import * as array from "std/array"

const numbers: Array U32 = #[10, 20, 12]
entry const expected = array.fold_left U32.add 0 numbers

entry const answer = func () => return array.fold_left U32.add 0 numbers

entry const unchanged = func () => return do:
  let original = #[1, 2, 3]
  let updated = original
  updated[1] := 40
  break original[1] + updated[1]

entry const checked = func index => return Maybe.unwrap_or 0 $ numbers.get(index)

entry const nested = func () => return do:
  let rows: Array (U32, Bool) = #[(42, true), (7, false)]
  let (value, _) = rows[0]
  break value
