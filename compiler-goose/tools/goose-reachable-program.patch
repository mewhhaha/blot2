 namespace goose {
+
+// Explicit private observation: no clock reads, formatting or allocations when
+// the environment switch is absent. Driver boundaries reuse existing clocks.
+inline bool CheckerProfileEnabled() {
+    static const bool enabled = [] {
+        auto value = getenv("GOOSE_CHECKER_PROFILE");
+        return value && *value;
+    }();
+    return enabled;
+}
+inline void CheckerPhase(const char *name, chrono::steady_clock::time_point from,
+                         chrono::steady_clock::time_point to) {
+    if (!CheckerProfileEnabled()) return;
+    auto ns = chrono::duration_cast<chrono::nanoseconds>(to - from).count();
+    fprintf(stderr, "GOOSE_CHECKER_PROFILE phase=%s ns=%lld\n", name, (long long)ns);
+}
+struct CheckerRootProfile {
+    bool enabled = CheckerProfileEnabled();
+    chrono::steady_clock::time_point from;
+    CheckerRootProfile() { if (enabled) from = chrono::steady_clock::now(); }
+    void Mark(const char *name) {
+        if (!enabled) return;
+        auto to = chrono::steady_clock::now();
+        CheckerPhase(name, from, to);
+        from = to;
+    }
+};
 
