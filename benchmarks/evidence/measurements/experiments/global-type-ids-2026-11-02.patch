+    var limited_work: usize = 4096;
+    var limited = K.Builder.init(&store, &limited_work, .{ .encoded_words = 32 });
+    defer limited.deinit();
+    var prefix: std.ArrayList(u32) = .empty;
+    defer prefix.deinit(a);
+    try prefix.append(a, 123);
+    try std.testing.expectError(error.Limit, limited.root(&prefix, root));
+    try std.testing.expectEqualSlices(u32, &.{123}, prefix.items);
+    // Descriptor-word work is local even for direct global-root hits.
+    var empty_work: usize = 4096;
+    var exhausted = K.Builder.init(&store, &empty_work, .{ .word_work = 0 });
+    defer exhausted.deinit();
+    try std.testing.expectError(error.Limit, exhausted.root(&prefix, root));
+    var fresh_work: usize = 4096;
+    var fresh = K.Builder.init(&store, &fresh_work, .{});
+    defer fresh.deinit();
+    try fresh.root(&prefix, root);
+    try fresh.finish(&prefix);
+}
