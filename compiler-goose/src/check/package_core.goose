recursive fn sharedGoal(self:Walker&,wanted:blot_support::Option<blot_check_core::Obligation>,given:blot_check_core::Obligation,depth:i64)->bool,Error {let error=self.step(depth);if error!=Error.none {return false,error;}let solver .= self.scopes.solver;if !solver {return false,Error.none;}if given.kind!=blot_check_types::ObligationKind.callee_use || given.other!=0 || given.result!=0 || given.signature!=0 || given.name!=0 || given.operator!=blot_check_types::Operator.none {return false,Error.invalid_artifact;}let selected,error=self.target(blot_check_core::BindingRef{unit:given.identity.unit,binding:given.identity.decl, ..});if error!=Error.none {return false,error;}let owner .= selected;var binding=given.identity.decl;if binding==0 || binding>=owner.bindings.len {return false,Error.invalid_artifact;}var declaration=owner.binding(binding);var forwards:i64=0;while declaration.kind==blot_check_core::BindingKind.external {let error=self.step(depth+forwards);if error!=Error.none {return false,error;}if !self.admission.source_bodies {return false,Error.invalid_artifact;}var target=declaration.target;if target.unit==0 {target.unit=owner.unit;}let selected,error=self.target(target);if error!=Error.none {return false,error;}let next .= selected;if target.binding==0 || target.binding>=next.bindings.len {return false,Error.invalid_artifact;}let imported=next.binding(target.binding);if declaration.public_variables.len!=imported.public_variables.len || declaration.public_rows.len!=imported.public_rows.len {return false,Error.invalid_artifact;}owner .= next;binding=target.binding;declaration=imported;forwards+=1;}if declaration.kind!=blot_check_core::BindingKind.global || owner.body(binding)==null {return false,Error.invalid_artifact;}if wanted.present {let reachable,error=self.reachableHeader(owner,binding,wanted.value,depth+1);if error!=Error.none || !reachable {return false,error;}}if self.admission.source_bodies {let error=sourceBody(owner,binding,self.context,self.admission