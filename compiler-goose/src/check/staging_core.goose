fn scopedNamed(parent:const Named&,locals:const Locals?,loop_owner:LoopOwner?,loan_owner:const LoanOwner?,active_calls:const CallOwner?,decision_owner:const DecisionOwner?)->Named {return Named{workspace:parent.workspace,m:parent.m,units:parent.units,remaining:parent.remaining,variables:parent.variables,current_scheme:parent.current_scheme,row_variables:parent.row_variables,data_rows:parent.data_rows,row_owners:parent.row_owners,locals:locals,loop_owner:loop_owner,scope_owner:parent.scope_owner,loan_owner:loan_owner,active_calls:active_calls,ambient:parent.ambient,decision_owner:decision_owner,resolver_callback:parent.resolver_callback,..};}
fn publishNamed(target:Named&,source:const Named&) {target.variables=source.variables;target.current_scheme=source.current_scheme;target.row_variables=source.row_variables;target.data_rows=source.data_rows;target.row_owners=source.row_owners;target.scope_owner=source.scope_owner;target.ambient=source.ambient;target.resolver_callback=source.resolver_callback;}
