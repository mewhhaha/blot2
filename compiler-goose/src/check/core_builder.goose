type Error=blot_error::Error;
type Id=u32;
type List=blot_check_core::List;
type Identity=blot_check_types::NominalIdentity;
type Module=blot_check_core::Module;
struct Source {tree:const blot_parse_ast::Tree&,names:const blot_parse_symbols::Pool&,checked:const blot_check_check::Checked&,diagnostic_origins:blot_check_check::ModuleOrigins=blot_check_check::ModuleOrigins{..}}
struct Tables {
field_names:blot_check_core::FieldName[>..<]&,
request_loops:blot_check_core::RequestLoopInfo[>..<]&,
request_arms:blot_check_core::RequestArm[>..<]&,
tag_calls:blot_check_core::Id[>..<]&,
nodes:blot_check_core::Node[>..<]&,
spans:blot_check_core::Span[>..<]&,
extra:blot_check_core::Id[>..<]&,
type_nodes:blot_check_types::Node[>..<]&,
quantifier_goals:blot_check_types::QuantifierGoals[>..<]&,
quantifier_obligations:blot_check_types::Obligation[>..<]&,
type_extra:blot_check_types::Id[>..<]&,
effect_rows:blot_check_effects::Row[>..<]&,
effect_labels:blot_check_effects::Label[>..<]&,
effect_operations:blot_check_types::Operation[>..<]&,
bindings:blot_check_core::Binding[>..<]&,
bodies:blot_check_core::Body[>..<]&,
parameters:blot_check_core::Parameter[>..<]&,
runtime_names:blot_check_core::RuntimeName[>..<]&,
source_names:blot_check_core::RuntimeName[>..<]&,
erased_declaration_references:blot_check_core::ErasedDeclarationReference[>..<]&,
references:blot_check_core::BindingRef[>..<]&,
calls:blot_check_core::CallInfo[>..<]&,
merges:blot_check_core::Merge[>..<]&,
merge_ranges:blot_check_core::List[>..<]&,
name_bytes:u8[>..<]&,
obligations:blot_check_core::Obligation[>..<]&,
diagnostics:blot_check_core::Diagnostic[>..<]&,
nominals:blot_check_core::Nominal[>..<]&,
operation_names:blot_check_core::OperationName[>..<]&,
constructors:blot_check_core::Constructor[>..<]&,
projections:blot_check_core::Projection[>..<]&,
projection_variants:blot_check_core::ProjectionVariant[>..<]&,
patterns:blot_check_core::Pattern[>..<]&,
pattern_rows:blot_check_core::PatternRow[>..<]&,
match_arms:blot_check_core::MatchArm[>..<]&,
matches:blot_check_core::MatchInfo[>..<]&,
updates:blot_check_core::UpdateInfo[>..<]&,
update_steps:blot_check_core::UpdateStep[>..<]&,
closures:blot_check_core::ClosureInfo[>..<]&,
associated:blot_check_core::Associated[>..<]&,
contracts:blot_check_core::Contract[>..<]&,
contract_members:blot_check_core::ContractMember[>..<]&,
implementations:blot_check_core::Implementation[>..<]&,
implementation_members:blot_check_core::ImplementationMember[>..<]&,
member_templates:blot_check_core::MemberTemplate[>..<]&,
selected_proofs:blot_check_core::SelectedProof[>..<]&,
selected_members:blot_check_core::ImplementationMember[>..<]&,
selected_edges:u32[>..<]&,
selected_uses:blot_check_core::SelectedUse[>..<]&,
dictionary_selections:blot_check_core::DictionarySelection[>..<]&,
dictionary_uses:blot_check_core::DictionaryUse[>..<]&,
primitives:blot_check_core::Primitive[>..<]&,
loops:blot_check_core::LoopInfo[>..<]&,
loop_carries:blot_check_core::LoopCarry[>..<]&,
resolver_ops:blot_check_core::ResolverInfo[>..<]&,
operation_values:blot_check_core::OperationValue[>..<]&,
handle_effects:blot_check_core::HandleEffects[>..<]&,
dispatch_signatures:blot_check_types::Id[>..<]&,
proof_contracts:blot_check_core::ProofContract[>..<]&,
}
struct ResolverLoopFrame {source:u32,cursor:u32,parameter:u32,finalizer:u32,continued:u32,continue_constructor:u32}
struct RequestCallbackFrame {loop:u32,return_target:u32,decision_type:u32,state_type:u32}
struct Scratch {saved_fields:dictionary<u32,bool>&,nullary_nominals:dictionary<Identity,u32>&,request_callbacks:RequestCallbackFrame[>..<]&,visit_epochs:u32[>..<]&,resolver_loop_frames:ResolverLoopFrame[>..<]&,closed_containers:u32[6][3]=[[0;6];3],
type_map:u32[:]=[],
variable_map:u32[:]=[],
effect_row_map:u32[:]=[],
effect_variable_map:u32[:]=[],
effect_operation_map:u32[:]=[],
ast_map:u32[:]=[],
member_origin_heads:u32[:]=[],
member_origin_next:u32[:]=[],
signature_sources:u32[:]=[],
merge_heads:u32[:]=[],
merge_next:u32[:]=[],
loop_exit_indices:u32[:]=[],
statement_arms:u32[:]=[],
definition_epochs:u32[:]=[],
reference_epochs:u32[:]=[],
capture_epoch:u32=0,return_target:u32=0,function_target:u32=0,variable_count:u32=0,effect_variable_count:u32=0,body_lowerings:i64=0,proof_visits:i64=0}
struct Builder {source:Source,tables:Tables,scratch:Scratch}
type WordBuffer=blot_support_pooled_buffer::Buffer<u32>;
reusable[] var word_runs:u32[>..];
fn WordBuffer::append(self:WordBuffer&,value:u32)->Error {return self.push(value,word_runs);}
fn WordBuffer::appendSlice(self:WordBuffer&,values:const u32[:])->Error {return blot_support_pooled_buffer::append(self,values,word_runs);}
fn WordBuffer::deinit(self:WordBuffer&) {self.deinit(word_runs);}
fn Builder::allocateEmpty(self:Builder&,destination:u32[:]& ,count:i64)->Error {assert(destination.len==0);if count<0 {return Error.core_limit;}let buffer=word_runs.alloc_slice(count);for &value in buffer {value=0;}destination=buffer;return Error.none;}

fn binaryOp(text:const u8[:])->blot_support::Option<blot_check_core::Op> {
if text=="+" {return blot_support::some(blot_check_core::Op.add);}
if text=="-" {return blot_support::some(blot_check_core::Op.sub);}
if text=="*" {return blot_support::some(blot_check_core::Op.mul);}
if text=="/" {return blot_support::some(blot_check_core::Op.div);}
if text=="%" {return blot_support::some(blot_check_core::Op.rem);}
if text=="==" {return blot_support::some(blot_check_core::Op.equal);}
if text=="!=" {return blot_support::some(blot_check_core::Op.not_equal);}
if text=="<" {return blot_support::some(blot_check_core::Op.less);}
if text=="<=" {return blot_support::some(blot_check_core::Op.less_equal);}
if text==">" {return blot_support::some(blot_check_core::Op.greater);}
if text==">=" {return blot_support::some(blot_check_core::Op.greater_equal);}
if text=="&" {return blot_support::some(blot_check_core::Op.bit_and);}
if text=="|" {return blot_support::some(blot_check_core::Op.bit_or);}
if text=="^" {return blot_support::some(blot_check_core::Op.bit_xor);}
if text=="<<" {return blot_support::some(blot_check_core::Op.shift_left);}
if text==">>" {return blot_support::some(blot_check_core::Op.shift_right);}
if text=="and" {return blot_support::some(blot_check_core::Op.and_);}
if text=="or" {return blot_support::some(blot_check_core::Op.or_);}
return blot_support::none<blot_check_core::Op>();}
fn memberOp(text:const u8[:])->blot_check_core::Op {
if text=="add" {return blot_check_core::Op.add;}
if text=="sub" {return blot_check_core::Op.sub;}
if text=="mul" {return blot_check_core::Op.mul;}
if text=="div" {return blot_check_core::Op.div;}
if text=="rem" {return blot_check_core::Op.rem;}
if text=="eq" {return blot_check_core::Op.equal;}
if text=="ne" {return blot_check_core::Op.not_equal;}
if text=="lt" {return blot_check_core::Op.less;}
if text=="le" {return blot_check_core::Op.less_equal;}
if text=="gt" {return blot_check_core::Op.greater;}
if text=="ge" {return blot_check_core::Op.greater_equal;}
if text=="bit_and" {return blot_check_core::Op.bit_and;}
if text=="bit_or" {return blot_check_core::Op.bit_or;}
if text=="bit_xor" {return blot_check_core::Op.bit_xor;}
if text=="shl" {return blot_check_core::Op.shift_left;}
if text=="shr" {return blot_check_core::Op.shift_right;}
return blot_check_core::Op.none;}
struct Intrinsic {op:blot_check_core::Op,arity:u8}
struct ArrayIntrinsic {op:blot_check_core::ArrayOp,arity:u8}
fn arrayIntrinsic(text:const u8[:])->blot_support::Option<ArrayIntrinsic> {let value=blot_backend_collection_ops::lookup(text);if !value.present {return blot_support::none<ArrayIntrinsic>();}return blot_support::some(ArrayIntrinsic{value.value.op,value.value.arity, ..});}
fn intrinsic(text:const u8[:])->blot_support::Option<Intrinsic> {let simd=blot_backend_simd_intrinsics::lookup(text);if simd.present {return blot_support::some(Intrinsic{simd.value.op,simd.value.arity, ..});}
if text=="@u32.add" {return blot_support::some(Intrinsic{blot_check_core::Op.add,2, ..});}
if text=="@u32.sub" {return blot_support::some(Intrinsic{blot_check_core::Op.sub,2, ..});}
if text=="@u32.mul" {return blot_support::some(Intrinsic{blot_check_core::Op.mul,2, ..});}
if text=="@u32.div" {return blot_support::some(Intrinsic{blot_check_core::Op.div,2, ..});}
if text=="@u32.rem" {return blot_support::some(Intrinsic{blot_check_core::Op.rem,2, ..});}
if text=="@u32.eq" {return blot_support::some(Intrinsic{blot_check_core::Op.equal,2, ..});}
if text=="@u32.lt" {return blot_support::some(Intrinsic{blot_check_core::Op.less,2, ..});}
if text=="@u32.bit_and" {return blot_support::some(Intrinsic{blot_check_core::Op.bit_and,2, ..});}
if text=="@u32.bit_or" {return blot_support::some(Intrinsic{blot_check_core::Op.bit_or,2, ..});}
if text=="@u32.bit_xor" {return blot_support::some(Intrinsic{blot_check_core::Op.bit_xor,2, ..});}
if text=="@u32.shl" {return blot_support::some(Intrinsic{blot_check_core::Op.shift_left,2, ..});}
if text=="@u32.shr" {return blot_support::some(Intrinsic{blot_check_core::Op.shift_right,2, ..});}
if text=="@u32.to_f32" {return blot_support::some(Intrinsic{blot_check_core::Op.convert_u32_f32,1, ..});}
if text=="@f32.add" {return blot_support::some(Intrinsic{blot_check_core::Op.add,2, ..});}
if text=="@f32.sub" {return blot_support::some(Intrinsic{blot_check_core::Op.sub,2, ..});}
if text=="@f32.mul" {return blot_support::some(Intrinsic{blot_check_core::Op.mul,2, ..});}
if text=="@f32.div" {return blot_support::some(Intrinsic{blot_check_core::Op.div,2, ..});}
if text=="@f32.eq" {return blot_support::some(Intrinsic{blot_check_core::Op.equal,2, ..});}
if text=="@f32.ne" {return blot_support::some(Intrinsic{blot_check_core::Op.not_equal,2, ..});}
if text=="@f32.lt" {return blot_support::some(Intrinsic{blot_check_core::Op.less,2, ..});}
if text=="@f32.le" {return blot_support::some(Intrinsic{blot_check_core::Op.less_equal,2, ..});}
if text=="@f32.gt" {return blot_support::some(Intrinsic{blot_check_core::Op.greater,2, ..});}
if text=="@f32.ge" {return blot_support::some(Intrinsic{blot_check_core::Op.greater_equal,2, ..});}
if text=="@f32.abs" {return blot_support::some(Intrinsic{blot_check_core::Op.abs,1, ..});}
if text=="@f32.neg" {return blot_support::some(Intrinsic{blot_check_core::Op.neg,1, ..});}
if text=="@f32.ceil" {return blot_support::some(Intrinsic{blot_check_core::Op.ceil,1, ..});}
if text=="@f32.floor" {return blot_support::some(Intrinsic{blot_check_core::Op.floor,1, ..});}
if text=="@f32.trunc" {return blot_support::some(Intrinsic{blot_check_core::Op.trunc,1, ..});}
if text=="@f32.sqrt" {return blot_support::some(Intrinsic{blot_check_core::Op.sqrt,1, ..});}
if text=="@f32.to_u32" {return blot_support::some(Intrinsic{blot_check_core::Op.convert_f32_u32,1, ..});}
return blot_support::none<Intrinsic>();}
fn Builder::initialize(self:Builder&)->Error {
 let checked .= self.source.checked;let tree .= self.source.tree;let error=self.allocateEmpty(self.scratch.type_map,checked.types.nodes.len);if error!=Error.none {return error;}let error=self.allocateEmpty(self.scratch.variable_map,checked.types.variables.len);if error!=Error.none {return error;}let error=self.allocateEmpty(self.scratch.effect_row_map,checked.types.effects.rows.len);if error!=Error.none {return error;}let error=self.allocateEmpty(self.scratch.effect_variable_map,checked.types.effects.variables.len);if error!=Error.none {return error;}let error=self.allocateEmpty(self.scratch.effect_operation_map,checked.types.operations.len);if error!=Error.none {return error;}self.tables.effect_rows.push(blot_check_effects::Row{..});self.tables.effect_operations.append([blot_check_types::Operation{identity:Identity{0,0, ..}, ..},blot_check_types::Operation{identity:Identity{0,1, ..}, ..}]);self.scratch.effect_operation_map[blot_check_types::foreign_operation]=blot_check_types::foreign_operation;let error=self.allocateEmpty(self.scratch.ast_map,tree.nodes.len);if error!=Error.none {return error;}
 let origins=tree.operator_origins.items;var member_origin=false;for origin in origins {if origin.member_point!=0 && origin.node<tree.nodes.len {member_origin=true;break;}}if member_origin {if origins.len>0xffffffff {return Error.core_limit;}let error=self.allocateEmpty(self.scratch.member_origin_heads,tree.nodes.len);if error!=Error.none {return error;}let error=self.allocateEmpty(self.scratch.member_origin_next,origins.len);if error!=Error.none {return error;}for origin,index in origins {if origin.member_point==0 || origin.node>=self.scratch.member_origin_heads.len {continue;}self.scratch.member_origin_next[index]=self.scratch.member_origin_heads[origin.node];self.scratch.member_origin_heads[origin.node]=(index+1) as u32;}}
 for signature,source in checked.dispatch_signatures {if signature==0 {continue;}if self.scratch.signature_sources.len==0 {let error=self.allocateEmpty(self.scratch.signature_sources,tree.nodes.len);if error!=Error.none {return error;}}self.scratch.signature_sources[source]=signature;}for obligation in checked.obligations {if obligation.signature!=0 {if self.scratch.signature_sources.len==0 {let error=self.allocateEmpty(self.scratch.signature_sources,tree.nodes.len);if error!=Error.none {return error;}}self.scratch.signature_sources[obligation.source]=obligation.signature;}}
 if checked.merges.len!=0 {let error=self.allocateEmpty(self.scratch.merge_heads,tree.nodes.len);if error!=Error.none {return error;}for &head in self.scratch.merge_heads {head=0xffffffff;}let error=self.allocateEmpty(self.scratch.merge_next,checked.merges.len);if error!=Error.none {return error;}var index=checked.merges.len;while index!=0 {index-=1;let source=checked.merges[index].node;self.scratch.merge_next[index]=self.scratch.merge_heads[source];self.scratch.merge_heads[source]=index as u32;}}
 if checked.loop_exits.len!=0 {let error=self.allocateEmpty(self.scratch.loop_exit_indices,tree.nodes.len);if error!=Error.none {return error;}for exit,index in checked.loop_exits {self.scratch.loop_exit_indices[exit.node]=(index+1) as u32;}}if checked.statement_arms.len!=0 {let error=self.allocateEmpty(self.scratch.statement_arms,tree.nodes.len);if error!=Error.none {return error;}for arm in checked.statement_arms {self.scratch.statement_arms[arm.node]=1;}}
 self.tables.type_nodes.append(checked.types.nodes.items[..6]);for index in 0..6 {self.scratch.type_map[index]=index as u32;}let ignored,error=self.reserve(0);if error!=Error.none {return error;}self.tables.bodies.push(blot_check_core::Body{..});return Error.none;
}
fn Builder::diagnostic(self:Builder&,code:blot_check_core::Code,source:u32)->Error {self.tables.diagnostics.push(blot_check_core::Diagnostic{code:code,span:self.source.checked.diagnosticSpan(self.source.tree,source), ..});return Error.none;}
fn Builder::addType(self:Builder&,value:blot_check_types::Node)->u32,Error {var container:i64=-1;if value.tag==blot_check_types::Tag.array {container=0;}else if value.tag==blot_check_types::Tag.list {container=1;}else if value.tag==blot_check_types::Tag.cursor {container=2;}var canonical:u32?=null;if container>=0 && value.a!=0 && value.a<6 && value.b==0 && value.c==0 {canonical .= self.scratch.closed_containers[container][value.a];if canonical && canonical!=0 {return canonical,Error.none;}}if self.tables.type_nodes.len==0xffffffff {return 0,Error.core_limit;}let id=self.tables.type_nodes.len as u32;let nullary=value.tag==blot_check_types::Tag.nominal && self.tables.type_extra[value.c]==0;self.tables.type_nodes.push(value);if canonical {canonical=id;}if nullary {let identity=Identity{value.a,value.b, ..};if !self.scratch.nullary_nominals.contains(identity) {self.scratch.nullary_nominals.insert(identity,id);}}return id,Error.none;}
recursive fn Builder::projectType(self:Builder&,source:u32,depth:i64)->u32,Error {if source==0 {return 0,Error.none;}if self.scratch.type_map[source]!=0 {return self.scratch.type_map[source],Error.none;}if depth>=1024 {return 0,Error.core_limit;}let resolved=self.source.checked.types.head(source,0);if resolved!=source {let id,error=self.projectType(resolved,depth+1);if error!=Error.none {return 0,error;}self.scratch.type_map[source]=id;return id,Error.none;}let original=self.source.checked.types.node(resolved);if original.tag==blot_check_types::Tag.variable && self.scratch.variable_map[original.a]!=0 {let id=self.scratch.variable_map[original.a];self.scratch.type_map[source]=id;return id,Error.none;}if original.tag==blot_check_types::Tag.rigid {return self.projectRigid(source,original,depth);}if original.tag==blot_check_types::Tag.nominal && self.source.checked.types.nominalArguments(original).len==0 {let known .= self.scratch.nullary_nominals.get(Identity{original.a,original.b, ..});if known {self.scratch.type_map[source]=known;return known,Error.none;}}var words=WordBuffer{..};let value,error=projectTypeShape(self,source,original,depth,words);words.deinit();if error!=Error.none {return 0,error;}let id,error=self.addType(value);if error!=Error.none {return 0,error;}self.scratch.type_map[source]=id;if original.tag==blot_check_types::Tag.variable {self.scratch.variable_map[original.a]=id;}if original.tag==blot_check_types::Tag.forall || original.tag==blot_check_types::Tag.existential {let error=self.projectQuantifierGoals(source,id,depth);if error!=Error.none {return 0,error;}}return id,Error.none;}
fn Builder::projectRigid(self:Builder&,source:u32,original:blot_check_types::Node,depth:i64)->u32,Error {let checked .= self.source.checked;if original.c==2 {for loan in checked.usage_loans {let region=checked.types.node(loan.region);if region.a!=original.a {continue;}let binding=checked.resolved[loan.parameter];if binding==0 {return 0,Error.core_limit;}let id,error=self.addType(blot_check_types::Node{tag:blot_check_types::Tag.bound,a:0,b:2,c:binding, ..});if error!=Error.none {return 0,error;}self.scratch.type_map[source]=id;return id,Error.none;}}
 var owner=blot_support::none<blot_check_check::RankImplementation>();for implementation in checked.rank_implementations {if implementation.scope==original.a {owner=blot_support::some(implementation);break;}}if !owner.present {return 0,Error.core_limit;}let implementation=owner.value;var quantified=implementation.quantified;if implementation.node!=0 && implementation.node<checked.expr_types.len {var published=checked.types.head(checked.expr_types[implementation.node],0);var stopped=false;for index in 0..128 {let wrapper=checked.types.node(published);if wrapper.tag!=blot_check_types::Tag.usage {stopped=true;break;}published=checked.types.head(wrapper.a,0);}if !stopped {return 0,Error.core_limit;}if checked.types.node(published).tag==blot_check_types::Tag.forall {quantified=published;}}
 let quantifier=checked.types.node(checked.types.head(quantified,0));if (quantifier.tag!=blot_check_types::Tag.forall && quantifier.tag!=blot_check_types::Tag.existential) || original.b>=quantifier.c {return 0,Error.core_limit;}let bound=checked.types.list(blot_check_types::List{quantifier.b,quantifier.c, ..})[original.b];let leaf=checked.types.node(bound);if leaf.tag!=blot_check_types::Tag.bound || leaf.b!=original.c {return 0,Error.core_limit;}if quantifier.tag==blot_check_types::Tag.existential {if implementation.node==0 || implementation.node>=checked.resolved.len {return 0,Error.core_limit;}let binding=checked.resolved[implementation.node];if binding==0 || binding>=checked.bindings.len || self.source.tree.node(implementation.node).tag!=blot_parse_ast::tag_package_unpack {return 0,Error.core_limit;}let id,error=self.addType(blot_check_types::Node{tag:blot_check_types::Tag.bound,a:original.b,b:original.c,c:binding, ..});if error!=Error.none {return 0,error;}self.scratch.type_map[source]=id;return id,Error.none;}let result,error=self.projectType(bound,depth+1);if error!=Error.none {return 0,error;}self.scratch.type_map[source]=result;return result,Error.none;
}
fn projectTypeShape(self:Builder&,source:u32,original:blot_check_types::Node,depth:i64,words:WordBuffer&)->blot_check_types::Node,Error {let tag=original.tag;var value=original;match tag {
 blot_check_types::Tag.usage=>{let a,error=self.projectType(original.a,depth+1);if error!=Error.none {return value,error;}var c:u32=0;if original.c!=0 {let projected,error=self.projectType(original.c,depth+1);if error!=Error.none {return value,error;}c=projected;}return blot_check_types::Node{tag:tag,a:a,b:original.b,c:c, ..},Error.none;},
 blot_check_types::Tag.bound=>{return blot_check_types::Node{tag:tag,a:original.a,b:original.b, ..},Error.none;},
 blot_check_types::Tag.forall,blot_check_types::Tag.existential=>{for binder in self.source.checked.types.list(blot_check_types::List{original.b,original.c, ..}) {let projected,error=self.projectType(binder,depth+1);if error!=Error.none {return value,error;}let error=words.append(projected);if error!=Error.none {return value,error;}}let body,error=self.projectType(original.a,depth+1);if error!=Error.none {return value,error;}let span,error=self.saveTypes(words.items);return blot_check_types::Node{tag:tag,a:body,b:span.start,c:span.len, ..},error;},
 blot_check_types::Tag.variable=>{let index=self.scratch.variable_count;self.scratch.variable_count+=1;return blot_check_types::Node{tag:tag,a:index, ..},Error.none;},
