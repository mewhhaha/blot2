fn scalarContract(self_:Walker&,operation:blot_check_core::Op,inputs:const u32[:],output:u32)->Error {if inputs.len!=0 && self_.module.types.node(inputs[0]).tag==blot_check_types::Tag.product {return blot_check_simd_contracts::validate(self_.module.types,operation,inputs,output);}let error=self_.step(0);if error!=blot_error::Error.none {return error;}var arity:i64=2;match operation {neg,abs,ceil,floor,trunc,sqrt,convert_u32_f32,convert_f32_u32=>{arity=1;},_=>{},}if inputs.len!=arity {return blot_error::Error.invalid_artifact;}let input=self_.module.types.node(inputs[0]).tag;var machine=blot_backend_runtime_ir::SC_u32;match input {unsigned32=>{},floating32=>{machine=blot_backend_runtime_ir::SC_f32;},boolean=>{if operation!=blot_check_core::Op.equal && operation!=blot_check_core::Op.not_equal {return blot_error::Error.invalid_artifact;}machine=blot_backend_runtime_ir::SC_bool;},_=>{return blot_error::Error.invalid_artifact;},}if !blot_backend_scalar_ops::opcode(operation,machine).present {return blot_error::Error.invalid_artifact;}if inputs.len==2 {let error=self_.same(inputs[0],inputs[1]);if error!=blot_error::Error.none {return error;}}var expected=inputs[0];match operation {equal,not_equal,less,less_equal,greater,greater_equal=>{expected=blot_check_types::boolean;},convert_u32_f32=>{if input!=blot_check_types::Tag.unsigned32 {return blot_error::Error.invalid_artifact;}expected=blot_check_types::f32_type;},convert_f32_u32=>{if input!=blot_check_types::Tag.floating32 {return blot_error::Error.invalid_artifact;}expected=blot_check_types::u32_type;},_=>{},}return self_.same(expected,output);}
