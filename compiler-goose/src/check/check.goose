fn Engine::builtinStateTemplate(self:Engine&,read:bool)->u32,blot_error::Error {var identity=blot_check_types::builtin_state_write;if read {identity=blot_check_types::builtin_state_read;}let existing .= self.catalogs.effect_template_identities.get(identity);if existing {return existing,blot_error::Error.none;}if self.effect_templates.len==0xffffffff {return 0,blot_error::Error.type_limit;}let state,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}let index=self.effect_templates.len as u32;var parameter=state;var result=blot_check_types::unit;if read {parameter=blot_check_types::unit;result=state;}self.effect_templates.append(EffectTemplate{identity:identity,family:0,name:0,parameter:parameter,result:result});self.catalogs.effect_template_identities.insert(identity,index);return index,blot_error::Error.none;}
