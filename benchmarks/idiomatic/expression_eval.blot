type Expr is data = $Value U32 | $Add (Expr, Expr) | $Multiply (Expr, Expr)
const make_expr = func (depth: U32) -> (seed: U32) : Expr => return do:
  if depth == 0:
    break $Value (seed % 16)
  let left = make_expr (depth - 1) (seed * 3 + 1)
  let right = make_expr (depth - 1) (seed * 5 + 7)
  break if seed % 2 == 0 then $Add (left, right) else $Multiply (left, right)
const evaluate = func (expr: Expr) : U32 => return case expr of
  $Value value => value
  $Add (left, right) => evaluate left + evaluate right
  $Multiply (left, right) => evaluate left * evaluate right
entry const run = func (seed: U32) : U32 => return evaluate (make_expr 9 seed)
