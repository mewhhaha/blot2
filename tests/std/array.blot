import * as array from "std/array"
import * as test from "std/test"

private func array_checks (): Unit ! { test.Test } =>
  let values = #[2, 3, 4, 5]
  use test.eq "map" #[4, 6, 8, 10] (array.map (func value => value * 2) values)
  use test.eq "filter preserves order" #[2, 4] (array.filter (func value => value % 2 == 0) values)
  use test.eq "middle slice" #[3, 4] (array.slice 1 2 values)
  let empty: #[U32] = #[]
  use test.eq "empty slice at the end" empty (array.slice 4 0 values)
  use test.eq "concat" #[2, 3, 4, 5, 6, 7] (array.concat values #[6, 7])
  let zipped = array.zip values #[true, false]
  let zipped_count = zipped.length
  use test.eq "zip stops at shorter length" 2 zipped_count
  let (first_number, first_flag) = zipped[0]
  let (second_number, second_flag) = zipped[1]
  use test.eq "first zipped number" 2 first_number
  use test.holds "first zipped flag" first_flag
  use test.eq "second zipped number" 3 second_number
  use test.holds_not "second zipped flag" second_flag
  use test.eq "fold left order" 2345 (array.fold_left (func acc -> digit => acc * 10 + digit) 0 values)
  use test.eq "empty fold" 42 (array.fold_left add 42 empty)
  use test.eq "prefix sums" #[2, 5, 9, 14] (array.prefix_sums values)
  use test.eq "prefix sums wrap" #[0xffff_ffff, 0, 3] (array.prefix_sums #[0xffff_ffff, 1, 3])
  return ()

entry func test_array (): test.Report => test.run array_checks

entry func trap_slice_oob (): Unit =>
  let sliced = array.slice 1 2 #[42]
  if sliced.length == 0:
    return ()
  return ()
