fn attemptClosedNodeSlots(self_: Session&,unit: u32,id: u32,values: const dictionary_slot<u32,ValueId>[:]) -> ValueId,bool,Error { let saved=self_.diagnostic; let value,error=closedNodeSlots(self_,unit,id,values,[],[]); if error==blot_error::Error.out_of_memory { return 0,false,error; } if error!=blot_error::Error.none { self_.diagnostic=saved; return 0,false,blot_error::Error.none; } return value,true,blot_error::Error.none; }

fn closeRegionTiming(session: Session&,active: bool,previous: blot_backend_backend_timing::Phase) { if active&&session.timing { blot_backend_backend_timing::account(requireReference(session.timing)); requireReference(session.timing).active=previous; } }
