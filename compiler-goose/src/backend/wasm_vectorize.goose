// Independent checked numeric stores vectorize; effects and scalar tails stay in place.
namespace blot_backend_wasm_vectorize;
import .runtime_ir;
import .wasm;
import .optimizer_buffers;
import support.error;
import support.option;
type Error=blot_error::Error;
type Module=blot_backend_wasm::Module;
type Function=blot_backend_runtime_ir::Function;
type Instruction=blot_backend_runtime_ir::Instruction;
type Op=blot_backend_runtime_ir::Op;
type ValueType=blot_backend_runtime_ir::ValueType;
type Output=blot_backend_runtime_ir::DetachedBody;
type Code=blot_backend_optimizer_buffers::Code;
type Types=blot_backend_optimizer_buffers::Types;
type Id=u16;
let none:Id=65535;
struct Node {op:Op,operand:u32=0,left:Id=none,right:Id=none,machine:ValueType=blot_backend_runtime_ir::VT_i32}
struct Block {base:i64,result:blot_support::Option<ValueType> =blot_support::none<ValueType>()}
struct Plan {nodes:Node[256]=[default<Node>();256],len:i64=0,budget:i64=1024,index:u32}
fn add(self_:Plan&,node:Node)->blot_support::Option<Id> {if self_.len==self_.nodes.len {return blot_support::none<Id>();}let id=self_.len as Id;self_.nodes[self_.len]=node;self_.len+=1;return blot_support::some(id);}
fn exitBlock(self_:Plan&,instructions:const Instruction[:],start:i64,labels:i64)->blot_support::Option<i64> {var nested:i64=0;var remaining=labels;for inst,index in instructions[start..] {let at=start+index;if self_.budget==0 {return blot_support::none<i64>();}self_.budget-=1;match inst.op {blot_backend_runtime_ir::OP_block,blot_backend_runtime_ir::OP_loop,blot_backend_runtime_ir::OP_if_=>{nested+=1;},blot_backend_runtime_ir::OP_end=>{if nested!=0 {nested-=1;}else if remaining!=0 {remaining-=1;}else {return blot_support::some(at);}},_=>{},}}return blot_support::none<i64>();}
recursive fn parse(self_:Plan&,module:const Module&,instructions:const Instruction[:],initial:const Id[:],depth:i64)->blot_support::Option<Id> {if depth>6 || initial.len>256 {return blot_support::none<Id>();}var locals:Id[256]=[none;256];for id,index in initial {locals[index]=id;}var stack:Id[256]=[none;256];var len:i64=0;var blocks:Block[16]=[Block{..};16];var block_count:i64=0;var at:i64=0;while at<instructions.len {let inst=instructions[at];if inst.op==blot_backend_runtime_ir::OP_ownership {at+=1;continue;}if inst.table_reference || self_.budget==0 {return blot_support::none<Id>();}self_.budget-=1;var result=blot_support::none<Id>();match inst.op {
 blot_backend_runtime_ir::OP_block=>{if block_count==blocks.len {return blot_support::none<Id>();}var machine=blot_support::none<ValueType>();if inst.operand==blot_backend_runtime_ir::VT_i32 as u32 {machine=blot_support::some(blot_backend_runtime_ir::VT_i32);}else if inst.operand==blot_backend_runtime_ir::VT_f32 as u32 {machine=blot_support::some(blot_backend_runtime_ir::VT_f32);}else if inst.operand!=0 {return blot_support::none<Id>();}blocks[block_count]=Block{base:len,result:machine,..};block_count+=1;},
 blot_backend_runtime_ir::OP_end=>{if block_count==0 {return blot_support::none<Id>();}block_count-=1;let block_=blocks[block_count];var expected=block_.base;if block_.result.present {expected+=1;}if len!=expected || (block_.result.present && self_.nodes[stack[len-1]].machine!=block_.result.value) {return blot_support::none<Id>();}},
 blot_backend_runtime_ir::OP_br=>{if inst.operand>=block_count {return blot_support::none<Id>();}let target=block_count-1-inst.operand;let block_=blocks[target];if block_.result.present {if len<=block_.base || self_.nodes[stack[len-1]].machine!=block_.result.value {return blot_support::none<Id>();}stack[block_.base]=stack[len-1];}len=block_.base;if block_.result.present {len+=1;}let end=self_.exitBlock(instructions,at+1,inst.operand);if !end.present {return blot_support::none<Id>();}at=end.value-1;block_count=target+1;},
 blot_backend_runtime_ir::OP_local_get=>{if inst.operand>=initial.len || locals[inst.operand]==none {return blot_support::none<Id>();}result=blot_support::some(locals[inst.operand]);},blot_backend_runtime_ir::OP_local_set,blot_backend_runtime_ir::OP_local_tee=>{if len==0 || inst.operand>=initial.len {return blot_support::none<Id>();}locals[inst.operand]=stack[len-1];if inst.op==blot_backend_runtime_ir::OP_local_set {len-=1;}},
 blot_backend_runtime_ir::OP_i32_const,blot_backend_runtime_ir::OP_f32_const=>{var machine=blot_backend_runtime_ir::VT_i32;if inst.op==blot_backend_runtime_ir::OP_f32_const {machine=blot_backend_runtime_ir::VT_f32;}result=self_.add(Node{op:inst.op,operand:inst.operand,machine:machine,..});if !result.present {return result;}},blot_backend_runtime_ir::OP_nop=>{},blot_backend_runtime_ir::OP_drop=>{if len==0 {return blot_support::none<Id>();}len-=1;},blot_backend_runtime_ir::OP_return_=>{if depth!=0 && len==1 {return blot_support::some(stack[0]);}return blot_support::none<Id>();},
 blot_backend_runtime_ir::OP_call=>{if inst.operand>=module.functions.len {return blot_support::none<Id>();}let target=module.functions[inst.operand];let own=module.locals(target);if own.len>0x7fffffffffffffff-target.parameters.len {return blot_support::none<Id>();}let slots=target.parameters.len+own.len;if target.parameters.len>len || slots>256 || (target.result!=blot_backend_runtime_ir::VT_i32 && target.result!=blot_backend_runtime_ir::VT_f32) {return blot_support::none<Id>();}var args:Id[256]=[none;256];for index in 0..target.parameters.len {args[index]=stack[len-target.parameters.len+index];}for ty,index in own {if ty!=blot_backend_runtime_ir::VT_i32 && ty!=blot_backend_runtime_ir::VT_f32 {return blot_support::none<Id>();}var op=blot_backend_runtime_ir::OP_i32_const;if ty==blot_backend_runtime_ir::VT_f32 {op=blot_backend_runtime_ir::OP_f32_const;}let value=self_.add(Node{op:op,machine:ty,..});if !value.present {return blot_support::none<Id>();}args[target.parameters.len+index]=value.value;}len-=target.parameters.len;result=self_.parse(module,blot_backend_wasm::instructions(module,target),args[..slots],depth+1);if !result.present {return result;}},
 _=>{let lifted,valid=blot_backend_runtime_ir::lift(inst.op);if !valid {return blot_support::none<Id>();}let signature=blot_backend_runtime_ir::fixed(inst.op);if signature.effect!=blot_backend_runtime_ir::EFFECT_pure || signature.may_trap || len<signature.arity {return blot_support::none<Id>();}let arity=signature.arity;let left=stack[len-arity];var right:Id=none;if arity!=1 {right=stack[len-1];}len-=arity;for index in 0..arity {if self_.nodes[stack[len+index]].machine!=signature.inputs[index] {return blot_support::none<Id>();}}result=self_.add(Node{op:inst.op,left:left,right:right,machine:signature.result,..});if !result.present {return result;}},
 }if result.present {if len==stack.len {return blot_support::none<Id>();}stack[len]=result.value;len+=1;}at+=1;}if block_count==0 && len==1 {return blot_support::some(stack[0]);}return blot_support::none<Id>();}
fn I(op:Op,operand:u32=0)->Instruction {return Instruction{op:op,operand:operand,..};}
recursive fn expression(locals:Types&,output:Code&,plan:const Plan&,id:Id,ready:blot_support::Option<u32>[:],parameters:i64)->u32,Error {if ready[id].present {return ready[id].value,blot_error::Error.none;}let node=plan.nodes[id];var left=blot_support::none<u32>();var right=blot_support::none<u32>();if node.left!=none {let value,error=expression(locals,output,plan,node.left,ready,parameters);if error!=blot_error::Error.none {return 0,error;}left=blot_support::some(value);}if node.right!=none {let value,error=expression(locals,output,plan,node.right,ready,parameters);if error!=blot_error::Error.none {return 0,error;}right=blot_support::some(value);}match node.op {blot_backend_runtime_ir::OP_local_get,blot_backend_runtime_ir::OP_i32_const,blot_backend_runtime_ir::OP_f32_const=>{var splat=blot_backend_runtime_ir::OP_i32x4_splat;if node.machine==blot_backend_runtime_ir::VT_f32 {splat=blot_backend_runtime_ir::OP_f32x4_splat;}let error=output.append([I(node.op,node.operand),I(splat)]);if error!=blot_error::Error.none {return 0,error;}if node.op==blot_backend_runtime_ir::OP_local_get && node.operand==plan.index {let error=output.append([I(blot_backend_runtime_ir::OP_i32_const,0),I(blot_backend_runtime_ir::OP_i32x4_splat)]);if error!=blot_error::Error.none {return 0,error;}for lane in 1..4 {let error=output.append([I(blot_backend_runtime_ir::OP_i32_const,lane as u32),I(blot_backend_runtime_ir::OP_i32x4_replace_lane,lane as u32)]);if error!=blot_error::Error.none {return 0,error;}}let error=output.push(I(blot_backend_runtime_ir::OP_i32x4_add));if error!=blot_error::Error.none {return 0,error;}}},_=>{assert(left.present);let error=output.push(I(blot_backend_runtime_ir::OP_local_get,left.value));if error!=blot_error::Error.none {return 0,error;}if right.present {let error=output.push(I(blot_backend_runtime_ir::OP_local_get,right.value));if error!=blot_error::Error.none {return 0,error;}}let lifted,valid=blot_backend_runtime_ir::lift(node.op);assert(valid);let error=output.push(I(lifted));if error!=blot_error::Error.none {return 0,error;}},}let local=(parameters+locals.len) as u32;let error=locals.push(blot_backend_runtime_ir::VT_v128);if error!=blot_error::Error.none {return 0,error;}let error=output.push(I(blot_backend_runtime_ir::OP_local_set,local));if error!=blot_error::Error.none {return 0,error;}ready[id]=blot_support::some(local);return local,blot_error::Error.none;}
fn isInst(inst:Instruction,op:Op,operand:u32)->bool {return inst.op==op && inst.operand==operand;}
fn privateLocals(module:const Module&,function:const Function&,start:i64,end:i64,slots:i64)->bool {let source=blot_backend_wasm::instructions(module,function);var written:bool[128]=[false;128];var count:i64=0;for inst in source[start..end] {if inst.op==blot_backend_runtime_ir::OP_local_set || inst.op==blot_backend_runtime_ir::OP_local_tee {if inst.operand<function.parameters.len || inst.operand>=slots {return false;}if !written[inst.operand] {count+=1;written[inst.operand]=true;}}}if count==0 {return true;}if source.len>4096 {return false;}for inst,at in source {if at>=start && at<end {continue;}if (inst.op==blot_backend_runtime_ir::OP_local_get || inst.op==blot_backend_runtime_ir::OP_local_set || inst.op==blot_backend_runtime_ir::OP_local_tee) && inst.operand<slots && written[inst.operand] {return false;}}var defined:bool[128]=[false;128];for inst in source[start..end] {if inst.op==blot_backend_runtime_ir::OP_local_get && inst.operand<slots && written[inst.operand] && !defined[inst.operand] {return false;}if inst.op==blot_backend_runtime_ir::OP_local_set || inst.op==blot_backend_runtime_ir::OP_local_tee {defined[inst.operand]=true;}}return true;}
fn run(module:const Module&,function:const Function&)->blot_support::Option<Output>,Error {var locals=Types{..};var out=Code{..};let changed,error=build(module,function,locals,out);return blot_backend_optimizer_buffers::finishOptional(locals,out,changed,error);}
fn build(module:const Module&,function:const Function&,locals:Types&,out:Code&)->bool,Error {let source=blot_backend_wasm::instructions(module,function);var changed=false;var copied:i64=0;var at:i64=5;while at+18<source.len {let candidate=kernel(module,function,at);if !candidate.present {at+=1;continue;}var found=candidate.value;let end=found.end;let index=found.plan.index;let count=source[at+3].operand;if !changed {let error=locals.append(module.locals(function));if error!=blot_error::Error.none {return false,error;}}changed=true;let error=out.append(source[copied..at]);if error!=blot_error::Error.none {return false,error;}let error=out.append([I(blot_backend_runtime_ir::OP_block),I(blot_backend_runtime_ir::OP_loop),I(blot_backend_runtime_ir::OP_local_get,count),I(blot_backend_runtime_ir::OP_local_get,index),I(blot_backend_runtime_ir::OP_i32_sub),I(blot_backend_runtime_ir::OP_i32_const,4),I(blot_backend_runtime_ir::OP_i32_lt_u),I(blot_backend_runtime_ir::OP_br_if,1)]);if error!=blot_error::Error.none {return false,error;}var ready:blot_support::Option<u32>[256]=[blot_support::none<u32>();256];let vector,error=expression(locals,out,found.plan,found.result,ready,function.parameters.len);if error!=blot_error::Error.none {return false,error;}let error=out.append(source[at+6..at+11]);if error!=blot_error::Error.none {return false,error;}let error=out.append([I(blot_backend_runtime_ir::OP_local_get,vector),I(blot_backend_runtime_ir::OP_v128_store,4),I(blot_backend_runtime_ir::OP_local_get,index),I(blot_backend_runtime_ir::OP_i32_const,4),I(blot_backend_runtime_ir::OP_i32_add),I(blot_backend_runtime_ir::OP_local_set,index),I(blot_backend_runtime_ir::OP_br),I(blot_backend_runtime_ir::OP_end),I(blot_backend_runtime_ir::OP_end)]);if error!=blot_error::Error.none {return false,error;}let error=out.append(source[at..end+8]);if error!=blot_error::Error.none {return false,error;}copied=end+8;at=copied;}if !changed {return false,blot_error::Error.none;}let error=out.append(source[copied..]);return true,error;}
struct Kernel {plan:Plan,result:Id,end:i64}
fn kernel(module:const Module&,function:const Function&,at:i64)->blot_support::Option<Kernel> {let source=blot_backend_wasm::instructions(module,function);if !isInst(source[at],blot_backend_runtime_ir::OP_block,0) || !isInst(source[at+1],blot_backend_runtime_ir::OP_loop,0) || source[at+2].op!=blot_backend_runtime_ir::OP_local_get || source[at+3].op!=blot_backend_runtime_ir::OP_local_get || source[at+4].op!=blot_backend_runtime_ir::OP_i32_ge_u || !isInst(source[at+5],blot_backend_runtime_ir::OP_br_if,1) {return blot_support::none<Kernel>();}let index=source[at+2].operand;let count=source[at+3].operand;if source[at+6].op!=blot_backend_runtime_ir::OP_local_get {return blot_support::none<Kernel>();}let target=source[at+6].operand;if !isInst(source[at-5],blot_backend_runtime_ir::OP_local_get,target) || !isInst(source[at-4],blot_backend_runtime_ir::OP_local_get,count) || !isInst(source[at-3],blot_backend_runtime_ir::OP_i32_store,0) || !isInst(source[at-2],blot_backend_runtime_ir::OP_i32_const,0) || !isInst(source[at-1],blot_backend_runtime_ir::OP_local_set,index) {return blot_support::none<Kernel>();}if !isInst(source[at+7],blot_backend_runtime_ir::OP_local_get,index) || !isInst(source[at+8],blot_backend_runtime_ir::OP_i32_const,4) || source[at+9].op!=blot_backend_runtime_ir::OP_i32_mul || source[at+10].op!=blot_backend_runtime_ir::OP_i32_add {return blot_support::none<Kernel>();}var end=at+11;while end<min(source.len,at+64) && source[end].op!=blot_backend_runtime_ir::OP_i32_store && source[end].op!=blot_backend_runtime_ir::OP_f32_store {end+=1;}if end+7>=source.len || source[end].operand!=4 || (source[end].op!=blot_backend_runtime_ir::OP_i32_store && source[end].op!=blot_backend_runtime_ir::OP_f32_store) {return blot_support::none<Kernel>();}if !isInst(source[end+1],blot_backend_runtime_ir::OP_local_get,index) || !isInst(source[end+2],blot_backend_runtime_ir::OP_i32_const,1) || source[end+3].op!=blot_backend_runtime_ir::OP_i32_add || !isInst(source[end+4],blot_backend_runtime_ir::OP_local_set,index) || !isInst(source[end+5],blot_backend_runtime_ir::OP_br,0) || source[end+6].op!=blot_backend_runtime_ir::OP_end || source[end+7].op!=blot_backend_runtime_ir::OP_end {return blot_support::none<Kernel>();}let own=module.locals(function);if own.len>0x7fffffffffffffff-function.parameters.len {return blot_support::none<Kernel>();}let count_locals=function.parameters.len+own.len;if count_locals>128 {return blot_support::none<Kernel>();}var plan=Plan{index:index,..};var initial:Id[128]=[none;128];for &value,ordinal in initial[..count_locals] {var machine=blot_backend_runtime_ir::VT_none;if ordinal<function.parameters.len {machine=module.parameters(function)[ordinal];}else {machine=own[ordinal-function.parameters.len];}if machine!=blot_backend_runtime_ir::VT_i32 && machine!=blot_backend_runtime_ir::VT_f32 {return blot_support::none<Kernel>();}let created=plan.add(Node{op:blot_backend_runtime_ir::OP_local_get,operand:ordinal as u32,machine:machine,..});assert(created.present);value=created.value;}if !privateLocals(module,function,at+11,end,count_locals) {return blot_support::none<Kernel>();}let result=plan.parse(module,source[at+11..end],initial[..count_locals],0);if !result.present {return blot_support::none<Kernel>();}var machine=blot_backend_runtime_ir::VT_i32;if source[end].op==blot_backend_runtime_ir::OP_f32_store {machine=blot_backend_runtime_ir::VT_f32;}if plan.nodes[result.value].machine!=machine {return blot_support::none<Kernel>();}return blot_support::some(Kernel{plan:plan,result:result.value,end:end,..});}
