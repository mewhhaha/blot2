fn resolveAddress(self:const State&,original:u32)->u32,Error {if original<blot_runtime_arena_runtime::metadata_bytes && self.arena.present {return original,Error.none;}for item in self.constant_addresses.items {if original==item.original {return item.actual,Error.none;}}for item in self.addresses.items {if original>=item.original && original<item.original+item.len {return item.actual+original-item.original,Error.none;}}return 0,Error.invalid_function_reference;}
