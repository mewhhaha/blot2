import std; import i08_header_parse; import i08_header_verify; fn main(){
 let s="pub let project: forall [r: Region, s: Region, n: Nat, c: Nat, d: Domain] => Fn[static, Many, (View[r,{x:F32,y:F32,vx:F32,vy:F32},n,d], F32, Builder[s,{x:F32,y:F32},0,c,Append]), exists [e: Domain] => View[s,{x:F32,y:F32},n,e]] ! {read r, write s} requires [Le(n,c)] resources {depth: 2, frame: 256} = fn (source,dt,initial) => do:\n  let built = for i in 0..n carry (b = initial)\n    invariant [Eq(Init(b),i)] do:\n      next (builder.append(b, {x: source[i].x + source[i].vx * dt, y: source[i].y + source[i].vy * dt}))\n  return builder.freeze(built)\n";
 var original,status=i08_header_parse::parse(s);assert(status==0 && i08_header_verify::verify(original,s));var bytes:u8[>..]=[];bytes.append(s);let replacements:u8[10]=['?', 'x','n','r','0','1',' ', '\n',',',':'];var yes=0;var no=0;
 for i in bytes.len {let old=bytes[i];for c in replacements {bytes[i]=c;var p,st=i08_header_parse::parse(bytes);if st==0 {yes+=1;assert(i08_header_verify::verify(p,bytes));}else {no+=1;}if c!=old {assert(!i08_header_verify::verify(original,bytes));}}bytes[i]=old;}
 print(str("independent I08 whole-source mutations: ",yes," accepted, ",no," rejected"));}
