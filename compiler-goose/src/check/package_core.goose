recursive fn principal(self_:Walker&,reference:blot_check_core::BindingRef,expected:u32)->Error {let value,error=self_.principalMapping(reference,expected);return error;}
recursive fn principalMapping(self_:Walker&,reference:blot_check_core::BindingRef,expected:u32)->Principal,Error {let instances_before=self_.scopes.instance_variables;let rows_before=self_.scopes.instance_rows;var pairs:blot_check_package_contracts::VersionPair[16]=[default<blot_check_package_contracts::VersionPair>();16];let value,error=principalMappingValue(self_,reference,expected,pairs);if error!=blot_error::Error.none {self_.scopes.instance_variables=instances_before;self_.scopes.instance_rows=rows_before;return invalidPrincipal(),error;}return value,blot_error::Error.none;}
