fn edgeCode(edge:Edge)->u32 {match edge {after=>0,before=>1,when_true=>2,when_false=>3}}
fn less(left:Release,right:Release)->bool {if left.after!=right.after {return left.after<right.after;}if left.edge!=right.edge {return edgeCode(left.edge)<edgeCode(right.edge);}return left.local<right.local;}
fn siftReleases(values:Release[:],root:i64,count:i64) {var parent=root;loop {var child=parent*2+1;if child>=count {return;}if child+1<count && less(values[child],values[child+1]) {child+=1;}if !less(values[parent],values[child]) {return;}let swap=values[parent];values[parent]=values[child];values[child]=swap;parent=child;}}
