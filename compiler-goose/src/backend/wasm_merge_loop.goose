carries {if carry.iteration==first.value.cursor {if carry.backedge!=first_next.value {return blot_support::none<Source>();}matched|=1;}else if carry.iteration==second.value.cursor {if carry.backedge!=second_next.value {return blot_support::none<Source>();}matched|=2;}else if carry.iteration==yes.value.output {if carry.backedge!=output_next.value {return blot_support::none<Source>();}matched|=4;}else if carry.iteration==yes.value.target {if carry.backedge!=target_next.value {return blot_support::none<Source>();}matched|=8;}else if carry.backedge!=carry.iteration {return blot_support::none<Source>();}if (carry.iteration==first_exit.value.limit || carry.iteration==second_exit.value.limit) && carry.backedge!=carry.iteration {return blot_support::none<Source>();}}if matched!=15 {return blot_support::none<Source>();}return blot_support::some(Source{first_array:first.value.array,second_array:second.value.array,target:yes.value.target,first:first.value.cursor,second:second.value.cursor,output:yes.value.output,first_limit:second_exit.value.limit,second_limit:first_exit.value.limit,..});}
struct Span {word:u32,token:u32,epoch_low:u32,epoch_high:u32,length:u32,ready:blot_support::Option<u32> =blot_support::none<u32>()}
struct Plan {first_array:Span,second_array:Span,target:Span,first:u32,second:u32,output:u32,first_limit:u32,second_limit:u32,length_function:u32,next_local:u32}
