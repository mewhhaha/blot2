import mixed_parse; import mixed_fact_build; import mixed_fact_verify; fn main(){let s="fn x => do:\n  let sum = for i in 0..x carry (a=0) do:\n    let t0 = a\n    let t1 = a\n    let t2 = a\n    let t3 = a\n    let t4 = a\n    let t5 = a\n    let t6 = a\n    let t7 = a\n    let t8 = a\n    let t9 = a\n    let t10 = a\n    let t11 = a\n    let t12 = a\n    let t13 = a\n    let t14 = a\n    let t15 = a\n    let t16 = a\n    let t17 = a\n    let t18 = a\n    let t19 = a\n    let t20 = a\n    let t21 = a\n    let t22 = a\n    let t23 = a\n    let t24 = a\n    let t25 = a\n    let t26 = a\n    let t27 = a\n    let t28 = a\n    let t29 = a\n    if a < 4294967295:\n      next (a + 1)\n    else:\n      stop (a)\n  return sum\n"; var t,st=mixed_parse::parse(s);assert(st==0);let e=mixed_fact_build::build(t);assert(e.status==0 && mixed_fact_verify::verify(t,s,e.events));print("wide proof walk passed");}