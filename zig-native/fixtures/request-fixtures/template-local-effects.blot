data Count value = #Count value
type Tick is effect = { read: Unit -> U32 }
const witness = func () : Count U32 => return @panic "type witness executed"
const handled = func computation => return do:
  for request in @requests computation:
    case request of
      effect Tick.read () =>
        break 42.5
      complete value =>
        break value
entry const answer = func () => return do:
  let (#Count count, value) = @state.run (#Count 0) (func () => return do:
    let make = func () => return do:
      use previous <- @state.get witness
      let #Count old = previous
      use @state.set (#Count (@u32.add old 1))
      break @computation (func () => return do:
        use Tick.read ()
        break @panic "cancelled unconstrained computation continued"
      )
    use computation <- make ()
    let first = handled computation
    let second = handled computation
    break @f32.add first second
  )
  break @f32.add (@u32.to_f32 count) value
entry const folded = answer ()
