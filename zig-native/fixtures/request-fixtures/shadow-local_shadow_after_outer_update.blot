
type Tick is effect = Unit -> U32
entry const answer = func () => return do:
  let count = 40
  for request in @requests (@computation (func () => return do:
    use Tick ()
    break ()
  )):
    case request of
      effect Tick () =>
        count := @u32.add self 1
        let count = 2
        yield 1
      complete () =>
        break count

entry const checked_answer = answer ()
