import * as list from "std/list"

const values: List U32 = [1, 2, 3]
const packed: Array U32 = #[1, 2, 3]
const longer = [0, ...values, 4]
const squares = [x * x | x <- longer, x > 1]

entry const answer = fn () => list.fold_left U32.add 0 squares
entry const as_array = fn () => Array.from_list longer
entry const pairs = fn () => #[x * 10 + y | x <- values, y <- packed]
