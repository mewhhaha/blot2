fn resolveImplementationMemberBody(self:Engine&,ordinal:u32,member:ImplementationMember,declaration:Implementation,source:u32)->u32,blot_error::Error {
    let err=self.implementationScope(declaration);if err!=blot_error::Error.none {return 0,err;}var root:u32=0;if member.kind==blot_reuse_principal_interface::ImplementationMemberKind.type_ {let value,err=self.annotation(self.tree.node(source).b);if err!=blot_error::Error.none {return 0,err;}root=value;let err=self.unrestrictedAssociatedType(root,source);if err!=blot_error::Error.none {return 0,err;}}
    else {let index .= self.catalogs.contract_identities.get(declaration.contract);assert(index!=null);let contract=self.contracts[index];let member_index=self.memberIndex(contract,member.name);assert(member_index.present);let descriptor=self.contract_members[member_index.value];let value,err=resolveImplementationValue(self,member,declaration,contract,descriptor,source);if err!=blot_error::Error.none {return 0,err;}root=value;}
    self.implementation_members[ordinal].root=root;self.implementation_member_states.insert(ordinal,Engine_implementation_member_states_state.ready);return root,blot_error::Error.none;
}
fn resolveImplementationValue(self:Engine&,member:ImplementationMember,declaration:Implementation,contract:Contract,descriptor:ContractMember,source:u32)->u32,blot_error::Error {
    let old=equation_type_ids.alloc_slice(contract.variables.len);for value,index in self.types.list(contract.variables) {old[index]=value;}let fresh=equation_type_ids.alloc_slice(old.len);let old_rows=equation_type_ids.alloc_slice(contract.row_variables.len);let new_rows=equation_type_ids.alloc_slice(old_rows.len);
    let root,err=resolveImplementationValueBody(self,member,declaration,contract,descriptor,source,old,fresh,old_rows,new_rows);equation_type_ids.free_slice(new_rows);equation_type_ids.free_slice(old_rows);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old);return root,err;
}
fn resolveImplementationValueBody(self:Engine&,member:ImplementationMember,declaration:Implementation,contract:Contract,descriptor:ContractMember,source:u32,old:const u32[:],fresh:u32[:],old_rows:u32[:],new_rows:u32[:])->u32,blot_error::Error {
    for &variable in fresh {let value,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}variable=value;}for value,index in self.types.list(contract.row_variables) {old_rows[index]=value;}for &row in new_rows {let value,err=self.types.freshEffects();if err!=blot_error::Error.none {return 0,err;}row=value;}
    for parameter in 0..declaration.head.len {let before,err=self.types.substituteWithRows(self.types.list(contract.parameters)[parameter],old,fresh,old_rows,new_rows);if err!=blot_error::Error.none {return 0,err;}let err=self.types.unify(before,self.types.list(declaration.head)[parameter]);if err!=blot_error::Error.none {return 0,err;}}
    let selected,err=self.types.substituteWithRows(descriptor.root,old,fresh,old_rows,new_rows);if err!=blot_error::Error.none {return 0,err;}let root,err=self.normalizeAssociated(selected,source,false);if err!=blot_error::Error.none {return 0,err;}let annotation=self.tree.value_decl(source).annotation;if annotation!=0 {let required,err=self.annotation(annotation);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(root,required,annotation);if err!=blot_error::Error.none {return 0,err;}}self.bindings[member.target.binding].ty=root;return root,blot_error::Error.none;
