recursive fn captureReference(self_:Walker&,source:u32,node:blot_check_core::Node,depth:i64)->bool,Error {let reference=self_.module.reference(source);for use in self_.module.dictionary_uses {let error=self_.step(depth);if error!=blot_error::Error.none {return false,error;}if use.node!=source {continue;}let error=blot_check_dictionary_contracts::use(self_.module,source,self_.scopes);if error!=blot_error::Error.none {return false,error;}for opening in self_.scopes.openings[..self_.scopes.opening_count] {if opening.binding!=use.opening {continue;}let goals=self_.module.types.quantifierGoals(opening.quantifier);if use.quantifier!=opening.quantifier || use.goal>=goals.len {return false,blot_error::Error.invalid_artifact;}let goal=goals[use.goal];for endpoint in [goal.ty,goal.other,goal.result,goal.signature] {if endpoint==0 {continue;}let footprint,error=self_.scopes.goalFootprint(endpoint,opening.quantifier,opening.binders,self_.sealed,depth+1);if error!=blot_error::Error.none || footprint {return footprint,error;}}}}if reference.unit!=0 && reference.unit!=self_.module.unit {return false,blot_error::Error.none;}let binding=self_.module.binding(reference.binding);for opening in self_.scopes.openings[..self_.scopes.opening_count] {if opening.binding==reference.binding {return self_.unsealedType(binding.ty,depth+1);}}if binding.initializer!=0 {return self_.capturesOpening(binding.initializer,depth+1);}if binding.kind!=blot_reuse_principal_interface::Kind.local {return false,blot_error::Error.none;}let initializer,error=self_.lookupDefinition(reference.binding,depth+1);if error!=blot_error::Error.none {return false,error;}if initializer!=0 {return self_.capturesOpening(initializer,depth+1);}return false,blot_error::Error.none;}
struct CaptureChildren {walker:Walker&,found:bool=false,return_target:blot_support::Option<u32> =blot_support::none<u32>(),depth:i64}
