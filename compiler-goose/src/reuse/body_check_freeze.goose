// Complete body publication happens only after one independently owned graph.
namespace blot_reuse_body_check_cache;
import .body_check_cache;
import .dependency_snapshot;
type FrozenGraph=blot_check_frozen_types::Graph;
type OwnedGraph=blot_reuse_dependency_payload::Owned<FrozenGraph>;
struct FreezeWork {
 tree:const Tree&,checked:const blot_check_check::Checked&,catalog:Catalog,bodies:Body[:],roots:u32[:],rows:u32[:],effect_rows:u32[:],labels:u32[:],
 private:AuxiliaryGraph,schemes:blot_check_types::Scheme[>..<]&,nominals:IdentityRead[>..<]&,fields:u8[:][>..<]&,qualifications:Qualification[>..<]&,
 graph:OwnedGraph=default<OwnedGraph>(),result:Chunk?=null,
}
fn freezeChunk(tree:const Tree&,pool:const Pool&,checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>,bodies:Body[:],roots:u32[:],rows:u32[:],effect_rows:u32[:],labels:u32[:])->Chunk?,Error {
 let catalog=Catalog{ unit:checked.unit, pool:pool, nominals:checked.nominals, constructors:checked.constructors, effect_families:checked.effect_families, effect_templates:checked.effect_templates, contracts:checked.contracts, values:blot_support::some(Values{bindings:checked.bindings,tree:tree,names:names, ..}), patterns:blot_support::some<blot_check_frozen_types::Patterns>(blot_check_frozen_types::Patterns.store{checked.parameter_patterns, ..}), .. };
 var schemes:blot_check_types::Scheme[>..<]=[];var nominals:IdentityRead[>..<]=[];var fields:u8[:][>..<]=[];var qualifications:Qualification[>..<]=[];var scopes:PrivateScope[>..]=[];
 var work=FreezeWork{tree:tree,checked:checked,catalog:catalog,bodies:bodies,roots:roots,rows:rows,effect_rows:effect_rows,labels:labels,private:AuxiliaryGraph{tree,checked,bodies,scopes, ..},schemes:schemes,nominals:nominals,fields:fields,qualifications:qualifications, ..};
 let error=freezeBuild(work);work.graph.owner.deinit();for nominal in nominals {releaseOwned(nominal.name);}for name in fields {releaseOwned(name);}if error!=blot_error::Error.none {return null,error;}return work.result,blot_error::Error.none;
}
fn freezeBuild(work:FreezeWork&)->Error {
 let checked .= work.checked;let tree .= work.tree;let catalog=work.catalog;let source=blot_check_frozen_types::Source.store{checked.types, ..};
 for body in work.bodies {for local in body.local_schemes {var principal=local.principal;principal.obligations=List{..};work.schemes.push(principal);}}
 let graph,error=blot_reuse_dependency_snapshot::freezeCheckedRoots(tree,checked,work.roots,work.rows,work.schemes[..],work.effect_rows,work.labels,work.private);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }work.graph=graph;
 let nodes=work.graph.owner.mutable(work.graph.value.nodes);let extra=work.graph.owner.mutable(work.graph.value.extra);let goals=work.graph.owner.mutable(work.graph.value.quantifier_obligations);let operations=work.graph.owner.mutable(work.graph.value.operations);
 for node in nodes {if node.tag!=blot_check_types::Tag.record {continue;}for index in node.b {let at=node.a+index*2;let name,error=ownFieldName(work.fields,catalog.pool.get(extra[at]));{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }extra[at]=name;}}
 for &node in nodes {if node.tag!=blot_check_types::Tag.nominal && node.tag!=blot_check_types::Tag.projection && node.tag!=blot_check_types::Tag.type_constructor {continue;}if node.tag==blot_check_types::Tag.nominal && blot_check_types::compilerNominalArity(Identity{node.a,node.b, ..}).present {continue;}
 let is_contract=node.tag==blot_check_types::Tag.projection;let identity_=Identity{node.a,node.b, ..};let family_descriptor=node.tag==blot_check_types::Tag.nominal && catalog.familyIdentity(identity_).present;let operation_token=node.tag==blot_check_types::Tag.nominal && !family_descriptor && !catalog.identity(identity_).present;
 var slot:u32=0;if family_descriptor {let index,error=ownFamilyRead(catalog,source,work.nominals,identity_);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }slot=index;}else if operation_token {let index,error=ownOperationRead(catalog,source,work.nominals,identity_);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }slot=index;}else {let index,error=ownIdentityRead(catalog,source,work.nominals,identity_,is_contract);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }slot=index;}
 if is_contract {let member=node.c+1+extra[node.c];let name,error=ownFieldName(work.fields,catalog.pool.get(extra[member]));{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }extra[member]=name;}node.a=slot+1;node.b=0;
 }
 for &goal in goals {
 if goal.qualification_span.present {let span=goal.qualification_span.value;{ let propagated_error = require(goal.qualification_unit==checked.unit); if propagated_error != blot_error::Error.none { return propagated_error; } }var selected=blot_support::none<Qualification>();for root in tree.roots.items {let ordinal=qualificationOrdinal(tree,root,span);if !ordinal.present {continue;}let node=tree.node(root);{ let propagated_error = require(node.tag==blot_parse_ast::tag_value_decl || node.tag==blot_parse_ast::tag_type_alias_decl); if propagated_error != blot_error::Error.none { return propagated_error; } }{ let propagated_error = require(!selected.present); if propagated_error != blot_error::Error.none { return propagated_error; } }let name,error=ownFieldName(work.fields,catalog.pool.get(node.a));{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }selected=blot_support::some(Qualification{name,node.tag,ordinal.value,blot_parse_ast::declaration_traits(tree,root).private, ..});}
 { let propagated_error = require(selected.present); if propagated_error != blot_error::Error.none { return propagated_error; } }let origin=selected.value;var index:i64=-1;for prior,at in work.qualifications {if prior==origin {index=at;break;}}if index<0 {index=work.qualifications.len;work.qualifications.push(origin);}goal.qualification_span=blot_support::some(blot_parse_ast::Span{(index+1) as u32,0, ..});goal.qualification_unit=0;
 }
 if goal.name!=0 {let name,error=ownFieldName(work.fields,catalog.pool.get(goal.name));{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }goal.name=1+name;}
 if goal.kind==blot_check_types::ObligationKind.contract {let slot,error=ownIdentityRead(catalog,source,work.nominals,goal.identity,true);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }goal.identity=Identity{slot+1,0, ..};}
 else if goal.kind==blot_check_types::ObligationKind.effect_operation {let slot,error=ownOperationRead(catalog,source,work.nominals,goal.identity);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }goal.identity=Identity{slot+1,0, ..};}
 }
 { let propagated_error = require(operations.len<=4096); if propagated_error != blot_error::Error.none { return propagated_error; } }for &operation,label in operations {if label<=blot_check_types::foreign_operation {continue;}let slot,error=ownOperationRead(catalog,source,work.nominals,operation.identity);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }operation.identity=Identity{slot+1,0, ..};}
 var next_type:i64=0;var next_row:i64=0;var next_scheme:i64=0;var auxiliary_rows:i64=0;var auxiliary_labels:i64=0;
 for &body in work.bodies {
 for &local in body.local_schemes {let requirements=local.principal.obligations;local.principal=work.schemes[next_scheme];local.principal.obligations=requirements;next_scheme+=1;}
 for &fact in body.facts {fact.ty=work.roots[next_type];next_type+=1;}for &binding in body.bindings {binding.ty=work.roots[next_type];next_type+=1;}for &signature in body.signatures {signature.ty=work.roots[next_type];next_type+=1;}for &access in body.accesses {access.ty=work.roots[next_type];next_type+=1;}
 for &predicate in body.predicates {predicate.value.ty=work.roots[next_type];predicate.value.other=work.roots[next_type+1];predicate.value.result=work.roots[next_type+2];predicate.value.signature=work.roots[next_type+3];
 if predicate.value.kind==blot_check_types::ObligationKind.contract {let slot,error=ownIdentityRead(catalog,source,work.nominals,predicate.value.identity,true);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }predicate.value.identity=Identity{slot+1,0, ..};}
 else if predicate.value.kind==blot_check_types::ObligationKind.effect_operation {let slot,error=ownOperationRead(catalog,source,work.nominals,predicate.value.identity);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }predicate.value.identity=Identity{slot+1,0, ..};}next_type+=4;}
 for &row in body.closed_rows {row=work.rows[next_row];next_row+=1;}
 for &constructor in body.constructors {let identity_,error=frozenNominal(catalog,work.nominals[..],constructor.nominal);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }constructor.nominal=identity_;}
 for &field in body.fields {let identity_,error=frozenNominal(catalog,work.nominals[..],field.nominal);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }field.nominal=identity_;}
 for &step in body.accesses {let identity_,error=frozenNominal(catalog,work.nominals[..],step.nominal);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }step.nominal=identity_;let field,error=ownFieldName(work.fields,catalog.pool.get(step.field));{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }step.field=field;}
 let owner .= body.auxiliary;if owner {var dependencies:u32[>..<]=[];var constructors:blot_reuse_body_auxiliary::Constructor[>..<]=[];var mapper=AuxiliaryFreeze{catalog:catalog,source:source,nominals:work.nominals,fields:work.fields,dependencies:dependencies,constructors:constructors,roots:work.roots,rows:work.effect_rows,labels:work.labels,next_type:next_type,next_row:auxiliary_rows,next_label:auxiliary_labels,private:work.private, ..};{ let propagated_error = owner.transform(mapper); if propagated_error != blot_error::Error.none { return propagated_error; } }owner.dependencies=blot_reuse_body_auxiliary::copyOwned(dependencies[..]);owner.constructors=blot_reuse_body_auxiliary::copyOwned(constructors[..]);blot_reuse_body_auxiliary::releaseOwned(owner.origins);owner.origins=default<u32[:]>();blot_reuse_body_auxiliary::releaseOwned(owner.binding_origins);owner.binding_origins=default<u32[:]>();}
 let reads,error=bodyReads(work.graph.value,body,work.fields[..],work.nominals[..]);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }body.nominals=reads.nominals;body.type_work=reads.bytes;
 }
 let at=chunks.alloc_index(Chunk{graph:work.graph.value,graph_owner:work.graph.owner,nominals:copyOwned(work.nominals[..]),field_names:copyOwned(work.fields[..]),qualifications:copyOwned(work.qualifications[..]),bodies:copyOwned(work.bodies),live:true, ..});let owner:Chunk& =chunks[at];owner.slot=(at+1) as u32;
 for &body in owner.bodies {owner.body_bytes+=body.bytes();owner.type_work+=body.type_work;body.owner .= owner;}
 work.graph.owner=blot_reuse_dependency_payload::Owner{..};work.nominals.clear();work.fields.clear();work.result .= owner;return blot_error::Error.none;
}
fn capture(tree:const Tree&,pool:const Pool&,text:const u8[:],checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>)->Cache,Error {
 let value,error=initPooled();if error!=blot_error::Error.none {return Cache{..},error;}var result=value;let error=captureInto(tree,pool,text,checked,names,result);if error!=blot_error::Error.none {result.deinit();return Cache{..},error;}return result,blot_error::Error.none;
}
fn captureInto(tree:const Tree&,pool:const Pool&,text:const u8[:],checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>,cache:Cache&)->Error {return captureIntoResolved(tree,pool,text,checked,names,blot_support::none<AnnotationLookup>(),cache);}
fn captureIntoResolved(tree:const Tree&,pool:const Pool&,text:const u8[:],checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>,annotations:blot_support::Option<AnnotationLookup>,cache:Cache&)->Error {
 if checked.diagnostics.len!=0 || text.len==0 {return blot_error::Error.none;}{ let propagated_error = cache.compact(); if propagated_error != blot_error::Error.none { return propagated_error; } }var bodies:Body[>..<]=[];let error=captureCandidates(tree,pool,text,checked,names,annotations,cache,bodies);for &body in bodies {body.deinit();}return error;
}
fn captureCandidates(tree:const Tree&,pool:const Pool&,text:const u8[:],checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>,annotations:blot_support::Option<AnnotationLookup>,cache:Cache&,bodies:Body[>..<]&)->Error {
 for root in tree.roots.items {if tree.node(root).tag!=blot_parse_ast::tag_value_decl || cache.find(pool.get(tree.value_decl(root).name))!=null {continue;}let node_owner,present=blot_parse_ast::declaration_nodes(tree,root);if !present || node_owner.len<cache.minimum_nodes {continue;}let shape,error=syntax(tree,pool,root);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }if !shape.present {continue;}if shape.value.ids.len<cache.minimum_nodes {releaseSyntax(shape.value);continue;}
 let body,error=captureBody(tree,pool,text,checked,root,shape.value,names,annotations);releaseSyntax(shape.value);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }if body.present {bodies.push(body.value);}}
 if bodies.len==0 {return blot_error::Error.none;}var roots:u32[>..<]=[];var rows:u32[>..<]=[];var effect_rows:u32[>..<]=[];var labels:u32[>..<]=[];var auxiliary_roots=AuxiliaryRoots{roots,effect_rows,labels, ..};
 for body in bodies {for fact in body.facts {roots.push(fact.ty);}for binding in body.bindings {roots.push(binding.ty);}for signature in body.signatures {roots.push(signature.ty);}for access in body.accesses {roots.push(access.ty);}for predicate in body.predicates {roots.append([predicate.value.ty,predicate.value.other,predicate.value.result,predicate.value.signature]);}rows.append(body.closed_rows);let owner .= body.auxiliary;if owner {{ let propagated_error = owner.transform(auxiliary_roots); if propagated_error != blot_error::Error.none { return propagated_error; } }}}
 let owner,error=freezeChunk(tree,pool,checked,names,bodies[..],roots[..],rows[..],effect_rows[..],labels[..]);if error!=blot_error::Error.none {if error==blot_error::Error.out_of_memory {return error;}return blot_error::Error.none;}let chunk .= owner;if !chunk {return blot_error::Error.none;}bodies.clear();return publishChunk(cache,chunk);
}
