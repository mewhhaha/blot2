@@ -0,0 +1,51 @@
+import * as world from "game/world_storage"
+import * as library from "game/library"
+import * as host from "ink/pen/host"
+import * as owned from "./minor_support/owned"
+import * as ecs from "ink/ecs"
+import * as math from "ink/math"
+import * as view from "ink/view"
+import * as orbit from "ink/orbit"
+
+// Caller inputs vary; production with_owners still initializes every real pool.
+const initial = {
+  camera: $view.Camera {position: math.vec3 1.0 2.0 3.0, rotation: math.identity_quat},
+  orbit: $orbit.Settings {
+    start: $orbit.Orbit {focus: math.zero3, yaw: 0.0, pitch: 0.6, distance: 24.0},
+    nearest: 6.0, farthest: 120.0, lowest: 0.42, steepest: 1.45,
+    room: 100.0, overlook: true, bindings: library.orbit_bindings,
+  },
+  stash: math.vec3 4.0 0.0 5.0,
+}
+
+entry const exercise = func (read: U32 -> U32 ! {Foreign}): U32 ! {Foreign} => return do:
+  let result = #[0]
+  use finished <- world.with_owners initial (func base => return do:
+    if base.clock[0].tick != 0 or base.entities.length != 0 or base.camera[0].position.x != 1.0:
+      return @panic "owner initialization changed"
+    base.reset_salt ()
+    if base.salt.state[0].stashes != 1 or base.salt.stashes[0].x != 4.0 or base.salt.stashes[0].z != 5.0:
+      return @panic "captured reset lost its owner"
+    let id = ecs.spawn base.entities base.entities_meta
+    host.with_frame {bind_frame: world.bind_frame} base (func framed => return do:
+      framed.clock[0].tick := 17
+      @storage.push framed.frame_values 1.5
+      let kept = &framed.frame_values[0..1]
+      let owners = world.owner_access framed
+      owned.with_frame owners world.bind_frame (func nested => return do:
+        if nested.frame_values.length != 0 or nested.clock[0].tick != 17:
+          return @panic "nested frame owner mismatch"
+        @storage.push nested.frame_values 3.5
+        nested.clock[0].tick := 19
+        return ())
+      if kept[0] != 1.5 or framed.frame_values.length != 1 or base.clock[0].tick != 19:
+        return @panic "frame aliases lost their roots"
+      return ())
+    base.despawn id
+    if ecs.live base.entities id:
+      return @panic "captured despawn lost its owner"
+    use observed <- read 41
+    result[0] := observed
+    return 17)
+  let finished_unit: Unit = finished
+  return result[0]
