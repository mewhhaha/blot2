// Expression-tree evaluation over a sum-type AST arena.
import * as rng from "./rng"

const BENCH_N: U32 = 20 // BENCH_N
const PASSES: U32 = 8
const MOD: U32 = 1000003

type Expr is data = $Num { v: U32 } | $Add { l: U32, r: U32 } | $Mul { l: U32, r: U32 } | $Neg { inner: U32 }

func build_expr (max_depth: U32) -> (init_seed: rng.U64): #[Expr] =>
  let pool: #[Expr] = #[]
  let cap: U32 = 32
  let st_depth = @array.fill cap 0
  let st_lo = @array.fill cap 0
  let st_hi = @array.fill cap 0
  let st_k = @array.fill cap 0
  let st_stage = @array.fill cap 0
  let st_left = @array.fill cap 0

  let $rng.U64 { lo: slo, hi: shi } = init_seed
  st_depth[0] := max_depth
  st_lo[0] := slo
  st_hi[0] := shi
  st_stage[0] := 0
  let sp: U32 = 1
  let last_idx: U32 = 0

  for ever:
    if sp == 0:
      break
    let top = sp - 1
    let d = st_depth[top]
    let stage = st_stage[top]
    if stage == 0:
      let s = rng.xs_next (rng.u64_make st_lo[top] st_hi[top])
      if d == 0:
        pool := self.push ($Num { v: rng.xs_mod_small s 1000 })
        last_idx := pool.length - 1
        sp := self - 1
      else:
        let k = rng.xs_mod_small s 8
        let $rng.U64 { lo: nlo, hi: nhi } = s
        st_lo[top] := nlo
        st_hi[top] := nhi
        st_k[top] := k
        st_stage[top] := 1
        st_depth[sp] := d - 1
        st_lo[sp] := nlo
        st_hi[sp] := nhi
        st_stage[sp] := 0
        sp := self + 1
    else:
      if stage == 1:
        let k = st_k[top]
        if k < 1:
          pool := self.push ($Neg { inner: last_idx })
          last_idx := pool.length - 1
          sp := self - 1
        else:
          st_left[top] := last_idx
          st_stage[top] := 2
          let s2 = rng.xs_next (rng.u64_make st_lo[top] st_hi[top])
          let $rng.U64 { lo: nlo, hi: nhi } = s2
          st_depth[sp] := d - 1
          st_lo[sp] := nlo
          st_hi[sp] := nhi
          st_stage[sp] := 0
          sp := self + 1
      else:
        let l = st_left[top]
        let r = last_idx
        if st_k[top] < 5:
          pool := self.push ($Add { l, r })
        else:
          pool := self.push ($Mul { l, r })
        last_idx := pool.length - 1
        sp := self - 1
  return pool

func eval_pass (pool: #[Expr]) -> (root: U32) -> (p: U32): U32 =>
  let cap: U32 = 32
  let st_idx = @array.fill cap 0
  let st_stage = @array.fill cap 0
  let st_val = @array.fill cap 0
  st_idx[0] := root
  st_stage[0] := 0
  let sp: U32 = 1
  let res: U32 = 0

  for ever:
    if sp == 0:
      break
    let top = sp - 1
    let idx = st_idx[top]
    let stage = st_stage[top]
    case pool[idx] of
      $Num { v } => do:
        res := (v + p) % MOD
        sp := self - 1
      $Neg { inner } => do:
        if stage == 0:
          st_stage[top] := 1
          st_idx[sp] := inner
          st_stage[sp] := 0
          sp := self + 1
        else:
          res := (MOD - res) % MOD
          sp := self - 1
      $Add { l, r } => do:
        if stage == 0:
          st_stage[top] := 1
          st_idx[sp] := l
          st_stage[sp] := 0
          sp := self + 1
        else:
          if stage == 1:
            st_val[top] := res
            st_stage[top] := 2
            st_idx[sp] := r
            st_stage[sp] := 0
            sp := self + 1
          else:
            res := (st_val[top] + res) % MOD
            sp := self - 1
      $Mul { l, r } => do:
        if stage == 0:
          st_stage[top] := 1
          st_idx[sp] := l
          st_stage[sp] := 0
          sp := self + 1
        else:
          if stage == 1:
            st_val[top] := res
            st_stage[top] := 2
            st_idx[sp] := r
            st_stage[sp] := 0
            sp := self + 1
          else:
            res := rng.xs_mod (rng.u32_mul_wide st_val[top] res) MOD
            sp := self - 1
  return res

io bench (): #[U32] =>
  let pool = build_expr BENCH_N (rng.u64_from_u32 12345)
  let root = pool.length - 1
  let total: U32 = 0
  for p in 0 .. PASSES:
    total := (self + eval_pass pool root p) % MOD

  let out: #[U32] = #[]
  out := rng.emit_u32 self pool.length
  out := rng.emit_u32 self total
  return out
