// A pure getter and setter share their source type. Replacements and the
// resulting source may have different types from the original focus/source.
type Path [source, target, focus, replacement] is data = $Path {
  read: source -> focus,
  write: replacement -> source -> target,
}

func make read -> write => return $Path { read, write }
const identity = make (func value => return value) (func replacement -> _ => return replacement)

func get path -> source => return do:
  let $Path { read, write: _ } = path
  break read source

func set path -> replacement -> source => return do:
  let $Path { read: _, write } = path
  break write replacement source

func modify path -> transform -> source => return do:
  let $Path { read, write } = path
  break write (transform (read source)) source

func compose outer -> inner => return do:
  let $Path { read: read_outer, write: write_outer } = outer
  let $Path { read: read_inner, write: write_inner } = inner
  break make
    (func source => return read_inner (read_outer source))
    (func replacement -> source => return write_outer (write_inner replacement (read_outer source)) source)
