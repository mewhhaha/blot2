fn reserve(self_:Catalogs&,extra:i64)->Error {if extra<0 || extra>0x1555555555555555-self_.count {return blot_error::Error.out_of_memory;}let needed=self_.count+extra;var capacity=max(8,self_.slots.len);while needed*3>capacity*2 {if capacity>0x2000000000000000 {return blot_error::Error.out_of_memory;}capacity*=2;}if capacity!=self_.slots.len {blot_support_pooled_map::grow(self_,capacity,catalogs_slots);}return blot_error::Error.none;}
