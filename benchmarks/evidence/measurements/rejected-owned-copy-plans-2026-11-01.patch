+                } else for (m.updatePath(id)) |projection| {
+                    if (path.len == path.fields.len) return null;
+                    path.fields[path.len] = CopySource.Field.from(m, projection) orelse return null;
+                    path.len += 1;
+                }
+                const value = self.expression(m, info.value, nesting + 1) orelse return null;
+                const source = self.loop_source orelse return null;
+                if (value.kind != .tail or !source.place.eql(.{ .argument = root.place.argument, .path = path })) return null;
+                self.update_row = root.place.argument;
+                self.update_field = path;
+                self.update_vectors = value.place.argument;
+                return .{ .kind = .copied_row, .place = root.place, .vectors = value.place.argument };
+            },
+            .apply => {
+                const function = self.expression(m, n.a, nesting + 1) orelse return null;
+                const argument = self.expression(m, n.b, nesting + 1) orelse return null;
+                if (function.kind != .method) return null;
+                return self.forward(function.copy.?, &.{ .{ .kind = .argument, .place = function.place }, argument }, nesting + 1);
+            },
+            .call => {
+                var target = m.call(id).target;
+                if (target.unit == 0) target.unit = m.unit;
+                if (target.unit == 0 or target.unit > self.units.len or !self.dependency(target)) return null;
+                const owner = &self.units[target.unit - 1];
+                const body = owner.body(target.binding) orelse return null;
+                const arguments = m.call(id).arguments;
+                const parameters = owner.bodyParameters(body);
+                if (arguments.len != parameters.len or arguments.len > 8) return null;
+                var values: [8]Symbol = undefined;
+                for (arguments, 0..) |argument, index| values[index] = self.expression(m, argument, nesting + 1) orelse return null;
+                // Only a completed copy-tail callee can introduce writes here.
+                var has_row = false;
+                for (values[0..arguments.len]) |value| if (value.kind == .row) {
+                    has_row = true;
+                };
+                if (has_row) if (extractCopySource(self.units, target, self.remaining, self.active, self.depth + 1, self.resolver)) |callee| if (callee.operation == .copy_tail) {
+                    if (parameters.len != 2) return null;
+                    const operation = callee.operation.copy_tail;
+                    const row = values[operation.row];
+                    const vectors = values[operation.vectors];
+                    if (row.kind != .row or vectors.kind != .argument or vectors.place.path.len != 0) return null;
+                    for (callee.dependencies[0..callee.dependency_count]) |dependency_| if (!self.dependency(dependency_)) return null;
+                    self.copies += 1;
+                    return .{ .kind = .copied_row, .place = row.place, .vectors = vectors.place.argument, .copy = target, .copy_row = operation.row, .copy_vectors = operation.vectors, .copy_field = operation.field };
+                };
+                // Ordinary forwarding wrappers must reduce entirely to an
+                // existing selected primitive, with no side effects of their own.
+                return self.forward(target, values[0..arguments.len], nesting + 1);
+            },
+            else => return null,
+        }
+    }
+};
+fn extractCopySource(units: []const core.Module, target: core.BindingRef, remaining: *usize, active: *[8]core.BindingRef, depth: usize, resolver: ?CopyResolver) ?CopySource {
+    if (depth >= active.len or target.unit == 0 or target.unit > units.len) return null;
+    for (active[0..depth]) |prior| if (std.meta.eql(prior, target)) return null;
+    active[depth] = target;
+    const m = &units[target.unit - 1];
+    const body = m.body(target.binding) orelse return null;
+    const parameters = m.bodyParameters(body);
+    if (parameters.len == 0 or parameters.len > 8) return null;
+    const before = remaining.*;
+    var analyzer: CopyAnalyzer = .{ .units = units, .resolver = resolver, .remaining = remaining, .active = active, .depth = depth };
+    for (parameters, 0..) |parameter, index| if (!analyzer.bind(m.unit, parameter.binding, .{ .kind = .argument, .place = .{ .argument = @intCast(index) } })) return null;
+    const result = analyzer.expression(m, body.root, 0) orelse return null;
+    if (analyzer.loop_count != 1 or analyzer.pushes != 1) return null;
+    const source = analyzer.loop_source orelse return null;
+    const destination = analyzer.push_destination orelse return null;
+    const pushed = analyzer.push_value orelse return null;
+    var operation: @FieldType(CopySource, "operation") = undefined;
+    if (analyzer.loop_kind == .array) {
+        if (parameters.len != 2) return null;
+        if (result.kind != .copied_row or analyzer.update_row == null or analyzer.update_vectors == null or destination.path.len != 0 or pushed.kind != .item) return null;
+        if (source.place.argument != analyzer.update_row.? or destination.argument != analyzer.update_vectors.?) return null;
+        if (analyzer.length_count != 2 or analyzer.reads != 0 or analyzer.views != 1 or analyzer.copies != 0) return null;
+        if (!analyzer.lengths[0].place.eql(destination) or analyzer.lengths[0].after_copy or !analyzer.lengths[1].place.eql(destination) or !analyzer.lengths[1].after_copy) return null;
+        operation = .{ .copy_tail = .{ .row = analyzer.update_row.?, .vectors = analyzer.update_vectors.?, .field = analyzer.update_field } };
+    } else {
+        if (result.kind != .unit or analyzer.update_row != null or source.place.path.len != 0) return null;
+        if (analyzer.length_count != 1 or analyzer.reads != 1 or analyzer.views != 0) return null;
+        if (!analyzer.lengths[0].place.eql(source.place) or analyzer.lengths[0].after_copy) return null;
+        if (pushed.copy != null and analyzer.copies != 1) return null;
+        if (pushed.copy == null and analyzer.copies != 0) return null;
+        operation = .{ .append_rows = .{ .rows = source.place.argument, .output = destination, .vectors = pushed.vectors, .copy = pushed.copy, .copy_row = pushed.copy_row, .copy_vectors = pushed.copy_vectors, .copy_field = pushed.copy_field } };
+    }
+    return .{ .target = target, .root = body.root, .operation = operation, .dependencies = analyzer.dependencies, .dependency_count = analyzer.dependency_count, .visits = before - remaining.* };
+}
+pub fn ownedCopySource(units: []const core.Module, target: core.BindingRef, remaining: *usize) ?CopySource {
+    var active: [8]core.BindingRef = undefined;
+    return extractCopySource(units, target, remaining, &active, 0, null);
+}
+
+pub fn ownedCopySourceResolved(units: []const core.Module, target: core.BindingRef, remaining: *usize, resolver: CopyResolver) ?CopySource {
+    var active: [8]core.BindingRef = undefined;
+    return extractCopySource(units, target, remaining, &active, 0, resolver);
+}
