fn artifact_decode(bytes: const u8[:], b: CoreBuilder, diags: Diagnostic[>..]&) -> bool {
    if bytes.len < HEADER || bytes.len > LIMIT_ARTIFACT { return invalid(diags, 1); }
    if get32(bytes, 0) != MAGIC { return invalid(diags, 2); }
    if get32(bytes, 4) != SCHEMA || get32(bytes, 8) != SEM_POLICY ||
        get32(bytes, 12) != OPT_POLICY || get32(bytes, 16) != ABI_VERSION {
        return incompatible(diags);
    }
    if get32(bytes, 20) != 0 || get32(bytes, 24) != bytes.len || get32(bytes, 28) != TABLES {
        return invalid(diags, 3);
    }
    for i in 32 { if bytes[64 + i] != ABI_HASH[i] { return incompatible(diags); } }
    let digest = k1hash::blake3(bytes[64..]);
    for i in 8 { if get32(bytes, (32 + i * 4) as u32) != digest.words[i] { return invalid(diags, 4); } }
    var required: u64 = HEADER;
    let n_layout_premises = get32(bytes, 96);
    if n_layout_premises < 1 || n_layout_premises > 4194304 || b.layout_premises.len != 1 { return invalid(diags, 10); }
    required += (n_layout_premises as u64) * 8;
    let n_dictionary_realizations = get32(bytes, 100);
    if n_dictionary_realizations < 1 || n_dictionary_realizations > 4194304 || b.dictionary_realizations.len != 1 { return invalid(diags, 11); }
    required += (n_dictionary_realizations as u64) * 28;
    let n_static_relocations = get32(bytes, 104);
    if n_static_relocations < 1 || n_static_relocations > 4194304 || b.static_relocations.len != 1 { return invalid(diags, 12); }
    required += (n_static_relocations as u64) * 16;
    let n_static_objects = get32(bytes, 108);
    if n_static_objects < 1 || n_static_objects > 4194304 || b.static_objects.len != 1 { return invalid(diags, 13); }
    required += (n_static_objects as u64) * 52;
    let n_adapter_captures = get32(bytes, 112);
    if n_adapter_captures < 1 || n_adapter_captures > 4194304 || b.adapter_captures.len != 1 { return invalid(diags, 14); }
    required += (n_adapter_captures as u64) * 12;
    let n_callable_adapters = get32(bytes, 116);
    if n_callable_adapters < 1 || n_callable_adapters > 4194304 || b.callable_adapters.len != 1 { return invalid(diags, 15); }
    required += (n_callable_adapters as u64) * 28;
    let n_schemas = get32(bytes, 120);
    if n_schemas < 1 || n_schemas > 4194304 || b.schemas.len != 1 { return invalid(diags, 16); }
