 for &fact in body.facts {fact.ty=roots[next_type];next_type+=1;}for &binding in body.bindings {binding.ty=roots[next_type];next_type+=1;}for &signature in body.signatures {signature.ty=roots[next_type];next_type+=1;}for &access in body.accesses {access.ty=roots[next_type];next_type+=1;}
 for &predicate in body.predicates {predicate.value.ty=roots[next_type];predicate.value.other=roots[next_type+1];predicate.value.result=roots[next_type+2];predicate.value.signature=roots[next_type+3];
 if predicate.value.kind==blot_check_types::ObligationKind.contract {let slot,error=ownIdentityRead(catalog,source,work.nominals,predicate.value.identity,true);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }predicate.value.identity=Identity{slot+1,0, ..};}
 else if predicate.value.kind==blot_check_types::ObligationKind.effect_operation {let slot,error=ownOperationRead(catalog,source,work.nominals,predicate.value.identity);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }predicate.value.identity=Identity{slot+1,0, ..};}next_type+=4;}
