import * as array from "std/array"
entry const run = fn (seed: U32) -> U32 => do:
  let bins = array.fill 256 0
  let state = seed
  for ignored in 0..16384:
    state := self * 1664525 + 1013904223
    let bin = state / 65536 % 256
    bins[bin] := bins[bin] + 1
  let total = 0
  for index in 0..256:
    total := self + bins[index] * (index + 1)
  break total
