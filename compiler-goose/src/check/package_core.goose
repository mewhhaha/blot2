fn copyGoal(solver:blot_check_scheme_equations::Solver&,copy:blot_check_check_scheme_import::Copier&,source:blot_check_core::Obligation)->blot_check_core::Obligation,Error {var goal=source;let value,error=solver.copy(copy,source.ty);if error!=Error.none {return goal,solver.readerError(error);}goal.ty=value;let value,error=solver.copy(copy,source.other);if error!=Error.none {return goal,solver.readerError(error);}goal.other=value;let value,error=solver.copy(copy,source.result);if error!=Error.none {return goal,solver.readerError(error);}goal.result=value;let value,error=solver.copy(copy,source.signature);if error!=Error.none {return goal,solver.readerError(error);}goal.signature=value;return goal,Error.none;}
fn sharedGoalValue(self:Walker&,solver:blot_check_scheme_equations::Solver&,owner:const Module&,binding:u32,declaration:blot_check_core::Binding,given:blot_check_core::Obligation,wanted:blot_support::Option<blot_check_core::Obligation>,memo:blot_support::Option<blot_check_scheme_equations::SharedGoal>,parts:const u32[:],maps:ImportMaps&,depth:i64)->bool,Error {var graph=default<blot_check_frozen_types::Graph>();let imported,error=solver.importer(owner,graph,declaration.scheme,maps.tables());if error!=Error.none {return false,solver.readerError(error);}var copy=imported;let variables=owner.types.list(declaration.public_variables);for index in 0..variables.len {let formal=variables[index];if !wordContains(owner.types.list(declaration.scheme.variables),formal) {return false,Error.invalid_artifact;}let fresh .= copy.mapping.get(formal);if !fresh {return false,Error.invalid_artifact;}let error=solver.unify(fresh,parts[index]);if error!=Error.none {return false,solver.readerError(error);}}let rows=owner.types.list(declaration.public_rows);for index in 0..rows.len {let formal=rows[index];if !wordContains(owner.types.list(declaration.scheme.row_variables),formal) {return false,Error.invalid_artifact;}let carrier=self.module.types.node(parts[variables.len+index]);if carrier.tag!=blot_check_types::Tag.function || carrier.a!=blot_check_types::unit || carrier.b!=blot_check_types::unit {return false,Error.invalid_artifact;}copy.row_variables.insert(formal,carrier.c);if copy.row_variables.failure!=Error.none {solver.oom=true;return false,Error.invalid_artifact;}}
