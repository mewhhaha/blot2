// Benchmarks Game binary-trees: direct recursion over a fresh pre-sized
// stack-backed arena per tree (reclaimed in one store on function exit).
import * as rng from "./rng"

const BENCH_N: U32 = 17 // BENCH_N
const MINDEPTH: U32 = 4
const NONE: U32 = 0xFFFFFFFF

type TNode is data = $TNode { l: U32, r: U32 }

func build_tree (pool: own #[TNode]) -> (d: U32): (#[TNode], U32) =>
  if d == 0:
    let idx = pool.length
    pool := self.push ($TNode { l: NONE, r: NONE })
    return (pool, idx)
  let (p1, l) = build_tree pool (d - 1)
  let (p2, r) = build_tree p1 (d - 1)
  let idx = p2.length
  let p3 = p2.push ($TNode { l, r })
  return (p3, idx)

func check_tree (pool: #[TNode]) -> (idx: U32): U32 =>
  let nd = pool[idx]
  if nd.l == NONE:
    return 1
  return 1 + check_tree pool nd.l + check_tree pool nd.r

func tree_check (depth: U32): U32 =>
  let pool: #[TNode] = Array.with_capacity ((1 << (depth + 1)) - 1)
  let (p, root) = build_tree pool depth
  return check_tree p root

io bench (): #[U32] =>
  let out: #[U32] = #[]
  out := rng.emit_u32 self (tree_check (BENCH_N + 1))

  let long_cap = (1 << (BENCH_N + 1)) - 1
  let (long_pool, lroot) = build_tree (Array.with_capacity long_cap) BENCH_N

  let d: U32 = MINDEPTH
  for ever:
    if d > BENCH_N:
      break
    let iters: U32 = 1 << (BENCH_N - d + MINDEPTH)
    let sum: U32 = 0
    for _ in 0 .. iters:
      sum := self + tree_check d
    out := rng.emit_u32 self iters
    out := rng.emit_u32 self d
    out := rng.emit_u32 self sum
    d := self + 2

  out := rng.emit_u32 self (check_tree long_pool lroot)
  return out
