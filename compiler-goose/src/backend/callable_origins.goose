fn constructionLayout(module: const Module&,origin: blot_backend_wasm::TableOrigin) -> blot_support::Option<u32> {let fact = construction(module,origin);if !fact.present {return blot_support::none<u32>();}return blot_support::some(fact.value.layout);}
fn resultConstruction(module: const Module&,id: u32) -> blot_support::Option<Construction> {
