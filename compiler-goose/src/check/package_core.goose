fn sourceRowsValue(self_:Walker&,pending:WordBuffer&)->Error {for row,id in self_.module.types.effects.rows {let error=self_.step(0);if error!=blot_error::Error.none {return error;}match row.tail {variable payload=>{let error=pending.push(id as u32,word_runs);if error!=blot_error::Error.none {return error;}},_=>{},}}let error=self_.sortRows(pending.items);if error!=blot_error::Error.none {return error;}let error=self_.admission.saveSourceRows(self_.module,pending.items);if error!=blot_error::Error.none {return error;}let index=self_.admission.source_rows.items[self_.admission.source_rows.len-1];self_.source_row_index=index.rows;self_.has_source_row_index=true;return blot_error::Error.none;}
