import std;import os;import source_resolver;import semantic_job;
fn main(){let a=args();if a.len!=7 {exit(2);}var root=source_resolver::open_root(a[1],a[2]);if root.status!=0 {exit(3);}let fault:u32=if a[5]=="none" {0} else if a[5]=="after-read" {1} else if a[5]=="after-check" {2} else if a[5]=="after-emit" {3} else {4};let depth:u32=if a[6]=="depth" {0} else {128};let out=semantic_job::compile(root.root,a[3],a[4],0,depth,0,4294967295,fault);let closed=source_resolver::close_root(root.root);if !closed || out.status!=0 || out.wasm.len==0 {exit(4);}write_stdout(out.wasm);}
