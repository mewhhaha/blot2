struct SpawnVisitor { module: const Module&, units: const ModuleRef[:], node: blot_check_core::Node, remaining: i64& }
fn append(self_: SpawnVisitor&, child: u32) -> Error { if child == 0 { return blot_error::Error.none; } let value, err = spawnValue(self_.module, child, self_.units, self_.remaining, 0); if err != blot_error::Error.none { return blot_error::Error.plan_limit; } if !value.present || (self_.node.tag == blot_check_core::Tag.apply && self_.node.a == child) || (self_.node.tag == blot_check_core::Tag.bind && self_.node.b == child) { return blot_error::Error.none; } return blot_error::Error.plan_limit; }
fn appendSlice(self_: SpawnVisitor&, children: const u32[:]) -> Error { for child in children { let err = self_.append(child); if err != blot_error::Error.none { return err; } } return blot_error::Error.none; }
fn spawnCapture(module: const Module&, units: const ModuleRef[:], site: u32, group: u32, action: u32, remaining: i64&, workspace: blot_check_scheme_equations::Workspace?) -> Error { let closure, err = callable(module, action); if err != blot_error::Error.none { return err; } let owner, err = groupOwner(module, units, group, remaining); if err != blot_error::Error.none { return err; } let found, err = inside(module, owner, site, remaining, 0); if err != blot_error::Error.none { return err; } if !found { return blot_error::Error.invalid_artifact; } var scanner = Captures { workspace: workspace, module: module, units: units, destination: owner, remaining: remaining , ..}; for body in module.bodies { if body.root == 0 { continue; } let found, err = inside(module, body.root, site, remaining, 0); if err != blot_error::Error.none { return err; } if found { let err = scanner.rows(body.closed_rows); if err != blot_error::Error.none { return err; } } } return scanner.check(closure); }
fn spawnUses(module: const Module&, units: const ModuleRef[:], id: u32, remaining: i64&, workspace: blot_check_scheme_equations::Workspace?) -> Error {
    let node = module.node(id); if node.tag == blot_check_core::Tag.call { let call = module.call(id); let owner, err = ownerUnit(module, call.target.unit, units); if err != blot_error::Error.none { return err; } if !owner { return blot_error::Error.invalid_artifact; } if owner.binding(call.target.binding).capability_flow == blot_check_capability_flow::Contract.spawn_task { let err = spawnWrapper(owner, call.target.binding, units); if err != blot_error::Error.none { return err; } if call.arguments.len != 2 { return blot_error::Error.invalid_artifact; } let err = spawnCapture(module, units, id, call.arguments[0], call.arguments[1], remaining, workspace); if err != blot_error::Error.none { return err; } } } else if node.tag == blot_check_core::Tag.apply { let function, err = spawnValue(module, node.a, units, remaining, 0); if err != blot_error::Error.none { return err; } if function.present && function.value.group != 0 { let err = spawnCapture(module, units, id, function.value.group, node.b, remaining, workspace); if err != blot_error::Error.none { return err; } } }
    var visitor = SpawnVisitor { module, units, node, remaining , ..}; let err = blot_eval_body_recipe::appendChildren(visitor, module, id, false); if err != blot_error::Error.none { return blot_error::Error.invalid_artifact; } return blot_error::Error.none;
}
fn receiveType(module: const Module&, input: u32, output: u32, remaining: i64&) -> Error { let shape = module.types.node(input); if shape.tag != blot_check_types::Tag.product { let args, err = handle(module, input); if err != blot_error::Error.none { return err; } return same(module, module.types.node(args[1]).b, output, remaining); } let result = module.types.node(output); if result.tag != blot_check_types::Tag.product || shape.b == 0 || shape.b > 16 || shape.b != result.b { return blot_error::Error.invalid_artifact; } let values = module.types.list(blot_check_types::List { shape.a, shape.b , ..}); let results = module.types.list(blot_check_types::List { result.a, result.b , ..}); for item, index in values { let args, err = handle(module, item); if err != blot_error::Error.none { return err; } let err = same(module, module.types.node(args[1]).b, results[index], remaining); if err != blot_error::Error.none { return err; } } return blot_error::Error.none; }
fn validate(module: const Module&) -> Error { return validateContext(module, []); }
fn validateContext(module: const Module&, units: const ModuleRef[:]) -> Error { return validateContextWorkspace(module, units, null); }
fn validateContextWorkspace(module: const Module&, units: const ModuleRef[:], workspace: blot_check_scheme_equations::Workspace?) -> Error { var spawn_contracts = false; for binding in module.bindings { if binding.capability_flow == blot_check_capability_flow::Contract.spawn_task { spawn_contracts = true; break; } } if !spawn_contracts { for unit_owner_ref in units { let unit: const blot_check_core::Module&  = unit_owner_ref.value; for binding in unit.bindings { if binding.capability_flow == blot_check_capability_flow::Contract.spawn_task { spawn_contracts = true; break; } } if spawn_contracts { break; } } } return validateSpawnContextWorkspace(module, units, workspace, spawn_contracts); }
fn validateBatchWorkspace(module: const Module&, batch: const blot_check_frozen_core_validation::Batch&, workspace: blot_check_scheme_equations::Workspace?) -> Error { return validateSpawnContextWorkspace(module, batch.units(), workspace, batch.hasSpawnContracts(module)); }
fn validateSpawnContextWorkspace(module: const Module&, units: const ModuleRef[:], workspace: blot_check_scheme_equations::Workspace?, spawn_contracts: bool) -> Error { var remaining: i64 = 65536; for node, id in module.nodes { if node.tag == blot_check_core::Tag.task { let err = validateOperationContextWorkspace(module, units, id as u32, remaining, workspace); if err != blot_error::Error.none { return err; } } if spawn_contracts && id != 0 { let err = spawnUses(module, units, id as u32, remaining, workspace); if err != blot_error::Error.none { return err; } } } if spawn_contracts { for body in module.bodies { if body.root == 0 { continue; } let value, err = spawnValue(module, body.root, units, remaining, 0); if err != blot_error::Error.none { return err; } if value.present && (body.is_function || value.value.group != 0 || module.binding(body.binding).capability_flow != blot_check_capability_flow::Contract.spawn_task) { return blot_error::Error.invalid_artifact; } } } return blot_error::Error.none; }
fn validateOperation(module: const Module&, id: u32, remaining: i64&) -> Error { return validateOperationContext(module, [], id, remaining); }
fn validateOperationContext(module: const Module&, units: const ModuleRef[:], id: u32, remaining: i64&) -> Error { return validateOperationContextWorkspace(module, units, id, remaining, null); }
fn validateOperationContextWorkspace(module: const Module&, units: const ModuleRef[:], id: u32, remaining: i64&, workspace: blot_check_scheme_equations::Workspace?) -> Error {
    let node = module.node(id); if node.tag != blot_check_core::Tag.task { return blot_error::Error.invalid_artifact; } let err = step(remaining, 0); if err != blot_error::Error.none { return err; } let operation, err = blot_check_task_types::opFromCode(node.c); if err != blot_error::Error.none || node.op != blot_check_core::Op.none || node.b != blot_check_task_types::arity(operation) { return blot_error::Error.invalid_artifact; } let operands = module.children(id);
    match operation {
        scope => { let arrow, err = once(module, operands[0]); if err != blot_error::Error.none { return err; } if !blot_check_task_types::isGroup(module.types, arrow.a) { return blot_error::Error.invalid_artifact; } if module.node(operands[0]).tag == blot_check_core::Tag.closure { let err = same(module, arrow.a, module.closure(operands[0]).parameter.ty, remaining); if err != blot_error::Error.none { return err; } } else if !blot_check_task_types::scopeCallback(module.types, module.typeOf(operands[0])).present { return blot_error::Error.invalid_artifact; } return same(module, arrow.b, node.ty, remaining); },
        spawn => { let group = module.typeOf(operands[0]); if !blot_check_task_types::isGroup(module.types, group) { return blot_error::Error.invalid_artifact; } let arrow, err = once(module, operands[1]); if err != blot_error::Error.none { return err; } if arrow.a != blot_check_types::unit { return blot_error::Error.invalid_artifact; } let args, err = handle(module, node.ty); if err != blot_error::Error.none { return err; } let err = same(module, group, args[0], remaining); if err != blot_error::Error.none { return err; } let err = same(module, module.types.node(module.typeOf(operands[1])).a, args[1], remaining); if err != blot_error::Error.none { return err; } let formal, err = spawnFormal(module, id, units); if err != blot_error::Error.none { return err; } if !formal { return spawnCapture(module, units, id, operands[0], operands[1], remaining, workspace); } },
        join, cancel, receive => { if operation == blot_check_task_types::Op.receive && module.types.node(module.typeOf(operands[0])).tag == blot_check_types::Tag.variable { let requirement, err = receiveRequirement(module, id, remaining); return err; } let args, err = handle(module, module.typeOf(operands[0])); if err != blot_error::Error.none { return err; } var result = blot_check_types::unit; if operation != blot_check_task_types::Op.cancel { result = module.types.node(args[1]).b; } return same(module, result, node.ty, remaining); },
        collect => { let input = module.types.node(module.typeOf(operands[0])); let output = module.types.node(node.ty); if input.tag != blot_check_types::Tag.product || output.tag != blot_check_types::Tag.product || input.b == 0 || input.b > 16 || input.b != output.b { return blot_error::Error.invalid_artifact; } let values = module.types.list(blot_check_types::List { input.a, input.b , ..}); let results = module.types.list(blot_check_types::List { output.a, output.b , ..}); for item, index in values { let args, err = handle(module, item); if err != blot_error::Error.none { return err; } let err = same(module, module.types.node(args[1]).b, results[index], remaining); if err != blot_error::Error.none { return err; } } },
        split => { let partition, err = blot_check_task_regions::partition(module, id); if err != blot_error::Error.none { return err; } let arrow, err = once(module, operands[2]); if err != blot_error::Error.none { return err; } let output = module.types.node(node.ty); if output.tag != blot_check_types::Tag.product || output.b != 2 { return blot_error::Error.invalid_artifact; } let results = module.types.list(blot_check_types::List { output.a, output.b , ..}); let err = same(module, module.typeOf(operands[0]), results[0], remaining); if err != blot_error::Error.none { return err; } return same(module, arrow.b, results[1], remaining); },
        read, write => { let view = blot_check_task_types::viewInfo(module.types, module.typeOf(operands[0])); if !view.present { return blot_error::Error.invalid_artifact; } let element = module.types.node(view.value.payload).a; if operation == blot_check_task_types::Op.read { let affine, err = blot_check_usage_check::affineNominal(module.types, module.nominals, element); if err != blot_error::Error.none || affine { return blot_error::Error.invalid_artifact; } let issue, err = blot_check_task_types::captureIssue(module.types, element, false, remaining, 0); if err != blot_error::Error.none || issue.present { return blot_error::Error.invalid_artifact; } } if module.typeOf(operands[1]) != blot_check_types::u32_type { return blot_error::Error.invalid_artifact; } var result = element; if operation == blot_check_task_types::Op.write { let err = same(module, element, module.typeOf(operands[2]), remaining); if err != blot_error::Error.none { return err; } let issue, err = blot_check_task_types::captureIssue(module.types, element, false, remaining, 0); if err != blot_error::Error.none || issue.present { return blot_error::Error.invalid_artifact; } result = blot_check_types::unit; } return same(module, result, node.ty, remaining); },
    } return blot_error::Error.none;
}
struct Captures { workspace: blot_check_scheme_equations::Workspace? = null, module: const Module&, units: const ModuleRef[:], destination: u32, closed_rows: u32[4096], row_count: i64 = 0, remaining: i64&, locals: u32[4096], local_count: i64 = 0, seen: u32[4096], seen_count: i64 = 0 }
fn rows(self_: Captures&, source: blot_check_types::List) -> Error { let values = self_.module.types.list(source); if values.len > self_.closed_rows.len - self_.row_count { return blot_error::Error.invalid_artifact; } for value, index in values { self_.closed_rows[self_.row_count + index] = value; } self_.row_count += values.len; return blot_error::Error.none; }
fn local(self_: Captures&, binding: u32) -> Error { let err = step(self_.remaining, 0); if err != blot_error::Error.none { return err; } if contains(self_.locals[..self_.local_count], binding) { return blot_error::Error.none; } if self_.local_count == self_.locals.len { return blot_error::Error.invalid_artifact; } self_.locals[self_.local_count] = binding; self_.local_count += 1; return blot_error::Error.none; }
fn definitions(self_: Captures&, id: u32, depth: i64) -> Error { let err = step(self_.remaining, depth); if err != blot_error::Error.none { return err; } let node = self_.module.node(id); if node.tag == blot_check_core::Tag.bind { let err = self_.local(node.a); if err != blot_error::Error.none { return err; } } if node.tag == blot_check_core::Tag.closure { let err = self_.local(self_.module.closures[node.a].parameter.binding); if err != blot_error::Error.none { return err; } return self_.definitions(self_.module.closures[node.a].body, depth + 1); } return self_.children(id, depth + 1, true); }
fn references(self_: Captures&, id: u32, depth: i64) -> Error {
    if id == 0 { return blot_error::Error.none; } let err = step(self_.remaining, depth); if err != blot_error::Error.none { return err; } if contains(self_.seen[..self_.seen_count], id) { return blot_error::Error.none; } if self_.seen_count == self_.seen.len { return blot_error::Error.invalid_artifact; } self_.seen[self_.seen_count] = id; self_.seen_count += 1; let node = self_.module.node(id);
    if node.tag == blot_check_core::Tag.call { let err = blot_check_staging_core::taskNamedContextWorkspace(self_.module, self_.units, id, false, self_.remaining, self_.workspace); if err != blot_error::Error.none { return err; } let signature = self_.module.call(id).callee_type; let issue, err = blot_check_task_types::captureIssueWithRows(self_.module.types, signature, false, self_.remaining, depth + 1, self_.closed_rows[..self_.row_count]); if err != blot_error::Error.none || issue.present { return blot_error::Error.invalid_artifact; } }
    if node.tag == blot_check_core::Tag.reference { let reference = self_.module.reference(id); if reference.unit != 0 && reference.unit != self_.module.unit { let issue, err = blot_check_task_types::captureIssue(self_.module.types, node.ty, false, self_.remaining, depth + 1); if err != blot_error::Error.none || issue.present { return blot_error::Error.invalid_artifact; } return blot_check_staging_core::taskNamedContextWorkspace(self_.module, self_.units, id, true, self_.remaining, self_.workspace); } if contains(self_.locals[..self_.local_count], reference.binding) { return blot_error::Error.none; } let binding = self_.module.bindings[reference.binding]; var capture_type = binding.ty;
        if binding.kind == blot_reuse_principal_interface::Kind.global || binding.kind == blot_reuse_principal_interface::Kind.external { capture_type = node.ty; let err = blot_check_staging_core::taskNamedContextWorkspace(self_.module, self_.units, id, true, self_.remaining, self_.workspace); if err != blot_error::Error.none { return err; } } let issue, err = blot_check_task_types::captureIssue(self_.module.types, capture_type, false, self_.remaining, depth + 1); if err != blot_error::Error.none || issue.present { return blot_error::Error.invalid_artifact; } let err = enclosing(self_.module, capture_type, self_.destination, self_.remaining, depth + 1); if err != blot_error::Error.none { return err; }
        if blot_check_task_types::isGroup(self_.module.types, capture_type) { let owner, err = groupOwner(self_.module, self_.units, id, self_.remaining); if err != blot_error::Error.none { return err; } let found, err = inside(self_.module, owner, self_.destination, self_.remaining, depth + 1); if err != blot_error::Error.none || !found { return blot_error::Error.invalid_artifact; } } let captured = self_.module.types.node(capture_type); let data_scalar = captured.tag == blot_check_types::Tag.unit || captured.tag == blot_check_types::Tag.boolean || captured.tag == blot_check_types::Tag.unsigned32 || captured.tag == blot_check_types::Tag.floating32;
        if binding.initializer != 0 && !data_scalar { if self_.module.node(binding.initializer).tag == blot_check_core::Tag.closure { let err = self_.definitions(binding.initializer, depth + 1); if err != blot_error::Error.none { return err; } } let err = self_.references(binding.initializer, depth + 1); if err != blot_error::Error.none { return err; } } return blot_error::Error.none;
    }
    if node.tag == blot_check_core::Tag.closure { let closure = self_.module.closures[node.a]; let previous = self_.row_count; let err = self_.rows(closure.closed_rows); if err != blot_error::Error.none { return err; } let err = self_.references(closure.body, depth + 1); self_.row_count = previous; return err; } return self_.children(id, depth + 1, false);
}
struct CaptureVisitor { scanner: Captures&, depth: i64, definitions: bool }
fn append(self_: CaptureVisitor&, child: u32) -> Error { if child == 0 { return blot_error::Error.none; } var err = blot_error::Error.none; if self_.definitions { err = self_.scanner.definitions(child, self_.depth); } else { err = self_.scanner.references(child, self_.depth); } if err != blot_error::Error.none { return blot_error::Error.plan_limit; } return blot_error::Error.none; }
fn appendSlice(self_: CaptureVisitor&, children: const u32[:]) -> Error { for child in children { let err = self_.append(child); if err != blot_error::Error.none { return err; } } return blot_error::Error.none; }
fn children(self_: Captures&, id: u32, depth: i64, definitions: bool) -> Error { var visitor = CaptureVisitor { self_, depth, definitions , ..}; let err = blot_eval_body_recipe::appendChildren(visitor, self_.module, id, false); if err != blot_error::Error.none { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; }
fn check(self_: Captures&, closure: u32) -> Error { let err = self_.definitions(closure, 0); if err != blot_error::Error.none { return err; } return self_.references(closure, 0); }
