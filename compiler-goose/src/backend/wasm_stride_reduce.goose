// Literal-match reductions retain the original checked loop outside complete safe ranges.
namespace blot_backend_wasm_stride_reduce;
import check.core;
import check.types;
import .runtime_ir;
import .collection_ops;
import .wasm_merge_loop;
import .optimizer_buffers;
import support.error;
import support.option;
type Error=blot_error::Error;
type Core=blot_check_core::Module;
type Tag=blot_check_core::Tag;
type Instruction=blot_backend_runtime_ir::Instruction;
type Op=blot_backend_runtime_ir::Op;
type Output=blot_backend_runtime_ir::DetachedBody;
type Builder=blot_backend_optimizer_buffers::Builder;
struct Source {array:u32,cursor:u32,limit:u32,last:u32,count:u32,stride:u32,bits:u32}
fn reference(module:const Core&,id:u32)->blot_support::Option<u32> {return blot_backend_wasm_merge_loop::reference(module,id);}
fn scalar(module:const Core&,id:u32)->blot_support::Option<u32> {return blot_backend_wasm_merge_loop::scalarReference(module,id);}
fn isScalar(module:const Core&,id:u32,binding:u32)->bool {let value=scalar(module,id);return value.present && value.value==binding;}
fn only(module:const Core&,id:u32)->u32 {return blot_backend_wasm_merge_loop::only(module,id);}
fn empty(module:const Core&,id:u32)->bool {return blot_backend_wasm_merge_loop::empty(module,id);}
fn merged(module:const Core&,id:u32,yes:u32,no:u32)->blot_support::Option<u32> {return blot_backend_wasm_merge_loop::merged(module,id,yes,no);}
struct Increment {binding:u32,next:u32,amount:u32}
fn increment(module:const Core&,id:u32)->blot_support::Option<Increment> {let bind=module.node(id);if bind.tag!=blot_check_core::Tag.bind {return blot_support::none<Increment>();}let add=module.node(bind.b);if add.tag!=blot_check_core::Tag.scalar || add.op!=blot_check_core::Op.add || add.c!=0 || add.ty!=blot_check_types::u32_type {return blot_support::none<Increment>();}let amount=module.node(add.b);if amount.tag!=blot_check_core::Tag.constant || amount.ty!=blot_check_types::u32_type {return blot_support::none<Increment>();}let binding=scalar(module,add.a);if !binding.present {return blot_support::none<Increment>();}return blot_support::some(Increment{binding:binding.value,next:bind.a,amount:amount.a,..});}
fn source(module:const Core&,id:u32)->blot_support::Option<Source> {let info=module.loopInfo(id);let carries=module.loopCarries(id);if info.kind!=blot_check_core::LoopKind.forever || !info.can_exit || carries.len>32 || module.node(info.body).tag!=blot_check_core::Tag.suite {return blot_support::none<Source>();}let children=module.children(info.body);if children.len!=3 {return blot_support::none<Source>();}let exit=module.node(children[0]);if exit.tag!=blot_check_core::Tag.if_stmt || !empty(module,exit.c) || module.branchMerges(children[0]).len!=0 {return blot_support::none<Source>();}let condition=module.node(exit.a);if condition.tag!=blot_check_core::Tag.scalar || condition.op!=blot_check_core::Op.less || condition.c!=0 {return blot_support::none<Source>();}let cursor=scalar(module,condition.b);let limit=scalar(module,condition.a);if !cursor.present || !limit.present {return blot_support::none<Source>();}let stop=only(module,exit.b);let done=module.node(stop);if done.tag!=blot_check_core::Tag.break_ || done.a!=id || done.op!=blot_check_core::Op.none {return blot_support::none<Source>();}let values=module.breakValues(stop);if values.len!=carries.len {return blot_support::none<Source>();}for value,index in values {let binding=reference(module,value);if !binding.present || binding.value!=carries[index].iteration {return blot_support::none<Source>();}}let choose=module.node(children[1]);if choose.tag!=blot_check_core::Tag.if_stmt || !empty(module,choose.c) || module.branchMerges(children[1]).len!=2 || module.node(choose.b).tag!=blot_check_core::Tag.suite {return blot_support::none<Source>();}let equal=module.node(choose.a);if equal.tag!=blot_check_core::Tag.scalar || equal.op!=blot_check_core::Op.equal || equal.c!=0 {return blot_support::none<Source>();}let read=module.node(equal.a);let bits=module.node(equal.b);if read.tag!=blot_check_core::Tag.array_op || module.arrayOperation(equal.a)!=blot_backend_collection_ops::Op.get || read.ty!=blot_check_types::u32_type || bits.tag!=blot_check_core::Tag.constant || bits.ty!=blot_check_types::u32_type {return blot_support::none<Source>();}let args=module.children(equal.a);if args.len!=2 || !isScalar(module,args[1],cursor.value) {return blot_support::none<Source>();}let array=reference(module,args[0]);if !array.present {return blot_support::none<Source>();}let updates=module.children(choose.b);if updates.len!=2 {return blot_support::none<Source>();}let last_bind=module.node(updates[0]);if last_bind.tag!=blot_check_core::Tag.bind || !isScalar(module,last_bind.b,cursor.value) {return blot_support::none<Source>();}let count_step=increment(module,updates[1]);let cursor_step=increment(module,children[2]);if !count_step.present || !cursor_step.present || count_step.value.amount!=1 || cursor_step.value.binding!=cursor.value || cursor_step.value.amount==0 || cursor_step.value.amount>0xffffffff/7 {return blot_support::none<Source>();}var last=blot_support::none<u32>();for merge in module.branchMerges(children[1]) {if merge.then_binding==last_bind.a {last=blot_support::some(merge.else_binding);}}if !last.present {return blot_support::none<Source>();}let previous_last=last.value;if cursor.value==limit.value || cursor.value==previous_last || cursor.value==count_step.value.binding || previous_last==count_step.value.binding || limit.value==previous_last || limit.value==count_step.value.binding {return blot_support::none<Source>();}let last_next=merged(module,children[1],last_bind.a,previous_last);let count_next=merged(module,children[1],count_step.value.next,count_step.value.binding);if !last_next.present || !count_next.present {return blot_support::none<Source>();}var matched:u8=0;for carry in carries {if carry.iteration==cursor.value {if carry.backedge!=cursor_step.value.next {return blot_support::none<Source>();}matched|=1;}else if carry.iteration==previous_last {if carry.backedge!=last_next.value {return blot_support::none<Source>();}matched|=2;}else if carry.iteration==count_step.value.binding {if carry.backedge!=count_next.value {return blot_support::none<Source>();}matched|=4;}else if carry.backedge!=carry.iteration {return blot_support::none<Source>();}}if matched!=7 {return blot_support::none<Source>();}return blot_support::some(Source{array:array.value,cursor:cursor.value,limit:limit.value,last:previous_last,count:count_step.value.binding,stride:cursor_step.value.amount,bits:bits.a,..});}
struct Plan {array:blot_backend_wasm_merge_loop::Span,cursor:u32,limit:u32,last:u32,count:u32,stride:u32,bits:u32,length_function:u32,next_local:u32}
fn I(op:Op,operand:u32=0)->Instruction {return Instruction{op:op,operand:operand,..};}
fn L(local:u32)->Instruction {return I(blot_backend_runtime_ir::OP_local_get,local);}
fn C(bits:u32)->Instruction {return I(blot_backend_runtime_ir::OP_i32_const,bits);}
fn emit(original:const Instruction[:],plan:Plan)->Output,Error {var self_=Builder{next_local:plan.next_local,..};let error=build(self_,original,plan);if error!=blot_error::Error.none {self_.code.deinit();self_.locals.deinit();return Output{..},error;}return blot_backend_optimizer_buffers::finish(self_.locals,self_.code);}
fn build(self_:Builder&,original:const Instruction[:],plan:Plan)->Error {if plan.stride==0 || plan.stride>0xffffffff/7 {return self_.code.append(original);}let safe,error=self_.temp();if error!=blot_error::Error.none {return error;}let base,error=self_.temp();if error!=blot_error::Error.none {return error;}let matched,error=self_.temp();if error!=blot_error::Error.none {return error;}let error=self_.code.append([C(0),I(blot_backend_runtime_ir::OP_local_set,safe),L(plan.cursor),L(plan.limit),I(blot_backend_runtime_ir::OP_i32_le_u),L(plan.limit),L(plan.cursor),I(blot_backend_runtime_ir::OP_i32_sub),C(plan.stride*7),I(blot_backend_runtime_ir::OP_i32_ge_u),I(blot_backend_runtime_ir::OP_i32_and),I(blot_backend_runtime_ir::OP_if_)]);if error!=blot_error::Error.none {return error;}let error=blot_backend_wasm_merge_loop::ensureSpan(self_,plan.array,plan.length_function);if error!=blot_error::Error.none {return error;}let error=self_.code.append([L(plan.limit),L(plan.array.length),I(blot_backend_runtime_ir::OP_i32_lt_u),L(plan.array.word),C(0xffffffef),I(blot_backend_runtime_ir::OP_i32_le_u),L(plan.limit),C(0xffffffef),L(plan.array.word),I(blot_backend_runtime_ir::OP_i32_sub),C(2),I(blot_backend_runtime_ir::OP_i32_shr_u),I(blot_backend_runtime_ir::OP_i32_lt_u),C(plan.stride),C(0xffffffff),L(plan.limit),I(blot_backend_runtime_ir::OP_i32_sub),I(blot_backend_runtime_ir::OP_i32_le_u),I(blot_backend_runtime_ir::OP_i32_and),I(blot_backend_runtime_ir::OP_i32_and),I(blot_backend_runtime_ir::OP_i32_and),I(blot_backend_runtime_ir::OP_local_set,safe),I(blot_backend_runtime_ir::OP_end),L(safe),I(blot_backend_runtime_ir::OP_if_),L(plan.array.word),C(16),I(blot_backend_runtime_ir::OP_i32_add),I(blot_backend_runtime_ir::OP_local_set,base),I(blot_backend_runtime_ir::OP_loop),L(base),L(plan.cursor),C(2),I(blot_backend_runtime_ir::OP_i32_shl),I(blot_backend_runtime_ir::OP_i32_add),I(blot_backend_runtime_ir::OP_i32_load),C(plan.bits),I(blot_backend_runtime_ir::OP_i32_eq),I(blot_backend_runtime_ir::OP_local_set,matched),L(plan.count),L(matched),I(blot_backend_runtime_ir::OP_i32_add),I(blot_backend_runtime_ir::OP_local_set,plan.count),L(plan.cursor),L(plan.last),L(matched),I(blot_backend_runtime_ir::OP_i32_select),I(blot_backend_runtime_ir::OP_local_set,plan.last),L(plan.cursor),C(plan.stride),I(blot_backend_runtime_ir::OP_i32_add),I(blot_backend_runtime_ir::OP_local_set,plan.cursor),L(plan.cursor),L(plan.limit),I(blot_backend_runtime_ir::OP_i32_le_u),I(blot_backend_runtime_ir::OP_br_if),I(blot_backend_runtime_ir::OP_end),I(blot_backend_runtime_ir::OP_else_)]);if error!=blot_error::Error.none {return error;}let error=self_.code.append(original);if error!=blot_error::Error.none {return error;}return self_.code.push(I(blot_backend_runtime_ir::OP_end));}
