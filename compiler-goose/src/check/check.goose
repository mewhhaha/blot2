fn packagePackGoals(self:Engine&,id:u32,required:u32,binders:const u32[:],witnesses:const u32[:],goals:const blot_check_types::Obligation[:])->blot_error::Error {for goal,ordinal in goals {let selected,err=self.types.substituteGoal(goal,binders,witnesses);if err!=blot_error::Error.none {return err;}selected.source=id;let given,err=self.dictionaryGivenSelection(selected);if err!=blot_error::Error.none {return err;}if given.present {self.dictionary_selections.append(DictionarySelection{source:id,quantifier:required,goal:ordinal as u32,proof:DictionaryProof.given{value:given.value}});}else {let proof,err=self.proveAndSavePredicate(selected,id);if err!=blot_error::Error.none {return err;}if proof.present {self.dictionary_selections.append(DictionarySelection{source:id,quantifier:required,goal:ordinal as u32,proof:DictionaryProof.selected{value:proof.value}});}else {let err=self.diagnostic(Code.package_witness_mismatch,id);if err!=blot_error::Error.none {return err;}}}}return blot_error::Error.none;}
struct RankBoundary {variables:i64,versions:i64,rows:i64,row_versions:i64}
fn Engine::rankBoundary(self:const Engine&)->RankBoundary {return RankBoundary{self.types.variables.len,self.types.versions.len,self.types.effects.variables.len,self.types.effects.versions.len};}
fn Engine::checkPackageUnpack(self:Engine&,id:u32)->u32,blot_error::Error {let err=self.inferenceTransition();if err!=blot_error::Error.none {return 0,err;}let node=self.tree.node(id);let details=self.tree.extra.items[node.c..node.c+3];let value,err=self.expression(node.a);if err!=blot_error::Error.none {return 0,err;}let root,err=self.types.resolve(value,0);if err!=blot_error::Error.none {return 0,err;}let package=self.types.node(root);if package.tag!=blot_check_types::Tag.existential {return self.diagnosticFresh(Code.package_expected,node.a);}if details[0]!=package.c {return self.diagnosticFresh(Code.package_witness_mismatch,id);}let boundary=self.rankBoundary();let scope,err=self.types.rigidScope();if err!=blot_error::Error.none {return 0,err;}self.rank_implementations.append(RankImplementation{scope:scope,quantified:value,node:id});let type_scope=self.type_env.items.len;let value_scope=self.env.len;let given_scope=self.dictionary_givens.len;let binders=equation_type_ids.alloc_slice(package.c);for value,index in self.types.list(blot_check_types::List{package.b,package.c}) {binders[index]=value;}var rigids=IdBuffer{};let result,error=packageUnpackBinders(self,id,node,details,value,package,boundary,scope,type_scope,binders,rigids);rigids.deinit(equation_type_ids);equation_type_ids.free_slice(binders);self.dictionary_givens.resize(given_scope);self.type_env.resize(type_scope);self.env.resize(value_scope);return result,error;}
fn packageUnpackBinders(self:Engine&,id:u32,node:blot_parse_ast::Node,details:const u32[:],value:u32,package:blot_check_types::Node,boundary:RankBoundary,scope:u32,type_scope:i64,binders:const u32[:],rigids:IdBuffer&)->u32,blot_error::Error {for binder_id,ordinal in self.tree.list(blot_parse_ast::List{node.b,details[0]}) {let syntax=self.tree.node(binder_id);if syntax.b!=0 || self.types.node(binders[ordinal]).b!=0 {return self.diagnosticFresh(Code.package_witness_mismatch,binder_id);}for entry in self.type_env.items[type_scope..] {if entry.name==syntax.a {let err=self.diagnostic(Code.duplicate_type_parameter,binder_id);if err!=blot_error::Error.none {return 0,err;}}}let rigid,err=self.types.rigid(scope,ordinal as u32,0);if err!=blot_error::Error.none {return 0,err;}self.expr_types[binder_id]=rigid;let err=rigids.append(rigid);if err!=blot_error::Error.none {return 0,err;}let err=self.type_env.append(Engine_type_env{name:syntax.a,ty:rigid});if err!=blot_error::Error.none {return 0,err;}}let opened,err=self.types.substitute(package.a,binders,rigids.items);if err!=blot_error::Error.none {return 0,err;}let binding,err=self.addBinding(Binding{name:details[1],declaration:id,owner:self.owner,kind:Kind.local,ty:opened});if err!=blot_error::Error.none {return 0,err;}self.resolved[id]=binding;self.env.append(Entry{name:details[1],binding:binding});let resolved,err=self.types.resolve(value,0);if err!=blot_error::Error.none {return 0,err;}let goals=equation_values.alloc_slice(self.types.quantifierGoals(resolved).len);for goal,index in self.types.quantifierGoals(resolved) {goals[index]=goal;}let error=packageUnpackGivens(self,binding,value,binders,rigids.items,goals);equation_values.free_slice(goals);if error!=blot_error::Error.none {return 0,error;}let result,err=self.expression(details[2]);if err!=blot_error::Error.none {return 0,err;}let err=self.finishDictionaryUses(details[2]);if err!=blot_error::Error.none {return 0,err;}let err=self.finishDictionaryGoals(details[2]);if er