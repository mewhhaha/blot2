fn effectRunnerValues(self:Builder&,source:u32,metadata:blot_check_check::EffectRunner,depth:i64,prefix:WordBuffer&)->u32,Error {let state,error=self.projectType(metadata.state_type,0);if error!=Error.none {return 0,error;}let result,error=self.projectType(metadata.body_result,0);if error!=Error.none {return 0,error;}let outer,error=self.projectRow(metadata.outer_effects,0);if error!=Error.none {return 0,error;}let extended,error=self.projectRow(metadata.body_effects,0);if error!=Error.none {return 0,error;}let read,error=self.projectType(metadata.read_token,0);if error!=Error.none {return 0,error;}let write,error=self.projectType(metadata.write_token,0);if error!=Error.none {return 0,error;}var initial:u32=0;if metadata.kind==blot_check_check::EffectRunnerKind.run {let value,error=self.runnerOperand(metadata.initial,state,prefix,depth+1);if error!=Error.none {return 0,error;}initial=value;}var witness:u32=0;if metadata.witness!=0 {let ty,error=self.typeOf(metadata.witness);if error!=Error.none {return 0,error;}let value,error=self.runnerOperand(metadata.witness,ty,prefix,depth+1);if error!=Error.none {return 0,error;}witness=value;}var implementation:u32=0;if metadata.implementation!=0 {let ty,error=self.projectType(metadata.implementation_type,0);if error!=Error.none {return 0,error;}let value,error=self.runnerOperand(metadata.implementation,ty,prefix,depth+1);if error!=Error.none {return 0,error;}implementation=value;}let action_type,error=self.projectType(metadata.action_type,0);if error!=Error.none {return 0,error;}let action,error=self.runnerOperand(metadata.action,action_type,prefix,depth+1);if error!=Error.none {return 0,error;}var first=write;if read!=0 {first=read;}var provider:u32=0;var second:u32=0;if metadata.kind==blot_check_check::EffectRunnerKind.run {let reader,error=self.runnerOperation(source,read,blot_check_types::unit,state,extended);if error!=Error.none {return 0,error;}let writer,error=self.runnerOperation(source,write,state,blot_check_types::