fn prepare(self_: RaggedFacts&,id: u32) -> bool,Error { if id==0 { return true,blot_error::Error.none; } if self_.remaining==0 { return false,blot_error::Error.none; } self_.remaining--; let n=self_.module.node(id); match n.tag {
