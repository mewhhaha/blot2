  "parent_commit": "83fdba2022340d0ebd6892910f5a254f411b5556",
  "scope": "Selected-address loads for plain stable indexed rows. Instrumented Safe/noLLVM compiler; actual Ink Settings and matrix controls. No whole-game size or compile completion claim.",
  "toolchain": {
    "zig": "0.17.0",
    "optimize": "safe",
    "llvm": false,
    "deno": "deno 2.9.8 (stable, release, x86_64-unknown-linux-gnu)"
