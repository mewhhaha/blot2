import * as array from "std/array"
entry const run = fn (seed: U32) -> U32 => do:
  let count = 16384 + seed % 1024
  let prime = array.fill count #True
  prime[0] := #False
  prime[1] := #False
  let factor = 2
  for ever:
    if Bool.not (factor * factor < count):
      break
    if prime[factor]:
      let index = factor * factor
      for ever:
        if Bool.not (index < count):
          break
        prime[index] := #False
        index := self + factor
    factor := self + 1
  let total = 0
  for index in 0..count:
    if prime[index]:
      total := self + index
  break total
