fn Engine::resolvePredicate(self:Engine&,before:blot_check_types::Obligation)->blot_check_types::Obligation,blot_error::Error {var result=before;let value,e=self.types.resolve(before.ty,0);if e!=blot_error::Error.none {return result,e;}result.ty=value;let value,e=self.types.resolve(before.other,0);if e!=blot_error::Error.none {return result,e;}result.other=value;let value,e=self.types.resolve(before.result,0);if e!=blot_error::Error.none {return result,e;}result.result=value;let value,e=self.types.resolve(before.signature,0);if e!=blot_error::Error.none {return result,e;}result.signature=value;return result,blot_error::Error.none;}
fn Engine::memberTemplates(self:Engine&)->blot_error::Error {for slot in self.catalogs.contract_names.slots {if slot.tag==0 {continue;}let key=slot.key;let contract=self.contracts[slot.val];for member in self.contract_members[contract.members.start..contract.members.start+contract.members.len] {if member.kind!=blot_reuse_principal_interface::ContractMemberKind.value {continue;}let allowed,err=self.associatedStep(0);if err!=blot_error::Error.none || !allowed {return err;}self.name_bytes.clear();if key.namespace!=0 {for byte in self.pool.get(key.namespace) {self.name_bytes.append(byte);}self.name_bytes.append('.' as u8);}for byte in self.pool.get(key.member) {self.name_bytes.append(byte);}self.name_bytes.append('.' as u8);for byte in self.pool.get(member.name) {self.name_bytes.append(byte);}let name,err=self.pool.intern(self.name_bytes);if err==blot_error::Error.symbol_limit {return blot_error::Error.type_limit;}if err!=blot_error::Error.none {return err;}if self.hasGlobal(name) {continue;}let start=self.obligations.len as u32;for predicate in self.contract_predicates[contract.predicates.start..contract.predicates.start+contract.predicates.len] {self.obligations.append(predicate);}let member_index=self.memberIndex(contract,member.name);let origin .= self.member_sources.get(member_index.value);var source:u32=0;if origin {source=origin;}let pack,err=self.implementationArgumentPack(contract.parameters);if err!=blot_error::Error.none {return err;}self.obligations.append(blot_check_types::Obligation{kind:blot_check_types::ObligationKind.contract,ty:pack,identity:contract.identity,source:source,explicit:true});let principal=blot_check_types::Scheme{root:member.root,variables:contract.variables,row_variables:contract.row_variables,obligations:blot_check_types::List{start:start,len:self.obligations.len as u32-start}};let summary,err=self.summarize(principal);if err!=blot_error::Error.none {return err;}let binding,err=self.addBinding(Binding{private:contract.private,name:name,