fn rollback(self_:Owner&,mark:u32) {assert(self_.valid());var head=owners[self_.lease-1].head;while head!=mark {assert(head!=0);let at=head-1;let link=links[at];head=link.next;freeRun(link.run);links[at]=Link{};links.free(at);}owners[self_.lease-1].head=mark;}
fn deinit(self_:Owner&) {if self_.lease==0 {return;}assert(self_.valid());self_.rollback(0);let at=self_.lease-1;owners[at]=Lease{};owners.free(at);self_=Owner{};}
fn alloc<T>(self_:Owner&,length:i64)->T[:],Error {return allocate(self_,default<T>(),length);}
fn allocate(self_:Owner&,witness:u8,length:i64)->u8[:],Error {assert(self_.valid());if length<0 {return default<u8[:]>(),blot_error::Error.artifact_limit;}if length==0 {return default<u8[:]>(),blot_error::Error.none;}let values=pool_u8.alloc_slice(length);let error=self_.remember(Run.run_u8{values});if error!=blot_error::Error.none {pool_u8.free_slice(values);return default<u8[:]>(),error;}return values,blot_error::Error.none;}
fn mutable(self_:const Owner&,values:const u8[:])->u8[:] {assert(self_.valid());if values.len==0 {return default<u8[:]>();}var link=owners[self_.lease-1].head;while link!=0 {let entry=links[link-1];match entry.run {run_u8 run=>{if blot_support::same_slice_identity(run.values,values) {return pool_u8.realloc_slice(run.values,run.values.len);}},_=>{}}link=entry.next;}abort("archive slice is outside its owner");}
fn allocate(self_:Owner&,witness:blot_reuse_frozen_dependency::Symbol,length:i64)->blot_reuse_frozen_dependency::Symbol[:],Error {assert(self_.valid());if length<0 {return default<blot_reuse_frozen_dependency::Symbol[:]>(),blot_error::Error.artifact_limit;}if length==0 {return default<blot_reuse_frozen_dependency::Symbol[:]>(),blot_error::Error.none;}let values=pool_blot_reuse_frozen_dependency__Symbol.alloc_slice(length);let error=self_.remember(Run.run_blot_reuse_frozen_dependency__Symbol{values});if error!=blot_error::Error.none {pool_blot_reuse_frozen_dependency__Symbol.free_slice(values);return default<blot_reuse_frozen_dependency::Symbol[:]>(),error;}return values,blot_error::Error.none;}
