fn caseArms(self:Engine&,id:u32,result:u32,scope:i64,arms:const u32[:],types:const u32[:],carry:bool,versions:u32[:],exits:bool[:])->u32,blot_error::Error {for arm_id,arm_index in arms {let arm=self.tree.node(arm_id);let meta=self.tree.extra.items[arm.c..arm.c+2];let first,err=caseArmBindings(self,id,arm,scope,types);if err!=blot_error::Error.none {if first.len!=0 {entry_runs.free_slice(first);}return 0,err;}self.env.resize(scope);for entry in first {self.env.append(entry);}if first.len!=0 {entry_runs.free_slice(first);}if meta[0]!=0 {let guard,err=self.expression(meta[0]);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(guard,blot_check_types::boolean,meta[0]);if err!=blot_error::Error.none {return 0,err;}}if !carry {let ty,err=self.expression(meta[1]);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(result,ty,arm_id);if err!=blot_error::Error.none {return 0,err;}continue;}let current=versions[arm_index*scope..(arm_index+1)*scope];for entry,index in self.env[..scope] {current[index]=entry.binding;}var capture=ArmCapture{block:meta[1],versions:current};let saved .= self.arm_capture;self.arm_capture .= capture;let ty,error=self.expression(meta[1]);self.arm_capture .= saved;if error!=blot_error::Error.none {return 0,error;}let err=self.constrain(result,ty,arm_id);if err!=blot_error::Error.none {return 0,err;}let resolved,err=self.types.resolve(ty,0);if err!=blot_error::Error.none {return 0,err;}exits[arm_index]=resolved==blot_check_types::never;if capture.carrying {self.statement_arms.append(StatementArm{node:meta[1]});}}self.cases.append(id);return result,blot_error::Error.none;}
fn caseArmBindings(self:Engine&,id:u32,arm:blot_parse_ast::Node,scope:i64,types:const u32[:])->Entry[:],blot_error::Error {var first:Entry[:]=[];for row,row_index in self.tree.list(blot_parse_ast::List{arm.a,arm.b}) {self.env.resize(scope);let patterns=self.tree.children(row);if patterns.len!=types.len {let err=self.diagnostic(Code.pattern_arity,row);if err!=blot_error::Error.none {return first,err;}continue;}let saved=self.case_pattern_source;self.case_pattern_source=id;let error=caseRowPatterns(self,patterns,types,scope,first);self.case_pattern_source=saved;if error!=blot_error::Error.none {return first,error;}if row_index==0 {first=entry_runs.alloc_slice(self.env.len-scope);for entry,index in self.env[scope..] {first[index]=entry;}}else {if self.env.len-scope!=first.len {let err=self.diagnostic(Code.pattern_bindings,row);if err!=blot_error::Error.none {return first,err;}}for entry in self.env[scope..] {var found=false;for prior in first {if entry.name==prior.name {found=true;break;}}if !found {let err=self.diagnostic(Code.pattern_bindings,row);if err!=blot_error::Error.none {return first,err;}}}}}return first,blot_error::Error.none;}
fn caseRowPatterns(self:Engine&,patterns:const u32[:],types:const u32[:],scope:i64,reuse:const Entry[:])->blot_error::Error {for pattern,index in patterns {let matched,err=self.pattern(pattern,types[index],scope,reuse,false);if err!=blot_error::Error.none {return err;}}return blot_error::Error.none;}
fn Engine::joinCaseArms(self:Engine&,id:u32,arms:const u32[:],versions:const u32[:],exits:const bool[:])->blot_error::Error {let scope=self.env.len;for index in 0..scope {let entry=self.env[index];var shadowed=false;for later in self.env[index+1..scope] {if later.name==entry.name {shadowed=true;break;}}if shadowed {continue;}var changed=false;var live:u32=0;for arm,ordinal in arms {let version=versions[ordinal*scope+index];changed=changed || version!=entry.binding;if exits[ordinal] {continue;}if live==0 {live=version;}else {let err=self.constrain(self.bindings[live].ty,self.bindings[version].ty,arm);if err!=blot_error::Error.none {return err;}}}if !changed || live==0 {continue;}var level=arms.len-1;var joined=versions[(arms.len-1)*scope+index];var joined_exits=exits[arms.len-1];if arms.len==1 {level=arms.len;joined=entry.binding;joined_exits=false;}while level!=0 {level-=1;let version=versions[level*scope+index];if exits[level] {continue;}if joined_exits {joined=version;joined_exits=false;continue;}if version==joined {continue;}if arms.len==1 {let err=self.constrain(self.bindings[version].ty,self.bindings[joined].ty,arms[level]);if err!=blot_error::Error.none {return err;}}let merged,err=self.addBinding(Binding{name:entry.name,declaration:id,owner:self.owner,kind:Kind.local,ty:self.bindings[version].ty,predecessor:entry.binding});if err!=blot_error::Error.none {return err;}self.merges.append(Merge{node:arms[level],result:merged,then_binding:version,else_binding:joined});joined=merged;}if !joined_exits && joined!=entry.binding {self.env.append(Entry{name:entry.name,binding:joined});}}return blot_error::Error.none;}
fn Engine::annotationEffects(self:Engine&,id:u32)->u32,blot_error::Error {let row=self.tree.node(id);if row.tag!=blot_parse_ast::tag_effect_row {return 0,blot_error::Error.type_limit;}var tail=blot_check_effects::Tail.closed;if row.c!=0 {let variable,err=self.rowVariable(self.tree.node(row.c).a,row.c);if err!=blot_error::Error.none {return 0,err;}tail=self.types.row(variable).tail;}var labels=IdBuffer{};let result,err=annotationEffectLabels(self,row,tail,labels);labels.deinit(equation_type_ids);return result,err;}
fn annotationEffectLabels(self:Engine&,row:blot_parse_ast::Node,tail:blot_check_effects::Tail,labels:IdBuffer&)->u32,blot_error::Error {for source in self.tree.list(blot_parse_ast::List{row.a,row.b}) {var reverse=IdBuffer{};let err=annotationEffectLabel(self,source,reverse,labels);reverse.deinit(equation_type_ids);if err!=blot_error::Error.none {return 0,err;}}let result,err=self.types.effects.row(labels.items,tail);return result,blot_check_types::effectError(err);}
fn annotationEffectLabel(self:Engine&,source:u32,reverse:IdBuffer&,labels:IdBuffer&)->blot_error::Error {var head=source;while self.tree.node(head).tag==blot_parse_ast::tag_type_apply {let err=reverse.append(self.tree.node(head).b);if err!=blot_error::Error.none {return err;}head=self.tree.node(head).a;}let name=self.tree.node(head);if name.tag!=blot_parse_ast::tag_type_name {return self.diagnostic(Code.unknown_effect,source);}if reverse.items.len==0 {let lexical,err=annotationLexicalEffect(self,name.a);if err!=blot_error::Error.none {return err;}if lexical.present {return labels.append(lexical.value);}}let text=self.pool.get(name.a);if text=="Foreign" {if reverse.items.len!=0 {return self.diagnostic(Code.type_arity,source);}return labels.append(blot_check_types::foreign_operation);}var family=blot_support::none<u32>();var member=blot_support::none<u32>();let found .= self.catalogs.effect_family_names.get(self.catalogKey(name.a));if found {family=blot_support::some(found);}else {let found .= self.catalogs.effect_operation_names.get(self.catalogKey(name.a));if found {member=blot_support::some(found);family=blot_support::some(self.effect_templates[found].family);}else {let separator=lastDot(text);if separator.present {let key=self.textCatalogKey(text[..separator.value]);if key.present {let selected .= self.catalogs.effect_family_names.get(key.value);if selected {let symbol,known=self.pool.lookup(text[separator.value+1..]);if known {let template .= self.catalogs.effect_members.get(EffectMember{family:selected,member:symbol});if template {family=blot_support::some(selected);member=blot_support::some(template);}}}}}}}if !family.present {return self.diagnostic(Code.unknown_effect,source);}let descriptor=self.effect_families[family.value];let shapes=equation_type_ids.alloc_slice(descriptor.parameters.len);for value,index in self.types.list(descriptor.parameters) {shapes[index]=value;}if reverse.items.len!=shapes.len {equation_type_ids.free_slice(shapes);return self.diagnostic(Code.type_arity,source);}reverseIds(reverse.items);let old=equation_type_ids.alloc_slice(descriptor.variables.len);for value,index in self.types.list(descriptor.variables) {old[index]=value;}let fresh=equation_type_ids.alloc_slice(old.len);let arguments=equation_type_ids.alloc_slice(shapes.len);let err=annotationEffectArguments(self,descriptor,member,reverse.items,shapes,old,fresh,arguments,labels);equation_type_ids.free_slice(arguments);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old);equation_type_ids.free_slice(shapes);return err;}
fn annotationLexicalEffect(self:Engine&,name:u32)->blot_support::Option<u32>,blot_error::Error {let binding=self.lookup(name);if binding.present && self.bindings[binding.value].operation_ref!=0 {let root,err=self.types.resolve(self.bindings[binding.value].ty,0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let signature=self.types.node(root);if signature.tag==blot_check_types::Tag.function && self.types.rowLabels(signature.c).len==1 {return blot_support::some(self.types.rowLabels(signature.c)[0]),blot_error::Error.none;}}let text=self.pool.get(name);let separator=lastDot(text);if !separator.present {return blot_support::none<u32>(),blot_error::Error.none;}let root_name,known=self.pool.lookup(text[..separator.value]);if !known {return blot_support::none<u32>(),blot_error::Error.none;}let binding=self.lookup(root_name);if !binding.present {return blot_support::none<u32>(),blot_error::Error.none;}let root,err=self.types.resolve(self.bindings[binding.value].ty,0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let capability=self.types.node(root);if capability.tag!=blot_check_types::Tag.scoped {return blot_support::none<u32>(),blot_error::Error.none;}let root,err=self.types.resolve(capability.a,0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let descriptor=self.types.node(root);if descriptor.tag!=blot_check_types::Tag.nominal {return blot_support::none<u32>(),blot_error::Error.none;}let family .= self.catalogs.effect_family_identities.get(Identity{descriptor.a,descriptor.b});if !family {return blot_support::none<u32>(),blot_error::Error.none;}let member,known=self.pool.lookup(text[separator.value+1..]);if !known {return blot_support::none<u32>(),blot_error::Error.none;}let operation .= self.catalogs.effect_members.get(EffectMember{family:family,member:member});if !operation {return blot_support::none<u32>(),blot_error::Error.none;}let arguments=equation_type_ids.alloc_slice(self.types.nominalArgument