    recursive fn plan() -> Error { if config.persistent_lanes.len != 0 && config.persistent_lanes.len != self_.globals.items.len { return blot_error::Error.invalid_plan; } for index in 0..self_.max_stacks { let added = capacities.push(config.grower_bytes); if added != blot_error::Error.none { return added; } } capacities.items[self_.fixed_region] = config.temporary_bytes; for global,index in self_.globals.items { var configured = config.persistent_bytes; if config.persistent_lanes.len != 0 { configured = config.persistent_lanes[index]; } var literal = configured; if global.literal_bytes.present { literal = global.literal_bytes.value; } capacities.items[index] = min(configured,literal); } if self_.transport_region.present { capacities.items[self_.transport_region.value] = config.transport_bytes; } let applied = self_.capacity_requests.apply(capacities.items); if applied != blot_error::Error.none { return applied; } let memory = blot_runtime_data_stacks::Plan { region_capacities: capacities.items,owner_capacity: config.owner_capacity,..}; let finished = blot_runtime_data_stacks::finishPlan(self_.module,self_.runtime,memory); if finished != blot_error::Error.none { return finished; } if self_.transport.present { assert(self_.transport_region.present); let base,base_error = blot_runtime_data_stacks::regionBase(memory,self_.transport_region.value); assert(base_error == blot_error::Error.none); let configured = blot_runtime_storage_packets::configure(self_.module,self_.transport.value,base,capacities.items[self_.transport_region.value]); if configured != blot_error::Error.none { return blot_error::Error.invalid_transport_region; } } return blot_error::Error.none; }
    let error = plan(); capacities.deinit(); return error;
}
