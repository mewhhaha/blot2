+      entry,
+      prelude: null,
+      codegenTier,
+      cacheDirectory: false,
+      startupTimeoutMs: 5000,
+    });
+    try {
+      let original: Uint8Array<ArrayBuffer> | undefined;
+      for (const extra of [0, 1, 0]) {
+        const current = source.replace(
+          "many 1 2 3 4 5 6 7 8",
+          `many 1 2 3 4 5 6 7 ${8 + extra}`,
+        );
+        const built = await compiler.build({
+          sources: { [entry]: current },
+          signal: AbortSignal.timeout(5000),
+        });
+        assert(built.success, JSON.stringify(built));
+        if (extra === 0) {
+          if (original) assert.deepEqual(built.bytes, original);
+          else original = built.bytes.slice();
+        }
+        for (const asynchronous of [false, true]) {
+          const guest = await instantiateGuest(built.bytes, { asynchronous });
+          try {
+            const seen: number[] = [];
+            const capability = {
+              parameter: "U32" as const,
+              result: "U32" as const,
+              call(value: number) {
+                seen.push(value);
+                return value + 2;
+              },
+            };
+            const callback = guest.capability(capability);
+            const invoke = async (
+              name: string,
+              value: Parameters<typeof guest.call>[1],
+            ) => {
+              if (asynchronous) return await guest.callAsync(name, value);
+              return guest.call(name, value);
+            };
+            for (const input of [1, 7, 41]) {
+              assert.equal(await invoke("answer", input), input + 36 + extra);
+              assert.equal(await invoke("ordinary_stop", input), input);
+              assert.equal(await invoke("intrinsic_stop", input), input);
+            }
+            assert.equal(await invoke("sequence", callback), 34);
+            assert.deepEqual(seen, [1, 2]);
+            await assert.rejects(() => invoke("ordinary_stop", 0));
+            await assert.rejects(() => invoke("intrinsic_stop", 0));
+          } finally {
+            guest.dispose();
+          }
+        }
+        const bad = current.replace("right: many", "wrong: many");
+        const rejected = await compiler.build({
+          sources: { [entry]: bad },
+          signal: AbortSignal.timeout(5000),
+        });
+        assert(!rejected.success);
+        assert.equal(rejected.diagnostics[0].code, "unknown_field");
+        assert.equal(rejected.diagnostics[0].start, bad.indexOf("wrong: many"));
+      }
+    } finally {
+      await compiler.dispose();
+      await Deno.remove(directory, { recursive: true });
+    }
+  });
+}
