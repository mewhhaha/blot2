type Pick is data = $First U32 | $Second U32 | $Third F32
type Position is data = $Position {z: U32, x: F32}
io lazy_and (value: Bool): Bool => return value and (@panic "and")
io lazy_or (value: Bool): Bool => return value or (@panic "or")
io alternatives (n: U32): U32 => return do:
  let value = if n > 5 then $Second n else $First (n + 100)
  return case value of
    $First v | $Second v => v + 2
    $Third _ => 0
io positional (n: U32): F32 => return do:
  let p = $Position (n, 1.5)
  return p.x * 100.0 + U32.to_f32 p.z
io grown (n: U32): U32 => return do:
  let rows: Array U32 = #[5]
  for i in 0..64:
    @storage.push rows i
  rows[0] := self + n
  return rows[0] + rows.length
