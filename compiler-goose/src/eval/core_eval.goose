fn constant(self: Session&,raw: Target) -> ValueId,Error {
 let resolved,error=external(self,raw); if error!=Error.none { return 0,error; } let reference=BindingRef {unitId(self,resolved.unit),resolved.binding}; let parent=self.constant_recorder; if parent { let e=parent.beforeRead(self); if e!=Error.none { return 0,e; } } self.constant_recorder .= null; defer self.constant_recorder .= parent;
 let ready=slot(self,resolved).state==State.complete; let value,e=constantInner(self,resolved); if e!=Error.none { return 0,e; } if self.member_trace { self.member_trace.readyRead(blot_reuse_specialization_receipt::ReadyFact {reference,value},ready); } if parent { let read_error=parent.read(self,reference,value); if read_error!=Error.none { return 0,read_error; } } return value,Error.none;
