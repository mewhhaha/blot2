        for closure in closures {var until: u32 = 0;{let found .= blot_support_pooled_map::get(borrows.until,closure);if found {until = found;}}for binding in module.closureCaptures(closure) {if until != 0 && module.binding(binding).kind == blot_reuse_principal_interface::Kind.local {let use = borrows.captured(unit,closure,binding,until,read_refs);if use.present {if use.value == Use.parts {states[binding].deep = false;}continue;}}states[binding].escaped = true;}}
