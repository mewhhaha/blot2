Speed: a cycle's rounds compare a count of broken threaded classes instead
of summing the flag over the whole threadedclasses map before and after
every round. Classes are only ever broken, never mended or erased; debug
builds assert the count equals the sum.

diff --git a/src/typecheck.h b/src/typecheck.h
index 174a06a..40b213f 100644
--- a/src/typecheck.h
+++ b/src/typecheck.h
@@ -2499,6 +2499,7 @@ struct TypeCheck {
     };
     unordered_map<VarDef *, ThreadedClass> threadedclasses;
     size_t threadbounds = 0;   // Classes BoundThread bounded, for a cycle's rounds to settle.
+    size_t threadbroken = 0;   // Classes broken (ThreadedClass::broken), likewise.
     void ValidateThreadArgs(FnSpec *spec, vector<Val> &argvals, Node *callnode);
     bool PointsOutside(VarDef *pr, const Roots &v, vector<VarDef *> &through);
     void BoundThread(VarDef *cls, const string &why);
