// Structural equality is opt-in for application data. This contract lives in
// an explicit module so unrelated projects keep the small bootstrap prelude.
type Eq a is contract = { const eq: a -> a -> Bool }
const eq: a -> a -> Bool where { Eq a } = fn left => fn right => Eq.eq left right

impl Boolean : Eq Bool = {
  const eq = fn left => fn right => Bool.eq left right,
}
impl Unsigned : Eq U32 = {
  const eq = fn left => fn right => U32.eq left right,
}
impl Float : Eq F32 = {
  const eq = fn left => fn right => F32.eq left right,
}

const equal_array: Array a -> Array a -> Bool where { Eq a } = fn left => fn right => do:
  if left.length != right.length:
    break #False
  let same = #True
  for index in 0..left.length:
    if Bool.not (Eq.eq left[index] right[index]):
      same := #False
  break same
impl Sequence a : Eq (Array a) where { Eq a } = {
  const eq = fn left => fn right => equal_array left right,
}
