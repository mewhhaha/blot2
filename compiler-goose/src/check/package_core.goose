recursive fn storageMatch(self_:Walker&,source:u32,definitions:Definitions&,depth:i64)->bool,Error {for input in self_.module.matchInputs(source) {let exited,error=self_.storage(input,definitions,depth+1);if error!=blot_error::Error.none {return false,error;}}var branches:Definitions[2]=[Definitions{..};2];var exits:bool[2]=[false;2];var all_exit=true;var survivor=Definitions{..};var continuing:i64=0;for arm,index in self_.module.matchArms(source) {var local=definitions;for row,ordinal in self_.module.armRows(arm) {var alternate=definitions;for pattern in self_.module.rowPatterns(row) {let error=self_.patternStorage(pattern,alternate,depth+1);if error!=blot_error::Error.none {return false,error;}let error=self_.pattern(pattern,self_.module.pattern(pattern).ty,alternate,depth+1);if error!=blot_error::Error.none {return false,error;}}if ordinal==0 {local=alternate;}else if !local.eql(alternate) {return false,blot_error::Error.invalid_artifact;}}let exited,error=self_.storage(arm.guard_,local,depth+1);if error!=blot_error::Error.none {return false,error;}let exited,error=self_.storage(arm.body,local,depth+1);if error!=blot_error::Error.none {return false,error;}all_exit=all_exit && exited;if !exited {survivor=local;continuing+=1;}if index<branches.len {branches[index]=local;exits[index]=exited;}}if self_.module.matchInfo(source).statement && continuing==1 {definitions=survivor;}if self_.module.branchMerges(source).len!=0 {if self_.module.matchArms(source).len!=2 {return false,blot_error::Error.invalid_artifact;}let error=self_.storageMerges(source,definitions,branches,exits);if error!=blot_error::Error.none {return false,error;}}return self_.module.matchInfo(source).statement && all_exit,blot_error::Error.none;}
