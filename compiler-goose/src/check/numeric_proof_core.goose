        Tag.proof_guard => { let left, err = self.walk(n.a, depth + 1); if err != Error.none { return Value {}, err; } let right, err = self.walk(n.b, depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(left); if err != Error.none { return Value {}, err; } let err = ordinary(right); if err != Error.none { return Value {}, err; } if left.operand == 0 || right.operand == 0 { return Value {}, Error.invalid_artifact; } let relation, err = blot_check_numeric_proof_terms::relationFromCode(n.c); if err != Error.none { return Value {}, Error.invalid_artifact; } let proposition = Proposition { relation, left.operand, right.operand }; let err = self.values.view().proposition(proposition); if err != Error.none { return Value {}, err; }
            if self.plan { let admitted, err = self.query(proposition); if err != Error.none { return Value {}, err; } let err = self.plan.record(id, admitted); if err != Error.none { return Value {}, err; } } let err = self.fact(Fact.order { proposition }); return Value { proof: blot_support::some(proposition) }, err;
