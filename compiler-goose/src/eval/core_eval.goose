 if tag==blot_eval_type_evidence::Tag.nominal { if blot_check_types::isReflectionIdentity(n.a,n.b) { return true,Error.none; } }
 if tag==blot_eval_type_evidence::Tag.nominal||tag==blot_eval_type_evidence::Tag.product { for child in self.storage.evidence.children(evidence) { let found,error=containsReflectionType(self,owner,id,child,depth+1); if error!=Error.none||found { return found,error; } } }
 else if tag==blot_eval_type_evidence::Tag.record { let fields=self.storage.evidence.children(evidence); var index=1; while index<fields.len { let found,error=containsReflectionType(self,owner,id,fields[index],depth+1); if error!=Error.none||found { return found,error; } index+=2; } }
 else if tag==blot_eval_type_evidence::Tag.function||tag==blot_eval_type_evidence::Tag.state_provider { let a,error=containsReflectionType(self,owner,id,n.a,depth+1); if error!=Error.none||a { return a,error; } let b,e=containsReflectionType(self,owner,id,n.b,depth+1); if e!=Error.none||b { return b,e; } if tag==blot_eval_type_evidence::Tag.state_provider { return containsReflectionType(self,owner,id,n.c,depth+1); } }
