type OwnedGraph=blot_reuse_dependency_payload::Owned<FrozenGraph>;
struct FreezeWork {schemes:FreezeSchemes=FreezeSchemes{..},nominals:FreezeIdentities=FreezeIdentities{..},fields:Scratch_u8___=Scratch_u8___{..},qualifications:FreezeQualifications=FreezeQualifications{..},graph:OwnedGraph=default<OwnedGraph>(),result:Chunk?=null}
fn deinit(work:FreezeWork&) {work.graph.owner.deinit();for nominal in work.nominals.items {releaseOwned(nominal.name);}for name in work.fields.items {releaseOwned(name);}work.schemes.deinit();work.nominals.deinit();work.fields.deinit();work.qualifications.deinit();}
fn freezeChunk(tree:const Tree&,pool:const Pool&,checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>,bodies:Body[:],roots:u32[:],rows:u32[:],effect_rows:u32[:],labels:u32[:])->Chunk?,Error {
