fn rebindPath(self:Builder&,source:u32,syntax:blot_parse_ast::Node,binding:u32,depth:i64,path:WordBuffer&,selectors:UpdateBuffer&)->u32,Error {let metadata=self.source.checked.rebindings[source];let type_path=self.source.checked.types.list(self.source.checked.access_types[source]);let source_path=self.source.checked.types.list(metadata.path);if type_path.len!=source_path.len+1 {let error=self.diagnostic(blot_check_core::Code.unresolved_binding,source);return 0,error;}let root_type,error=self.projectType(type_path[0],0);if error!=Error.none {return 0,error;}let root,error=self.referenceNode(source,metadata.root,root_type);if error!=Error.none {return 0,error;}var mixed=false;for catalog in source_path {if catalog==0 {mixed=true;break;}}if mixed {let access_nodes=self.source.checked.types.list(self.source.checked.access_nodes[source]);if access_nodes.len!=source_path.len {let error=self.diagnostic(blot_check_core::Code.unresolved_binding,source);return 0,error;}for index in 0..source_path.len {let catalog=source_path[index];let access_id=access_nodes[index];let access=self.source.tree.node(access_id);let owner_type,error=self.projectType(type_path[index],0);if error!=Error.none {return 0,error;}let result_type,error=self.projectType(type_path[index+1],0);if error!=Error.none {return 0,error;}var step=blot_check_core::UpdateStep{source_type:owner_type,result_type:result_type, ..};if access.tag==blot_parse_ast::tag_index_access && catalog==0 {let value,error=self.expression(access.b,depth+1);if error!=Error.none {return 0,error;}step.kind=blot_check_core::UpdateKind.index;step.index=value;}else if access.tag==blot_parse_ast::tag_field_access && catalog!=0 {let projection,error=self.projectionIndex(catalog,owner_type,result_type);if error!=Error.none {return 0,error;}step.kind=blot_check_core::UpdateKind.field;step.projection=projection;}else {let error=self.diagnostic(blot_check_core::Code.unresolved_binding,access_id);return 0,error;}let error=selectors.push(step,updat