        return_ => { let flow,err = self_.expression(node.a,depth+1); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } var frame .= self_.returns; while frame { if frame.target == node.b { self_.record(frame); return Outcome.exit,blot_error::Error.none; } frame .= frame.parent; } return Outcome.live,blot_error::Error.invalid_artifact; },
        break_ => { let flow,err = self_.operands(self_.module.extra[node.b..node.b+node.c],depth); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } let frame .= self_.breaks; if !frame || frame.target != node.a { return Outcome.live,blot_error::Error.invalid_artifact; } self_.record(frame); return Outcome.exit,blot_error::Error.none; },
        if_value,if_stmt => { let flow,err = self_.expression(node.a,depth+1); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } return self_.branches(node.b,node.c,depth+1); },
        block_ => { return self_.block_(source,depth+1); },
        task => { let operation,err = blot_check_task_types::opFromCode(node.c); if err != blot_error::Error.none { return Outcome.live,blot_error::Error.invalid_artifact; } let operands = self_.module.children(source); if operation == blot_check_task_types::Op.read || operation == blot_check_task_types::Op.write { let owner = self_.module.node(operands[0]); if owner.tag == blot_check_core::Tag.reference { let ref = self_.module.reference(operands[0]); if ref.unit == 0 || ref.unit == self_.module.unit { let entry .= self_.state(ref.binding); if entry && (entry.first != 0 || entry.loan != 0) { return Outcome.live,blot_error::Error.invalid_artifact; } } } else { let flow,err = self_.expression(operands[0],depth+1); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } } let flow,err = self_.operands(operands[1..],depth); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } } else { let flow,err = self_.operands(operands,depth); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } } },
        suite,product,record,array,array_op,storage => { let flow,err = self_.operands(self_.module.extra[node.a..node.a+node.b],depth); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } },
        match_ => { return self_.cases(node.a,depth+1); },
        closure => { let err = self_.closure(node.a,node.ty,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } },
        computation => { if node.a == 0 || node.b != 0 || node.c != 0 || node.op != blot_check_core::Op.none { return Outcome.live,blot_error::Error.invalid_artifact; } let flow,err = self_.expression(node.a,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } },
        operation_value => { if node.a >= self_.module.operation_values.len || node.b != 0 || node.c != 0 { return Outcome.live,blot_error::Error.invalid_artifact; } let operation = self_.module.operationValue(source); if operation.capability != 0 { let flow,err = self_.expression(operation.capability,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } } },
        request_decision => { if node.a > blot_check_core::requestDecisionKindCode(blot_check_core::RequestDecisionKind.break_) { return Outcome.live,blot_error::Error.invalid_artifact; } for child in [node.b,node.c] { if child != 0 { let flow,err = self_.expression(child,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } } } return Outcome.exit,blot_error::Error.none; },
        request_loop => { return self_.requestLoop(source,node,depth); },
        pattern_bind => { let flow,err = self_.expression(node.b,depth+1); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } if node.c != 0 { let count=self_.len; let mark=self_.snapshot_len; let before,err=self_.snapshot(); if err != blot_error::Error.none { return Outcome.live,err; } let flow,err=self_.expression(node.c,depth+1); self_.len=count; copy(self_.states[..count],before); self_.snapshot_len=mark; if err != blot_error::Error.none { return Outcome.live,err; } } let err=self_.pattern(node.a,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } },
        package_unpack => { let flow,err=self_.expression(node.a,depth+1); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } let err=self_.introduce(node.b); if err != blot_error::Error.none { return Outcome.live,err; } return self_.expression(self_.module.extra[node.c],depth+1); },
        loop_ => { return self_.loopValue(source,node,depth); },
