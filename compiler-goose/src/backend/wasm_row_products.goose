// Share one checked vector product while preserving the scalar reduction order.
namespace blot_backend_wasm_row_products;
import .runtime_ir;
import .wasm;
import .source_origins;
import .optimizer_buffers;
import support.error;
import support.option;
type Error=blot_error::Error;
type Instruction=blot_backend_runtime_ir::Instruction;
type Output=blot_backend_runtime_ir::DetachedBody;
type Code=blot_backend_optimizer_buffers::Code;
type Types=blot_backend_optimizer_buffers::Types;
struct Product {base:Instruction,load:Instruction,factor:Instruction,lane:u32}
fn product(source:const Instruction[:],at:i64)->blot_support::Option<Product> {if at+5>source.len {return blot_support::none<Product>();}let part=source[at..at+5];for inst in part {if inst.table_reference {return blot_support::none<Product>();}}if part[0].op!=blot_backend_runtime_ir::OP_local_get || part[1].op!=blot_backend_runtime_ir::OP_v128_load || part[2].op!=blot_backend_runtime_ir::OP_f32x4_extract_lane || part[2].operand>=4 || part[4].op!=blot_backend_runtime_ir::OP_f32_mul {return blot_support::none<Product>();}if part[3].op!=blot_backend_runtime_ir::OP_local_get && part[3].op!=blot_backend_runtime_ir::OP_f32_const {return blot_support::none<Product>();}return blot_support::some(Product{base:part[0],load:part[1],factor:part[3],lane:part[2].operand,..});}
fn same(left:Product,right:Product)->bool {return blot_backend_source_origins::same(left.base,right.base) && blot_backend_source_origins::same(left.load,right.load) && blot_backend_source_origins::same(left.factor,right.factor);}
fn pure(inst:Instruction)->bool {if inst.table_reference {return false;}match inst.op {blot_backend_runtime_ir::OP_local_get,blot_backend_runtime_ir::OP_i32_const,blot_backend_runtime_ir::OP_f32_const,blot_backend_runtime_ir::OP_drop,blot_backend_runtime_ir::OP_nop=>{return true;},_=>{let lifted,found=blot_backend_runtime_ir::lift(inst.op);if !found {return false;}let facts=blot_backend_runtime_ir::fixed(inst.op);return facts.effect==blot_backend_runtime_ir::EFFECT_pure && !facts.may_trap;},}}
fn run(module:const blot_backend_wasm::Module&,function:const blot_backend_runtime_ir::Function&)->blot_support::Option<Output>,Error {if module.instructions(function).len>4096 {return blot_support::none<Output>(),Error.none;}var locals=Types{..};var output=Code{..};let changed,error=build(module,function,locals,output);return blot_backend_optimizer_buffers::finishOptional(locals,output,changed,error);}
fn build(module:const blot_backend_wasm::Module&,function:const blot_backend_runtime_ir::Function&,locals:Types&,output:Code&)->bool,Error {let source=module.instructions(function);var changed=false;var copied:i64=0;var at:i64=0;while at+5<=source.len {let selected=product(source,at);if !selected.present {at+=1;continue;}let first=selected.value;var sites:i64[4]=[0;4];var count:i64=0;var lanes:u8=0;var next=at;while next+5<=min(source.len,at+96) && count<sites.len {let candidate=product(source,next);if candidate.present {if !same(first,candidate.value) {break;}let bit=1 as u8<<candidate.value.lane;if lanes&bit!=0 {break;}lanes|=bit;sites[count]=next;count+=1;next+=5;}else {if !pure(source[next]) {break;}next+=1;}}if count!=4 || lanes!=15 {at+=1;continue;}if !changed {let error=locals.append(module.locals(function));if error!=Error.none {return false,error;}}changed=true;let vector=(function.parameters.len+locals.len) as u32;let error=locals.push(blot_backend_runtime_ir::VT_v128);if error!=Error.none {return false,error;}let error=output.append(source[copied..at]);if error!=Error.none {return false,error;}let error=output.append([first.base,first.load,first.factor,blot_backend_optimizer_buffers::I(blot_backend_runtime_ir::OP_f32x4_splat),blot_backend_optimizer_buffers::I(blot_backend_runtime_ir::OP_f32x4_mul),blot_backend_optimizer_buffers::I(blot_backend_runtime_ir::OP_local_set,vector)]);if error!=Error.none {return false,error;}var cursor=at;for site in sites {let error=output.append(source[cursor..site]);if error!=Error.none {return false,error;}let error=output.append([blot_backend_optimizer_buffers::I(blot_backend_runtime_ir::OP_local_get,vector),source[site+2]]);if error!=Error.none {return false,error;}cursor=site+5;}copied=cursor;at=cursor;}if !changed {return false,Error.none;}let error=output.append(source[copied..]);return true,error;}
