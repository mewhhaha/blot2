
type Counter is effect = { first: U32 -> U32, next: Unit -> U32 }
entry const answer = func () => return do:
  let count = 40
  for request in @requests (@computation (func () => return do:
    use Counter.first 5
    use Counter.next ()
    break ()
  )):
    case request of
      effect Counter.first count =>
        count := @u32.add self 1
        yield count
      effect Counter.next () =>
        count := @u32.add self 1
        yield count
      complete () =>
        break count

entry const checked_answer = answer ()
