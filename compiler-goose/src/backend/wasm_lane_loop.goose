fn reference(module:const Core&,id:u32)->blot_support::Option<BindingRef> {if id==0 || module.node(id).tag!=blot_check_core::Tag.reference {return blot_support::none<BindingRef>();}var ref=module.reference(id);if ref.unit==0 {ref.unit=module.unit;}if ref.unit!=module.unit {return blot_support::none<BindingRef>();}return blot_support::some(ref);}
