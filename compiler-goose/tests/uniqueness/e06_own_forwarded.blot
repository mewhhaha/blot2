type Box is data = $Box (Array U32)
type World is data = $World { counts: Array U32, other: Array U32 }
type Opt is data = $Has (Array U32) | $Missing
type Point is data = $Point { x: U32, y: U32 }
const keep = func (values: Array U32) => return values[0]
const fill = func (rows: own Array U32) -> (n: U32) => return do:
  rows[0] := n
  break rows
const count = func (world: own World) -> (n: U32) => return do:
  world.counts[0] := n
  break world
const twice = func (rows: own Array U32) -> (n: U32) => return do:
  rows[1] := n
  break fill rows n
const run = func (n: U32) => return twice #[1, 2] n
