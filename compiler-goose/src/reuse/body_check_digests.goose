 for label in tree.list(blot_parse_ast::List {row.a,row.b}) { if budget==0 { return blot_support::none<Digest>(); } budget--; var head=label; var arity: i64=0; while tree.node(head).tag==blot_parse_ast::tag_type_apply { if budget==0 { return blot_support::none<Digest>(); } budget--; arity++; head=tree.node(head).a; } let node=tree.node(head); if node.tag!=blot_parse_ast::tag_type_name { return blot_support::none<Digest>(); } let name=catalog.pool.get(node.a); if name=="Foreign" { if arity!=0 { return blot_support::none<Digest>(); } hashWord(hash,blot_check_types::foreign_operation); continue; } if !catalog.values.present||!catalog.values.value.annotations.present { return blot_support::none<Digest>(); } let annotations=catalog.values.value.annotations.value; let resolved=annotations.effect(name); if !resolved.present||resolved.value.family>=catalog.effect_families.len { return blot_support::none<Digest>(); } let family=catalog.effect_families[resolved.value.family]; if arity!=family.parameters.len||family.operations.len==0 { return blot_support::none<Digest>(); } hashWord(hash,2 as u32); if resolved.value.member.present { let member=resolved.value.member.value; if member>=catalog.effect_templates.len||catalog.effect_templates[member].family!=resolved.value.family { return blot_support::none<Digest>(); } let digest=operationDigestAt(source,catalog,member,0,budget); if !digest.present { return blot_support::none<Digest>(); } hash.update(digest.value); } else { for member in source.list(family.operations) { let digest=operationDigestAt(source,catalog,member,0,budget); if !digest.present { return blot_support::none<Digest>(); } hash.update(digest.value); } } }
 return blot_support::some(blot_support_blake3::final(hash));
}
fn annotationDigest(source: Source,catalog: Catalog,name: const u8[:]) -> blot_support::Option<Digest> {
 let relation,present=blot_check_numeric_proof_terms::type_name(name); if present { var hash=blot_support_blake3::init(); hash.update("numeric-proof-annotation"); hashWord(hash,blot_check_numeric_proof_terms::relationCode(relation)); return blot_support::some(blot_support_blake3::final(hash)); }
 var index=blot_support::none<i64>(); if catalog.values.present&&catalog.values.value.annotations.present { index=catalog.values.value.annotations.value.lookup(name); } if !index.present { index=catalog.named(catalog.unit,name); }
