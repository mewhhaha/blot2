// Shared public diagnostic vocabulary and exact message text.
namespace blot_check_diagnostic_code;
import support.error;
import support.structural_adapters;

import support.structural;
enum Code { cycle, constant_fuel, constant_recursion, integer_divide_by_zero, array_bounds, backend_limit, const_panic, const_effect, const_runtime_dependency, invalid_annotation, ambiguous_state, ambiguous_operator, ambiguous_associated, missing_associated, ambiguous_member, missing_member, missing_implementation, incompatible_implementation, recursive_evidence, recursive_associated_type, associated_limit, missing_field, ambiguous_qualified, type_mismatch, effect_mismatch, infinite_effect, type_constructor_required, invalid_provider, initialization_cycle, backend_const_only, unsupported, no_entry, entry_type, entry_let_type, unresolved_type, constant_expression, complexity, invalid_numeric_proof, ownership_unproved, collector_free_unproved, simd_lane_literal, stage_unavailable, code_shape_mismatch, cross_stage_authority, staging_budget, storage_unsupported, storage_borrow_conflict, storage_escape }
fn message(self_: Code, detail: const u8[:]) -> const u8[:] {
    match self_ {
        storage_unsupported => { if detail.len != 0 { return detail; } return "This program exceeds the current scoped-storage profile"; },
        storage_borrow_conflict => { if detail.len != 0 { return detail; } return "This storage operation could invalidate a borrow"; },
        storage_escape => { if detail.len != 0 { return detail; } return "Borrowed storage cannot escape its owner"; },
        const_panic => { return detail; },
        cycle => { return "Compile-time constant dependencies contain a cycle"; },
        constant_fuel => { return "Constant evaluation exceeded its operation or nesting budget"; },
        constant_recursion => { return "Constant evaluation exceeded its function call depth limit"; },
        integer_divide_by_zero => { return "Compile-time integer division or remainder has a zero divisor"; },
        array_bounds => { return "Array index is outside the element range"; },
        invalid_numeric_proof => { return "Numeric proof condition is false"; },
        backend_limit => { if detail.len != 0 { return detail; } return "Array length exceeds the 16 MiB bootstrap arena"; },
        const_effect => { return "A constant initializer requires a handled effect"; },
        const_runtime_dependency => { if detail.len != 0 { return detail; } return "a const initializer cannot read a top-level let value initialized at module startup"; },
        invalid_annotation => { return "Never is an internal control-flow type"; },
        ambiguous_state => { return "State requires a concrete runtime value type"; },
        ambiguous_operator => { return "This operator does not have a compatible implementation for these operand types"; },
        ambiguous_associated => { if detail.len != 0 { return detail; } return "Associated result dispatch requires a known destination type"; },
        missing_associated => { return "Neither operand has a compatible associated implementation"; },
        ambiguous_member => { return "A field and associated function share this name"; },
        incompatible_implementation => { return "The matching implementation cannot satisfy its prerequisites"; },
        recursive_evidence => { return "Implementation prerequisites repeat an active application"; },
        recursive_associated_type => { return "Associated type equations contain a cycle"; },
        associated_limit => { return "Associated normalization or evidence exceeds its work or depth limit"; },
        missing_implementation => { return "This contract application requires an explicit implementation"; },
        missing_member => { return "This receiver has no associated member with this name"; },
        missing_field => { if detail.len != 0 { return detail; } return "This receiver has no physical field with this name"; },
        ambiguous_qualified => { return "An explicit predicate lacks complete concrete evidence"; },
        type_mismatch => { if detail.len != 0 { return detail; } return "The expression has a different type from the required type"; },
        effect_mismatch => { return "Effect rows do not match"; },
        infinite_effect => { return "An effect row contains itself"; },
        type_constructor_required => { return "A monad resolver requires a declared data type constructor"; },
        invalid_provider => { return "This computation requires an effect resolver"; },
        initialization_cycle => { return "top-level let initializers form a dependency cycle"; },
        backend_const_only => { return "Effect reflection and descriptors are available only during constant evaluation"; },
        unsupported => { return "This typed core form is not supported by constant evaluation or native Wasm lowering"; },
        no_entry => { return "A build requires at least one entry declaration"; },
        entry_type => { if detail.len != 0 { return detail; } return "An entry requires one supported guest parameter and result, or a scalar constant"; },
        entry_let_type => { if detail.len != 0 { return detail; } return "A runtime-initialized entry requires a supported guest function or a scalar global"; },
        unresolved_type => { return "Code emission requires concrete representation evidence"; },
        constant_expression => { return "This compile-time value cannot be evaluated by the native evaluator"; },
        complexity => { return "Typed-core lowering exceeds the native compiler limit"; },
        collector_free_unproved => { if detail.len != 0 { return detail; } return "The complete module has no collector-free certificate"; },
        ownership_unproved => {
                if detail.len != 0 { return detail; }
                return "Native emission requires checked ownership for every allocation, field and exit";
            },
        simd_lane_literal => { return "SIMD lane indices must be in-range U32 literals at a direct, fully applied shuffle, swizzle or broadcast"; },
        stage_unavailable => { return "The code or descriptor is unavailable at this stage"; },
        code_shape_mismatch => { return "The generated code does not have its checked shape"; },
        cross_stage_authority => { return "The value cannot cross this stage boundary"; },
        staging_budget => { return "Typed staging exceeds the evaluation budget"; },
    }
}

fn codeCode(value: Code) -> u32 {
    match value {
        cycle => { return 0; },
        constant_fuel => { return 1; },
        constant_recursion => { return 2; },
        integer_divide_by_zero => { return 3; },
        array_bounds => { return 4; },
        backend_limit => { return 5; },
        const_panic => { return 6; },
        const_effect => { return 7; },
        const_runtime_dependency => { return 8; },
        invalid_annotation => { return 9; },
        ambiguous_state => { return 10; },
        ambiguous_operator => { return 11; },
        ambiguous_associated => { return 12; },
        missing_associated => { return 13; },
        ambiguous_member => { return 14; },
        missing_member => { return 15; },
        missing_implementation => { return 16; },
        incompatible_implementation => { return 17; },
        recursive_evidence => { return 18; },
        recursive_associated_type => { return 19; },
        associated_limit => { return 20; },
        missing_field => { return 21; },
        ambiguous_qualified => { return 22; },
        type_mismatch => { return 23; },
        effect_mismatch => { return 24; },
        infinite_effect => { return 25; },
        type_constructor_required => { return 26; },
        invalid_provider => { return 27; },
        initialization_cycle => { return 28; },
        backend_const_only => { return 29; },
        unsupported => { return 30; },
        no_entry => { return 31; },
        entry_type => { return 32; },
        entry_let_type => { return 33; },
        unresolved_type => { return 34; },
        constant_expression => { return 35; },
        complexity => { return 36; },
        invalid_numeric_proof => { return 37; },
        ownership_unproved => { return 38; },
        collector_free_unproved => { return 39; },
        simd_lane_literal => { return 40; },
        stage_unavailable => { return 41; },
        code_shape_mismatch => { return 42; },
        cross_stage_authority => { return 43; },
        staging_budget => { return 44; },
        storage_unsupported => { return 45; },
        storage_borrow_conflict => { return 46; },
        storage_escape => { return 47; },
    }
}
fn codeFromCode(code: u32) -> Code, blot_error::Error {
    match code {
        0 => { return Code.cycle, blot_error::Error.none; },
        1 => { return Code.constant_fuel, blot_error::Error.none; },
        2 => { return Code.constant_recursion, blot_error::Error.none; },
        3 => { return Code.integer_divide_by_zero, blot_error::Error.none; },
        4 => { return Code.array_bounds, blot_error::Error.none; },
        5 => { return Code.backend_limit, blot_error::Error.none; },
        6 => { return Code.const_panic, blot_error::Error.none; },
        7 => { return Code.const_effect, blot_error::Error.none; },
        8 => { return Code.const_runtime_dependency, blot_error::Error.none; },
        9 => { return Code.invalid_annotation, blot_error::Error.none; },
        10 => { return Code.ambiguous_state, blot_error::Error.none; },
        11 => { return Code.ambiguous_operator, blot_error::Error.none; },
        12 => { return Code.ambiguous_associated, blot_error::Error.none; },
        13 => { return Code.missing_associated, blot_error::Error.none; },
        14 => { return Code.ambiguous_member, blot_error::Error.none; },
        15 => { return Code.missing_member, blot_error::Error.none; },
        16 => { return Code.missing_implementation, blot_error::Error.none; },
        17 => { return Code.incompatible_implementation, blot_error::Error.none; },
        18 => { return Code.recursive_evidence, blot_error::Error.none; },
        19 => { return Code.recursive_associated_type, blot_error::Error.none; },
        20 => { return Code.associated_limit, blot_error::Error.none; },
        21 => { return Code.missing_field, blot_error::Error.none; },
        22 => { return Code.ambiguous_qualified, blot_error::Error.none; },
        23 => { return Code.type_mismatch, blot_error::Error.none; },
        24 => { return Code.effect_mismatch, blot_error::Error.none; },
        25 => { return Code.infinite_effect, blot_error::Error.none; },
        26 => { return Code.type_constructor_required, blot_error::Error.none; },
        27 => { return Code.invalid_provider, blot_error::Error.none; },
        28 => { return Code.initialization_cycle, blot_error::Error.none; },
        29 => { return Code.backend_const_only, blot_error::Error.none; },
        30 => { return Code.unsupported, blot_error::Error.none; },
        31 => { return Code.no_entry, blot_error::Error.none; },
        32 => { return Code.entry_type, blot_error::Error.none; },
        33 => { return Code.entry_let_type, blot_error::Error.none; },
        34 => { return Code.unresolved_type, blot_error::Error.none; },
        35 => { return Code.constant_expression, blot_error::Error.none; },
        36 => { return Code.complexity, blot_error::Error.none; },
        37 => { return Code.invalid_numeric_proof, blot_error::Error.none; },
        38 => { return Code.ownership_unproved, blot_error::Error.none; },
        39 => { return Code.collector_free_unproved, blot_error::Error.none; },
        40 => { return Code.simd_lane_literal, blot_error::Error.none; },
        41 => { return Code.stage_unavailable, blot_error::Error.none; },
        42 => { return Code.code_shape_mismatch, blot_error::Error.none; },
        43 => { return Code.cross_stage_authority, blot_error::Error.none; },
        44 => { return Code.staging_budget, blot_error::Error.none; },
        45 => { return Code.storage_unsupported, blot_error::Error.none; },
        46 => { return Code.storage_borrow_conflict, blot_error::Error.none; },
        47 => { return Code.storage_escape, blot_error::Error.none; },
        _ => { return Code.cycle, blot_error::Error.invalid_artifact; },
    }
}

fn blot_structural::equal(left: blot_check_diagnostic_code::Code, right: blot_check_diagnostic_code::Code) -> bool { return left == right; }
fn blot_check_diagnostic_code::blotStructuralHash<S>(value: blot_check_diagnostic_code::Code,sink: S&) { blot_structural::hash(sink, blot_check_diagnostic_code::codeCode(value) as! u8); }
