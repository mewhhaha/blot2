    var failure=blot_error::Error.none;var context=ImplementationOrderContext{self,self.order_entries,failure};blot_check_source_sort::pdqContext(0,self.order_entries.len,context);if failure!=blot_error::Error.none {if failure==blot_error::Error.out_of_memory {return failure;}return self.diagnostic(Code.associated_limit,0);}for entry in self.order_entries {self.implementation_order.append(entry.index);}return blot_error::Error.none;
}
fn Engine::implementationCoherence(self:Engine&)->blot_error::Error {let err=self.implementationOrder();if err!=blot_error::Error.none {return err;}for later_index,ordinal in self.implementation_order {let later=self.implementations[later_index];for earlier_index in self.implementation_order[..ordinal] {let earlier=self.implementations[earlier_index];if later.private && earlier.private && later.identity.unit!=earlier.identity.unit {continue;}let overlap,err=blot_eval_implementation_patterns::overlap(self.types,earlier,later);if err!=blot_error::Error.none {return err;}if !overlap {continue;}var origin=later.declaration;if later.identity.unit!=self.unit {origin=0;}self.implementation_trace=blot_eval_implementation_trace::Record{context:self.unit,request:origin,contract:later.contract};self.implementation_trace.candidate(earlier.identity,blot_reuse_dispatch_explanation::Outcome.overlap);self.implementation_trace.candidate(later.identity,blot_reuse_dispatch_explanation::Outcome.overlap);let err=self.diagnostic(Code.overlapping_implementation,origin);if err!=blot_error::Error.none {return err;}if later.identity.unit!=self.unit {let issue .= self.diagnostics[self.diagnostics.len-1];issue.origin_unit=later.identity.unit;if self.purity_origins.has_source_available && self.purity_origins.sourceAvailable(later.identity.unit) && later.origin_span.present {issue.span=later.origin_span.value;}}return blot_error::Error.none;}}return blot_error::Error.none;}
fn Engine::implementationIndexForMember(self:const Engine&,member:u32)->blot_support::Option<u32> {for declaration,index in self.implementations {if member>=declaration.members.start && member-declaration.members.start<declaration.members.len {return blot_support::some(index as u32);}}return blot_support::none<u32>();}
fn Engine::implementationMemberIndex(self:const Engine&,declaration:Implementation,name:u32)->blot_support::Option<u32> {for ordinal in declaration.members.start..declaration.members.start+declaration.members.len {if self.implementation_members[ordinal].name==name {return blot_support::some(ordinal as u32);}}return blot_support::none<u32>();}
