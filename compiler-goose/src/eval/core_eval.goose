fn scalarExpression(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let n=self.units[owner].node(id); if n.c!=0&&n.b!=0 { return dispatch(self,owner,id,frame); } let first,e=expression(self,owner,n.a,frame); if e!=Error.none||!isValue(first) { return first,e; } let second,e2=expression(self,owner,n.b,frame); if e2!=Error.none||!isValue(second) { return second,e2; } let a=flowValue(first); let b=flowValue(second); if valueInfo(self,a).kind==ValueKind.product { let result,error=simdValue(self,owner,id,n.op,a,b); return Flow.value {result},error; } let av,e3=requireScalar(self,owner,id,a); if e3!=Error.none { return Flow.value {0},e3; } let bv,e4=requireScalar(self,owner,id,b); if e4!=Error.none { return Flow.value {0},e4; } let result,error=blot_backend_scalar_ops::evaluate(n.op,av,bv); if error!=Error.none { var code=Code.unsupported; if error==Error.integer_divide_by_zero { code=Code.integer_divide_by_zero; } return Flow.value {0},failNode(self,owner,id,code); } let value,e5=makeScalar(self,owner,id,result); return Flow.value {value},e5; }
fn logicalExpression(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let n=self.units[owner].node(id); let first,e=expression(self,owner,n.a,frame); if e!=Error.none||!isValue(first) { return first,e; } let scalar,e2=requireScalar(self,owner,id,flowValue(first)); if e2!=Error.none { return Flow.value {0},e2; } if scalar.scalar!=blot_backend_runtime_ir::SC_bool { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } if (n.op==blot_check_core::Op.and_&&scalar.bits==0)||(n.op==blot_check_core::Op.or_&&scalar.bits!=0) { return first,Error.none; } if n.op!=blot_check_core::Op.and_&&n.op!=blot_check_core::Op.or_ { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } let second,error=expression(self,owner,n.b,frame); if error!=Error.none { return second,error; } if isValue(second) { let value,e3=requireScalar(self,owner,id,flowValue(second)); if e3!=Error.none { return Flow.value {0},e3; } if value.scalar!=blot_backend_runtime_ir::SC_bool { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } } return second,Error.none; }
