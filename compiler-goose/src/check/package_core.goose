fn Walker::principalMapping(self:Walker&,reference:blot_check_core::BindingRef,expected:u32)->Principal,Error {let instances_before=self.scopes.instance_variables;let rows_before=self.scopes.instance_rows;var pairs:blot_check_package_contracts::VersionPair[16]=[default<blot_check_package_contracts::VersionPair>();16];let value,error=principalMappingValue(self,reference,expected,pairs);if error!=Error.none {self.scopes.instance_variables=instances_before;self.scopes.instance_rows=rows_before;return invalidPrincipal(),error;}return value,Error.none;}
