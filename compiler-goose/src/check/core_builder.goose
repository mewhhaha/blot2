capture_epoch:u32=0,return_target:u32=0,function_target:u32=0,variable_count:u32=0,effect_variable_count:u32=0,body_lowerings:i64=0,proof_visits:i64=0}
struct Builder {source:Source,tables:Tables,scratch:Scratch}
type WordBuffer=blot_support_pooled_buffer::Buffer<u32>;
reusable[] var word_runs:u32[>..];
reusable[] var saved_field_slots:dictionary_slot<u32,bool>[>..]=[];
reusable[] var nullary_nominal_slots:dictionary_slot<Identity,u32>[>..]=[];
reusable[] var request_callback_runs:RequestCallbackFrame[>..]=[];
reusable[] var resolver_loop_frame_runs:ResolverLoopFrame[>..]=[];
fn append(self_:WordBuffer&,value:u32)->Error {return blot_support_pooled_buffer::push(self_,value,word_runs);}
fn appendSlice(self_:WordBuffer&,values:const u32[:])->Error {return blot_support_pooled_buffer::append(self_,values,word_runs);}
fn deinit(self_:WordBuffer&) {blot_support_pooled_buffer::deinit(self_,word_runs);}
fn resizeVisitEpochs(self_:Builder&,length:i64)->Error {let old=self_.scratch.visit_epochs.items.len;let error=blot_support_pooled_buffer::ensure(self_.scratch.visit_epochs,length,word_runs);if error!=blot_error::Error.none {return error;}if length>old {for index in old..length {self_.scratch.visit_epochs.storage[index]=0;}}self_.scratch.visit_epochs.items=self_.scratch.visit_epochs.storage[..length];return blot_error::Error.none;}
fn allocateEmpty(self_:Builder&,destination:u32[:]& ,count:i64)->Error {assert(destination.len==0);if count<0 {return blot_error::Error.core_limit;}let buffer=word_runs.alloc_slice(count);for &value in buffer {value=0;}destination=buffer;return blot_error::Error.none;}

fn binaryOp(text:const u8[:])->blot_support::Option<blot_check_core::Op> {
if text=="+" {return blot_support::some(blot_check_core::Op.add);}
if text=="-" {return blot_support::some(blot_check_core::Op.sub);}
if text=="*" {return blot_support::some(blot_check_core::Op.mul);}
if text=="/" {return blot_support::some(blot_check_core::Op.div);}
if text=="%" {return blot_support::some(blot_check_core::Op.rem);}
if text=="==" {return blot_support::some(blot_check_core::Op.equal);}
if text=="!=" {return blot_support::some(blot_check_core::Op.not_equal);}
if text=="<" {return blot_support::some(blot_check_core::Op.less);}
if text=="<=" {return blot_support::some(blot_check_core::Op.less_equal);}
if text==">" {return blot_support::some(blot_check_core::Op.greater);}
if text==">=" {return blot_support::some(blot_check_core::Op.greater_equal);}
if text=="&" {return blot_support::some(blot_check_core::Op.bit_and);}
if text=="|" {return blot_support::some(blot_check_core::Op.bit_or);}
if text=="^" {return blot_support::some(blot_check_core::Op.bit_xor);}
if text=="<<" {return blot_support::some(blot_check_core::Op.shift_left);}
if text==">>" {return blot_support::some(blot_check_core::Op.shift_right);}
if text=="and" {return blot_support::some(blot_check_core::Op.and_);}
if text=="or" {return blot_support::some(blot_check_core::Op.or_);}
return blot_support::none<blot_check_core::Op>();}
fn memberOp(text:const u8[:])->blot_check_core::Op {
if text=="add" {return blot_check_core::Op.add;}
if text=="sub" {return blot_check_core::Op.sub;}
if text=="mul" {return blot_check_core::Op.mul;}
if text=="div" {return blot_check_core::Op.div;}
if text=="rem" {return blot_check_core::Op.rem;}
if text=="eq" {return blot_check_core::Op.equal;}
if text=="ne" {return blot_check_core::Op.not_equal;}
if text=="lt" {return blot_check_core::Op.less;}
if text=="le" {return blot_check_core::Op.less_equal;}
if text=="gt" {return blot_check_core::Op.greater;}
if text=="ge" {return blot_check_core::Op.greater_equal;}
if text=="bit_and" {return blot_check_core::Op.bit_and;}
if text=="bit_or" {return blot_check_core::Op.bit_or;}
if text=="bit_xor" {return blot_check_core::Op.bit_xor;}
if text=="shl" {return blot_check_core::Op.shift_left;}
if text=="shr" {return blot_check_core::Op.shift_right;}
return blot_check_core::Op.none;}
struct Intrinsic {op:blot_check_core::Op,arity:u8}
struct ArrayIntrinsic {op:blot_check_core::ArrayOp,arity:u8}
fn arrayIntrinsic(text:const u8[:])->blot_support::Option<ArrayIntrinsic> {let value=blot_backend_collection_ops::lookup(text);if !value.present {return blot_support::none<ArrayIntrinsic>();}return blot_support::some(ArrayIntrinsic{value.value.op,value.value.arity, ..});}
fn intrinsic(text:const u8[:])->blot_support::Option<Intrinsic> {let simd_=blot_backend_simd_intrinsics::lookup(text);if simd_.present {return blot_support::some(Intrinsic{simd_.value.op,simd_.value.arity, ..});}
if text=="@u32.add" {return blot_support::some(Intrinsic{blot_check_core::Op.add,2, ..});}
if text=="@u32.sub" {return blot_support::some(Intrinsic{blot_check_core::Op.sub,2, ..});}
if text=="@u32.mul" {return blot_support::some(Intrinsic{blot_check_core::Op.mul,2, ..});}
if text=="@u32.div" {return blot_support::some(Intrinsic{blot_check_core::Op.div,2, ..});}
if text=="@u32.rem" {return blot_support::some(Intrinsic{blot_check_core::Op.rem,2, ..});}
if text=="@u32.eq" {return blot_support::some(Intrinsic{blot_check_core::Op.equal,2, ..});}
if text=="@u32.lt" {return blot_support::some(Intrinsic{blot_check_core::Op.less,2, ..});}
if text=="@u32.bit_and" {return blot_support::some(Intrinsic{blot_check_core::Op.bit_and,2, ..});}
if text=="@u32.bit_or" {return blot_support::some(Intrinsic{blot_check_core::Op.bit_or,2, ..});}
if text=="@u32.bit_xor" {return blot_support::some(Intrinsic{blot_check_core::Op.bit_xor,2, ..});}
if text=="@u32.shl" {return blot_support::some(Intrinsic{blot_check_core::Op.shift_left,2, ..});}
if text=="@u32.shr" {return blot_support::some(Intrinsic{blot_check_core::Op.shift_right,2, ..});}
if text=="@u32.to_f32" {return blot_support::some(Intrinsic{blot_check_core::Op.convert_u32_f32,1, ..});}
if text=="@f32.add" {return blot_support::some(Intrinsic{blot_check_core::Op.add,2, ..});}
if text=="@f32.sub" {return blot_support::some(Intrinsic{blot_check_core::Op.sub,2, ..});}
if text=="@f32.mul" {return blot_support::some(Intrinsic{blot_check_core::Op.mul,2, ..});}
if text=="@f32.div" {return blot_support::some(Intrinsic{blot_check_core::Op.div,2, ..});}
if text=="@f32.eq" {return blot_support::some(Intrinsic{blot_check_core::Op.equal,2, ..});}
if text=="@f32.ne" {return blot_support::some(Intrinsic{blot_check_core::Op.not_equal,2, ..});}
if text=="@f32.lt" {return blot_support::some(Intrinsic{blot_check_core::Op.less,2, ..});}
if text=="@f32.le" {return blot_support::some(Intrinsic{blot_check_core::Op.less_equal,2, ..});}
if text=="@f32.gt" {return blot_support::some(Intrinsic{blot_check_core::Op.greater,2, ..});}
if text=="@f32.ge" {return blot_support::some(Intrinsic{blot_check_core::Op.greater_equal,2, ..});}
if text=="@f32.abs" {return blot_support::some(Intrinsic{blot_check_core::Op.abs,1, ..});}
if text=="@f32.neg" {return blot_support::some(Intrinsic{blot_check_core::Op.neg,1, ..});}
if text=="@f32.ceil" {return blot_support::some(Intrinsic{blot_check_core::Op.ceil,1, ..});}
if text=="@f32.floor" {return blot_support::some(Intrinsic{blot_check_core::Op.floor,1, ..});}
if text=="@f32.trunc" {return blot_support::some(Intrinsic{blot_check_core::Op.trunc,1, ..});}
if text=="@f32.sqrt" {return blot_support::some(Intrinsic{blot_check_core::Op.sqrt,1, ..});}
if text=="@f32.to_u32" {return blot_support::some(Intrinsic{blot_check_core::Op.convert_f32_u32,1, ..});}
return blot_support::none<Intrinsic>();}
fn initialize(self_:Builder&)->Error {
 let checked .= self_.source.checked;let tree .= self_.source.tree;let error=self_.allocateEmpty(self_.scratch.type_map,checked.types.nodes.len);if error!=blot_error::Error.none {return error;}let error=self_.allocateEmpty(self_.scratch.variable_map,checked.types.variables.len);if error!=blot_error::Error.none {return error;}let error=self_.allocateEmpty(self_.scratch.effect_row_map,checked.types.effects.rows.len);if error!=blot_error::Error.none {return error;}let error=self_.allocateEmpty(self_.scratch.effect_variable_map,checked.types.effects.variables.len);if error!=blot_error::Error.none {return error;}let error=self_.allocateEmpty(self_.scratch.effect_operation_map,checked.types.operations.len);if error!=blot_error::Error.none {return error;}self_.tables.effect_rows.push(blot_check_effects::Row{..});self_.tables.effect_operations.append([blot_check_types::Operation{identity:Identity{0,0, ..}, ..},blot_check_types::Operation{identity:Identity{0,1, ..}, ..}]);self_.scratch.effect_operation_map[blot_check_types::foreign_operation]=blot_check_types::foreign_operation;let error=self_.allocateEmpty(self_.scratch.ast_map,tree.nodes.len);if error!=blot_error::Error.none {return error;}
 let ast_origins_count=tree.operator_origins.items.len;var member_origin=false;let ast_walk_1_count=tree.operator_origins.items.len;for ast_walk_1_index in 0..ast_walk_1_count {let origin=tree.operator_origins.items[ast_walk_1_index];if origin.member_point!=0 && origin.node<tree.nodes.len {member_origin=true;break;}}if member_origin {if ast_origins_count>0xffffffff {return blot_error::Error.core_limit;}let error=self_.allocateEmpty(self_.scratch.member_origin_heads,tree.nodes.len);if error!=blot_error::Error.none {return error;}let error=self_.allocateEmpty(self_.scratch.member_origin_next,ast_origins_count);if error!=blot_error::Error.none {return error;}let ast_walk_2_count=tree.operator_origins.items.len;for index in 0..ast_walk_2_count {let origin=tree.operator_origins.items[index];if origin.member_point==0 || origin.node>=self_.scratch.member_origin_heads.len {continue;}self_.scratch.member_origin_next[index]=self_.scratch.member_origin_heads[origin.node];self_.scratch.member_origin_heads[origin.node]=(index+1) as u32;}}
 for signature,source in checked.dispatch_signatures {if signature==0 {continue;}if self_.scratch.signature_sources.len==0 {let error=self_.allocateEmpty(self_.scratch.signature_sources,tree.nodes.len);if error!=blot_error::Error.none {return error;}}self_.scratch.signature_sources[source]=signature;}for obligation in checked.obligations {if obligation.signature!=0 {if self_.scratch.signature_sources.len==0 {let error=self_.allocateEmpty(self_.scratch.signature_sources,tree.nodes.len);if error!=blot_error::Error.none {return error;}}self_.scratch.signature_sources[obligation.source]=obligation.signature;}}
 if checked.merges.len!=0 {let error=self_.allocateEmpty(self_.scratch.merge_heads,tree.nodes.len);if error!=blot_error::Error.none {return error;}for &head in self_.scratch.merge_heads {head=0xffffffff;}let error=self_.allocateEmpty(self_.scratch.merge_next,checked.merges.len);if error!=blot_error::Error.none {return error;}var index=checked.merges.len;while index!=0 {index-=1;let source=checked.merges[index].node;self_.scratch.merge_next[index]=self_.scratch.merge_heads[source];self_.scratch.merge_heads[source]=index as u32;}}
 if checked.loop_exits.len!=0 {let error=self_.allocateEmpty(self_.scratch.loop_exit_indices,tree.nodes.len);if error!=blot_error::Error.none {return error;}for exit,index in checked.loop_exits {self_.scratch.loop_exit_indices[exit.node]=(index+1) as u32;}}if checked.statement_arms.len!=0 {let error=self_.allocateEmpty(self_.scratch.statement_arms,tree.nodes.len);if error!=blot_error::Error.none {return error;}for arm in checked.statement_arms {self_.scratch.statement_arms[arm.node]=1;}}
 self_.tables.type_nodes.append(checked.types.nodes.items[..6]);for index in 0..6 {self_.scratch.type_map[index]=index as u32;}let ignored,error=self_.reserve(0);if error!=blot_error::Error.none {return error;}self_.tables.bodies.push(blot_check_core::Body{..});return blot_error::Error.none;
}
fn diagnostic(self_:Builder&,code:blot_check_core::Code,source:u32)->Error {self_.tables.diagnostics.push(blot_check_core::Diagnostic{code:code,span:self_.source.checked.diagnosticSpan(self_.source.tree,source), ..});return blot_error::Error.none;}
fn addType(self_:Builder&,value:blot_check_types::Node)->u32,Error {var container:i64=-1;if value.tag==blot_check_types::Tag.array {container=0;}else if value.tag==blot_check_types::Tag.list {container=1;}else if value.tag==blot_check_types::Tag.cursor {container=2;}var canonical:u32?=null;if container>=0 && value.a!=0 && value.a<6 && value.b==0 && value.c==0 {canonical .= self_.scratch.closed_containers[container][value.a];if canonical && canonical!=0 {return canonical,blot_error::Error.none;}}if self_.tables.type_nodes.len==0xffffffff {return 0,blot_error::Error.core_limit;}let id=self_.tables.type_nodes.len as u32;let nullary=value.tag==blot_check_types::Tag.nominal && self_.tables.type_extra[value.c]==0;self_.tables.type_nodes.push(value);if canonical {canonical=id;}if nullary {let identity=Identity{value.a,value.b, ..};if !blot_support_pooled_map::contains(self_.scratch.nullary_nominals,identity) {blot_support_pooled_map::insert(self_.scratch.nullary_nominals,identity,id,nullary_nominal_slots);}}return id,blot_error::Error.none;}
recursive fn projectType(self_:Builder&,source:u32,depth:i64)->u32,Error {if source==0 {return 0,blot_error::Error.none;}if self_.scratch.type_map[source]!=0 {return self_.scratch.type_map[source],blot_error::Error.none;}if depth>=1024 {return 0,blot_error::Error.core_limit;}let resolved=self_.source.checked.types.head(source,0);if resolved!=source {let id,error=self_.projectType(resolved,depth+1);if error!=blot_error::Error.none {return 0,error;}self_.scratch.type_map[source]=id;return id,blot_error::Error.none;}let original=self_.source.checked.types.node(resolved);if original.tag==blot_check_types::Tag.variable && self_.scratch.variable_map[original.a]!=0 {let id=self_.scratch.variable_map[original.a];self_.scratch.type_map[source]=id;return id,blot_error::Error.none;}if original.tag==blot_check_types::Tag.rigid {return self_.projectRigid(source,original,depth);}if original.tag==blot_check_types::Tag.nominal && self_.source.checked.types.nominalArguments(original).len==0 {let known .= blot_support_pooled_map::get(self_.scratch.nullary_nominals,Identity{original.a,original.b, ..});if known {self_.scratch.type_map[source]=known;return known,blot_error::Error.none;}}var words=WordBuffer{..};let value,error=projectTypeShape(self_,source,original,depth,words);blot_check_core_builder::deinit(words);if error!=blot_error::Error.none {return 0,error;}let id,error=self_.addType(value);if error!=blot_error::Error.none {return 0,error;}self_.scratch.type_map[source]=id;if original.tag==blot_check_types::Tag.variable {self_.scratch.variable_map[original.a]=id;}if original.tag==blot_check_types::Tag.forall || original.tag==blot_check_types::Tag.existential {let error=self_.projectQuantifierGoals(source,id,depth);if error!=blot_error::Error.none {return 0,error;}}return id,blot_error::Error.none;}
recursive fn projectRigid(self_:Builder&,source:u32,original:blot_check_types::Node,depth:i64)->u32,Error {let checked .= self_.source.checked;if original.c==2 {for loan in checked.usage_loans {let region=checked.types.node(loan.region);if region.a!=original.a {continue;}let binding=checked.resolved[loan.parameter];if binding==0 {return 0,blot_error::Error.core_limit;}let id,error=self_.addType(blot_check_types::Node{tag:blot_check_types::Tag.bound,a:0,b:2,c:binding, ..});if error!=blot_error::Error.none {return 0,error;}self_.scratch.type_map[source]=id;return id,blot_error::Error.none;}}
 var owner=blot_support::none<blot_check_check::RankImplementation>();for implementation in checked.rank_implementations {if implementation.scope==original.a {owner=blot_support::some(implementation);break;}}if !owner.present {return 0,blot_error::Error.core_limit;}let implementation=owner.value;var quantified=implementation.quantified;if implementation.node!=0 && implementation.node<checked.expr_types.len {var published=checked.types.head(checked.expr_types[implementation.node],0);var stopped=false;for index in 0..128 {let wrapper=checked.types.node(published);if wrapper.tag!=blot_check_types::Tag.usage {stopped=true;break;}published=checked.types.head(wrapper.a,0);}if !stopped {return 0,blot_error::Error.core_limit;}if checked.types.node(published).tag==blot_check_types::Tag.forall {quantified=published;}}
 let quantifier=checked.types.node(checked.types.head(quantified,0));if (quantifier.tag!=blot_check_types::Tag.forall && quantifier.tag!=blot_check_types::Tag.existential) || original.b>=quantifier.c {return 0,blot_error::Error.core_limit;}let bound=checked.types.list(blot_check_types::List{quantifier.b,quantifier.c, ..})[original.b];let leaf=checked.types.node(bound);if leaf.tag!=blot_check_types::Tag.bound || leaf.b!=original.c {return 0,blot_error::Error.core_limit;}if quantifier.tag==blot_check_types::Tag.existential {if implementation.node==0 || implementation.node>=checked.resolved.len {return 0,blot_error::Error.core_limit;}let binding=checked.resolved[implementation.node];if binding==0 || binding>=checked.bindings.len || self_.source.tree.node(implementation.node).tag!=blot_parse_ast::tag_package_unpack {return 0,blot_error::Error.core_limit;}let id,error=self_.addType(blot_check_types::Node{tag:blot_check_types::Tag.bound,a:original.b,b:original.c,c:binding, ..});if error!=blot_error::Error.none {return 0,error;}self_.scratch.type_map[source]=id;return id,blot_error::Error.none;}let result,error=self_.projectType(bound,depth+1);if error!=blot_error::Error.none {return 0,error;}self_.scratch.type_map[source]=result;return result,blot_error::Error.none;
}
recursive fn projectTypeShape(self_:Builder&,source:u32,original:blot_check_types::Node,depth:i64,words:WordBuffer&)->blot_check_types::Node,Error {let tag=original.tag;var value=original;match tag {
 usage=>{let a,error=self_.projectType(original.a,depth+1);if error!=blot_error::Error.none {return value,error;}var c:u32=0;if original.c!=0 {let projected,error=self_.projectType(original.c,depth+1);if error!=blot_error::Error.none {return value,error;}c=projected;}return blot_check_types::Node{tag:tag,a:a,b:original.b,c:c, ..},blot_error::Error.none;},
 bound=>{return blot_check_types::Node{tag:tag,a:original.a,b:original.b, ..},blot_error::Error.none;},
 forall,existential=>{for binder in self_.source.checked.types.list(blot_check_types::List{original.b,original.c, ..}) {let projected,error=self_.projectType(binder,depth+1);if error!=blot_error::Error.none {return value,error;}let error=blot_check_core_builder::append(words,projected);if error!=blot_error::Error.none {return value,error;}}let body,error=self_.projectType(original.a,depth+1);if error!=blot_error::Error.none {return value,error;}let span,error=self_.saveTypes(words.items);return blot_check_types::Node{tag:tag,a:body,b:span.start,c:span.len, ..},error;},
 variable=>{let index=self_.scratch.variable_count;self_.scratch.variable_count+=1;return blot_check_types::Node{tag:tag,a:index, ..},blot_error::Error.none;},
 function=>{let a,error=self_.projectType(original.a,depth+1);if error!=blot_error::Error.none {return value,error;}let b,error=self_.projectType(original.b,depth+1);if error!=blot_error::Error.none {return value,error;}let c,error=self_.projectRow(original.c,depth+1);return blot_check_types::Node{tag:tag,a:a,b:b,c:c, ..},error;},
 product=>{for child in self_.source.checked.types.list(blot_check_types::List{original.a,original.b, ..}) {let projected,error=self_.projectType(child,depth+1);if error!=blot_error::Error.none {return value,error;}let error=blot_check_core_builder::append(words,projected);if error!=blot_error::Error.none {return value,error;}}let span,error=self_.saveTypes(words.items);return blot_check_types::Node{tag:tag,a:span.start,b:span.len, ..},error;},
 record=>{for index in 0..original.b {let field=self_.source.checked.types.recordField(original,index);let error=self_.saveFieldName(field.name);if error!=blot_error::Error.none {return value,error;}let error=blot_check_core_builder::append(words,field.name);if error!=blot_error::Error.none {return value,error;}let projected,error=self_.projectType(field.ty,depth+1);if error!=blot_error::Error.none {return value,error;}let error=blot_check_core_builder::append(words,projected);if error!=blot_error::Error.none {return value,error;}}let span,error=self_.saveTypes(words.items);return blot_check_types::Node{tag:tag,a:span.start,b:original.b, ..},error;},
 nominal,projection,instance_selection=>{let arguments=self_.source.checked.types.nominalArguments(original);let error=blot_check_core_builder::append(words,arguments.len as u32);if error!=blot_error::Error.none {return value,error;}for argument in arguments {let projected,error=self_.projectType(argument,depth+1);if error!=blot_error::Error.none {return value,error;}let error=blot_check_core_builder::append(words,projected);if error!=blot_error::Error.none {return value,error;}}if tag==blot_check_types::Tag.projection {let error=blot_check_core_builder::append(words,self_.source.checked.types.projectionMember(original));if error!=blot_error::Error.none {return value,error;}}let span,error=self_.saveTypes(words.items);return blot_check_types::Node{tag:tag,a:original.a,b:original.b,c:span.start, ..},error;},
 scoped=>{let a,error=self_.projectType(original.a,depth+1);if error!=blot_error::Error.none {return value,error;}var c=original.c;if original.b==0 {let projected,error=self_.projectType(original.c,depth+1);if error!=blot_error::Error.none {return value,error;}c=projected;}return blot_check_types::Node{tag:tag,a:a,b:original.b,c:c, ..},blot_error::Error.none;},
 array,list,cursor,resolver=>{let a,error=self_.projectType(original.a,depth+1);return blot_check_types::Node{tag:tag,a:a, ..},error;},
 provider=>{let a,error=self_.projectType(original.a,depth+1);if error!=blot_error::Error.none {return value,error;}let c,error=self_.projectRow(original.c,depth+1);return blot_check_types::Node{tag:tag,a:a,c:c, ..},error;},
 state_provider=>{let a,error=self_.projectType(original.a,depth+1);if error!=blot_error::Error.none {return value,error;}let b,error=self_.projectType(original.b,depth+1);if error!=blot_error::Error.none {return value,error;}let c,error=self_.projectType(original.c,depth+1);return blot_check_types::Node{tag:tag,a:a,b:b,c:c, ..},error;},_=>{return original,blot_error::Error.none;},}}
recursive fn projectQuantifierGoals(self_:Builder&,source:u32,id:u32,depth:i64)->Error {let goals=self_.source.checked.types.quantifierGoals(source);if goals.len==0 {return blot_error::Error.none;}if self_.tables.quantifier_obligations.len>0xffffffff || goals.len>0xffffffff-self_.tables.quantifier_obligations.len {return blot_error::Error.core_limit;}let start=self_.tables.quantifier_obligations.len as u32;for goal in goals {self_.tables.quantifier_obligations.push(blot_check_types::Obligation{ty:0,kind:blot_check_types::ObligationKind.type_rep,source:0, ..});}self_.tables.quantifier_goals.push(blot_check_types::QuantifierGoals{owner:id,goals:blot_check_types::List{start,goals.len as u32, ..}, ..});for old,ordinal in goals {var goal=old;let ty,error=self_.projectType(old.ty,depth+1);if error!=blot_error::Error.none {return error;}goal.ty=ty;let other,error=self_.projectType(old.other,depth+1);if error!=blot_error::Error.none {return error;}goal.other=other;let result,error=self_.projectType(old.result,depth+1);if error!=blot_error::Error.none {return error;}goal.result=result;let signature,error=self_.projectType(old.signature,depth+1);if error!=blot_error::Error.none {return error;}goal.signature=signature;goal.source=0;self_.tables.quantifier_obligations[start+ordinal]=goal;}return blot_error::Error.none;}
fn projectRowVariable(self_:Builder&,variable:u32)->u32,Error {if variable>=self_.scratch.effect_variable_map.len {return 0,blot_error::Error.core_limit;}if self_.scratch.effect_variable_map[variable]!=0 {return self_.scratch.effect_variable_map[variable]-1,blot_error::Error.none;}if self_.scratch.effect_variable_count==0xffffffff {return 0,blot_error::Error.core_limit;}let id=self_.scratch.effect_variable_count;self_.scratch.effect_variable_count+=1;self_.scratch.effect_variable_map[variable]=id+1;return id,blot_error::Error.none;}
recursive fn projectInstance(self_:Builder&,original:Identity,depth:i64)->Identity,Error {if original.unit!=0 || original.decl==0 {return original,blot_error::Error.none;}let projected,error=self_.projectType(original.decl,depth+1);if error!=blot_error::Error.none {return Identity{0,0, ..},error;}let node=self_.tables.type_nodes[projected];if node.tag==blot_check_types::Tag.scoped {return Identity{node.b,node.c, ..},blot_error::Error.none;}if node.tag!=blot_check_types::Tag.variable && node.tag!=blot_check_types::Tag.instance_selection {return Identity{0,0, ..},blot_error::Error.core_limit;}return Identity{0,projected, ..},blot_error::Error.none;}
recursive fn projectOperation(self_:Builder&,label:u32,depth:i64)->u32,Error {if depth>=1024 || label==0 || label>=self_.scratch.effect_operation_map.len {return 0,blot_error::Error.core_limit;}if self_.scratch.effect_operation_map[label]!=0 {return self_.scratch.effect_operation_map[label],blot_error::Error.none;}let source=self_.source.checked.types.operations.items[label];var values=WordBuffer{..};let result,error=projectOperationValues(self_,label,source,depth,values);blot_check_core_builder::deinit(values);return result,error;}
recursive fn projectOperationValues(self_:Builder&,label:u32,source:blot_check_types::Operation,depth:i64,values:WordBuffer&)->u32,Error {for argument in self_.source.checked.types.list(source.arguments) {let projected,error=self_.projectType(argument,depth+1);if error!=blot_error::Error.none {return 0,error;}let error=blot_check_core_builder::append(values,projected);if error!=blot_error::Error.none {return 0,error;}}let arguments,error=self_.saveTypes(values.items);if error!=blot_error::Error.none {return 0,error;}if self_.tables.effect_operations.len==0xffffffff {return 0,blot_error::Error.core_limit;}let id=self_.tables.effect_operations.len as u32;let instance,error=self_.projectInstance(source.instance,depth+1);if error!=blot_error::Error.none {return 0,error;}self_.tables.effect_operations.push(blot_check_types::Operation{identity:source.identity,arguments:arguments,instance:instance, ..});self_.scratch.effect_operation_map[label]=id;return id,blot_error::Error.none;}
recursive fn projectRow(self_:Builder&,source:u32,depth:i64)->u32,Error {if source==0 {return 0,blot_error::Error.none;}if depth>=1024 || source>=self_.scratch.effect_row_map.len {return 0,blot_error::Error.core_limit;}if self_.scratch.effect_row_map[source]!=0 {return self_.scratch.effect_row_map[source]-1,blot_error::Error.none;}let original=self_.source.checked.types.effects.node(source);var labels=WordBuffer{..};let result,error=projectRowLabels(self_,source,original,depth,labels);blot_check_core_builder::deinit(labels);return result,error;}
recursive fn projectRowLabels(self_:Builder&,source:u32,original:blot_check_effects::Row,depth:i64,labels:WordBuffer&)->u32,Error {for label in self_.source.checked.types.effects.list(original.labels) {let projected,error=self_.projectOperation(label,depth+1);if error!=blot_error::Error.none {return 0,error;}let error=blot_check_core_builder::append(labels,projected);if error!=blot_error::Error.none {return 0,error;}}var tail=blot_check_effects::Tail.closed;match original.tail {closed=>{},variable payload=>{let variable,error=self_.projectRowVariable(payload.value);if error!=blot_error::Error.none {return 0,error;}tail=blot_check_effects::Tail.variable{value:variable, ..};},parameter payload=>{tail=blot_check_effects::Tail.parameter{value:payload.value, ..};},formal payload=>{let formal,error=self_.projectType(payload.value,depth+1);if error!=blot_error::Error.none {return 0,error;}tail=blot_check_effects::Tail.formal{value:formal, ..};},}if labels.items.len==0 && tail==blot_check_effects::Tail.closed {self_.scratch.effect_row_map[source]=1;return 0,blot_error::Error.none;}if self_.tables.effect_rows.len==0xffffffff || labels.items.len>0xffffffff-self_.tables.effect_labels.len {return 0,blot_error::Error.core_limit;}let start=self_.tables.effect_labels.len as u32;self_.tables.effect_labels.append(labels.items);let id=self_.tables.effect_rows.len as u32;self_.tables.effect_rows.push(blot_check_effects::Row{labels:blot_check_effects::List{start,labels.items.len as u32, ..},tail:tail, ..});self_.scratch.effect_row_map[source]=id+1;return id,blot_error::Error.none;}
fn saveTypes(self_:Builder&,values:const u32[:])->blot_check_types::List,Error {if values.len>0xffffffff-self_.tables.type_extra.len {return blot_check_types::List{..},blot_error::Error.core_limit;}let start=self_.tables.type_extra.len as u32;self_.tables.type_extra.append(values);return blot_check_types::List{start,values.len as u32, ..},blot_error::Error.none;}
fn projectScheme(self_:Builder&,scheme:blot_check_types::Scheme,local:bool)->blot_check_types::Scheme,Error {let root,error=self_.projectType(scheme.root,0);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}var variables=WordBuffer{..};var rows=WordBuffer{..};let result,error=projectSchemeLists(self_,scheme,local,root,variables,rows);blot_check_core_builder::deinit(variables);blot_check_core_builder::deinit(rows);return result,error;}
fn wordContains(words:const u32[:],value:u32)->bool {for word in words {if word==value {return true;}}return false;}
fn projectSchemeLists(self_:Builder&,scheme:blot_check_types::Scheme,local:bool,root:u32,variables:WordBuffer&,rows:WordBuffer&)->blot_check_types::Scheme,Error {for id in self_.source.checked.types.list(scheme.variables) {let projected,error=self_.projectType(id,0);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}let tag=self_.tables.type_nodes[root].tag;if local && tag!=blot_check_types::Tag.forall && tag!=blot_check_types::Tag.existential {if self_.tables.type_nodes[projected].tag!=blot_check_types::Tag.variable || wordContains(variables.items,projected) {continue;}}let error=blot_check_core_builder::append(variables,projected);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}}var universal=root;var scopes:i64=0;while self_.tables.type_nodes[universal].tag==blot_check_types::Tag.forall {if scopes==128 {return blot_check_types::Scheme{..},blot_error::Error.core_limit;}scopes+=1;let quantifier=self_.tables.type_nodes[universal];let error=blot_check_core_builder::appendSlice(variables,self_.tables.type_extra[quantifier.b..quantifier.b+quantifier.c]);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}universal=quantifier.a;}let span,error=self_.saveTypes(variables.items);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}for variable in self_.source.checked.types.list(scheme.row_variables) {let projected,error=self_.projectRowVariable(variable);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}let error=blot_check_core_builder::append(rows,projected);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}}let row_span,error=self_.saveTypes(rows.items);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}rows.clear();for variable in self_.source.checked.types.list(scheme.closed_rows) {let projected,error=self_.projectRowVariable(variable);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}let error=blot_check_core_builder::append(rows,projected);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}}let closed_span,error=self_.saveTypes(rows.items);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}let start=self_.tables.obligations.len as u32;for value in self_.source.checked.obligations[scheme.obligations.start..scheme.obligations.start+scheme.obligations.len] {let error=self_.projectObligation(value);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}}let generative,error=self_.projectPublic(scheme.generative,false);if error!=blot_error::Error.none {return blot_check_types::Scheme{..},error;}return blot_check_types::Scheme{ root:root, variables:span, row_variables:row_span, closed_rows:closed_span, obligations:blot_check_types::List{start,(self_.tables.obligations.len-start) as u32, ..}, generative:generative, .. },blot_error::Error.none;}
fn projectObligation(self_:Builder&,value:blot_check_types::Obligation)->Error {let ty,error=self_.projectType(value.ty,0);if error!=blot_error::Error.none {return error;}let result,error=self_.projectType(value.result,0);if error!=blot_error::Error.none {return error;}let other,error=self_.projectType(value.other,0);if error!=blot_error::Error.none {return error;}let signature,error=self_.projectType(value.signature,0);if error!=blot_error::Error.none {return error;}var diagnostic_name=blot_check_core::Name{..};if value.explicit && value.name!=0 {let name,error=self_.saveName(self_.source.names.get(value.name));if error!=blot_error::Error.none {return error;}diagnostic_name=name;}self_.tables.obligations.push(blot_check_core::Obligation{ty:ty,kind:value.kind,span:self_.source.checked.diagnosticSpan(self_.source.tree,value.source),name:value.name,result:result,other:other,signature:signature,operator:value.operator,identity:value.identity,explicit:value.explicit,qualification_span:value.qualification_span,qualification_unit:value.qualification_unit,diagnostic_name:diagnostic_name, ..});return blot_error::Error.none;}
fn projectPublic(self_:Builder&,public:blot_check_types::List,rows:bool)->blot_check_types::List,Error {var values=WordBuffer{..};let result,error=projectPublicValues(self_,public,rows,values);blot_check_core_builder::deinit(values);return result,error;}
fn projectPublicValues(self_:Builder&,public:blot_check_types::List,rows:bool,values:WordBuffer&)->blot_check_types::List,Error {for id in self_.source.checked.types.list(public) {var projected:u32=0;if rows {let value,error=self_.projectRowVariable(id);if error!=blot_error::Error.none {return blot_check_types::List{..},error;}projected=value;}else {let value,error=self_.projectType(id,0);if error!=blot_error::Error.none {return blot_check_types::List{..},error;}projected=value;}let error=blot_check_core_builder::append(values,projected);if error!=blot_error::Error.none {return blot_check_types::List{..},error;}}return self_.saveTypes(values.items);}
fn reserve(self_:Builder&,source:u32)->u32,Error {if self_.tables.nodes.len==0xffffffff {return 0,blot_error::Error.core_limit;}let id=self_.tables.nodes.len as u32;self_.tables.nodes.push(blot_check_core::Node{tag:blot_check_core::Tag.invalid, ..});self_.tables.spans.push(self_.source.checked.diagnosticSpan(self_.source.tree,source));self_.tables.merge_ranges.push(List{..});self_.tables.dispatch_signatures.push(0);return id,blot_error::Error.none;}
fn make(self_:Builder&,source:u32,value:blot_check_core::Node)->u32,Error {let id,error=self_.reserve(source);if error!=blot_error::Error.none {return 0,error;}self_.tables.nodes[id]=value;if value.tag==blot_check_core::Tag.call || value.tag==blot_check_core::Tag.reference {let span=self_.source.tree.span(source);for use in self_.source.checked.selected_uses {let origin=self_.source.tree.span(use.source);if origin.start<span.start || origin.end>span.end {continue;}self_.tables.selected_uses.push(blot_check_core::SelectedUse{node:id,proof:use.proof, ..});}}
 if value.tag==blot_check_core::Tag.project && self_.tables.projections[value.b].diagnostic_point==0 {let field=self_.tables.projections[value.b].field;var member_point:u32=0;var matches:i64=0;var next:u32=0;if source<self_.scratch.member_origin_heads.len {next=self_.scratch.member_origin_heads[source];}while next!=0 {let index=next-1;let origin=self_.source.tree.operator_origins.items[index];next=self_.scratch.member_origin_next[index];if origin.member!=field {continue;}matches+=1;member_point=origin.member_point;if matches==2 {break;}}if matches==1 {let ordinary=self_.source.tree.span(source);let selected=self_.source.checked.diagnosticSpan(self_.source.tree,source);var point=member_point;if selected.start!=ordinary.start || selected.end!=ordinary.end {point=selected.start;}self_.tables.projections[value.b].diagnostic_point=point;}}
 if value.tag==blot_check_core::Tag.bind && value.a!=0 && value.a<self_.tables.bindings.len {self_.tables.bindings[value.a].initializer=value.b;if self_.tables.nodes[value.b].tag==blot_check_core::Tag.closure {let template .= self_.tables.closures[self_.tables.nodes[value.b].a];if template.qualifier==0 {template.qualifier=value.a;}}}if self_.scratch.signature_sources.len!=0 && self_.scratch.signature_sources[source]!=0 {let signature,error=self_.projectType(self_.scratch.signature_sources[source],0);if error!=blot_error::Error.none {return 0,error;}let callable=self_.tables.type_nodes[signature];if value.tag==blot_check_core::Tag.project && callable.tag==blot_check_types::Tag.function {let projected,error=self_.addType(blot_check_types::Node{tag:blot_check_types::Tag.function,a:self_.tables.nodes[value.a].ty,b:value.ty,c:callable.c, ..});if error!=blot_error::Error.none {return 0,error;}self_.tables.dispatch_signatures[id]=projected;}else {self_.tables.dispatch_signatures[id]=signature;}}return id,blot_error::Error.none;
}
fn save(self_:Builder&,values:const u32[:])->List,Error {if values.len>0xffffffff-self_.tables.extra.len {return List{..},blot_error::Error.core_limit;}let start=self_.tables.extra.len as u32;self_.tables.extra.append(values);return List{start,values.len as u32, ..},blot_error::Error.none;}
fn unwrap(self_:const Builder&,original:u32)->u32 {var source=original;while self_.source.tree.node(source).tag==blot_parse_ast::tag_group {source=self_.source.tree.node(source).a;}return source;}
fn target(self_:const Builder&,binding:u32)->blot_check_core::BindingRef {if binding>=self_.source.checked.bindings.len {return blot_check_core::BindingRef{binding:binding, ..};}let value=self_.source.checked.bindings[binding];if value.external.present {let external=value.external.value;return blot_check_core::BindingRef{unit:external.unit,binding:external.binding, ..};}return blot_check_core::BindingRef{binding:binding, ..};}
fn typeOf(self_:Builder&,source:u32)->u32,Error {return self_.projectType(self_.source.checked.expr_types[source],0);}
