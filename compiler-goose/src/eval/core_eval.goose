fn expression(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error {
 let outcome,error=expressionInner(self,owner,id,frame); if error!=Error.none { return Flow.value {0},error; }
 match outcome { value v=>{ if id==0 { return outcome,Error.none; } let projected,e=projectType(self,owner,id,self.units[owner].typeOf(id),frame.mappings,frame.row_mappings); if e!=Error.none { return Flow.value {0},e; } var actual=projected; if actual==0 { let principal,p=principalValueType(self,owner,id,v.value,frame); if p!=Error.none { return Flow.value {0},p; } actual=principal; } let view,e2=typedView(self,owner,id,v.value,actual); return Flow.value {view},e2; },_=>{ return outcome,Error.none; }, }
}
fn reflectionLabel(self: Session&,owner: i64,id: u32,label: u32,frame: const Frame&) -> u32,Error { let operation=self.units[owner].types.operation(label); var arguments: u32[>..<]=[]; for argument in self.units[owner].types.operationArguments(label) { let actual,error=projectType(self,owner,id,argument,frame.mappings,frame.row_mappings); if error!=Error.none { return 0,error; } if actual==0 { return 0,failNode(self,owner,id,Code.unsupported); } arguments.push(actual); } let result,error=self.storage.evidence.effects.internOperationInstance(operation.identity,arguments,operation.instance); if error!=Error.none { return 0,evidenceFailure(self,owner,self.units[owner].span(id),error); } return result,Error.none; }
fn containsReflectionType(self: Session&,owner: i64,id: u32,evidence: u32,depth: i64) -> bool,Error {
