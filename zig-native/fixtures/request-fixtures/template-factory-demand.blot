type Tick is effect = { read: Unit -> F32 }
const keep = fn ~value => fn () => @force value
const handled = fn computation => do:
  for request in @requests computation:
    case request of
      effect Tick.read () =>
        yield 42.5
      complete value =>
        break value
const create = fn action => do:
  let delayed = keep (action ())
  break @computation (fn () => delayed ())
entry const answer = fn () => do:
  let computation = create (fn () => Tick.read ())
  break handled computation
entry const folded = answer ()
