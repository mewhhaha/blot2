import std;
import i08_link_build;
import i08_link_verify;
fn source()->u8[] {return "pub let project: forall [r: Region, s: Region, n: Nat, c: Nat, d: Domain] => Fn[static, Many, (View[r,{x:F32,y:F32,vx:F32,vy:F32},n,d], F32, Builder[s,{x:F32,y:F32},0,c,Append]), exists [e: Domain] => View[s,{x:F32,y:F32},n,e]] ! {read r, write s} requires [Le(n,c)] resources {depth: 2, frame: 256} = fn (source,dt,initial) => do:\n  let built = for i in 0..n carry (b = initial)\n    invariant [Eq(Init(b),i)] do:\n      next (builder.append(b, {x: source[i].x + source[i].vx * dt, y: source[i].y + source[i].vy * dt}))\n  return builder.freeze(built)\n";}
fn replace(s:u8[:],a:u8[:],b:u8[:])->u8[] {var out:u8[>..]=[];var at:i64=0;var done=false;while at<s.len {if !done && a.len<=s.len-at && s[at..at+a.len]==a {out.append(b);at+=a.len;done=true;}else {out.push(s[at]);at+=1;}}assert(done);return out;}
fn main(){let s=source();var p,status=i08_link_build::build(s);assert(status==0 && i08_link_verify::verify(p,s));
 for i in p.tree.nodes.len {for f in 11 {let old=p.tree.nodes[i];if f==0 {p.tree.nodes[i].tag+=1;} else if f==1 {p.tree.nodes[i].start+=1;}else if f==2 {p.tree.nodes[i].end+=1;}else if f==3 {p.tree.nodes[i].a+=1;}else if f==4 {p.tree.nodes[i].b+=1;}else if f==5 {p.tree.nodes[i].c+=1;}else if f==6 {p.tree.nodes[i].d+=1;}else if f==7 {p.tree.nodes[i].e+=1;}else if f==8 {p.tree.nodes[i].f+=1;}else if f==9 {p.tree.nodes[i].g+=1;}else {p.tree.nodes[i].target+=1;}assert(!i08_link_verify::verify(p,s));p.tree.nodes[i]=old;}}
 for i in p.tree.bindings.len {for f in 4 {let old=p.tree.bindings[i];if f==0 {p.tree.bindings[i].start+=1;}else if f==1 {p.tree.bindings[i].end+=1;}else if f==2 {p.tree.bindings[i].kind+=1;}else {p.tree.bindings[i].scope+=1;}assert(!i08_link_verify::verify(p,s));p.tree.bindings[i]=old;}}
 for i in p.cap.steps.len {for f in 5 {let old=p.cap.steps[i];if f==0 {p.cap.steps[i].kind+=1;}else if f==1 {p.cap.steps[i].event+=1;}else if f==2 {p.cap.steps[i].node+=1;}else if f==3 {p.cap.steps[i].site+=1;}else {p.cap.steps[i].proof+=1;}assert(!i08_link_verify::verify(p,s));p.cap.steps[i]=old;}}
 for i in p.cap.job.events.len {for f in 13 {let old=p.cap.job.events[i];if f==0 {p.cap.job.events[i].kind+=1;}else if f==1 {p.cap.job.events[i].node+=1;}else if f==2 {p.cap.job.events[i].site+=1;}else if f==3 {p.cap.job.events[i].symbol+=1;}else if f==4 {p.cap.job.events[i].version+=1;}else if f==5 {p.cap.job.events[i].region+=1;}else if f==6 {p.cap.job.events[i].domain+=1;}else if f==7 {p.cap.job.events[i].index+=1;}else if f==8 {p.cap.job.events[i].a+=1;}else if f==9 {p.cap.job.events[i].b+=1;}else if f==10 {p.cap.job.events[i].output+=1;}else if f==11 {p.cap.job.events[i].output_version+=1;}else {p.cap.job.events[i].proof+=1;}assert(!i08_link_verify::verify(p,s));p.cap.job.events[i]=old;}}
 print("independent I08 link forged fields rejected");}
