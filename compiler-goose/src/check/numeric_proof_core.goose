}
fn Checker::summaryCondition(self: Checker&, module: const Module&, inputs: SummaryInputs, id: u32, depth: i64) -> u32, Error {
    if id == 0 || depth >= 32 { return 0, Error.none; } let err = self.values.charge(1); if err != Error.none { return 0, err; } let node = module.node(id);
    if node.tag == Tag.reference { let reference = module.reference(id); if reference.unit != 0 && reference.unit != module.unit { return 0, Error.none; } let value = inputs.lookup(reference.binding); if value.present { return value.value.condition, Error.none; } }
    if node.tag == Tag.call { let value, err = self.summaryInvocation(module, inputs, id, depth); return value.condition, err; }
    if node.tag == Tag.scalar && node.c == 0 && module.types.node(node.ty).tag == TypeTag.boolean { let left, err = self.summaryOperand(module, inputs, node.a, depth + 1); if err != Error.none { return 0, err; } let right, err = self.summaryOperand(module, inputs, node.b, depth + 1); if err != Error.none { return 0, err; } return self.comparison(node.op, left, right); }
    if node.tag == Tag.logical && (node.op == Op.and_ || node.op == Op.or_) { let left, err = self.summaryCondition(module, inputs, node.a, depth + 1); if err != Error.none { return 0, err; } let right, err = self.summaryCondition(module, inputs, node.b, depth + 1); if err != Error.none || (left == 0 && right == 0) { return 0, err; } return self.condition(Condition { op: node.op, left: left, right: right }); }
    if node.tag == Tag.if_value && module.types.node(node.ty).tag == TypeTag.boolean { var condition, err = self.summaryCondition(module, inputs, node.a, depth + 1); if err != Error.none { return 0, err; } let then_node = module.node(node.b); let else_node = module.node(node.c);
        if then_node.tag == Tag.constant && else_node.tag == Tag.constant && module.types.node(then_node.ty).tag == TypeTag.boolean && module.types.node(else_node.ty).tag == TypeTag.boolean { if then_node.a == else_node.a { return 0, Error.none; } if then_node.a != 0 { return condition, Error.none; } return self.condition(Condition { negated: true, left: condition }); }
        for branch, index in [node.c, node.b] { let fixed = module.node(branch); if fixed.tag != Tag.constant || module.types.node(fixed.ty).tag != TypeTag.boolean { continue; } var other = node.b; if index == 1 { other = node.c; let changed, err = self.condition(Condition { negated: true, left: condition }); if err != Error.none { return 0, err; } condition = changed; } let right, err = self.summaryCondition(module, inputs, other, depth + 1); if err != Error.none { return 0, err; } var op = Op.and_; if fixed.a != 0 { op = Op.or_; let changed, err = self.condition(Condition { negated: true, left: condition }); if err != Error.none { return 0, err; } condition = changed; } return self.condition(Condition { op: op, left: condition, right: right }); }
    }
