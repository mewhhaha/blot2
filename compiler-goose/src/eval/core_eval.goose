fn recordRegionTiming(region: ClosureRegion&) { let session: Session& =region.session; if !region.timing_active||session.timing==null||!requireReference(session.timing).clock.enabled||region.scratch.sources.len==0 { return; } let elapsed=regionElapsed(session,region.timing_started); if elapsed<1000 { return; } let source=region.scratch.sources.items[0]; let module=session.units[source.owner]; var binding=source.binding; if binding==0 { for body in module.bodies[1..] { if body.root==source.body { binding=body.binding; break; } } } var offset: u32=0; if binding!=0 { offset=module.sourceNamePoint(binding); } else if source.body!=0 { offset=module.span(source.body).start; } if session.diagnostic_context.identity.present {let found=session.diagnostic_context.identity.value.owner(unitId(session,source.owner));if found.present {recordRegionTimingName(region,source.owner,source.body,binding,offset,elapsed,found.value);return;}}recordRegionTimingName(region,source.owner,source.body,binding,offset,elapsed,"");}

