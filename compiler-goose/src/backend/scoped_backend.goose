        var optimization = blot_backend_optimized_bodies::Stats { tier: options.tier,..}; workspace.bytes.clear(); let assemble_trace = blot_phase_profile::region("owned.assemble",entry,0,0); let assembled = generator.module.assembleWithOptions(blot_backend_wasm::AssembleOptions { io: options.io, workers: options.workers, profile: options.profile, tier: options.tier, share_machine_code: options.share_machine_code, stats: optimization, .. },workspace.bytes); assemble_trace.exit();
