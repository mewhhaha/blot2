+    auto tabled = false;
+    auto classparam = [&](VarDef *cr, bool &view) -> int {
+        if (!tabled) return ClassParam(spec, cr, view);
+#ifndef NDEBUG
+        auto checked = view;
+        auto expected = ClassParam(spec, cr, checked);
+#endif
+        auto p = -1;
+        for (auto r = cr; r && p < 0; r = r->componentowner)
+            for (size_t q = 0; q < paramclasses.size(); q++) {
+                view = paramclasses[q].second == r;
+                if (paramclasses[q].first == r || view) {
+                    p = (int)q;
+                    break;
+                }
+            }
+        assert(p == expected && view == checked);
+        return p;
+    };
