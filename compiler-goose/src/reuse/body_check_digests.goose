struct PrivateFacts { tree: blot_parse_ast::Tree,checked: blot_check_check::Checked,ids: const u32[:]=default<const u32[:]>() }
enum PrivateVersionKind { source,binding }
struct PrivateVersion { kind: PrivateVersionKind,operand: u32 }
fn physical(self_: PrivateFacts,identity_: blot_check_types::NominalIdentity,selection: bool) -> blot_support::Option<u32> {
 if identity_.unit!=self_.checked.unit { return blot_support::none<u32>(); } let slot=digestPosition(self_.ids,identity_.decl); if !slot.present { return blot_support::none<u32>(); }
 for node in self_.checked.types.nodes.items { if node.tag!=blot_check_types::Tag.instance_selection||node.a!=identity_.unit||node.b!=identity_.decl { continue; } let arguments=self_.checked.types.nominalArguments(node); if arguments.len==2||arguments.len==3 { return blot_support::some(slot.value+1); } }
 if selection { return blot_support::none<u32>(); } for scope in self_.checked.effect_scopes { if scope.parameter!=identity_.decl||!digestPosition(self_.ids,scope.node).present { continue; } if !digestPosition(self_.ids,scope.callback).present { return blot_support::none<u32>(); } let callback=self_.tree.node(scope.callback); if callback.tag!=blot_parse_ast::tag_lambda||callback.a!=scope.parameter { return blot_support::none<u32>(); } return blot_support::some(slot.value+1); }
 if identity_.decl>=self_.checked.resolved.len { return blot_support::none<u32>(); } let binding=self_.checked.resolved[identity_.decl]; if binding==0||binding>=self_.checked.bindings.len { return blot_support::none<u32>(); } let parameter=self_.checked.bindings[binding]; if parameter.kind!=blot_reuse_principal_interface::Kind.parameter||parameter.declaration!=identity_.decl||!digestPosition(self_.ids,parameter.owner).present { return blot_support::none<u32>(); } let lambda=self_.tree.node(parameter.owner); if lambda.tag!=blot_parse_ast::tag_lambda||lambda.a!=parameter.declaration { return blot_support::none<u32>(); } var budget: i64=4096; if carrier(self_,parameter.ty,identity_,budget,0) { return blot_support::some(slot.value+1); } return blot_support::none<u32>();
}
fn carrier(self_: PrivateFacts,ty: u32,identity_: blot_check_types::NominalIdentity,budget: i64&,depth: i64) -> bool { if budget==0||depth>=128 { return false; } budget--; let node=self_.checked.types.node(self_.checked.types.head(ty,0)); match node.tag {
 scoped=>{ if node.b==identity_.unit&&node.c==identity_.decl { return true; } return carrier(self_,node.a,identity_,budget,depth+1); },usage=>{ return carrier(self_,node.a,identity_,budget,depth+1); },product=>{ for child in self_.checked.types.list(blot_check_types::List {node.a,node.b}) { if carrier(self_,child,identity_,budget,depth+1) { return true; } } },record=>{ for index in 0..node.b { if carrier(self_,self_.checked.types.recordField(node,index).ty,identity_,budget,depth+1) { return true; } } },_=>{}, } return false; }
fn version(self_: PrivateFacts,id: u32) -> blot_support::Option<PrivateVersion> {
 let node=self_.checked.types.node(id); if node.tag!=blot_check_types::Tag.instance_version||node.a!=self_.checked.unit { return blot_support::none<PrivateVersion>(); } var result=blot_support::none<PrivateVersion>();
 for binding in self_.checked.generative_bindings { let origin=digestPosition(self_.ids,binding.origin); if !origin.present { continue; } let selected=self_.checked.types.node(self_.checked.types.head(binding.selection,0)); if selected.tag!=blot_check_types::Tag.scoped||selected.b!=0 { continue; } let selection=self_.checked.types.node(self_.checked.types.head(selected.c,0)); if selection.tag!=blot_check_types::Tag.instance_selection { continue; } let arguments=self_.checked.types.nominalArguments(selection); if arguments.len!=3||self_.checked.types.head(arguments[2],0)!=id { continue; } let end=self_.tree.span(binding.origin).end; if end==0xffffffff||end+1!=node.b { continue; } let candidate=PrivateVersion {PrivateVersionKind.source,origin.value+1}; if result.present&&result.value!=candidate { return blot_support::none<PrivateVersion>(); } result=blot_support::some(candidate); }
 if result.present { return result; } for parent in self_.checked.types.nodes.items {
  if parent.tag==blot_check_types::Tag.instance_selection { let arguments=self_.checked.types.nominalArguments(parent); if arguments.len!=3||arguments[2]!=id||parent.a!=self_.checked.unit { continue; } let source=digestPosition(self_.ids,parent.b); if !source.present { continue; } let end=self_.tree.span(parent.b).end; if end==0xffffffff||end+1!=node.b { continue; } let candidate=PrivateVersion {PrivateVersionKind.source,source.value+1}; if result.present&&result.value!=candidate { return blot_support::none<PrivateVersion>(); } result=blot_support::some(candidate);
  } else if parent.tag==blot_check_types::Tag.nominal { let slot=blot_check_types::compilerNominalVersionArgument(blot_check_types::NominalIdentity {parent.a,parent.b}); if !slot.present { continue; } let arguments=self_.checked.types.nominalArguments(parent); if slot.value>=arguments.len||arguments[slot.value]!=id||node.b==0||node.b>=self_.checked.bindings.len { continue; } let binding=self_.checked.bindings[node.b]; if (binding.kind!=blot_reuse_principal_interface::Kind.local&&binding.kind!=blot_reuse_principal_interface::Kind.parameter)||!digestPosition(self_.ids,binding.declaration).present||!digestPosition(self_.ids,binding.owner).present { continue; } let usage=self_.checked.types.node(self_.checked.types.head(binding.ty,0)); if usage.tag!=blot_check_types::Tag.usage||usage.b!=blot_check_types::usageKindCode(blot_check_types::UsageKind.unique)||self_.checked.types.node(self_.checked.types.head(usage.a,0)).tag!=blot_check_types::Tag.array { continue; } let candidate=PrivateVersion {PrivateVersionKind.binding,node.b}; if result.present&&result.value!=candidate { return blot_support::none<PrivateVersion>(); } result=blot_support::some(candidate); }
 } return result;
}
fn rigid(self_: PrivateFacts,scope: u32) -> bool { if scope==0 { return false; } for implementation in self_.checked.rank_implementations { if implementation.scope==scope&&digestPosition(self_.ids,implementation.node).present { return true; } } for loan in self_.checked.usage_loans { if loan.region==0||!digestPosition(self_.ids,loan.source).present { continue; } let region=self_.checked.types.node(self_.checked.types.head(loan.region,0)); if region.tag==blot_check_types::Tag.rigid&&region.a==scope { return true; } } return false; }
fn bound(self_: PrivateFacts,id: u32) -> bool { var budget: i64=4096; for node in self_.checked.types.nodes.items { if budget==0 { return false; } budget--; if node.tag!=blot_check_types::Tag.forall&&node.tag!=blot_check_types::Tag.existential { continue; } if digestPosition(self_.checked.types.list(blot_check_types::List {node.b,node.c}),id).present { return true; } } return false; }
struct BoundScope { ids: const u32[:]=default<const u32[:]>(),parent: u32=0,live: bool=true }
reusable var digest_bound_scopes: BoundScope[>..]=[];
reusable[] var digest_bound_ids: u32[>..]=[];
fn pushBoundScope(ids: const u32[:],parent: u32) -> u32 { let owned=digest_bound_ids.alloc_slice(ids.len); for id,index in ids { owned[index]=id; } return (digest_bound_scopes.alloc_index(BoundScope {owned,parent,true})+1) as u32; }
fn popBoundScope(scope: u32) { assert(scope!=0&&scope<=digest_bound_scopes.len&&digest_bound_scopes[scope-1].live); digest_bound_ids.free_slice(digest_bound_scopes[scope-1].ids); digest_bound_scopes[scope-1]=BoundScope {live:false}; digest_bound_scopes.free(scope-1); }
fn digestPosition<T>(values: const T[:],wanted: T) -> blot_support::Option<u32> { for value,index in values { if value==wanted { return blot_support::some(index as u32); } } return blot_support::none<u32>(); }
fn digestBit(value: bool) -> u32 { if value { return 1; } return 0; }
fn hashWord(hash: blot_support_blake3::State&,value: u32) { var bytes: u8[4]=default<u8[4]>(); for index in 4 { bytes[index]=(value>>((index*8) as u32)) as! u8; } hash.update(bytes); }
fn hashWord(hash: blot_support_blake3::State&,value: i64) { hashWord(hash,value as u32); }
fn hashWord(hash: blot_support_blake3::State&,value: u16) { hashWord(hash,value as u32); }
fn hashWord(hash: blot_support_blake3::State&,value: u8) { hashWord(hash,value as u32); }
fn identity(self_: Catalog,value: blot_check_types::NominalIdentity) -> blot_support::Option<i64> { for nominal,index in self_.nominals { if nominal.identity==value { return blot_support::some(index); } } return blot_support::none<i64>(); }
fn unitOrigin(self_: Catalog,unit: u32) -> blot_support::Option<Digest> { if unit!=0&&self_.values.present&&self_.values.value.names.present { let names=self_.values.value.names.value; if names.has_unit_origin { return names.unitOrigin(unit); } } var hash=blot_support_blake3::init(); hashWord(hash,unit); return blot_support::some(blot_support_blake3::final(hash)); }
fn namedOrigin(self_: Catalog,origin: Digest,name: const u8[:]) -> blot_support::Option<i64> { var found=blot_support::none<i64>(); for nominal,index in self_.nominals { if self_.pool.get(nominal.name)!=name { continue; } let current=self_.unitOrigin(nominal.identity.unit); if !current.present { return blot_support::none<i64>(); } if origin!=current.value { continue; } if found.present { return blot_support::none<i64>(); } found=blot_support::some(index); } return found; }
fn named(self_: Catalog,unit: u32,name: const u8[:]) -> blot_support::Option<i64> { for nominal,index in self_.nominals { if nominal.identity.unit==unit&&self_.pool.get(nominal.name)==name { return blot_support::some(index); } } return blot_support::none<i64>(); }
fn operation(self_: Catalog,identity_: blot_check_types::NominalIdentity,budget: i64&) -> blot_support::Option<i64> { var found=blot_support::none<i64>(); for value,index in self_.effect_templates { if budget==0 { return blot_support::none<i64>(); } budget--; if value.identity!=identity_ { continue; } if found.present { return blot_support::none<i64>(); } found=blot_support::some(index); } return found; }
fn namedOperation(self_: Catalog,origin: Digest,name: const u8[:]) -> blot_support::Option<i64> { var budget: i64=4096; var found=blot_support::none<i64>(); for value,index in self_.effect_templates { if budget==0||value.family>=self_.effect_families.len { return blot_support::none<i64>(); } budget--; let family=self_.effect_families[value.family]; let current=self_.unitOrigin(value.identity.unit); if !current.present { return blot_support::none<i64>(); } if origin!=current.value { continue; } let separator=digestPosition(name,':' as u8); if !separator.present { return blot_support::none<i64>(); } let parsed=decimalSize(name[..separator.value]); if !parsed.present { return blot_support::none<i64>(); } let rest=name[separator.value+1..]; if parsed.value>rest.len as u64 { return blot_support::none<i64>(); } let size=parsed.value as i64; if rest[..size]!=self_.pool.get(family.name)||rest[size..]!=self_.pool.get(value.name) { continue; } if found.present { return blot_support::none<i64>(); } found=blot_support::some(index); } return found; }
fn familyIdentity(self_: Catalog,identity_: blot_check_types::NominalIdentity) -> blot_support::Option<i64> { for value,index in self_.effect_families { if value.identity==identity_ { return blot_support::some(index); } } return blot_support::none<i64>(); }
fn namedFamily(self_: Catalog,origin: Digest,name: const u8[:]) -> blot_support::Option<i64> { var found=blot_support::none<i64>(); for value,index in self_.effect_families { if self_.pool.get(value.name)!=name { continue; } let current=self_.unitOrigin(value.identity.unit); if !current.present||current.value!=origin||found.present { return blot_support::none<i64>(); } found=blot_support::some(index); } return found; }
fn contract(self_: Catalog,identity_: blot_check_types::NominalIdentity) -> blot_support::Option<blot_check_check::Contract> { for value in self_.contracts { if value.identity==identity_ { return blot_support::some(value); } } return blot_support::none<blot_check_check::Contract>(); }
fn namedContract(self_: Catalog,origin: Digest,name: const u8[:]) -> blot_support::Option<blot_check_check::Contract> { var found=blot_support::none<blot_check_check::Contract>(); for value in self_.contracts { if self_.pool.get(value.name)!=name { continue; } let current=self_.unitOrigin(value.identity.unit); if !current.present { return blot_support::none<blot_check_check::Contract>(); } if origin!=current.value { continue; } if found.present { return blot_support::none<blot_check_check::Contract>(); } found=blot_support::some(value); } return found; }
fn runtimeBinding(tree: const blot_parse_ast::Tree&,binding: blot_check_check::Binding) -> bool { return binding.kind==blot_reuse_principal_interface::Kind.global&&tree.node(binding.declaration).tag==blot_parse_ast::tag_value_decl&&tree.value_decl(binding.declaration).runtime; }
fn nominalDigest(source: Source,catalog: Catalog,index: i64) -> blot_support::Option<Digest> { var budget: i64=4096; return nominalDigestAt(source,catalog,index,0,budget); }
fn nominalDigestAt(source: Source,catalog: Catalog,index: i64,depth: i64,budget: i64&) -> blot_support::Option<Digest> {
 if depth>=128||budget==0 { return blot_support::none<Digest>(); } if catalog.recipes { let entry=catalog.recipes.lookup(index,depth); if entry.present { if entry.value.cost>budget { return blot_support::none<Digest>(); } budget-=entry.value.cost; return blot_support::some(entry.value.digest); } }
 let available=budget; budget--; let nominal=catalog.nominals[index]; if nominal.name==0||nominal.alias!=0 { return blot_support::none<Digest>(); } var storage=nominal.storage; if nominal.is_opaque&&storage.kind==blot_backend_opaque_storage::Kind.unknown { var storage_budget: i64=4096; storage=blot_backend_opaque_storage::infer(source,catalog.nominals,catalog.constructors,index as u32,storage_budget); } if nominal.is_opaque&&storage.kind==blot_backend_opaque_storage::Kind.unknown { return blot_support::none<Digest>(); }
 var hash=blot_support_blake3::init(); hashWord(hash,blot_parse_ast::tag_data_decl); let origin=catalog.unitOrigin(nominal.identity.unit); if !origin.present { return blot_support::none<Digest>(); } hash.update(origin.value); hash.update(catalog.pool.get(nominal.name)); hashWord(hash,digestBit(nominal.private)); hashWord(hash,digestBit(nominal.is_opaque)); hashWord(hash,digestBit(nominal.affine)); hashWord(hash,digestBit(nominal.has_usage)); hashWord(hash,digestBit(nominal.closed_storage)); hashWord(hash,blot_backend_opaque_storage::kindCode(storage.kind)); hashWord(hash,storage.parameter); hashWord(hash,storage.selector); hashWord(hash,nominal.parameters.len);
 for parameter in source.list(nominal.parameters) { if !typeHash(source,parameter,hash,budget,depth+1,false,source.list(nominal.variables),[],catalog) { return blot_support::none<Digest>(); } } if !parameterHash(source,catalog,nominal,hash,depth+1,budget) { return blot_support::none<Digest>(); } hashWord(hash,nominal.constructors.len);
 for constructor_index in source.list(nominal.constructors) { if constructor_index>=catalog.constructors.len { return blot_support::none<Digest>(); } let constructor=catalog.constructors[constructor_index]; let name=catalog.pool.get(constructor.name); if name.len==0 { return blot_support::none<Digest>(); } hashWord(hash,name.len); hash.update(name); hashWord(hash,constructor.tag); hashWord(hash,digestBit(constructor.private)); hashWord(hash,digestBit(constructor.declared_record)); if !typeHash(source,constructor.payload,hash,budget,depth+1,false,source.list(nominal.variables),[],catalog) { return blot_support::none<Digest>(); } }
