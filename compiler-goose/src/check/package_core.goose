fn openType(self_:Walker&,ty:u32,depth:i64)->bool,Error {return self_.scopeType(ty,depth,false);}
fn unsealedType(self_:Walker&,ty:u32,depth:i64)->bool,Error {return self_.scopeType(ty,depth,true);}
