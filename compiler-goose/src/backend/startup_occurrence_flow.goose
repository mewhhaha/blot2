struct Bindings {table:blot_support_pooled_map::Map<u32,u32> =blot_support_pooled_map::Map<u32,u32>{..}}
reusable[] var pool_Bindings:dictionary_slot<u32,u32>[>..]=[];
fn get(self_:const Bindings&,key:u32)->u32? {return blot_support_pooled_map::get(self_.table,key);}
fn contains(self_:const Bindings&,key:u32)->bool {return blot_support_pooled_map::contains(self_.table,key);}
fn insert(self_:Bindings&,key:u32,value:u32) {blot_support_pooled_map::insert(self_.table,key,value,pool_Bindings);}
fn remove(self_:Bindings&,key:u32) {blot_support_pooled_map::remove(self_.table,key);}
fn deinit(self_:Bindings&) {blot_support_pooled_map::deinit(self_.table,pool_Bindings);}
struct Constants {table:blot_support_pooled_map::Map<BindingRef,ValueId> =blot_support_pooled_map::Map<BindingRef,ValueId>{..}}
reusable[] var pool_Constants:dictionary_slot<BindingRef,ValueId>[>..]=[];
fn get(self_:const Constants&,key:BindingRef)->ValueId? {return blot_support_pooled_map::get(self_.table,key);}
fn contains(self_:const Constants&,key:BindingRef)->bool {return blot_support_pooled_map::contains(self_.table,key);}
fn insert(self_:Constants&,key:BindingRef,value:ValueId) {blot_support_pooled_map::insert(self_.table,key,value,pool_Constants);}
fn remove(self_:Constants&,key:BindingRef) {blot_support_pooled_map::remove(self_.table,key);}
fn deinit(self_:Constants&) {blot_support_pooled_map::deinit(self_.table,pool_Constants);}
struct Preparing {table:blot_support_pooled_map::Map<BindingRef,bool> =blot_support_pooled_map::Map<BindingRef,bool>{..}}
reusable[] var pool_Preparing:dictionary_slot<BindingRef,bool>[>..]=[];
fn get(self_:const Preparing&,key:BindingRef)->bool? {return blot_support_pooled_map::get(self_.table,key);}
fn contains(self_:const Preparing&,key:BindingRef)->bool {return blot_support_pooled_map::contains(self_.table,key);}
fn insert(self_:Preparing&,key:BindingRef,value:bool) {blot_support_pooled_map::insert(self_.table,key,value,pool_Preparing);}
fn remove(self_:Preparing&,key:BindingRef) {blot_support_pooled_map::remove(self_.table,key);}
fn deinit(self_:Preparing&) {blot_support_pooled_map::deinit(self_.table,pool_Preparing);}
struct Frame {values:Bindings=Bindings{..},possible_return:blot_support::Option<Return> =blot_support::Option<Return>{..}}
fn deinit(self_:Frame&) {self_.values.deinit();self_.possible_return=blot_support::none<Return>();}
struct Walk {units:const Module[:],session:Session&,root:BindingRef=BindingRef{..},edges:Edges=Edges{..},facts:Facts=Facts{..},values:Values=Values{..},children:Words=Words{..},fields:Words=Words{..},constants:Constants=Constants{..},preparing:Preparing=Preparing{..},expansions:Expansions=Expansions{..},steps:i64=0,depth:i64=0,prepared_partial:ValueId=0,failure:Error=blot_error::Error.none}
fn deinit(self_:Walk&) {self_.edges.deinit();self_.facts.deinit();self_.values.deinit();self_.children.deinit();self_.fields.deinit();self_.constants.deinit();self_.preparing.deinit();self_.expansions.deinit();}
fn failed(self_:Walk&)->bool {if self_.failure==blot_error::Error.none {for error in [self_.edges.failure,self_.facts.failure,self_.values.failure,self_.children.failure,self_.fields.failure,self_.expansions.failure] {if error!=blot_error::Error.none {self_.failure=error;break;}}}return self_.failure!=blot_error::Error.none;}
fn bad(self_:Walk&)->u32 {if self_.failure==blot_error::Error.none {self_.failure=blot_error::Error.incomplete;}return 0;}
fn charge(self_:Walk&)->bool {if self_.failed() {return false;}if self_.steps>=max_steps || self_.depth>=max_depth {self_.bad();return false;}self_.steps+=1;return true;}
fn unitId(self_:const Walk&,owner:i64)->u32 {let unit=self_.units[owner].unit;if unit!=0 {return unit;}return (owner+1) as u32;}
fn ownerOf(self_:Walk&,unit:u32,local:blot_support::Option<i64>)->i64 {if self_.failed() {return 0;}if unit==0 {if local.present {return local.value;}if self_.units.len==1 {return 0;}self_.bad();return 0;}for module,index in self_.units {if self_.unitId(index)==unit {return index;}}self_.bad();return 0;}
fn normalize(self_:Walk&,owner:blot_support::Option<i64>,initial:BindingRef)->BindingRef {var target=initial;var local=owner;for index in 0..128 {let producer=self_.ownerOf(target.unit,local);if self_.failed() {return BindingRef{..};}let module .= self_.units[producer];if target.binding==0 || target.binding>=module.bindings.len {self_.bad();return BindingRef{..};}let binding=module.binding(target.binding);if binding.kind!=blot_reuse_principal_interface::Kind.external {return BindingRef{unit:self_.unitId(producer),binding:target.binding};}target=binding.target;local=blot_support::some(producer);}self_.bad();return BindingRef{..};}
fn emit(self_:Walk&,site:Site,target:BindingRef,kind:EdgeKind,weak:bool,observe:bool) {if !observe || self_.failed() {return;}self_.edges.push(Edge{root:self_.root,target:target,weak:weak,kind:kind,unit:self_.unitId(site.owner),node:site.node});}
fn fact(self_:Walk&,site:Site,kind:FactKind,weak:bool,identity:u32,actual:blot_support::Option<u32>,observe:bool) {if !observe || self_.failed() {return;}var value:u32=0;if actual.present {value=actual.value;}self_.facts.push(Fact{root:self_.root,kind:kind,unit:self_.unitId(site.owner),node:site.node,weak:weak,identity:identity,value:value});}
fn add(self_:Walk&,value:Value)->ValueId {if self_.failed() {return 0;}if self_.values.len>=max_values {return self_.bad();}let id=self_.values.len as ValueId;self_.values.push(value);return id;}
fn aggregate(self_:Walk&,input:Value,children:const ValueId[:],fields:const u32[:])->ValueId {if self_.failed() {return 0;}if children.len>max_children-self_.children.len || fields.len>max_children-self_.fields.len {return self_.bad();}var value=input;value.children=List{start:self_.children.len as u32,len:children.len as u32};value.fields=List{start:self_.fields.len as u32,len:fields.len as u32};self_.children.append(children);self_.fields.append(fields);return self_.add(value);}
fn mode(value:Value,inherited:bool)->bool {if value.provenance==Provenance.ready {return true;}if value.provenance==Provenance.waiting {return false;}return inherited;}
fn boundary(self_:Walk&,id:ValueId,provenance:Provenance)->ValueId {if self_.failed() {return 0;}var value=self_.values.items[id];value.provenance=provenance;return self_.add(value);}
fn context(self_:Walk&,id:ValueId,weak:bool)->ValueId {if self_.failed() {return 0;}if !weak || self_.values.items[id].provenance!=Provenance.inherit {return id;}return self_.boundary(id,Provenance.ready);}
fn scalarType(self_:Walk&,owner:i64,ty:u32,known:bool,bits:u32)->ValueId {if self_.failed() {return 0;}let module .= self_.units[owner];if ty>=module.types.nodes.len {return self_.bad();}let tag=module.types.node(ty).tag;var scalar=blot_backend_runtime_ir::SC_unit;if tag==blot_check_types::Tag.boolean {scalar=blot_backend_runtime_ir::SC_bool;}else if tag==blot_check_types::Tag.unsigned32 {scalar=blot_backend_runtime_ir::SC_u32;}else if tag==blot_check_types::Tag.floating32 {scalar=blot_backend_runtime_ir::SC_f32;}else if tag!=blot_check_types::Tag.unit {return self_.bad();}return self_.add(Value{scalar:ScalarValue{scalar:scalar,bits:bits},known:known || scalar==blot_backend_runtime_ir::SC_unit,..});}
fn placeholder(self_:Walk&,owner:i64,ty:u32)->ValueId {return self_.scalarType(owner,ty,false,0);}
fn body(self_:Walk&,target:BindingRef)->Body {let owner=self_.ownerOf(target.unit,blot_support::none<i64>());if self_.failed() {return Body{..};}let module .= self_.units[owner];if target.binding>=module.bindings.len {self_.bad();return Body{..};}let binding=module.binding(target.binding);if binding.body_id==0 || binding.body_id>=module.bodies.len {self_.bad();return Body{..};}return module.bodies[binding.body_id];}
fn named(self_:Walk&,target:BindingRef)->ValueId {return self_.add(Value{kind:Kind.closure,closure:ClosureValue{unit:target.unit,identity:target.binding,origin:blot_eval_eval_values::ClosureOrigin.named,..},..});}
recursive fn constant(self_:Walk&,target:BindingRef)->ValueId {if self_.failed() {return 0;}let cached .= self_.constants.get(target);if cached {return cached;}if self_.preparing.contains(target) {return self_.bad();}let owner=self_.ownerOf(target.unit,blot_support::none<i64>());let declaration=self_.body(target);if self_.failed() {return 0;}if declaration.runtime {return self_.bad();}let actual,present,error=self_.session.cachedBindingValue(target);if error!=blot_error::Error.none {self_.failure=blot_error::Error.incomplete;if error==blot_error::Error.out_of_memory {self_.failure=error;}return 0;}if declaration.is_function {var result=self_.named(target);if present {result=self_.alignActual(actual,result);}if !self_.failed() {self_.constants.insert(target,result);}return result;}if !present {return self_.bad();}self_.preparing.insert(target,true);var frame=Frame{..};let result=self_.expression(owner,declaration.root,frame,false,false);frame.deinit();self_.preparing.remove(target);if self_.failed() {return 0;}if result.returning {return self_.bad();}let value=self_.alignActual(actual,result.value);if !self_.failed() {self_.constants.insert(target,value);}return value;}
recursive fn alignActual(self_:Walk&,actual:u32,symbolic:ValueId)->ValueId {if !self_.charge() {return 0;}self_.depth+=1;let value=alignActualInner(self_,actual,symbolic);self_.depth-=1;return value;}
recursive fn alignActualInner(self_:Walk&,actual:u32,symbolic:ValueId)->ValueId {if actual>=self_.session.storage.values.len {return self_.bad();}let info=self_.session.valueInfo(actual);var value=self_.values.items[symbolic];var kind=Kind.scalar;let source=info.kind;if source==blot_eval_eval_values::ValueKind.product {kind=Kind.product;}else if source==blot_eval_eval_values::ValueKind.record {kind=Kind.record;}else if source==blot_eval_eval_values::ValueKind.nominal {kind=Kind.nominal;}else if source==blot_eval_eval_values::ValueKind.array || source==blot_eval_eval_values::ValueKind.list {kind=Kind.array;}else if source==blot_eval_eval_values::ValueKind.closure {kind=Kind.closure;}else if source!=blot_eval_eval_values::ValueKind.scalar {return self_.bad();}if kind!=value.kind || info.len!=value.children.len {return self_.bad();}if kind==Kind.scalar {if !value.known || value.scalar.scalar!=info.scalar || value.scalar.bits!=info.bits {return self_.bad();}}else if kind==Kind.closure {let metadata=self_.session.closureInfo(actual);let source=value.closure;if metadata.origin!=source.origin || metadata.unit!=source.unit || metadata.identity!=source.identity || metadata.applied!=source.applied {return self_.bad();}value.closure=metadata;}else if kind==Kind.nominal {if value.nominal.unit!=(info.nominal>>32) as! u32 || value.nominal.decl!=info.nominal as! u32 || value.tag!=info.bits {return self_.bad();}}let children=word_runs.alloc_slice(info.len);for &child,index in children {child=self_.alignActual(self_.session.storage.children.items[info.start+index],self_.children.items[value.children.start+index]);}let fields=word_runs.alloc_slice(value.fields.len);for &field,index in fields {field=self_.fields.items[value.fields.start+index];}if kind==Kind.record {if actual>=self_.session.storage.value_records.len {self_.bad();}else {let layout_id=self_.session.storage.value_records.items[actual];if layout_id>=self_.session.storage.record_layouts.len {self_.bad();}else {let layout=self_.session.storage.record_layouts.items[layout_id];if layout.len!=fields.len || self_.session.storage.field_names.items[layout.start..layout.start+layout.len]!=fields {self_.bad();}}}}value.actual=blot_support::some(actual);let result=self_.aggregate(value,children,fields);word_runs.free_slice(children);word_runs.free_slice(fields);return result;}
fn enter(self_:Walk&,metadata:ClosureValue) {if self_.failed() {return;}let key=Expansion{unit:metadata.unit,identity:metadata.identity,origin:metadata.origin};for active in self_.expansions.items {if active==key {self_.bad();return;}}if self_.expansions.len>=max_depth {self_.bad();return;}self_.expansions.push(key);}

recursive fn invoke(self_:Walk&,function:ValueId,arguments:const ValueId[:],site:Site,inherited:bool,observe:bool,retention:bool)->ValueId {return self_.invokeScalarInterface(function,arguments,site,inherited,observe,retention,blot_support::none<ScalarInterface>());}
recursive fn invokeScalarInterface(self_:Walk&,function:ValueId,arguments:const ValueId[:],site:Site,inherited:bool,observe:bool,retention:bool,expected:blot_support::Option<ScalarInterface>)->ValueId {if !self_.charge() {return 0;}let value=self_.values.items[function];if value.kind!=Kind.closure {return self_.bad();}let weak=mode(value,inherited);let metadata=value.closure;let owner=self_.ownerOf(metadata.unit,blot_support::none<i64>());if self_.failed() {return 0;}let module .= self_.units[owner];if metadata.origin==blot_eval_eval_values::ClosureOrigin.operation {return self_.bad();}if metadata.origin==blot_eval_eval_values::ClosureOrigin.primitive {if metadata.identity>=module.primitives.len {return self_.bad();}let primitive=module.primitives[metadata.identity];if metadata.applied!=value.children.len || metadata.applied>primitive.arity || arguments.len>primitive.arity-metadata.applied {return self_.bad();}let count=value.children.len+arguments.len;let supplied=word_runs.alloc_slice(count);for child,index in self_.children.items[value.children.start..value.children.start+value.children.len] {supplied[index]=child;}for argument,index in arguments {supplied[value.children.len+index]=argument;}var result:ValueId=0;if count!=primitive.arity {var partial=value;partial.closure.applied=count as u32;partial.actual=blot_support::none<u32>();result=self_.aggregate(partial,supplied,[]);}else if primitive.kind==blot_check_core::PrimitiveKind.array {result=self_.arrayValues(primitive.array_op,supplied,site,weak,observe);}else {var second:ValueId=0;if count!=1 {second=supplied[1];}result=self_.scalar(primitive.op,supplied[0],second);}word_runs.free_slice(supplied);return result;}if metadata.origin==blot_eval_eval_values::ClosureOrigin.constructor {if metadata.applied!=0 || arguments.len!=1 || metadata.identity>=module.constructors.len {return self_.bad();}return self_.construct(owner,metadata.identity,blot_support::some(arguments[0]),true);}
 var frame=Frame{..};let body_root=prepareInvocation(self_,value,arguments,site,weak,observe,retention,expected,owner,frame);if self_.failed() {frame.deinit();return 0;}if body_root==0 {frame.deinit();return self_.prepared_partial;}self_.enter(metadata);if self_.failed() {frame.deinit();return 0;}let body_site=Site{owner:owner,node:body_root};self_.fact(body_site,FactKind.body_enter,weak,metadata.identity,value.actual,observe);let outcome=self_.expression(owner,body_root,frame,weak,observe);self_.expansions.pop();let pending_return=frame.possible_return.present;frame.deinit();if self_.failed() {return 0;}if outcome.returning || pending_return {return self_.bad();}if expected.present {let result=self_.values.items[outcome.value];if result.kind!=Kind.scalar || result.scalar.scalar!=expected.value.result {return self_.bad();}}self_.fact(body_site,FactKind.body_complete,weak,metadata.identity,value.actual,observe);return self_.context(outcome.value,weak);
