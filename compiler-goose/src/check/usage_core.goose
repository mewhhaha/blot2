// Executable references independently prove moves, captures and loan scopes.
namespace blot_check_usage_core;
import support.error;
import support.option;
import .core;
import .types;
import .check;
import .usage_check;
import .rank_equal;
import .typed_staging;
import .task_types;
import .cleanup_contracts;
import .task_core;
import .closed_nominal_storage;
import .capability_contracts;
import .capability_contract_core;
import eval.body_recipe;
type Error = blot_error::Error;
type Module = blot_check_core::Module;
type Tag = blot_check_core::Tag;
type TypeTag = blot_check_types::Tag;
type Usage = blot_check_types::UsageKind;
struct State { binding: u32, first: u32 = 0, loan: u32 = 0 }
enum Outcome { live, exit }
struct ExitFrame { target: u32, joined: State[:], seen: bool = false, parent: ExitFrame? = null }
struct StageEnvironment { states: State[:], regions: const u32[:], bindings: const u32[:], ambient: u32, returns: ExitFrame?, breaks: ExitFrame?, earlier: StageEnvironment? }
struct Walker {
    module: const Module&, states: State[4096], len: i64 = 0, snapshots: State[65536], snapshot_len: i64 = 0, remaining: i64 = 65536,
    regions: u32[128], region_bindings: u32[128], region_count: i64 = 0, ambient: u32 = 0,
    returns: ExitFrame? = null, breaks: ExitFrame? = null, earlier: StageEnvironment? = null
}
fn Walker::record(self: Walker&, frame: ExitFrame&) { frame.seen = true; for &entry, index in frame.joined { if entry.first == 0 { entry.first = self.states[index].first; } } }
fn Walker::charge(self: Walker&, depth: i64) -> Error { if depth >= 128 || self.remaining == 0 { return Error.invalid_artifact; } self.remaining -= 1; return Error.none; }
fn Walker::snapshot(self: Walker&) -> State[:], Error { if self.len > self.snapshots.len - self.snapshot_len || self.len > self.remaining { return [], Error.invalid_artifact; } self.remaining -= self.len; let values = self.snapshots[self.snapshot_len..self.snapshot_len + self.len]; self.snapshot_len += self.len; for value, index in self.states[..self.len] { values[index] = value; } return values, Error.none; }
fn copy(destination: State[:], source: const State[:]) { for value, index in source { destination[index] = value; } }
fn Walker::block(self: Walker&, source: u32, depth: i64) -> Outcome, Error { let count = self.len; let mark = self.snapshot_len; let joined, err = self.snapshot(); if err != Error.none { return Outcome.live, err; } var frame = ExitFrame { target: source, joined: joined, parent: self.returns }; let outer .= self.returns; self.returns .= frame;
    let node = self.module.nodes[source]; var flow = Outcome.live; var error = Error.none; for child in self.module.extra[node.a..node.a + node.b] { let result, err = self.expression(child, depth + 1); if err != Error.none { error = err; break; } if result == Outcome.exit { flow = Outcome.exit; break; } } self.len = count; self.returns .= outer; self.snapshot_len = mark; if error != Error.none { return flow, error; }
    if frame.seen { if flow == Outcome.exit { copy(self.states[..count], frame.joined); } else { for &entry, index in self.states[..count] { if entry.first == 0 { entry.first = frame.joined[index].first; } } } return Outcome.live, Error.none; } return flow, Error.none;
}
fn Walker::singleIteration(self: Walker&, loop: blot_check_core::LoopInfo) -> bool { if loop.kind != blot_check_core::LoopKind.range { return false; } let first = self.module.nodes[loop.first]; let end = self.module.nodes[loop.end]; if first.tag != Tag.constant || end.tag != Tag.constant || first.ty != blot_check_types::u32_type || end.ty != blot_check_types::u32_type { return false; } return first.a < end.a && end.a - first.a == 1; }
fn Walker::affine(self: Walker&, ty: u32) -> bool, Error { let value, err = blot_check_usage_check::affineNominal(self.module.types, self.module.nominals, ty); if err != Error.none { return false, Error.invalid_artifact; } return value, Error.none; }
fn Walker::state(self: Walker&, binding: u32) -> State? { for entry in self.states[..self.len] { if entry.binding == binding { return entry; } } return null; }
fn Walker::introduce(self: Walker&, binding: u32) -> Error { if binding == 0 { return Error.none; } if binding >= self.module.bindings.len { return Error.invalid_artifact; } if self.state(binding) { return Error.none; } let affine, err = self.affine(self.module.bindings[binding].ty); if err != Error.none { return err; } if !affine { return Error.none; } if self.len == self.states.len { return Error.invalid_artifact; } self.states[self.len] = State { binding: binding }; self.len += 1; return Error.none; }
fn Walker::use(self: Walker&, binding: u32, source: u32) -> Error { if binding == 0 || binding >= self.module.bindings.len { return Error.invalid_artifact; } let affine, err = self.affine(self.module.bindings[binding].ty); if err != Error.none { return err; } if !affine { return Error.none; } let entry .= self.state(binding); if !entry || entry.first != 0 || entry.loan != 0 { return Error.invalid_artifact; } entry.first = source; return Error.none; }
fn Walker::liveLoans(self: Walker&, ty: u32, depth: i64) -> Error { let err = self.charge(depth); if err != Error.none { return err; } let node = self.module.types.node(ty); match node.tag {
    TypeTag.usage => { if node.c != 0 { var live = false; for region in self.regions[..self.region_count] { if node.c == region { live = true; } } if !live { return Error.invalid_artifact; } } return self.liveLoans(node.a, depth + 1); },
    TypeTag.array, TypeTag.list, TypeTag.cursor => { return self.liveLoans(node.a, depth + 1); },
    TypeTag.product => { for child in self.module.types.list(blot_check_types::List { node.a, node.b }) { let err = self.liveLoans(child, depth + 1); if err != Error.none { return err; } } },
    TypeTag.record => { for index in 0..node.b { let err = self.liveLoans(self.module.types.recordField(node, index).ty, depth + 1); if err != Error.none { return err; } } },
    TypeTag.nominal => { for child in self.module.types.nominalArguments(node) { let err = self.liveLoans(child, depth + 1); if err != Error.none { return err; } } }, _ => {},
    } return Error.none;
}
fn Walker::activeType(self: Walker&, ty: u32, depth: i64) -> bool, Error { let err = self.charge(depth); if err != Error.none { return false, err; } let node = self.module.types.node(ty); match node.tag {
    TypeTag.usage => { for region in self.regions[..self.region_count] { if node.c == region { return true, Error.none; } } return self.activeType(node.a, depth + 1); },
    TypeTag.array, TypeTag.list, TypeTag.cursor => { return self.activeType(node.a, depth + 1); },
    TypeTag.function => { let a, err = self.activeType(node.a, depth + 1); if err != Error.none || a { return a, err; } return self.activeType(node.b, depth + 1); },
    TypeTag.product => { for child in self.module.types.list(blot_check_types::List { node.a, node.b }) { let found, err = self.activeType(child, depth + 1); if err != Error.none || found { return found, err; } } },
    TypeTag.record => { for index in 0..node.b { let found, err = self.activeType(self.module.types.recordField(node, index).ty, depth + 1); if err != Error.none || found { return found, err; } } },
    TypeTag.nominal => { for child in self.module.types.nominalArguments(node) { let found, err = self.activeType(child, depth + 1); if err != Error.none || found { return found, err; } } }, _ => {},
    } return false, Error.none;
}
fn Walker::scalar(self: Walker&, ty: u32) -> bool { let tag = self.module.types.node(ty).tag; return tag == TypeTag.unit || tag == TypeTag.boolean || tag == TypeTag.unsigned32 || tag == TypeTag.floating32; }
fn Walker::capturedLoan(self: Walker&, source: u32, excluded: u32, depth: i64) -> bool, Error { let err = self.charge(depth); if err != Error.none { return false, err; } if source == 0 { return false, Error.none; } let node = self.module.nodes[source]; match node.tag {
    Tag.reference => { return self.carriesLoan(source, excluded, depth + 1); },
    Tag.constant, Tag.primitive_function, Tag.constructor_function, Tag.type_constructor, Tag.panic => { return false, Error.none; },
    Tag.closure => { let value = self.module.closures[node.a]; return self.capturedLoan(value.body, value.parameter.binding, depth + 1); },
    Tag.apply, Tag.scalar, Tag.logical, Tag.record_merge, Tag.proof_guard, Tag.resource_acquire, Tag.usage_borrow => { let found, err = self.capturedLoan(node.a, excluded, depth + 1); if err != Error.none || found { return found, err; } return self.capturedLoan(node.b, excluded, depth + 1); },
    Tag.resource_release, Tag.usage_share, Tag.usage_read, Tag.project, Tag.return_, Tag.package_pack => { return self.capturedLoan(node.a, excluded, depth + 1); },
    Tag.effect_scope => { if node.a == 0 || node.a >= self.module.nodes.len { return false, Error.invalid_artifact; } return self.capturedLoan(node.a, excluded, depth + 1); },
    Tag.bind, Tag.construct => { return self.capturedLoan(node.b, excluded, depth + 1); },
    Tag.if_value, Tag.if_stmt => { for child in [node.a, node.b, node.c] { let found, err = self.capturedLoan(child, excluded, depth + 1); if err != Error.none || found { return found, err; } } },
    Tag.task, Tag.block_, Tag.suite, Tag.product, Tag.record, Tag.array, Tag.array_op, Tag.storage => { for child in self.module.extra[node.a..node.a + node.b] { let found, err = self.capturedLoan(child, excluded, depth + 1); if err != Error.none || found { return found, err; } } },
    Tag.call => { let target = self.module.calls[node.a].target; if target.unit == 0 || target.unit == self.module.unit { for definition in self.module.nodes { let err = self.charge(depth); if err != Error.none { return false, err; } if definition.tag == Tag.bind && definition.a == target.binding { let found, err = self.carriesLoan(definition.b, excluded, depth + 1); if err != Error.none || found { return found, err; } } } } for child in self.module.extra[node.b..node.b + node.c] { let found, err = self.capturedLoan(child, excluded, depth + 1); if err != Error.none || found { return found, err; } } }, _ => { return false, Error.invalid_artifact; },
    } return false, Error.none;
}
fn Walker::carriesLoan(self: Walker&, source: u32, excluded: u32, depth: i64) -> bool, Error { let err = self.charge(depth); if err != Error.none { return false, err; } if source == 0 { return false, Error.none; } let node = self.module.nodes[source]; let active, err = self.activeType(node.ty, depth + 1); if err != Error.none || active { return active, err; }
    match node.tag {
        Tag.reference => { let ref = self.module.references[node.a]; if (ref.unit != 0 && ref.unit != self.module.unit) || ref.binding == excluded { return false, Error.none; } for binding in self.region_bindings[..self.region_count] { if binding == ref.binding { return true, Error.none; } } for definition in self.module.nodes { let err = self.charge(depth); if err != Error.none { return false, err; } if definition.tag == Tag.bind && definition.a == ref.binding { return self.carriesLoan(definition.b, excluded, depth + 1); } } let active, err = self.activeType(self.module.bindings[ref.binding].ty, depth + 1); if err != Error.none || active { return active, err; } let binding = self.module.bindings[ref.binding]; if binding.kind == blot_check_check::Kind.parameter || binding.kind == blot_check_check::Kind.global || binding.kind == blot_check_check::Kind.external || self.scalar(node.ty) { return false, Error.none; } return false, Error.invalid_artifact; },
        Tag.constant => { if !self.scalar(node.ty) { return false, Error.invalid_artifact; } },
        Tag.usage_share => { return self.carriesLoan(node.a, excluded, depth + 1); },
        Tag.resource_release, Tag.primitive_function, Tag.constructor_function, Tag.type_constructor, Tag.usage_read => {},
        Tag.resource_acquire => { return false, Error.none; },
        Tag.scalar, Tag.logical, Tag.call, Tag.apply => { if !self.scalar(node.ty) { return false, Error.invalid_artifact; } },
        Tag.closure => { let value = self.module.closures[node.a]; return self.capturedLoan(value.body, value.parameter.binding, depth + 1); },
        Tag.project, Tag.return_, Tag.package_pack => { return self.carriesLoan(node.a, excluded, depth + 1); },
        Tag.bind, Tag.construct => { return self.carriesLoan(node.b, excluded, depth + 1); },
        Tag.if_value, Tag.if_stmt => { let found, err = self.carriesLoan(node.b, excluded, depth + 1); if err != Error.none || found { return found, err; } return self.carriesLoan(node.c, excluded, depth + 1); },
        Tag.task, Tag.block_, Tag.suite, Tag.product, Tag.record, Tag.array, Tag.array_op, Tag.storage => { for child in self.module.extra[node.a..node.a + node.b] { let found, err = self.carriesLoan(child, excluded, depth + 1); if err != Error.none || found { return found, err; } } }, _ => { return false, Error.invalid_artifact; },
    } return false, Error.none;
}
fn Walker::argument(self: Walker&, source: u32, parameter: u32, depth: i64) -> Error { if self.region_count == 0 { return Error.none; } let carries, err = self.carriesLoan(source, 0, depth + 1); if err != Error.none { return err; } if !carries { return Error.none; } let actual = self.module.types.node(self.module.typeOf(source)); let required = self.module.types.node(parameter); if actual.tag != TypeTag.usage || required.tag != TypeTag.usage || actual.b != required.b || (actual.b != blot_check_types::usageCode(Usage.borrow) && actual.b != blot_check_types::usageCode(Usage.borrow_mut)) { return Error.invalid_artifact; } let equal, err = blot_check_rank_equal::equal(self.module.types, actual.a, required.a, true); if err != Error.none || !equal { return Error.invalid_artifact; } if actual.c == required.c { return Error.none; } let region = self.module.types.node(required.c); if region.tag != TypeTag.bound || region.b != 2 || region.c != 0 || !formalRegion(self.module, required.c, self.remaining) { return Error.invalid_artifact; } return Error.none; }
fn Walker::argumentArrow(self: Walker&, ty: u32) -> blot_check_types::Node, Error { var current = ty; while true { let err = self.charge(0); if err != Error.none { return default<blot_check_types::Node>(), err; } let node = self.module.types.node(current); if node.tag != TypeTag.usage && node.tag != TypeTag.forall { return node, Error.none; } current = node.a; } }
fn Walker::quantified(self: Walker&, ty: u32) -> blot_check_types::Node, Error { var current = ty; while true { let err = self.charge(0); if err != Error.none { return default<blot_check_types::Node>(), err; } let node = self.module.types.node(current); if node.tag == TypeTag.usage { current = node.a; continue; } if node.tag != TypeTag.forall { return node, Error.none; } if node.c == 0 || node.c > 128 || node.b > self.module.types.extra.len || node.c > self.module.types.extra.len - node.b { return node, Error.invalid_artifact; }
    for binder, ordinal in self.module.types.list(blot_check_types::List { node.b, node.c }) { if binder >= self.module.types.nodes.len { return node, Error.invalid_artifact; } let bound = self.module.types.node(binder); if bound.tag != TypeTag.bound || bound.c != 0 || bound.a != ordinal || (bound.b != 0 && bound.b != 2) { return node, Error.invalid_artifact; } if bound.b != 2 { continue; } if self.region_count == self.regions.len { return node, Error.invalid_artifact; } self.regions[self.region_count] = binder; self.region_bindings[self.region_count] = 0; self.region_count += 1; } current = node.a;
    }
}
fn Walker::reference(self: Walker&, catalog: u32, source: u32) -> Error { if catalog >= self.module.references.len { return Error.invalid_artifact; } let ref = self.module.references[catalog]; let err = self.liveLoans(self.module.nodes[source].ty, 0); if err != Error.none { return err; } if ref.unit != 0 && ref.unit != self.module.unit { let affine, err = self.affine(self.module.nodes[source].ty); if err != Error.none { return err; } if affine { return Error.invalid_artifact; } return Error.none; } return self.use(ref.binding, source); }
fn Walker::pattern(self: Walker&, source: u32, depth: i64) -> Error { let err = self.charge(depth); if err != Error.none { return err; } if source == 0 || source >= self.module.patterns.len { return Error.invalid_artifact; } let node = self.module.patterns[source]; match node.tag {
    blot_check_core::PatternTag.bind => { return self.introduce(node.a); }, blot_check_core::PatternTag.constructor => { if node.b != 0 { return self.pattern(node.b, depth + 1); } }, blot_check_core::PatternTag.product => { for child in self.module.extra[node.a..node.a + node.b] { let err = self.pattern(child, depth + 1); if err != Error.none { return err; } } }, _ => {},
    } return Error.none;
}
fn Walker::branches(self: Walker&, left: u32, right: u32, depth: i64) -> Outcome, Error { let mark = self.snapshot_len; let result, err = branchesBody(self, left, right, depth); self.snapshot_len = mark; return result, err; }
fn branchesBody(self: Walker&, left: u32, right: u32, depth: i64) -> Outcome, Error { let count = self.len; let before, err = self.snapshot(); if err != Error.none { return Outcome.live, err; } let left_flow, err = self.expression(left, depth + 1); if err != Error.none { return Outcome.live, err; } self.len = count; let after, err = self.snapshot(); if err != Error.none { return Outcome.live, err; } copy(self.states[..count], before[..count]); var right_flow = Outcome.live; if right != 0 { let flow, err = self.expression(right, depth + 1); if err != Error.none { return Outcome.live, err; } right_flow = flow; } self.len = count;
    for &entry, index in self.states[..count] { let first = after[index]; if right_flow == Outcome.exit { entry = first; } else if left_flow != Outcome.exit && entry.first == 0 { entry.first = first.first; } } if left_flow == Outcome.exit && right_flow == Outcome.exit { return Outcome.exit, Error.none; } return Outcome.live, Error.none;
}
fn Walker::cases(self: Walker&, index: u32, depth: i64) -> Outcome, Error { let mark = self.snapshot_len; let result, err = casesBody(self, index, depth); self.snapshot_len = mark; return result, err; }
fn casesBody(self: Walker&, index: u32, depth: i64) -> Outcome, Error { let info = self.module.matches[index]; for input in self.module.extra[info.inputs.start..info.inputs.start + info.inputs.len] { let flow, err = self.expression(input, depth + 1); if err != Error.none { return Outcome.live, err; } } let count = self.len; let before, err = self.snapshot(); if err != Error.none { return Outcome.live, err; } let joined, err = self.snapshot(); if err != Error.none { return Outcome.live, err; } var live = false;
    for arm in self.module.match_arms[info.arms.start..info.arms.start + info.arms.len] { copy(self.states[..count], before[..count]); for row in self.module.pattern_rows[arm.rows.start..arm.rows.start + arm.rows.len] { for pattern in self.module.extra[row.patterns.start..row.patterns.start + row.patterns.len] { let err = self.pattern(pattern, depth + 1); if err != Error.none { return Outcome.live, err; } } }
        if arm.guard != 0 { let flow, err = self.expression(arm.guard, depth + 1); if err != Error.none { return Outcome.live, err; } if flow == Outcome.exit { self.len = count; continue; } for &entry, index in before[..count] { if entry.first == 0 { entry.first = self.states[index].first; } } for entry in self.states[count..self.len] { if entry.first != 0 { return Outcome.live, Error.invalid_artifact; } } }
        let flow, err = self.expression(arm.body, depth + 1); if err != Error.none { return Outcome.live, err; } self.len = count; if flow == Outcome.live { live = true; for &entry, index in joined[..count] { if entry.first == 0 { entry.first = self.states[index].first; } } }
    } copy(self.states[..count], joined[..count]); if !live { return Outcome.exit, Error.none; } return Outcome.live, Error.none;
}
fn Walker::closure(self: Walker&, index: u32, ty: u32, depth: i64) -> Error {
    if index >= self.module.closures.len { return Error.invalid_artifact; } let value = self.module.closures[index]; let qualifier = self.module.types.node(ty); if qualifier.tag == TypeTag.usage && qualifier.b == blot_check_types::usageCode(Usage.concurrent) { return Error.invalid_artifact; } let once = qualifier.tag == TypeTag.usage && qualifier.b == blot_check_types::usageCode(Usage.once); let count = self.len; var found: bool[4096] = [false;4096]; let err = self.capture(value.body, found, depth + 1); if err != Error.none { return err; }
    for captured, index in found[..count] { if captured { let entry .= self.states[index]; if !once || entry.first != 0 { return Error.invalid_artifact; } entry.first = value.body; } }
    let mark = self.snapshot_len; let saved, err = self.snapshot(); if err != Error.none { return err; } let region_count = self.region_count; let ambient = self.ambient; let returns .= self.returns; let breaks .= self.breaks;
    let result = closureBody(self, value, ty, found, count, depth); self.len = count; copy(self.states[..count], saved[..count]); self.region_count = region_count; self.ambient = ambient; self.returns .= returns; self.breaks .= breaks; self.snapshot_len = mark; return result;
}
fn closureBody(self: Walker&, value: blot_check_core::ClosureInfo, ty: u32, found: const bool[:], count: i64, depth: i64) -> Error { for captured, index in found[..count] { if captured { self.states[index].first = 0; } } let arrow, err = self.quantified(ty); if err != Error.none { return err; } if arrow.tag != TypeTag.function { return Error.invalid_artifact; } self.ambient = arrow.c; self.returns .= null; self.breaks .= null; let err = self.introduce(value.parameter.binding); if err != Error.none { return err; } let flow, err = self.expression(value.body, depth + 1); return err; }
fn Walker::capturePattern(self: Walker&, id: u32, found: bool[4096]&, depth: i64) -> Error { let err = self.charge(depth); if err != Error.none { return err; } let pattern = self.module.pattern(id); match pattern.tag {
    blot_check_core::PatternTag.value => { return self.capture(pattern.a, found, depth + 1); },
    blot_check_core::PatternTag.constructor, blot_check_core::PatternTag.record_payload => { if pattern.b != 0 { return self.capturePattern(pattern.b, found, depth + 1); } },
    blot_check_core::PatternTag.product => { for child in self.module.patternChildren(id) { let err = self.capturePattern(child, found, depth + 1); if err != Error.none { return err; } } },
    blot_check_core::PatternTag.wildcard, blot_check_core::PatternTag.bind, blot_check_core::PatternTag.constant => {}, blot_check_core::PatternTag.invalid => { return Error.invalid_artifact; },
    } return Error.none;
}
struct CaptureChildren { walker: Walker&, found: bool[4096]&, depth: i64 }
fn CaptureChildren::append(self: CaptureChildren&, id: u32) -> Error { if id == 0 { return Error.none; } let err = self.walker.capture(id, self.found, self.depth + 1); if err != Error.none { return Error.plan_limit; } return Error.none; }
fn CaptureChildren::appendSlice(self: CaptureChildren&, ids: const u32[:]) -> Error { for id in ids { let err = self.append(id); if err != Error.none { return err; } } return Error.none; }
fn Walker::capture(self: Walker&, source: u32, found: bool[4096]&, depth: i64) -> Error {
    let err = self.charge(depth); if err != Error.none { return err; } if source == 0 || source >= self.module.nodes.len { return Error.invalid_artifact; } let node = self.module.nodes[source]; match node.tag {
        Tag.reference => { let ref = self.module.reference(source); if ref.unit != 0 && ref.unit != self.module.unit { return Error.none; } for state, index in self.states[..self.len] { if state.binding == ref.binding { found[index] = true; } } return Error.none; },
        Tag.closure => { if node.a >= self.module.closures.len { return Error.invalid_artifact; } return self.capture(self.module.closures[node.a].body, found, depth + 1); },
        Tag.operation_value => { if node.a >= self.module.operation_values.len || node.b != 0 || node.c != 0 { return Error.invalid_artifact; } let operation = self.module.operationValue(source); if operation.capability != 0 { let err = self.capture(operation.capability, found, depth + 1); if err != Error.none { return err; } } if operation.witness != 0 { let err = self.capture(operation.witness, found, depth + 1); if err != Error.none { return err; } } return Error.none; },
        Tag.match_ => { for arm in self.module.matchArms(source) { for row in self.module.armRows(arm) { for pattern in self.module.rowPatterns(row) { let err = self.capturePattern(pattern, found, depth + 1); if err != Error.none { return err; } } } } },
        Tag.pattern_bind => { let err = self.capturePattern(node.a, found, depth + 1); if err != Error.none { return err; } },
        Tag.loop_ => { let pattern = self.module.loopInfo(source).pattern; if pattern != 0 { let err = self.capturePattern(pattern, found, depth + 1); if err != Error.none { return err; } } },
        Tag.request_loop => { let pattern = self.module.requestLoopInfo(source).completion_pattern; if pattern != 0 { let err = self.capturePattern(pattern, found, depth + 1); if err != Error.none { return err; } } },
        Tag.invalid => { return Error.invalid_artifact; }, _ => {},
    } var children = CaptureChildren { self, found, depth }; let err = blot_eval_body_recipe::appendChildren(children, self.module, source, false); if err != Error.none { return Error.invalid_artifact; } return Error.none;
}
struct LoanResult { walker: Walker&, callback: blot_check_core::ClosureInfo, depth: i64 }
