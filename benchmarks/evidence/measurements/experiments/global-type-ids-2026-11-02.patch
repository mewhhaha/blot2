+test "selected structural global collision chains never spend query budgets" {
+    var warm_store = K.Store.init(a, .{ .hash_mask = 0 });
+    defer warm_store.deinit();
+    // More unrelated colliding nodes than a complete query's 4k work quota.
+    for (0..4098) |index| {
+        const head = [_]u32{@intCast(index)};
+        const term = [_]Term{.{ .reference = .{ .unit = 1, .ty = 1 }, .head = &head }};
+        const output = try key(&warm_store, &term, &.{0}, .{});
+        a.free(output);
+    }
+    const tiny = [_]Term{.{ .reference = .{ .unit = 1, .ty = 1 }, .head = &.{3} }};
+    const options: K.Options = .{ .encoded_words = 8, .word_work = 8 };
+    const warm = try key(&warm_store, &tiny, &.{0}, options);
+    defer a.free(warm);
+    var fresh_store = K.Store.init(a, .{ .hash_mask = 0 });
+    defer fresh_store.deinit();
+    const fresh = try key(&fresh_store, &tiny, &.{0}, options);
+    defer a.free(fresh);
+    // IDs are private to each Store; both queries must independently succeed.
+    try std.testing.expectEqual(@as(usize, 3), warm.len);
+    try std.testing.expectEqual(@as(usize, 3), fresh.len);
