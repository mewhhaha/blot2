fn selectImplementationInstance(self:Engine&,contract:Identity,arguments:const u32[:],source:u32,saved:blot_check_types::List,index:u32,declaration:Implementation,variables:u32[:],rows:u32[:],old:u32[:],old_rows:u32[:],prerequisites:const blot_check_types::Obligation[:],edges:u32[:],before:const ImplementationMember[:],members:ImplementationMember[:])->blot_support::Option<u32>,blot_error::Error {let instance,err=blot_eval_implementation_patterns::instantiateInto(self.types,declaration,variables,rows);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}for argument,ordinal in arguments {let err=self.types.unify(self.types.list(instance.head)[ordinal],argument);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}}for value,ordinal in self.types.list(declaration.variables) {old[ordinal]=self.types.head(value,0);}for ordinal in 0..old_rows.len {let resolved,err=self.types.resolveEffects(self.types.list(declaration.row_parameters)[ordinal],0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}match self.types.row(resolved).tail {blot_check_effects::Tail.variable payload=>{old_rows[ordinal]=payload.value;},_=>{return blot_support::none<u32>(),blot_error::Error.type_mismatch;}}}self.provisional_equations.append(Engine_provisional_equations{declaration:index,arguments:saved,variables:variables,rows:rows});let result,err=selectImplementationPrerequisites(self,contract,source,saved,declaration,variables,rows,old,old_rows,prerequisites,edges,before,members);self.provisional_equations.resize(self.provisional_equations.len-1);return result,err;}
