type Box is data = $Box (Array U32)
type World is data = $World { counts: Array U32, other: Array U32 }
type Opt is data = $Has (Array U32) | $Missing
type Point is data = $Point { x: U32, y: U32 }
const keep = func (values: Array U32) => return values[0]
const run = func (n: U32) => return do:
  let outer = #[1, 2]
  let make = func (k: U32) => return do:
    let rows = #[1, 2]
    rows[0] := k
    break rows[0]
  let bad = func (k: U32) => return do:
    outer[0] := k
    break outer[0]
  break @u32.add (make n) (bad n)
