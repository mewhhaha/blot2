 else { let body=module.body(input.identity); if body==null { return 0,Error.unresolved_type; } self.scratch.sources[scope].body=body.root; self.scratch.sources[scope].closed_rows=body.closed_rows; qualifier=input.identity; var source_type=module.binding(input.identity).ty; for unused in 0..input.applied { let arrow=module.types.node(source_type); if arrow.tag!=TypeTag.function { return 0,Error.type_mismatch; } source_type=arrow.b; } let root,e=importType(self,scope,source_type,0); if e!=Error.none { return 0,e; } setSourceRoot(self,scope,root); }
