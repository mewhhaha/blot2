const generate = fn count => fn generator => @list.generate count generator
const fill = fn count => fn value => @list.fill count value
const from_array = fn values => @list.from_array values
const to_array = fn values => @array.from_list values
const length = fn values => @list.length values
const is_empty = fn values => List.is_empty values
const append = fn value => fn values => @list.append values value
const prepend = fn value => fn values => @list.prepend values value
const map = fn transform => fn (values: List a) => [transform value | value <- values]
const filter = fn predicate => fn (values: List a) => [value | value <- values, predicate value]
const fold_left = fn reduce => fn initial => fn (values: List a) => do:
  let state = initial
  for value in values:
    use next <- reduce state value
    state := next
  return state

const any = fn predicate => fn (values: List a) => do:
  for value in values:
    use found <- predicate value
    if found:
      return #True
  return #False

const all = fn predicate => fn (values: List a) => do:
  for value in values:
    use accepted <- predicate value
    if Bool.not accepted:
      return #False
  return #True

// Whole subtrees are shared; partial boundary leaves are copied.
const concat = fn left => fn right => @list.concat left right
const slice = fn start => fn count => fn values => @list.slice values start count
const split_at = fn index => fn values =>
  (slice 0 index values, slice index (values.length - index) values)
const take = fn count => fn values => slice 0 (min count values.length) values
const drop = fn count => fn values => do:
  let start = min count values.length
  return slice start (values.length - start) values

// Positions refer to the original list; unchanged subtrees remain shared.
const splice = fn start => fn delete_count => fn replacement => fn values => do:
  if start > values.length || delete_count > values.length - start:
    return @panic "list splice range is out of bounds"
  if delete_count == 0 && replacement.is_empty:
    return values
  let end = start + delete_count
  return concat (concat (slice 0 start values) replacement) (slice end (values.length - end) values)

// Validate sorted, nonoverlapping edits before constructing the result. Multiple
// insertions at the same position keep their written order. Empty edits share xs.
const splice_many = fn (edits: List { start: U32, delete_count: U32, replacement: List a }) => fn (values: List a) => do:
  let end = 0
  for edit in edits:
    if edit.start < end || edit.start > values.length || edit.delete_count > values.length - edit.start:
      return @panic "list splice edits must be ordered, nonoverlapping and in bounds"
    end := edit.start + edit.delete_count
  if edits.is_empty:
    return values
  let result = []
  let cursor = 0
  for edit in edits:
    result := concat (concat self (slice cursor (edit.start - cursor) values)) edit.replacement
    cursor := edit.start + edit.delete_count
  return concat result (slice cursor (values.length - cursor) values)
