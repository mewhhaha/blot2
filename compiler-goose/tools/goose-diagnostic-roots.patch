@@ -1387,7 +1387,17 @@
             fprintf(msgs, "roundtrip ok: %d bytes of dump\n", (int)dumped.size());
         }
         if (parseonly) return 0;
+        auto diagnostic_roots = getenv("GOOSE_DIAGNOSTIC_ROOTS");
+        auto partial_diagnostics = diagnostic_roots && *diagnostic_roots;
+        if (partial_diagnostics && !nocgen)
+            throw CompileError { "GOOSE_DIAGNOSTIC_ROOTS requires check mode; no output is emitted" };
+        if (partial_diagnostics)
+            fprintf(msgs, "PARTIAL selected-root diagnostics; full-program qualification pending\n");
         TypeCheckProgram(ast, library, nocgen);
