        Error.unrecognized_cycle_guard => "UnrecognizedCycleGuard",
        Error.unresolved_type => "UnresolvedType",
        Error.unsafe_cleanup => "UnsafeCleanup",
        Error.unsupported => "Unsupported",
        Error.unsupported_arena_composition => "UnsupportedArenaComposition",
        Error.unsupported_cohort => "UnsupportedCohort",
        Error.unsupported_version => "UnsupportedVersion",
        Error.version_mismatch => "VersionMismatch",
        Error.missing_field => "MissingField",
    }
}

fn failed(code: Error) -> bool { code != Error.none }
