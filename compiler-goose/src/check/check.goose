fn Engine::builtinStateApplication(self:Engine&,id:u32)->blot_support::Option<u32>,blot_error::Error {let syntax=self.tree.node(id);if self.tree.node(syntax.a).tag!=blot_parse_ast::tag_intrinsic {return blot_support::none<u32>(),blot_error::Error.none;}let name=self.pool.get(self.tree.node(syntax.a).a);let read=name=="@state.get";if !read && name!="@state.set" {return blot_support::none<u32>(),blot_error::Error.none;}let operand,err=self.expression(syntax.b);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if !read && self.active_effect_scopes!=0 {let footprint,err=self.scopeFootprint(operand,0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if footprint {let err=self.diagnostic(Code.capability_escape,syntax.b);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}}}var state=operand;if read {let root,err=self.witnessType(operand,id);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}state=root;}let template,err=self.builtinStateTemplate(read);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let identity=self.effect_templates[template].identity;let latent,err=self.types.freshEffects();if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}var row=latent;let concrete,err=self.types.equalClosed(state,state);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if concrete {let label,err=self.types.internOperation(identity,[state]);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let selected,err=self.types.effects.row([label],self.types.row(latent).tail);if err!=blot_error::Error.none {return blot_support::none<u32>(),blot_check_types::effectError(err);}row=selected;}var result=blot_check_types::unit;var parameter=state;var call=OperationUse_call.state_write;if read {result=state;parameter=blot_check_types::unit;call=OperationUse_call.state_read;}let signature,err=self.types.functionWithEffects(parameter,result,row);if