// A retained representation never authorizes a source slot, fuel, or resource charge.
namespace blot_reuse_constant_receipt_reuse;
import std;
import support.error;
import support.option;
import support.structural;
import check.core;
import backend.runtime_identity;
import eval.core_eval;
import eval.type_evidence;
import eval.eval_values;
import eval.eval_collection_growth;
import .code_artifacts;
import .constant_receipt;
import .source_value_template;
import .artifact_import;
import .principal_reuse_gate;
import .specialization_receipt;
type Error=blot_error::Error;
type Pools=blot_reuse_code_artifacts::Pools;
type Module=blot_check_core::Module;
type Inputs=blot_reuse_constant_receipt::Inputs;
type Record=blot_reuse_constant_receipt::Record;
type Event=blot_reuse_constant_receipt::Event;
type Reason=blot_reuse_constant_receipt::Reason;
type Resources=blot_reuse_constant_receipt::Resources;
type Growth=blot_reuse_constant_receipt::Growth;
type Query=blot_reuse_constant_receipt::Query;
type QueryKind=blot_reuse_constant_receipt::QueryKind;
type Plan=blot_reuse_source_value_template::Plan;
type QueryScratch=blot_reuse_source_value_template::QueryScratch;
type QueryStorage=blot_reuse_source_value_template::QueryStorage;
type Importer=blot_reuse_artifact_import::Importer;
type Gate=blot_reuse_principal_reuse_gate::Gate;
type Frontier=blot_eval_eval_collection_growth::Frontier;
struct State {allocation_owner:u64=0,old:blot_support::Option<Pools> =blot_support::none<Pools>(),units:Module[:]=default<Module[:]>(),gate:Gate=Gate{..},semantic:blot_support::Option<Importer> =blot_support::none<Importer>(),scratch:blot_support::Option<QueryScratch> =blot_support::none<QueryScratch>(),live:bool=false,allocation_index:i64=-1}
reusable var state_owners:State[>..]=[];
reusable[] var unit_headers:Module[>..]=[];
fn copyUnits(source:const Module[:])->Module[:] {let result=unit_headers.alloc_slice(source.len);for value,index in source {result[index]=value;}return result;}
fn initPooledRef()->State?,Error {let at=state_owners.alloc_index(State{..});state_owners[at].allocation_index=at;return state_owners[at],blot_error::Error.none;}
fn releasePooled(self_:State&) {let at=self_.allocation_index;assert(at>=0 && at<state_owners.len);let owned:State& =state_owners[at];assert(owned .==self_);self_.deinit();self_.allocation_index=-1;state_owners.free(at);}
fn deinit(self_:State&) {if !self_.live {return;}if self_.scratch.present {self_.scratch.value.deinit();}if self_.semantic.present {self_.semantic.value.deinit();}if self_.gate.storage!=0 {self_.gate.deinit();}if self_.units.len!=0 {unit_headers.free_slice(self_.units);}self_=State{allocation_index:self_.allocation_index,..};}
fn source(self_:const State&)->const Pools& {assert(self_.live && self_.old.present);return self_.old.value;}
fn initInto(self_:State&,old:const Pools&,units:const Module[:],names:blot_support::Option<blot_backend_runtime_identity::View>,stamps:blot_reuse_code_artifacts::ModuleStamps?,allocation_owner:u64,gate:const Gate&)->Error {self_.deinit();let owned=copyUnits(units);self_=State{allocation_owner:allocation_owner,old:blot_support::some<Pools>(old),units:owned,gate:gate.retainOwned(),live:true,allocation_index:self_.allocation_index,..};self_.gate.units=owned;self_.gate.source_pools .= self_.old.value;
 // prepareReuse supplies the same identity to every fresh/shared query gate.
 if gate.validation_names.present {assert(names.present);let before=gate.validation_names.value;let after=names.value;assert(blot_support::same_slice_identity(before.bytes,after.bytes) && blot_support::same_slice_identity(before.symbols,after.symbols) && blot_support::same_slice_identity(before.owners,after.owners));self_.gate.validation_names=names;}
 return blot_error::Error.none;}
fn init(allocation_owner:u64,old:const Pools&,units:const Module[:],names:blot_support::Option<blot_backend_runtime_identity::View>,stamps:blot_reuse_code_artifacts::ModuleStamps?)->State?,Error {let allocated,error=initPooledRef();if error!=blot_error::Error.none {return null,error;}let self_ .= allocated;assert(self_);self_=State{allocation_owner:allocation_owner,old:blot_support::some<Pools>(old),units:copyUnits(units),live:true,allocation_index:self_.allocation_index,..};let gate,error=blot_reuse_principal_reuse_gate::initConstantReceipts(allocation_owner,self_.source(),self_.units,names,stamps);if error!=blot_error::Error.none {releasePooled(self_);return null,error;}self_.gate=gate;return self_,blot_error::Error.none;}
fn pairedImporter(self_:State&)->Importer?,Error {if !self_.semantic.present {let checked,error=blot_reuse_artifact_import::initCheckedQuery(self_.allocation_owner,self_.source(),self_.gate.units,self_.gate);if error!=blot_error::Error.none {return null,error;}if checked.present {self_.semantic=checked;}else {let old .=self_.source();if !old.identity.present {return null,blot_error::Error.invalid_artifact;}let imported,error=blot_reuse_artifact_import::init(self_.allocation_owner,old,self_.gate.units,blot_support::some(old.identity.value.view()),self_.gate.units.len);if error!=blot_error::Error.none {return null,error;}self_.semantic=blot_support::some(imported);}}return self_.semantic.value,blot_error::Error.none;}
fn buffers(self_:State&)->QueryScratch& {if !self_.scratch.present {self_.scratch=blot_support::some(QueryScratch{allocation_owner:self_.allocation_owner,..});}return self_.scratch.value;}
fn reject<G>(self_:State&,g:G&,reason:Reason)->blot_support::Option<u32> {var code:i64=0;match reason {mode=>{code=0;},source=>{code=1;},resource=>{code=2;},ready=>{code=3;},graph=>{code=4;},read=>{code=5;},imported=>{code=6;},}g.evaluator.constant_stats.reasons[code]+=1;return blot_support::none<u32>();}
fn declined<G>(self_:State&,g:G&,reason:Reason)->blot_support::Option<u32>,Error {return self_.reject(g,reason),blot_error::Error.none;}
fn abortDemand<G>(self_:State&,g:G&,reason:Reason)->blot_support::Option<u32>,Error {g.evaluator.constant_receipt_retry=true;return self_.declined(g,reason);}
fn ordinaryError<G>(self_:State&,g:G&,error:Error,reason:Reason,demand:bool)->blot_support::Option<u32>,Error {if error==blot_error::Error.out_of_memory {return blot_support::none<u32>(),error;}if demand {return self_.abortDemand(g,reason);}return self_.declined(g,reason);}
fn room(limit:i64,used:i64)->i64 {return max(0,limit-used);}
fn resourcesFit(session:const blot_eval_core_eval::Session&,work:Resources,total:Resources)->bool {return work.steps<=room(room(session.options.max_steps,session.steps),total.steps) && work.values<=room(room(session.options.max_values,session.constantValueCount()),total.values) && work.children<=room(room(session.options.max_children,session.constantChildCount()),total.children) && work.depth<=room(session.options.max_depth,session.depth) && work.call_depth<=room(session.options.max_call_depth,session.call_depth);}
fn positionsFit(session:const blot_eval_core_eval::Session&,depth:i64,calls:i64)->bool {return depth<=room(session.options.max_depth,session.depth) && calls<=room(session.options.max_call_depth,session.call_depth);}
fn publish<G>(self_:State&,g:G&,owned:Record&,total:Resources,imported:i64,scalar:bool)->blot_support::Option<u32>,Error {let session .= g.evaluator;let error=session.retained.constant_records.ensure(session.retained.constant_records.len+1);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}let value=owned.value;session.retained.constant_records.push(owned);owned=Record{..};session.constant_stats.reused+=1;if scalar {session.constant_stats.scalar_reused+=1;}session.constant_stats.source_steps_replayed+=total.steps;session.constant_stats.values_imported+=imported;session.constant_stats.owned_payload_bytes+=session.retained.constant_records.items[session.retained.constant_records.len-1].ownedBytes();return blot_support::some(value),blot_error::Error.none;}
recursive fn lookup<G>(self_:State&,g:G&,target:blot_check_core::BindingRef,inputs:Inputs)->blot_support::Option<blot_reuse_constant_receipt::Lookup>,Error {let session .= g.evaluator;session.constant_stats.lookups+=1;let old=self_.source();if !self_.gate.enabled || old.constant_records.len>4096 {return blot_support::none<blot_reuse_constant_receipt::Lookup>(),blot_error::Error.none;}for &record in old.constant_records {session.constant_stats.lookup_comparisons+=1;if record.target!=target {continue;}session.constant_stats.candidates+=1;let value,error=self_.replay(g,record,inputs);if error!=blot_error::Error.none {return blot_support::none<blot_reuse_constant_receipt::Lookup>(),error;}if !value.present {session.constant_stats.declined+=1;return blot_support::none<blot_reuse_constant_receipt::Lookup>(),blot_error::Error.none;}let published=session.retained.constant_records.items[session.retained.constant_records.len-1];return finishReceiptLookup(published,value.value);}return blot_support::none<blot_reuse_constant_receipt::Lookup>(),blot_error::Error.none;}
fn mappedInputs<G>(self_:State&,g:G&,unit:u32,before:Inputs)->blot_support::Option<Inputs>,Error {if before.types.len==0 && before.rows.len==0 {let result,error=before.clone();return blot_support::some(result),error;}if unit==0 || unit>self_.gate.units.len || !self_.gate.structural_units[unit-1] {return blot_support::none<Inputs>(),blot_error::Error.none;}let maps,error=self_.pairedImporter();if error!=blot_error::Error.none {return blot_support::none<Inputs>(),error;}assert(maps);let types,rows,error=before.cloneMutable();if error!=blot_error::Error.none {return blot_support::none<Inputs>(),error;}var result=Inputs{types:types,rows:rows,..};let accepted,error=mapInputValues(self_,g,maps,self_.gate.units[unit-1],types,rows);if error!=blot_error::Error.none || !accepted {result.deinit();return blot_support::none<Inputs>(),error;}return blot_support::some(result),blot_error::Error.none;}
fn mapInputValues<G>(self_:State&,g:G&,maps:Importer&,module:const Module&,types:blot_eval_type_evidence::Mapping[:],rows:blot_eval_type_evidence::RowMapping[:])->bool,Error {for &mapping in types {if !blot_reuse_constant_receipt::sourceMappingKey(module,mapping.variable) {return false,blot_error::Error.none;}if mapping.evidence!=0 {let current,error=maps.importEvidence(g,mapping.evidence);if error!=blot_error::Error.none || !current.present {return false,error;}mapping.evidence=current.value;}}for &mapping in rows {if mapping.variable>=module.types.effects.variable_count {return false,blot_error::Error.none;}let current,error=maps.importSemanticRow(g,mapping.evidence);if error!=blot_error::Error.none || !current.present {return false,error;}mapping.evidence=current.value;}return true,blot_error::Error.none;}
fn mapOutputs<G>(self_:State&,g:G&,record:const Record&,owned:Record&)->bool,Error {let before .= record.outputs;if !before {return true,blot_error::Error.none;}let mapped,error=self_.mappedInputs(g,record.target.unit,before);if error!=blot_error::Error.none || !mapped.present {return false,error;}let outputs .= owned.outputs;assert(outputs);outputs.deinit();outputs=mapped.value;return true,blot_error::Error.none;}
fn installInputs(owned:Record&,inputs:Inputs)->Error {let copy,error=inputs.clone();if error!=blot_error::Error.none {return error;}owned.inputs.deinit();owned.inputs=copy;return blot_error::Error.none;}
fn replayJudgment<G>(self_:State&,g:G&,query:const blot_reuse_constant_receipt::Judgment&,expected:u32)->blot_reuse_constant_receipt::Judgment?,Error {if query.unit==0 || query.unit>self_.gate.units.len || !self_.gate.structural_units[query.unit-1] {return null,blot_error::Error.none;}let owner .= self_.gate.units[query.unit-1];if query.source==0 || query.source>=owner.nodes.len {return null,blot_error::Error.none;}var producer=query.producer;if producer==0 {producer=query.unit;}if producer>self_.gate.units.len || !self_.gate.structural_units[producer-1] || query.root>=self_.gate.units[producer-1].types.nodes.len {return null,blot_error::Error.none;}let lists=owner.types.extra.len;for list in [query.scheme.variables,query.scheme.row_variables,query.scheme.closed_rows,query.scheme.generative,query.closed_rows] {if list.start>lists || list.len>lists-list.start {return null,blot_error::Error.none;}}if query.scheme.root>=owner.types.nodes.len || query.scheme.obligations.start>owner.obligations.len || query.scheme.obligations.len>owner.obligations.len-query.scheme.obligations.start {return null,blot_error::Error.none;}let first,error=self_.mappedInputs(g,producer,query.inputs);if error!=blot_error::Error.none || !first.present {return null,error;}var inputs=first.value;let second,error=self_.mappedInputs(g,producer,query.outputs);if error!=blot_error::Error.none || !second.present {inputs.deinit();return null,error;}var outputs=second.value;var current=query;current.inputs=inputs;let selected,error=replayJudgmentCurrent(self_,g,query,current,expected,outputs);outputs.deinit();inputs.deinit();return selected,error;}
fn replayJudgmentCurrent<G>(self_:State&,g:G&,query:const blot_reuse_constant_receipt::Judgment&,current:blot_reuse_constant_receipt::Judgment,expected:u32,outputs:Inputs)->blot_reuse_constant_receipt::Judgment?,Error {let completed,error=g.evaluator.receiptJudgment(current,expected);if error!=blot_error::Error.none {if error==blot_error::Error.out_of_memory {return null,error;}return null,blot_error::Error.none;}return finishJudgmentReplay(query,current,outputs,completed);}
fn finishJudgmentReplay(query:const blot_reuse_constant_receipt::Judgment&,current:blot_reuse_constant_receipt::Judgment,outputs:Inputs,completed:blot_eval_core_eval::ReceiptJudgment)->blot_reuse_constant_receipt::Judgment?,Error {var result=completed;if result.matched!=query.matched || !blot_structural::equal(outputs.types,result.solved.types) || !blot_structural::equal(outputs.rows,result.solved.rows) || !blot_structural::equal(query.selected,result.solved.selected) {result.deinit();return null,blot_error::Error.none;}var value=current;value.outputs=Inputs{types:result.solved.types,rows:result.solved.rows,..};value.selected=result.solved.selected;let cloned,error=value.clone();result.deinit();return cloned,error;}
fn scalarInputs(self_:const State&,record:const Record&)->bool {let old=self_.source();if !blot_reuse_source_value_template::scalarRoot(old.evaluator,record.value).present {return false;}for event in record.events {match event {read value=>{if !blot_reuse_source_value_template::scalarRoot(old.evaluator,value.value.value).present {return false;}},query=>{return false;},_=>{},}}return true;}
fn cloneRecordInputs<G>(self_:State&,g:G&,record:const Record&,inputs:Inputs)->blot_support::Option<Record>,Error {let copy,error=record.clone();if error!=blot_error::Error.none {return blot_support::none<Record>(),error;}var owned=copy;owned.values_before=g.evaluator.storage.values.len;let error=installInputs(owned,inputs);if error!=blot_error::Error.none {owned.deinit();return blot_support::none<Record>(),error;}let mapped,error=self_.mapOutputs(g,record,owned);if error!=blot_error::Error.none || !mapped {owned.deinit();if error==blot_error::Error.none {self_.reject(g,blot_reuse_constant_receipt::Reason.source);}return blot_support::none<Record>(),error;}return blot_support::some(owned),blot_error::Error.none;}
fn replayScalar<G>(self_:State&,g:G&,record:const Record&,total:Resources,inputs:Inputs)->blot_support::Option<u32>,Error {let session .= g.evaluator;let old=self_.source();var anchor:u32=0;for event in record.events {match event {read value=>{let read=value.value;let current=session.readyConstantAnchor(read.target);assert(current.present);let before=blot_reuse_source_value_template::scalarRoot(old.evaluator,read.value);let after=blot_reuse_source_value_template::scalarRoot(session.snapshot(),current.value);if !after.present || before.value.scalar!=after.value.scalar || before.value.bits!=after.value.bits {return self_.declined(g,blot_reuse_constant_receipt::Reason.read);}if read.value==record.value {anchor=current.value;}},_=>{},}}if anchor==0 && total.values==0 {return self_.declined(g,blot_reuse_constant_receipt::Reason.resource);}let copy,error=self_.cloneRecordInputs(g,record,inputs);if error!=blot_error::Error.none || !copy.present {return blot_support::none<u32>(),error;}var owned=copy.value;let selected,error=replayScalarOwned(self_,g,record,total,owned,anchor);if error!=blot_error::Error.none || !selected.present {owned.deinit();}return selected,error;}
fn replayScalarOwned<G>(self_:State&,g:G&,record:const Record&,total:Resources,owned:Record&,initial:u32)->blot_support::Option<u32>,Error {let session .= g.evaluator;let error=session.retained.constant_records.ensure(session.retained.constant_records.len+1);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}var anchor=initial;var added:i64=0;if anchor==0 {let actual,error=blot_reuse_source_value_template::materializeScalarRoot(session,blot_reuse_source_value_template::scalarRoot(self_.source().evaluator,record.value).value);if error!=blot_error::Error.none {return self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,false);}anchor=actual;added=1;}owned.value=anchor;for &event in owned.events {match event {read value=>{var read=value.value;let ready=session.readyConstantAnchor(read.target);assert(ready.present);read.value=ready.value;event=blot_reuse_constant_receipt::Event.read{value:read,..};},_=>{},}}session.steps+=total.steps;session.constant_value_debt+=total.values-added;session.constant_child_debt+=total.children;return self_.publish(g,owned,total,added,true);}
fn eventRoots(record:const Record&,all:bool,roots:blot_reuse_source_value_template::WordBuffer&)->Error {let error=roots.push(record.value);if error!=blot_error::Error.none {return error;}for event in record.events {match event {read item=>{let error=roots.push(item.value.value);if error!=blot_error::Error.none {return error;}},view item=>{if all {let error=roots.append([item.value.value,item.value.selected]);if error!=blot_error::Error.none {return error;}}},query item=>{if all {if item.value.input!=0 {let error=roots.push(item.value.input);if error!=blot_error::Error.none {return error;}}if item.value.selected!=0 {let error=roots.push(item.value.selected);if error!=blot_error::Error.none {return error;}}}},_=>{},}}return blot_error::Error.none;}
fn inspectRecord(self_:State&,record:const Record&,all:bool)->blot_reuse_source_value_template::Inspection,Error {var roots=blot_reuse_source_value_template::WordBuffer{..};let error=eventRoots(record,all,roots);if error!=blot_error::Error.none {roots.deinit();return default<blot_reuse_source_value_template::Inspection>(),error;}let found,error=blot_reuse_source_value_template::inspectConstantRoots(self_.source(),self_.gate,roots.items);roots.deinit();return found,error;}
fn prefixBuffers(self_:State&,record:const Record&)->bool,Reason,Error {let old=self_.source();for effect in record.buffers {if effect.value<record.values_before || effect.value>=old.evaluator.values.len {return false,blot_reuse_constant_receipt::Reason.graph,blot_error::Error.none;}let info=old.evaluator.values[effect.value];let frontier=effect.frontier;if frontier.offset>info.start || frontier.capacity<info.len || frontier.offset>frontier.capacity-info.len {return false,blot_reuse_constant_receipt::Reason.graph,blot_error::Error.none;}let start=info.start-frontier.offset;if start>old.evaluator.children.len || frontier.capacity>old.evaluator.children.len-start {return false,blot_reuse_constant_receipt::Reason.graph,blot_error::Error.none;}}if record.buffers.len==0 {return true,blot_reuse_constant_receipt::Reason.graph,blot_error::Error.none;}for event in record.events {var roots:u32[2]=[0;2];var count:i64=0;match event {view item=>{roots=[item.value.value,item.value.selected];count=2;},query item=>{if item.value.input!=0 {roots[0]=item.value.input;count=1;}},_=>{},}if count==0 {continue;}let inspected,error=blot_reuse_source_value_template::inspectConstantRoots(old,self_.gate,roots[..count]);if error!=blot_error::Error.none {return false,blot_reuse_constant_receipt::Reason.graph,error;}if !inspected.plan.present {return false,blot_reuse_constant_receipt::Reason.graph,blot_error::Error.none;}var plan=inspected.plan.value;var overlap=false;for id in plan.order {let child=old.evaluator.values[id];for effect in record.buffers {let start=old.evaluator.values[effect.value].start-effect.frontier.offset;if child.len!=0 && child.start<start as i64+effect.frontier.capacity && start<child.start as i64+child.len {overlap=true;}}}plan.deinit();if overlap {return false,blot_reuse_constant_receipt::Reason.mode,blot_error::Error.none;}}return true,blot_reuse_constant_receipt::Reason.graph,blot_error::Error.none;}
recursive fn replayDemand<G>(self_:State&,g:G&,record:const Record&,total:Resources,inputs:Inputs)->blot_support::Option<u32>,Error {let found,error=self_.inspectRecord(record,true);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}if !found.plan.present {return self_.declined(g,blot_reuse_constant_receipt::Reason.graph);}var plan=found.plan.value;g.evaluator.constant_stats.graph_values_examined+=plan.order.len;g.evaluator.constant_stats.graph_index_bytes+=found.stats.inspection_index_bytes;let value,error=demandPlan(self_,g,record,total,inputs,plan);plan.deinit();return value,error;}
recursive fn demandPlan<G>(self_:State&,g:G&,record:const Record&,total:Resources,inputs:Inputs,plan:Plan)->blot_support::Option<u32>,Error {let permitted,reason,error=self_.prefixBuffers(record);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}if !permitted {return self_.declined(g,reason);}let semantic,error=self_.pairedImporter();if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}assert(semantic);let scratch .= self_.buffers();let before=scratch.payloadBytes();let value,error=demandScratch(self_,g,record,total,inputs,plan,semantic,scratch);g.evaluator.constant_stats.graph_index_bytes+=scratch.payloadBytes()-before;return value,error;}
struct Credits {values:i64=0,children:i64=0,imported:i64=0}
recursive fn demandScratch<G>(self_:State&,g:G&,record:const Record&,total:Resources,inputs:Inputs,plan:Plan,semantic:Importer&,scratch:QueryScratch&)->blot_support::Option<u32>,Error {let seeds,error=scratch.begin(plan,g);if error!=blot_error::Error.none {return self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,false);}let copy,error=self_.cloneRecordInputs(g,record,inputs);if error!=blot_error::Error.none || !copy.present {return blot_support::none<u32>(),error;}var owned=copy.value;let result,error=demandOwned(self_,g,record,total,plan,semantic,scratch,seeds,owned);if error!=blot_error::Error.none || !result.present {owned.deinit();}return result,error;}
fn materializeSubset<G>(self_:State&,g:G&,record:const Record&,roots:const u32[:],semantic:Importer&,scratch:QueryScratch&,seeds:u32[:],credits:Credits&)->blot_support::Option<const u32[:]>,Error {let inspected,error=blot_reuse_source_value_template::inspectConstantRoots(self_.source(),self_.gate,roots);if error!=blot_error::Error.none {return blot_support::none<const u32[:]>(),error;}if !inspected.plan.present {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.graph);return blot_support::none<const u32[:]>(),blot_error::Error.none;}var plan=inspected.plan.value;let before_values=g.evaluator.storage.values.len;let before_children=g.evaluator.storage.children.len;let storage=QueryStorage{values_before:record.values_before,values_added:credits.values,children_added:credits.children,exact:false,precharged:true,..};let mapped,error=plan.materializeReceiptWithScratch(g,semantic,seeds,storage,scratch);plan.deinit();if error!=blot_error::Error.none {self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,true);return blot_support::none<const u32[:]>(),errorOnlyOom(error);}let added=g.evaluator.storage.values.len-before_values;credits.imported+=added;credits.values-=added;credits.children-=g.evaluator.storage.children.len-before_children;let readonly_mapped:const u32[:]=mapped;return blot_support::some<const u32[:]>(readonly_mapped),blot_error::Error.none;}
fn errorOnlyOom(error:Error)->Error {if error==blot_error::Error.out_of_memory {return error;}return blot_error::Error.none;}
fn demandRead<G>(self_:State&,g:G&,read:blot_reuse_constant_receipt::Read,plan:Plan,semantic:Importer&,scratch:QueryScratch&,seeds:u32[:])->bool,Error {let session .= g.evaluator;if !positionsFit(session,read.depth,read.call_depth) {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.resource);return false,blot_error::Error.none;}let depth=session.depth;let calls=session.call_depth;let provider=session.constant_provider_enabled;session.constant_provider_enabled=false;session.depth+=read.depth;session.call_depth+=read.call_depth;let actual,error=session.receiptRead(read.target);session.depth=depth;session.call_depth=calls;session.constant_provider_enabled=provider;if error!=blot_error::Error.none {self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.read,true);return false,errorOnlyOom(error);}let matched,error=plan.matchIntoWithScratch(g,semantic,read.value,actual,seeds,scratch);if error!=blot_error::Error.none {self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,true);return false,errorOnlyOom(error);}if !matched {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.read);}return matched,blot_error::Error.none;}
fn demandView<G>(self_:State&,g:G&,record:const Record&,view:blot_reuse_specialization_receipt::ViewEffect,plan:Plan,semantic:Importer&,scratch:QueryScratch&,seeds:u32[:],credits:Credits&)->bool,Error {let session .= g.evaluator;if view.value>=seeds.len || view.selected>=seeds.len || !blot_reuse_constant_receipt::validView(self_.source().evaluator,view) {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.graph);return false,blot_error::Error.none;}let actual,error=semantic.importEvidence(g,view.evidence);if error!=blot_error::Error.none {return false,error;}if !actual.present {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.imported);return false,blot_error::Error.none;}let input=seeds[view.value];var existing=blot_support::none<u32>();if input!=0 {let candidate .= session.storage.typed_views.get(blot_eval_eval_values::ViewKey{value:input,evidence:actual.value,..});if candidate {existing=blot_support::some(candidate);}}if view.existed {if !existing.present {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.read);return false,blot_error::Error.none;}let matched,error=plan.matchIntoWithScratch(g,semantic,view.selected,existing.value,seeds,scratch);if error!=blot_error::Error.none {self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,true);return false,errorOnlyOom(error);}if !matched {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.read);return false,blot_error::Error.none;}}else if existing.present {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.read);return false,blot_error::Error.none;}let mapped,error=materializeSubset(self_,g,record,[view.value,view.selected],semantic,scratch,seeds,credits);if error!=blot_error::Error.none || !mapped.present {return false,error;}if !view.existed {session.storage.typed_views.insert(blot_eval_eval_values::ViewKey{value:mapped.value[view.value],evidence:actual.value,..},mapped.value[view.selected]);}return true,blot_error::Error.none;}
recursive fn demandQuery<G>(self_:State&,g:G&,record:const Record&,query:const Query&,owned:Query&,plan:Plan,semantic:Importer&,scratch:QueryScratch&,seeds:u32[:],credits:Credits&)->bool,Error {let session .= g.evaluator;if !positionsFit(session,query.depth,query.call_depth) {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.resource);return false,blot_error::Error.none;}var current=query;if query.kind==blot_reuse_constant_receipt::QueryKind.array_member && !self_.gate.admitsCallIdentity(query.target) {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.source);return false,blot_error::Error.none;}if query.input!=0 {let input,error=materializeSubset(self_,g,record,[query.input],semantic,scratch,seeds,credits);if error!=blot_error::Error.none || !input.present {return false,error;}current.input=input.value[query.input];}if query.expected!=0 {let expected,error=semantic.importEvidence(g,query.expected);if error!=blot_error::Error.none {return false,error;}if !expected.present {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.imported);return false,blot_error::Error.none;}current.expected=expected.value;}let depth=session.depth;let calls=session.call_depth;session.depth+=query.depth;session.call_depth+=query.call_depth;let accepted,error=demandQueryCurrent(self_,g,query,current,owned,plan,semantic,scratch,seeds);session.depth=depth;session.call_depth=calls;if accepted && error==blot_error::Error.none {session.constant_stats.queries_replayed+=1;}return accepted,error;}
recursive fn demandQueryCurrent<G>(self_:State&,g:G&,query:const Query&,current:Query,owned:Query&,plan:Plan,semantic:Importer&,scratch:QueryScratch&,seeds:u32[:])->bool,Error {var result=current;if query.kind==blot_reuse_constant_receipt::QueryKind.source {if !self_.gate.admitsCallIdentity(query.target) {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.source);return false,blot_error::Error.none;}let ordinary,error=g.evaluator.sourceInterface(query.target);if error!=blot_error::Error.none {self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.read,true);return false,errorOnlyOom(error);}var expected=query.result;if expected.evidence!=0 {let imported,error=semantic.importEvidence(g,expected.evidence);if error!=blot_error::Error.none {return false,error;}if !imported.present {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.imported);return false,blot_error::Error.none;}expected.evidence=imported.value;}if expected!=ordinary {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.read);return false,blot_error::Error.none;}result.result=ordinary;}else if query.kind==blot_reuse_constant_receipt::QueryKind.judgment {let judgment .= query.judgment;if !judgment {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.source);return false,blot_error::Error.none;}let completed,error=self_.replayJudgment(g,judgment,current.expected);if error!=blot_error::Error.none {return false,error;}let selected .= completed;if !selected {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.read);return false,blot_error::Error.none;}let prior .= owned.judgment;if prior {prior.destroy();}setQueryJudgment(result,selected);}else {let selected,error=g.evaluator.receiptQuery(current);if error!=blot_error::Error.none {self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.read,true);return false,errorOnlyOom(error);}var id:u32=0;if selected.present {id=selected.value;}if (query.selected==0)!=(id==0) {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.read);return false,blot_error::Error.none;}if id!=0 {let matched,error=plan.matchIntoWithScratch(g,semantic,query.selected,id,seeds,scratch);if error!=blot_error::Error.none {self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,true);return false,errorOnlyOom(error);}if !matched {self_.abortDemand(g,blot_reuse_constant_receipt::Reason.read);return false,blot_error::Error.none;}}result.selected=id;}setReplayedQuery(owned,result);return true,blot_error::Error.none;}
recursive fn demandOwned<G>(self_:State&,g:G&,record:const Record&,total:Resources,plan:Plan,semantic:Importer&,scratch:QueryScratch&,seeds:u32[:],owned:Record&)->blot_support::Option<u32>,Error {let session .= g.evaluator;let error=session.retained.constant_records.ensure(session.retained.constant_records.len+1);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}var credits=Credits{..};for event,index in record.events {match event {
 work item=>{let work=item.value;if !resourcesFit(session,work,Resources{..}) {return self_.abortDemand(g,blot_reuse_constant_receipt::Reason.resource);}session.steps+=work.steps;session.constant_value_debt+=work.values;session.constant_child_debt+=work.children;credits.values+=work.values;credits.children+=work.children;},
 read item=>{let matched,error=demandRead(self_,g,item.value,plan,semantic,scratch,seeds);if error!=blot_error::Error.none || !matched {return blot_support::none<u32>(),error;}},
 view item=>{let accepted,error=demandView(self_,g,record,item.value,plan,semantic,scratch,seeds,credits);if error!=blot_error::Error.none || !accepted {return blot_support::none<u32>(),error;}},
 query item=>{let target .= owned.events[index];match target {query payload=>{let accepted,error=demandQuery(self_,g,record,item.value,payload.value,plan,semantic,scratch,seeds,credits);if error!=blot_error::Error.none || !accepted {return blot_support::none<u32>(),error;}},_=>{abort("receipt clone changed query event");},}},
 growth item=>{let observed=item.value;if observed.frontier.present || observed.mutations>=0xffffffffffffffff-session.storage.collection_buffers.mutation_serial {return self_.abortDemand(g,blot_reuse_constant_receipt::Reason.resource);}session.storage.collection_buffers.mutation_serial+=observed.mutations;},
 }}let error=session.retained.constant_records.ensure(session.retained.constant_records.len+1);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}let before=session.storage.values.len;let storage=makeDemandStorage(record.values_before,credits.values,credits.children,record.buffers);let mapped,error=plan.materializeReceiptWithScratch(g,semantic,seeds,storage,scratch);if error!=blot_error::Error.none {return self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,true);}owned.value=mapped[record.value];remapRecord(session,owned,mapped,true);return self_.publish(g,owned,total,credits.imported+session.storage.values.len-before,false);}
fn remapRecord(session:blot_eval_core_eval::Session&,owned:Record&,mapped:const u32[:],views:bool) {if views {let changed=blot_reuse_constant_receipt::copyOwned(owned.buffers);for &effect in changed {effect.value=mapped[effect.value];}blot_reuse_constant_receipt::releaseOwned(owned.buffers);owned.buffers=changed;}for &event in owned.events {match event {read item=>{var read=item.value;read.value=mapped[read.value];event=blot_reuse_constant_receipt::Event.read{value:read,..};},view item=>{if views {var view=item.value;view.value=mapped[view.value];view.selected=mapped[view.selected];view.evidence=session.valueEvidence(view.selected);event=blot_reuse_constant_receipt::Event.view{value:view,..};}},_=>{},}}}
fn inputEvidence<G>(self_:State&,g:G&,record:const Record&,inputs:Inputs)->bool,Error {if record.inputs.types.len!=inputs.types.len || record.inputs.rows.len!=inputs.rows.len {return false,blot_error::Error.none;}if inputs.types.len==0 && inputs.rows.len==0 {return true,blot_error::Error.none;}let owner=record.target.unit-1;if !self_.gate.structural_units[owner] {return false,blot_error::Error.none;}let maps,error=self_.pairedImporter();if error!=blot_error::Error.none {return false,error;}assert(maps);let old_module=self_.source().modules[owner].module;let current .= self_.gate.units[owner];for before,index in record.inputs.types {let after=inputs.types[index];if before.variable!=after.variable || before.variable==0 || before.variable>=old_module.types.nodes.len || after.variable>=current.types.nodes.len || !blot_reuse_constant_receipt::sourceMappingKey(old_module,before.variable) || !blot_reuse_constant_receipt::sourceMappingKey(current,after.variable) {return false,blot_error::Error.none;}if before.evidence==0 || after.evidence==0 {if before.evidence!=after.evidence {return false,blot_error::Error.none;}continue;}let selected,error=maps.importEvidence(g,before.evidence);if error!=blot_error::Error.none || !selected.present || selected.value!=after.evidence {return false,error;}}for before,index in record.inputs.rows {let after=inputs.rows[index];if before.variable!=after.variable || before.variable>=old_module.types.effects.variable_count || after.variable>=current.types.effects.variable_count {return false,blot_error::Error.none;}let selected,error=maps.importSemanticRow(g,before.evidence);if error!=blot_error::Error.none || !selected.present || selected.value!=after.evidence {return false,error;}}return true,blot_error::Error.none;}
fn sourceEvidence(self_:State&,record:const Record&)->bool,Error {let old=self_.source();if !self_.gate.admitsLocalSource(record.target) || !self_.gate.admitsCallIdentity(record.target) {return false,blot_error::Error.none;}let generative,error=blot_reuse_source_value_template::generativeNamed(old.modules[record.target.unit-1].module,record.target.binding);if error!=blot_error::Error.none || generative {return false,error;}for source in record.sources {match source {named value=>{if !self_.gate.admitsLocalSource(value.target) {return false,blot_error::Error.none;}let generative,error=blot_reuse_source_value_template::generativeNamed(old.modules[value.target.unit-1].module,value.target.binding);if error!=blot_error::Error.none || generative {return false,error;}},anonymous value=>{if !self_.gate.admitsClosure(value.unit,value.catalog) {return false,blot_error::Error.none;}let generative,error=blot_reuse_source_value_template::generativeClosure(old.modules[value.unit-1].module,value.catalog);if error!=blot_error::Error.none || generative {return false,error;}},}}return true,blot_error::Error.none;}
recursive fn replay<G>(self_:State&,g:G&,record:const Record&,inputs:Inputs)->blot_support::Option<u32>,Error {let session .= g.evaluator;let old=self_.source();if !record.productive(session.minimum_constant_steps) {return blot_support::none<u32>(),blot_error::Error.none;}if !blot_reuse_constant_receipt::admittedGraph(old.evaluator,record.value) {return self_.declined(g,blot_reuse_constant_receipt::Reason.graph);}for event in record.events {match event {read item=>{if !blot_reuse_constant_receipt::admittedGraph(old.evaluator,item.value.value) {return self_.declined(g,blot_reuse_constant_receipt::Reason.graph);}},_=>{},}}if record.options!=session.options {return self_.declined(g,blot_reuse_constant_receipt::Reason.source);}let source,error=self_.sourceEvidence(record);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}if !source {return self_.declined(g,blot_reuse_constant_receipt::Reason.source);}let admitted,error=inputEvidence(self_,g,record,inputs);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}if !admitted {return self_.declined(g,blot_reuse_constant_receipt::Reason.source);}var total=Resources{..};var growth=blot_support::none<Growth>();var needs_demand=false;var has_views=false;var has_queries=false;for event in record.events {match event {growth item=>{let observed=item.value;if growth.present || observed.mutations==0 || observed.mutations>=0xffffffffffffffff-session.storage.collection_buffers.mutation_serial {return self_.declined(g,blot_reuse_constant_receipt::Reason.resource);}growth=blot_support::some(observed);},work item=>{let work=item.value;if !resourcesFit(session,work,total) {return self_.declined(g,blot_reuse_constant_receipt::Reason.resource);}total.steps+=work.steps;total.values+=work.values;total.children+=work.children;},view=>{has_views=true;},query=>{has_queries=true;},read item=>{if !session.readyConstantAnchor(item.value.target).present {needs_demand=true;}},}}
 if record.buffers.len!=0 && !growth.present {return self_.declined(g,blot_reuse_constant_receipt::Reason.graph);}if needs_demand || has_views || has_queries || record.buffers.len!=0 {if !record.ordered_reads {return self_.declined(g,blot_reuse_constant_receipt::Reason.ready);}if growth.present && growth.value.frontier.present {return self_.declined(g,blot_reuse_constant_receipt::Reason.mode);}return self_.replayDemand(g,record,total,inputs);}if self_.scalarInputs(record) {if growth.present && growth.value.frontier.present {return self_.declined(g,blot_reuse_constant_receipt::Reason.graph);}let result,error=self_.replayScalar(g,record,total,inputs);if error==blot_error::Error.none && result.present && growth.present {session.storage.collection_buffers.mutation_serial+=growth.value.mutations;}return result,error;}
 var frontier=blot_support::none<Frontier>();if growth.present && growth.value.frontier.present {let buffer=growth.value.frontier.value;let root=old.evaluator.values[record.value];if root.len==0 || buffer.capacity<root.len || buffer.offset>buffer.capacity-root.len || buffer.offset>root.start {return self_.declined(g,blot_reuse_constant_receipt::Reason.graph);}if buffer.capacity>old.evaluator.children.len-(root.start-buffer.offset) {return self_.declined(g,blot_reuse_constant_receipt::Reason.graph);}frontier=blot_support::some(buffer);}let found,error=self_.inspectRecord(record,false);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}if !found.plan.present {return self_.declined(g,blot_reuse_constant_receipt::Reason.graph);}var plan=found.plan.value;session.constant_stats.graph_values_examined+=plan.order.len;session.constant_stats.graph_index_bytes+=found.stats.inspection_index_bytes;let result,error=readyPlan(self_,g,record,total,inputs,growth,frontier,plan);plan.deinit();return result,error;
}
fn readyPlan<G>(self_:State&,g:G&,record:const Record&,total:Resources,inputs:Inputs,growth:blot_support::Option<Growth>,frontier:blot_support::Option<Frontier>,plan:Plan)->blot_support::Option<u32>,Error {let semantic,error=self_.pairedImporter();if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}assert(semantic);let scratch .= self_.buffers();let bytes_before=scratch.payloadBytes();let value,error=readyScratch(self_,g,record,total,inputs,growth,frontier,plan,semantic,scratch);g.evaluator.constant_stats.graph_index_bytes+=scratch.payloadBytes()-bytes_before;return value,error;}
fn readyScratch<G>(self_:State&,g:G&,record:const Record&,total:Resources,inputs:Inputs,growth:blot_support::Option<Growth>,frontier:blot_support::Option<Frontier>,plan:Plan,semantic:Importer&,scratch:QueryScratch&)->blot_support::Option<u32>,Error {let seeds,error=scratch.begin(plan,g);if error!=blot_error::Error.none {return self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,false);}for event in record.events {match event {read item=>{let current=g.evaluator.readyConstantAnchor(item.value.target);assert(current.present);let matched,error=plan.matchIntoWithScratch(g,semantic,item.value.value,current.value,seeds,scratch);if error!=blot_error::Error.none {return self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,false);}if !matched {return self_.declined(g,blot_reuse_constant_receipt::Reason.read);}},_=>{},}}let copy,error=self_.cloneRecordInputs(g,record,inputs);if error!=blot_error::Error.none || !copy.present {return blot_support::none<u32>(),error;}var owned=copy.value;let result,error=readyOwned(self_,g,record,total,growth,frontier,plan,semantic,scratch,seeds,owned);if error!=blot_error::Error.none || !result.present {owned.deinit();}return result,error;}
fn readyOwned<G>(self_:State&,g:G&,record:const Record&,total:Resources,growth:blot_support::Option<Growth>,frontier:blot_support::Option<Frontier>,plan:Plan,semantic:Importer&,scratch:QueryScratch&,seeds:u32[:],owned:Record&)->blot_support::Option<u32>,Error {let session .= g.evaluator;let error=session.retained.constant_records.ensure(session.retained.constant_records.len+1);if error!=blot_error::Error.none {return blot_support::none<u32>(),error;}let before_values=session.storage.values.len;let before_children=session.storage.children.len;let storage=QueryStorage{values_before:0,values_added:total.values,children_added:total.children,exact:false,root_buffer:frontier,..};let mapped,error=plan.materializeReceiptWithScratch(g,semantic,seeds,storage,scratch);if error!=blot_error::Error.none {return self_.ordinaryError(g,error,blot_reuse_constant_receipt::Reason.imported,false);}let added_values=session.storage.values.len-before_values;let added_children=session.storage.children.len-before_children;assert(added_values<=total.values && added_children<=total.children);owned.value=mapped[record.value];if frontier.present {let root=session.valueInfo(owned.value);session.storage.collection_buffers.buffers.insert(blot_eval_eval_collection_growth::Span{start:root.start,len:root.len,..},blot_eval_eval_collection_growth::Span{start:root.start-frontier.value.offset,len:frontier.value.capacity,..});}if growth.present {session.storage.collection_buffers.mutation_serial+=growth.value.mutations;}remapRecord(session,owned,mapped,false);session.steps+=total.steps;session.constant_value_debt+=total.values-added_values;session.constant_child_debt+=total.children-added_children;return self_.publish(g,owned,total,added_values,false);}

fn setQueryJudgment(query:Query&,judgment:blot_reuse_constant_receipt::Judgment&?) {query.judgment .= judgment;}
fn setReplayedQuery(owned:Query&,value:Query) {owned=value;}

fn finishReceiptLookup(published:Record,value:u32)->blot_support::Option<blot_reuse_constant_receipt::Lookup>,Error {var outputs=published.inputs;let changed .= published.outputs;if changed {outputs=changed;}return blot_support::some(blot_reuse_constant_receipt::Lookup{value:value,outputs:outputs,..}),blot_error::Error.none;}
fn makeDemandStorage(values_before:i64,values_added:i64,children_added:i64,buffers:const blot_eval_eval_collection_growth::BufferEffect[:])->QueryStorage {return QueryStorage{values_before:values_before,values_added:values_added,children_added:children_added,exact:false,precharged:true,buffers:buffers,..};}
