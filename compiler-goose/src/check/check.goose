fn Engine::storageApplication(self:Engine&,id:u32)->blot_support::Option<u32>,blot_error::Error {var head=id;var backwards:u32[3]=[0;3];var count:i64=0;while self.tree.node(head).tag==blot_parse_ast::tag_apply {let application=self.tree.node(head);if count<backwards.len {backwards[count]=application.b;}count+=1;head=application.a;}let syntax=self.tree.node(head);if syntax.tag!=blot_parse_ast::tag_intrinsic {return blot_support::none<u32>(),blot_error::Error.none;}let operation=blot_check_storage_ops::lookup(self.pool.get(syntax.a));if !operation.present {return blot_support::none<u32>(),blot_error::Error.none;}let op=operation.value;if count!=blot_check_storage_ops::arity(op) {let err=self.diagnostic(Code.call_arity,id);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let root,err=self.types.fresh();return blot_support::some(root),err;}let first=backwards[count-1];let input,err=self.expression(first);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let resolved,err=self.types.resolve(input,0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let kind=blot_check_storage_types::info(self.types,resolved);var element=blot_check_storage_types::arrayElement(self.types,resolved);if !element.present && kind.present && kind.value.kind==blot_check_storage_types::view {element=blot_support::some(kind.value.element);}let result,err=storageOperation(self,op,first,input,kind,element,backwards[..count]);return blot_support::some(result),err;}
fn storageOperation(self:Engine&,op:blot_check_storage_ops::Op,first:u32,input:u32,kind:blot_support::Option<blot_check_storage_types::Info>,element:blot_support::Option<u32>,backwards:const u32[:])->u32,blot_error::Error {var result=blot_check_types::unit;var valid=true;match op {
