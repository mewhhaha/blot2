fn updateConstraint(self: ClosureRegion&,c: Constraint) -> bool,Error { let resolved,error=self.solver.resolve(c.left,0); if error!=Error.none { return false,error; } let owner=self.solver.node(resolved); if owner.tag==TypeTag.variable { return false,Error.none; } if owner.tag==TypeTag.record { let updated,e=updatedRecord(self,c.left,c.right,c.member,blot_support::none<u32>()); if e!=Error.none { return false,e; } if !updated.present { return false,failConstraint(self,c,Code.missing_field); } let joined=unify(self,c.result,updated.value); if joined!=Error.none { return false,joined; } } else if owner.tag==TypeTag.nominal { let source=self.scratch.sources[c.scope]; let module=self.session.units[source.owner]; var constructors=0; for constructor in module.constructors { let nominal=module.nominal(constructor.nominal); if nominalIdentity(self.session,source.owner,nominal.identity.unit,nominal.identity.decl)!=((owner.a as u64)<<32|owner.b) { continue; } constructors++; if constructor.payload==0 { return false,failConstraint(self,c,Code.missing_field); } let input_scope,e=typeScope(self,source.owner); if e!=Error.none { return false,e; } let output_scope,e2=typeScope(self,source.owner); if e2!=Error.none { return false,e2; } var work=RegionImport {self}; let input=self.solver.node(sourceType(work,input_scope,constructor.scheme.root,0)); let output=self.solver.node(sourceType(work,output_scope,constructor.scheme.root,0)); if work.failure!=Error.none { return false,work.failure; } if input.tag!=TypeTag.function||output.tag!=TypeTag.function { return false,Error.type_mismatch; } let joined=unify(self,input.b,c.left); if joined!=Error.none { return false,joined; } let output_payload=sourceType(work,output_scope,constructor.payload,0); let input_payload=sourceType(work,input_scope,constructor.payload,0); if work.failure!=Error.none { return false,work.failure; } let updated,e3=updatedRecord(self,output_payload,c.right,c.member,blot_support::some(input_payload)); if e3!=Error.