recursive fn retainedCall(self_:Walker&,source:u32,depth:i64)->blot_support::Option<bool>,Error {let error=self_.step(depth);if error!=blot_error::Error.none {return blot_support::none<bool>(),error;}let call=blot_check_capability_flow::coreCall(self_.module,source);if !call.present {return blot_support::none<bool>(),blot_error::Error.none;}let selected,error=self_.target(call.value.target);if error!=blot_error::Error.none {return blot_support::none<bool>(),error;}if !selected {return blot_support::none<bool>(),blot_error::Error.invalid_artifact;}let owner .= selected;let resolved=blot_check_capability_flow::coreCallBody(owner,call.value);if !resolved.present {return blot_support::none<bool>(),blot_error::Error.none;}let retained=blot_check_capability_flow::retainedCore(owner,resolved.value.body,resolved.value.bindings[..resolved.value.len],self_.scopes.remaining);if !retained.present {return blot_support::none<bool>(),blot_error::Error.none;}for argument,ordinal in call.value.arguments[..call.value.len] {if retained.value & ((1 as u16) << ordinal)==0 {continue;}let captured,error=self_.capturesOpening(argument,depth+1);if error!=blot_error::Error.none {return blot_support::none<bool>(),error;}if captured {return blot_support::some(true),blot_error::Error.none;}}return blot_support::some(false),blot_error::Error.none;}
