 if scalar!=0 {let member=text[5..];for candidate in ["add","sub","mul","div"] {if member==candidate {return arrow2(self,scalar,scalar,scalar);}}if scalar==blot_check_types::u32_type {for candidate in ["rem","bit_and","bit_or","bit_xor","shl","shr"] {if member==candidate {return arrow2(self,scalar,scalar,scalar);}}}for candidate in ["eq","ne","lt","le","gt","ge"] {if member==candidate && (scalar==blot_check_types::f32_type || member=="eq" || member=="lt") {return arrow2(self,scalar,scalar,blot_check_types::boolean);}}if scalar==blot_check_types::f32_type {for candidate in ["neg","abs","sqrt","floor","ceil","trunc"] {if member==candidate {return self.types.function(scalar,scalar);}}}if scalar==blot_check_types::u32_type && member=="to_f32" {return self.types.function(blot_check_types::u32_type,blot_check_types::f32_type);}if scalar==blot_check_types::f32_type && member=="to_u32" {return self.types.function(blot_check_types::f32_type,blot_check_types::u32_type);}}
 let collection=blot_backend_collection_ops::lookup(text);if collection.present {return collectionIntrinsic(self,id,collection.value);}let err=self.diagnostic(Code.unsupported,id);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();
}
fn collectionIntrinsic(self:Engine&,id:u32,primitive:blot_backend_collection_ops::Primitive)->u32,blot_error::Error {let element,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}let op=primitive.op;if op==blot_backend_collection_ops::Op.cursor_has || op==blot_backend_collection_ops::Op.cursor_value || op==blot_backend_collection_ops::Op.cursor_advance {let collection,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}let err=self.constrainCollection(collection,element,id);if err!=blot_error::Error.none {return 0,err;}let cursor,err=self.types.sequence(blot_check_types::Tag.cursor,collection);if err!=blot_error::Error.none {return 0,err;}var result=cursor;if op==blot_backend_collection_ops::Op.cursor_has {result=blot_check_types::boolean;}else if op==blot_backend_collection_ops::Op.cursor_value {result=element;}return self.types.function(cursor,result);}var tag=blot_check_types::Tag.array;if primitive.is_list {tag=blot_check_types::Tag.list;}let sequence,err=self.types.sequence(tag,element);if err!=blot_error::Error.none {return 0,err;}match op {
 blot_backend_collection_ops::Op.flatten => {let array,err=self.types.sequence(blot_check_types::Tag.array,sequence);if err!=blot_error::Error.none {return 0,err;}return self.types.function(array,sequence);},
 blot_backend_collection_ops::Op.length => {return self.types.function(sequence,blot_check_types::u32_type);},
 blot_backend_collection_ops::Op.get => {return arrow2(self,sequence,blot_check_types::u32_type,element);},
 blot_backend_collection_ops::Op.set => {return arrow3(self,sequence,blot_check_types::u32_type,element,sequence);},
 blot_backend_collection_ops::Op.fill => {return arrow2(self,blot_check_types::u32_type,element,sequence);},
 blot_backend_collection_ops::Op.generate => {let callback,err=self.types.function(blot_check_types::u32_type,element);if err!=blot_error::Error.none {return 0,err;}return arrow2(self,blot_check_types::u32_type,callback,sequence);},
 blot_backend_collection_ops::Op.append,blot_backend_collection_ops::Op.prepend => {return arrow2(self,sequence,element,sequence);},
 blot_backend_collection_ops::Op.identity => {return self.types.function(sequence,sequence);},
 blot_backend_collection_ops::Op.convert => {var source_tag=blot_check_types::Tag.list;if primitive.is_list {source_tag=blot_check_types::Tag.array;}let source,err=self.types.sequence(source_tag,element);if err!=blot_error::Error.none {return 0,err;}return self.types.function(source,sequence);},
 blot_backend_collection_ops::Op.cursor => {let cursor,err=self.types.sequence(blot_check_types::Tag.cursor,sequence);if err!=blot_error::Error.none {return 0,err;}return self.types.function(sequence,cursor);},
 blot_backend_collection_ops::Op.concat => {return arrow2(self,sequence,sequence,sequence);},
 blot_backend_collection_ops::Op.slice => {return arrow3(self,sequence,blot_check_types::u32_type,blot_check_types::u32_type,sequence);},
 blot_backend_collection_ops::Op.simd_load => {let vector,err=self.types.product([element,element,element,element]);if err!=blot_error::Error.none {return 0,err;}return arrow2(self,sequence,blot_check_types::u32_type,vector);},
 blot_backend_collection_ops::Op.simd_store => {let vector,err=self.types.product([element,element,element,element]);if err!=blot_error::Error.none {return 0,err;}return arrow3(self,sequence,blot_check_types::u32_type,vector,sequence);},
 _ => {abort("cursor operations handled before sequence construction");},
 }}
recursive fn Engine::proofOperand(self:Engine&,source:u32,depth:i64)->u32,blot_error::Error {let values .= self.proof_body.values;if depth>=128 {return 0,blot_error::Error.proof_analysis_limit;}let err=values.charge(1);if err!=blot_error::Error.none {return 0,err;}let node=self.tree.node(source);if node.tag==blot_parse_ast::tag_group {return self.proofOperand(node.a,depth+1);}var kind=blot_check_numeric_proof_terms::Kind.unsigned32;match self.types.node(self.types.head(self.expr_types[source],0)).tag {blot_check_types::Tag.unsigned32=>{},blot_check_types::Tag.array=>{kind=blot_check_numeric_proof_terms::Kind.array;},blot_check_types::Tag.list=>{kind=blot_check_numeric_proof_terms::Kind.list;},_=>{return 0,blot_error::Error.invalid_proof_operand;},}if node.tag==blot_parse_ast::tag_integer {return values.intern(blot_check_numeric_proof_terms::Term{tag:blot_check_numeric_proof_terms::Tag.literal,a:node.a});}if node.tag==blot_parse_ast::tag_name {let binding=self.resolved[source];if binding==0 {return 0,blot_error::Error.invalid_proof_operand;}let origin .= self.proof_body.sources.get(binding);if origin {return self.proofOperand(origin,depth+1);}return values.intern(blot_check_numeric_proof_terms::Term{tag:blot_check_numeric_proof_terms::Tag.version,kind:kind,a:binding,b:1});}if node.tag==blot_parse_ast::tag_apply && self.tree.node(node.a).tag==blot_parse_ast::tag_intrinsic {let name=self.pool.get(self.tree.node(node.a).a);var collection=blot_support::none<blot_check_numeric_proof_terms::Kind>();if name=="@array.length" {collection=blot_support::some(blot_check_numeric_proof_terms::Kind.array);}if name=="@list.length" {collection=blot_support::some(blot_check_numeric_proof_terms::Kind.list);}if collection.present {let operand,err=self.proofOperand(node.b,depth+1);if err!=blot_error::Error.none {return 0,err;}let term,err=values.view().get(operand);if err!=blot_error::Error.none {return 0,err;}if term.kind!=collection.value {return 0,blot_error::Error.invalid_proof_operand;}return values.intern(blot_check_numeric_proof_terms::Term{tag:blot_check_numeric_proof_terms::Tag.length,a:operand});}}return values.intern(blot_check_numeric_proof_terms::Term{tag:blot_check_numeric_proof_terms::Tag.version,kind:kind,a:source,b:2});}
recursive fn Engine::proofProposition(self:Engine&,source:u32,depth:i64)->blot_support::Option<blot_check_numeric_proof_terms::Proposition>,blot_error::Error {if depth>=128 {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),blot_error::Error.proof_analysis_limit;}let err=self.proof_body.values.charge(1);if err!=blot_error::Error.none {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),err;}let index .= self.proof_body.expressions.get(source);if index {let introduction=self.proof_body.introductions[index];if introduction.owner!=self.proof_owner {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),blot_error::Error.proof_scope_escape;}return blot_support::some(introduction.proposition),blot_error::Error.none;}let node=self.tree.node(source);if node.tag==blot_parse_ast::tag_group {return self.proofProposition(node.a,depth+1);}if node.tag==blot_parse_ast::tag_apply {return self.proofCallResult(source);}var result=blot_support::none<blot_check_numeric_proof_terms::Proposition>();if node.tag==blot_parse_ast::tag_block {let error=self.proofReturns(source,result,depth+1);return result,error;}if node.tag==blot_parse_ast::tag_if_expr {let err=self.proofJoin(node.b,result,depth+1);if err!=blot_error::Error.none {return result,err;}let err=self.proofJoin(node.c,result,depth+1);return result,err;}if node.tag==blot_parse_ast::tag_case_expr {for arm in self.tree.list(blot_parse_ast::List{node.b,node.c}) {let metadata=self.tree.extra.items[self.tree.node(arm).c..self.tree.node(arm).c+2];let err=self.proofJoin(metadata[1],result,depth+1);if err!=blot_error::Error.none {return result,err;}}return result,blot_error::Error.none;}if node.tag!=blot_parse_ast::tag_name {return result,blot_error::Error.none;}let binding=self.resolved[source];let origin .= self.proof_body.sources.get(binding);if origin {return self.proofProposition(origin,depth+1);}for parameter in self.proof_body.parameters {let err=self.proof_body.values.charge(1);if err!=blot_error::Error.none {return result,err;}if parameter.binding!=binding {continue;}let err=self.proof_body.values.charge(self.proof_contracts.len);if err!=blot_error::Error.none {return result,err;}for contract in self.proof_contracts {if contract.binding==parameter.contract {if self.current!=contract.binding {return result,blot_error::Error.proof_scope_escape;}let slot,err=self.proofBodySlot(contract,self.proof_owner);if err!=blot_error::Error.none {return result,err;}if !slot.present {return result,blot_error::Error.proof_scope_escape;}return blot_support::some(parameter.proposition),blot_error::Error.none;}}}return result,blot_error::Error.none;}
recursive fn Engine::proofJoin(self:Engine&,source:u32,result:blot_support::Option<blot_check_numeric_proof_terms::Proposition>&,depth:i64)->blot_error::Error {if self.types.head(self.expr_types[source],0)==blot_check_types::never {return blot_error::Error.none;}let proposition,err=self.proofProposition(source,depth);if err!=blot_error::Error.none {return err;}if !proposition.present {return blot_error::Error.invalid_proof_operand;}if result.present {if result.value!=proposition.value {return blot_error::Error.invalid_proof_operand;}}else {result=proposition;}return blot_error::Error.none;}
recursive fn Engine::proofReturns(self:Engine&,source:u32,result:blot_support::Option<blot_check_numeric_proof_terms::Proposition>&,depth:i64)->blot_error::Error {if source==0 {return blot_error::Error.none;}if depth>=128 {return blot_error::Error.proof_analysis_limit;}let err=self.proof_body.values.charge(1);if err!=blot_error::Error.none {return err;}let node=self.tree.node(source);match node.tag {
 blot_parse_ast::tag_block=>{for child in self.tree.children(source) {let err=self.proofReturns(child,result,depth+1);if err!=blot_error::Error.none {return err;}}},
 blot_parse_ast::tag_return_stmt=>{return self.proofJoin(node.a,result,depth+1);},
 blot_parse_ast::tag_if_stmt=>{let err=self.proofReturns(node.b,result,depth+1);if err!=blot_error::Error.none {return err;}return self.proofReturns(node.c,result,depth+1);},
 blot_parse_ast::tag_if_let_stmt=>{for body in self.tree.extra.items[node.c..node.c+2] {let err=self.proofReturns(body,result,depth+1);if err!=blot_error::Error.none {return err;}}},
 blot_parse_ast::tag_forever_stmt=>{return self.proofReturns(node.a,result,depth+1);},
 blot_parse_ast::tag_range_stmt=>{return self.proofReturns(node.c,result,depth+1);},
 blot_parse_ast::tag_for_stmt=>{return self.proofReturns(self.tree.extra.items[node.c+1],result,depth+1);},_=>{},}return blot_error::Error.none;}
fn reverseWords(values:u32[:]) {var first:i64=0;var last=values.len;while first<last {last-=1;if first>=last {break;}let old=values[first];values[first]=values[last];values[last]=old;first+=1;}}
fn Engine::proofCallResult(self:Engine&,source:u32)->blot_support::Option<blot_check_numeric_proof_terms::Proposition>,blot_error::Error {var arguments:u32[>..]=[];var leaf=source;while self.tree.node(leaf).tag==blot_parse_ast::tag_apply {let err=self.proof_body.values.charge(1);if err!=blot_error::Error.none {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),err;}if arguments.len>=self.proof_body.values.limits.terms {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),blot_error::Error.proof_analysis_limit;}arguments.push(self.tree.node(leaf).b);leaf=self.tree.node(leaf).a;}if self.tree.node(leaf).tag!=blot_parse_ast::tag_name {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),blot_error::Error.none;}let err=self.proof_body.values.charge(self.proof_contracts.len);if err!=blot_error::Error.none {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),err;}let found=self.proofContract(self.resolved[leaf]);if !found.present {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),blot_error::Error.none;}let header=found.value;if !header.result.present || arguments.len!=header.arity {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),blot_error::Error.none;}reverseWords(arguments);var values:u32[>..]=[];values.resize(header.arity,0);for slot in header.value_slots {let value,err=self.proofOperand(arguments[slot],0);if err!=blot_error::Error.none {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),err;}values[slot]=value;}let propositions,err=header.signature().instantiate(self.proof_body.values,values);if err!=blot_error::Error.none {return blot_support::none<blot_check_numeric_proof_terms::Proposition>(),err;}return blot_support::some(propositions[propositions.len-1]),blot_error::Error.none;}
fn Engine::proofResult(self:Engine&,lambda:u32,body:u32)->blot_error::Error {if self.types.head(self.expr_types[body],0)==blot_check_types::never {return blot_error::Error.none;}let error=self.proof_body.values.charge(self.proof_contracts.len);if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,body);return err;}for contract in self.proof_contracts {if contract.binding!=self.current || !contract.header.result.present {continue;}let slot,error=self.proofBodySlot(contract,lambda);if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,body);return err;}if !slot.present || slot.value+1!=contract.header.arity {continue;}var values:u32[>..]=[];values.resize(contract.header.arity,0);for position,index in contract.header.value_slots {let kind=contract.header.values[index];let value,error=self.proof_body.values.intern(blot_check_numeric_proof_terms::Term{tag:blot_check_numeric_proof_terms::Tag.version,kind:kind,a:contract.parameters[position],b:1});if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,body);return err;}values[position]=value;}let expected,error=contract.header.signature().instantiate(self.proof_body.values,values);if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,body);return err;}let actual,error=self.proofProposition(body,0);if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,body);return err;}let valid,err=self.proofEntails(actual,expected[expected.len-1],body);if err!=blot_error::Error.none {return err;}if !valid {return self.diagnostic(Code.proof_mismatch,body);}return blot_error::Error.none;}return self.diagnostic(Code.proof_scope_escape,body);}
fn Engine::proofEntails(self:Engine&,actual:blot_support::Option<blot_check_numeric_proof_terms::Proposition>,expected:blot_check_numeric_proof_terms::Proposition,source:u32)->bool,blot_error::Error {if !actual.present {return false,blot_error::Error.none;}let supplied=actual.value;if supplied==expected {return true,blot_error::Error.none;}let result,error=blot_check_numeric_proof_contracts::entails(self.proof_body.values,[supplied],expected);if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,source);return false,err;}return result,blot_error::Error.none;}
fn Engine::proofCall(self:Engine&,source:u32,witness:u32)->bool,blot_error::Error {var reverse:u32[>..]=[];var leaf=source;while self.tree.node(leaf).tag==blot_parse_ast::tag_apply {if reverse.len>=4096 {let err=self.diagnostic(Code.proof_analysis_limit,source);return false,err;}reverse.push(self.tree.node(leaf).b);leaf=self.tree.node(leaf).a;}if self.tree.node(leaf).tag!=blot_parse_ast::tag_name || reverse.len==0 {let err=self.diagnostic(Code.proof_runtime_use,source);return false,err;}let callee=self.resolved[leaf];let error=self.proof_body.values.charge(reverse.len+self.proof_contracts.len);if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,source);return false,err;}let found=self.proofContract(callee);if !found.present {let err=self.diagnostic(Code.proof_runtime_use,source);return false,err;}let header=found.value;reverseWords(reverse);let slot=(reverse.len-1) as u32;var arguments:u32[>..]=[];arguments.resize(slot,0);for value_slot in header.value_slots {if value_slot>=slot {break;}let value,error=self.proofOperand(reverse[value_slot],0);if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,source);return false,err;}arguments[value_slot]=value;}let expected,error=header.signature().instantiateRequirement(self.proof_body.values,slot,arguments);if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,source);return false,err;}let actual,error=self.proofProposition(witness,0);if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,witness);return false,err;}let valid,err=self.proofEntails(actual,expected,witness);if err!=blot_error::Error.none {return false,err;}if !valid {let err=self.diagnostic(Code.proof_mismatch,witness);return false,err;}let error=self.proof_body.use(blot_check_numeric_proof_bodies::Use{source:source,callee:callee,witness:witness,proposition:expected});if error!=blot_error::Error.none {let ignored,err=self.proofHeaderFailure(error,source);return false,err;}return true,blot_error::Error.none;}
fn Engine::proofIntroduction(self:Engine&,id:u32)->blot_support::Option<u32>,blot_error::Error {if !self.tree.has_numeric_proofs {return blot_support::none<u32>(),blot_error::Error.none;}let outer=self.tree.node(id);if outer.tag!=blot_parse_ast::tag_apply {return blot_support::none<u32>(),blot_error::Error.none;}let inner=self.tree.node(outer.a);if inner.tag!=blot_parse_ast::tag_apply {return blot_support::none<u32>(),blot_error::Error.none;}let primitive=self.tree.node(inner.a);if primitive.tag!=blot_parse_ast::tag_intrinsic {return blot_support::none<u32>(),blot_error::Error.none;}let relation,present=blot_check_numeric_proof_terms::constructor(self.pool.get(primitive.a));if !present {return blot_support::none<u32>(),blot_error::Error.none;}let left_type,err=self.expression(inner.b);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let right_type,err=self.expression(outer.b);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if relation!=blot_check_numeric_proof_terms::Relation.index {let err=self.constrain(left_type,blot_check_types::u32_type,inner.b);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}}let err=self.constrain(right_type,blot_check_types::u32_type,outer.b);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let left,error=self.proofOperand(inner.b,0);if error!=blot_error::Error.none {let root,failure=self.proofHeaderFailure(error,inner.b);return blot_support::some(root),failure;}let right,error=self.proofOperand(outer.b,0);if error!=blot_error::Error.none {let root,failure=self.proofHeaderFailure(error,outer.b);return blot_support::some(root),failure;}let error=self.proof_body.introduce(blot_check_numeric_proof_bodies::Introduction{source:id,owner:self.proof_owner,arguments:[inner.b,outer.b],proposition:blot_check_numeric_proof_terms::Proposition{relation,left,right}});if error!=blot_error::Error.none {let root,failure=self.proofHeaderFailure(error,id);return blot_support::some(root),failure;}let root,err=self.types.proofKind();return blot_support::some(root),err;}
fn Engine::runtimeValue(self:Engine&,ty:u32,source:u32)->u32,blot_error::Error {if self.has_tasks && self.spawnUse(source).present {let err=self.diagnostic(Code.task_capture_transfer,source);if err!=blot_error::Error.none {return 0,err;}}if !self.types.has_proof_kinds || self.types.node(self.types.head(ty,0)).tag!=blot_check_types::Tag.erased_proof {return ty,blot_error::Error.none;}let err=self.diagnostic(Code.proof_runtime_use,source);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}
fn Engine::nameExpression(self:Engine&,id:u32)->u32,blot_error::Error {let node=self.tree.node(id);if self.editorAt(id) && self.editor_marker.present && self.editor_marker.value.kind==blot_reuse_completion_probe::Kind.expression {return self.captureEditor(id,0,0);}let found=self.lookup(node.a);if found.present {let binding=found.value;let stage .= self.staging_bindings.get(binding);var depth:u32=0;if stage {depth=stage;}if self.tree.has_typed_staging && depth!=self.staging_depth {let err=self.diagnostic(Code.stage_unavailable,id);if err!=blot_error::Error.none {return 0,err;}}self.resolved[id]=binding;let ty,err=self.instantiate(binding,id);if err!=blot_error::Error.none {return 0,err;}if self.types.has_proof_kinds && self.types.node(self.types.head(ty,0)).tag==blot_check_types::Tag.erased_proof {let proposition,error=self.proofProposition(id,0);if error!=blot_error::Error.none {return self.proofHeaderFailure(error,id);}if !proposition.present {let err=self.diagnostic(Code.proof_mismatch,id);if err!=blot_error::Error.none {return 0,err;}}}return ty,blot_error::Error.none;}let global,err=self.globalBinding(node.a);if err!=blot_error::Error.none {return 0,err;}if global.present {return self.globalReference(global.value,id);}let qualified,err=self.qualifiedValue(id,node.a);if err!=blot_error::Error.none {return 0,err;}if qualified.present {return qualified.value,blot_error::Error.none;}let template,err=self.operationTemplate(node.a);if err!=blot_error::Error.none {return 0,err;}if template.present {return self.operationValue(id,template.value,blot_support::none<const u32[:]>());}let constructor,err=self.typeConstructorValue(self.catalogKey(node.a));if err!=blot_error::Error.none {return 0,err;}if constructor.present {return constructor.value,blot_error::Error.none;}return self.diagnosticFresh(Code.unknown_name,id);}
fn Engine::taskRegionExpression(self:Engine&,id:u32)->u32,blot_error::Error {let parameter=self.task_region_parameter;var binding:u32=0;if parameter!=0 {binding=self.resolved[parameter];}if binding==0 || !blot_check_task_types::isGroup(self.types,self.types.head(self.bindings[binding].ty,0)) {return self.diagnosticFresh(Code.task_escape,id);}let stage .= self.staging_bindings.get(binding);var depth:u32=0;if stage {depth=stage;}if self.tree.has_typed_staging && depth!=self.staging_depth {let err=self.diagnostic(Code.stage_unavailable,id);if err!=blot_error::Error.none {return 0,err;}}self.resolved[id]=binding;return self.bindings[binding].ty,blot_error::Error.none;}
