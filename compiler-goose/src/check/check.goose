fn operationTypeNominal(self:Engine&,id:u32,index:u32,nominal:Nominal,syntax:const u32[:],depth:i64,shapes:const u32[:],old:const u32[:],fresh:u32[:],arguments:u32[:])->u32,blot_error::Error {if syntax.len!=shapes.len {let err=self.diagnostic(Code.type_arity,id);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}for &variable in fresh {let root,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}variable=root;}for origin,ordinal in syntax {let argument,err=self.parameterArgument(self.parameter_patterns.list(nominal.patterns)[ordinal],origin,false,depth+1);if err!=blot_error::Error.none {return 0,err;}let selected,err=self.types.substitute(shapes[ordinal],old,fresh);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(selected,argument,origin);if err!=blot_error::Error.none {return 0,err;}let resolved,err=self.types.resolve(selected,0);if err!=blot_error::Error.none {return 0,err;}arguments[ordinal]=resolved;}let alias,err=self.aliasInstance(index,old,fresh,id);if err!=blot_error::Error.none {return 0,err;}if alias.present {return alias.value,blot_error::Error.none;}return self.types.nominal(nominal.identity,arguments);}
