type Read is effect = { first: Unit -> U32, second: Unit -> U32 }
type State a is effect = { get: Unit -> a, set: a -> Unit }
const outer = @effect.provider Read.first (func () => return 20)
const second = @effect.provider Read.second (func () => return Read.first ())
const younger = @effect.provider Read.first (func () => return 99)
func both () => return do:
  use first <- Read.first ()
  use forwarded <- Read.second ()
  break first + forwarded
entry func nested (n: U32): U32 => return do outer:
  break do second:
    break do younger:
      use total <- both ()
      break total + n
const counter = @effect.state (State.get U32) (State.set U32) 40
func bump () => return do:
  use count <- State.get U32 ()
  use State.set U32 (count + 1)
  break count
entry func counted (n: U32): U32 => return do:
  let (final, previous) = do counter:
    use a <- bump ()
    use b <- bump ()
    break a + b + n
  break final * 1000 + previous
func early (n: U32): U32 => return do outer:
  if n > 5:
    return 7
  use value <- Read.first ()
  break value
entry func returned (n: U32): U32 => return do younger:
  let left = early n
  use right <- Read.first ()
  break left * 100 + right
