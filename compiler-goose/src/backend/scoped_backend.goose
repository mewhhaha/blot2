        concat,append,prepend,slice=>{
            let source_length,error = length(self_,module,id,args[0]); if error != blot_error::Error.none { return Value {..},error; } let count,count_error = self_.c.temp(); if count_error != blot_error::Error.none { return Value {..},count_error; } var start = zero; var out = blot_emitter::Emitter<blot_backend_wasm::Module> { code: self_.c , ..};
