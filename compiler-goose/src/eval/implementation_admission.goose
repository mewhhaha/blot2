// Recipe admission compares exact symbolic heads; prerequisites grant no overlap.
namespace blot_eval_implementation_admission;
import check.associated_admission;
import check.check_packet_owner;
import check.core;
import check.frozen_types;
import check.types;
import check.usage_check;
import eval.given_equations;
import eval.implementation_patterns;
import reuse.frozen_dependency;
import reuse.principal_interface;
import reuse.principal_type_graph;
import support.error;
import support.option;

import dictionary;
import check.check;
type Error=blot_error::Error;
type Id=u32;
type Store=blot_check_types::Store;
type Types=blot_check_core::Types;
type Copier=blot_reuse_principal_type_graph::Copier;
type Implementation=blot_reuse_principal_interface::Implementation;
type Contract=blot_reuse_principal_interface::Contract;
type ContractMember=blot_reuse_principal_interface::ContractMember;
type Member=blot_reuse_principal_interface::ImplementationMember;
type Tag=blot_check_types::Tag;
type K=blot_check_types::ObligationKind;
fn require(condition: bool) -> Error { if !condition { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; }
fn convert(error: Error) -> Error { if error==blot_error::Error.none||error==blot_error::Error.out_of_memory { return error; } return blot_error::Error.invalid_artifact; }
fn graph(source: const Types&) -> blot_check_frozen_types::Graph { return blot_check_frozen_types::Graph {source.nodes,source.extra,source.effects.rows,source.effects.labels,source.operations,source.effects.variable_count,source.quantifier_goals,source.quantifier_obligations}; }
fn charge(remaining: i64&) -> Error { if remaining==0 { return blot_error::Error.invalid_artifact; } remaining--; return blot_error::Error.none; }
fn list(copy: Copier&,span: blot_check_types::List) -> blot_check_types::List,Error { var roots: Id[>..<]=[]; for root in copy.source.list(span) { let copied,error=copy.ty(root,0); if error!=blot_error::Error.none { return blot_check_types::List {},convert(error); } roots.push(copied); } let result,error=copy.destination.saveList(roots); return result,convert(error); }
fn imported(copy: Copier&,source: Implementation) -> Implementation,Error { var value=source; let variables,error=list(copy,source.variables); if error!=blot_error::Error.none { return value,error; } value.variables=variables; var rows: u32[>..<]=[]; for row in copy.source.list(source.row_variables) { let copied,e=copy.rowVariable(row); if e!=blot_error::Error.none { return value,convert(e); } rows.push(copied); } let row_variables,e=copy.destination.saveList(rows); if e!=blot_error::Error.none { return value,convert(e); } value.row_variables=row_variables; let head,e2=list(copy,source.head); value.head=head; return value,e2; }
fn sameRoot(copy: Copier&,first: Id,second: Id,remaining: i64&) -> Error { let left,error=copy.ty(first,0); if error!=blot_error::Error.none { return convert(error); } let right,e=copy.ty(second,0); if e!=blot_error::Error.none { return convert(e); } let store: Store& =copy.destination; store.has_projections=true; store.projection_limit=store.projection_steps+remaining; let before=store.projection_steps; let same,e2=store.equalSymbolic(left,right); var spent=store.projection_steps-before; if spent>remaining { spent=remaining; } remaining-=spent; if e2!=blot_error::Error.none { return convert(e2); } return require(same); }
fn canonicalCarrier(store: Store&,id: Id,head_rows: const u32[:]) -> Id,Error { if id==0 { return 0,blot_error::Error.none; } let node=store.node(store.head(id,0)); if node.tag!=blot_check_types::Tag.function||node.a!=blot_check_types::unit||node.b!=blot_check_types::unit { return id,blot_error::Error.none; } let resolved,error=store.resolveEffects(node.c,0); if error!=blot_error::Error.none { return 0,convert(error); } let row=store.row(resolved); if row.labels.len==0 { match row.tail { variable variable=>{ var found=false; for head in head_rows { if head==variable.value { found=true; break; } } if !found { return 0,blot_error::Error.none; } },_=>{}, } } return id,blot_error::Error.none; }
struct ProjectionWork { store: Store&,remaining: i64&,observed: i64=0 }
fn sync(self_: ProjectionWork&) -> Error { let spent=self_.store.projection_steps-self_.observed; if spent>self_.remaining { return blot_error::Error.invalid_artifact; } self_.remaining-=spent; self_.observed=self_.store.projection_steps; self_.store.projection_limit=self_.store.projection_steps+self_.remaining; return blot_error::Error.none; }
fn step(self_: ProjectionWork&) -> Error { let error=sync(self_); if error!=blot_error::Error.none { return error; } let charged=charge(self_.remaining); if charged!=blot_error::Error.none { return charged; } self_.store.projection_limit=self_.store.projection_steps+self_.remaining; return blot_error::Error.none; }
fn failed(self_: ProjectionWork&) { var spent=self_.store.projection_steps-self_.observed; if spent>self_.remaining { spent=self_.remaining; } self_.remaining-=spent; }
fn contractPredicates(owner: const blot_check_core::Module&) -> const blot_check_core::Obligation[:] { return owner.obligations; }
fn contractPredicates(owner: const blot_reuse_principal_interface::Interface&) -> const blot_check_types::Obligation[:] { return owner.contract_predicates; }
fn tombstone(owner: const blot_check_core::Module&,binding: blot_check_core::Binding) -> Error { return blot_error::Error.invalid_artifact; }
fn tombstone(owner: const blot_reuse_principal_interface::Interface&,binding: blot_reuse_principal_interface::Binding) -> Error { return require(binding.name==0&&binding.ty==0); }
fn claimPredicate(predicates: const blot_check_types::Obligation[:],claimed: bool[:],index: i64) -> Error { if claimed[index] { return blot_error::Error.invalid_artifact; } claimed[index]=true; return blot_error::Error.none; }
fn claimPredicate(predicates: const blot_check_core::Obligation[:],claimed: bool[:],index: i64) -> Error { claimed[index]=true; return blot_error::Error.none; }
struct Declaration<O,P,Q> { source: const Types&,owner: const O&,implementation: Implementation,predicates: const P[:],contracts: const Q[:],remaining: i64&,work: ProjectionWork?=null }
fn declarationRecipe<O,P,Q>(source: const Types&,owner: const O&,implementation: Implementation,predicates: const P[:],contracts: const Q[:],remaining: i64&) -> Error { var context=Declaration<O,P,Q> {source,owner,implementation,predicates,contracts,remaining}; return blot_check_types::withStore<Declaration<O,P,Q>>(context,declarationStore); }
fn declarationStore<O,P,Q>(context: Declaration<O,P,Q>&,destination: Store&) -> Error { destination.has_projections=true; destination.resolution_depth_limit=256; var work=ProjectionWork {destination,context.remaining}; context.work .= work; let synced=sync(work); if synced!=blot_error::Error.none { return synced; } let frozen=graph(context.source); let error=blot_reuse_principal_type_graph::withFrozenCopy<Declaration<O,P,Q>>(blot_check_frozen_types::Source.frozen {frozen},destination,256,1000000,context.remaining,work.observed,context,declarationCopy); if error!=blot_error::Error.none { failed(work); } context.work .= null; return error; }
fn copyEndpoints<P>(copy: Copier&,predicate: P) -> Error { for endpoint in [predicate.ty,predicate.other,predicate.result,predicate.signature] { let value,error=copy.ty(endpoint,0); if error!=blot_error::Error.none { return convert(error); } } return blot_error::Error.none; }
fn declarationCopy<O,P,Q>(context: Declaration<O,P,Q>&,copy: Copier&) -> Error { let source: const Types& =context.source; let owner: const O& =context.owner; let implementation=context.implementation; let destination: Store& =copy.destination; assert(context.work!=null); let work .= context.work; var selected=blot_support::none<Contract>(); for candidate in owner.contracts { if candidate.identity==implementation.contract { selected=blot_support::some(candidate); break; } } if !selected.present { return blot_error::Error.invalid_artifact; } let contract=selected.value; let head,error=list(copy,implementation.head); if error!=blot_error::Error.none { return error; } var arguments: Id[>..<]=[]; arguments.append(destination.list(head)); for pattern,index in source.list(contract.parameters) { let expected,e=copy.ty(pattern,0); if e!=blot_error::Error.none { return convert(e); } let joined=destination.unify(expected,arguments[index]); if joined!=blot_error::Error.none { return convert(joined); } } let pack,e=destination.product(arguments); if e!=blot_error::Error.none { return convert(e); } let head_rows,e2=destination.freeRowVariables(pack); if e2!=blot_error::Error.none { return convert(e2); } let recipe_members=owner.implementation_members[implementation.members.start..implementation.members.start+implementation.members.len];
 for member in recipe_members { let ignored,e3=copy.ty(member.root,0); if e3!=blot_error::Error.none { return convert(e3); } } for member in owner.contract_members[contract.members.start..contract.members.start+contract.members.len] { let ignored,e3=copy.ty(member.root,0); if e3!=blot_error::Error.none { return convert(e3); } } for predicate in context.predicates[implementation.predicates.start..implementation.predicates.start+implementation.predicates.len] { let copied=copyEndpoints(copy,predicate); if copied!=blot_error::Error.none { return copied; } } for predicate in context.contracts[contract.predicates.start..contract.predicates.start+contract.predicates.len] { let copied=copyEndpoints(copy,predicate); if copied!=blot_error::Error.none { return copied; } }
 let synchronized=sync(work); if synchronized!=blot_error::Error.none { return synchronized; } var index=0; while index<destination.nodes.len { let charged=step(work); if charged!=blot_error::Error.none { return charged; } let node=destination.nodes.items[index]; let ordinal=index; index++; if node.tag!=blot_check_types::Tag.projection||node.a!=contract.identity.unit||node.b!=contract.identity.decl { continue; } var inputs: Id[>..<]=[]; inputs.append(destination.nominalArguments(node)); if inputs.len!=arguments.len { return blot_error::Error.invalid_artifact; } var same=true; for actual,position in inputs { let input,e3=destination.resolve(actual,0); if e3!=blot_error::Error.none { return convert(e3); } let expected,e4=destination.resolve(arguments[position],0); if e4!=blot_error::Error.none { return convert(e4); } let equal,e5=destination.equalSymbolic(input,expected); if e5!=blot_error::Error.none { return convert(e5); } if !equal { same=false; break; } } if !same { continue; } let name=destination.projectionMember(node); var equation: Id=0; for member in recipe_members { if member.kind==blot_reuse_principal_interface::ImplementationMemberKind.type_&&member.name==name { let value,e3=copy.ty(member.root,0); if e3!=blot_error::Error.none { return convert(e3); } equation=value; break; } } if equation==0 { for member in owner.contract_members[contract.members.start..contract.members.start+contract.members.len] { if member.kind==blot_reuse_principal_interface::ContractMemberKind.defined_type&&member.name==name { let value,e3=copy.ty(member.root,0); if e3!=blot_error::Error.none { return convert(e3); } equation=value; break; } } } if equation!=0 { let bound=destination.bindAssociated(ordinal as u32,equation); if bound!=blot_error::Error.none { return convert(bound); } } }
 var equations: blot_eval_given_equations::Equation[>..<]=[]; for predicate in context.predicates[implementation.predicates.start..implementation.predicates.start+implementation.predicates.len] { if predicate.kind!=blot_check_types::ObligationKind.type_eq { continue; } let charged=step(work); if charged!=blot_error::Error.none { return charged; } let left,e3=copy.ty(predicate.ty,0); if e3!=blot_error::Error.none { return convert(e3); } let right,e4=copy.ty(predicate.result,0); if e4!=blot_error::Error.none { return convert(e4); } equations.push(blot_eval_given_equations::Equation {left,right}); } var given=blot_eval_given_equations::Rewrite {destination,equations};
 for member in recipe_members { let synced=sync(work); if synced!=blot_error::Error.none { return synced; } let imported,e3=copy.ty(member.root,0); if e3!=blot_error::Error.none { return convert(e3); } let ignored,e4=destination.resolve(imported,0); if e4!=blot_error::Error.none { return convert(e4); } if member.kind!=blot_reuse_principal_interface::ImplementationMemberKind.value { continue; } var descriptor=blot_support::none<ContractMember>(); for candidate in owner.contract_members[contract.members.start..contract.members.start+contract.members.len] { if candidate.name==member.name { descriptor=blot_support::some(candidate); break; } } if !descriptor.present { return blot_error::Error.invalid_artifact; } let expected_root,e5=copy.ty(descriptor.value.root,0); if e5!=blot_error::Error.none { return convert(e5); } let expected,e6=given.normalize(expected_root); if e6!=blot_error::Error.none { return convert(e6); } let actual_root,e7=copy.ty(member.root,0); if e7!=blot_error::Error.none { return convert(e7); } let actual,e8=given.normalize(actual_root); if e8!=blot_error::Error.none { return convert(e8); } let equal,e9=destination.equalSymbolic(expected,actual); if e9!=blot_error::Error.none { return convert(e9); } if !equal { return blot_error::Error.invalid_artifact; }
  if member.target.unit==owner.unit { let binding=owner.bindings[member.target.binding]; if !binding.private { return blot_error::Error.invalid_artifact; } if binding.scheme.root==0 { let valid=tombstone(owner,binding); if valid!=blot_error::Error.none { return valid; } } else { let root,e10=copy.ty(binding.scheme.root,0); if e10!=blot_error::Error.none { return convert(e10); } let signature,e11=given.normalize(root); if e11!=blot_error::Error.none { return convert(e11); } let same,e12=destination.equalSymbolic(actual,signature); if e12!=blot_error::Error.none { return convert(e12); } if !same { return blot_error::Error.invalid_artifact; } } }
 }
 for expected in context.contracts[contract.predicates.start..contract.predicates.start+contract.predicates.len] { var found=false; for actual in context.predicates[implementation.predicates.start..implementation.predicates.start+implementation.predicates.len] { let charged=step(work); if charged!=blot_error::Error.none { return charged; } if actual.kind!=expected.kind||actual.name!=expected.name||actual.operator!=expected.operator||actual.identity!=expected.identity { continue; } var same=true; let before: Id[4]=[expected.ty,expected.other,expected.result,expected.signature]; let after: Id[4]=[actual.ty,actual.other,actual.result,actual.signature]; for operand,part in before { let l,e3=copy.ty(operand,0); if e3!=blot_error::Error.none { return convert(e3); } let r,e4=copy.ty(after[part],0); if e4!=blot_error::Error.none { return convert(e4); } var first=l; var second=r; if part==3&&(actual.kind==blot_check_types::ObligationKind.dispatch||actual.kind==blot_check_types::ObligationKind.receiver||actual.kind==blot_check_types::ObligationKind.update) { let a,e5=canonicalCarrier(destination,first,head_rows); if e5!=blot_error::Error.none { return e5; } first=a; let b,e6=canonicalCarrier(destination,second,head_rows); if e6!=blot_error::Error.none { return e6; } second=b; } let first_resolved,e5=destination.resolve(first,0); if e5!=blot_error::Error.none { return convert(e5); } let second_resolved,e6=destination.resolve(second,0); if e6!=blot_error::Error.none { return convert(e6); } let equal,e7=destination.equalSymbolic(first_resolved,second_resolved); if e7!=blot_error::Error.none { return convert(e7); } if !equal { same=false; } } if same { found=true; break; } } if !found { return blot_error::Error.invalid_artifact; } } return sync(work);
}
struct Templates<O,Q> { source: const Types&,owner: const O&,predicates: const Q[:],remaining: i64& }
fn templateRecipes<O,Q>(source: const Types&,owner: const O&,predicates: const Q[:],remaining: i64&) -> Error { if owner.member_templates.len==0 { return blot_error::Error.none; } var context=Templates<O,Q> {source,owner,predicates,remaining}; return blot_check_types::withStore<Templates<O,Q>>(context,templatesStore); }
fn templatesStore<O,Q>(context: Templates<O,Q>&,store: Store&) -> Error { let frozen=graph(context.source); var observed=store.projection_steps; return blot_reuse_principal_type_graph::withFrozenCopy<Templates<O,Q>>(blot_check_frozen_types::Source.frozen {frozen},store,256,1000000,context.remaining,observed,context,templatesCopy); }
fn templatesCopy<O,Q>(context: Templates<O,Q>&,copy: Copier&) -> Error { copy.projection_observed .= null; let owner: const O& =context.owner; let source: const Types& =context.source; var claimed: bool[>..<]=[]; claimed.resize(owner.bindings.len,false); for template,ordinal in owner.member_templates { let charged=charge(context.remaining); if charged!=blot_error::Error.none { return charged; } if claimed[template.binding] { return blot_error::Error.invalid_artifact; } claimed[template.binding]=true; let binding=owner.bindings[template.binding]; var selected=blot_support::none<Contract>(); for candidate in owner.contracts { if candidate.identity==template.contract { selected=blot_support::some(candidate); break; } } if !selected.present { return blot_error::Error.invalid_artifact; } let contract=selected.value; var descriptor=blot_support::none<ContractMember>(); for candidate in owner.contract_members[contract.members.start..contract.members.start+contract.members.len] { if candidate.name==template.name { descriptor=blot_support::some(candidate); break; } } if !descriptor.present||descriptor.value.kind!=blot_reuse_principal_interface::ContractMemberKind.value||binding.private!=contract.private||binding.kind!=blot_reuse_principal_interface::Kind.global||source.node(descriptor.value.root).tag!=blot_check_types::Tag.function { return blot_error::Error.invalid_artifact; }
 let declared=sameRoot(copy,binding.ty,descriptor.value.root,context.remaining); if declared!=blot_error::Error.none { return declared; } let scheme=sameRoot(copy,binding.scheme.root,descriptor.value.root,context.remaining); if scheme!=blot_error::Error.none { return scheme; } if source.list(binding.scheme.variables)!=source.list(contract.variables)||source.list(binding.scheme.row_variables)!=source.list(contract.row_variables)||template.arguments.len!=contract.parameters.len { return blot_error::Error.invalid_artifact; } for argument,index in source.list(template.arguments) { let equal=sameRoot(copy,argument,source.list(contract.parameters)[index],context.remaining); if equal!=blot_error::Error.none { return equal; } } let clauses=owner.obligations[binding.scheme.obligations.start..binding.scheme.obligations.start+binding.scheme.obligations.len]; let prerequisites=context.predicates[contract.predicates.start..contract.predicates.start+contract.predicates.len]; if clauses.len!=prerequisites.len+1 { return blot_error::Error.invalid_artifact; } for actual,index in clauses[..prerequisites.len] { let charged=charge(context.remaining); if charged!=blot_error::Error.none { return charged; } let expected=prerequisites[index]; if actual.kind!=expected.kind||actual.name!=expected.name||actual.operator!=expected.operator||actual.identity!=expected.identity||actual.explicit!=expected.explicit { return blot_error::Error.invalid_artifact; } let left: Id[4]=[actual.ty,actual.other,actual.result,actual.signature]; let right: Id[4]=[expected.ty,expected.other,expected.result,expected.signature]; for operand,part in left { let equal=sameRoot(copy,operand,right[part],context.remaining); if equal!=blot_error::Error.none { return equal; } } }
 let self_=clauses[prerequisites.len]; if self_.kind!=blot_check_types::ObligationKind.contract||self_.identity!=contract.identity||!self_.explicit||self_.other!=0||self_.result!=0||self_.signature!=0 { return blot_error::Error.invalid_artifact; } let pack=source.node(self_.ty); if pack.tag!=blot_check_types::Tag.product||pack.b!=contract.parameters.len { return blot_error::Error.invalid_artifact; } for argument,index in source.list(blot_check_types::List {pack.a,pack.b}) { let equal=sameRoot(copy,argument,source.list(contract.parameters)[index],context.remaining); if equal!=blot_error::Error.none { return equal; } } let body=templateBody(owner,source,copy,template,ordinal,descriptor.value,context.remaining); if body!=blot_error::Error.none { return body; }
 } return templateNodes(owner,context.remaining); }
fn templateBody(owner: const blot_reuse_principal_interface::Interface&,source: const Types&,copy: Copier&,template: blot_reuse_principal_interface::MemberTemplate,ordinal: i64,descriptor: ContractMember,remaining: i64&) -> Error { return blot_error::Error.none; }
fn templateBody(owner: const blot_check_core::Module&,source: const Types&,copy: Copier&,template: blot_reuse_principal_interface::MemberTemplate,ordinal: i64,descriptor: ContractMember,remaining: i64&) -> Error { let binding=owner.bindings[template.binding]; if binding.body_id==0 { return blot_error::Error.invalid_artifact; } let body=owner.bodies[binding.body_id]; if body.binding!=template.binding||!body.is_function||body.scheme!=binding.scheme { return blot_error::Error.invalid_artifact; } let root=owner.node(body.root); if root.tag!=blot_check_core::Tag.contract_method||root.a!=ordinal||root.c!=body.parameters.len { return blot_error::Error.invalid_artifact; } var expected=descriptor.root; let children=owner.children(body.root); for parameter,index in owner.bodyParameters(body) { let charged=charge(remaining); if charged!=blot_error::Error.none { return charged; } let arrow=source.node(expected); if arrow.tag!=blot_check_types::Tag.function { return blot_error::Error.invalid_artifact; } let input=sameRoot(copy,parameter.ty,arrow.a,remaining); if input!=blot_error::Error.none { return input; } let reference=owner.node(children[index]); if reference.tag!=blot_check_core::Tag.reference { return blot_error::Error.invalid_artifact; } let selected=owner.references[reference.a]; if selected.binding!=parameter.binding||(selected.unit!=0&&selected.unit!=owner.unit) { return blot_error::Error.invalid_artifact; } let actual=sameRoot(copy,reference.ty,arrow.a,remaining); if actual!=blot_error::Error.none { return actual; } expected=arrow.b; } if source.node(expected).tag==blot_check_types::Tag.function { return blot_error::Error.invalid_artifact; } return sameRoot(copy,root.ty,expected,remaining); }
fn templateNodes(owner: const blot_reuse_principal_interface::Interface&,remaining: i64&) -> Error { return blot_error::Error.none; }
fn templateNodes(owner: const blot_check_core::Module&,remaining: i64&) -> Error { for node,index in owner.nodes { if node.tag!=blot_check_core::Tag.contract_method { continue; } let charged=charge(remaining); if charged!=blot_error::Error.none { return charged; } let template=owner.member_templates[node.a]; if owner.bodies[owner.bindings[template.binding].body_id].root!=index { return blot_error::Error.invalid_artifact; } } return blot_error::Error.none; }
fn unrestrictedAssociatedType<N>(source: const Types&,nominals: N,root: Id,remaining: i64&) -> Error { var work=blot_check_usage_check::Work {remaining:remaining}; let contains,error=blot_check_usage_check::containsNominalWork(source,nominals,root,work); remaining=work.remaining; if error!=blot_error::Error.none { return convert(error); } return require(!contains); }
struct Scopes<O,P,Q> { source: const Types&,owner: const O&,predicates: const P[:],contracts: const Q[:],remaining: i64&,claimed: bool[:],claimed_predicates: bool[:],heads: Implementation[>..<]& }
fn scopes<O,P>(source: const Types&,owner: const O&,predicates: const P[:],remaining: i64&) -> Error { return scopesPrepared(source,owner,predicates,contractPredicates(owner),remaining); }
fn scopesPrepared<O,P,Q>(source: const Types&,owner: const O&,predicates: const P[:],contracts: const Q[:],remaining: i64&) -> Error { let templates=templateRecipes(source,owner,contracts,remaining); if templates!=blot_error::Error.none { return templates; } for member in owner.contract_members { if member.kind==blot_reuse_principal_interface::ContractMemberKind.defined_type { let unrestricted=unrestrictedAssociatedType(source,owner.nominals,member.root,remaining); if unrestricted!=blot_error::Error.none { return unrestricted; } } } if owner.implementations.len==0 { return blot_error::Error.none; } var claimed: bool[>..<]=[]; claimed.resize(owner.implementation_members.len,false); var claimed_predicates: bool[>..<]=[]; claimed_predicates.resize(predicates.len,false); var heads: Implementation[>..<]=[]; var context=Scopes<O,P,Q> {source,owner,predicates,contracts,remaining,claimed,claimed_predicates,heads}; return blot_check_types::withStore<Scopes<O,P,Q>>(context,scopesStore); }
fn scopesStore<O,P,Q>(context: Scopes<O,P,Q>&,destination: Store&) -> Error { let owner: const O& =context.owner; let source: const Types& =context.source; let frozen=graph(source); let view=blot_check_frozen_types::Source.frozen {frozen}; for implementation,ordinal in owner.implementations { let charged=charge(context.remaining); if charged!=blot_error::Error.none { return charged; } for prior in owner.implementations[..ordinal] { if prior.identity==implementation.identity { return blot_error::Error.invalid_artifact; } } if implementation.private&&implementation.name==0 { continue; } let recipe=declarationRecipe(source,owner,implementation,context.predicates,context.contracts,context.remaining); if recipe!=blot_error::Error.none { return recipe; } var selected=blot_support::none<Contract>(); for candidate in owner.contracts { if candidate.identity==implementation.contract { selected=blot_support::some(candidate); break; } } if !selected.present||!selected.value.requires_implementation||implementation.head.len!=selected.value.parameters.len { return blot_error::Error.invalid_artifact; } let contract=selected.value;
 for root in source.list(implementation.head) { let valid=blot_check_associated_admission::scope(view,implementation,root,false,context.remaining); if valid!=blot_error::Error.none { return valid; } } let variables=source.list(implementation.row_variables); for id,index in source.list(implementation.row_parameters) { let row=source.row(id); if row.labels.len!=0 { return blot_error::Error.invalid_artifact; } match row.tail { variable variable=>{ if variable.value!=variables[index] { return blot_error::Error.invalid_artifact; } },_=>{ return blot_error::Error.invalid_artifact; }, } } for variable,index in source.list(implementation.variables) { for prior in source.list(implementation.variables)[..index] { if variable==prior { return blot_error::Error.invalid_artifact; } } } for variable,index in variables { for prior in variables[..index] { if variable==prior { return blot_error::Error.invalid_artifact; } } }
 for member,offset in owner.implementation_members[implementation.members.start..implementation.members.start+implementation.members.len] { let index=implementation.members.start+offset; if context.claimed[index] { return blot_error::Error.invalid_artifact; } context.claimed[index]=true; var descriptor=blot_support::none<ContractMember>(); for candidate in owner.contract_members[contract.members.start..contract.members.start+contract.members.len] { if candidate.name==member.name { descriptor=blot_support::some(candidate); break; } } if !descriptor.present||descriptor.value.kind==blot_reuse_principal_interface::ContractMemberKind.defined_type||(descriptor.value.kind==blot_reuse_principal_interface::ContractMemberKind.abstract_type)!=(member.kind==blot_reuse_principal_interface::ImplementationMemberKind.type_) { return blot_error::Error.invalid_artifact; } for prior in owner.implementation_members[implementation.members.start..index] { if prior.name==member.name { return blot_error::Error.invalid_artifact; } } let valid=blot_check_associated_admission::scope(view,implementation,member.root,true,context.remaining); if valid!=blot_error::Error.none { return valid; } if member.kind==blot_reuse_principal_interface::ImplementationMemberKind.type_ { let unrestricted=unrestrictedAssociatedType(source,owner.nominals,member.root,context.remaining); if unrestricted!=blot_error::Error.none { return unrestricted; } } }
 for descriptor in owner.contract_members[contract.members.start..contract.members.start+contract.members.len] { if descriptor.kind==blot_reuse_principal_interface::ContractMemberKind.defined_type { continue; } var present=false; for member in owner.implementation_members[implementation.members.start..implementation.members.start+implementation.members.len] { if member.name==descriptor.name { present=true; break; } } if !present { return blot_error::Error.invalid_artifact; } }
 for predicate,offset in context.predicates[implementation.predicates.start..implementation.predicates.start+implementation.predicates.len] { let index=implementation.predicates.start+offset; let claimed=claimPredicate(context.predicates,context.claimed_predicates,index); if claimed!=blot_error::Error.none { return claimed; } for endpoint in [predicate.ty,predicate.other,predicate.result,predicate.signature] { let valid=blot_check_associated_admission::scope(view,implementation,endpoint,false,context.remaining); if valid!=blot_error::Error.none { return valid; } } }
 var imported_context=ScopeImport<O,P,Q> {context,implementation,contract}; var observed=destination.projection_steps; let imported=blot_reuse_principal_type_graph::withFrozenCopy<ScopeImport<O,P,Q>>(view,destination,256,1000000,context.remaining,observed,imported_context,scopeImport); if imported!=blot_error::Error.none { return imported; }
 } for member,index in owner.implementation_members { if !context.claimed[index]&&(member.name!=0||member.root!=0||member.target.unit!=0||member.target.binding!=0) { return blot_error::Error.invalid_artifact; } } return blot_error::Error.none; }
struct ScopeImport<O,P,Q> { context: Scopes<O,P,Q>&,implementation: Implementation,contract: Contract }
fn scopeImport<O,P,Q>(context: ScopeImport<O,P,Q>&,copy: Copier&) -> Error { copy.projection_observed .= null; let destination: Store& =copy.destination; let declaration,error=imported(copy,context.implementation); if error!=blot_error::Error.none { return error; } for root in destination.list(declaration.head) { let contains,e=destination.containsProjection(root); if e!=blot_error::Error.none { return convert(e); } if contains { return blot_error::Error.invalid_artifact; } } var roots: Id[>..<]=[]; roots.append(destination.list(declaration.head)); let pack,e=destination.product(roots); if e!=blot_error::Error.none { return convert(e); } let variables,e2=destination.freeVariables(pack); if e2!=blot_error::Error.none { return convert(e2); } if variables.len!=declaration.variables.len { return blot_error::Error.invalid_artifact; } let rows,e3=destination.freeRowVariables(pack); if e3!=blot_error::Error.none { return convert(e3); } if rows.len!=declaration.row_variables.len { return blot_error::Error.invalid_artifact; } for prior in context.context.heads { destination.projection_limit=destination.projection_steps+context.context.remaining; let before=destination.projection_steps; let overlap,e4=blot_eval_implementation_patterns::overlap(destination,prior,declaration); var spent=destination.projection_steps-before; if spent>context.context.remaining { spent=context.context.remaining; } context.context.remaining-=spent; if e4!=blot_error::Error.none { return convert(e4); } if overlap { return blot_error::Error.invalid_artifact; } } context.context.heads.push(declaration); let point=destination.mark(); let frozen=graph(context.context.source); var observed=destination.projection_steps; var anchor=ScopeAnchor {source:context.context.source,implementation:context.implementation,contract:context.contract,roots:roots}; let checked=blot_reuse_principal_type_graph::withFrozenCopy<ScopeAnchor>(blot_check_frozen_types::Source.frozen {frozen},destination,256,1000000,context.context.remaining,observed,anchor,scopeAnchor); destination.rollback(point); return checked; }
struct ScopeAnchor { source: const Types&,implementation: Implementation,contract: Contract,roots: const Id[:] }
fn scopeAnchor(context: ScopeAnchor&,copy: Copier&) -> Error { copy.projection_observed .= null; var anchor: Id=0; if context.contract.variables.len!=0 { let root,error=copy.ty(context.source.list(context.contract.variables)[0],0); if error!=blot_error::Error.none { return convert(error); } anchor=root; } for pattern,index in context.source.list(context.contract.parameters) { let expected,error=copy.ty(pattern,0); if error!=blot_error::Error.none { return convert(error); } let joined=copy.destination.unify(expected,context.roots[index]); if joined!=blot_error::Error.none { return convert(joined); } } if context.implementation.identity.unit!=context.contract.identity.unit { if anchor==0 { return blot_error::Error.invalid_artifact; } let head=copy.destination.node(copy.destination.head(anchor,0)); if head.tag!=blot_check_types::Tag.nominal||head.a!=context.implementation.identity.unit { return blot_error::Error.invalid_artifact; } } return blot_error::Error.none; }
fn recipe(value: Implementation) -> Contract { return Contract {private:value.private,identity:value.identity,name:value.name,parameters:value.head,variables:value.variables,parameter_names:value.parameter_names,row_variables:value.row_variables,row_parameter_names:value.row_parameter_names,row_parameters:value.row_parameters,requires_implementation:true}; }
fn members(contract: blot_check_types::NominalIdentity,values: const Member[:],output: ContractMember[>..<]&) { for value in values { var kind=blot_reuse_principal_interface::ContractMemberKind.defined_type; if value.kind==blot_reuse_principal_interface::ImplementationMemberKind.value { kind=blot_reuse_principal_interface::ContractMemberKind.value; } output.push(ContractMember {contract:contract,name:value.name,kind:kind,root:value.root}); } }
fn equivalent<LP,RP>(first: const Types&,second: const Types&,left: Implementation,right: Implementation,left_members: const Member[:],right_members: const Member[:],left_predicates: LP,right_predicates: RP,remaining: i64&) -> Error { if left.contract!=right.contract||left.origin_span!=right.origin_span||first.list(left.parameter_names)!=second.list(right.parameter_names)||left_members.len!=right_members.len { return blot_error::Error.invalid_artifact; } for before,index in left_members { if before.target!=right_members[index].target { return blot_error::Error.invalid_artifact; } } var before: ContractMember[>..<]=[]; var after: ContractMember[>..<]=[]; members(left.contract,left_members,before); members(right.contract,right_members,after); return blot_check_associated_admission::equivalent(first,second,recipe(left),recipe(right),before,after,left_predicates,right_predicates,remaining); }
fn publicCore(principal: const blot_reuse_principal_interface::Interface&,executable: const blot_check_core::Module&,remaining: i64&) -> Error { let selected=selectedPrincipal(principal,executable,remaining); if selected!=blot_error::Error.none { return selected; } let first=blot_check_associated_admission::typesView(principal.graph); for implementation in principal.implementations { if implementation.private { continue; } var original=blot_support::none<Implementation>(); for candidate in executable.implementations { if candidate.identity==implementation.identity { original=blot_support::some(candidate); break; } } if !original.present { return blot_error::Error.invalid_artifact; } let before=principal.implementation_members[implementation.members.start..implementation.members.start+implementation.members.len]; let after=executable.implementation_members[original.value.members.start..original.value.members.start+original.value.members.len]; let predicates=principal.implementation_predicates[implementation.predicates.start..implementation.predicates.start+implementation.predicates.len]; let requirements=executable.obligations[original.value.predicates.start..original.value.predicates.start+original.value.predicates.len]; let equal=equivalent(first,executable.types,implementation,original.value,before,after,predicates,requirements,remaining); if equal!=blot_error::Error.none { return equal; } } for implementation in executable.implementations { if implementation.private { continue; } var present=false; for candidate in principal.implementations { if !candidate.private&&candidate.identity==implementation.identity { present=true; break; } } if !present { return blot_error::Error.invalid_artifact; } } return blot_error::Error.none; }
struct SelectedPrincipal { principal: const blot_reuse_principal_interface::Interface&,executable: const blot_check_core::Module&,first: Types,remaining: i64& }
fn selectedPrincipal(principal: const blot_reuse_principal_interface::Interface&,executable: const blot_check_core::Module&,remaining: i64&) -> Error { if principal.selected_proofs.len==0 { return require(principal.selected_members.len==0&&principal.selected_edges.len==0); } if principal.selected_proofs.len!=executable.selected_proofs.len||principal.selected_members.len!=executable.selected_members.len||principal.selected_edges!=executable.selected_edges { return blot_error::Error.invalid_artifact; } var context=SelectedPrincipal {principal,executable,blot_check_associated_admission::typesView(principal.graph),remaining}; return blot_check_types::withStore<SelectedPrincipal>(context,selectedPrincipalStore); }
fn selectedPrincipalStore(context: SelectedPrincipal&,destination: Store&) -> Error { return blot_check_associated_admission::withCopiers<SelectedPrincipal>(context.first,context.executable.types,destination,context.remaining,context,selectedPrincipalCopies); }
fn compareRoot(left: Copier&,right: Copier&,first: Id,second: Id,remaining: i64&) -> Error { let original,error=left.ty(first,0); if error!=blot_error::Error.none { return convert(error); } let current,e=right.ty(second,0); if e!=blot_error::Error.none { return convert(e); } let store: Store& =left.destination; store.has_projections=true; store.projection_limit=store.projection_steps+remaining; let before=store.projection_steps; let same,e2=store.equalSymbolic(original,current); var spent=store.projection_steps-before; if spent>remaining { spent=remaining; } remaining-=spent; if e2!=blot_error::Error.none { return convert(e2); } return require(same); }
fn selectedPrincipalCopies(context: SelectedPrincipal&,destination: Store&,before: Copier&,after: Copier&) -> Error { let principal=context.principal; let executable=context.executable; for original,index in principal.selected_proofs { let charged=charge(context.remaining); if charged!=blot_error::Error.none { return charged; } let current=executable.selected_proofs[index]; if original.context!=current.context||original.kind!=current.kind||original.implementation!=current.implementation||original.contract!=current.contract||original.predicate_target!=current.predicate_target||original.members!=current.members||original.prerequisites!=current.prerequisites||original.arguments.len!=current.arguments.len { return blot_error::Error.invalid_artifact; } for left,position in context.first.list(original.arguments) { let right=executable.types.list(current.arguments)[position]; let equal=compareRoot(before,after,left,right,context.remaining); if equal!=blot_error::Error.none { return equal; } } if original.kind==blot_reuse_principal_interface::SelectedProofKind.predicate { if original.predicate.kind!=current.predicate.kind||original.predicate.operator!=current.predicate.operator||original.predicate.name!=current.predicate.name||original.predicate.identity!=current.predicate.identity { return blot_error::Error.invalid_artifact; } let left: Id[4]=[original.predicate.ty,original.predicate.other,original.predicate.result,original.predicate.signature]; let right: Id[4]=[current.predicate.ty,current.predicate.other,current.predicate.result,current.predicate.signature]; for endpoint,position in left { let equal=compareRoot(before,after,endpoint,right[position],context.remaining); if equal!=blot_error::Error.none { return equal; } } } } for original,index in principal.selected_members { let charged=charge(context.remaining); if charged!=blot_error::Error.none { return charged; } let current=executable.selected_members[index]; if original.name!=current.name||original.kind!=current.kind||original.target!=current.target { return blot_error::Error.invalid_artifact; } let equal=compareRoot(before,after,original.root,current.root,context.remaining); if equal!=blot_error::Error.none { return equal; } } return blot_error::Error.none; }
fn originalProducers(owners: const blot_reuse_frozen_dependency::Module[:],remaining: i64&) -> Error { for owner in owners { for implementation in owner.interface.implementations { if implementation.private { continue; } if implementation.identity.unit==0||implementation.identity.unit>owners.len { return blot_error::Error.invalid_artifact; } let producer=owners[implementation.identity.unit-1].interface; var original=blot_support::none<Implementation>(); for candidate in producer.implementations { if !candidate.private&&candidate.identity==implementation.identity { original=blot_support::some(candidate); break; } } if !original.present { return blot_error::Error.invalid_artifact; } let first=blot_check_associated_admission::typesView(owner.interface.graph); let second=blot_check_associated_admission::typesView(producer.graph); let equal=equivalent(first,second,implementation,original.value,owner.interface.implementation_members[implementation.members.start..implementation.members.start+implementation.members.len],producer.implementation_members[original.value.members.start..original.value.members.start+original.value.members.len],owner.interface.implementation_predicates[implementation.predicates.start..implementation.predicates.start+implementation.predicates.len],producer.implementation_predicates[original.value.predicates.start..original.value.predicates.start+original.value.predicates.len],remaining); if equal!=blot_error::Error.none { return equal; } } } return blot_error::Error.none; }
