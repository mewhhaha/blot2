import std;
import abi_fixed;
import abi_fixed_validate;

// Literal golden bytes from the ABI_PROFILE_SCHEMA fixed-word tables.
// The vector is cross-checked separately; no digest is exposed.
fn hex_digit(c: u8) -> u8 {
    if c >= '0' && c <= '9' { return c - '0'; }
    return c - 'a' + 10;
}
fn golden() -> u8[>..] {
    var hex: u8[>..] = [];
    hex.append("4b314649583030310100000022000000010000000100000001000000100000000400000001000000040000000000000001000000020000000100000010000000");
    hex.append("00000000010000000000000000000000010000000300000001000000100000000400000004000000200000000100000001000000040000000100000014000000");
    hex.append("04000000040000000200000000000000010000000100000005000000010000001000000004000000040000002000000001000000010000000600000001000000");
    hex.append("10000000040000000400000001000000010000000100000007000000010000000c00000001000000010000000100000001000000080000000100000014000000");
    hex.append("0400000004000000040000000100000001000000010000000900000001000000140000000100000000000000010000000000000000000000010000000a000000");
    hex.append("010000001000000004000000010000000000000000000000010000000b000000010000000c000000010000000000000000000000010000000c00000001000000");
    hex.append("180000004000000020000000400000002000000000010000000100000200000001000000010000000c0000000200000001000000020000000200000002000000");
    hex.append("010000000c0000000200000001000000030000000200000003000000010000000c00000002000000010000000400000002000000040000000100000010000000");
    hex.append("030000000100000002000000030000000200000005000000010000000c0000000200000005000000060000000200000006000000010000000c00000002000000");
    hex.append("05000000060000000200000007000000010000000c0000000200000005000000060000000200000008000000010000000c000000020000000500000006000000");
    hex.append("0200000009000000010000000c000000020000000700000008000000020000000a000000010000001400000004000000090000000a0000000b0000000c000000");
    hex.append("03000000010000000100000034000000000001000010000020000000000100000000004000100000000000018000000000000001000100000000100000000100");
    hex.append("00000100030000000200000001000000240000000800000001000000020000000300000004000000050000000600000007000000080000000300000003000000");
    hex.append("01000000180000000500000000000000010000000200000003000000040000000300000004000000010000002400000004000000010000000200000003000000");
    hex.append("04000000000000000000000000000000000000000400000001000000010000001400000004000000010000000200000004000000f8ffffff0400000002000000");
    hex.append("01000000180000000500000001000000020000000300000004000000050000000400000003000000010000001000000001000000000000000100000000000000");
    hex.append("0400000004000000010000000c0000000100000002000000010000000400000005000000010000000c0000000100000080000000010000000600000001000000");
    hex.append("010000002c0000000100314b20000000080000000100000002000000030000000400000005000000060000000700000008000000060000000200000001000000");
    hex.append("2000000007000000000000000100000002000000030000000400000005000000060000000600000003000000010000000c000000020000000100000002000000");
    var out: u8[>..] = [];
    for i in hex.len / 2 { out.push((hex_digit(hex[2 * i]) << 4) | hex_digit(hex[2 * i + 1])); }
    return out;
}
fn main() {
    let encoded = abi_fixed::encode_component();
    let reference = golden();
    assert(encoded == reference);
    assert(abi_fixed_validate::validate_component(encoded));
    assert(abi_fixed_validate::validate_component(reference));
    // Every one-bit change at every offset must be rejected, including each
    // section/id/version/length/payload byte. Restore before the next test.
    var changed: u8[>..] = []; changed.append(reference);
    for i in changed.len {
        for bit in 8 {
            changed[i] ^= (1 as u8 << bit);
            assert(!abi_fixed_validate::validate_component(changed));
            changed[i] ^= (1 as u8 << bit);
        }
    }
    for n in reference.len { assert(!abi_fixed_validate::validate_component(reference[0..n])); }
    // Equal-size first two records: duplicate and swap exercise multi-byte
    // changes to canonical identity and ordering.
    for i in 32 { changed[48 + i] = reference[16 + i]; }
    assert(!abi_fixed_validate::validate_component(changed));
    for i in 32 { changed[48 + i] = reference[16 + i]; changed[16 + i] = reference[48 + i]; }
    assert(!abi_fixed_validate::validate_component(changed));
    for i in reference.len { changed[i] = reference[i]; }
    changed.push(0); assert(!abi_fixed_validate::validate_component(changed));
    print("fixed ABI component golden and mutation laws passed");
}
