fn observe(body:blot_backend_wasm_copy_coalesce::Body,first:Reference[:],shared:bool[:],writes:u32[:],reads:u32[:])->Error {for inst in body.instructions {if !local(inst.op) {continue;}if inst.operand>=first.len {return blot_error::Error.invalid_outline;}let reference .= first[inst.operand];if reference.function==absent {reference.function=body.function;}else if reference.function!=body.function {shared[inst.operand]=true;}reference.weight+=1;if inst.op==blot_backend_runtime_ir::OP_local_tee {reference.weight+=1;}if inst.op==blot_backend_runtime_ir::OP_local_get {reads[inst.operand]=body.function;}else if writes[inst.operand]!=0xffffffff {writes[inst.operand]+=1;}}return blot_error::Error.none;}
struct CycleNode {index:u32=absent,low:u32=absent,active:bool=false,bank:bool=false}
struct CycleVisit {function:u32,at:i64=0}
