  constant=>{ let actual=valueScalar(self,value); if !actual.present { return false,Error.none; } let tag=module.types.node(pattern.ty).tag; var scalar=blot_backend_runtime_ir::SC_unit; if tag==TypeTag.unsigned32 { scalar=blot_backend_runtime_ir::SC_u32; } else if tag==TypeTag.boolean { scalar=blot_backend_runtime_ir::SC_bool; } else if tag!=TypeTag.unit { return false,fail(self,owner,pattern.span,Code.unsupported); } return actual.value.scalar==scalar&&actual.value.bits==pattern.a,Error.none; },
  value=>{ let expected,e=expression(self,owner,pattern.a,frame); if e!=Error.none { return false,e; } if !isValue(expected) { return false,fail(self,owner,pattern.span,Code.unsupported); } let actual=valueScalar(self,value); if !actual.present { return false,Error.none; } let scalar,e2=requireScalar(self,owner,pattern.a,flowValue(expected)); if e2!=Error.none { return false,e2; } if actual.value.scalar!=blot_backend_runtime_ir::SC_u32&&actual.value.scalar!=blot_backend_runtime_ir::SC_bool { return false,fail(self,owner,pattern.span,Code.unsupported); } return actual.value==scalar,Error.none; },
  product=>{ let info=valueInfo(self,value); let tag=module.types.node(pattern.ty).tag; var kind=ValueKind.product; if tag==TypeTag.record { kind=ValueKind.record; } else if tag!=TypeTag.product { return false,fail(self,owner,pattern.span,Code.unsupported); } let patterns=module.patternChildren(pattern_id); if info.kind!=kind||info.len!=patterns.len { return false,Error.none; } for child,index in patterns { var field=index; if kind==ValueKind.record { let name=module.types.recordField(module.types.node(pattern.ty),index).name; var found=false; for key,slot in recordFieldNames(self,value) { if key==name { field=slot; found=true; break; } } if !found { return false,Error.none; } } let child_value=valueChildren(self,value)[field]; let matched,e=matchPattern(self,owner,child,child_value,frame,bound,nesting+1); if e!=Error.none||!matched { return false,e; } } return true,Error.none; },
  record_payload=>{ let info=valueInfo(self,value); if info.kind!=ValueKind.record||info.len!=pattern.a { return false,Error.none; } let canonical,e=recordPayload(self,unitId(self,owner),pattern_id,value); if e!=Error.none { return false,e; } return matchPattern(self,owner,pattern.b,canonical,frame,bound,nesting+1); },
  constructor=>{ let constructor=module.constructor(pattern.a); let nominal=module.nominal(constructor.nominal); let info=valueInfo(self,value); if info.kind!=ValueKind.nominal||info.nominal!=nominalIdentity(self,owner,nominal.identity.unit,nominal.identity.decl)||info.bits!=constructor.tag { return false,Error.none; } if pattern.b==0 { return info.len==0,Error.none; } if info.len!=1 { return false,Error.none; } return matchPattern(self,owner,pattern.b,valueChildren(self,value)[0],frame,bound,nesting+1); },invalid=>{ return false,fail(self,owner,pattern.span,Code.unsupported); },
 }
}
fn recordArgument(self: Session&,producer: i64,owner: i64,source: u32,catalog: u32,value: ValueId) -> ValueId,Error { let module=self.units[producer]; let payload=module.constructor(catalog).payload; let record=module.types.node(payload); if record.tag!=TypeTag.record||record.b==0 { return 0,failNode(self,owner,source,Code.unsupported); } var values: ValueId[>..<]=[]; if record.b==1 { values.push(value); } else { let info=valueInfo(self,value); if info.kind!=ValueKind.product||info.len!=record.b { return 0,failNode(self,owner,source,Code.type_mismatch); } values.append(valueChildren(self,value)); } var words: u32[>..<]=[]; var closed=true; for child,index in values { let evidence=valueEvidence(self,child); words.push(module.types.recordField(record,index).name); words.push(evidence); closed=closed&&evidence!=0; } var actual: u32=0; if closed { let evidence,error=self.storage.evidence.intern(blot_eval_type_evidence::Tag.record,0,0,words); if error!=Error.none { return 0,evidenceFailure(self,owner,self.units[owner].span(source),error); } actual=evidence; } let layout,e=recordLayout(self,producer,0,payload); if e!=Error.none { return 0,e; } let result,error=makeAggregate(self,owner,source,ValueKind.record,0,0,values); if error!=Error.none { return 0,error; } self.storage.value_records[result]=layout; self.storage.value_evidence[result]=actual; return result,Error.none; }
fn canonicalRecordEvidence(self: Session&,owner: i64,source: u32,value: ValueId) -> u32,Error { let children=valueChildren(self,value); if children.len==1 { return valueEvidence(self,children[0]),Error.none; } var fields: u32[>..<]=[]; for child in children { let field=valueEvidence(self,child); if field==0 { return 0,Error.none; } fields.push(field); } let result,error=self.storage.evidence.intern(blot_eval_type_evidence::Tag.product,0,0,fields); if error!=Error.none { return 0,evidenceFailure(self,owner,self.units[owner].span(source),error); } return result,Error.none; }
fn recordPayload(self: Session&,unit: u32,pattern_id: u32,value: ValueId) -> ValueId,Error { let owner=findUnit(self,unit,blot_support::none<i64>()); if !owner.present { return 0,fail(self,self.units.len,Span {0,0},Code.unsupported); } let pattern=self.units[owner.value].pattern(pattern_id); let record=self.units[owner.value].types.node(pattern.ty); let info=valueInfo(self,value); let names=recordFieldNames(self,value); if pattern.tag!=blot_check_core::PatternTag.record_payload||record.tag!=TypeTag.record||info.kind!=ValueKind.record||pattern.a==0||info.len!=pattern.a||names.len!=pattern.a { return 0,fail(self,owner.value,pattern.span,Code.unsupported); } for name,index in names { if name!=self.units[owner.value].types.recordField(record,index).name { return 0,fail(self,owner.value,pattern.span,Code.type_mismatch); } } if pattern.a==1 { return valueChildren(self,value)[0],Error.none; } var children: ValueId[>..<]=[]; children.append(valueChildren(self,value)); return makeAggregate(self,owner.value,0,ValueKind.product,0,0,children); }
fn match(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let module=self.units[owner]; var values: ValueId[>..<]=[]; for input in module.matchInputs(id) { let outcome,error=expression(self,owner,input,frame); if error!=Error.none||!isValue(outcome) { return outcome,error; } values.push(flowValue(outcome)); } var bound: Bound[>..<]=[];
 for arm,arm_index in module.matchArms(id) { var matched=false; for row in module.armRows(arm) { bound.resize(0); let patterns=module.rowPatterns(row); if patterns.len!=values.len { return Flow.value {0},fail(self,owner,arm.span,Code.unsupported); } matched=true; for pattern,index in patterns { let okay,error=matchPattern(self,owner,pattern,values[index],frame,bound,0); if error!=Error.none { return Flow.value {0},error; } if !okay { matched=false; break; } } if matched { break; } } if !matched { continue; } installBindings(frame,bound); defer restoreBindings(frame,bound);
  if arm.guard!=0 { let guard,error=expression(self,owner,arm.guard,frame); if error!=Error.none||!isValue(guard) { return guard,error; } let condition,e=requireScalar(self,owner,arm.guard,flowValue(guard)); if e!=Error.none { return Flow.value {0},e; } if condition.scalar!=blot_backend_runtime_ir::SC_bool { return Flow.value {0},fail(self,owner,arm.span,Code.unsupported); } if condition.bits==0 { continue; } }
  let outcome,error=expression(self,owner,arm.body,frame); if error!=Error.none||!module.matchInfo(id).statement||!isValue(outcome) { return outcome,error; } for merge in module.branchMerges(id) { var source=merge.else_binding; if arm_index==0 { source=merge.then_binding; } let value=frame.values.get(source); if value==null { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } frame.values.insert(merge.result,value); } return Flow.value {0},Error.none;
 } return Flow.value {0},failNode(self,owner,id,Code.unsupported);
}
fn breakFlow(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let module=self.units[owner]; var values: ValueId[>..<]=[]; for reference in module.breakValues(id) { let outcome,error=expression(self,owner,reference,frame); if error!=Error.none||!isValue(outcome) { return outcome,error; } values.push(flowValue(outcome)); } var available=self.options.max_children-self.break_values.len; if available<0 { available=0; } if values.len>available||values.len>0xffffffff-self.break_values.len { return Flow.value {0},failNode(self,owner,id,Code.constant_fuel); } let start=self.break_values.len as u32; self.break_values.append(values); return Flow.breaking {module.node(id).a,blot_check_core::List {start,values.len as u32},module.node(id).op==blot_check_core::Op.continue_},Error.none; }
fn indexedEdit(self: Session&,region: IndexedRegion&,edit: blot_eval_eval_indexed_builder::Edit) -> Flow,Error { let owner=region.owner; let frame=region.frame; let selected,error=expression(self,owner,edit.index,frame); if error!=Error.none||!isValue(selected) { return selected,error; } let offset,e=requireScalar(self,owner,edit.update,flowValue(selected)); if e!=Error.none { return Flow.value {0},e; } if offset.scalar!=blot_backend_runtime_ir::SC_u32 { return Flow.value {0},failNode(self,owner,edit.update,Code.unsupported); } if edit.bounds_first&&offset.bits>=region.children.len { return Flow.value {0},failNode(self,owner,edit.update,Code.array_bounds); } if edit.self_binding!=0 { frame.values.insert(edit.self_binding,region.children[offset.bits]); } let next,e2=expression(self,owner,edit.value,frame); if e2!=Error.none||!isValue(next) { return next,e2; } if offset.bits>=region.children.len { return Flow.value {0},failNode(self,owner,edit.update,Code.array_bounds); } region.children[offset.bits]=flowValue(next); return Flow.value {region.original},Error.none; }
fn indexedLoop(self: Session&,owner: i64,id: u32,frame: Frame&,first: ValueId,begin: u32,end: u32,plan: blot_eval_eval_indexed_builder::Plan) -> Flow,Error { let stored=frame.values.get(plan.incoming); if stored==null { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } let original: ValueId=stored; let info=valueInfo(self,original); if info.kind!=ValueKind.array&&info.kind!=ValueKind.list { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } let error=chargeCells(self,owner,id,info.len); if error!=Error.none { return Flow.value {0},error; } var children: ValueId[>..<]=[]; children.append(valueChildren(self,original)); var region=IndexedRegion {owner,frame,original,children,plan}; let previous=self.indexed_region; declineConstant(self); self.indexed_region .= region; defer self.indexed_region .= previous; let outcome,e=loopIterations(self,owner,id,frame,first,begin,end); if e!=Error.none||!isValue(outcome) { return outcome,e; } var result=original; if begin<end { let value,e2=makeAggregate(self,owner,id,info.kind,info.nominal,info.bits,children); if e2!=Error.none { return Flow.value {0},e2; } result=value; } self.storage.value_evidence[result]=valueEvidence(self,original); frame.values.insert(plan.outgoing,result); return outcome,Error.none; }
fn loop(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let module=self.units[owner]; let metadata=module.loopInfo(id); let first,error=expression(self,owner,metadata.first,frame); if error!=Error.none||!isValue(first) { return first,error; } let last,e=expression(self,owner,metadata.end,frame); if e!=Error.none||!isValue(last) { return last,e; } var index: u32=0; var end: u32=0;
 if metadata.kind==blot_check_core::LoopKind.range { let lower,e2=requireScalar(self,owner,id,flowValue(first)); if e2!=Error.none { return Flow.value {0},e2; } let upper,e3=requireScalar(self,owner,id,flowValue(last)); if e3!=Error.none { return Flow.value {0},e3; } if lower.scalar!=blot_backend_runtime_ir::SC_u32||upper.scalar!=blot_backend_runtime_ir::SC_u32 { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } index=lower.bits; end=upper.bits; }
 else if metadata.kind==blot_check_core::LoopKind.array { let array=valueInfo(self,flowValue(first)); if array.kind!=ValueKind.array&&array.kind!=ValueKind.list { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } end=array.len; }
 if self.indexed_region==null { let plan=blot_eval_eval_indexed_builder::analyze(module,id); if plan.present { return indexedLoop(self,owner,id,frame,flowValue(first),index,end,plan.value); } } return loopIterations(self,owner,id,frame,flowValue(first),index,end);
}
fn loopIterations(self: Session&,owner: i64,id: u32,frame: Frame&,first: ValueId,begin: u32,end: u32) -> Flow,Error { let module=self.units[owner]; let metadata=module.loopInfo(id); let carries=module.loopCarries(id); var index=begin; var current: ValueId[>..<]=[]; for carry in carries { let value=frame.values.get(carry.incoming); if value==null { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } current.push(value); }
 while metadata.kind==blot_check_core::LoopKind.forever||index<end { let charge=chargeCells(self,owner,id,1); if charge!=Error.none { return Flow.value {0},charge; } for carry,position in carries { frame.values.insert(carry.iteration,current[position]); }
  if metadata.pattern!=0 { var iterator: ValueId=0; if metadata.kind==blot_check_core::LoopKind.array { iterator=valueChildren(self,first)[index]; } else { let value,error=makeScalar(self,owner,id,Value {blot_backend_runtime_ir::SC_u32,index}); if error!=Error.none { return Flow.value {0},error; } iterator=value; } var bound: Bound[>..<]=[]; let matched,error=matchPattern(self,owner,metadata.pattern,iterator,frame,bound,0); if error!=Error.none { return Flow.value {0},error; } if !matched { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } installBindings(frame,bound); }
  let outcome,error=expression(self,owner,metadata.body,frame); if error!=Error.none { return outcome,error; } var breaking=false; var continues=false; match outcome { returning=>{ return outcome,Error.none; },breaking result=>{ if result.target!=id { return outcome,Error.none; } let span=result.values; if span.len!=carries.len { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } for value,position in self.break_values[span.start..span.start+span.len] { current[position]=value; } self.break_values.resize(span.start); breaking=true; continues=result.continues; },value=>{}, }
  if breaking { if !continues { break; } if metadata.kind!=blot_check_core::LoopKind.forever { index++; } continue; } for carry,position in carries { let value=frame.values.get(carry.backedge); if value==null { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } current[position]=value; } if metadata.kind!=blot_check_core::LoopKind.forever { index++; }
 } for carry,position in carries { frame.values.insert(carry.outgoing,current[position]); } return Flow.value {0},Error.none;
}
