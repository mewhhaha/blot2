fn spawnWrapper(initial: const Module&, initial_binding: u32, units: const ModuleRef[:]) -> Error {
    var module: const Module&  = initial; var binding_id = initial_binding;
    for ignored in 0..128 { if binding_id == 0 || binding_id >= module.bindings.len { return blot_error::Error.invalid_artifact; } let binding = module.bindings[binding_id]; if binding.kind != blot_reuse_principal_interface::Kind.global || binding.capability_flow != blot_check_capability_flow::Contract.spawn_task || binding.body_id == 0 || binding.body_id >= module.bodies.len { return blot_error::Error.invalid_artifact; } let body = module.bodies[binding.body_id]; if body.binding != binding_id || body.root == 0 || body.root >= module.nodes.len { return blot_error::Error.invalid_artifact; } let root = module.node(body.root);
        if body.is_function { if body.parameters.len != 2 || body.parameters.start >= module.parameters.len || body.parameters.len > module.parameters.len - body.parameters.start || root.tag != blot_check_core::Tag.task || root.c != blot_check_task_types::opCode(blot_check_task_types::Op.spawn) || root.b != 2 || root.a >= module.extra.len || root.b > module.extra.len - root.a { return blot_error::Error.invalid_artifact; }
            for operand, index in module.children(body.root) { let parameter = module.parameters[body.parameters.start + index]; if operand == 0 || operand >= module.nodes.len || module.node(operand).tag != blot_check_core::Tag.reference || module.node(operand).a >= module.references.len { return blot_error::Error.invalid_artifact; } let reference = module.reference(operand); if (reference.unit != 0 && reference.unit != module.unit) || reference.binding != parameter.binding { return blot_error::Error.invalid_artifact; } }
            if !blot_check_task_types::isGroup(module.types, module.parameters[body.parameters.start].ty) { return blot_error::Error.invalid_artifact; } let action, err = once(module, module.children(body.root)[1]); if err != blot_error::Error.none { return err; } if action.a != blot_check_types::unit { return blot_error::Error.invalid_artifact; } return blot_error::Error.none;
        }
        if body.parameters.len != 0 || root.tag != blot_check_core::Tag.reference || root.a >= module.references.len { return blot_error::Error.invalid_artifact; } let reference = module.reference(body.root); binding_id = reference.binding; let owner, err = ownerUnit(module, reference.unit, units); if err != blot_error::Error.none { return err; } if !owner { return blot_error::Error.invalid_artifact; } module .= owner;
    } return blot_error::Error.invalid_artifact;
