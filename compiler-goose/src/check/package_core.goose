recursive fn capturesOpening(self_:Walker&,source:u32,depth:i64)->bool,Error {let error=self_.step(depth);if error!=blot_error::Error.none {return false,error;}let node=self_.module.node(source);let unsealed,error=self_.unsealedType(node.ty,depth+1);if error!=blot_error::Error.none || unsealed {return unsealed,error;}match self_.module.types.node(node.ty).tag {unit,boolean,unsigned32,floating32,never=>{return false,blot_error::Error.none;},_=>{},}match node.tag {
