return blot_support::none<Operation>(),blot_error::Error.none;}let resolved,error=selected.lanePrimitiveMember(owner,root.c);if error!=blot_error::Error.none || !resolved.present {return blot_support::none<Operation>(),error;}operation=resolved.value;}return blot_support::some(Operation{op:operation,left:call.arguments[0],right:call.arguments[1],..}),blot_error::Error.none;}
struct Value {binding:u32,node:u8}
struct Proof {module:const Core&,units:const Core[:],resolver:blot_backend_scoped_backend::Generator?=null,iterator:u32,state:BindingRef,input:blot_support::Option<BindingRef> =blot_support::none<BindingRef>(),lane:blot_support::Option<u32> =blot_support::none<u32>(),seen_state:bool=false,values:Value[16]=[default<Value>();16],value_len:i64=0,output:Source}
fn cyclic(self_:Proof&,id:u32)->bool,Error {if self_.lane.present && same(self_.module,id,self_.lane.value) {return true,blot_error::Error.none;}let selected,error=scalarOperation(self_.units,self_.module,id,self_.resolver);if error!=blot_error::Error.none || !selected.present {return false,error;}let operation=selected.value;if operation.op!=blot_check_core::Op.rem || !same(self_.module,operation.left,self_.iterator) {return false,blot_error::Error.none;}let eight=self_.module.node(operation.right);if eight.tag!=blot_check_core::Tag.constant || eight.ty!=blot_check_types::u32_type || eight.a!=8 {return false,blot_error::Error.none;}if operation.associated {self_.output.associated_ops[blot_check_core::opCode(blot_check_core::Op.rem)]=true;}return true,blot_error::Error.none;}
