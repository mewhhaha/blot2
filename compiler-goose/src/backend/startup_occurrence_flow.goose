fn deinit(self_:Words&) {blot_support_pooled_buffer::deinit(self_,pool_Words);self_.len=0;self_.failure=blot_error::Error.none;}
struct Expansions {storage:Expansion[:] = default<Expansion[:]>(),items:Expansion[:] = default<Expansion[:]>(),len:i64=0,failure:Error=blot_error::Error.none}
reusable[] var pool_Expansions:Expansion[>..]=[];
fn push(self_:Expansions&,value:Expansion) {if self_.failure!=blot_error::Error.none {return;}self_.failure=blot_support_pooled_buffer::push(self_,value,pool_Expansions);self_.len=self_.items.len;}
fn append(self_:Expansions&,values:const Expansion[:]) {if self_.failure!=blot_error::Error.none {return;}self_.failure=blot_support_pooled_buffer::append(self_,values,pool_Expansions);self_.len=self_.items.len;}
