fn Engine::dictionaryGivenSelection(self:Engine&,wanted:blot_check_types::Obligation)->blot_support::Option<DictionaryGiven>,blot_error::Error {if wanted.kind!=blot_check_types::ObligationKind.contract {return blot_support::none<DictionaryGiven>(),blot_error::Error.none;}var found=blot_support::none<DictionaryGiven>();for given in self.dictionary_givens {let err=self.inferenceTransition();if err!=blot_error::Error.none {return blot_support::none<DictionaryGiven>(),err;}let goal=given.predicate;if goal.kind!=blot_check_types::ObligationKind.contract || goal.identity!=wanted.identity {continue;}let before,err=self.types.resolve(goal.ty,0);if err!=blot_error::Error.none {return blot_support::none<DictionaryGiven>(),err;}let after,err=self.types.resolve(wanted.ty,0);if err!=blot_error::Error.none {return blot_support::none<DictionaryGiven>(),err;}let equal,err=self.types.equalSymbolic(before,after);if err!=blot_error::Error.none {return blot_support::none<DictionaryGiven>(),err;}if !equal {continue;}if found.present {let err=self.diagnostic(Code.ambiguous_qualified,wanted.source);return blot_support::none<DictionaryGiven>(),err;}let index .= self.catalogs.contract_identities.get(goal.identity);assert(index!=null);let contract=self.contracts[index];let root,err=self.types.resolve(goal.ty,0);if err!=blot_error::Error.none {return blot_support::none<DictionaryGiven>(),err;}let arguments=self.types.node(root);if arguments.tag!=blot_check_types::Tag.product || arguments.b!=contract.parameters.len {return blot_support::none<DictionaryGiven>(),blot_error::Error.type_mismatch;}let old=equation_type_ids.alloc_slice(contract.variables.len);for value,index in self.types.list(contract.variables) {old[index]=value;}let old_rows=equation_type_ids.alloc_slice(contract.row_variables.len);for value,index in self.types.list(contract.row_variables) {old_rows[index]=value;}let fresh=equation_type_ids.alloc_slice(old.len);let rows=equation_type_ids.alloc_slice(old_rows.len);let patterns=equation_type_ids.alloc_slice(contract.parameters.len);for value,index in self.types.list(contract.parameters) {patterns[index]=value;}let actual=equation_type_ids.alloc_slice(arguments.b);for value,index in self.types.list(blot_check_types::List{arguments.a,arguments.b}) {actual[index]=value;}let declared=contract_member_runs.alloc_slice(contract.members.len);for member,index in self.contract_members[contract.members.start..contract.members.start+contract.members.len] {declared[index]=member;}let members=equation_type_ids.alloc_slice(declared.len);let result,error=dictionaryGivenMembers(self,given,old,old_rows,fresh,rows,patterns,actual,declared,members);equation_type_ids.free_slice(members);contract_member_runs.free_slice(declared);equation_type_ids.free_slice(actual);equation_type_ids.free_slice(patterns);equation_type_ids.free_slice(rows);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old_rows);equation_type_ids.free_slice(old);if error!=blot_error::Error.none {return blot_support::none<DictionaryGiven>(),error;}found=blot_support::some(result);}return found,blot_error::Error.none;}
fn dictionaryGivenMembers(self:Engine&,given:Engine_dictionary_givens,old:const u32[:],old_rows:const u32[:],fresh:u32[:],rows:u32[:],patterns:const u32[:],actual:const u32[:],declared:const ContractMember[:],members:u32[:])->DictionaryGiven,blot_error::Error {for &variable in fresh {let root,err=self.types.fresh();if err!=blot_error::Error.none {return DictionaryGiven{},err;}variable=root;}for &row in rows {let root,err=self.types.freshEffects();if err!=blot_error::Error.none {return DictionaryGiven{},err;}row=root;}for parameter,index in patterns {let root,err=self.types.substituteWithRows(parameter,old,fresh,old_rows,rows);if err!=blot_error::Error.none {return DictionaryGiven{},err;}let err=self.types.unify(root,actual[index]);if err!=blot_error::Error.none {return DictionaryGiven{},err;}}for member,index in declared {var root:u32=0;if member.kind==blot_reuse_principal_interface::ContractMemberKind.value {let substituted,err=self.types.substituteWithRows(member.root,old,fresh,old_rows,rows);if err!=blot_error::Error.none {return DictionaryGiven{},err;}let resolved,err=self.types.resolve(substituted,0);if err!=blot_error::Error.none {return DictionaryGiven{},err;}root=resolved;}members[index]=root;}let arguments,err=self.types.saveList(actual);if err!=blot_error::Error.none {return DictionaryGiven{},err;}let member_types,err=self.types.saveList(members);if err!=blot_error::Error.none {return DictionaryGiven{},err;}return DictionaryGiven{opening:given.opening,introduction:given.introduction,quantifier:given.quantifier,goal:given.goal,arguments:arguments,member_types:member_types},blot_error::Error.none;}
fn Engine::packageProjection(self:Engine&,root:u32,arguments:const u32[:],equations:PackEquations,source:u32)->u32,blot_error::Error {let projection=self.types.node(root);let member=self.types.projectionMember(projection);for selection in self.dictionary_selections[equations.selections.start..equations.selections.start+equations.selections.len] {let err=self.inferenceTransition();if err!=blot_error::Error.none {return 0,err;}if selection.source!=equations.source || selection.quantifier!=equations.quantifier {return 0,blot_error::Error.type_mismatch;}let written=self.types.quantifierGoals(equations.quantifier)[selection.goal];if written.kind!=blot_check_types::ObligationKind.contract || written.identity.unit!=projection.a || written.identity.decl!=projection.b {continue;}let goal,err=self.types.substituteGoal(written,equations.binders,equations.witnesses);if err!=blot_error::Error.none {return 0,err;}let tuple=self.types.node(self.types.head(goal.ty,0));if tuple.tag!=blot_check_types::Tag.product || tuple.b!=arguments.len {continue;}let required=equation_type_ids.alloc_slice(tuple.b);for value,index in self.types.list(blot_check_types::List{tuple.a,tuple.b}) {required[index]=value;}let same,error=contractArgumentsEqualBody(self,required,arguments,true);equation_type_ids.free_slice(required);if error!=blot_error::Error.none {return 0,error;}if !same {continue;}match selection.proof {DictionaryProof.given payload=>{return self.types.projection(Identity{projection.a,projection.b},member,arguments);},DictionaryProof.selected payload=>{let selected=self.selectedMember(payload.value,member);if !selected.present || selected.value.kind!=blot_reuse_principal_interface::ImplementationMemberKind.type_ {break;}return self.types.resolve(selected.value.root,0);},}}return self.diagnosticFresh(Code.package_witness_mismatch,source);}
fn Engine::checkPackagePack(self:Engine&,id:u32)->u32,blot_error::Error {let node=self.tree.node(id);let details=self.tree.extra.items[node.c..node.c+2];let required,err=self.annotation(details[1]);if err!=blot_error::Error.none {return 0,err;}let root,err=self.types.resolve(required,0);if err!=blot_error::Error.none {return 0,err;}let package=self.types.node(root);if package.tag!=blot_check_types::Tag.existential {return self.diagnosticFresh(Code.package_expected,details[1]);}if package.c!=node.b {let err=self.diagnostic(Code.package_witness_mismatch,id);return required,err;}let binders=equation_type_ids.alloc_slice(package.c);for value,index in self.types.list(blot_check_types::List{package.b,package.c}) {binders[index]=value;}var witnesses=IdBuffer{};var probe=AssociatedMemo{package_probe:true};var active=IdBuffer{};let result,error=packagePackWitnesses(self,id,node,details,required,package,binders,witnesses,probe,active);active.deinit(equation_type_ids);probe.deinit();witnesses.deinit(equation_type_ids);equation_type_ids.free_slice(binders);return result,error;}
fn packagePackWitnesses(self:Engine&,id:u32,node:blot_parse_ast::Node,details:const u32[:],required:u32,package:blot_check_types::Node,binders:const u32[:],witnesses:IdBuffer&,probe:AssociatedMemo&,active:IdBuffer&)->u32,blot_error::Error {var work=blot_check_usage_check::Work{};for witness in self.tree.list(blot_parse_ast::List{node.a,node.b}) {let ty,err=self.annotation(witness);if err!=blot_error::Error.none {return 0,err;}self.expr_types[witness]=ty;let usage,err=blot_check_usage_check::containsNominalWork(self.types,self.nominals,ty,work);if err!=blot_error::Error.none {return 0,err;}if usage {let err=self.diagnostic(Code.usage_evidence_mismatch,witness);if err!=blot_error::Error.none {return 0,err;}}let err=witnesses.append(ty);if err!=blot_error::Error.none {return 0,err;}}let body,err=self.types.substitute(package.a,binders,witnesses.items);if err==blot_error::Error.type_mismatch {let err=self.diagnostic(Code.package_witness_mismatch,id);return required,err;}if err!=blot_error::Error.none {return 0,err;}var expected=body;if self.types.has_projections {let normalized,err=self.normalizeAssociatedNode(body,id,false,probe,active,0);if err!=blot_error::Error.none {return 0,err;}expected=normalized;}let value,err=self.contextualLambda(details[0],expected);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(value,expected,details[0]);if err!=blot_error::Error.none {return 0,err;}let start=self.dictionary_selections.len;let goals=equation_values.alloc_slice(self.types.quantifierGoals(required).len);for value,index in self.types.quantifierGoals(required) {goals[index]=value;}let error=packagePackGoals(self,id,required,binders,witnesses.items,goals);equation_values.free_slice(goals);if error!=blot_error::Error.none {return 0,error;}if self.types.has_projections {var equations=AssociatedMemo{package:blot_support::some(PackEquations{source:id,quantifier:required,selections:blot_check_types::List{start:start as u32,len:self.dictionary_selections.len as u