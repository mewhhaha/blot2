fn Walker::physicalField(self:Walker&,goal:blot_check_core::Obligation,depth:i64)->bool,Error {let owner=self.module.types.node(goal.ty);if owner.tag==blot_check_types::Tag.record {for ordinal in 0..owner.b {let error=self.step(depth);if error!=Error.none {return false,error;}if self.module.types.recordField(owner,ordinal).name==goal.name {return true,Error.none;}}return false,Error.none;}if owner.tag!=blot_check_types::Tag.nominal || blot_check_storage_types::identity(owner.a,owner.b).present {return false,Error.none;}for method in self.module.associated {let error=self.step(depth);if error!=Error.none {return false,error;}if method.identity.unit==owner.a && method.identity.decl==owner.b && method.member==goal.name {return false,Error.none;}}for constructor in self.module.constructors {let error=self.step(depth);if error!=Error.none {return false,error;}let family=self.module.nominals[constructor.nominal];if family.identity.unit!=owner.a || family.identity.decl!=owner.b || family.constructors.len!=1 {continue;}let payload=self.module.types.node(constructor.payload);if payload.tag!=blot_check_types::Tag.record {continue;}for ordinal in 0..payload.b {let error=self.step(depth);if error!=Error.none {return false,error;}if self.module.types.recordField(payload,ordinal).name==goal.name {return true,Error.none;}}}return false,Error.none;}
fn Walker::prerequisiteGoal(self:Walker&,goal:blot_check_core::Obligation,depth:i64)->bool,Error {return self.prerequisiteGoalMode(goal,depth,true);}
fn Walker::prerequisiteGoalMode(self:Walker&,goal:blot_check_core::Obligation,depth:i64,shared:bool)->bool,Error {let prior_row=self.body_row;var signature=goal.signature;if goal.kind==blot_check_types::ObligationKind.resolver_dispatch {signature=goal.other;}if signature!=0 {let arrow=self.module.types.node(signature);if arrow.tag!=blot_check_types::Tag.function {return false,Error.invalid_artifact;}self.body_row=arrow.c;}let given,error=self.goalGivenMode(goal,depth+1,shared);if error!=Error.none || given {self.body_row=prior_row;return given,error;}let closed,error=self.closedGoal(goal,depth+1);self.body_row=prior_row;return closed,error;}

fn Walker::goalRows(self:Walker&,signature:u32,arity:blot_support::Option<i64>,depth:i64)->Error {var cursor=signature;var count:i64=0;while (!arity.present || count<arity.value) && cursor!=0 && self.module.types.node(cursor).tag==blot_check_types::Tag.function {let error=self.step(depth+count);if error!=Error.none {return error;}let arrow=self.module.types.node(cursor);let error=self.allowedRow(arrow.c,true);if error!=Error.none {return error;}cursor=arrow.b;count+=1;}return require(count!=0 && (!arity.present || count==arity.value));}
fn Walker::goalArity(self:Walker&,kind:blot_check_types::ObligationKind,signature:u32)->blot_support::Option<i64> {let arrow=self.module.types.node(signature);if arrow.tag==blot_check_types::Tag.function && arrow.a==blot_check_types::unit && arrow.b==blot_check_types::unit {return blot_support::some(1 as i64);}match kind {blot_check_types::ObligationKind.dispatch=>{return blot_support::some(2 as i64);},blot_check_types::ObligationKind.field,blot_check_types::ObligationKind.receiver,blot_check_types::ObligationKind.result_dispatch=>{return blot_support::some(1 as i64);},_=>{return blot_support::none<i64>();},}}
fn Walker::canonicalCallee(self:Walker&,identity:blot_check_types::NominalIdentity,types:const blot_check_core::Types&,public:u32)->blot_check_types::NominalIdentity,Error {let selected,error=self.target(blot_check_core::BindingRef{unit:identity.unit,binding:identity.decl});if error!=Error.none {return blot_check_types::NominalIdentity{},error;}let owner .= selected;var binding=identity.decl;var forwards:i64=0;while true {let error=self.step(forwards);if error!=Error.none {return blot_check_types::NominalIdentity{},error;}if binding==0 || binding>=owner.bindings.len || public>=types.nodes.len {return blot_check_types::NominalIdentity{},Error.invalid_artifact;}let declaration=owner.binding(binding);let pack=types.node(public);if pack.tag!=blot_check_types::Tag.product || pack.b!=declaration.public_variables.len+declaration.public_rows.len {return blot_check_types::NominalIdentity{},Error.invalid_artifact;}if declaration.kind!=blot_check_core::BindingKind.external {if declaration.kind!=blot_check_core::BindingKind.global || owner.body(binding)==null {return blot_check_types::NominalIdentity{},Error.invalid_artifact;}let error=sourceBody(owner,binding,self.context,self.admission);if error!=Error.none {return blot_check_types::NominalIdentity{},error;}return blot_check_types::NominalIdentity{unit:owner.unit,decl:binding},Error.none;}var target=declaration.target;if target.unit==0 {target.unit=owner.unit;}let selected,error=self.target(target);if error!=Error.none {return blot_check_types::NominalIdentity{},error;}let next .= selected;if target.binding==0 || target.binding>=next.bindings.len {return blot_check_types::NominalIdentity{},Error.invalid_artifact;}let imported=next.binding(target.binding);if declaration.public_variables.len!=imported.public_variables.len || declaration.public_rows.len!=imported.public_rows.len {return blot_check_types::NominalIdentity{},Error.invalid_artifact;}owner .= next;binding=target.binding;forwards+=1;}}
fn Walker::goalHeaderCandidate(self:Walker&,wanted,given)->bool,Error {if self.admission.source_bodies && wanted.kind==blot_check_types::ObligationKind.callee_use && given.kind==blot_check_types::ObligationKind.callee_use && wanted.identity!=given.identity {return true,Error.none;}if wanted.kind==given.kind && wanted.name==given.name && wanted.operator==given.operator && wanted.identity==given.identity {return true,Error.none;}let error=self.step(0);return false,error;}
fn Walker::goalMatches(self:Walker&,proof:Principal&,wanted_original,given_original,covariant_signature:bool)->bool,Error {let error=self.step(0);if error!=Error.none {return false,error;}var wanted=wanted_original;var given=given_original;if self.admission.source_bodies && wanted.kind==blot_check_types::ObligationKind.callee_use && given.kind==blot_check_types::ObligationKind.callee_use && wanted.identity!=given.identity {let identity,error=self.canonicalCallee(wanted.identity,proof.left,wanted.ty);if error!=Error.none {return false,error;}wanted.identity=identity;let identity,error=self.canonicalCallee(given.identity,proof.right,given.ty);if error!=Error.none {return false,error;}given.identity=identity;}proof.foreign_views=false;if wanted.kind!=given.kind || wanted.name!=given.name || wanted.operator!=given.operator || wanted.identity!=given.identity {return false,Error.none;}let solver .= self.scopes.solver;var point=default<blot_check_types::Mark>();var type_epoch:u64=0;var effect_epoch:u64=0;var physical_epoch:u64=0;if solver {point=solver.store.mark();type_epoch=solver.store.mutation_epoch;effect_epoch=solver.store.effects.mutation_epoch;physical_epoch=solver.store.effects.physical_epoch;}let accepted=goalCompare(proof,wanted,given,covariant_signature);if !accepted && solver {let unchanged=!solver.oom && type_epoch!=0xffffffffffffffff && effect_epoch!=0xffffffffffffffff && physical_epoch!=0xffffffffffffffff && solver.store.mutation_epoch==type_epoch && solver.store.effects.mutation_epoch==effect_epoch && solver.store.effects.physical_epoch==physical_epoch && point==solver.store.mark();if !unchanged {solver.rollback(point);}}return accepted,Error.none;}
fn goalCompare(proof:Principal&,wanted,given,covariant_signature:bool)->bool {let lefts=[wanted.ty,wanted.other,wanted.result];let rights=[given.ty,given.other,given.result];for index in 0..3 {let left=lefts[index];let right=rights[index];if left==0 || right==0 {if left!=right {return false;}}else {let error=proof.validate(left,right);if error!=Error.none {return false;}}}if wanted.signature!=0 && given.signature!=0 {let left=proof.left.node(wanted.signature);let right=proof.right.node(given.signature);if left.tag==blot_check_types::Tag.function && left.a==blot_check_types::unit && left.b==blot_check_types::unit && right.tag==blot_check_types::Tag.function {if proof.rows(left.c,right.c)!=Error.none {return false;}}else {proof.foreign_views=covariant_signature;if proof.validate(wanted.signature,given.signature)!=Error.none {return false;}}}return true;}
fn Walker::reachableHeader(self:Walker&,initial:const Module&,binding:u32,wanted:blot_check_core::Obligation,depth:i64)->bool,Error {let solver .= self.scopes.solver;if !solver {return true,Error.none;}let cache .= self.context.source_proofs;if cache && cache.owns(initial) {let result,error=cache.possibleHeader(initial,binding,wanted,depth,self.scopes.remaining);if error!=Error.none {return false,solver.readerError(error);}return result,Error.none;}let origin .= self.origin;let root .= self.module;if origin {root .= origin;}let result,error=reachableHeaderMetadata(catalog(self.context),root,initial,binding,wanted,depth,self.scopes.remaining);if error!=Error.none {return false,solver.readerError(error);}return result,Error.none;}
recursive fn Walker::sharedDataPrefix(self:Walker&,solver:blot_check_scheme_equations::Solver&,root:u32,work:i64&)->bool,Error {if work==0 || root==0 || root>=solver.prefix_nodes {return false,Error.none;}work-=1;let error=solver.step();if error!=Error.none {return false,error;}let node=solver.store.node(root);match node.tag {blot_check_types::Tag.unit,blot_check_types::Tag.boolean,blot_check_types::Tag.unsigned32,blot_check_types::Tag.floating32,blot_check_types::Tag.never=>{return true,Error.none;},blot_check_types::Tag.array,blot_check_types::Tag.list,blot_check_types::Tag.cursor=>{return self.sharedDataPrefix(solver,node.a,work);},blot_check_types::Tag.product=>{for child in solver.store.list(List{start:node.a,len:node.b}) {let valid,error=self.sharedDataPrefix(solver,child,work);if error!=Error.none || !valid {return false,error;}}return true,Error.none;},blot_check_types::Tag.record=>{for index in 0..node.b {let valid,error=self.sharedDataPrefix(solver,solver.store.recordField(node,index).ty,work);if error!=Error.none || !valid {return false,error;}}return true,Error.none;},blot_check_types::Tag.nominal=>{let arguments=solver.store.nominalArguments(node);for child in arguments {let valid,error=self.sharedDataPrefix(solver,child,work);if error!=Error.none || !valid {return false,error;}}if blot_check_storage_types::identity(node.a,node.b).present {return arguments.len==1,Error.none;}if arguments.len!=0 {return false,Error.none;}for nominal,index in self.module.nominals {if nominal.identity.unit!=node.a || nominal.identity.decl!=node.b {continue;}if nominal.private || nominal.is_opaque || nominal.variables.len!=0 || nominal.parameters.len!=0 || nominal.constructors.len==0 {return false,Error.none;}for constructor in self.module.constructors {if constructor.nominal!=index || constructor.payload==0 {continue;}let valid,error=self.sharedDataPrefix(solver,constructor.payload,work);if error!=Error.none || !valid {return false,error;}}return true,Error.none;}return false,Error.none;},_=>{return false,Error.none;},}}
fn Walker::sharedRowPrefix(self:Walker&,solver:blot_check_scheme_equations::Solver&,row:u32,work:i64&)->bool,Error {if work==0 || row>=solver.prefix_rows {return false,Error.none;}work-=1;let error=solver.step();if error!=Error.none {return false,error;}if solver.store.row(row).tail!=blot_check_effects::Tail.closed {return false,Error.none;}for label in solver.store.rowLabels(row) {if label>=solver.prefix_operations {return false,Error.none;}let operation=solver.store.operations.items[label];if operation.instance.unit!=0 || operation.instance.decl!=0 || label!=blot_check_types::foreign_operation {return false,Error.none;}for argument in solver.store.list(operation.arguments) {let valid,error=self.sharedDataPrefix(solver,argument,work);if error!=Error.none || !valid {return false,error;}}}return true,Error.none;}
fn Walker::sharedGoalKey(self:Walker&,solver:blot_check_scheme_equations::Solver&,owner:const Module&,binding:u32,given:blot_check_core::Obligation)->blot_support::Option<blot_check_scheme_equations::SharedGoal>,Error {let declaration=owner.binding(binding);if !self.admission.source_bodies || declaration.scheme.generative.len!=0 || self.scope_owner!=null || self.handled_count!=0 || declaration.public_variables.len+declaration.public_rows.len>128 {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),Error.none;}let product=solver.store.node(given.ty);let ambient,error=solver.resolveRow(self.body_row);if error!=Error.none {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),error;}var origin=blot_support::none<Module>();let source .= self.origin;if source {origin=blot_support::some(source);}var key=blot_check_scheme_equations::SharedGoal{producer:owner,origin:origin,binding:binding,call_owner:self.call_owner,resolver_callback:self.resolver_callback,goal_depth:self.goal_depth,ambient:ambient,foreign_allowed:self.foreign_allowed,type_count:declaration.public_variables.len as u8,row_count:declaration.public_rows.len as u8};var work:i64=256;let valid,error=self.sharedRowPrefix(solver,key.ambient,work);if error!=Error.none || !valid {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),error;}for index in 0..product.b {let actual=solver.store.list(List{start:product.a,len:product.b})[index];if index<declaration.public_variables.len {let root,error=solver.resolve(actual);if error!=Error.none {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),error;}let valid,error=self.sharedDataPrefix(solver,root,work);if error!=Error.none || !valid {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),error;}key.arguments[index]=root;}else {let resolved,error=solver.resolve(actual);if error!=Error.none {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),error;}let carrier=solver.store.node(resolved);if carrier.tag!=blot_check_types::Tag.function || carrier.a!=blot_check_types::unit || carrier.b!=blot_check_types::unit {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),Error.none;}let row,error=solver.resolveRow(carrier.c);if error!=Error.none {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),error;}let valid,error=self.sharedRowPrefix(solver,row,work);if error!=Error.none || !valid {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),error;}key.arguments[index]=row;}}let eligible,error=solver.sharedAuthority(self.scopes);if error!=Error.none || !eligible {return blot_support::none<blot_check_scheme_equations::SharedGoal>(),error;}return blot_support::some(key),Error.none;}
