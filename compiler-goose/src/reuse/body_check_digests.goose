 binding=>{ return typeHash(source,node.a,hash,budget,depth+1,false,variables,[],catalog); },tuple,array=>{ hashWord(hash,node.b); for child in patterns.list(List {node.a,node.b}) { if !patternHash(source,patterns,child,variables,catalog,hash,depth+1,budget) { return false; } } },record=>{ hashWord(hash,node.b); for index in 0..node.b { let field=patterns.field(node,index); let name=catalog.pool.get(field.name); if name.len==0 { return false; } hashWord(hash,name.len); hash.update(name); if !patternHash(source,patterns,field.pattern,variables,catalog,hash,depth+1,budget) { return false; } } }, } return true;
