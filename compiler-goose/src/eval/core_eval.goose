fn setSourceRoot(self: ClosureRegion&,scope: u32,root: u32) { self.scratch.sources[scope].root=root; }
fn callableScope(self: ClosureRegion&,target: Target) -> u32,Error { let observed=observePrincipalSource(self.session,target.unit,target.binding); if observed!=Error.none { return 0,observed; } let module=self.session.units[target.unit]; let body=module.body(target.binding); if body==null { return 0,Error.unresolved_type; } let scope,error=typeScope(self,target.unit); if error!=Error.none { return 0,error; } self.scratch.sources[scope].body=body.root; self.scratch.sources[scope].closed_rows=body.closed_rows; let imported,e=importImplementation(self,scope,module.binding(target.binding).ty); if e!=Error.none { return 0,e; } setSourceRoot(self,scope,imported); self.scratch.sources[scope].binding=target.binding; if !self.building_principal||scope==0 { let required=importScheme(self,scope,body.scheme,body.root); if required!=Error.none { return 0,required; } } return scope,Error.none; }
