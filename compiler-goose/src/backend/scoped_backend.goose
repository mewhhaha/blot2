        identity=>{ return args[0],blot_error::Error.none; },
        convert=>{ let count,error = length(self_,module,id,args[0]); if error != blot_error::Error.none { return Value {..},error; } let result,result_error = array(self_,module,id,count,blot_runtime_data_stacks::Mode.fixed); if result_error != blot_error::Error.none { return Value {..},result_error; } let copied = copyRange(self_,module,id,result,zero,args[0],zero,count); if copied != blot_error::Error.none { return Value {..},copied; } return result,blot_error::Error.none; },
        cursor=>{ var result = args[0]; result.tag = ValueTag.view; result.type_evidence = blot_support::none<u32>(); let zero,error = constant(self_,0); if error != blot_error::Error.none { return Value {..},error; } result.index = zero.word; let count,count_error = length(self_,module,id,args[0]); if count_error != blot_error::Error.none { return Value {..},count_error; } result.length = count; return result,blot_error::Error.none; },
        cursor_has=>{ if args[0].tag != ValueTag.view { return Value {..},unsupported(self_,module,id); } var out = blot_emitter::Emitter<blot_backend_wasm::Module> { code: self_.c , ..}; let result = out.temp(); out.value(args[0].index); out.value(args[0].length); out.op(blot_backend_runtime_ir::OP_i32_lt_u); out.set(result); if out.failure != blot_error::Error.none { return Value {..},out.failure; } return Value { word: result , ..},blot_error::Error.none; },
        cursor_value=>{ if args[0].tag != ValueTag.view { return Value {..},unsupported(self_,module,id); } var out = blot_emitter::Emitter<blot_backend_wasm::Module> { code: self_.c , ..}; out.value(args[0].index); out.value(args[0].length); out.op(blot_backend_runtime_ir::OP_i32_ge_u); out.trap(); if out.failure != blot_error::Error.none { return Value {..},out.failure; } return readElement(self_,module,id,args[0],args[0].index); },
        cursor_advance=>{ if args[0].tag != ValueTag.view { return Value {..},unsupported(self_,module,id); } var result = args[0]; var out = blot_emitter::Emitter<blot_backend_wasm::Module> { code: self_.c , ..}; out.value(result.index); out.value(result.length); out.op(blot_backend_runtime_ir::OP_i32_ge_u); out.trap(); result.index = out.temp(); out.value(args[0].index); out.value(1); out.op(blot_backend_runtime_ir::OP_i32_add); out.set(result.index); if out.failure != blot_error::Error.none { return Value {..},out.failure; } return result,blot_error::Error.none; },
        fill,generate=>{
            let count,error = scalar(self_,module,id,args[0]); if error != blot_error::Error.none { return Value {..},error; } let result,result_error = array(self_,module,id,count,blot_runtime_data_stacks::Mode.fixed); if result_error != blot_error::Error.none { return Value {..},result_error; } let read_frame,frame_error = beginReadFrame(self_); if frame_error != blot_error::Error.none { return Value {..},frame_error; }
            recursive fn fillRows() -> Value,Error { var out = blot_emitter::Emitter<blot_backend_wasm::Module> { code: self_.c , ..}; let index = out.temp(); out.set(index,0); out.loopStart(); if out.failure != blot_error::Error.none { return Value {..},out.failure; } self_.nesting += 2; out.value(index); out.value(count); out.op(blot_backend_runtime_ir::OP_i32_ge_u); out.op(blot_backend_runtime_ir::OP_br_if,1); if out.failure != blot_error::Error.none { return Value {..},out.failure; } var value = args[1]; if op == blot_backend_collection_ops::Op.generate { let applied,error = apply(self_,module,id,args[1],Value { word: index , ..},depth + 1); if error != blot_error::Error.none { return Value {..},error; } value = applied; } if !value.terminated { let written = writeElement(self_,module,id,result,blot_support::some(index),value); if written != blot_error::Error.none { return Value {..},written; } } let checked = checkReadFrame(self_,module,id,read_frame); if checked != blot_error::Error.none { return Value {..},checked; } out.next(index); out.op(blot_backend_runtime_ir::OP_br); out.end(); out.end(); if out.failure != blot_error::Error.none { return Value {..},out.failure; } self_.nesting -= 2; return result,blot_error::Error.none; }
            let filled,filled_error = fillRows(); self_.read_frames.resize(read_frame); return filled,filled_error;
