fn finite(value: f64) -> bool {return (blot_native::f64_bits(value) & 9218868437227405312) != 9218868437227405312;}
fn integral(value: f64) -> bool {let bits = blot_native::f64_bits(value) & 9223372036854775807;let exponent = ((bits >> 52) & 2047) as i64 - 1023;if exponent < 0 {return bits == 0;}if exponent >= 52 {return exponent != 1024;}return (bits & ((1 as u64 << (52 - exponent)) - 1)) == 0;}
fn negative(value: f64) -> bool {return (blot_native::f64_bits(value) >> 63) != 0;}
fn float32(out: u8[>..<]&,value: f64) {
    let rounded = value as! f32;var magnitude = rounded as f64;let sign = (blot_native::f32_bits(rounded) >> 31) != 0;if sign {magnitude = -magnitude;out.append("(-");}var raw: u8[>..] = [];format(raw,magnitude);var digits: u8[>..<] = [];var point: i64 = -1;var at: i64 = 0;
    while at < raw.len && raw[at] != 'e' && raw[at] != 'E' {if raw[at] == '.' {point = digits.len;}else {digits.push(raw[at]);}at++;}if point < 0 {point = digits.len;}var exponent: i64 = 0;var exponent_sign = false;if at < raw.len {at++;if at < raw.len && (raw[at] == '+' || raw[at] == '-') {exponent_sign = raw[at] == '-';at++;}while at < raw.len {exponent = exponent * 10 + (raw[at] - '0') as i64;at++;}if exponent_sign {exponent = -exponent;}}
    var first: i64 = 0;while first + 1 < digits.len && digits[first] == '0' {first++;point--;}var last = digits.len;while last > first + 1 && digits[last - 1] == '0' {last--;}let scientific = magnitude >= 1e21 || (magnitude != 0.0 && magnitude < 1e-6);let decimal_point = point + exponent;let selected = digits[first..last];
    if scientific {out.push(selected[0]);if selected.len > 1 {out.push('.');out.append(selected[1..]);}out.push('e');let scale = decimal_point - 1;if scale >= 0 {out.push('+');}format(out,scale);}
    else if decimal_point <= 0 {out.append("0.");for index in 0..-decimal_point {out.push('0');}out.append(selected);}
    else {for index in 0..decimal_point {if index < selected.len {out.push(selected[index]);}else {out.push('0');}}out.push('.');if decimal_point < selected.len {out.append(selected[decimal_point..]);}else {out.push('0');}}
    if sign {out.push(')');}
}
fn hexDigit(byte: u8) -> u32,bool {if byte >= '0' && byte <= '9' {return (byte - '0') as u32,true;}if byte >= 'a' && byte <= 'f' {return (byte - 'a' + 10) as u32,true;}if byte >= 'A' && byte <= 'F' {return (byte - 'A' + 10) as u32,true;}return 0,false;}
// The WGSL caller validates separators before removing them. Bare integers
