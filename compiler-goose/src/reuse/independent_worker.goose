// Independent proof workers reconstruct complete local source admission.
namespace blot_reuse_independent_call_proof;
import eval.worker_packet;
import eval.semantic_parallel;
import eval.semantic_job_batch;
import eval.core_eval;
import eval.type_evidence;
import support.evidence_packet;
import support.error;
import support.option;
import support.native;
import phase_profile;
import reuse.code_artifacts;
import reuse.principal_reuse_gate;
import backend.runtime_identity;
type PacketWriter=blot_eval_worker_packet::Writer;
type PacketReader=blot_eval_worker_packet::Reader;
struct IndependentPacketContext<S,G> { state: S&,g: G& }
fn encode<S,G>(context: IndependentPacketContext<S,G>&,request: blot_eval_semantic_parallel::Request) -> u8[>..],Error { var bytes: u8[>..]=[]; var writer=PacketWriter {bytes, ..}; blot_eval_worker_packet::put(writer,0x494e4451 as u32); blot_eval_worker_packet::put(writer,1 as u32); let state .= context.state; let g .= context.g; if !state.old.metadata.pools.present||!state.gate.validation_names.present { return bytes,blot_error::Error.declined; } let pools: const blot_reuse_code_artifacts::Pools& =state.old.metadata.pools.value; if !pools.identity.present { return bytes,blot_error::Error.declined; }
 blot_eval_worker_packet::writeCatalog(writer,pools.modules); blot_eval_worker_packet::writeCatalog(writer,g.evaluator.units); blot_eval_worker_packet::writeIdentity(writer,pools.identity.value.view()); blot_eval_worker_packet::writeIdentity(writer,state.gate.validation_names.value); blot_eval_worker_packet::writeEvidence(writer,pools.evaluator.evidence.view()); blot_eval_worker_packet::writeEvidence(writer,g.evaluator.evidenceView()); blot_eval_worker_packet::writeRecords(writer,state.old.metadata.independent_calls.items); blot_eval_worker_packet::writeRecords(writer,recordsView(state.completed_worker_proofs)); blot_eval_worker_packet::put(writer,g.evaluator.options); blot_eval_worker_packet::put(writer,g.evaluator.depth); blot_eval_worker_packet::writeSeeds(writer,g.evaluator); blot_eval_worker_packet::put(writer,request); return bytes,writer.failure;
}
fn decode<S,G>(context: IndependentPacketContext<S,G>&,bytes: const u8[:]) -> blot_eval_semantic_parallel::Result,Error { var reader=PacketReader {bytes, ..}; var signature: u32=0; var version: u32=0; blot_eval_worker_packet::get(reader,signature); blot_eval_worker_packet::get(reader,version); if reader.failure!=blot_error::Error.none||signature!=0x494e4452||version!=1 { return blot_eval_semantic_parallel::Result {..},blot_error::Error.invalid_artifact; } var result=blot_eval_semantic_parallel::Result {..}; var present=false; blot_eval_worker_packet::get(reader,present); if present { result.record=blot_support::some(blot_eval_worker_packet::readRecord(reader)); } blot_eval_worker_packet::get(reader,result.counts); if reader.failure!=blot_error::Error.none||reader.at!=reader.data.len { if result.record.present { result.record.value.deinit(); } if reader.failure!=blot_error::Error.none { return blot_eval_semantic_parallel::Result {..},reader.failure; } return blot_eval_semantic_parallel::Result {..},blot_error::Error.invalid_artifact; } return result,blot_error::Error.none; }
fn runParallel<S,G>(state: S&,g: G&,requests: const blot_eval_semantic_parallel::Request[:],requested: u8,owned_requests: blot_eval_semantic_parallel::Requests&,owned_slots: blot_eval_semantic_parallel::Slots&,outcomes: blot_eval_semantic_parallel::Outcomes&) -> blot_eval_semantic_parallel::Batch,Error { var context=IndependentPacketContext<S,G> {state,g, ..}; return blot_eval_semantic_parallel::run<IndependentPacketContext<S,G>>(requests,requested,context,owned_requests,owned_slots,outcomes); }
struct PacketMetadata { pools: blot_support::Option<blot_reuse_code_artifacts::Pools>,independent_calls: const Record[:] }
struct PacketOld { metadata: PacketMetadata& }
struct PacketState { old: PacketOld,gate: blot_reuse_principal_reuse_gate::Gate,completed_worker_proofs: const Record[:],stats: blot_eval_semantic_parallel::Counts=blot_eval_semantic_parallel::Counts {..} }
struct PacketGenerator { evaluator: blot_eval_core_eval::Session& }
struct IndependentRequest { old: blot_eval_worker_packet::Catalog=blot_eval_worker_packet::Catalog {..},current: blot_eval_worker_packet::Catalog=blot_eval_worker_packet::Catalog {..},old_identity: blot_eval_worker_packet::Identity=blot_eval_worker_packet::Identity {..},current_identity: blot_eval_worker_packet::Identity=blot_eval_worker_packet::Identity {..},old_evidence: blot_evidence_packet::OwnedSnapshot,current_evidence: blot_evidence_packet::OwnedSnapshot,old_records: Record[:]=default<Record[:]>(),completed: Record[:]=default<Record[:]>(),options: blot_eval_core_eval::Options=blot_eval_core_eval::Options {..},depth: i64=0,seeds: blot_eval_worker_packet::ScalarSeed[:]=default<blot_eval_worker_packet::ScalarSeed[:]>(),request: blot_eval_semantic_parallel::Request,result: blot_eval_semantic_parallel::Result=blot_eval_semantic_parallel::Result {..} }
fn releaseRequest(context: IndependentRequest&) { context.old.deinit(); context.current.deinit(); context.old_identity.deinit(); context.current_identity.deinit(); context.old_evidence.deinit(); context.current_evidence.deinit(); blot_eval_worker_packet::releaseRecords(context.old_records); blot_eval_worker_packet::releaseRecords(context.completed); blot_eval_worker_packet::scalar_seeds.free_slice(context.seeds); }
fn readRequest(reader: PacketReader&,context: IndependentRequest&) -> Error { var signature: u32=0; var version: u32=0; blot_eval_worker_packet::get(reader,signature); blot_eval_worker_packet::get(reader,version); if reader.failure!=blot_error::Error.none||signature!=0x494e4451||version!=1 { return blot_error::Error.invalid_artifact; } context.old=blot_eval_worker_packet::readCatalog(reader); if reader.failure!=blot_error::Error.none { return reader.failure; } context.current=blot_eval_worker_packet::readCatalog(reader); if reader.failure!=blot_error::Error.none { return reader.failure; } context.old_identity=blot_eval_worker_packet::readIdentity(reader); if reader.failure!=blot_error::Error.none { return reader.failure; } context.current_identity=blot_eval_worker_packet::readIdentity(reader); if reader.failure!=blot_error::Error.none { return reader.failure; } context.old_evidence=blot_eval_worker_packet::readEvidence(reader); if reader.failure!=blot_error::Error.none { return reader.failure; } context.current_evidence=blot_eval_worker_packet::readEvidence(reader); if reader.failure!=blot_error::Error.none { return reader.failure; } context.old_records=blot_eval_worker_packet::readRecords(reader); if reader.failure!=blot_error::Error.none { return reader.failure; } context.completed=blot_eval_worker_packet::readRecords(reader); if reader.failure!=blot_error::Error.none { return reader.failure; } blot_eval_worker_packet::get(reader,context.options); blot_eval_worker_packet::get(reader,context.depth); context.seeds=blot_eval_worker_packet::readSeeds(reader); if reader.failure!=blot_error::Error.none { return reader.failure; } blot_eval_worker_packet::get(reader,context.request); if reader.failure!=blot_error::Error.none { return reader.failure; } if reader.at!=reader.data.len||context.depth<0||context.current_identity.owners.len!=context.current.modules.len||context.old_identity.owners.len!=context.old.modules.len { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; }
fn executeIndependentPacket(bytes: const u8[:],retained_scratch: i64) -> u8[>..],bool,bool,Error { var reply: u8[>..]=[]; var reader=PacketReader {bytes, ..}; var request=IndependentRequest {old_evidence:blot_evidence_packet::OwnedSnapshot {snapshot:blot_evidence_packet::emptySnapshot(), ..},current_evidence:blot_evidence_packet::OwnedSnapshot {snapshot:blot_evidence_packet::emptySnapshot(), ..},request:blot_eval_semantic_parallel::Request {index:0,read:blot_reuse_specialization_receipt::CallRead {0,0,0,false, ..},actual:0, ..}, ..}; let decoded=readRequest(reader,request); if decoded!=blot_error::Error.none { releaseRequest(request); if decoded==blot_error::Error.out_of_memory { return reply,false,false,decoded; } return reply,false,false,blot_error::Error.none; }
 let old_valid=blot_eval_worker_packet::validate(request.old,blot_support::some(request.old_identity.symbols.len)); let current_valid=blot_eval_worker_packet::validate(request.current,blot_support::some(request.current_identity.symbols.len)); if old_valid!=blot_error::Error.none||current_valid!=blot_error::Error.none { releaseRequest(request); if old_valid==blot_error::Error.out_of_memory||current_valid==blot_error::Error.out_of_memory { return reply,false,false,blot_error::Error.out_of_memory; } return reply,false,false,blot_error::Error.none; } var remaining: i64=0x7fffffffffffffff; let old_goals=request.old_evidence.snapshot.view().validateGoalTablesWithBudget(remaining); let current_goals=request.current_evidence.snapshot.view().validateGoalTablesWithBudget(remaining); if old_goals!=blot_error::Error.none||current_goals!=blot_error::Error.none { releaseRequest(request); return reply,false,false,blot_error::Error.none; }
 let executed=blot_eval_core_eval::withSession<IndependentRequest>(request.current.modules,blot_native::fresh_owner_id(),request,independentSession); if executed!=blot_error::Error.none { if request.result.record.present { request.result.record.value.deinit(); } releaseRequest(request); if executed==blot_error::Error.out_of_memory { return reply,false,false,executed; } return reply,false,false,blot_error::Error.none; } var writer=PacketWriter {reply, ..}; blot_eval_worker_packet::put(writer,0x494e4452 as u32); blot_eval_worker_packet::put(writer,1 as u32); blot_eval_worker_packet::put(writer,request.result.record.present); if request.result.record.present { blot_eval_worker_packet::writeRecord(writer,request.result.record.value); request.result.record.value.deinit(); } blot_eval_worker_packet::put(writer,request.result.counts); releaseRequest(request); if writer.failure!=blot_error::Error.none { return reply,false,false,writer.failure; } return reply,true,false,blot_error::Error.none;
}
fn independentSession(context: IndependentRequest&,session: blot_eval_core_eval::Session&) -> Error { session.options=context.options; session.semantic_io_enabled=false; session.semantic_component_workers=0; session.depth=context.depth; let seeded=blot_eval_worker_packet::seed(session,context.seeds); if seeded!=blot_error::Error.none { return seeded; } let module_pins,error=blot_eval_worker_packet::pin(context.old,context.old_identity); if error!=blot_error::Error.none { return error; } let pools=blot_eval_worker_packet::semanticPools(context.old_identity,module_pins,context.old_evidence); let gate,e=blot_reuse_principal_reuse_gate::init(session.allocation_owner,pools,session.units,blot_support::some(context.current_identity.view())); if e!=blot_error::Error.none { blot_eval_worker_packet::pins.free_slice(module_pins); return e; } var metadata=PacketMetadata {blot_support::some(pools),context.old_records, ..}; var state=PacketState {old:PacketOld {metadata, ..},gate:gate,completed_worker_proofs:context.completed, ..}; var generator=PacketGenerator {session, ..}; let record,e2=acquire(state,generator,context.request.read,context.request.actual); context.result=blot_eval_semantic_parallel::Result {record:canonicalOwned(record),counts:state.stats, ..}; state.gate.deinit(); blot_eval_worker_packet::pins.free_slice(module_pins); return e2; }

// Public independent-proof process dispatcher. Revalidation and private-session
// acquisition are performed by executeIndependentPacket before any result exists.
fn executePacket(bytes:const u8[:],output:u8[>..<]&)->Error {
 let request,telemetry,decoded=blot_eval_semantic_job_batch::unpackRequest(bytes); if decoded!=blot_error::Error.none {return decoded;}
 var installation=blot_phase_profile::beginWorker(telemetry); let reply,present,stopped,error=executeIndependentPacket(request,4194304); let snapshot=installation.finish(); if error!=blot_error::Error.none { return error; }
 return blot_eval_semantic_job_batch::writeResult(output,reply,present,stopped,snapshot);
}
