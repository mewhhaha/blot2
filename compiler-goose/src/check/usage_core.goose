    let owner = self.module.types.node(self.module.types.head(self.module.typeOf(node.a),0)); let parameter = self.module.types.node(self.module.types.head(callback.parameter.ty,0)); if owner.tag != TypeTag.usage || (owner.b != blot_check_types::usageCode(Usage.unique) && owner.b != blot_check_types::usageCode(Usage.borrow_mut) && (node.c != 0 || (owner.b != blot_check_types::usageCode(Usage.shared) && owner.b != blot_check_types::usageCode(Usage.borrow)))) { return Error.invalid_artifact; }
