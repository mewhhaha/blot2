
type Counter is effect = { next: Unit -> U32 }
const count = func computation => return do:
  let current = 0
  for request in @requests computation:
    case request of
      effect Counter.next () =>
        current := @u32.add self 1
        yield current
      complete () =>
        break current
entry const answer = func limit => return count (@computation (func () => return do:
  for index in 0 .. limit:
    use Counter.next ()
  break ()
))

entry const checked_answer = answer 1000
