fn existing(self_: RaggedFacts,reference: BindingRef) -> blot_support::Option<ValueId> { var target=reference; if target.unit==0 { target.unit=unitId(self_.session,self_.owner); } let resolved=blot_check_primitive_operator::resolve(self_.session.units,target); if !resolved.present { return blot_support::none<ValueId>(); } let owner=findUnit(self_.session,resolved.value.unit,blot_support::none<i64>()); if !owner.present { return blot_support::none<ValueId>(); } let stored=slot(self_.session,Target {owner.value,resolved.value.binding}); if stored.state!=State.complete { return blot_support::none<ValueId>(); } return blot_support::some(stored.value); }
