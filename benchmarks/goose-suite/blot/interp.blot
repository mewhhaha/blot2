// Expression-tree evaluation over a sum-type AST arena with direct recursion.
import * as rng from "./rng"

const BENCH_N: U32 = 20 // BENCH_N
const PASSES: U32 = 8
const MOD: U32 = 1000003

type Expr is data = $Num { v: U32 } | $Add { l: U32, r: U32 } | $Mul { l: U32, r: U32 } | $Neg { inner: U32 }

func build_rec (pool: own #[Expr]) -> (d: U32) -> (seed: U64): (#[Expr], U32) =>
  let s = rng.xs_next seed
  if d == 0:
    let idx = pool.length
    pool := self.push ($Num { v: (s % 1000u64).to_u32 })
    return (pool, idx)
  let k = (s & 7u64).to_u32
  let (p1, l) = build_rec pool (d - 1) s
  if k < 1:
    let idx = p1.length
    let p2 = p1.push ($Neg { inner: l })
    return (p2, idx)
  let (p2, r) = build_rec p1 (d - 1) (rng.xs_next s)
  let idx = p2.length
  let p3 = if k < 5 then p2.push ($Add { l, r }) else p2.push ($Mul { l, r })
  return (p3, idx)

func eval_rec (pool: #[Expr]) -> (idx: U32) -> (p: U32): U32 =>
  case pool[idx] of
    $Num { v } => (v + p) % MOD
    $Neg { inner } => (MOD - eval_rec pool inner p) % MOD
    $Add { l, r } => (eval_rec pool l p + eval_rec pool r p) % MOD
    $Mul { l, r } => ((eval_rec pool l p).to_u64 * (eval_rec pool r p).to_u64 % 1000003u64).to_u32

io bench (): #[U32] =>
  let (pool, root) = build_rec (Array.with_capacity (1 << BENCH_N)) BENCH_N 12345u64
  let total: U32 = 0
  for p in 0 .. PASSES:
    total := (self + eval_rec pool root p) % MOD

  let out: #[U32] = #[]
  out := rng.emit_u32 self pool.length
  out := rng.emit_u32 self total
  return out
