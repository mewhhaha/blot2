struct CollectionProof {walker:Walker&}
fn same(self_:CollectionProof,first:u32,second:u32)->Error {return self_.walker.strictSame(first,second);}
fn callback(self_:CollectionProof,row:u32)->Error {return require(self_.walker.scopes.isPure(row) || (self_.walker.foreign_allowed && self_.walker.scopes.isForeign(row)));}
fn collection(self_:CollectionProof,sequence:u32,element:u32)->Error {return self_.walker.collectionSequence(sequence,element);}
