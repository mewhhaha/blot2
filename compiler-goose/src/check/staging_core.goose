fn conditional(self:Named&,id:u32,owner:u32,parameters:const blot_check_core::Parameter[:],closed_rows:List,outer:Locals&,outer_bindings:u32[:],depth:i64)->bool,Error {let node=self.m.node(id);var storage:u32[256][2]=[[0;256];2];let parent .= self.locals;var scopes=[Locals{parent:parent, ..},Locals{parent:parent, ..}];var terminated:bool[2]=[false;2];let branches=[node.b,node.c];let result,error=conditionalValue(self,id,owner,parameters,closed_rows,outer,outer_bindings,depth,parent,storage,scopes,terminated,branches);self.locals .= parent;return result,error;}
