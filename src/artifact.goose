        row.right = get32(bytes, at); at += 4;
        row.third = get32(bytes, at); at += 4;
        row.domain = get32(bytes, at); at += 4;
        row.version = get32(bytes, at); at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.facts.push(row); }
    }
    for index in n_evidence {
        let row_start = at;
        var row = Evidence { .. };
        row.rule = get32(bytes, at); at += 4;
        row.fact = get32(bytes, at); at += 4;
        row.contract = get32(bytes, at); at += 4;
        row.formal_fact = get32(bytes, at); at += 4;
        row.call = get32(bytes, at); at += 4;
        row.scope = get32(bytes, at); at += 4;
        row.edge = get32(bytes, at); at += 4;
        row.operands = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.premises = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.origin = get32(bytes, at); at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.evidence.push(row); }
    }
    for index in n_loops {
        let row_start = at;
        var row = Loop { .. };
        row.header = get32(bytes, at); at += 4;
        row.body = get32(bytes, at); at += 4;
        row.exit = get32(bytes, at); at += 4;
        row.index = get32(bytes, at); at += 4;
        row.lower = get32(bytes, at); at += 4;
        row.upper = get32(bytes, at); at += 4;
        row.carries = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.invariant = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.backedges = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.exits = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.loops.push(row); }
    }
    for index in n_functions {
        let row_start = at;
        var row = Function { .. };
        if get32(bytes, at) > 1 { return invalid(diags, 51); }
        row.evaluator_only = get32(bytes, at) != 0; at += 4;
        row.environment_bindings = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.visibility = get32(bytes, at); at += 4;
        row.name = get32(bytes, at); at += 4;
        row.module = get32(bytes, at); at += 4;
        row.type_id = get32(bytes, at); at += 4;
        row.contract = get32(bytes, at); at += 4;
        row.param = get32(bytes, at); at += 4;
        row.entry = get32(bytes, at); at += 4;
        row.blocks = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.captures = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.calls = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.binders = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.export_id = get32(bytes, at); at += 4;
        row.producer = get32(bytes, at); at += 4;
        row.origin = get32(bytes, at); at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.functions.push(row); }
    }
    for index in n_calls {
        let row_start = at;
        var row = Call { .. };
        row.op = get32(bytes, at); at += 4;
        row.caller = get32(bytes, at); at += 4;
        row.callee = get32(bytes, at); at += 4;
        row.contract = get32(bytes, at); at += 4;
        row.substitutions = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.calls.push(row); }
    }
    for index in n_substitutions {
        let row_start = at;
        var row = Substitution { .. };
        row.binder = get32(bytes, at); at += 4;
        row.kind = get32(bytes, at); at += 4;
        row.value = get32(bytes, at); at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.substitutions.push(row); }
    }
    for index in n_captures {
        let row_start = at;
        var row = Capture { .. };
        row.function = get32(bytes, at); at += 4;
        row.value = get32(bytes, at); at += 4;
        row.local_value = get32(bytes, at); at += 4;
        row.field = get32(bytes, at); at += 4;
        row.scope = get32(bytes, at); at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.captures.push(row); }
    }
    for index in n_loans {
        let row_start = at;
        var row = Loan { .. };
        row.value = get32(bytes, at); at += 4;
        row.owner = get32(bytes, at); at += 4;
        row.scope = get32(bytes, at); at += 4;
        row.kind = get32(bytes, at); at += 4;
        row.begin_op = get32(bytes, at); at += 4;
        row.end_op = get32(bytes, at); at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.loans.push(row); }
    }
    for index in n_transitions {
        let row_start = at;
        var row = Transition { .. };
        row.op = get32(bytes, at); at += 4;
        row.value = get32(bytes, at); at += 4;
        row.before = get32(bytes, at); at += 4;
        row.after = get32(bytes, at); at += 4;
        row.authority = get32(bytes, at); at += 4;
        row.scope = get32(bytes, at); at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.transitions.push(row); }
    }
    for index in n_layouts {
        let row_start = at;
        var row = Layout { .. };
        row.type_id = get32(bytes, at); at += 4;
        row.size = get32(bytes, at); at += 4;
        row.align = get32(bytes, at); at += 4;
        row.flags = get32(bytes, at); at += 4;
        row.abi = get32(bytes, at); at += 4;
        row.schema = get32(bytes, at); at += 4;
        row.fields = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.depth = get32(bytes, at); at += 4;
        row.leaves = get32(bytes, at); at += 4;
        row.guards = get32(bytes, at); at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.layouts.push(row); }
    }
    for index in n_interfaces {
        let row_start = at;
        var row = Interface { .. };
        row.abi_digest = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.function = get32(bytes, at); at += 4;
        row.type_id = get32(bytes, at); at += 4;
        row.contract = get32(bytes, at); at += 4;
        row.dependencies = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.digest = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.producer = get32(bytes, at); at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.interfaces.push(row); }
    }
    for index in n_dependencies {
        let row_start = at;
        var row = Dependency { .. };
        row.query_kind = get32(bytes, at); at += 4;
        row.kind = get32(bytes, at); at += 4;
        row.producer = get32(bytes, at); at += 4;
        row.identity = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.digest = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        if get32(bytes, at) > 1 { return invalid(diags, 51); }
        row.present = get32(bytes, at) != 0; at += 4;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.dependencies.push(row); }
    }
    for index in n_receipts {
        let row_start = at;
        var row = Receipt { .. };
        row.producer = get32(bytes, at); at += 4;
        row.source_digest = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.semantic_digest = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.dependencies = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.completed_visits = get32(bytes, at) as u64 | (get32(bytes, at + 4) as u64 << 32); at += 8;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.receipts.push(row); }
    }
    for index in n_exports {
        let row_start = at;
        var row = Export { .. };
        row.function = get32(bytes, at); at += 4;
        row.name = get32(bytes, at); at += 4;
        row.kind = get32(bytes, at); at += 4;
        row.arg_type = get32(bytes, at); at += 4;
        row.result_type = get32(bytes, at); at += 4;
        row.substitutions = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.fields = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.input_maxima = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        row.output_capacity = get32(bytes, at); at += 4;
        row.work_bytes = get32(bytes, at); at += 4;
        row.frame = get32(bytes, at); at += 4;
        row.depth = get32(bytes, at); at += 4;
        row.abi_digest = Span { get32(bytes, at), get32(bytes, at + 4) }; at += 8;
        if index == 0 { for byte in bytes[row_start..at] { if byte != 0 { return invalid(diags, 52); } } } else { b.exports.push(row); }
    }
    for index in n_refs {
        b.refs.push(get32(bytes, at)); at += 4;
    }
    b.bytes.append(bytes[at..at + n_bytes]);
    // Imported receipts carry observations only. No source admission or encoded executable is trusted.
    b.phase.phase = PHASE_SEALED;
    return true;
}
