fn revise<E>(self:Session,executor:E&,entry:const u8[:],identity:Text,options:Options)->Emission,Error {var preparation,error=self.prepareRevision(executor,entry,identity,options);if error!=Error.none {return Emission{..},error;}match preparation {Preparation.inactive=>{abort("inactive synchronous revision");},Preparation.rejected &payload=>{let result=payload.value.takeResult();preparation=Preparation.inactive;return result,Error.none;},Preparation.ready &payload=>{assert(self.commit(payload.candidate));let result=payload.candidate.takeResult();assert(result.present);payload.candidate.deinit();preparation=Preparation.inactive;return result.value,Error.none;}}}
