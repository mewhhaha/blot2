import .frozen_core_validation;
type Error=blot_error::Error;
type Module=blot_check_core::Module;
type ModuleRef=blot_check_frozen_core_validation::ModuleRef;
type TypeTag=blot_check_types::Tag;
type Tag=blot_check_core::Tag;
type Flow=blot_check_capability_flow::Contract;
struct Fact {arrow:u32,selected:u32,value:u32}
struct Site {point:u32,ordinal:u32,node:u32}
struct Sites {values:Site[4096],len:i64=0}
fn claim(self:Sites&,version:blot_check_types::Node,node:u32)->Error {for site in self.values[..self.len] {if site.point==version.b && site.ordinal==version.c {if site.node!=node {return Error.invalid_artifact;} return Error.none;}} if self.len==self.values.len {return Error.invalid_artifact;} self.values[self.len]=Site{version.b,version.c,node, ..}; self.len+=1; return Error.none;}
struct Scan {module:const Module&,owners:const ModuleRef[:],graph:blot_check_frozen_core_validation::Graph,sites:Sites&,variables:blot_check_types::List,facts:Fact[256],len:i64=0,remaining:i64=65536}
fn ownerModule(self:const Scan&,unit:u32)->const Module?,Error {if unit==0 || unit==self.module.unit {return self.module,Error.none;} for owner in self.owners {if owner.value.unit==unit {return owner.value,Error.none;}} return null,Error.invalid_artifact;}
fn same(self:const Scan&,left:u32,right:u32)->bool,Error {let equal,err=blot_check_rank_equal::equal(self.module.types,left,right,true); if err!=Error.none {return false,Error.invalid_artifact;} return equal,Error.none;}
fn arrow(self:const Scan&,left:u32,right:u32)->bool,Error {let a=self.module.types.node(left);let b=self.module.types.node(right);if a.tag!=TypeTag.function || b.tag!=TypeTag.function {return false,Error.none;} let input,err=self.same(a.a,b.a);if err!=Error.none || !input {return input,err;} let output,err=self.same(a.b,b.b);if err!=Error.none || !output {return output,err;}return self.module.types.rowLabels(a.c)==self.module.types.rowLabels(b.c),Error.none;}
fn selected(self:const Scan&,ty:u32)->blot_support::Option<blot_check_types::Node> {let value=self.module.types.node(ty);if value.tag!=TypeTag.scoped || value.b!=0 {return blot_support::none<blot_check_types::Node>();} let term=self.module.types.node(value.c);if term.tag!=TypeTag.instance_selection || self.module.types.nominalArguments(term).len!=3 {return blot_support::none<blot_check_types::Node>();}return blot_support::some(term);}
fn fact(self:Scan&,arrow:u32,ty:u32,value:u32)->Error {if arrow==0 {return Error.none;}for prior in self.facts[..self.len] {if prior.value!=value {continue;}let same_arrow,err=self.arrow(prior.arrow,arrow);if err!=Error.none {return err;}if !same_arrow {continue;}let selected,err=self.same(prior.selected,ty);if err!=Error.none {return err;}if selected {return Error.none;}}if self.len==self.facts.len {return Error.invalid_artifact;}self.facts[self.len]=Fact{arrow,ty,value, ..};self.len+=1;return Error.none;}
fn callResult(self:Scan&,id:u32,arrow:u32,value:u32,root:u32,depth:i64)->Error {if root==0 {return Error.none;}if depth>=128 || self.remaining==0 {return Error.invalid_artifact;}self.remaining-=1;let selected=self.selected(root);if selected.present {let term=selected.value;let version=self.module.types.node(self.module.types.nominalArguments(term)[2]);if version.a==self.module.unit && version.b==self.module.span(id).end+1 {let err=self.calledBinder(id,term);if err!=Error.none {return err;}let err=self.sites.claim(version,id);if err!=Error.none {return err;}return self.fact(arrow,root,value);}return Error.none;}
    let n=self.module.types.node(root);match n.tag {
