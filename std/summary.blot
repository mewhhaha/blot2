import * as tree from "./_summary_tree"

opaque type Summary s = tree.Tree s
const build = fn (combine: s -> s -> s) => fn (identity: s) => fn values => do:
  use value <- tree.build combine values
  return #Summary value
const length = fn (#Summary value) => tree.length value
const get = fn index => fn (#Summary value) => tree.get index value
const query = fn (combine: s -> s -> s) => fn identity => fn start => fn count => fn (#Summary value) => tree.query combine identity start count value
const set = fn (combine: s -> s -> s) => fn index => fn value => fn (#Summary original) => #Summary (tree.set combine index value original)
const concat = fn (combine: s -> s -> s) => fn (#Summary left) => fn (#Summary right) => #Summary (tree.concat combine left right)
