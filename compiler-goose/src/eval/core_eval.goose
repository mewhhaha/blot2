struct RaggedRegion { owner: i64,frame: Frame,plan: blot_backend_ragged_builder::Plan,original: ValueId=0,children: ValueId[:],written: i64=0,published: blot_support::Option<ValueId> =blot_support::none<ValueId>(),reserved: bool=true }
