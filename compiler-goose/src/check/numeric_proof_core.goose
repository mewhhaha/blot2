recursive fn summaryValue(self_: Checker&, module: const Module&, inputs: SummaryInputs, id: u32, depth: i64) -> Value, Error { if id == 0 || depth >= 32 { return Value {..}, blot_error::Error.none; } let node = module.node(id); if node.tag == blot_check_core::Tag.call { return self_.summaryInvocation(module, inputs, id, depth); } if node.tag == blot_check_core::Tag.block_ { return self_.summaryBlock(module, inputs, id, [], depth); } if node.tag == blot_check_core::Tag.if_value && module.types.node(node.ty).tag != blot_check_types::Tag.boolean { let err = self_.values.charge(1); if err != blot_error::Error.none { return Value {..}, err; } let left, err = self_.summaryValue(module, inputs, node.b, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let right, err = self_.summaryValue(module, inputs, node.c, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } return join(left, right, false); } let operand, err = self_.summaryOperand(module, inputs, id, depth); if err != blot_error::Error.none { return Value {..}, err; } let condition, err = self_.summaryCondition(module, inputs, id, depth); return Value { operand: operand, condition: condition , ..}, err; }
recursive fn summaryInvocation(self_: Checker&, module: const Module&, inputs: SummaryInputs, id: u32, depth: i64)->Value, Error {var actual:Values=Values{..};let result,error=summaryInvocationValue(self_,module,inputs,id,depth,actual);blot_support_pooled_buffer::deinit(actual,value_scratch);return result,error;}
recursive fn summaryInvocationValue(self_: Checker&, module: const Module&, inputs: SummaryInputs, id: u32, depth: i64,actual:Values&)->Value, Error { let invocation = module.call(id); let err = self_.values.charge(invocation.arguments.len + 1); if err != blot_error::Error.none { return Value {..}, err; } for argument in invocation.arguments { let value, err = self_.summaryValue(module, inputs, argument, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let stored=blot_support_pooled_buffer::push(actual,value,value_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} } var target = invocation.target; if target.unit == 0 { target.unit = module.unit; } return self_.summaryCall(target, actual.items, depth + 1); }
