let max_depth:i64=128;
let max_values:i64=32768;
let max_children:i64=131072;
struct Edges {storage:Edge[:] = default<Edge[:]>(),items:Edge[:] = default<Edge[:]>(),len:i64=0,failure:Error=blot_error::Error.none}
