// From LangArena goose/src/buffer_hash.goose and its Goose arena port.
// Copyright (c) 2026 'Konstantin Makarchev'. MIT; see LICENSE.
// LangArena's custom eight-lane digest; this is not cryptographic SHA-256.
// Byte values use U32 storage: four bytes per byte, with the same 0..255 values.
const arena_revision = 0
entry const revision = func (): U32 => return arena_revision

const prepare = func (bytes: Array U32) -> (size: U32): Unit => return do:
  for index in 0 .. size:
    bytes[index] := 0
  let rng_last = 42
  for index in 0 .. size:
    rng_last := (self * 3877 + 29573) % 139968
    bytes[index] := rng_last * 256 / 139968
  return ()

const simple_digest = func (bytes: Array U32) -> (size: U32) -> (result: Array U32): Unit => return do:
  let hashes: Array U32 = #[0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19]
  for index in 0 .. size:
    let hash_idx = index % 8
    let hash = hashes[hash_idx]
    hash := (self << 5) + self + bytes[index]
    hash := (self + (self << 10)) ^ (self >> 6)
    hashes[hash_idx] := hash
  for index in 0 .. 8:
    let hash = hashes[index]
    result[index * 4] := (hash >> 24) & 255
    result[index * 4 + 1] := (hash >> 16) & 255
    result[index * 4 + 2] := (hash >> 8) & 255
    result[index * 4 + 3] := hash & 255
  return ()

const run = func (bytes: Array U32) -> (size: U32): U32 => return do:
  let digest: Array U32 = @array.fill 32 0
  simple_digest bytes size digest
  return digest[0] | (digest[1] << 8) | (digest[2] << 16) | (digest[3] << 24)

entry const benchmark = func (host: Array U32 -> Array U32 ! {Foreign}): U32 ! {Foreign} => return do:
  use inputs <- host #[0]
  let size = inputs[0]
  let iterations = inputs[1]
  let warmups = inputs[2]
  let bytes: Array U32 = @array.fill 1000000 0
  prepare bytes size
  let checksum = 0
  for index in 0 .. warmups:
    checksum := self + run bytes size
  use started <- host #[1]
  for index in 0 .. iterations:
    checksum := self + run bytes size
  use finished <- host #[2]
  break checksum
