import std;import os;
import generic_bool_frontend;import scalar_host_emit;import scalar_host_verify;
fn main(){for s,i in ["pub let f: Bool -> U32 ! {} resources {depth: 1, frame: 0} = fn x => do:\n  if x:\n    return 11\n  return 42\n","pub let g: Bool -> U32 ! {} resources {depth: 1, frame: 0} = fn x => do:\n  if x:\n    return 4294967295\n  return 0\n"] {var p=generic_bool_frontend::parse(s);assert(p.status==0);let bytes=scalar_host_emit::emit(s,p.program);assert(bytes.len>0 && scalar_host_verify::verify(s,p.program,bytes));for j in bytes.len {var x=copy(bytes);x[j]^=1;assert(!scalar_host_verify::verify(s,p.program,x));assert(!scalar_host_verify::verify(s,p.program,bytes[..j]));}assert(!scalar_host_verify::verify("wrong",p.program,bytes));var forged=copy(p.program);forged.head.depth=2;assert(scalar_host_emit::emit(s,forged).len==0);var forged2=copy(p.program);forged2.head.frame=1;assert(scalar_host_emit::emit(s,forged2).len==0);assert(write_file(str("scalar-host-",i,".wasm"),bytes));}for bad in ["pub let f: Bool -> U32 ! {} resources {depth: 2, frame: 0} = fn x => do:\n  return 11\n", "pub let f: Bool -> U32 ! {} resources {depth: 1, frame: 1} = fn x => do:\n  return 11\n"] {var x=generic_bool_frontend::parse(bad);assert(x.status==0 && scalar_host_emit::emit(bad,x.program).len==0);}print("private Bool scalar wrapper source/target checked");}
