 blot_check_types::Tag.unit,blot_check_types::Tag.boolean,blot_check_types::Tag.unsigned32,blot_check_types::Tag.floating32,blot_check_types::Tag.never=>{return false,blot_error::Error.none;},
 blot_check_types::Tag.usage=>{if boundary.capture_usage || (boundary.loan!=0 && value.c==boundary.loan) {return true,blot_error::Error.none;}return self.scopeFootprintDepth(value.a,depth+1,remaining,inherited,boundary);},
 blot_check_types::Tag.array,blot_check_types::Tag.list,blot_check_types::Tag.cursor=>{return self.scopeFootprintDepth(value.a,depth+1,remaining,inherited,boundary);},
 blot_check_types::Tag.product=>{let children=equation_type_ids.alloc_slice(value.b);for child,index in self.types.list(blot_check_types::List{value.a,value.b}) {children[index]=child;}let result,err=scopeProductFootprint(self,children,depth,remaining,inherited,boundary);equation_type_ids.free_slice(children);return result,err;},
 blot_check_types::Tag.record=>{for index in 0..value.b {let found,err=self.scopeFootprintDepth(self.types.recordField(value,index).ty,depth+1,remaining,inherited,boundary);if err!=blot_error::Error.none || found {return found,err;}}return false,blot_error::Error.none;},
 _=>{return true,blot_error::Error.none;},
