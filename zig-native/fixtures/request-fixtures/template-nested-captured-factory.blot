type Tick is effect = { read: Unit -> U32 }
const handled = func computation => return do:
  for request in @requests computation:
    case request of
      effect Tick.read () =>
        break 42.5
      complete value =>
        break value
const create = func action => return do:
  let factory = func callback => return @computation (func () => return callback ())
  break @computation (func () => return do:
    let computation = factory action
    break handled computation
  )
entry const answer = func () => return handled (create (func () => return do:
  use Tick.read ()
  break @panic "cancelled action continued"
))
entry const folded = answer ()
