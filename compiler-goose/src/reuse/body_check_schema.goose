// Fail closed when new checker facts have no body receipt route.
namespace blot_reuse_body_check_cache;
import .body_check_cache;
fn knownCheckedField(name:const u8[:])->bool {return name=="owner" || name=="types" || name=="expr_types" || name=="resolved" || name=="bindings" || name=="merges" || name=="obligations" || name=="body_closed_rows" || name=="lambda_closed_rows" || name=="dispatch_signatures" || name=="covered_requirements" || name=="operation_uses" || name=="operation_refs" || name=="constructor_resolved" || name=="projections" || name=="access_paths" || name=="access_nodes" || name=="access_types" || name=="projection_resolved" || name=="projection_catalog" || name=="rebindings" || name=="loop_carries" || name=="loop_ranges" || name=="loop_exits" || name=="proof_contracts" || name=="capability_contracts" || name=="parameter_patterns" || name=="effect_families" || name=="effect_templates" || name=="associated" || name=="nominals" || name=="contracts" || name=="contract_predicates" || name=="contract_members" || name=="implementations" || name=="implementation_predicates" || name=="implementation_members" || name=="member_templates" || name=="selected_proofs" || name=="selected_members" || name=="selected_edges" || name=="selected_uses" || name=="constructors" || name=="tag_origins" || name=="unit" || name=="editor" || name=="initializer_rejected" || name=="diagnostics" || name=="body_elaborations" || name=="imported_schemes" || name=="counters" || name=="usage_loans" || name=="dictionary_selections" || name=="dictionary_uses" || name=="function_exit_lambdas" || name=="rank_implementations" || name=="generative_bindings" || name=="computations" || name=="request_loops" || name=="request_arms" || name=="request_controls" || name=="reflections" || name=="effect_scopes" || name=="effect_runners" || name=="provider_blocks" || name=="resolver_blocks" || name=="resolver_ops" || name=="resolver_joins" || name=="resolver_completions" || name=="resolver_loops" || name=="statement_arms" || name=="iterator_bodies" || name=="effect_scope_ids" || name=="effect_runner_ids" || name=="provider_block_ids" || name=="resolver_block_ids" || name=="resolver_op_ids" || name=="resolver_join_ids" || name=="resolver_loop_ids" || name=="proof_bodies";}
fn unretainedFacts()->bool {const for <N,A> in fields<blot_check_check::Checked> {if !knownCheckedField(N) {return true;}}return false;}
