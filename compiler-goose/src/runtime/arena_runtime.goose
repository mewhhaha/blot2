// Nonmoving allocation and size-class reuse preserve every payload address.
namespace blot_runtime_arena_runtime;
import backend.wasm;
import backend.runtime_ir;
import runtime.runtime_layout;
import runtime.shared_rc;
import support.error;
type Error = blot_error::Error;
type Module = blot_backend_wasm::Module;
type Arena = blot_backend_wasm::Arena;
type Instruction = blot_backend_runtime_ir::Instruction;
let first_class: u32 = 6; let companion_classes: u32 = 6;
let empty_list_address: u32 = 168;
let empty_scalar_list_address: u32 = empty_list_address + blot_runtime_runtime_layout::ListDescriptor_bytes;
let empty_rows_address: u32 = 256;
let empty_acyclic_list_address: u32 = empty_rows_address + 15 * blot_runtime_runtime_layout::ListDescriptor_bytes;
let metadata_bytes: u32 = empty_acyclic_list_address + blot_runtime_runtime_layout::ListDescriptor_bytes;
fn emit(module: Module&, arena: Arena) -> Error {
    let ordinary = allocate(module, arena); if ordinary != Error.none { return ordinary; }
    let scalar = allocateScalar(module, arena); if scalar != Error.none { return scalar; }
    let free = recycle(module, arena); if free != Error.none { return free; }
    return blot_runtime_shared_rc::emit(module, arena);
}
fn allocateScalar(module: Module&, arena: Arena) -> Error {
    let result, result_error = module.addLocal(arena.allocate_scalar, blot_backend_runtime_ir::VT_i32); if result_error != Error.none { return result_error; }
    let code = [
        Instruction { blot_backend_runtime_ir::OP_local_get, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_call, arena.allocate , ..},
        Instruction { blot_backend_runtime_ir::OP_local_set, result , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_if_, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, result , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, blot_runtime_runtime_layout::ArenaHeader_bytes - blot_runtime_runtime_layout::ArenaHeader_flags , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_sub, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 2 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_store, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_end, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, result , ..},
    ];
    return module.emitSlice(arena.allocate_scalar, code);
}
fn recycle(module: Module&, arena: Arena) -> Error {
    let pointer: u32 = 0;
    let head, head_error = module.addLocal(arena.free, blot_backend_runtime_ir::VT_i32); if head_error != Error.none { return head_error; }
    let size, size_error = module.addLocal(arena.free, blot_backend_runtime_ir::VT_i32); if size_error != Error.none { return size_error; }
    let bin, bin_error = module.addLocal(arena.free, blot_backend_runtime_ir::VT_i32); if bin_error != Error.none { return bin_error; }
    let code = [
        Instruction { blot_backend_runtime_ir::OP_local_get, pointer , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, blot_runtime_runtime_layout::ArenaHeader_bytes , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_sub, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_local_tee, head , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_load, blot_runtime_runtime_layout::ArenaHeader_requested , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_eqz, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_if_, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_unreachable_, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_end, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, head , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_load, blot_runtime_runtime_layout::ArenaHeader_block_size , ..},
        Instruction { blot_backend_runtime_ir::OP_local_tee, size , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 0x80000000 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_gt_u, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_if_, 0x7f , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 160 , ..},
        Instruction { blot_backend_runtime_ir::OP_else_, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 32 , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, size , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_ctz, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 2 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_shl, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_add, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, size , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, size , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 1 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_sub, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_and, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_ne, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 4 * (first_class - 2) , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_mul, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_sub, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_end, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_local_set, bin , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, head , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_store, blot_runtime_runtime_layout::ArenaHeader_requested , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, head , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_const, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_store, blot_runtime_runtime_layout::ArenaHeader_flags , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, head , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, bin , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_load, 0 , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_store, blot_runtime_runtime_layout::ArenaHeader_next , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, bin , ..},
        Instruction { blot_backend_runtime_ir::OP_local_get, head , ..},
        Instruction { blot_backend_runtime_ir::OP_i32_store, 0 , ..},
    ];
    return module.emitSlice(arena.free, code);
}
fn allocate(module: Module&, arena: Arena) -> Error {
    let bytes: u32 = 0;
