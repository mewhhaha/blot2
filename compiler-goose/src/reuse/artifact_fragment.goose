struct State {allocation_owner:u64=0,old:Capture=Capture{..},units:Module[:]=[],importer:Importer=Importer{..},starts:u64[:]=[],ends:u64[:]=[],blocked:bool[:]=[],requests_admitted:bool[:]=[],functions:u32[:]=[],signatures:u32[:]=[],signature_records:u32[:]=[],imports:u32[:]=[],globals:u32[:]=[],addresses:AddressBuffer=AddressBuffer{..},arena:blot_support::Option<Arena>=blot_support::none<Arena>(),lists:blot_support::Option<ListRuntime>=blot_support::none<ListRuntime>(),host:blot_support::Option<HostReferences>=blot_support::none<HostReferences>(),enabled:bool=false,stats:Stats=Stats{..},static_matches:StaticMap=StaticMap{..},serialized_roots:RootsMap=RootsMap{..},serialized_order:u32[:]=[],serialized_bindings:BindingsMap=BindingsMap{..},serialized_addresses:RootsMap=RootsMap{..},aggregate_constants:AggregatesMap=AggregatesMap{..},constant_addresses:AddressBuffer=AddressBuffer{..},match_scratch:blot_support::Option<QueryScratch>=blot_support::none<QueryScratch>(),live:bool=false}
reusable var state_owners:State[>..]=[];
reusable[] var unit_headers:Module[>..]=[];
reusable[] var times:u64[>..]=[];
reusable[] var flags:bool[>..]=[];
reusable[] var words:u32[>..]=[];
fn initPooledRef()->State?,Error {let at=state_owners.alloc_index(State{..});return state_owners[at],Error.none;}
fn releasePooled(self:State&) {self.deinit();let at=state_owners.index_of(self);assert(at>=0);state_owners.free(at);}
fn deinit(self:State&) {if !self.live {return;}self.importer.deinit();if self.units.len!=0 {unit_headers.free_slice(self.units);}if self.starts.len!=0 {times.free_slice(self.starts);}if self.ends.len!=0 {times.free_slice(self.ends);}if self.blocked.len!=0 {flags.free_slice(self.blocked);}if self.requests_admitted.len!=0 {flags.free_slice(self.requests_admitted);}for run in [self.functions,self.signatures,self.signature_records,self.imports,self.globals,self.serialized_order] {if run.len!=0 {words.free_slice(run);}}if self.match_scratch.present {self.match_scratch.value.deinit();}self.addresses.deinit();self.static_matches.deinit();self.serialized_roots.deinit();self.serialized_bindings.deinit();self.serialized_addresses.deinit();self.aggregate_constants.deinit();self.constant_addresses.deinit();self=State{..};}
fn pools(self:const State&)->const Pools& {assert(self.live && self.old.metadata.pools.present);return self.old.metadata.pools.value;}
fn slots(count:i64)->u32[:] {let result=words.alloc_slice(count);for &value in result {value=absent;}return result;}
fn rootKey(value:u32,ty:u32)->u64 {return (value as u64)<<32 | ty as u64;}
fn copyUnits(source:const Module[:])->Module[:] {let result=unit_headers.alloc_slice(source.len);for value,index in source {result[index]=value;}return result;}
fn initInto(self:State&,old:const Capture&,units:const Module[:],names:blot_support::Option<blot_backend_runtime_identity::View>,cached:i64,stamps:blot_reuse_code_artifacts::ModuleStamps?,allocation_owner:u64)->Error {self.deinit();self=State{allocation_owner:allocation_owner,old:old,units:copyUnits(units),live:true,..};let graphs,error=blot_reuse_artifact_import::initWithStamps(allocation_owner,self.pools(),self.units,names,cached,stamps);if error!=Error.none {self.deinit();return error;}self.importer=graphs;let error=initialize(self,names,cached);if error!=Error.none {self.deinit();return error;}return Error.none;}
fn init(allocation_owner:u64,old:const Capture&,units:const Module[:],names:blot_support::Option<blot_backend_runtime_identity::View>,cached:i64)->State?,Error {return initWithStamps(allocation_owner,old,units,names,cached,null);}
fn initWithStamps(allocation_owner:u64,old:const Capture&,units:const Module[:],names:blot_support::Option<blot_backend_runtime_identity::View>,cached:i64,stamps:blot_reuse_code_artifacts::ModuleStamps?)->State?,Error {let state,error=initPooledRef();if error!=Error.none {return null,error;}let self .= state;let error=initInto(self,old,units,names,cached,stamps,allocation_owner);if error!=Error.none {releasePooled(self);return null,error;}return self,Error.none;}
fn initialize(self:State&,names:blot_support::Option<blot_backend_runtime_identity::View>,cached:i64)->Error {var stable=self.importer.enabled && self.old.selectionStable(self.units,names,cached);var semantic=false;if self.importer.code_gate.present {semantic=self.importer.code_gate.value.semantic.enabled;if semantic {stable=true;}}if stable && !semantic {for admitted in self.importer.stable[..cached] {if !admitted {stable=false;break;}}}let count=self.old.metadata.jobs.len;self.starts=times.alloc_slice(count);self.ends=times.alloc_slice(count);self.blocked=flags.alloc_slice(count);self.requests_admitted=flags.alloc_slice(count);for &value in self.starts {value=0xffffffffffffffff;}for &value in self.ends {value=0;}for &value in self.blocked {value=false;}for &value in self.requests_admitted {value=false;}for event in self.old.metadata.events.items {match event.event {MetaEvent.enter item=>{self.starts[item.job-1]=event.sequence;},MetaEvent.leave item=>{self.ends[item.job-1]=event.sequence;},_=>{},}}let entries=self.pools().serialized;for entry in entries {self.serialized_roots.insert(rootKey(entry.value,entry.ty),entry.address);}self.serialized_order=words.alloc_slice(entries.len);for &index,position in self.serialized_order {index=position as u32;}sortSerialized(self.serialized_order,entries);for job,index in self.old.metadata.jobs.items {var fresh=!job.reusable;match job.request {Request.constant=>{fresh=fresh || (!scalarConstant(self.old,job) && !aggregateRoot(self.old,self.serialized_roots,job).present);},Request.runtime_global=>{fresh=true;},_=>{},}for target in self.old.metadata.inline_bodies.items[job.inline_bodies.start..job.inline_bodies.start+job.inline_bodies.len] {if !self.importer.admitsBody(target) {fresh=true;}}if fresh {var parent=(index+1) as u32;while parent!=0 {self.blocked[parent-1]=true;parent=self.old.metadata.jobs.items[parent-1].parent;}}}var signatures:i64=0;var imports:i64=0;var globals:i64=0;for record in self.old.emission.records.items {match record.event {EmitEvent.signature item=>{signatures=max(signatures,item.id as i64+1);},EmitEvent.import_ item=>{imports=max(imports,item.id as i64+1);},EmitEvent.global item=>{globals=max(globals,item.id as i64+1);},EmitEvent.arena=>{self.arena=self.old.emission.arena;},EmitEvent.lists=>{self.lists=self.old.emission.lists;},EmitEvent.host_references item=>{self.host=blot_support::some(item.value);},_=>{},}}self.functions=slots(self.old.emission.functions.len);self.signatures=slots(signatures);self.signature_records=slots(signatures);for record,index in self.old.emission.records.items {match record.event {EmitEvent.signature item=>{if self.signature_records[item.id]==absent {self.signature_records[item.id]=index as u32;}},_=>{},}}self.imports=slots(imports);self.globals=slots(globals);self.enabled=stable;return Error.none;}
fn siftSerialized(order:u32[:],entries:const blot_reuse_code_artifacts::Serialized[:],root:i64,count:i64) {var parent=root;loop {let child=parent*2+1;if child>=count {return;}var largest=child;if child+1<count && entries[order[child]].address<entries[order[child+1]].address {largest=child+1;}if entries[order[parent]].address>=entries[order[largest]].address {return;}let swap=order[parent];order[parent]=order[largest];order[largest]=swap;parent=largest;}}
fn sortSerialized(order:u32[:],entries:const blot_reuse_code_artifacts::Serialized[:]) {var parent=order.len/2;while parent>0 {parent-=1;siftSerialized(order,entries,parent,order.len);}var count=order.len;while count>1 {count-=1;let swap=order[0];order[0]=order[count];order[count]=swap;siftSerialized(order,entries,0,count);}}
fn serializedAt(self:const State&,address:u32)->i64 {let entries=self.pools().serialized;var left:i64=0;var right=self.serialized_order.len;while left<right {let middle=left+(right-left)/2;if entries[self.serialized_order[middle]].address<address {left=middle+1;}else {right=middle;}}return left;}
fn metaAt(self:const State&,sequence:u64)->i64 {var left:i64=0;var right=self.old.metadata.events.len;while left<right {let middle=left+(right-left)/2;if self.old.metadata.events.items[middle].sequence<sequence {left=middle+1;}else {right=middle;}}return left;}
fn emissionAt(self:const State&,sequence:u64)->i64 {var left:i64=0;var right=self.old.emission.records.len;while left<right {let middle=left+(right-left)/2;if self.old.emission.records.items[middle].sequence<sequence {left=middle+1;}else {right=middle;}}return left;}
fn matchValues<G>(self:State&,g:G&,plan:const Plan&,old_root:u32,current_root:u32)->bool,Error {if !self.match_scratch.present {self.match_scratch=blot_support::some(QueryScratch{allocation_owner:g.evaluator.allocation_owner,..});}let scratch .= self.match_scratch.value;let anchors,error=scratch.begin(plan,g);if error!=Error.none {return false,oomOnly(error);}let same,error=plan.matchIntoWithScratch(g,self.importer,old_root,current_root,anchors,scratch);if error!=Error.none || !same {return false,oomOnly(error);}return self.importer.recordValueAnchorIds(scratch.anchors.items,scratch.anchor_ids.items);}
fn oomOnly(error:Error)->Error {if error==Error.out_of_memory {return error;}return Error.none;}
fn serializedBinding<G>(self:State&,g:G&,entry:blot_reuse_code_artifacts::Serialized)->blot_support::Option<SerializedBinding>,Error {let ty,error=self.importer.importLayout(g,entry.ty);if error!=Error.none || !ty.present {return blot_support::none<SerializedBinding>(),error;}let anchor .= self.importer.value_anchors.get(entry.value);if anchor {return blot_support::some(SerializedBinding{value:anchor,ty:ty.value,..}),Error.none;}let source=self.pools().evaluator;if entry.value>=source.values.len || source.values[entry.value].kind!=blot_eval_eval_values::ValueKind.closure || source.values[entry.value].len!=0 {return blot_support::none<SerializedBinding>(),Error.none;}let evidence=source.value_evidence[entry.value];if evidence==0 || !self.importer.code_gate.present {return blot_support::none<SerializedBinding>(),Error.none;}let gate .= self.importer.code_gate.value.semantic;let inspection,error=blot_reuse_source_value_template::inspectRootsWithRows(self.pools(),gate,[entry.value],blot_reuse_source_value_template::RowPolicy.source_declared);if error!=Error.none || !inspection.plan.present {return blot_support::none<SerializedBinding>(),error;}var plan=inspection.plan.value;let result,error=serializedClosure(self,g,entry,ty.value,evidence,plan);plan.deinit();return result,error;}
fn serializedClosure<G>(self:State&,g:G&,entry:blot_reuse_code_artifacts::Serialized,ty:u32,evidence:u32,plan:const Plan&)->blot_support::Option<SerializedBinding>,Error {let expected,error=self.importer.importClosedEvidence(g,evidence);if error!=Error.none || !expected.present {return blot_support::none<SerializedBinding>(),error;}let source=self.pools().evaluator;let header=source.closures[source.values[entry.value].bits];let entries=self.pools().serialized;var index=self.serializedAt(entry.address);while index<self.serialized_order.len {let candidate=entries[self.serialized_order[index]];index+=1;if candidate.address!=entry.address {break;}if candidate.value==entry.value || candidate.value>=source.values.len {continue;}let info=source.values[candidate.value];if info.kind!=blot_eval_eval_values::ValueKind.closure || info.len!=0 {continue;}let other=source.closures[info.bits];if header.unit!=other.unit || header.identity!=other.identity || header.origin!=other.origin || header.staged!=other.staged || header.applied!=other.applied {continue;}let current .= self.importer.value_anchors.get(candidate.value);if !current {continue;}let diagnostic=g.evaluator.diagnostic;let selected,error=g.evaluator.specializeClosure(current,expected.value);if error!=Error.none {g.evaluator.diagnostic=diagnostic;return blot_support::none<SerializedBinding>(),oomOnly(error);}let matched,error=self.matchValues(g,plan,entry.value,selected);if error!=Error.none {return blot_support::none<SerializedBinding>(),error;}if matched {return blot_support::some(SerializedBinding{value:selected,ty:ty,..}),Error.none;}}return blot_support::none<SerializedBinding>(),Error.none;}
fn admitSerialized<G>(self:State&,g:G&,address:u32,len:u32)->bool,Error {let entries=self.pools().serialized;var position=self.serializedAt(address);while position<self.serialized_order.len {let index=self.serialized_order[position];position+=1;let entry=entries[index];if entry.address-address>=len {break;}let selected,error=self.serializedBinding(g,entry);if error!=Error.none || !selected.present {return false,error;}let binding=selected.value;let key=blot_backend_backend_static_data::SerializedKey{value:binding.value,ty:binding.ty,..};if g.static_data.cache.contains(key) {return false,Error.none;}let root=rootKey(binding.value,binding.ty);let previous .= self.serialized_addresses.get(root);if previous {if previous!=entry.address {return false,Error.none;}}else {self.serialized_addresses.insert(root,entry.address);}self.serialized_bindings.insert(index,binding);}return true,Error.none;}
fn publishSerialized<G>(self:State&,g:G&,address:u32,actual:u32,len:u32)->Error {let entries=self.pools().serialized;var position=self.serializedAt(address);while position<self.serialized_order.len {let index=self.serialized_order[position];position+=1;let entry=entries[index];if entry.address-address>=len {break;}let binding .= self.serialized_bindings.get(index);if !binding {return Error.invalid_function_reference;}let relocated=actual+(entry.address-address);let key=blot_backend_backend_static_data::SerializedKey{value:binding.value,ty:binding.ty,..};let previous .= g.static_data.cache.get(key);if previous && previous!=relocated {return Error.invalid_function_reference;}let error=g.static_data.cache.insert(key,relocated);if error!=Error.none {return error;}}return Error.none;}
fn aggregateRoot(old:const Capture&,roots:const RootsMap&,job:Job)->blot_support::Option<u32> {if job.state!=blot_reuse_code_artifacts::State.complete || !job.value.present {return blot_support::none<u32>();}match job.request {Request.constant=>{},_=>{return blot_support::none<u32>();},}let result=job.value.value;let values=old.metadata.pools.value.evaluator.values;if result.value>=values.len {return blot_support::none<u32>();}match values[result.value].kind {blot_eval_eval_values::ValueKind.scalar,blot_eval_eval_values::ValueKind.computation,blot_eval_eval_values::ValueKind.request_decision,blot_eval_eval_values::ValueKind.type_constructor,blot_eval_eval_values::ValueKind.resolver,blot_eval_eval_values::ValueKind.provider,blot_eval_eval_values::ValueKind.state_provider=>{return blot_support::none<u32>();},_=>{},}let root .= roots.get(rootKey(result.value,result.layout));if !root {return blot_support::none<u32>();}return blot_support::some(root);}
fn scalarConstant(old:const Capture&,job:Job)->bool {if job.state!=blot_reuse_code_artifacts::State.complete || !job.value.present || !old.metadata.pools.present {return false;}match job.request {Request.constant=>{},_=>{return false;},}let result=job.value.value;let values=old.metadata.pools.value.evaluator.values;return result.value<values.len && values[result.value].kind==blot_eval_eval_values::ValueKind.scalar && result.layout>0 && result.layout<=blot_check_types::f32_type;}
fn constantTarget<G>(self:State&,g:G&,target:blot_check_core::BindingRef)->blot_support::Option<blot_check_core::BindingRef> {if !self.importer.admitsBody(target) || target.unit==0 || target.unit>self.importer.unit_map.len {return blot_support::none<blot_check_core::BindingRef>();}let unit=self.importer.unit_map[target.unit-1];if unit==0 || unit>g.evaluator.units.len || target.binding>=g.evaluator.units[unit-1].bindings.len {return blot_support::none<blot_check_core::BindingRef>();}let body .= g.evaluator.units[unit-1].body(target.binding);if !body || body.runtime {return blot_support::none<blot_check_core::BindingRef>();}let slot=g.evaluator.slots[g.evaluator.binding_offsets[unit-1]+target.binding];if slot.state!=blot_eval_core_eval::State.complete {return blot_support::none<blot_check_core::BindingRef>();}return blot_support::some(blot_check_core::BindingRef{unit:unit,binding:target.binding,..});}
fn aggregateConstantRequest<G>(self:State&,g:G&,id:u32)->blot_support::Option<AggregateConstant>,Error {let known .= self.aggregate_constants.get(id);if known {return blot_support::some(known),Error.none;}let job=self.old.metadata.jobs.items[id-1];let root=aggregateRoot(self.old,self.serialized_roots,job);if !root.present {return blot_support::none<AggregateConstant>(),Error.none;}match job.request {Request.constant item=>{let request=item.key;let target=constantTarget(self,g,request.target);if !target.present || !self.importer.code_gate.present || !self.importer.code_gate.value.semantic.enabled {return blot_support::none<AggregateConstant>(),Error.none;}let gate .= self.importer.code_gate.value.semantic;let inspection,error=blot_reuse_source_value_template::inspectRootsWithRows(self.pools(),gate,[job.value.value.value],blot_reuse_source_value_template::RowPolicy.source_declared);if error!=Error.none || !inspection.plan.present {return blot_support::none<AggregateConstant>(),error;}var plan=inspection.plan.value;let slot=g.evaluator.slots[g.evaluator.binding_offsets[target.value.unit-1]+target.value.binding];let matched,error=self.matchValues(g,plan,job.value.value.value,slot.value);plan.deinit();if error!=Error.none || !matched {return blot_support::none<AggregateConstant>(),error;}let ty,error=self.importer.importLayout(g,request.ty);if error!=Error.none || !ty.present {return blot_support::none<AggregateConstant>(),error;}let admitted=AggregateConstant{request:Request.constant{key:blot_reuse_code_artifacts::ConstantKey{target:target.value,ty:ty.value,..},..},root:root.value,..};self.aggregate_constants.insert(id,admitted);return blot_support::some(admitted),Error.none;},_=>{return blot_support::none<AggregateConstant>(),Error.none;},}}
