// Streaming JSON response serializer with FNV-1a 64-bit checksum per response.
import * as rng from "./rng"

const BENCH_N: U32 = 400000 // BENCH_N

type HandleRes is data = $HandleRes { hash: U64, len: U32 }

func emit_uint (buf: own #[U8]) -> (v: U32): #[U8] =>
  if v == 0:
    buf := self.push 48
    return buf
  let d0: U32 = 0
  let d1: U32 = 0
  let d2: U32 = 0
  let d3: U32 = 0
  let d4: U32 = 0
  let d5: U32 = 0
  let d6: U32 = 0
  let d7: U32 = 0
  let n: U32 = 0
  let x = v
  for ever:
    if x == 0:
      break
    let dig = 48 + (x % 10)
    if n == 0:
      d0 := dig
    else:
      if n == 1:
        d1 := dig
      else:
        if n == 2:
          d2 := dig
        else:
          if n == 3:
            d3 := dig
          else:
            if n == 4:
              d4 := dig
            else:
              if n == 5:
                d5 := dig
              else:
                if n == 6:
                  d6 := dig
                else:
                  d7 := dig
    n := self + 1
    x := self / 10
  for ever:
    if n == 0:
      break
    n := self - 1
    let ch = if n == 0 then d0 else if n == 1 then d1 else if n == 2 then d2 else if n == 3 then d3 else if n == 4 then d4 else if n == 5 then d5 else if n == 6 then d6 else d7
    buf := self.push ch.to_u8
  return buf

func emit_name (buf: own #[U8]) -> (seed: U64): #[U8] =>
  let r = rng.xs_next seed
  let n = 3 + rng.xs_mod r 8
  let odd = rng.xs_mod (r >> 8) 8 == 0
  buf := self.push 34
  for i in 0 .. n:
    r := rng.xs_next self
    if odd and i == 1:
      buf := self.push 92
      let q: U8 = if rng.xs_mod r 2 == 0 then 34 else 92
      buf := self.push q
    else:
      buf := self.push (97 + rng.xs_mod r 26).to_u8
  buf := self.push 34
  return buf

func emit_sku (buf: own #[U8]) -> (seed: U64): #[U8] =>
  let r = rng.xs_next seed
  buf := self.push 34
  buf := self.push (65 + rng.xs_mod r 26).to_u8
  buf := self.push (65 + rng.xs_mod (r >> 8) 26).to_u8
  for _ in 0 .. 4:
    r := rng.xs_next self
    buf := self.push (48 + rng.xs_mod r 10).to_u8
  buf := self.push 34
  return buf

func fnv_buf (buf: #[U8]): U64 =>
  // 14695981039346656037 = 0xCBF29CE484222325
  let h: U64 = rng.FNV_OFFSET
  for i in 0 .. buf.length:
    h := rng.fnv_step self buf[i]
  return h

func handle (seed: U64): HandleRes =>
  let r0 = rng.xs_next seed
  let n = 1 + rng.xs_mod r0 8
  let buf: #[U8] = #[]
  // {"id":
  buf := self.push 123
  buf := self.push 34
  buf := self.push 105
  buf := self.push 100
  buf := self.push 34
  buf := self.push 58
  buf := emit_uint self (rng.xs_mod (r0 >> 4) 1000000)
  // ,"user":
  buf := self.push 44
  buf := self.push 34
  buf := self.push 117
  buf := self.push 115
  buf := self.push 101
  buf := self.push 114
  buf := self.push 34
  buf := self.push 58
  buf := emit_name self (r0 >> 8)
  // ,"items":[
  buf := self.push 44
  buf := self.push 34
  buf := self.push 105
  buf := self.push 116
  buf := self.push 101
  buf := self.push 109
  buf := self.push 115
  buf := self.push 34
  buf := self.push 58
  buf := self.push 91

  let total: U32 = 0
  let r = r0 >> 16
  for i in 0 .. n:
    r := rng.xs_next self
    if i > 0:
      buf := self.push 44
    let qty = 1 + rng.xs_mod (r >> 8) 5
    let price = 100 + rng.xs_mod (r >> 16) 99900
    // {"sku":
    buf := self.push 123
    buf := self.push 34
    buf := self.push 115
    buf := self.push 107
    buf := self.push 117
    buf := self.push 34
    buf := self.push 58
    buf := emit_sku self r
    // ,"qty":
    buf := self.push 44
    buf := self.push 34
    buf := self.push 113
    buf := self.push 116
    buf := self.push 121
    buf := self.push 34
    buf := self.push 58
    buf := emit_uint self qty
    // ,"price":
    buf := self.push 44
    buf := self.push 34
    buf := self.push 112
    buf := self.push 114
    buf := self.push 105
    buf := self.push 99
    buf := self.push 101
    buf := self.push 34
    buf := self.push 58
    buf := emit_uint self price
    // }
    buf := self.push 125
    total := self + qty * price

  // ],"total":
  buf := self.push 93
  buf := self.push 44
  buf := self.push 34
  buf := self.push 116
  buf := self.push 111
  buf := self.push 116
  buf := self.push 97
  buf := self.push 108
  buf := self.push 34
  buf := self.push 58
  buf := emit_uint self total
  buf := self.push 125

  return $HandleRes { hash: fnv_buf buf, len: buf.length }

io bench (): #[U32] =>
  let seed: U64 = 12345
  let h: U64 = 0
  let bytes: I64 = 0
  for i in 0 .. BENCH_N:
    seed := rng.xs_next self
    let $HandleRes { hash: hh, len: l } = handle seed
    let term = hh * 31 + i.to_u64
    h := self ^ term
    bytes := self + l.to_i64

  let out: #[U32] = #[]
  out := rng.emit_u32 self BENCH_N
  out := rng.emit_i64 self bytes
  out := rng.emit_u64 self h
  return out
