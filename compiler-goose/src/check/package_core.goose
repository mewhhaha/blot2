fn rowVariable(types:const blot_check_core::Types&,row:u32)->u32 {match types.row(row).tail {variable value=>{return value.value;},_=>{abort("row variable index contains a closed row");},}}
fn rowsForVariable(self_: Walker&, variable: u32) -> const u32[:], Error {
    if self_.admission.source_bodies {
        let index, error = self_.sourceRows();
        if error != blot_error::Error.none {
            return default<const u32[:]>(), error;
        }
        return rowsInIndex(self_, index, variable);
    }
    if !self_.rows_indexed {
        for row, id in self_.module.types.effects.rows {
            let error = self_.step(0);
            if error != blot_error::Error.none {
                return default<const u32[:]>(), error;
            }
            match row.tail {
                variable payload => {
                    if self_.row_index_len >= self_.row_index.len {
                        return default<const u32[:]>(), blot_error::Error.invalid_artifact;
                    }
                    self_.row_index[self_.row_index_len] = id as u32;
                    self_.row_index_len +=1;
                }, _ => {
                },
            }
        }
        let error = self_.sortRows(self_.row_index[ .. self_.row_index_len]);
        if error != blot_error::Error.none {
            return default<const u32[:]>(), error;
        }
        self_.rows_indexed = true;
    }
    return rowsInIndex(self_, self_.row_index[ .. self_.row_index_len], variable);
}
fn rowsInIndex(self_: Walker&, index: const u32[:], variable: u32) -> const u32[:], Error {
    var first: i64 = 0;
    var end = index.len;
    while first < end {
        let error = self_.step(0);
        if error != blot_error::Error.none {
            return default<const u32[:]>(), error;
        }
        let middle = first + (end - first) / 2;
        if rowVariable(self_.module.types, index[middle]) < variable {
            first = middle + 1;
        } else {
            end = middle;
        }
    }
    end = first;
    while end < index.len {
        let error = self_.step(0);
        if error != blot_error::Error.none {
            return default<const u32[:]>(), error;
        }
        if rowVariable(self_.module.types, index[end]) != variable {
            break;
        }
        end +=1;
    }
    return index[first .. end], blot_error::Error.none;
}

struct RowOrder {types:const blot_check_core::Types&,remaining:i64&,rows:u32[:]}
fn lessThan(self_:RowOrder,left:i64,right:i64)->bool {self_.remaining=max(0,self_.remaining-1);return rowVariable(self_.types,self_.rows[left])<rowVariable(self_.types,self_.rows[right]);}
fn swap(self_:RowOrder,left:i64,right:i64) {let value=self_.rows[left];self_.rows[left]=self_.rows[right];self_.rows[right]=value;}
fn sortRows(self_:Walker&,rows:u32[:])->Error {blot_check_source_sort::pdqContext(0,rows.len,RowOrder{types:self_.module.types,remaining:self_.scopes.remaining,rows:rows, ..});return require(self_.scopes.remaining!=0);}
