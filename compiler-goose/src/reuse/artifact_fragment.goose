 }return true,blot_error::Error.none;}

fn knownGlobal(self_:const State&,id:u32,requests:blot_support::Option<u32>)->bool {if self_.arena.present {let value=self_.arena.value;if id==value.heap {return true;}if id==value.base {return true;}if id==value.static_end {return true;}if id==value.allocated {return true;}if id==value.rc_enabled {return true;}if id==value.rc_leases {return true;}if id==value.rc_retains {return true;}if id==value.rc_releases {return true;}if id==value.rc_destroyed {return true;}if id==value.root_enabled {return true;}if id==value.root_page {return true;}if id==value.root_top {return true;}if id==value.root_frame {return true;}if id==value.root_active {return true;}if id==value.root_external {return true;}if id==value.root_count {return true;}if id==value.root_globals {return true;}if id==value.root_started {return true;}if id==value.root_host_cursor {return true;}if id==value.root_host_active {return true;}if id==value.root_static_map {return true;}if id==value.root_static_count {return true;}if id==value.root_global_count {return true;}if id==value.cycle_head {return true;}if id==value.cycle_members {return true;}if id==value.cycle_work {return true;}if id==value.cycle_phase {return true;}if id==value.cycle_removed {return true;}if id==value.cycle_cadence {return true;}if id==value.cycle_passes {return true;}if id==value.cycle_vertices {return true;}if id==value.cycle_edges {return true;}if id==value.cycle_bytes {return true;}if id==value.cycle_threshold {return true;}}if self_.host.present {let value=self_.host.value;if id==value.cursor || id==value.active {return true;}}if !requests.present || id!=0 || self_.old.emission.records.len==0 {return false;}let first=self_.old.emission.records.items[0];match first.event {global=>{return first.owner==0;},_=>{return false;},}}
