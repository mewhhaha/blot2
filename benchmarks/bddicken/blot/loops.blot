// 10k x 10k array modulo-update loop matching bddicken/languages.
// Parameter packs (u << 16) | r with 0 <= r < 10000.
io loops (arg: U32): U32 =>
  let u = arg >> 16
  let r = arg & 65535
  let a = @array.fill 10000 0
  for i in 0 .. 10000:
    let acc: U32 = 0
    for j in 0 .. 10000:
      acc := self + (j % u)
    a[i] := acc + r
  return a[r]
