recursive fn summaryCall(self_: Checker&, target: blot_check_core::BindingRef, actual: const Value[:], depth: i64) -> Value, Error {
    if depth >= 32 { return Value {..}, blot_error::Error.none; } let selected, err = self_.target(target); if err != blot_error::Error.none { return Value {..}, err; } let binding = selected.module.bindings[selected.binding]; if binding.body_id == 0 || binding.body_id >= selected.module.bodies.len { return Value {..}, blot_error::Error.none; } let body .= selected.module.bodies[binding.body_id]; let parameters = selected.module.bodyParameters(body); if body.binding != selected.binding || !body.is_function || parameters.len > actual.len { return Value {..}, blot_error::Error.none; }
