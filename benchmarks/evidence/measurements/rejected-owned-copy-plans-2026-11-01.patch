+++ b/zig-native/tests/owned_render_copy_execution.test.ts
@@ -0,0 +1,85 @@
+import { strict as assert } from "node:assert";
+import { resolve } from "node:path";
+import { createZigProjectCompiler } from "../../compiler/zig_project_client.ts";
+import { instantiateGuest } from "../../compiler/guest.ts";
+import {
+  expectedRenderStream,
+  ownedRenderSource,
+} from "./owned_render_copy_fixture.ts";
+
+for (const operation of ["owned", "emit"] as const) {
+  for (const tier of ["development", "optimized"] as const) {
+    Deno.test(`completed original Ink copies preserve full streams aliases and prefix borrows (${operation}/${tier})`, async () => {
+      const root = resolve(new URL("../..", import.meta.url).pathname);
+      const directory = await Deno.makeTempDir();
+      let compiler;
+      let guest;
+      try {
+        const entry = resolve(directory, "main.blot");
+        compiler = await createZigProjectCompiler({
+          executable: Deno.args[0],
+          entry,
+          imports: { "ink/": resolve(root, "../ink/lib") },
+          stdRoot: resolve(root, "std"),
+          prelude: resolve(root, "std/prelude.blot"),
+          cacheDirectory: false,
+          codegenTier: tier,
+          profileBackend: true,
+          startupTimeoutMs: 5000,
+        });
+        const result = await compiler.build({
+          sources: { [entry]: ownedRenderSource(4, operation) },
+          signal: AbortSignal.timeout(10000),
+        });
+        assert(result.success, JSON.stringify(result));
+        const counters = result.stats.workCounters as Record<string, number>;
+        assert(
+          counters.scoped_owned_copy_definitions >= 2,
+          JSON.stringify(counters),
+        );
+        assert(counters.scoped_owned_copy_hits >= 3, JSON.stringify(counters));
+        assert(
+          counters.scoped_owned_copy_summary_steps >= 9,
+          JSON.stringify(counters),
+        );
+        if (operation === "emit") {
+          assert(
+            counters.scoped_owned_copy_definitions >= 4,
+            JSON.stringify(counters),
+          );
+        }
+        for (const asynchronous of [false, true]) {
+          guest = await instantiateGuest(result.bytes, { asynchronous });
+          try {
+            for (const input of [0, 1, 17, 0]) {
+              for (
+                const name of [
+                  "stream",
+                  "overlap",
+                  "self_rows",
+                  "empty_after_freeze",
+                ]
+              ) {
+                let actual;
+                if (asynchronous) {
+                  actual = await guest.callAsync(name, input);
+                } else actual = guest.call(name, input);
+                assert.deepEqual(
+                  actual,
+                  expectedRenderStream(name, 4, input, operation),
+                );
+              }
+            }
+          } finally {
+            guest.dispose();
+            guest = undefined;
+          }
+        }
+      } finally {
+        guest?.dispose();
+        await compiler?.dispose();
+        await Deno.remove(directory, { recursive: true });
+      }
+    });
+  }
+}
diff --git a/scripts/bench/owned_render_copies.ts b/scripts/bench/owned_render_copies.ts
new file mode 100644
--- /dev/null
+++ b/scripts/bench/owned_render_copies.ts
@@ -0,0 +1,350 @@
+// Original Ink render.store_draw / emit_owned, fresh matched compilers, five-second caps.
+// deno run --no-config --no-lock -A scripts/bench/owned_render_copies.ts --compiler NEW --baseline OLD
+import { strict as assert } from "node:assert";
+import { resolve } from "node:path";
+import { parseArgs } from "node:util";
+import { createZigProjectCompiler } from "../../compiler/zig_project_client.ts";
+import { instantiateGuest } from "../../compiler/guest.ts";
+import {
+  expectedRenderStream,
+  ownedRenderSource,
+} from "../../zig-native/tests/owned_render_copy_fixture.ts";
+
+const root = resolve(new URL("../..", import.meta.url).pathname);
+const { values } = parseArgs({
+  args: Deno.args,
+  options: {
+    compiler: {
+      type: "string",
+      default: "zig-native/zig-out-native-dev/bin/blotc",
+    },
+    baseline: { type: "string" },
+    operation: { type: "string", default: "owned" },
+    callers: { type: "string", default: "1,4,8" },
+    repetitions: { type: "string", default: "3" },
+    output: { type: "string", default: "build/bench/owned-render-copies" },
+    tier: { type: "string", default: "optimized" },
+  },
+});
+const repetitions = Number(values.repetitions);
+assert(Number.isInteger(repetitions) && repetitions >= 1 && repetitions <= 9);
+assert(values.tier === "optimized" || values.tier === "development");
+assert(values.operation === "owned" || values.operation === "emit");
+const selectedCallers = [...new Set(values.callers!.split(",").map(Number))];
+assert(
+  selectedCallers.length > 0 &&
+    selectedCallers.every((value) => Number.isInteger(value) && value > 0),
+);
+type CallSite = {
+  filename: string;
+  line: number;
+  operation: string;
+  source: string;
+};
+const callSites: CallSite[] = [];
+async function inventory(directory: string): Promise<void> {
+  for await (const file of Deno.readDir(directory)) {
+    const path = resolve(directory, file.name);
+    if (file.isDirectory) await inventory(path);
+    else if (file.name.endsWith(".blot")) {
+      const lines = (await Deno.readTextFile(path)).split("\n");
+      for (const [line, source] of lines.entries()) {
+        for (
+          const match of source.matchAll(
+            /\brender\.(emit_owned|emit|store_draw)\b/g,
+          )
+        ) {
+          callSites.push({
+            filename: path,
+            line: line + 1,
+            operation: match[1],
+            source: source.trim(),
+          });
+        }
+      }
+    }
+  }
+}
+await inventory(resolve(root, "../gdev/src"));
+const directCalls = { emit: 0, emit_owned: 0, store_draw: 0 };
+for (const site of callSites) {
+  directCalls[site.operation as keyof typeof directCalls]++;
+}
+let maximumCallers = 8; // Historical owned-family diagnostic cells stay comparable.
+if (values.operation === "emit") {
+  maximumCallers = Math.min(16, directCalls.emit);
+}
+assert(
+  selectedCallers.every((value) => value <= maximumCallers),
+  `--callers exceeds supported ${values.operation} scope (${maximumCallers}); 16 requires actual plain-emit inventory`,
+);
+
+const compilers = [{
+  label: "candidate",
+  path: resolve(root, values.compiler!),
+}];
+if (values.baseline) {
+  compilers.unshift({
+    label: "baseline",
+    path: resolve(root, values.baseline),
+  });
+}
+const directory = resolve(root, values.output!);
+await Deno.mkdir(directory, { recursive: true });
+const evidence = await Deno.makeTempDir({ dir: directory, prefix: "run-" });
+const hash = async (bytes: Uint8Array<ArrayBuffer>) =>
+  [...new Uint8Array(await crypto.subtle.digest("SHA-256", bytes))]
+    .map((byte) => byte.toString(16).padStart(2, "0")).join("");
+const compilerPins = Object.fromEntries(
+  await Promise.all(
+    compilers.map(async (
+      compiler,
+    ) => [compiler.label, await hash(await Deno.readFile(compiler.path))]),
+  ),
+);
+// Pin the full source inventories, including dirty edits and transitive imports.
+const sourceFiles: Record<string, string> = {};
+async function pinSources(directory: string): Promise<void> {
+  const pending = [];
+  for await (const file of Deno.readDir(directory)) {
+    const path = resolve(directory, file.name);
+    if (file.isDirectory) pending.push(pinSources(path));
+    else if (file.name.endsWith(".blot")) {
+      pending.push((async () => {
+        sourceFiles[path] = await hash(await Deno.readFile(path));
+      })());
+    }
+  }
+  await Promise.all(pending);
+}
+await Promise.all([
+  pinSources(resolve(root, "../ink/lib")),
+  pinSources(resolve(root, "std")),
+]);
+for (const filename of new Set(callSites.map((site) => site.filename))) {
+  sourceFiles[filename] = await hash(await Deno.readFile(filename));
+}
+
+type Sample = {
+  callers: number;
+  label: string;
+  repetition: number;
+  status: string;
+  buildMs?: number;
+  wasmBytes?: number;
+  definitions?: number;
+  [key: string]: unknown;
+};
+const samples: Sample[] = [];
+for (const callers of selectedCallers) {
+  const entry = resolve(evidence, `render-${callers}.blot`);
+  const source = ownedRenderSource(callers, values.operation);
+  await Deno.writeTextFile(entry, source);
+  for (let repetition = 0; repetition < repetitions; repetition++) {
+    let order = compilers;
+    if (repetition % 2 === 1) order = compilers.toReversed();
+    for (const executable of order) {
+      const started = performance.now();
+      let compiler;
+      let guest;
+      let sample: Sample = {
+        callers,
+        label: executable.label,
+        repetition,
+        status: "incomplete",
+      };
+      try {
+        compiler = await createZigProjectCompiler({
+          executable: executable.path,
+          entry,
+          imports: { "ink/": resolve(root, "../ink/lib") },
+          stdRoot: resolve(root, "std"),
+          prelude: resolve(root, "std/prelude.blot"),
+          cacheDirectory: false,
+          profileBackend: true,
+          codegenTier: values.tier,
+          codegenWorkers: 1,
+          startupTimeoutMs: 5000,
+        });
+        const buildStarted = performance.now();
+        const result = await compiler.build({
+          signal: AbortSignal.timeout(5000),
+        });
+        sample.buildMs = performance.now() - buildStarted;
+        if (!result.success) {
+          sample.status = "failed";
+          sample.diagnostics = result.diagnostics;
+        } else {
+          guest = await instantiateGuest(result.bytes);
+          const executions = [];
+          for (const input of [0, 1, 17, 0]) {
+            for (
+              const name of [
+                "stream",
+                "overlap",
+                "self_rows",
+                "empty_after_freeze",
+              ]
+            ) {
+              const actual: unknown = guest.call(name, input);
+              const expected = expectedRenderStream(
+                name,
+                callers,
+                input,
+                values.operation,
+              );
+              assert.deepEqual(actual, expected);
+              executions.push({
+                name,
+                input,
+                words: [...expected],
+                sha256: await hash(new Uint8Array(expected.buffer)),
+              });
+            }
+          }
+          const counters = result.stats.workCounters as Record<string, number>;
+          sample = {
+            ...sample,
+            status: "complete",
+            wasmBytes: result.bytes.length,
+            wasmSha256: await hash(result.bytes),
+            definitions: counters.scoped_owned_copy_definitions ?? 0,
+            planHits: counters.scoped_owned_copy_hits ?? 0,
+            sourceVisits: counters.scoped_owned_copy_source_nodes ?? 0,
+            summarySteps: counters.scoped_owned_copy_summary_steps ?? 0,
+            proofInstances: counters.scoped_source_proof_instances,
+            proofHits: counters.scoped_source_proof_hits,
+            admissionVisits: counters.scoped_call_admission_nodes,
+            emissionVisits: counters.scoped_emission_expressions,
+            stats: result.stats,
+            executions,
+          };
+          await Deno.writeFile(
+            resolve(
+              evidence,
+              `render-${callers}-${executable.label}-${repetition}.wasm`,
+            ),
+            result.bytes,
+          );
+        }
+      } catch (error) {
+        sample.status = "failed_or_timeout";
+        sample.error = String(error);
+      } finally {
+        guest?.dispose();
+        await compiler?.dispose();
+      }
+      sample.wallMs = performance.now() - started;
+      sample.sourceSha256 = await hash(new TextEncoder().encode(source));
+      samples.push(sample);
+      await Deno.writeTextFile(
+        resolve(
+          evidence,
+          `render-${callers}-${executable.label}-${repetition}.json`,
+        ),
+        `${JSON.stringify(sample, null, 2)}\n`,
+      );
+      const { stats: _stats, executions: _executions, ...summary } = sample;
+      console.log(JSON.stringify(summary));
+    }
+  }
+}
+function median(values: number[]): number {
+  const sorted = values.toSorted((a, b) => a - b);
+  const middle = Math.floor(sorted.length / 2);
+  if (sorted.length % 2 !== 0) return sorted[middle];
+  return (sorted[middle - 1] + sorted[middle]) / 2;
+}
+const summaries = selectedCallers.map((callers) => {
+  const medians: Record<string, Record<string, number>> = {};
+  for (const compiler of compilers) {
+    const selected = samples.filter((sample) =>
+      sample.callers === callers && sample.label === compiler.label &&
+      sample.status === "complete"
+    );
+    if (selected.length !== repetitions) continue;
+    medians[compiler.label] = {};
+    for (
+      const field of [
+        "buildMs",
+        "wasmBytes",
+        "definitions",
+        "planHits",
+        "sourceVisits",
+        "summarySteps",
+        "proofInstances",
+        "proofHits",
+        "admissionVisits",
+        "emissionVisits",
+      ]
+    ) {
+      medians[compiler.label][field] = median(
+        selected.map((sample) => Number(sample[field])),
+      );
+    }
+  }
+  let compileImprovement = null;
+  let byteImprovement = null;
+  let decision = "incomplete_or_unpaired";
+  if (medians.baseline && medians.candidate) {
+    compileImprovement = 1 -
+      medians.candidate.buildMs / medians.baseline.buildMs;
+    byteImprovement = 1 -
+      medians.candidate.wasmBytes / medians.baseline.wasmBytes;
+    decision = "rejected_missing_measured_win";
+    if (
+      medians.candidate.definitions > 0 &&
+      (compileImprovement >= 0.2 || byteImprovement >= 0.3)
+    ) decision = "win_pending_full_qualification";
+    if (medians.candidate.definitions === 0) {
+      decision = "rejected_no_owned_copy_activation";
+    }
+    if (medians.candidate.summarySteps < callers + 5) {
+      decision = "rejected_requested_operation_not_fully_planned";
+    }
+    if (
+      values.operation === "owned" &&
+      callers > directCalls.emit_owned + directCalls.store_draw
+    ) decision = "rejected_extrapolated_owned_caller_count";
+  }
+  return { callers, medians, compileImprovement, byteImprovement, decision };
+});
+for (const compiler of compilers) {
+  assert.equal(
+    await hash(await Deno.readFile(compiler.path)),
+    compilerPins[compiler.label],
+    "Compiler changed during measurements",
+  );
+}
+const report = {
+  workload: "original_ink_render_owned_copy_graph",
+  diagnosticOnly: true,
+  evidence,
+  compilers,
+  compilerPins,
+  sourceFiles,
+  tier: values.tier,
+  workers: 1,
+  repetitions,
+  operation: values.operation,
+  selectedCallers,
+  sourceInventory: {
+    directCalls,
+    sites: callSites,
+    meaning:
+      "Direct namespace-qualified production source sites; not a reachability or dynamic call count.",
+  },
+  deadlineMs: 5000,
+  acceptance:
+    "At least 20% lower median build latency or 30% fewer emitted bytes, complete matched samples, activated owned-copy definitions and independent runtime assertions.",
+  limitations:
+    "This bounded slice executes original imported render.store_draw and render.emit_owned. It does not establish a whole-game result or guarantee activation of branch/operator readers.",
+  summaries,
+  samples,
+};
+await Deno.writeTextFile(
+  resolve(evidence, "result.json"),
+  `${JSON.stringify(report, null, 2)}\n`,
+);
+console.log(JSON.stringify({ evidence, summaries }));
+if (samples.some((sample) => sample.status !== "complete")) Deno.exitCode = 1;
