fn packageUnpackGivens(self:Engine&,binding:u32,value:u32,binders:const u32[:],rigids:const u32[:],goals:const blot_check_types::Obligation[:])->blot_error::Error {for goal,ordinal in goals {let quantifier,err=self.types.resolve(value,0);if err!=blot_error::Error.none {return err;}let predicate,err=self.types.substituteGoal(goal,binders,rigids);if err!=blot_error::Error.none {return err;}self.dictionary_givens.append(Engine_dictionary_givens{opening:binding,quantifier:quantifier,goal:ordinal as u32,predicate:predicate});}return blot_error::Error.none;}
fn Engine::resourceScope(self:Engine&,source:u32)->blot_support::Option<u32>,blot_error::Error {var parts:u32[3]=[0;3];var head=source;var count:i64=0;while self.tree.node(head).tag==blot_parse_ast::tag_apply && count<parts.len {let node=self.tree.node(head);parts[count]=node.b;count+=1;head=node.a;while self.tree.node(head).tag==blot_parse_ast::tag_group {head=self.tree.node(head).a;}}let syntax=self.tree.node(head);if syntax.tag!=blot_parse_ast::tag_intrinsic {return blot_support::none<u32>(),blot_error::Error.none;}let name=self.pool.get(syntax.a);let acquire=name=="@resource.acquire";let release=name=="@resource.release";if !acquire && !release && name!="@resource.scope" {return blot_support::none<u32>(),blot_error::Error.none;}let result,err=resourceApplication(self,source,head,parts[..count],acquire,release);return blot_support::some(result),err;}
fn resourceApplication(self:Engine&,source:u32,head:u32,parts:const u32[:],acquire:bool,release:bool)->u32,blot_error::Error {if acquire || release {var expected:i64=2;if release {expected=1;}if parts.len!=expected {return self.diagnosticFresh(Code.call_arity,source);}let row,err=resourceForeign(self,source);if err!=blot_error::Error.none {return 0,err;}if release {let input,err=self.expression(parts[0]);if err!=blot_error::Error.none {return 0,err;}let owner=self.types.node(self.types.head(input,0));if owner.tag!=blot_check_types::Tag.usage || owner.b!=blot_check_types::usageKindCode(blot_check_types::UsageKind.unique) || owner.c!=0 || !blot_check_cleanup_contracts::payloadNominal(self.types,self.nominals,owner.a) {let err=self.diagnostic(Code.cleanup_not_safe,parts[0]);if err!=blot_error::Error.none {return 0,err;}}let arrow,err=self.types.functionWithEffects(input,blot_check_types::unit,row);if err!=blot_error::Error.none {return 0,err;}self.expr_types[head]=arrow;return blot_check_types::unit,blot_error::Error.none;}let valid,err=resourceClosures(self,parts,0);if err!=blot_error::Error.none {return 0,err;}if !valid {return self.types.fresh();}let resource,err=resourceTypes(self,parts[1],parts[0],false);if err!=blot_error::Error.none {return 0,err;}self.usage_loans.append(UsageLoan{source:source,callback:0,parameter:0,region:0,mutable:false,acquire:parts[1],release:parts[0]});return resource.owner,blot_error::Error.none;}if parts.len!=3 {return self.diagnosticFresh(Code.call_arity,source);}let valid,err=resourceClosures(self,parts,1);if err!=blot_error::Error.none {return 0,err;}if !valid {return self.types.fresh();}let row,err=resourceForeign(self,source);if err!=blot_error::Error.none {return 0,err;}let resource,err=resourceTypes(self,parts[2],parts[1],true);if err!=blot_error::Error.none {return 0,err;}return resourceLoan(self,source,parts,resource);}
