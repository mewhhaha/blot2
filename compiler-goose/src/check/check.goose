    blot_parse_ast::tag_if_let_stmt,blot_parse_ast::tag_for_stmt=>{let err=self.collectAnnotationNames(node.b,depth+1);if err!=blot_error::Error.none {return err;}let metadata=self.tree.extra.items[node.c..];for child in metadata[..2] {let err=self.collectAnnotationNames(child,depth+1);if err!=blot_error::Error.none {return err;}}},
    blot_parse_ast::tag_case_expr,blot_parse_ast::tag_request_case=>{let inputs=self.tree.extra.items[node.a..node.a+2];for child in self.tree.list(blot_parse_ast::List{inputs[0],inputs[1]}) {let err=self.collectAnnotationNames(child,depth+1);if err!=blot_error::Error.none {return err;}}for child in self.tree.list(blot_parse_ast::List{node.b,node.c}) {let err=self.collectAnnotationNames(child,depth+1);if err!=blot_error::Error.none {return err;}}},
    blot_parse_ast::tag_case_arm=>{for child in self.tree.extra.items[node.c..node.c+2] {let err=self.collectAnnotationNames(child,depth+1);if err!=blot_error::Error.none {return err;}}},
    blot_parse_ast::tag_request_arm=>{for child in [node.a,node.c] {let err=self.collectAnnotationNames(child,depth+1);if err!=blot_error::Error.none {return err;}}},_=>{},
    }return blot_error::Error.none;
