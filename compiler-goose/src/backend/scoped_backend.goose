    var metadata_accesses: blot_backend_storage_recursive_admission::Access[>..<] = [];
    var metadata_events: WriterEvent[>..<] = [];
    var metadata_regions: i64[>..<] = [];
    var metadata_bundles: InputBundle[>..<] = [];
    var metadata_sharing: LoopSharing[>..<] = [];
    var metadata_reads: RootRead[>..<] = [];
    var metadata_traces: WriterTrace[>..<] = [];
    var metadata = Metadata { environments: environments,bytes: metadata_bytes,references: metadata_references,values: metadata_values,words: metadata_words,indexes: metadata_indexes,flags: metadata_flags,locals: metadata_locals,types: metadata_types,evidence: metadata_evidence,callables: metadata_callables,goals: metadata_goals,plans: metadata_plans,returned: metadata_returned,accesses: metadata_accesses,events: metadata_events,regions: metadata_regions,bundles: metadata_bundles,sharing: metadata_sharing,reads: metadata_reads,traces: metadata_traces,..};
    var record_fields: RecordField[>..<] = []; var record_entries = dictionary<RecordKey,RecordMetadata> {}; var records = RecordMetadataCache { entries: record_entries,fields: record_fields,..};
    reusable[] var argument_pool: TypeArgument[>..] = []; reusable[] var undo_pool: blot_backend_storage_type_arguments::Undo<TypeArgument>[>..] = []; reusable[] var position_pool: dictionary_slot<u64,blot_backend_storage_type_arguments::Positions>[>..] = []; reusable[] var snapshot_pool: TypeArgument[>..] = []; reusable[] var index_pool: i64[>..] = [];
    var argument_pools = blot_backend_storage_type_arguments::Pools<TypeArgument> { arguments: argument_pool,undo: undo_pool,positions: position_pool,snapshots: snapshot_pool,indexes: index_pool,..};
