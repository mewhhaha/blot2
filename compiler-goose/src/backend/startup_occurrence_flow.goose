// Bounded occurrence interpreter: immutable source and completed values supply evidence.
namespace blot_backend_startup_occurrence_flow;
import dictionary;
import support.error;
import support.option;
import support.pooled_buffer;
import support.pooled_map;
import support.structural;
import check.core;
import check.types;
import eval.core_eval;
import eval.eval_values;
import .scalar_ops;
import .runtime_ir;
import .collection_ops;
type Error=blot_error::Error;
type Module=blot_check_core::Module;
type BindingRef=blot_check_core::BindingRef;
type List=blot_check_core::List;
type Body=blot_check_core::Body;
type Session=blot_eval_core_eval::Session;
type Scalar=blot_backend_runtime_ir::Scalar;
type ScalarValue=blot_backend_scalar_ops::Value;
type ClosureValue=blot_eval_eval_values::ClosureValue;
type ClosureOrigin=blot_eval_eval_values::ClosureOrigin;
type CoreTag=blot_check_core::Tag;
type CoreOp=blot_check_core::Op;
type TypeTag=blot_check_types::Tag;
type ArrayOp=blot_check_core::ArrayOp;
type ValueId=u32;
enum EdgeKind {selected_call,runtime_read,retention}
struct Edge {root:BindingRef,target:BindingRef,weak:bool,kind:EdgeKind,unit:u32,node:u32}
enum FactKind {node,body_enter,body_complete,value_retained}
struct Fact {root:BindingRef,kind:FactKind,unit:u32,node:u32,weak:bool,identity:u32=0,value:u32=0}
struct Result {edges:Edge[:],facts:Fact[:]}
reusable[] var edge_runs:Edge[>..]=[];
reusable[] var fact_runs:Fact[>..]=[];
reusable[] var word_runs:u32[>..]=[];
fn deinit(self:Result&) {if self.edges.len!=0 {edge_runs.free_slice(self.edges);}if self.facts.len!=0 {fact_runs.free_slice(self.facts);}self=Result{edges:[],facts:[]};}
enum Provenance {inherit,ready,waiting}
enum Kind {scalar,product,record,nominal,array,closure}
struct Value {kind:Kind=Kind.scalar,scalar:ScalarValue=ScalarValue{..},known:bool=true,children:List=List{..},fields:List=List{..},nominal:blot_check_types::NominalIdentity=blot_check_types::NominalIdentity{..},tag:u32=0,closure:ClosureValue=ClosureValue{unit:0,identity:0,origin:ClosureOrigin.anonymous,..},actual:blot_support::Option<u32>=blot_support::Option<u32>{..},provenance:Provenance=Provenance.inherit}
struct Return {target:u32,value:ValueId}
struct Flow {value:ValueId=0,returning:bool=false,target:u32=0}
struct Expansion {unit:u32,identity:u32,origin:ClosureOrigin}
struct Site {owner:i64,node:u32}
struct ScalarInterface {parameter:ValueId,result:Scalar}
enum Match {yes,no,unknown}
let max_steps:i64=100000;
let max_depth:i64=128;
let max_values:i64=32768;
let max_children:i64=131072;
struct Edges {storage:Edge[:]=[],items:Edge[:]=[],len:i64=0,failure:Error=Error.none}
reusable[] var pool_Edges:Edge[>..]=[];
fn push(self:Edges&,value:Edge) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::push(self,value,pool_Edges);self.len=self.items.len;}
fn append(self:Edges&,values:const Edge[:]) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::append(self,values,pool_Edges);self.len=self.items.len;}
fn pop(self:Edges&)->Edge {assert(self.len>0);let value=self.items[self.len-1];blot_support_pooled_buffer::resize(self,self.len-1);self.len=self.items.len;return value;}
fn deinit(self:Edges&) {blot_support_pooled_buffer::deinit(self,pool_Edges);self.len=0;self.failure=Error.none;}
struct Facts {storage:Fact[:]=[],items:Fact[:]=[],len:i64=0,failure:Error=Error.none}
reusable[] var pool_Facts:Fact[>..]=[];
fn push(self:Facts&,value:Fact) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::push(self,value,pool_Facts);self.len=self.items.len;}
fn append(self:Facts&,values:const Fact[:]) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::append(self,values,pool_Facts);self.len=self.items.len;}
fn pop(self:Facts&)->Fact {assert(self.len>0);let value=self.items[self.len-1];blot_support_pooled_buffer::resize(self,self.len-1);self.len=self.items.len;return value;}
fn deinit(self:Facts&) {blot_support_pooled_buffer::deinit(self,pool_Facts);self.len=0;self.failure=Error.none;}
struct Values {storage:Value[:]=[],items:Value[:]=[],len:i64=0,failure:Error=Error.none}
reusable[] var pool_Values:Value[>..]=[];
fn push(self:Values&,value:Value) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::push(self,value,pool_Values);self.len=self.items.len;}
fn append(self:Values&,values:const Value[:]) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::append(self,values,pool_Values);self.len=self.items.len;}
fn pop(self:Values&)->Value {assert(self.len>0);let value=self.items[self.len-1];blot_support_pooled_buffer::resize(self,self.len-1);self.len=self.items.len;return value;}
fn deinit(self:Values&) {blot_support_pooled_buffer::deinit(self,pool_Values);self.len=0;self.failure=Error.none;}
struct Words {storage:u32[:]=[],items:u32[:]=[],len:i64=0,failure:Error=Error.none}
reusable[] var pool_Words:u32[>..]=[];
fn push(self:Words&,value:u32) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::push(self,value,pool_Words);self.len=self.items.len;}
fn append(self:Words&,values:const u32[:]) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::append(self,values,pool_Words);self.len=self.items.len;}
fn pop(self:Words&)->u32 {assert(self.len>0);let value=self.items[self.len-1];blot_support_pooled_buffer::resize(self,self.len-1);self.len=self.items.len;return value;}
fn deinit(self:Words&) {blot_support_pooled_buffer::deinit(self,pool_Words);self.len=0;self.failure=Error.none;}
struct Expansions {storage:Expansion[:]=[],items:Expansion[:]=[],len:i64=0,failure:Error=Error.none}
reusable[] var pool_Expansions:Expansion[>..]=[];
fn push(self:Expansions&,value:Expansion) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::push(self,value,pool_Expansions);self.len=self.items.len;}
fn append(self:Expansions&,values:const Expansion[:]) {if self.failure!=Error.none {return;}self.failure=blot_support_pooled_buffer::append(self,values,pool_Expansions);self.len=self.items.len;}
fn pop(self:Expansions&)->Expansion {assert(self.len>0);let value=self.items[self.len-1];blot_support_pooled_buffer::resize(self,self.len-1);self.len=self.items.len;return value;}
fn deinit(self:Expansions&) {blot_support_pooled_buffer::deinit(self,pool_Expansions);self.len=0;self.failure=Error.none;}
struct Bindings {table:blot_support_pooled_map::Map<u32,u32>=blot_support_pooled_map::Map<u32,u32>{..}}
reusable[] var pool_Bindings:dictionary_slot<u32,u32>[>..]=[];
fn get(self:const Bindings&,key:u32)->u32? {return blot_support_pooled_map::get(self.table,key);}
fn contains(self:const Bindings&,key:u32)->bool {return blot_support_pooled_map::contains(self.table,key);}
fn insert(self:Bindings&,key:u32,value:u32) {blot_support_pooled_map::insert(self.table,key,value,pool_Bindings);}
fn remove(self:Bindings&,key:u32) {blot_support_pooled_map::remove(self.table,key);}
fn deinit(self:Bindings&) {blot_support_pooled_map::deinit(self.table,pool_Bindings);}
struct Constants {table:blot_support_pooled_map::Map<BindingRef,ValueId>=blot_support_pooled_map::Map<BindingRef,ValueId>{..}}
reusable[] var pool_Constants:dictionary_slot<BindingRef,ValueId>[>..]=[];
fn get(self:const Constants&,key:BindingRef)->ValueId? {return blot_support_pooled_map::get(self.table,key);}
fn contains(self:const Constants&,key:BindingRef)->bool {return blot_support_pooled_map::contains(self.table,key);}
fn insert(self:Constants&,key:BindingRef,value:ValueId) {blot_support_pooled_map::insert(self.table,key,value,pool_Constants);}
fn remove(self:Constants&,key:BindingRef) {blot_support_pooled_map::remove(self.table,key);}
fn deinit(self:Constants&) {blot_support_pooled_map::deinit(self.table,pool_Constants);}
struct Preparing {table:blot_support_pooled_map::Map<BindingRef,bool>=blot_support_pooled_map::Map<BindingRef,bool>{..}}
reusable[] var pool_Preparing:dictionary_slot<BindingRef,bool>[>..]=[];
fn get(self:const Preparing&,key:BindingRef)->bool? {return blot_support_pooled_map::get(self.table,key);}
fn contains(self:const Preparing&,key:BindingRef)->bool {return blot_support_pooled_map::contains(self.table,key);}
fn insert(self:Preparing&,key:BindingRef,value:bool) {blot_support_pooled_map::insert(self.table,key,value,pool_Preparing);}
fn remove(self:Preparing&,key:BindingRef) {blot_support_pooled_map::remove(self.table,key);}
fn deinit(self:Preparing&) {blot_support_pooled_map::deinit(self.table,pool_Preparing);}
struct Frame {values:Bindings=Bindings{..},possible_return:blot_support::Option<Return>=blot_support::Option<Return>{..}}
fn deinit(self:Frame&) {self.values.deinit();self.possible_return=blot_support::none<Return>();}
struct Walk {units:const Module[:],session:Session&,root:BindingRef=BindingRef{..},edges:Edges=Edges{..},facts:Facts=Facts{..},values:Values=Values{..},children:Words=Words{..},fields:Words=Words{..},constants:Constants=Constants{..},preparing:Preparing=Preparing{..},expansions:Expansions=Expansions{..},steps:i64=0,depth:i64=0,prepared_partial:ValueId=0,failure:Error=Error.none}
fn deinit(self:Walk&) {self.edges.deinit();self.facts.deinit();self.values.deinit();self.children.deinit();self.fields.deinit();self.constants.deinit();self.preparing.deinit();self.expansions.deinit();}
fn failed(self:Walk&)->bool {if self.failure==Error.none {for error in [self.edges.failure,self.facts.failure,self.values.failure,self.children.failure,self.fields.failure,self.expansions.failure] {if error!=Error.none {self.failure=error;break;}}}return self.failure!=Error.none;}
fn bad(self:Walk&)->u32 {if self.failure==Error.none {self.failure=Error.incomplete;}return 0;}
fn charge(self:Walk&)->bool {if self.failed() {return false;}if self.steps>=max_steps || self.depth>=max_depth {self.bad();return false;}self.steps+=1;return true;}
fn unitId(self:const Walk&,owner:i64)->u32 {let unit=self.units[owner].unit;if unit!=0 {return unit;}return (owner+1) as u32;}
fn ownerOf(self:Walk&,unit:u32,local:blot_support::Option<i64>)->i64 {if self.failed() {return 0;}if unit==0 {if local.present {return local.value;}if self.units.len==1 {return 0;}self.bad();return 0;}for module,index in self.units {if self.unitId(index)==unit {return index;}}self.bad();return 0;}
fn normalize(self:Walk&,owner:blot_support::Option<i64>,initial:BindingRef)->BindingRef {var target=initial;var local=owner;for index in 0..128 {let producer=self.ownerOf(target.unit,local);if self.failed() {return BindingRef{..};}let module .= self.units[producer];if target.binding==0 || target.binding>=module.bindings.len {self.bad();return BindingRef{..};}let binding=module.binding(target.binding);if binding.kind!=blot_check_core::BindingKind.external {return BindingRef{unit:self.unitId(producer),binding:target.binding};}target=binding.target;local=blot_support::some(producer);}self.bad();return BindingRef{..};}
fn emit(self:Walk&,site:Site,target:BindingRef,kind:EdgeKind,weak:bool,observe:bool) {if !observe || self.failed() {return;}self.edges.push(Edge{root:self.root,target:target,weak:weak,kind:kind,unit:self.unitId(site.owner),node:site.node});}
fn fact(self:Walk&,site:Site,kind:FactKind,weak:bool,identity:u32,actual:blot_support::Option<u32>,observe:bool) {if !observe || self.failed() {return;}var value:u32=0;if actual.present {value=actual.value;}self.facts.push(Fact{root:self.root,kind:kind,unit:self.unitId(site.owner),node:site.node,weak:weak,identity:identity,value:value});}
fn add(self:Walk&,value:Value)->ValueId {if self.failed() {return 0;}if self.values.len>=max_values {return self.bad();}let id=self.values.len as ValueId;self.values.push(value);return id;}
fn aggregate(self:Walk&,input:Value,children:const ValueId[:],fields:const u32[:])->ValueId {if self.failed() {return 0;}if children.len>max_children-self.children.len || fields.len>max_children-self.fields.len {return self.bad();}var value=input;value.children=List{start:self.children.len as u32,len:children.len as u32};value.fields=List{start:self.fields.len as u32,len:fields.len as u32};self.children.append(children);self.fields.append(fields);return self.add(value);}
fn mode(value:Value,inherited:bool)->bool {if value.provenance==Provenance.ready {return true;}if value.provenance==Provenance.waiting {return false;}return inherited;}
fn boundary(self:Walk&,id:ValueId,provenance:Provenance)->ValueId {if self.failed() {return 0;}var value=self.values.items[id];value.provenance=provenance;return self.add(value);}
fn context(self:Walk&,id:ValueId,weak:bool)->ValueId {if self.failed() {return 0;}if !weak || self.values.items[id].provenance!=Provenance.inherit {return id;}return self.boundary(id,Provenance.ready);}
fn scalarType(self:Walk&,owner:i64,ty:u32,known:bool,bits:u32)->ValueId {if self.failed() {return 0;}let module .= self.units[owner];if ty>=module.types.nodes.len {return self.bad();}let tag=module.types.node(ty).tag;var scalar=blot_backend_runtime_ir::SC_unit;if tag==TypeTag.boolean {scalar=blot_backend_runtime_ir::SC_bool;}else if tag==TypeTag.unsigned32 {scalar=blot_backend_runtime_ir::SC_u32;}else if tag==TypeTag.floating32 {scalar=blot_backend_runtime_ir::SC_f32;}else if tag!=TypeTag.unit {return self.bad();}return self.add(Value{scalar:ScalarValue{scalar:scalar,bits:bits},known:known || scalar==blot_backend_runtime_ir::SC_unit,..});}
fn placeholder(self:Walk&,owner:i64,ty:u32)->ValueId {return self.scalarType(owner,ty,false,0);}
fn body(self:Walk&,target:BindingRef)->Body {let owner=self.ownerOf(target.unit,blot_support::none<i64>());if self.failed() {return Body{..};}let module .= self.units[owner];if target.binding>=module.bindings.len {self.bad();return Body{..};}let binding=module.binding(target.binding);if binding.body_id==0 || binding.body_id>=module.bodies.len {self.bad();return Body{..};}return module.bodies[binding.body_id];}
fn named(self:Walk&,target:BindingRef)->ValueId {return self.add(Value{kind:Kind.closure,closure:ClosureValue{unit:target.unit,identity:target.binding,origin:ClosureOrigin.named,..},..});}
fn constant(self:Walk&,target:BindingRef)->ValueId {if self.failed() {return 0;}let cached .= self.constants.get(target);if cached {return cached;}if self.preparing.contains(target) {return self.bad();}let owner=self.ownerOf(target.unit,blot_support::none<i64>());let declaration=self.body(target);if self.failed() {return 0;}if declaration.runtime {return self.bad();}let actual,present,error=self.session.cachedBindingValue(target);if error!=Error.none {self.failure=Error.incomplete;if error==Error.out_of_memory {self.failure=error;}return 0;}if declaration.is_function {var result=self.named(target);if present {result=self.alignActual(actual,result);}if !self.failed() {self.constants.insert(target,result);}return result;}if !present {return self.bad();}self.preparing.insert(target,true);var frame=Frame{..};let result=self.expression(owner,declaration.root,frame,false,false);frame.deinit();self.preparing.remove(target);if self.failed() {return 0;}if result.returning {return self.bad();}let value=self.alignActual(actual,result.value);if !self.failed() {self.constants.insert(target,value);}return value;}
fn alignActual(self:Walk&,actual:u32,symbolic:ValueId)->ValueId {if !self.charge() {return 0;}self.depth+=1;let value=alignActualInner(self,actual,symbolic);self.depth-=1;return value;}
fn alignActualInner(self:Walk&,actual:u32,symbolic:ValueId)->ValueId {if actual>=self.session.storage.values.len {return self.bad();}let info=self.session.valueInfo(actual);var value=self.values.items[symbolic];var kind=Kind.scalar;let source=info.kind;if source==blot_eval_eval_values::ValueKind.product {kind=Kind.product;}else if source==blot_eval_eval_values::ValueKind.record {kind=Kind.record;}else if source==blot_eval_eval_values::ValueKind.nominal {kind=Kind.nominal;}else if source==blot_eval_eval_values::ValueKind.array || source==blot_eval_eval_values::ValueKind.list {kind=Kind.array;}else if source==blot_eval_eval_values::ValueKind.closure {kind=Kind.closure;}else if source!=blot_eval_eval_values::ValueKind.scalar {return self.bad();}if kind!=value.kind || info.len!=value.children.len {return self.bad();}if kind==Kind.scalar {if !value.known || value.scalar.scalar!=info.scalar || value.scalar.bits!=info.bits {return self.bad();}}else if kind==Kind.closure {let metadata=self.session.closureInfo(actual);let source=value.closure;if metadata.origin!=source.origin || metadata.unit!=source.unit || metadata.identity!=source.identity || metadata.applied!=source.applied {return self.bad();}value.closure=metadata;}else if kind==Kind.nominal {if value.nominal.unit!=(info.nominal>>32) as! u32 || value.nominal.decl!=info.nominal as! u32 || value.tag!=info.bits {return self.bad();}}let children=word_runs.alloc_slice(info.len);for &child,index in children {child=self.alignActual(self.session.storage.children.items[info.start+index],self.children.items[value.children.start+index]);}let fields=word_runs.alloc_slice(value.fields.len);for &field,index in fields {field=self.fields.items[value.fields.start+index];}if kind==Kind.record {if actual>=self.session.storage.value_records.len {self.bad();}else {let layout_id=self.session.storage.value_records.items[actual];if layout_id>=self.session.storage.record_layouts.len {self.bad();}else {let layout=self.session.storage.record_layouts.items[layout_id];if layout.len!=fields.len || self.session.storage.field_names.items[layout.start..layout.start+layout.len]!=fields {self.bad();}}}}value.actual=blot_support::some(actual);let result=self.aggregate(value,children,fields);word_runs.free_slice(children);word_runs.free_slice(fields);return result;}
fn enter(self:Walk&,metadata:ClosureValue) {if self.failed() {return;}let key=Expansion{unit:metadata.unit,identity:metadata.identity,origin:metadata.origin};for active in self.expansions.items {if active==key {self.bad();return;}}if self.expansions.len>=max_depth {self.bad();return;}self.expansions.push(key);}

fn invoke(self:Walk&,function:ValueId,arguments:const ValueId[:],site:Site,inherited:bool,observe:bool,retention:bool)->ValueId {return self.invokeScalarInterface(function,arguments,site,inherited,observe,retention,blot_support::none<ScalarInterface>());}
fn invokeScalarInterface(self:Walk&,function:ValueId,arguments:const ValueId[:],site:Site,inherited:bool,observe:bool,retention:bool,expected:blot_support::Option<ScalarInterface>)->ValueId {if !self.charge() {return 0;}let value=self.values.items[function];if value.kind!=Kind.closure {return self.bad();}let weak=mode(value,inherited);let metadata=value.closure;let owner=self.ownerOf(metadata.unit,blot_support::none<i64>());if self.failed() {return 0;}let module .= self.units[owner];if metadata.origin==ClosureOrigin.operation {return self.bad();}if metadata.origin==ClosureOrigin.primitive {if metadata.identity>=module.primitives.len {return self.bad();}let primitive=module.primitives[metadata.identity];if metadata.applied!=value.children.len || metadata.applied>primitive.arity || arguments.len>primitive.arity-metadata.applied {return self.bad();}let count=value.children.len+arguments.len;let supplied=word_runs.alloc_slice(count);for child,index in self.children.items[value.children.start..value.children.start+value.children.len] {supplied[index]=child;}for argument,index in arguments {supplied[value.children.len+index]=argument;}var result:ValueId=0;if count!=primitive.arity {var partial=value;partial.closure.applied=count as u32;partial.actual=blot_support::none<u32>();result=self.aggregate(partial,supplied,[]);}else if primitive.kind==blot_check_core::PrimitiveKind.array {result=self.arrayValues(primitive.array_op,supplied,site,weak,observe);}else {var second:ValueId=0;if count!=1 {second=supplied[1];}result=self.scalar(primitive.op,supplied[0],second);}word_runs.free_slice(supplied);return result;}if metadata.origin==ClosureOrigin.constructor {if metadata.applied!=0 || arguments.len!=1 || metadata.identity>=module.constructors.len {return self.bad();}return self.construct(owner,metadata.identity,blot_support::some(arguments[0]),true);}
 var frame=Frame{..};let body_root=prepareInvocation(self,value,arguments,site,weak,observe,retention,expected,owner,frame);if self.failed() {frame.deinit();return 0;}if body_root==0 {frame.deinit();return self.prepared_partial;}self.enter(metadata);if self.failed() {frame.deinit();return 0;}let body_site=Site{owner:owner,node:body_root};self.fact(body_site,FactKind.body_enter,weak,metadata.identity,value.actual,observe);let outcome=self.expression(owner,body_root,frame,weak,observe);self.expansions.pop();let pending_return=frame.possible_return.present;frame.deinit();if self.failed() {return 0;}if outcome.returning || pending_return {return self.bad();}if expected.present {let result=self.values.items[outcome.value];if result.kind!=Kind.scalar || result.scalar.scalar!=expected.value.result {return self.bad();}}self.fact(body_site,FactKind.body_complete,weak,metadata.identity,value.actual,observe);return self.context(outcome.value,weak);
}
// The fixed partial-result slot is read immediately, before any recursive body call.
fn prepareInvocation(self:Walk&,value:Value,arguments:const ValueId[:],site:Site,weak:bool,observe:bool,retention:bool,expected:blot_support::Option<ScalarInterface>,owner:i64,frame:Frame&)->u32 {let metadata=value.closure;let module .= self.units[owner];if metadata.origin==ClosureOrigin.named {let target=self.normalize(blot_support::none<i64>(),BindingRef{unit:metadata.unit,binding:metadata.identity});if self.failed() {return 0;}if target.unit!=metadata.unit || target.binding!=metadata.identity {return self.bad();}let declaration=self.body(target);if self.failed() {return 0;}if !declaration.is_function {return self.bad();}let parameters=module.bodyParameters(declaration);if metadata.applied!=value.children.len || metadata.applied>parameters.len || arguments.len>parameters.len-metadata.applied {return self.bad();}let count=value.children.len+arguments.len;if expected.present && (!retention || parameters.len-count!=1) {return self.bad();}if count<parameters.len && !retention {let supplied=word_runs.alloc_slice(count);for child,index in self.children.items[value.children.start..value.children.start+value.children.len] {supplied[index]=child;}for argument,index in arguments {supplied[value.children.len+index]=argument;}var partial=value;partial.closure.applied=count as u32;partial.actual=blot_support::none<u32>();let result=self.aggregate(partial,supplied,[]);word_runs.free_slice(supplied);self.prepared_partial=self.context(result,weak);return 0;}for parameter,index in parameters {var bound:ValueId=0;if index<value.children.len {bound=self.children.items[value.children.start+index];}else if index<count {bound=arguments[index-value.children.len];}else if expected.present {bound=self.interfaceParameter(owner,parameter.ty,expected.value.parameter);}else {bound=self.placeholder(owner,parameter.ty);}if self.failed() {return 0;}frame.values.insert(parameter.binding,bound);}self.emit(site,target,EdgeKind.selected_call,weak,observe);if retention && observe && self.edges.len!=0 {self.edges.items[self.edges.len-1].kind=EdgeKind.retention;}return declaration.root;}
