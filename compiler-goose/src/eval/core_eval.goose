recursive fn parameterOperand(module: const Module&,id: u32,binding: u32,depth: i64) -> bool { if id==0||depth>=256 { return false; } let n=module.node(id); if n.tag==blot_check_core::Tag.reference { let reference=module.reference(id); if reference.unit!=0&&reference.unit!=module.unit { return false; } if reference.binding==binding { return true; } let source=module.binding(reference.binding); if source.kind==blot_reuse_principal_interface::Kind.local&&source.initializer!=0 { return parameterOperand(module,source.initializer,binding,depth+1); } } if n.tag==blot_check_core::Tag.project { return parameterOperand(module,n.a,binding,depth+1); } return false; }
fn callbackUseOrigin(self_: ClosureRegion&,owner: i64,id: u32) -> blot_support::Option<SourceLocation> { if id==0 { return blot_support::none<SourceLocation>(); } let module=self_.session.units[owner]; let span=module.span(id); let n=module.node(id); for callback in self_.scratch.callback_origins.items { if callback.owner!=owner||callback.span.start>span.start||callback.span.end<span.end { continue; } if n.tag==blot_check_core::Tag.call { for argument in module.children(id) { if parameterOperand(module,argument,callback.parameter,0) { return blot_support::some(callback.origin); } } } else if n.tag==blot_check_core::Tag.associated||n.tag==blot_check_core::Tag.scalar { if parameterOperand(module,n.a,callback.parameter,0)||parameterOperand(module,n.b,callback.parameter,0) { return blot_support::some(callback.origin); } } else if n.tag==blot_check_core::Tag.project&&parameterOperand(module,n.a,callback.parameter,0) { return blot_support::some(callback.origin); } } return blot_support::none<SourceLocation>(); }
