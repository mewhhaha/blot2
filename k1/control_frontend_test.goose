import control_frontend;
import control_validate;
import control_core;
import lexer;
fn main() {
    let s = "let f: Bool -> U32 = fn x => do:\n  if x && #False:\n    return 4294967295\n  else:\n    return 0\n";
    let result = control_frontend::parse(s);
    assert(result.status == 0);
    assert(control_validate::verify(s,result.program));
    var cursor = control_frontend::Cursor { token: lexer::Token { kind: 1, start: 0, end: 1 } };
    let bad_parameter = lexer::Token { kind: 1, start: -1, end: 1 };
    let ignored = control_frontend::atom(s,cursor,bad_parameter);
    assert(cursor.status == 1 && ignored.kind == 0);
    cursor = control_frontend::Cursor { token: lexer::Token { kind: 1, start: 2, end: 1 } };
    let good_parameter = lexer::Token { kind: 1, start: result.program.param_start, end: result.program.param_end };
    let ignored_second = control_frontend::atom(s,cursor,good_parameter);
    assert(cursor.status != 0 && ignored_second.kind == 0);
    var reader = control_validate::Reader { t: lexer::Token { kind: 2, start: -1, end: 1 } };
    assert(!control_validate::literal(s,reader,-1,1,0));
    reader = control_validate::Reader { t: lexer::Token { kind: 1, start: 0, end: 1 } };
    var bad_core = result.program; bad_core.param_start = -1;
    assert(!control_validate::atom(s,reader,bad_core,0,1,1));
    var forged = result.program; forged.left_kind = 2; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.op = 2; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.yes = 0; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.no_start = -1; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.name_start = -1; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.function_start += 1; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.if_start += 1; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.yes_target = 2; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.no_target = 0; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.yes_return_start += 1; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.no_return_end -= 1; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.param_end = s.len + 1; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.right_kind = 1; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.right_end = forged.right_start; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.op_start = forged.left_start; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.op = 0; assert(!control_validate::verify(s,forged));
    forged = result.program; forged.no = 1; assert(!control_validate::verify(s,forged));
    assert(!control_validate::verify("let f: Bool -> U32 = fn x => do:\n  if x || #False:\n    return 4294967295\n  else:\n    return 0\n", result.program));
    assert(!control_validate::verify("let f: Bool -> U32 = fn x => do:\n  if y && #False:\n    return 4294967295\n  else:\n    return 0\n", result.program));
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n  if x:\n    return 1\n").status == 4);
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n  if x:\n    return 1\n  return 2\n").status == 2);
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n  if y:\n    return 1\n  else:\n    return 2\n").status == 3);
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n  if x:\n    1\n  else:\n    return 2\n").status == 4);
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n  if x:\n    return 1\n  else:\n    return 4294967296\n").status != 0);
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n  if x:\n    return 1\n    return 2\n  else:\n    return 3\n").status != 0);
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n  if x && y:\n    return 1\n  else:\n    return 2\n").status == 3);
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n  if x && # True:\n    return 1\n  else:\n    return 2\n").status != 0);
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n  if x && #False || x:\n    return 1\n  else:\n    return 2\n").status != 0);
    assert(control_frontend::parse("let f: Bool -> U32 = fn x => do:\n if x:\n    return 1\n  else:\n    return 2\n").status != 0);
    let crlf = "// leading\r\nlet f: Bool -> U32 = fn x => do:\r\n  if x || #True: // comment\r\n    return 0\r\n  else:\r\n    return 1\r\n";
    let crlf_result = control_frontend::parse(crlf);
    assert(crlf_result.status == 0 && control_validate::verify(crlf,crlf_result.program));
    print("control frontend laws passed");
}
