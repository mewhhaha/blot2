fn find<G>(self:State&,g:G&,request:Request)->blot_support::Option<u32>,Error {if !self.enabled || !self.old.executable_queries_complete {return blot_support::none<u32>(),Error.none;}var indexed=request;match indexed {Request.named item=>{var key=item.key;let prior=self.priorUnit(key.target.unit);if !prior.present {return blot_support::none<u32>(),Error.none;}key.target.unit=prior.value;indexed=Request.named{key:key,..};},Request.closure item=>{var key=item.key;let prior=self.priorUnit(key.unit);if !prior.present {return blot_support::none<u32>(),Error.none;}key.unit=prior.value;indexed=Request.closure{key:key,..};},_=>{return blot_support::none<u32>(),Error.none;},}var candidates=self.old.executable_queries.candidates(blot_reuse_executable_query::fragmentFingerprint(indexed),blot_reuse_semantic_query_table::Order.oldest_first);loop {let position=candidates.next();if !position.present {break;}self.stats.lookup_positions+=1;let record=self.old.executable_queries.records[position.value];if !self.sameOrigin(record.key.request,request) {continue;}let job=record.value.job;if job==0 || self.blocked[job-1] {continue;}let matched,error=self.importer.matches(g,record.key.request,request);if error!=Error.none {return blot_support::none<u32>(),error;}if !matched {continue;}var dependencies=true;for target in record.dependencies.inline_bodies {if !self.importer.admitsBody(target) {dependencies=false;break;}}if !dependencies {continue;}for read in record.dependencies.static_reads {let matched,error=self.matchStatic(g,read);if error!=Error.none {return blot_support::none<u32>(),error;}if !matched {dependencies=false;break;}}if !dependencies {continue;}self.stats.candidates+=1;let admitted,error=self.admit(g,job);if error!=Error.none {return blot_support::none<u32>(),error;}if admitted {return blot_support::some(job),Error.none;}self.stats.declined+=1;}return blot_support::none<u32>(),Error.none;}
fn matchStatic<G>(self:State&,g:G&,read:StaticRead)->bool,Error {if self.static_matches.contains(staticKey(read)) {return true,Error.none;}if !self.importer.code_gate.present {return false,Error.none;}let gate .= self.importer.code_gate.value.semantic;if !gate.enabled || read.target.unit==0 || read.target.unit>self.importer.unit_map.len {return false,Error.none;}let target=blot_check_core::BindingRef{unit:self.importer.unit_map[read.target.unit-1],binding:read.target.binding,..};if target.unit==0 {return false,Error.none;}let current,error=g.evaluator.richValue(target);if error!=Error.none {return false,oomOnly(error);}let inspection,error=blot_reuse_source_value_template::inspectRootsWithRows(self.pools(),gate,[read.value],blot_reuse_source_value_template::RowPolicy.source_declared);if error!=Error.none || !inspection.plan.present {return false,error;}var plan=inspection.plan.value;let matched,error=self.matchValues(g,plan,read.value,current);plan.deinit();if error!=Error.none || !matched {return false,error;}self.static_matches.insert(staticKey(read),current);return true,Error.none;}
fn localAddress(self:const State&,address:u32,owner:u32)->bool {if address<blot_runtime_arena_runtime::metadata_bytes {return self.arena.present;}var cursor=self.emissionAt(self.starts[owner-1]);while cursor<self.old.emission.records.len {let record=self.old.emission.records.items[cursor];cursor+=1;if record.sequence>=self.ends[owner-1] {break;}if record.owner!=owner {continue;}match record.event {EmitEvent.data item=>{if address>=item.address && address<item.address+item.bytes.len {return true;}},_=>{},}}return address==0;}
fn staticHelper(self:const State&,function:FunctionArtifact,owner:u32)->bool {return function.role==FunctionRole.static_closure && owner!=0 && function.resource_owner==owner && !self.blocked[owner-1] && self.old.metadata.jobs.items[owner-1].hasStaticValues();}
fn admitJobRequest<G>(self:State&,g:G&,id:u32)->bool,Error {self.stats.request_checks+=1;if id==0 || id>self.requests_admitted.len {return false,Error.none;}if self.requests_admitted[id-1] && g.owner_id!=0 && self.importer.generator_owner==g.owner_id {self.stats.request_hits+=1;return true,Error.none;}let request=self.old.metadata.jobs.items[id-1].request;let selected,error=self.importer.importRequest(g,request);if error!=Error.none || !selected.present {return false,error;}self.requests_admitted[id-1]=false;match request {Request.named=>{self.requests_admitted[id-1]=true;},Request.closure item=>{self.requests_admitted[id-1]=item.key.static_values==0;},_=>{},}return true,Error.none;}
