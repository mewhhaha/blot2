fn loanBody(self: Walker&, source: u32, node: blot_check_core::Node, depth: i64) -> Error { var binding: u32 = 0; if self.module.node(node.a).tag == Tag.reference { let ref = self.module.reference(node.a); if ref.unit == 0 || ref.unit == self.module.unit { binding = ref.binding; } } let entry .= self.state(binding);
