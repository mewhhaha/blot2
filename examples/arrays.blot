import * as array from "std/array"

const numbers: Array U32 = #[10, 20, 12]
entry const expected = array.fold_left U32.add 0 numbers

entry const answer = fn () => array.fold_left U32.add 0 numbers

entry const unchanged = fn () => do:
  let original = #[1, 2, 3]
  let updated = original
  updated[1] := 40
  return original[1] + updated[1]

entry const checked = fn index => Maybe.unwrap_or 0 $ numbers.get(index)

entry const nested = fn () => do:
  let rows: Array (U32, Bool) = #[(42, #True), (7, #False)]
  let (value, _) = rows[0]
  return value
