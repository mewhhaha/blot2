 CoreTag.closure => {if n.a>=module.closures.len {self.bad();return Flow{..};}let template=module.closures[n.a];let captures=word_runs.alloc_slice(template.captures.len);for binding,index in module.extra[template.captures.start..template.captures.start+template.captures.len] {let captured .= frame.values.get(binding);if !captured {word_runs.free_slice(captures);self.bad();return Flow{..};}captures[index]=captured;}let result=self.aggregate(Value{kind:Kind.closure,closure:ClosureValue{unit:self.unitId(owner),identity:n.a,origin:ClosureOrigin.anonymous,..},..},captures,[]);word_runs.free_slice(captures);return Flow{value:result,..};},
 CoreTag.block_,CoreTag.suite => {for child in module.children(id) {let result=self.expression(owner,child,frame,weak,observe);if self.failed() {return Flow{..};}if result.returning {if n.tag==CoreTag.block_ && result.target==id {var value=result.value;if frame.possible_return.present {let possible=frame.possible_return.value;if possible.target!=id {self.bad();return Flow{..};}value=self.join(value,possible.value);frame.possible_return=blot_support::none<Return>();}return Flow{value:value,..};}return result;}}return Flow{..};},
