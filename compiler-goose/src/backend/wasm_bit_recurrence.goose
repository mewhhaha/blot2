// Exact affine bit transforms for a source-authorized fixed-trip U32 carry.
namespace blot_backend_wasm_bit_recurrence;
import .runtime_ir;
import .wasm;
import .optimizer_buffers;
import support.error;
import support.option;
type Error=blot_error::Error;
type Instruction=blot_backend_runtime_ir::Instruction;
type Op=blot_backend_runtime_ir::Op;
type Module=blot_backend_wasm::Module;
type Output=blot_backend_runtime_ir::DetachedBody;
type Code=blot_backend_optimizer_buffers::Code;
let absent:u32=0xffffffff;
struct Word {valid:bool=false,constant:u32=0,columns:u32[32]=[0;32]}
type Transform=Word;
fn literal(bits:u32)->Word {return Word{valid:true,constant:bits,..};}
fn input()->Word {var result=literal(0);for &column,bit in result.columns {column=1 as u32<<bit as u32;}return result;}
fn evaluate(self_:Word,value:u32)->u32 {var result=self_.constant;for column,bit in self_.columns {if value&(1 as u32<<bit as u32)!=0 {result^=column;}}return result;}
fn known(self_:Word)->blot_support::Option<u32> {if !self_.valid {return blot_support::none<u32>();}for column in self_.columns {if column!=0 {return blot_support::none<u32>();}}return blot_support::some(self_.constant);}
fn xor(left:Word,right:Word)->Word {if !left.valid || !right.valid {return Word{..};}var result=literal(left.constant^right.constant);for &column,index in result.columns {column=left.columns[index]^right.columns[index];}return result;}
fn mask(self_:Word,bits:u32)->Word {var result=self_;result.constant&=bits;for &column in result.columns {column&=bits;}return result;}
fn shift(self_:Word,amount:u32,left:bool)->Word {let bits=amount&31;var result=self_;if left {result.constant<<=bits;}else {result.constant>>=bits;}for &column in result.columns {if left {column<<=bits;}else {column>>=bits;}}return result;}
fn condition(self_:Word)->blot_support::Option<Word> {if !self_.valid {return blot_support::none<Word>();}let value=self_.known();if value.present {var bit:u32=0;if value.value!=0 {bit=1;}return blot_support::some(literal(bit));}var bits=self_.constant;for column in self_.columns {bits|=column;}if bits==0 || bits&(bits-1)!=0 {return blot_support::none<Word>();}var amount:u32=0;while bits&1==0 {bits>>=1;amount+=1;}return blot_support::some(self_.shift(amount,false));}
fn negate(value:u32)->u32 {return (0x100000000 as u64-value as u64) as! u32;}
fn choose(predicate:Word,yes:Word,no:Word)->Word {let fixed=predicate.known();if fixed.present {if fixed.value!=0 {return yes;}return no;}if yes==no {return yes;}if !yes.valid || !no.valid || yes.columns!=no.columns {return Word{..};}let selected=predicate.condition();if !selected.present {return Word{..};}let bits=selected.value;let difference=yes.constant^no.constant;var result=no;result.constant^=negate(bits.constant)&difference;for &column,index in result.columns {column^=negate(bits.columns[index])&difference;}return result;}
fn repeat(self_:Word,count:u32)->Word {var result=input();for iteration in 0..count {var next=literal(self_.evaluate(result.constant));for &column,index in next.columns {column=self_.evaluate(result.columns[index])^self_.constant;}result=next;}return result;}
struct Slot {id:u32,value:Word}
enum Flow {normal,branch,return_}
struct State {slots:Slot[96]=[default<Slot>();96],len:i64=0,stack:Word[64]=[Word{..};64],height:i64=0,forbidden:u32=absent,flow:Flow=Flow.normal,label:u32=0}
fn get(self_:const State&,id:u32)->Word {for slot in self_.slots[..self_.len] {if slot.id==id {return slot.value;}}return Word{..};}
fn set(self_:State&,id:u32,value:Word)->bool {for &slot in self_.slots[..self_.len] {if slot.id==id {slot.value=value;return true;}}if self_.len==self_.slots.len {return false;}self_.slots[self_.len]=Slot{id:id,value:value,..};self_.len+=1;return true;}
fn push(self_:State&,value:Word)->bool {if self_.height==self_.stack.len {return false;}self_.stack[self_.height]=value;self_.height+=1;return true;}
fn pop(self_:State&)->blot_support::Option<Word> {if self_.height==0 {return blot_support::none<Word>();}self_.height-=1;return blot_support::some(self_.stack[self_.height]);}
fn binary(op:Op,left:Word,right:Word)->blot_support::Option<Word> {match op {blot_backend_runtime_ir::OP_i32_xor=>{return blot_support::some(left.xor(right));},blot_backend_runtime_ir::OP_i32_and=>{let bits=right.known();if bits.present {return blot_support::some(left.mask(bits.value));}let bits=left.known();if bits.present {return blot_support::some(right.mask(bits.value));}},blot_backend_runtime_ir::OP_i32_or=>{let bits=right.known();if bits.present {return blot_support::some(left.mask(~bits.value).xor(literal(bits.value)));}let bits=left.known();if bits.present {return blot_support::some(right.mask(~bits.value).xor(literal(bits.value)));}},blot_backend_runtime_ir::OP_i32_shl,blot_backend_runtime_ir::OP_i32_shr_u=>{let amount=right.known();if amount.present {return blot_support::some(left.shift(amount.value,op==blot_backend_runtime_ir::OP_i32_shl));}},blot_backend_runtime_ir::OP_i32_eq,blot_backend_runtime_ir::OP_i32_ne=>{let tested=left.xor(right).condition();if !tested.present {return blot_support::none<Word>();}var result=tested.value;if op==blot_backend_runtime_ir::OP_i32_eq {result=result.xor(literal(1));}return blot_support::some(result);},blot_backend_runtime_ir::OP_i32_sub=>{let value=left.known();if value.present && value.value==0 {let tested=right.condition();if !tested.present || tested.value!=right {return blot_support::none<Word>();}return blot_support::some(choose(tested.value,literal(0xffffffff),literal(0)));}},_=>{},}return blot_support::none<Word>();}
struct Limits {instructions:i64=1024}
fn I(op:Op,operand:u32=0)->Instruction {return Instruction{operand:operand,op:op,..};}
fn canonicalLoop(code:const Instruction[:],body_start:i64,body_end:i64,iterator:u32,end:u32)->bool {let prefix=[I(blot_backend_runtime_ir::OP_block),I(blot_backend_runtime_ir::OP_loop),I(blot_backend_runtime_ir::OP_local_get,iterator),I(blot_backend_runtime_ir::OP_local_get,end),I(blot_backend_runtime_ir::OP_i32_ge_u),I(blot_backend_runtime_ir::OP_br_if,1)];let suffix=[I(blot_backend_runtime_ir::OP_local_get,iterator),I(blot_backend_runtime_ir::OP_i32_const,1),I(blot_backend_runtime_ir::OP_i32_add),I(blot_backend_runtime_ir::OP_local_set,iterator),I(blot_backend_runtime_ir::OP_br),I(blot_backend_runtime_ir::OP_end),I(blot_backend_runtime_ir::OP_end)];if body_start>body_end || body_end>code.len {return false;}return shellSame(code[..body_start],prefix) && shellSame(code[body_end..],suffix);}
fn shellSame(actual:const Instruction[:],expected:const Instruction[:])->bool {var at:i64=0;for inst in actual {if inst.table_reference || inst.table_kind!=blot_backend_runtime_ir::TABLE_unknown {return false;}if inst.op==blot_backend_runtime_ir::OP_nop {continue;}if at==expected.len || inst.op!=expected[at].op || inst.operand!=expected[at].operand {return false;}at+=1;}return at==expected.len;}
recursive fn interpret(module:const Module&,code:const Instruction[:],state:State&,limits:Limits&,depth:i64)->bool {if depth>=12 {return false;}var at:i64=0;while at<code.len {if limits.instructions==0 {return false;}limits.instructions-=1;let inst=code[at];if inst.table_reference || inst.table_kind!=blot_backend_runtime_ir::TABLE_unknown {return false;}match inst.op {
 blot_backend_runtime_ir::OP_nop=>{},blot_backend_runtime_ir::OP_i32_const=>{if !state.push(literal(inst.operand)) {return false;}},blot_backend_runtime_ir::OP_local_get=>{if inst.operand==state.forbidden || !state.push(state.get(inst.operand)) {return false;}},
 blot_backend_runtime_ir::OP_local_set,blot_backend_runtime_ir::OP_local_tee=>{let value=state.pop();if !value.present || inst.operand==state.forbidden || !state.set(inst.operand,value.value) {return false;}if inst.op==blot_backend_runtime_ir::OP_local_tee && !state.push(value.value) {return false;}},blot_backend_runtime_ir::OP_drop=>{if !state.pop().present {return false;}},
 blot_backend_runtime_ir::OP_block,blot_backend_runtime_ir::OP_if_=>{var end=at+1;var nested:i64=0;var alternate:i64=-1;while end<code.len {let op=code[end].op;if op==blot_backend_runtime_ir::OP_block || op==blot_backend_runtime_ir::OP_if_ {nested+=1;}else if op==blot_backend_runtime_ir::OP_else_ && nested==0 {if inst.op!=blot_backend_runtime_ir::OP_if_ || alternate>=0 {return false;}alternate=end;}else if op==blot_backend_runtime_ir::OP_end {if nested==0 {break;}nested-=1;}end+=1;}if end==code.len {return false;}if inst.op==blot_backend_runtime_ir::OP_block {if !interpret(module,code[at+1..end],state,limits,depth+1) {return false;}}else {let popped=state.pop();if !popped.present {return false;}let tested=popped.value.condition();if !tested.present {return false;}let predicate=tested.value;var yes=state;var no=state;var yes_end=end;if alternate>=0 {yes_end=alternate;}if !interpret(module,code[at+1..yes_end],yes,limits,depth+1) {return false;}if alternate>=0 && !interpret(module,code[alternate+1..end],no,limits,depth+1) {return false;}if yes.flow!=no.flow || yes.label!=no.label || yes.height!=no.height {return false;}state.flow=yes.flow;state.label=yes.label;for slot in yes.slots[..yes.len] {if !state.set(slot.id,choose(predicate,slot.value,no.get(slot.id))) {return false;}}for slot in no.slots[..no.len] {if !state.set(slot.id,choose(predicate,yes.get(slot.id),slot.value)) {return false;}}state.height=yes.height;for &value,index in state.stack[..state.height] {value=choose(predicate,yes.stack[index],no.stack[index]);}}at=end;if state.flow==Flow.branch {if state.label!=0 {state.label-=1;return true;}state.flow=Flow.normal;}else if state.flow==Flow.return_ {return true;}},
 blot_backend_runtime_ir::OP_br=>{state.flow=Flow.branch;state.label=inst.operand;return true;},blot_backend_runtime_ir::OP_return_=>{state.flow=Flow.return_;return true;},
 blot_backend_runtime_ir::OP_call=>{if inst.operand>=module.functions.len || module.runtimeHelper(inst.operand) {return false;}let callee .= module.functions[inst.operand];let parameters=module.parameters(callee);let locals=module.locals(callee);let instructions=blot_backend_wasm::instructions(module,callee);if callee.entry || callee.result!=blot_backend_runtime_ir::VT_i32 || callee.result_role!=blot_backend_runtime_ir::ROLE_scalar || instructions.len>128 || parameters.len+locals.len>32 || parameters.len>state.height {return false;}for machine in parameters {if machine!=blot_backend_runtime_ir::VT_i32 {return false;}}for machine in locals {if machine!=blot_backend_runtime_ir::VT_i32 {return false;}}var child=State{..};let first=state.height-parameters.len;for value,index in state.stack[first..state.height] {if !child.set(index as u32,value) {return false;}}state.height=first;for index in parameters.len..parameters.len+locals.len {if !child.set(index as u32,literal(0)) {return false;}}if !interpret(module,instructions,child,limits,depth+1) || child.flow==Flow.branch || child.height!=1 || !state.push(child.stack[0]) {return false;}},
 blot_backend_runtime_ir::OP_i32_eqz=>{let popped=state.pop();if !popped.present {return false;}let tested=popped.value.condition();if !tested.present || !state.push(tested.value.xor(literal(1))) {return false;}},
 _=>{let right=state.pop();let left=state.pop();if !right.present || !left.present {return false;}let value=binary(inst.op,left.value,right.value);if !value.present || !state.push(value.value) {return false;}},
 }at+=1;}return true;}
fn analyze(module:const Module&,code:const Instruction[:],carry:u32,iterator:u32,count:u32)->blot_support::Option<Word> {if count==0 || count>8 || code.len>256 {return blot_support::none<Word>();}var state=State{forbidden:iterator,..};if !state.set(carry,input()) {return blot_support::none<Word>();}var limits=Limits{..};if !interpret(module,code,state,limits,0) || state.flow!=Flow.normal || state.height!=0 {return blot_support::none<Word>();}let result=state.get(carry);if !result.valid {return blot_support::none<Word>();}return blot_support::some(result.repeat(count));}
fn analyzeLoop(module:const Module&,code:const Instruction[:],carry:u32,iterator:u32,end:u32,count:u32)->blot_support::Option<Word> {if carry==end || iterator==end {return blot_support::none<Word>();}for inst in code {if (inst.op==blot_backend_runtime_ir::OP_local_set || inst.op==blot_backend_runtime_ir::OP_local_tee) && inst.operand==end {return blot_support::none<Word>();}}return analyze(module,code,carry,iterator,count);}
enum Term {shifted {bits:u32},column {bit:u32,bits:u32},literal {bits:u32}}
recursive fn emitTerms(output:Code&,terms:const Term[:],carry:u32)->Error {if terms.len>1 {let middle=terms.len/2;let error=emitTerms(output,terms[..middle],carry);if error!=blot_error::Error.none {return error;}let error=emitTerms(output,terms[middle..],carry);if error!=blot_error::Error.none {return error;}return output.push(I(blot_backend_runtime_ir::OP_i32_xor));}match terms[0] {literal value=>{return output.push(I(blot_backend_runtime_ir::OP_i32_const,value.bits));},shifted value=>{let error=output.push(I(blot_backend_runtime_ir::OP_local_get,carry));if error!=blot_error::Error.none {return error;}if value.bits!=0 {return output.append([I(blot_backend_runtime_ir::OP_i32_const,value.bits),I(blot_backend_runtime_ir::OP_i32_shr_u)]);}},column column=>{let error=output.append([I(blot_backend_runtime_ir::OP_i32_const,0),I(blot_backend_runtime_ir::OP_local_get,carry)]);if error!=blot_error::Error.none {return error;}if column.bit!=0 {let error=output.append([I(blot_backend_runtime_ir::OP_i32_const,column.bit),I(blot_backend_runtime_ir::OP_i32_shr_u)]);if error!=blot_error::Error.none {return error;}}return output.append([I(blot_backend_runtime_ir::OP_i32_const,1),I(blot_backend_runtime_ir::OP_i32_and),I(blot_backend_runtime_ir::OP_i32_sub),I(blot_backend_runtime_ir::OP_i32_const,column.bits),I(blot_backend_runtime_ir::OP_i32_and)]);},}return blot_error::Error.none;}
fn emit(transform:Word,carry:u32)->blot_support::Option<Output>,Error {var best_shift:u32=32;var best_count:i64=33;for shift in 0..33 {var count:i64=0;if shift!=32 {count=1;}for column,bit in transform.columns {var base:u32=0;if shift!=32 {base=(1 as u32<<bit as u32)>>shift as u32;}if column!=base {count+=1;}}if count<best_count {best_count=count;best_shift=shift as u32;}}if best_count>16 {return blot_support::none<Output>(),blot_error::Error.none;}var terms:Term[34]=[Term.shifted{bits:0,..};34];var count:i64=0;if transform.constant!=0 {terms[count]=Term.literal{bits:transform.constant,..};count+=1;}if best_shift!=32 {terms[count]=Term.shifted{bits:best_shift,..};count+=1;}for column,bit in transform.columns {var base:u32=0;if best_shift!=32 {base=(1 as u32<<bit as u32)>>best_shift;}if column==base {continue;}terms[count]=Term.column{bit:bit as u32,bits:column^base,..};count+=1;}if count==0 {terms[0]=Term.literal{bits:0,..};count=1;}var locals=blot_backend_optimizer_buffers::Types{..};var output=Code{..};let error=emitTerms(output,terms[..count],carry);if error!=blot_error::Error.none {return blot_backend_optimizer_buffers::finishOptional(locals,output,false,error);}let error=output.push(I(blot_backend_runtime_ir::OP_local_set,carry));return blot_backend_optimizer_buffers::finishOptional(locals,output,true,error);}
