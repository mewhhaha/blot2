recursive fn forkExpression(self_:Builder&,source:u32,syntax:blot_parse_ast::Node,ty:u32,depth:i64)->u32,Error {
 let block_id,error=self_.reserve(source);
 if error!=blot_error::Error.none {return 0,error;}
 var children=WordBuffer{..};
 let entries=blot_parse_ast::List{start:syntax.a,len:syntax.b, ..};
 let entry_count=self_.source.tree.list(entries).len;
 for index in 0..entry_count {
  let entry_id=self_.source.tree.list(entries)[index];
  let entry=self_.source.tree.node(entry_id);
  let outer=self_.source.checked.resolved[entry.b];
  let inner=self_.source.checked.resolved[entry_id];
  if outer==0 || inner==0 {blot_check_core_builder::deinit(children);return 0,blot_error::Error.core_limit;}
  let outer_ty=self_.tables.bindings[outer].ty;
  let outer_ref,rerr=self_.referenceNode(entry.b,outer,outer_ty);
  if rerr!=blot_error::Error.none {blot_check_core_builder::deinit(children);return 0,rerr;}
  let bind_node,berr=self_.make(entry_id,blot_check_core::Node{tag:blot_check_core::Tag.bind,ty:blot_check_types::unit,a:inner,b:outer_ref, ..});
  if berr!=blot_error::Error.none {blot_check_core_builder::deinit(children);return 0,berr;}
  let aerr=blot_check_core_builder::append(children,bind_node);
  if aerr!=blot_error::Error.none {blot_check_core_builder::deinit(children);return 0,aerr;}
 }
 let previous_return=self_.scratch.return_target;
 let previous_function=self_.scratch.function_target;
 self_.scratch.return_target=0;
 self_.scratch.function_target=block_id;
 let body_stmts,serr=self_.statements(syntax.c,depth+1);
 self_.scratch.return_target=previous_return;
 self_.scratch.function_target=previous_function;
 if serr!=blot_error::Error.none {blot_check_core_builder::deinit(children);return 0,serr;}
 for child in self_.tables.extra[body_stmts.start..body_stmts.start+body_stmts.len] {
  let aerr=blot_check_core_builder::append(children,child);
  if aerr!=blot_error::Error.none {blot_check_core_builder::deinit(children);return 0,aerr;}
 }
 let saved,save_err=self_.save(children.items);
 blot_check_core_builder::deinit(children);
 if save_err!=blot_error::Error.none {return 0,save_err;}
 self_.tables.nodes[block_id]=blot_check_core::Node{tag:blot_check_core::Tag.block_,ty:ty,a:saved.start,b:saved.len, ..};
 return self_.make(source,blot_check_core::Node{tag:blot_check_core::Tag.fork_,ty:ty,a:block_id,b:entry_count as u32, ..});
}

recursive fn providerBlock(self_:Builder&,source:u32,metadata:blot_check_check::ProviderBlock,depth:i64)->u32,Error {let provider,error=self_.expression(metadata.provider,depth+1);if error!=blot_error::Error.none {return 0,error;}let inner,error=self_.reserve(source);if error!=blot_error::Error.none {return 0,error;}let previous=self_.scratch.return_target;self_.scratch.return_target=inner;let children,error=self_.statements(source,depth+1);self_.scratch.return_target=previous;if error!=blot_error::Error.none {return 0,error;}let body_type,error=self_.projectType(metadata.body_result,0);if error!=blot_error::Error.none {return 0,error;}self_.tables.nodes[inner]=blot_check_core::Node{tag:blot_check_core::Tag.block_,ty:body_type,a:children.start,b:children.len, ..};let result_type,error=self_.projectType(metadata.result,0);if error!=blot_error::Error.none {return 0,error;}return self_.make(source,blot_check_core::Node{tag:blot_check_core::Tag.handle,ty:result_type,a:provider,b:inner, ..});}
recursive fn runnerOperand(self_:Builder&,source:u32,ty:u32,prefix:WordBuffer&,depth:i64)->u32,Error {let value,error=self_.expression(source,depth+1);if error!=blot_error::Error.none {return 0,error;}if self_.tables.bindings.len==0xffffffff {return 0,blot_error::Error.core_limit;}let binding=self_.tables.bindings.len as u32;self_.tables.bindings.push(blot_check_core::Binding{kind:blot_reuse_principal_interface::Kind.local,ty:ty,scheme:blot_check_types::Scheme{root:ty, ..},target:blot_check_core::BindingRef{binding:0, ..},span:self_.source.tree.span(source), ..});let node,error=self_.make(source,blot_check_core::Node{tag:blot_check_core::Tag.bind,ty:blot_check_types::unit,a:binding,b:value, ..});if error!=blot_error::Error.none {return 0,error;}let error=blot_check_core_builder::append(prefix,node);if error!=blot_error::Error.none {return 0,error;}return self_.referenceNode(source,binding,ty);}
