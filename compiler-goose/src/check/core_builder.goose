fn lowerOwned(builder:Builder&,owner:blot_reuse_dependency_payload::Owner&,capabilities:blot_check_capability_contracts::CollectionTables,declarations:blot_reuse_declaration_dependencies::Recipe[>..<]&,references:blot_check_core::BindingRef[>..<]&,members:blot_check_core::DependencyMember[>..<]&)->Module,Error {let error=builder.initialize();if error!=Error.none {return default<Module>(),error;}if builder.source.checked.diagnostics.len!=0 {let error=builder.diagnostic(blot_check_core::Code.unchecked,0);if error!=Error.none {return default<Module>(),error;}}else {let error=builder.allBindings();if error!=Error.none {return default<Module>(),error;}let error=builder.allCatalogs();if error!=Error.none {return default<Module>(),error;}let error=builder.allBodies();if error!=Error.none {return default<Module>(),error;}}for goal in builder.tables.obligations {let error=builder.saveFieldName(goal.name);if error!=Error.none {return default<Module>(),error;}}let finished,error=builder.tables.finish(owner,builder.scratch.body_lowerings,builder.scratch.effect_variable_count,builder.scratch.ast_map);if error!=Error.none {return default<Module>(),error;}var result=finished;let collection,error=builder.source.checked.capability_contracts.select(builder.source.checked.bindings,[],false,capabilities);if error!=Error.none {return default<Module>(),error;}let nodes,error=owner.copy<blot_check_capability_contracts::Term>(collection.nodes);if error!=Error.none {return default<Module>(),error;}let words,error=owner.copy<u32>(collection.words);if error!=Error.none {return default<Module>(),error;}let bindings,error=owner.copy<blot_check_capability_contracts::Binding>(collection.bindings);if error!=Error.none {return default<Module>(),error;}result.capability_contracts=blot_check_capability_contracts::Collection{nodes:nodes,words:words,bindings:bindings, ..};result.unit=builder.source.checked.unit;let error=blot_reuse_declaration_dependencies::capture(result,declarations,references,members);if error!=Error.none {return default<Module>(),error;}let declaration_dependencies,error=owner.copy<blot_check_core::DeclarationDependencies>(declarations[:]);if error!=Error.none {return default<Module>(),error;}let dependency_references,error=owner.copy<blot_check_core::BindingRef>(references[:]);if error!=Error.none {return default<Module>(),error;}let dependency_members,error=owner.copy<blot_check_core::DependencyMember>(members[:]);if error!=Error.none {return default<Module>(),error;}result.declaration_dependencies=declaration_dependencies;result.dependency_references=dependency_references;result.dependency_members=dependency_members;return result,Error.none;}
