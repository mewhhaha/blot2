 for binding,index in module.bindings { if binding.initializer==0||module.types.node(binding.ty).tag!=TypeTag.function { continue; } work.push(binding.initializer); while work.len!=0 { let id=work[work.len-1]; work.resize(work.len-1); let n=module.node(id); match n.tag { reference,closure=>{ definitions.insert(DefinitionKey {owner,id},index as u32); },return_=>{ work.push(n.a); },if_value,if_stmt=>{ work.append([n.b,n.c]); },match_=>{ for arm in module.matchArms(id) { work.push(arm.body); } },block_,suite=>{ for child in module.children(id) { let tag=module.node(child).tag; if tag==CoreTag.return_||tag==CoreTag.if_stmt||tag==CoreTag.match_ { work.push(child); } } },_=>{}, } } } owners.insert(owner,true); return Error.none;
