+    // A warmed root still accounts every distinct reachable node and word.
+    var many_fields: [40]usize = @splat(0);
+    const broad = [_]Term{
+        .{ .reference = .{ .unit = 2, .ty = 1 }, .head = &.{3} },
+        .{ .reference = .{ .unit = 2, .ty = 2 }, .head = &.{9}, .children = &many_fields },
+    };
