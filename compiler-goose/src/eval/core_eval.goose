 if c.kind==ConstraintKind.scheme_use { let product=store.node(c.left); if product.tag!=TypeTag.product { return false,Error.none; } for part in store.list(blot_check_types::List {product.a,product.b}) { let node=store.node(part); if node.tag==TypeTag.variable { continue; } if node.tag!=TypeTag.function||node.a!=blot_check_types::unit||node.b!=blot_check_types::unit { return false,Error.none; } let row=store.row(node.c); if row.labels.len!=0||row.tail==blot_check_effects::Tail.parameter { return false,Error.none; } } return true,Error.none; }
 match c.kind { binary,field,result_dispatch,physical_field,receiver,update,collection,record_merge,type_head,type_compare,type_rep,effect_rep,effect_operation=>{},_=>{ return false,Error.none; }, }
 match c.kind {
  binary=>{ if store.node(c.left).tag!=TypeTag.variable&&store.node(c.right).tag!=TypeTag.variable { return false,Error.none; } },field,physical_field,receiver,update,collection=>{ if store.node(c.left).tag!=TypeTag.variable { return false,Error.none; } },result_dispatch=>{ if store.node(c.result).tag!=TypeTag.variable { return false,Error.none; } },record_merge=>{ if store.node(c.left).tag!=TypeTag.variable&&store.node(c.right).tag!=TypeTag.variable { return false,Error.none; } },type_head=>{ let head,error=principalWitnessHead(self,store,c.left); if error!=Error.none { return false,error; } if store.node(head).tag!=TypeTag.variable { return false,Error.none; } },type_rep=>{ let unknown,error=unknownPrincipalData(self,store,c.left); if error!=Error.none||!unknown { return false,error; } },effect_rep=>{ let carrier=store.node(c.signature); if carrier.tag!=TypeTag.function { return false,Error.none; } let row=store.row(carrier.c); var open=row.tail==blot_check_effects::Tail.variable; for label in store.rowLabels(carrier.c) { for argument in store.operationArguments(label) { if open { continue; } let unknown,error=unknownPrincipalData(self,store,argument); if error!=Error.none { return false,error; } open=unknown; } } if !open { return false,Error.none; } },type_compare=>{ let left,error=principalWitnessHead(self,store,c.left); if error!=Error.none { return false,error; } let right,e=principalWitnessHead(self,store,c.right); if e!=Error.none { return false,e; } if store.node(left).tag==TypeTag.never||store.node(right).tag==TypeTag.never { return false,Error.none; } let a,e2=unknownPrincipalData(self,store,left); if e2!=Error.none { return false,e2; } if !a { let b,e3=unknownPrincipalData(self,store,right); if e3!=Error.none||!b { return false,e3; } } },effect_operation=>{ if c.identity.unit==0 { return false,Error.none; } let signature=store.node(c.left); if signature.tag!=TypeTag.function||store.row(signature.c).tail==blot_check_effects::Tail.parameter { return false,Error.none; } },_=>{},
 }
