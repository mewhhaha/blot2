type Error=blot_error::Error;
type Identity=blot_check_types::NominalIdentity;
type List=blot_check_types::List;
type Mapping=blot_eval_type_evidence::Mapping;
type RowMapping=blot_eval_type_evidence::RowMapping;
type Tag=blot_eval_type_evidence::Tag;
type K=blot_check_types::ObligationKind;
type Outcome=blot_reuse_dispatch_explanation::Outcome;
enum Code { missing_implementation,incompatible_implementation,recursive_evidence,recursive_associated_type,associated_limit }
enum ProofKind { implementation,predicate }
struct Member { name: u32,kind: blot_check_core::ImplementationMemberKind=blot_reuse_principal_interface::ImplementationMemberKind.type_,root: u32,target: blot_check_core::BindingRef }
struct LegacyChoice { target: blot_check_core::BindingRef,carrier: u32=0 }
struct Fact { kind: K=blot_check_types::ObligationKind.type_rep,operator: blot_check_types::Operator=blot_check_types::Operator.none,identity: Identity=Identity {0,0},name: u32=0,operands: u32[4]=[0;4],target: blot_check_core::BindingRef=blot_check_core::BindingRef {0,0} }
struct Proof { kind: ProofKind=ProofKind.implementation,predicate: Fact=Fact {},context: u32,implementation: Identity,contract: Identity,arguments: List,members: List,prerequisites: List }
struct View { owner_id: u64=0,proofs: const Proof[:]=default<const Proof[:]>(),arguments: const u32[:]=default<const u32[:]>(),members: const Member[:]=default<const Member[:]>(),edges: const u32[:]=default<const u32[:]>() }
struct Snapshot { owner_id: u64=blot_native::fresh_owner_id(),proofs: const Proof[:]=default<const Proof[:]>(),arguments: const u32[:]=default<const u32[:]>(),members: const Member[:]=default<const Member[:]>(),edges: const u32[:]=default<const u32[:]>() }
fn view(self_: const Snapshot&) -> View { return View {self_.owner_id,self_.proofs,self_.arguments,self_.members,self_.edges}; }
struct FactKey { context: u32,fact: Fact }
fn hash(key: FactKey) -> u64 { var h=::hash(key.context); h=::hash_combine(h,blot_check_types::obligationKindCode(key.fact.kind) as u64); h=::hash_combine(h,blot_check_types::operatorCode(key.fact.operator) as u64); h=::hash_combine(h,::hash(key.fact.identity.unit)); h=::hash_combine(h,::hash(key.fact.identity.decl)); h=::hash_combine(h,::hash(key.fact.name)); for value in key.fact.operands { h=::hash_combine(h,::hash(value)); } return ::hash_combine(::hash_combine(h,::hash(key.fact.target.unit)),::hash(key.fact.target.binding)); }
struct Active { context: u32,contract: Identity,arguments: List }
struct ActiveProjection { context: u32,contract: Identity,member: u32,arguments: List }
struct Provisional { context: u32,declaration: blot_check_core::Implementation,arguments: List,mappings: List,rows: List }
struct ProofsBuffer { storage: Proof[:]=default<Proof[:]>(),items: Proof[:]=default<Proof[:]>(),len: i64=0,failure: Error=blot_error::Error.none }
reusable[] var pool_ProofsBuffer: Proof[>..]=[];
fn ensure(self_: ProofsBuffer&,minimum: i64) -> Error { if self_.failure!=blot_error::Error.none { return self_.failure; } let error=blot_support_pooled_buffer::ensure(self_,minimum,pool_ProofsBuffer); if error!=blot_error::Error.none { self_.failure=error; } return error; }
fn push(self_: ProofsBuffer&,value: Proof) { if self_.failure!=blot_error::Error.none { return; } self_.failure=blot_support_pooled_buffer::push(self_,value,pool_ProofsBuffer); self_.len=self_.items.len; }
fn append(self_: ProofsBuffer&,values: const Proof[:]) { if self_.failure!=blot_error::Error.none { return; } self_.failure=blot_support_pooled_buffer::append(self_,values,pool_ProofsBuffer); self_.len=self_.items.len; }
fn resize(self_: ProofsBuffer&,length: i64) { blot_support_pooled_buffer::resize(self_,length); self_.len=length; }
fn resize(self_: ProofsBuffer&,length: i64,value: Proof) { if length<=self_.len { resize(self_,length); return; } let error=ensure(self_,length); if error!=blot_error::Error.none { return; } for index in self_.len..length { self_.storage[index]=value; } self_.items=self_.storage[..length]; self_.len=length; }
fn clear(self_: ProofsBuffer&) { blot_support_pooled_buffer::clear(self_); self_.len=0; self_.failure=blot_error::Error.none; }
fn deinit(self_: ProofsBuffer&) { blot_support_pooled_buffer::deinit(self_,pool_ProofsBuffer); self_.len=0; self_.failure=blot_error::Error.none; }
