 var builder=Builder{source:Source{tree:tree,names:names,checked:checked,diagnostic_origins:diagnostic_origins, ..},tables:Tables{field_names:table_field_names,tag_calls:table_tag_calls,nodes:table_nodes,spans:table_spans,extra:table_extra,type_nodes:table_type_nodes,type_extra:table_type_extra,effect_rows:table_effect_rows,effect_labels:table_effect_labels,effect_operations:table_effect_operations,bindings:table_bindings,bodies:table_bodies,parameters:table_parameters,runtime_names:table_runtime_names,source_names:table_source_names,erased_declaration_references:table_erased_declaration_references,references:table_references,calls:table_calls,merges:table_merges,merge_ranges:table_merge_ranges,name_bytes:table_name_bytes,obligations:table_obligations,diagnostics:table_diagnostics,nominals:table_nominals,operation_names:table_operation_names,constructors:table_constructors,projections:table_projections,projection_variants:table_projection_variants,patterns:table_patterns,pattern_rows:table_pattern_rows,match_arms:table_match_arms,matches:table_matches,updates:table_updates,update_steps:table_update_steps,closures:table_closures,associated:table_associated,contracts:table_contracts,contract_members:table_contract_members,implementations:table_implementations,implementation_members:table_implementation_members,member_templates:table_member_templates,primitives:table_primitives,loops:table_loops,loop_carries:table_loop_carries,operation_values:table_operation_values,handle_effects:table_handle_effects,dispatch_signatures:table_dispatch_signatures,type_tags:table_type_tags, ..},scratch:Scratch{..}, ..};

 let initialized,error=blot_reuse_dependency_payload::init();if error!=blot_error::Error.none {return default<blot_reuse_dependency_payload::Owned<Module>>(),error;}var owner=initialized;
 var declarations:blot_reuse_declaration_dependencies::Recipe[>..<]=[];var references:blot_check_core::BindingRef[>..<]=[];var members:blot_check_core::DependencyMember[>..<]=[];
 let module,failure=lowerOwned(builder,owner,declarations,references,members,declared_signatures_only);builder.deinit();if failure!=blot_error::Error.none {owner.deinit();return default<blot_reuse_dependency_payload::Owned<Module>>(),failure;}return blot_reuse_dependency_payload::Owned<Module>{value:module,owner:owner, ..},blot_error::Error.none;
}
fn allTypeTags(self_:Builder&)->Error {
 for ordinal in 1..self_.source.checked.nominals.len {
  let nominal=self_.source.checked.nominals[ordinal];
  if nominal.identity.unit!=self_.source.checked.unit { continue; }
  let dnode=self_.source.tree.node(nominal.declaration);
  if dnode.tag!=blot_parse_ast::tag_data_decl { continue; }
  let meta=blot_parse_ast::List{dnode.c,4, ..};
  let attr_list=blot_parse_ast::List{self_.source.tree.list(meta)[2],self_.source.tree.list(meta)[3], ..};
  let attr_count=self_.source.tree.list(attr_list).len;
  for ai in 0..attr_count {
   let attr_id=self_.source.tree.list(attr_list)[ai];
   let expr_id=self_.source.tree.node(attr_id).a;
   if expr_id==0 || expr_id>=self_.source.checked.expr_types.len || self_.source.checked.expr_types[expr_id]==0 { continue; }
   let val_node,verr=self_.expression(expr_id,0);
   if verr!=blot_error::Error.none { return verr; }
   self_.tables.type_tags.push(blot_check_core::TypeTag{nominal:nominal.identity,constructor_tag:0xffffffff,field_name:0,has_default:false,value:val_node,ty:self_.tables.nodes[val_node].ty, ..});
  }
  let ccount=self_.source.tree.children(dnode.b).len;
  for ci in 0..ccount {
   let cid=self_.source.tree.children(dnode.b)[ci];
   let cnode=self_.source.tree.node(cid);
   if cnode.c!=0 {
    let clist=blot_parse_ast::List{self_.source.tree.extra.items[cnode.c-1],self_.source.tree.extra.items[cnode.c], ..};
    let calen=self_.source.tree.list(clist).len;
    for ai in 0..calen {
     let attr_id=self_.source.tree.list(clist)[ai];
     let expr_id=self_.source.tree.node(attr_id).a;
     if expr_id==0 || expr_id>=self_.source.checked.expr_types.len || self_.source.checked.expr_types[expr_id]==0 { continue; }
     let val_node,verr=self_.expression(expr_id,0);
     if verr!=blot_error::Error.none { return verr; }
     self_.tables.type_tags.push(blot_check_core::TypeTag{nominal:nominal.identity,constructor_tag:ci as u32,field_name:0,has_default:false,value:val_node,ty:self_.tables.nodes[val_node].ty, ..});
    }
   }
   if cnode.b!=0 && self_.source.tree.node(cnode.b).tag==blot_parse_ast::tag_type_record {
    let fcount=self_.source.tree.children(cnode.b).len;
    for fi in 0..fcount {
     let fid=self_.source.tree.children(cnode.b)[fi];
     let fnode=self_.source.tree.node(fid);
     if fnode.c==0 { continue; }
     let sferr=self_.saveFieldName(fnode.a);
     if sferr!=blot_error::Error.none { return sferr; }
     let flist=blot_parse_ast::List{self_.source.tree.extra.items[fnode.c-1],self_.source.tree.extra.items[fnode.c], ..};
     let falen=self_.source.tree.list(flist).len;
     for ai in 0..falen {
      let attr_id=self_.source.tree.list(flist)[ai];
      let expr_id=self_.source.tree.node(attr_id).a;
      if expr_id==0 || expr_id>=self_.source.checked.expr_types.len || self_.source.checked.expr_types[expr_id]==0 { continue; }
      let val_node,verr=self_.expression(expr_id,0);
      if verr!=blot_error::Error.none { return verr; }
      self_.tables.type_tags.push(blot_check_core::TypeTag{nominal:nominal.identity,constructor_tag:ci as u32,field_name:fnode.a,has_default:false,value:val_node,ty:self_.tables.nodes[val_node].ty, ..});
     }
     let def_expr=self_.source.tree.extra.items[fnode.c+1];
     if def_expr!=0 && def_expr<self_.source.checked.expr_types.len && self_.source.checked.expr_types[def_expr]!=0 {
      let val_node,verr=self_.expression(def_expr,0);
      if verr!=blot_error::Error.none { return verr; }
      self_.tables.type_tags.push(blot_check_core::TypeTag{nominal:nominal.identity,constructor_tag:ci as u32,field_name:fnode.a,has_default:true,value:val_node,ty:self_.tables.nodes[val_node].ty, ..});
     }
    }
   }
  }
 }
 return blot_error::Error.none;
}
fn lowerOwned(builder:Builder&,owner:blot_reuse_dependency_payload::Owner&,declarations:blot_reuse_declaration_dependencies::Recipe[>..<]&,references:blot_check_core::BindingRef[>..<]&,members:blot_check_core::DependencyMember[>..<]&,declared_signatures_only:bool)->Module,Error {let error=builder.initialize();
if error!=blot_error::Error.none {return default<Module>(),error;
}if builder.source.checked.diagnostics.len!=0 {let error=builder.diagnostic(blot_check_core::Code.unchecked,0);
if error!=blot_error::Error.none {return default<Module>(),error;
}}else {let error=builder.allBindings();
if error!=blot_error::Error.none {return default<Module>(),error;
}let error=builder.allCatalogs(declared_signatures_only);
if error!=blot_error::Error.none {return default<Module>(),error;
}let error=builder.allBodies();
if error!=blot_error::Error.none {return default<Module>(),error;
}let error=builder.allTypeTags();
if error!=blot_error::Error.none {return default<Module>(),error;
}}for goal in builder.tables.obligations {let error=builder.saveFieldName(goal.name);
if error!=blot_error::Error.none {return default<Module>(),error;
}}let finished,error=builder.tables.finish(owner,builder.scratch.body_lowerings,builder.scratch.effect_variable_count);
if error!=blot_error::Error.none {return default<Module>(),error;
}var result=finished;
result.unit=builder.source.checked.unit;
if result.diagnostics.len==0 {var rejected:blot_check_core::Diagnostic[>..<]=[];blot_check_uniqueness::check(result,rejected);if rejected.len!=0 {let diagnostics,error=blot_reuse_dependency_payload::copy<blot_check_core::Diagnostic>(owner,rejected[..]);if error!=blot_error::Error.none {return default<Module>(),error;}result.diagnostics=diagnostics;}}
if !declared_signatures_only {
let error=blot_reuse_declaration_dependencies::capture(result,declarations,references,members);
if error!=blot_error::Error.none {return default<Module>(),error;
}let declaration_dependencies,error=blot_reuse_dependency_payload::copy<blot_check_core::DeclarationDependencies>(owner,declarations[..]);
if error!=blot_error::Error.none {return default<Module>(),error;
}let dependency_references,error=blot_reuse_dependency_payload::copy<blot_check_core::BindingRef>(owner,references[..]);
if error!=blot_error::Error.none {return default<Module>(),error;
}let dependency_members,error=blot_reuse_dependency_payload::copy<blot_check_core::DependencyMember>(owner,members[..]);
if error!=blot_error::Error.none {return default<Module>(),error;
}result.declaration_dependencies=declaration_dependencies;
result.dependency_references=dependency_references;
result.dependency_members=dependency_members;
}
return result,blot_error::Error.none;
}

fn selectedAccessPath(self_:const Builder&,source:u32)->const u32[:] {if source<self_.source.checked.access_paths.len {return self_.source.checked.types.list(self_.source.checked.access_paths[source]);}return default<const u32[:]>();}
