 var walker=sourceBodyWalker(module,context,scopes,admission);
 if admission.bodies.len>=65536 {return blot_error::Error.invalid_artifact;
 }let workspace .= admission.workspace;
 if !workspace {return blot_error::Error.invalid_artifact;
 }admission.bodies.push(claim);
 if admission.bodies.failure!=blot_error::Error.none {workspace.oom=true;
 return blot_error::Error.invalid_artifact;
 }admission.body_index.insert(claim,true);
 if admission.body_index.failure!=blot_error::Error.none {admission.bodies.resize(admission.bodies.len-1);
 workspace.oom=true;
 return blot_error::Error.invalid_artifact;
 }let error=scopes.initialize();
 if error!=blot_error::Error.none {return error;
 }return walker.proveBody(body);
 }
recursive fn parametricBodyWorkspace<C>(module:const Module&,binding:u32,context:C,remaining:i64&,workspace:Workspace&)->Error {if binding==0 || binding>=module.bindings.len {return blot_error::Error.invalid_artifact;}let body .= module.body(binding);if !body || !body.is_function {return blot_error::Error.invalid_artifact;}return executableWorkspace(module,context,remaining,workspace);}
recursive fn callInstance<C>(module:const Module&,reference:blot_check_core::BindingRef,expected:u32,context:C,scopes:Views&,remaining:i64&)->Principal,Error {if !(scopes.types .== module.types) || !(scopes.remaining .== remaining) {return invalidPrincipal(),blot_error::Error.invalid_artifact;}var admission=packageAdmission(remaining);var walker=sourceBodyWalker(module,contextView(context),scopes,admission);let value,error=walker.principalMapping(reference,expected);admission.deinit();return value,error;}
