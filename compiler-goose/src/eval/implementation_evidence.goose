 assert(source.active_arguments .== state.active_arguments);
 assert(source.active .== state.active);
 assert(source.active_projections .== state.active_projections);
 assert(source.provisional_equations .== state.provisional_equations);
 assert(source.provisional_mappings .== state.provisional_mappings);
 assert(source.provisional_rows .== state.provisional_rows);
