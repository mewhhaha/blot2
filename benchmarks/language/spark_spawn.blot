effect Start: Array U32 -> U32
entry func planner (seed: U32): U32 => return seed
entry func planner_step (pair: Array U32): U32 => return @u32.add pair[0] pair[1]
func request (config: U32): U32 ! { Start } => return @spawn Start planner config
entry func local (config: U32): U32 => return do @effect.provider Start (func (packet: Array U32) => return packet[0]):
  use endpoint <- request config
  return endpoint
entry func live (host: Array U32 -> U32 ! { Foreign }) => return do @effect.provider Start host:
  use endpoint <- request 11
  return endpoint
entry func twice (xs: Array U32): Array U32 => return @spark #[@u32.mul x 2 | x <- xs]
entry func spark_mix (xs: Array U32): Array U32 => return @spark #[@u32.bit_xor (@u32.mul x 1664525) 1013904223 | x <- xs]
entry func ordinary_mix (xs: Array U32): Array U32 => return #[@u32.bit_xor (@u32.mul x 1664525) 1013904223 | x <- xs]
entry func indexed_mix (xs: Array U32): Array U32 => return @array.generate xs.length (func i => return @u32.bit_xor (@u32.mul xs[i] 1664525) 1013904223)
