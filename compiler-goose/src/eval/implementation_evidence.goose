 else if value.kind==blot_check_types::ObligationKind.integer { accepted=evidence.node(operands[0]).tag==blot_eval_type_evidence::Tag.unsigned32; }
 else if value.kind==blot_check_types::ObligationKind.equality { let tag=evidence.node(operands[0]).tag; accepted=tag==blot_eval_type_evidence::Tag.unsigned32||tag==blot_eval_type_evidence::Tag.floating32||tag==blot_eval_type_evidence::Tag.boolean; }
 else { let selected,present,error=host.implementationLegacyPredicate(context,value,operands,resolver_context,resolver_remaining,resolver_enabled); if error!=blot_error::Error.none { return Fact {},false,error; } if !present { return Fact {},false,blot_error::Error.none; } target=selected.target; operands[3]=selected.carrier; accepted=true; }
 if !accepted { return Fact {},false,blot_error::Error.none; } return Fact {value.kind,value.operator,value.identity,value.name,operands,target},true,blot_error::Error.none;
}
fn invocation<H>(host: H&,value: blot_check_core::Obligation,operands: u32[4]) -> u32,Error {
 var row: u32=0; if operands[3]!=0 { let carrier=host.evidenceStore().node(operands[3]); if carrier.tag!=blot_eval_type_evidence::Tag.function { return 0,blot_error::Error.type_mismatch; } row=carrier.c; }
 if value.kind==blot_check_types::ObligationKind.field||value.kind==blot_check_types::ObligationKind.writable_field { return host.evidenceStore().internWithEffects(blot_eval_type_evidence::Tag.function,operands[0],operands[2],row,[]); }
 let result,error=host.evidenceStore().internWithEffects(blot_eval_type_evidence::Tag.function,operands[1],operands[2],row,[]); if error!=blot_error::Error.none { return 0,error; } return host.evidenceStore().internWithEffects(blot_eval_type_evidence::Tag.function,operands[0],result,row,[]);
}
fn predicate<H,R>(host: H&,context: u32,value: blot_check_core::Obligation,mappings: const Mapping[:],rows: const RowMapping[:],resolver_context:R,resolver_remaining:i64&,resolver_enabled:bool) -> bool,Error { let fact,present,error=closedPredicate(host,context,value,mappings,rows,resolver_context,resolver_remaining,resolver_enabled); return present,error; }
fn deinit(self_: Store&) { if self_.lease==0 { return; } assert(valid(self_)); self_.proofs.deinit(); self_.arguments.deinit(); self_.members.deinit(); self_.edges.deinit(); self_.active_arguments.deinit(); self_.active.deinit(); self_.active_projections.deinit(); self_.provisional_equations.deinit(); self_.provisional_mappings.deinit(); self_.provisional_rows.deinit(); self_.next.deinit(); self_.active_facts.deinit(); release(self_.buckets); release(self_.facts); let at=self_.lease-1; states[at].live=false; states.free(at); let handle=self_.handle_index; self_=Store {}; if handle>=0 { handles.free(handle); } }
fn reset(self_: Store) { assert(valid(self_)); self_.proofs.clear(); self_.arguments.clear(); self_.members.clear(); self_.edges.clear(); self_.active_arguments.clear(); self_.active.clear(); self_.active_projections.clear(); self_.provisional_equations.clear(); self_.provisional_mappings.clear(); self_.provisional_rows.clear(); self_.next.clear(); self_.active_facts.clear(); self_.buckets.clear(); self_.facts.clear(); self_.trace=blot_eval_implementation_trace::Record {..}; self_.failure=blot_support::none<Code>(); self_.candidates=0; self_.prerequisite_edges=0; self_.hits=0; self_.max_depth=0; self_.owner_id=blot_native::fresh_owner_id(); }

struct LongWords { storage: u64[:]=default<u64[:]>(),items: u64[:]=default<u64[:]>(),len: i64=0,failure: Error=blot_error::Error.none }
reusable[] var pool_LongWords: u64[>..]=[];
fn ensure(self_: LongWords&,minimum: i64) -> Error { if self_.failure!=blot_error::Error.none { return self_.failure; } let error=blot_support_pooled_buffer::ensure(self_,minimum,pool_LongWords); if error!=blot_error::Error.none { self_.failure=error; } return error; }
fn push(self_: LongWords&,value: u64) { if self_.failure!=blot_error::Error.none { return; } self_.failure=blot_support_pooled_buffer::push(self_,value,pool_LongWords); self_.len=self_.items.len; }
fn append(self_: LongWords&,values: const u64[:]) { if self_.failure!=blot_error::Error.none { return; } self_.failure=blot_support_pooled_buffer::append(self_,values,pool_LongWords); self_.len=self_.items.len; }
fn resize(self_: LongWords&,length: i64) { blot_support_pooled_buffer::resize(self_,length); self_.len=length; }
fn resize(self_: LongWords&,length: i64,value: u64) { if length<=self_.len { resize(self_,length); return; } let error=ensure(self_,length); if error!=blot_error::Error.none { return; } for index in self_.len..length { self_.storage[index]=value; } self_.items=self_.storage[..length]; self_.len=length; }
fn clear(self_: LongWords&) { blot_support_pooled_buffer::clear(self_); self_.len=0; self_.failure=blot_error::Error.none; }
fn deinit(self_: LongWords&) { blot_support_pooled_buffer::deinit(self_,pool_LongWords); self_.len=0; self_.failure=blot_error::Error.none; }
