data Vec2 = Vec2 { x: F32, y: F32 }
data Body a = Body { position: Vec2, payload: a }
data Selection = Selected { index: U32 } | Cleared {}

fn Vec2.add left => fn right => do:
  let Vec2 { x: left_x, y: left_y } = left
  let Vec2 { x: right_x, y: right_y } = right
  return Vec2 {
    x: F32.add left_x right_x,
    y: F32.add left_y right_y,
  }

fn coordinate body => case body of
  Body { position: Vec2 { x }, payload: Selected { index } } => F32.add x (U32.to_f32 index)
  Body { payload: Cleared {} } => 0.0

const origin = Vec2 { y: 2.0, x: 20.0 }
const movement = Vec2 { x: 20.0, y: 1.0 }
const bodies = [Body { payload: Selected { index: 2 }, position: Vec2.add origin movement }]

export const expected = coordinate (@array.get bodies 0)
export fn answer () => coordinate (@array.get bodies 0)
