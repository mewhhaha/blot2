import std;import os;import owned_wasm_emit;
fn main(){let s="type Scalar[r: Region] = U32\nlet consume: (Owned[Scalar[_]], Bool) -> U32 ! {release} = fn (h, flag) => do:\n  let value = owned.open(h) as r data in do:\n    break data\n  owned.close(h)\n  return value\ntype ScalarPayload[r: Region] = U32\nlet main: Unit -> Result[U32,#Reserve(ReserveError) | #Body(#Cancelled)] ! {reserve,release} = fn () => do:\n  let built = owned@[ScalarPayload[_],#Cancelled](0) as r free in do:\n    seal(free,4294967295)\n  case built:\n    #Err(e) => return #Err(e)\n    #Ok(h) => return #Ok(consume(h,#True))\n";let b=owned_wasm_emit::emit(s);assert(b.len>0 && write_file("owned-wasm.wasm",b));print("private owned wasm emitted");}
