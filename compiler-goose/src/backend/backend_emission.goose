fn bodyMappings(body:u32)->MappingRead {let header=blot_backend_resolved_body::header(body);return MappingRead{body:body,owner_id:header.owner_id,len:header.mappings.len,..};}
fn bufferMappings(buffer:const MappingBuffer&)->MappingRead {let key=blot_backend_substitution_buffers::readKey(buffer);return MappingRead{buffer:key,len:key.len,..};}
fn takeMappings(buffer:MappingBuffer&)->MappingRead {let key=blot_backend_substitution_buffers::takeRead(buffer);return MappingRead{buffer:key,len:key.len,..};}
fn valid(key:MappingRead)->bool {if key.body!=0 {if !blot_backend_resolved_body::validBodyRead(key.body,key.owner_id) {return false;}let length=blot_backend_resolved_body::headers[key.body-1].mappings.len;return key.buffer.lease==0 && key.offset>=0 && key.len>=0 && key.offset<=length && key.len<=length-key.offset;}return key.owner_id==0 && key.offset==0 && key.len==key.buffer.len && blot_backend_substitution_buffers::valid(key.buffer);}
fn readMappings(key:MappingRead)->const Mapping[:] {assert(valid(key));if key.body!=0 {return blot_backend_resolved_body::readMappings(key.body,key.owner_id,key.offset,key.len);}return blot_backend_substitution_buffers::read(key.buffer);}
