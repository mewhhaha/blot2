 // Optional per-compilation observations. Count-based samples survive a bounded
 // failing prefix without adding per-query clock reads or retaining AST facts.
+// Historical container membership only. Event contents/classification remain live.
+// Append/replace are the only membership mutations; replaced IDs stay on old
+// postings too, with the query's original live-container guard removing them.
+struct HolderStoreIndex {
+    using Id = uint32_t;
+    unordered_map<const void *, vector<Id>> postings;
+    const vector<Id> empty;
+    size_t capacity = 0, count = 0;
+    size_t max_capacity = size_t(1) << 25, max_holders = size_t(1) << 18;
+    bool active = true;
+    const char *fallback_reason = "none";
+    bool profile = [] {
+        auto trace = getenv("GOOSE_CHECKER_TRACE"), full = getenv("GOOSE_CHECKER_PROFILE");
+        return (trace && *trace) || (full && *full);
+    }();
+    uint64_t queries = 0, hits = 0, misses = 0, visits = 0, fallbacks = 0, inserted = 0;
+    void Report() const {
+        if (!profile) return;
+        fprintf(stderr, "GOOSE_CHECKER_PROFILE holder_events active=%d queries=%llu hits=%llu misses=%llu visits=%llu fallbacks=%llu holders=%zu ids=%zu capacity=%zu inserted=%llu reason=%s max_holders=%zu max_capacity=%zu\n",
+                active, (unsigned long long)queries, (unsigned long long)hits,
+                (unsigned long long)misses, (unsigned long long)visits,
+                (unsigned long long)fallbacks, postings.size(), count, capacity,
+                (unsigned long long)inserted, fallback_reason, max_holders, max_capacity);
+    }
+    void Disable(const char *reason) {
+        active = false; fallback_reason = reason;
+        decltype(postings){}.swap(postings);
+        capacity = count = 0;
+        Report();
+    }
+    void Record(const void *holder, size_t id) {
+        if (!active) return;
+        if (id > UINT32_MAX) { Disable("id-range"); return; }
+        auto found = postings.find(holder);
+        if (found == postings.end()) {
+            if (postings.size() >= max_holders) { Disable("holders"); return; }
+            found = postings.try_emplace(holder).first;
+        }
+        auto &ids = found->second;
+        auto at = lower_bound(ids.begin(), ids.end(), (Id)id);
+        if (at != ids.end() && *at == id) return;
+        auto offset = (size_t)(at - ids.begin());
+        if (ids.size() == ids.capacity()) {
+            if (capacity >= max_capacity) { Disable("capacity"); return; }
+            auto old = ids.capacity();
+            auto wanted = std::max(size_t(1), old * 2);
+            wanted = std::min(wanted, old + max_capacity - capacity);
+            ids.reserve(wanted);
+            auto growth = ids.capacity() - old;
+            if (growth > max_capacity - capacity) { Disable("capacity"); return; }
+            capacity += growth;
+        }
+        ids.insert(ids.begin() + offset, (Id)id);
+        ++count; ++inserted;
+        if (profile && (inserted & ((UINT64_C(1) << 20) - 1)) == 0) Report();
+    }
+    const vector<Id> *Find(const void *holder) {
+        const vector<Id> *result = nullptr;
+        if (active) {
+            auto found = postings.find(holder);
+            if (found == postings.end()) { result = &empty; if (profile) ++misses; }
+            else { result = &found->second; if (profile) ++hits; }
+        } else if (profile) ++fallbacks;
+        if (profile && (++queries & ((UINT64_C(1) << 14) - 1)) == 0) Report();
+        return result;
+    }
+    ~HolderStoreIndex() { Report(); }
+};
+
