}
fn knownInstance(self:Walker&,instance:blot_check_types::NominalIdentity)->bool,Error {return self.knownInstanceDepth(instance,0);}
recursive fn knownInstanceDepth(self:Walker&,instance:blot_check_types::NominalIdentity,depth:i64)->bool,Error {let error=self.step(depth);if error!=Error.none {return false,error;}if instance.decl==0 {return instance.unit==0,Error.none;}let owner .= self.scope_owner;while owner {let error=self.step(0);if error!=Error.none {return false,error;}if owner.identity==instance {return true,Error.none;}owner .= owner.parent;}if instance.unit==0 && instance.decl<self.module.types.nodes.len {let selected=self.module.types.node(instance.decl);if selected.tag!=blot_check_types::Tag.instance_selection {return false,Error.none;}let choices=self.module.types.nominalArguments(selected);if choices.len!=2 && choices.len!=3 {return false,Error.invalid_artifact;}for choice in choices[..2] {let capability=self.module.types.node(choice);if capability.tag!=blot_check_types::Tag.scoped {return false,Error.invalid_artifact;}let known,error=self.knownInstanceDepth(blot_check_types::NominalIdentity{unit:capability.b,decl:capability.c, ..},depth+1);if error!=Error.none || !known {return false,error;}}return true,Error.none;}return false,Error.none;}
