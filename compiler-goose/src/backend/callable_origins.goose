        if at == 0 || at + 1 >= code.len || code[at].op != blot_backend_runtime_ir::OP_i32_const || !code[at].table_reference || code[at].table_kind != origin.kind || code[at].operand != origin.target || code[at - 1].op != blot_backend_runtime_ir::OP_local_get || code[at + 1].op != blot_backend_runtime_ir::OP_i32_store || code[at + 1].operand != 0 {return blot_support::none<Construction>();}
        let local = code[at - 1].operand;if local < body.parameters.len || local >= body.parameters.len + module.locals(body).len || module.locals(body)[local - body.parameters.len] != blot_backend_runtime_ir::VT_i32 {return blot_support::none<Construction>();}var allocation = blot_support::none<i64>();
        for inst,point in code {if (inst.op != blot_backend_runtime_ir::OP_local_set && inst.op != blot_backend_runtime_ir::OP_local_tee) || inst.operand != local {continue;}if allocation.present || inst.op != blot_backend_runtime_ir::OP_local_set || point < 2 || point >= at || code[point - 1].op != blot_backend_runtime_ir::OP_call || code[point - 1].operand != arena.allocate {return blot_support::none<Construction>();}allocation = blot_support::some(point - 1);}
