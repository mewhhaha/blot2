fn physicalField(self:Walker&,goal:blot_check_core::Obligation,depth:i64)->bool,Error {let owner=self.module.types.node(goal.ty);if owner.tag==blot_check_types::Tag.record {for ordinal in 0..owner.b {let error=self.step(depth);if error!=Error.none {return false,error;}if self.module.types.recordField(owner,ordinal).name==goal.name {return true,Error.none;}}return false,Error.none;}if owner.tag!=blot_check_types::Tag.nominal || blot_check_storage_types::identity(owner.a,owner.b).present {return false,Error.none;}for method in self.module.associated {let error=self.step(depth);if error!=Error.none {return false,error;}if method.identity.unit==owner.a && method.identity.decl==owner.b && method.member==goal.name {return false,Error.none;}}for constructor in self.module.constructors {let error=self.step(depth);if error!=Error.none {return false,error;}let family=self.module.nominals[constructor.nominal];if family.identity.unit!=owner.a || family.identity.decl!=owner.b || family.constructors.len!=1 {continue;}let payload=self.module.types.node(constructor.payload);if payload.tag!=blot_check_types::Tag.record {continue;}for ordinal in 0..payload.b {let error=self.step(depth);if error!=Error.none {return false,error;}if self.module.types.recordField(payload,ordinal).name==goal.name {return true,Error.none;}}}return false,Error.none;}
fn prerequisiteGoal(self:Walker&,goal:blot_check_core::Obligation,depth:i64)->bool,Error {return self.prerequisiteGoalMode(goal,depth,true);}
fn prerequisiteGoalMode(self:Walker&,goal:blot_check_core::Obligation,depth:i64,shared:bool)->bool,Error {let prior_row=self.body_row;var signature=goal.signature;if goal.kind==blot_check_types::ObligationKind.resolver_dispatch {signature=goal.other;}if signature!=0 {let arrow=self.module.types.node(signature);if arrow.tag!=blot_check_types::Tag.function {return false,Error.invalid_artifact;}self.body_row=arrow.c;}let given,error=self.goalGivenMode(goal,depth+1,shared);if error!=Error.none || given {self.body_row=prior_row;return given,error;}let closed,error=self.closedGoal(goal,depth+1);self.body_row=prior_row;return closed,error;}

fn goalRows(self:Walker&,signature:u32,arity:blot_support::Option<i64>,depth:i64)->Error {var cursor=signature;var count:i64=0;while (!arity.present || count<arity.value) && cursor!=0 && self.module.types.node(cursor).tag==blot_check_types::Tag.function {let error=self.step(depth+count);if error!=Error.none {return error;}let arrow=self.module.types.node(cursor);let error=self.allowedRow(arrow.c,true);if error!=Error.none {return error;}cursor=arrow.b;count+=1;}return require(count!=0 && (!arity.present || count==arity.value));}
