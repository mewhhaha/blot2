grammar Blot

// Precedence and name resolution belong to the semantic checker, not the parser.
token IDENT = /[a-z_][a-z0-9_]*/ ;
token TYPE_IDENT = /[A-Z][A-Za-z0-9_]*/ ;
token INTEGER = /(0[xX][0-9A-Fa-f](_?[0-9A-Fa-f])*|[0-9](_?[0-9])*)/ ;
token FLOAT = /[0-9](_?[0-9])*(\.[0-9](_?[0-9])*([eE][+-]?[0-9](_?[0-9])*)?|[eE][+-]?[0-9](_?[0-9])*)/ ;
token STRING = /"([^"\\\r\n]|\\["\\nrt])*"/ ;
token INTRINSIC priority 3 = /@[a-z_][a-z0-9_]*(\.[a-z_][a-z0-9_]*)*/ ;
token SYMBOL = /([+*$%=!<>^&|?-]+|\/)/ ;
token LAYOUT_NEWLINE = // ;
token LAYOUT_INDENT = // ;
token LAYOUT_DEDENT = // ;
skip WHITESPACE = /[ \t\r\n]+/ ;
skip COMMENT priority 3 = /\/\/[^\r\n]*/ ;

program = (imports:import_declaration* declarations:declaration*) ;
import_declaration = ("import" binding:(namespace_import | named_import) "froM" path:STRING LAYOUT_NEWLINE) ;
namespace_import = ("*" "as" name:IDENT) ;
named_import = ("{" (bindings:import_binding ("," bindings:import_binding)* ","?)? "}") ;
import_binding = (name:(IDENT | TYPE_IDENT) alias:("as" (IDENT | TYPE_IDENT))?) ;
declaration = (attributes:declaration_attribute* value:(value_declaration | data_type | type_alias | contract_type | effect_declaration | effect_type | symbolic_fixity | named_fixity) LAYOUT_NEWLINE) ;
type_alias = ("type" name:TYPE_IDENT parameters:type_atom? ("=>" "type" parameters:type_atom)* "=" value:type_expression) ;
contract_type = ("type" name:TYPE_IDENT parameters:type_atom? ("=>" "type" parameters:type_atom)* "is" kind:IDENT "=" body:constraint_body) ;
declaration_attribute = ("@" body:attribute_name LAYOUT_NEWLINE?) ;
attribute_name = ("[" value:expression "]") ;
value_declaration = (modifier:IDENT? kind:("const" | "let") name:qualified_name annotation:(":" type_expression)? where:where_clause? "=" value:expression) ;
effect_declaration = ("effect" name:qualified_name ":" signature:type_expression) ;
effect_type = ("type" name:TYPE_IDENT parameters:type_atom? ("=>" "type" parameters:type_atom)* "is" "effect" "=" (operations:effect_operations | signature:effect_signature)) ;
// A bare record declares operations; signatures start with a type name or group.
effect_signature = (head:effect_signature_application results:("->" type_application)* effects:effect_row?) ;
effect_signature_application = (head:effect_signature_atom arguments:type_atom*) ;
effect_signature_atom = (qualified_name | type_group) ;
effect_operations = ("{" LAYOUT_NEWLINE? (fields:effect_operation (("," LAYOUT_NEWLINE? | LAYOUT_NEWLINE) fields:effect_operation)* ("," LAYOUT_NEWLINE? | LAYOUT_NEWLINE)?)? "}") ;
effect_operation = (name:IDENT ":" signature:type_expression) ;
data_type = (("data" name:TYPE_IDENT parameters:type_atom? ("=>" "type" parameters:type_atom)* "=" | "type" name:TYPE_IDENT parameters:type_atom? ("=>" "type" parameters:type_atom)* "is" "data" "=") "|"? constructors:constructor ("|" constructors:constructor)*) ;
constructor = ("#" name:TYPE_IDENT payload:type_expression?) ;
symbolic_fixity = (associativity:("infixl" | "infixr" | "infix") precedence:INTEGER "(" symbol:(SYMBOL | "$" | "*" | "^" | "|") ")" "=" target:qualified_name) ;
named_fixity = (associativity:("infixl" | "infixr" | "infix") precedence:INTEGER "`" target:qualified_name "`") ;
qualified_name = (root:(IDENT | TYPE_IDENT) rest:("." (IDENT | TYPE_IDENT))*) ;
parameter = (demand:"~"? (name:IDENT | "(" (name:IDENT ":" annotation:type_expression where:where_clause?)? ")")) ;
type_array = ("[" (elements:type_expression ("," elements:type_expression)* ","?)? "]") ;
type_record = ("{" (fields:type_field ("," fields:type_field)* ","?)? "}") ;
type_field = (name:IDENT (":" value:type_expression)?) ;
type_expression = (head:type_application results:("->" type_application)* effects:effect_row?) ;
effect_row = ("!" "{" (labels:type_application ("," labels:type_application)*)? ("|" tail:IDENT)? "}") ;
// The frontend promotes `where` to this same-width private marker only after
// an annotation. Other uses remain ordinary IDENT, including type variables.
where_clause = (marker:"wherE" body:constraint_body) ;
constraint_body = ("{" LAYOUT_NEWLINE? (predicates:constraint_predicate ("," LAYOUT_NEWLINE? predicates:constraint_predicate)* ","?)? LAYOUT_NEWLINE? "}") ;
constraint_predicate = (kind:qualified_name member:STRING? arguments:type_atom* effects:effect_row?) ;
type_application = (head:type_atom arguments:type_atom*) ;
demand_type = ("~" value:type_atom) ;
type_atom = (qualified_name | type_group | type_array | type_record | demand_type) ;
type_group = ("(" (value:type_expression ("," value:type_expression)* ","?)? ")") ;

expression = (value:(lambda | do_block | case_expression | if_expression | infix_expression)) ;
lambda = ("fn" parameter:parameter result:("->" type_expression)? "=>" body:expression) ;
infix_expression = (head:prefix_expression tails:infix_tail*) ;
// Standalone $, *, and ^ are also reserved by forwarding, imports, and patterns.
infix_tail = (operator:(SYMBOL | "$" | "*" | "^" | "|" | named_operator) argument:(lambda | do_block | case_expression | if_expression | prefix_expression)) ;
prefix_expression = (operator:(SYMBOL | "*" | "^")? value:application) ;
named_operator = ("`" name:qualified_name "`") ;
application = (head:atom arguments:(atom | member_access)*) ;
member_access = ("." name:(IDENT | TYPE_IDENT)) ;
atom = (FLOAT | INTEGER | STRING | INTRINSIC | selector | type_witness | constructor_reference | qualified_name | group | comprehension | collection_spread | collection_cons | list | array | record_values) ;
constructor_reference = ("#" value:(record | qualified_name | "True" | "False")) ;
selector = ("·" name:(IDENT | TYPE_IDENT) ("." name:(IDENT | TYPE_IDENT))*) ;
type_witness = (":" value:atom) ;
if_expression = ("if" condition:infix_expression "then" consequence:expression "else" alternative:expression) ;
record = (name:qualified_name fields:record_values) ;
record_values = ("{" (fields:record_value ("," fields:record_value)* ","?)? "}") ;
record_value = (name:IDENT (":" value:expression)?) ;
group = ("(" (value:expression ("," value:expression)*)? ")") ;
list = ("[" (elements:collection_expression ("," elements:collection_expression)* ","?)? "]") ;
array = ("#" "[" (elements:collection_expression ("," elements:collection_expression)* ","?)? "]") ;
collection_open = ("#"? "[") ;
collection_spread = (opening:collection_open (prefix:collection_expression ",")* "..." tail:collection_expression ("," suffix:collection_expression)* ","? "]") ;
collection_cons = (opening:collection_open elements:collection_expression ("," elements:collection_expression)* "|" tail:expression "]") ;
comprehension = (opening:collection_open body:collection_expression "|" first:generator ("," rest:comprehension_qualifier)* "]") ;
comprehension_qualifier = (generator | comprehension_binding | comprehension_guard) ;
generator = (name:IDENT "<-" value:expression) ;
comprehension_binding = ("let" name:IDENT "=" value:expression) ;
comprehension_guard = (value:expression) ;
do_block = ("do" resolver:application? ":" body:suite) ;
case_expression = ("case" values:expression ("," values:expression)* "of" body:case_suite) ;
case_suite = (LAYOUT_NEWLINE LAYOUT_INDENT arms:case_arm* LAYOUT_DEDENT) ;
case_arm = (alternatives:pattern_row ("|" alternatives:pattern_row)* ("if" guard:expression)? "=>" body:expression LAYOUT_NEWLINE) ;
pattern_row = (patterns:pattern ("," patterns:pattern)*) ;
pattern = (IDENT | INTEGER | constructor_pattern | pattern_group | record_pattern | value_pattern | boolean_constructor_pattern) ;
boolean_constructor_pattern = ("#" value:("True" | "False")) ;
value_pattern = ("^" name:qualified_name) ;
constructor_pattern = ("#" name:(TYPE_IDENT | qualified_constructor) (fields:record_pattern | payload:pattern)?) ;
qualified_constructor = (((IDENT | TYPE_IDENT) ".")+ TYPE_IDENT) ;
pattern_group = ("(" (value:pattern ("," value:pattern)*)? ")") ;
record_pattern = ("{" (fields:record_pattern_field ("," fields:record_pattern_field)* ","?)? "}") ;
record_pattern_field = (name:IDENT (":" value:pattern)?) ;
suite = (LAYOUT_NEWLINE LAYOUT_INDENT statements:statement* LAYOUT_DEDENT) ;
statement = (value:(binding | rebinding | effect_binding | effect_step | result | reply | loop_exit | request_case | pattern_conditional | conditional | ever_statement | range_statement | for_statement | expression) LAYOUT_NEWLINE) ;
binding = ("let" pattern:pattern annotation:(":" type_expression)? where:where_clause? "=" value:expression fallback:binding_else?) ;
rebinding = (name:IDENT path:(member_access | index_access)* ":=" value:expression) ;
index_access = ("[" index:expression "]") ;
for_statement = ("for" "let"? pattern:pattern "in" start:expression (".." end:expression)? ":" body:suite) ;
range_statement = ("for" start:expression ".." end:expression ":" body:suite) ;
ever_statement = ("for" "ever" ":" body:suite) ;
binding_else = ("else" ":" alternative:suite) ;
// Separate islands avoid Baba's equal-length IDENT/expression transition tie.
effect_binding = ("use" name:IDENT annotation:(":" type_expression)? "<-" value:expression) ;
effect_step = ("use" value:expression) ;
result = ("return" forwarding:"$"? value:expression) ;
reply = ("yield" value:expression) ;
loop_exit = ("break") ;
request_case = ("case" request:IDENT "of" body:request_case_suite) ;
request_case_suite = (LAYOUT_NEWLINE LAYOUT_INDENT arms:request_arm* LAYOUT_DEDENT) ;
request_arm = (kind:"effect" operation:(qualified_name | group) pattern:pattern "=>" body:suite LAYOUT_NEWLINE | kind:"complete" pattern:pattern "=>" body:suite LAYOUT_NEWLINE) ;
pattern_conditional = ("if" "let" pattern:pattern "=" value:expression ":" consequence:suite fallback:else_clause?) ;
conditional = ("if" condition:expression ":" consequence:suite fallback:else_clause?) ;
else_clause = (LAYOUT_NEWLINE? "else" ":" alternative:suite) ;

// At this nesting level a pipe begins comprehension qualifiers or a cons tail.
// Parenthesized and nested expressions retain the ordinary operator grammar.
collection_expression = (value:(collection_lambda | do_block | case_expression | collection_if | collection_infix)) ;
collection_lambda = ("fn" parameter:parameter result:("->" type_expression)? "=>" body:collection_expression) ;
collection_if = ("if" condition:collection_infix "then" consequence:collection_expression "else" alternative:collection_expression) ;
collection_infix = (head:prefix_expression tails:collection_infix_tail*) ;
collection_infix_tail = (operator:(SYMBOL | "$" | "*" | "^" | named_operator) argument:(collection_lambda | do_block | case_expression | collection_if | prefix_expression)) ;
