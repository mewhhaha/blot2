fn aggregate(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let module=self.units[owner]; let n=module.node(id); let operands=module.children(id); var values: ValueId[>..<]=[]; values.resize(operands.len); for operand,index in operands { let outcome,error=expression(self,owner,operand,frame); if error!=Error.none||!isValue(outcome) { return outcome,error; } var destination=index; if n.tag==CoreTag.record { destination=module.recordDestinations(id)[index]; } if destination>=values.len { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } values[destination]=flowValue(outcome); }
