 blot_check_core::PatternTag.bind=>{let binding=self.module.binding(pattern.a);if binding.kind!=blot_check_core::BindingKind.local || binding.initializer!=0 || pattern.b!=0 || pattern.c!=0 {return Error.invalid_artifact;}let error=self.same(binding.ty,expected);if error!=Error.none {return error;}if binding.scheme.root!=0 {let error=self.same(binding.scheme.root,expected);if error!=Error.none {return error;}}let error=self.scheme(binding.scheme);if error!=Error.none {return error;}let locals .= definitions;if locals {if locals.isSet(pattern.a) {return Error.invalid_artifact;}return locals.set(pattern.a);}return Error.none;},
 blot_check_core::PatternTag.product=>{let shape=self.module.types.node(expected);let children=self.module.patternChildren(id);if (shape.tag!=blot_check_types::Tag.product && shape.tag!=blot_check_types::Tag.record) || children.len!=shape.b || pattern.c!=0 {return Error.invalid_artifact;}for child,index in children {var part:u32=0;if shape.tag==blot_check_types::Tag.product {part=self.module.types.list(List{start:shape.a,len:shape.b, ..})[index];}else {part=self.module.types.recordField(shape,index).ty;}let error=self.pattern(child,part,definitions,depth+1);if error!=Error.none {return error;}}return Error.none;},
 blot_check_core::PatternTag.constructor=>{if pattern.c!=0 {return Error.invalid_artifact;}let constructor=self.module.constructor(pattern.a);let family=self.module.nominals[constructor.nominal];if family.is_opaque && family.identity.unit!=self.module.unit {return Error.invalid_artifact;}var proof=Principal{left:self.module.types,right:self.module.types,remaining:self.scopes.remaining,views:self.scopes,instance:constructor.scheme.variables,instance_rows:constructor.scheme.row_variables, ..};let signature=self.module.types.node(constructor.scheme.root);if signature.tag==blot_check_types::Tag.function {let error=proof.validate(signature.b,expected);if error!=Error.none {return error;}if pattern.b==0 {return Error.invalid_artifact;}let error=proof.validate(constructor.payload,self.module.pattern(pattern.b).ty);if error!=Error.none {return error;}return self.pattern(pattern.b,self.module.pattern(pattern.b).ty,definitions,depth+1);}if pattern.b!=0 || constructor.payload!=0 {return Error.invalid_artifact;}return proof.validate(constructor.scheme.root,expected);},
