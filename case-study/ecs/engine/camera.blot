import * as ecs from "engine/ecs"
import { resource, Event, Update, Render } from "engine/ecs"
import * as render from "engine/render"
import * as app from "./app"
import { Frame } from "./app"
import * as input from "./input"
import { Input, FocusLost, PointerDown, PointerUp, Secondary, PointerMoved, Scrolled } from "./input"
import { Vec3, wrap_angle } from "./spatial"

#[resource]
type OrbitCamera is data = #OrbitCamera { yaw: F32, pitch: F32, distance: F32 }
#[resource]
type Orbiting is data = #Orbiting Bool
#[resource]
type OrbitControls is data = #OrbitControls {
  left: U32, right: U32, inward: U32, outward: U32, speed: F32,
}

const half_fov_tangent = F32.tan 0.5235987756

const axis = fn keys => fn negative => fn positive => case input.held keys negative, input.held keys positive of
  #True, #False => -1.0
  #False, #True => 1.0
  _, _ => 0.0

const receive = fn () => do:
  use controls <- ecs.get #Input
  use orbiting_value <- ecs.get #Orbiting
  use camera <- ecs.get #OrbitCamera
  let #Orbiting orbiting = orbiting_value
  let (next, active) = case controls.event, orbiting of
    #FocusLost, _ => (camera, #False)
    #PointerDown #Secondary, _ => (camera, #True)
    #PointerUp #Secondary, _ => (camera, #False)
    #Scrolled wheel, _ => do:
      let next = camera
      next.distance := F32.clamp 3.0 24.0 (self + wheel * 0.005)
      return (next, orbiting)
    #PointerMoved, #True => do:
      let next = camera
      next.yaw := wrap_angle (self - controls.delta.x * 0.006)
      next.pitch := F32.clamp 0.15 1.35 (self + controls.delta.y * 0.005)
      return (next, #True)
    _, _ => (camera, orbiting)
  use ecs.set next
  use ecs.set (#Orbiting active)
  return ()

const tick = fn () => do:
  use frame_value <- ecs.get Frame
  use controls <- ecs.get #OrbitControls
  use keys <- ecs.get #Input
  use camera <- ecs.get #OrbitCamera
  let #Frame frame = frame_value
  let turn = axis keys.held controls.left controls.right
  let zoom = axis keys.held controls.inward controls.outward
  let next = camera
  next.yaw := wrap_angle (self + turn * frame.seconds * controls.speed)
  next.distance := F32.clamp 3.0 24.0 (self + zoom * frame.seconds * 6.0)
  use ecs.set next
  return ()

// No hit includes a minimized viewport, a parallel ray or a plane behind the eye.
const ground_point = fn camera => fn viewport => fn pointer => fn ground_height => do:
  if Bool.not (F32.gt viewport.width 0.0):
    return #Nothing
  if Bool.not (F32.gt viewport.height 0.0):
    return #Nothing
  let sin_yaw = F32.sin camera.yaw
  let cos_yaw = F32.cos camera.yaw
  let sin_pitch = F32.sin camera.pitch
  let cos_pitch = F32.cos camera.pitch
  let back_x = sin_yaw * cos_pitch
  let back_z = cos_yaw * cos_pitch
  let eye_x = back_x * camera.distance
  let eye_y = sin_pitch * camera.distance
  let eye_z = back_z * camera.distance
  let x = ((2.0 * pointer.x / viewport.width - 1.0) * half_fov_tangent) * (viewport.width / viewport.height)
  let y = (1.0 - 2.0 * pointer.y / viewport.height) * half_fov_tangent
  let direction_x = cos_yaw * x - back_x - sin_yaw * sin_pitch * y
  let direction_y = cos_pitch * y - sin_pitch
  let direction_z = (F32.neg back_z) - sin_yaw * x - cos_yaw * sin_pitch * y
  if F32.lt (F32.abs direction_y) 1e-6:
    return #Nothing
  let length = (ground_height - eye_y) / direction_y
  if F32.le length 0.0:
    return #Nothing
  let ground_x = eye_x + direction_x * length
  let ground_z = eye_z + direction_z * length
  if Bool.not (F32.is_finite ground_x):
    return #Nothing
  if Bool.not (F32.is_finite ground_z):
    return #Nothing
  return #Some (#Vec3 { x: ground_x, y: ground_height, z: ground_z })

const project = fn () => do:
  use frame_value <- ecs.get Frame
  use current <- ecs.get #OrbitCamera
  use previous <- ecs.previous #OrbitCamera
  let #Frame frame = frame_value
  let width = frame.viewport.width
  let height = frame.viewport.height
  let yaw = F32.lerp_angle previous.yaw current.yaw frame.alpha
  let pitch = F32.lerp previous.pitch current.pitch frame.alpha
  let distance = F32.lerp previous.distance current.distance frame.alpha
  if Bool.not (F32.gt current.distance 0.0):
    use @panic "Camera distance must be positive"
  if Bool.not (F32.gt distance 0.0):
    use @panic "Camera distance must be positive"
  if Bool.not (F32.gt width 0.0):
    use @panic "Viewport dimensions must be positive"
  if Bool.not (F32.gt height 0.0):
    use @panic "Viewport dimensions must be positive"
  let sin_yaw = F32.sin yaw
  let cos_yaw = F32.cos yaw
  let sin_pitch = F32.sin pitch
  let cos_pitch = F32.cos pitch
  let right_x = cos_yaw
  let right_z = F32.neg sin_yaw
  let up_x = F32.neg (sin_yaw * sin_pitch)
  let up_y = cos_pitch
  let up_z = F32.neg (cos_yaw * sin_pitch)
  let back_x = sin_yaw * cos_pitch
  let back_y = sin_pitch
  let back_z = cos_yaw * cos_pitch
  use render.view [
    right_x, up_x, back_x, 0.0,
    0.0, up_y, back_y, 0.0,
    right_z, up_z, back_z, 0.0,
    0.0, 0.0, F32.neg distance, 1.0,
  ]
  let tangent = 1.0 / half_fov_tangent
  let depth = 100.0 / (0.1 - 100.0)
  let translation = 10.0 / (0.1 - 100.0)
  use render.projection [
    tangent * height / width, 0.0, 0.0, 0.0,
    0.0, tangent, 0.0, 0.0,
    0.0, 0.0, depth, -1.0,
    0.0, 0.0, translation, 0.0,
  ]
  return ()

// Install after input.plugin; game bindings and initial camera are explicit.
const plugin = fn initial => fn controls => fn builder => do:
  let next = app.insert_resource initial builder
  next := app.insert_resource controls self
  next := app.insert_resource (#Orbiting #False) self
  next := app.add_system #Event receive self
  next := app.add_system #Update tick self
  next := app.add_system #Render project self
  return next
