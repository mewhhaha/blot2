fn Walker::providerRows(self:Walker&,source:u32,depth:i64)->Error {let error=self.step(depth);if error!=Error.none {return error;}let node=self.module.node(source);if node.tag==blot_check_core::Tag.operation_value {let operation=self.module.operationValue(source);let error=self.operationAuthority(operation);if error!=Error.none {return error;}let signature=self.module.types.node(operation.signature);let view=self.module.types.node(node.ty);if signature.tag!=blot_check_types::Tag.function || view.tag!=blot_check_types::Tag.function {return Error.invalid_artifact;}for row_id in [signature.c,view.c] {let row=self.module.types.row(row_id);match row.tail {blot_check_effects::Tail.variable tail=>{let owned,error=self.scopes.ownsRow(tail.value);if error!=Error.none {return error;}if !owned {let error=self.scopes.closed_rows.set(row_id);if error!=Error.none {return error;}}},_=>{},}}return Error.none;}if node.tag!=blot_check_core::Tag.effect_provider {return Error.none;}let provider=self.module.types.node(node.ty);let implementation=self.module.node(node.b);if provider.tag!=blot_check_types::Tag.provider || implementation.tag!=blot_check_core::Tag.closure {return Error.none;}let closure=self.module.closure(node.b);let arrow=self.module.types.node(closure.function_type);if arrow.tag!=blot_check_types::Tag.function || arrow.c!=provider.c {return Error.none;}let row=self.module.types.row(provider.c);match row.tail {blot_check_effects::Tail.variable tail=>{if !wordContains(self.module.types.list(closure.closed_rows),tail.value) {return Error.none;}},_=>{return Error.none;},}let error=self.scopes.closed_rows.set(provider.c);if error!=Error.none {return error;}if row.labels.len==0 {return self.scopes.pure_rows.set(provider.c);}return Error.none;}
