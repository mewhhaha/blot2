// Event log of variant records (Tick, Move, Say, Quit) with a packed byte pool
// for Say strings, scanned 4 times.
import * as rng from "./rng"

const BENCH_N: U32 = 2000000 // BENCH_N
const PASSES: U32 = 4

type Event is data = $Tick | $Move { id: U32, dx: I32, dy: I32 } | $Say { id: U32, start: U32, len: U32 } | $Quit { id: U32, code: U32 }

io bench (): #[U32] =>
  let log: #[Event] = Array.with_capacity BENCH_N
  let text: #[U8] = Array.with_capacity (BENCH_N * 3)
  let r: U64 = 12345u64

  for _ in 0 .. BENCH_N:
    r := rng.xs_next self
    let k = (r & 7u64).to_u32
    let id = ((r >> 3u64) % 100000u64).to_u32
    if k < 4:
      let dx = ((r >> 20u64) % 201u64).to_u32.to_i32 - 100i32
      let dy = ((r >> 40u64) % 201u64).to_u32.to_i32 - 100i32
      log := self.push ($Move { id, dx, dy })
    else:
      if k < 6:
        let wr = rng.xs_next r
        let n = 4 + (wr % 12u64).to_u32
        let start = text.length
        for _ in 0 .. n:
          wr := rng.xs_next self
          text := self.push (97 + (wr % 26u64).to_u32).to_u8
        log := self.push ($Say { id, start, len: n })
      else:
        if k < 7:
          let code = ((r >> 20u64) & 255u64).to_u32
          log := self.push ($Quit { id, code })
        else:
          log := self.push $Tick

  let total: I64 = 0i64
  for _ in 0 .. PASSES:
    for i in 0 .. log.length:
      case log[i] of
        $Tick => do:
          total := self + 1i64
        $Move { id, dx, dy } => do:
          total := self + id.to_i64 + dx.to_i64 + dy.to_i64
        $Say { id, start, len } => do:
          total := self + id.to_i64 + len.to_i64 + text[start].to_i64
        $Quit { id, code } => do:
          total := self + id.to_i64 + code.to_i64

  let out: #[U32] = #[]
  out := rng.emit_u32 self log.length
  out := rng.emit_i64 self total
  return out
