}
reusable[] var completed_runs:bool[>..];
fn groundSharedFieldOwner(self:Walker&,solver:blot_check_scheme_equations::Solver&,producer:const Module&,scheme:blot_check_types::Scheme,copy:blot_check_check_scheme_import::Copier&,receiver:u32,depth:i64)->bool,Error {if solver.store.node(solver.store.head(receiver,0)).tag!=blot_check_types::Tag.variable {return true,Error.none;}let source_goals=producer.obligations[scheme.obligations.start..scheme.obligations.start+scheme.obligations.len];let completed=completed_runs.alloc_slice(source_goals.len);for &done in completed {done=false;}let result,error=groundFieldValue(self,solver,source_goals,copy,receiver,depth,completed);completed_runs.free_slice(completed);return result,error;}
fn groundFieldValue(self:Walker&,solver:blot_check_scheme_equations::Solver&,source_goals:const blot_check_core::Obligation[:],copy:blot_check_check_scheme_import::Copier&,receiver:u32,depth:i64,completed:bool[:])->bool,Error {var progress=true;while progress {let error=self.step(depth);if error!=Error.none {return false,error;}progress=false;for source_goal,index in source_goals {if completed[index] || (source_goal.kind!=blot_check_types::ObligationKind.field && source_goal.kind!=blot_check_types::ObligationKind.writable_field) {continue;}let copied,error=copyGoal(solver,copy,source_goal);if error!=Error.none {return false,error;}var goal=copied;let resolved,error=solver.resolve(goal.ty);if error!=Error.none {return false,solver.readerError(error);}goal.ty=resolved;if solver.store.node(goal.ty).tag==blot_check_types::Tag.variable {continue;}let point=solver.store.mark();let solved,error=self.prerequisiteGoalMode(goal,depth+1,false);if error!=Error.none {return false,error;}if !solved {solver.rollback(point);if solver.oom {return false,Error.invalid_artifact;}continue;}completed[index]=true;progress=true;if solver.store.node(solver.store.head(receiver,0)).tag!=blot_check_types::Tag.variable {return true,Error.none;}}}return false,Error.none;}
fn goalGiven(self:Walker&,wanted:blot_check_core::Obligation,depth:i64)->bool,Error {return self.goalGivenMode(wanted,depth,true);}
fn goalGivenMode(self:Walker&,wanted:blot_check_core::Obligation,depth:i64,shared:bool)->bool,Error {let error=self.step(depth);if error!=Error.none {return false,error;}for principal in self.scopes.schemes[..self.scopes.scheme_count] {let goals,error=self.scopes.schemeGoals(principal);if error!=Error.none {return false,error;}for given in goals {if given.kind==blot_check_types::ObligationKind.callee_use && wanted.kind!=blot_check_types::ObligationKind.callee_use && self.scopes.solver!=null {if !shared {continue;}let solved,error=self.sharedGoal(blot_support::some(wanted),given,depth+1);if error!=Error.none || solved {return solved,error;}continue;}let candidate,error=self.goalHeaderCandidate(given,wanted);if error!=Error.none {return false,error;}if !candidate {continue;}var proof=Principal{left:self.module.types,right:self.module.types,remaining:self.scopes.remaining,views:self.scopes, ..};let matches,error=self.goalMatches(proof,given,wanted,true);if error!=Error.none {return false,error;}if !matches {continue;}if given.kind!=blot_check_types::ObligationKind.task_receive && given.signature!=0 {let error=self.goalRows(given.signature,self.goalArity(given.kind,given.signature),depth+1);if error!=Error.none {return false,error;}}return true,Error.none;}}for owner in self.scopes.formals[..self.scopes.formal_count] {for given in self.module.types.quantifierGoals(owner) {let candidate,error=self.goalHeaderCandidate(given,wanted);if error!=Error.none {return false,error;}if !candidate {continue;}var proof=Principal{left:self.module.types,right:self.module.types,remaining:self.scopes.remaining,views:self.scopes, ..};let matches,error=self.goalMatches(proof,given,wanted,true);if error!=Error.none {return false,error;}if !matches {continue;}if given.kind!=blot_check_types::ObligationKind.task_receive && given.signature!=0 {let error=self.goalRows(given.signature,self.goalArity(given.kind,given.signature),depth+1);if error!=Error.none {return false,error;}}return true,Error.none;}}for opening in self.scopes.openings[..self.scopes.opening_count] {let owner=self.module.types.node(opening.quantifier);for given in self.module.types.quantifierGoals(opening.quantifier) {let candidate,error=self.goalHeaderCandidate(given,wanted);if error!=Error.none {return false,error;}if !candidate {continue;}var proof=Principal{left:self.module.types,right:self.module.types,remaining:self.scopes.remaining,views:self.scopes,instance:List{start:owner.b,len:owner.c, ..}, ..};for witness,index in self.module.types.list(opening.binders) {proof.witnesses[index]=witness;}let matches,error=self.goalMatches(proof,given,wanted,true);if error!=Error.none {return false,error;}if !matches {continue;}if given.kind!=blot_check_types::ObligationKind.task_receive && given.signature!=0 {let signature,error=self.mappedRoot(proof,given.signature,depth+1);if error!=Error.none {return false,error;}let error=self.goalRows(signature,self.goalArity(given.kind,given.signature),depth+1);if error!=Error.none {return false,error;}}return true,Error.none;}}return false,Error.none;}
fn mappedRoot(self:Walker&,proof:Principal&,root:u32,depth:i64)->u32,Error {if root==0 {return 0,Error.none;}let error=self.step(depth);if error!=Error.none {return 0,error;}let formals=proof.left.list(proof.instance);for index in 0..formals.len {let witness=proof.witnesses[index];if root==formals[index] && witness!=0 {return witness,Error.none;}}match proof.left.node(root).tag {blot_check_types::Tag.unit=>{return blot_check_types::unit,Error.none;},blot_check_types::Tag.boolean=>{return blot_check_types::boolean,Error.none;},blot_check_types::Tag.unsigned32=>{return blot_check_types::u32_type,Error.none;},blot_check_types::Tag.floating32=>{return blot_check_types::f32_type,Error.none;},blot_check_types::Tag.never=>{return blot_check_types::never,Error.none;},_=>{},}for candidate in 1..self.module.types.nodes.len {let error=self.step(depth);if error!=Error.none {return 0,error;}var comparison=proof;comparison.foreign_views=false;if comparison.validate(root,candidate as u32)!=Error.none {continue;}proof.witnesses=comparison.witnesses;proof.row_witnesses=comparison.row_witnesses;proof.scheme_row_witnesses=comparison.scheme_row_witnesses;return candidate as u32,Error.none;}return 0,Error.invalid_artifact;}

fn findWord(values:const u32[:],wanted:u32)->blot_support::Option<i64> {for value,index in values {if value==wanted {return blot_support::some(index);}}return blot_support::none<i64>();}
struct SolveWork {walker:Walker&,workspace:Workspace&,producer:const Module&,scheme:blot_check_types::Scheme,mapping:Principal&,depth:i64}
fn solveInstantiated(self:Walker&,workspace:Workspace&,producer:const Module&,scheme:blot_check_types::Scheme,mapping:Principal&,depth:i64)->Error {var work=SolveWork{walker:self,workspace:workspace,producer:producer,scheme:scheme,mapping:mapping,depth:depth, ..};let error=blot_check_scheme_equations::withSolver<SolveWork,solveInstanceScope>(self.module,self.scopes,self.scopes.remaining,work);if error==Error.out_of_memory {workspace.oom=true;}if error!=Error.none {return Error.invalid_artifact;}return Error.none;}
