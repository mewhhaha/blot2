struct StaticKey {unit:u32,binding:u32,value:u32}
fn hash(key:StaticKey)->u64 {return ::hash_combine(::hash_combine(::hash(key.unit),::hash(key.binding)),::hash(key.value));}
fn staticKey(read:StaticRead)->StaticKey {return StaticKey{read.target.unit,read.target.binding,read.value,..};}
struct Stats {graph_imports:blot_reuse_artifact_import::OwnerCensus=blot_reuse_artifact_import::OwnerCensus{..},static_graph_scratch:blot_reuse_source_value_template::ScratchStats=blot_reuse_source_value_template::ScratchStats{..},static_graph_scratch_bytes:i64=0,lookup_positions:i64=0,request_checks:i64=0,request_hits:i64=0,candidates:i64=0,reused_named:i64=0,reused_closures:i64=0,fresh_named:i64=0,fresh_closures:i64=0,refinement_regions:i64=0,declined:i64=0,reused_scalar_constants:i64=0,reused_aggregate_constants:i64=0}
struct StaticMap {table:blot_support_pooled_map::Map<StaticKey,u32> =blot_support_pooled_map::Map<StaticKey,u32>{..}}
