// The bootstrap prelude is ordinary Blot source. @u32.* and @f32.* are primitives.
// Arithmetic operators use ordinary functions with compile-time associated dispatch.
// Boolean and/or are reserved short-circuit operators.
infixl 5 (|>) = pipe
infix 30 (==) = eq
infix 30 (!=) = ne
infix 30 (<) = lt
infix 30 (<=) = le
infix 30 (>) = gt
infix 30 (>=) = ge
infixl 40 (|) = bit_or
infixl 45 (^) = bit_xor
infixl 50 (&) = bit_and
infixl 55 (<<) = shl
infixl 55 (>>) = shr
infixl 60 (+) = add
infixl 60 (-) = sub
infixl 70 (*) = mul
infixl 70 (/) = div
infixl 70 (%) = rem

func add left -> right => return @type.call "add" left right
func sub left -> right => return @type.call "sub" left right
func mul left -> right => return @type.call "mul" left right
func div left -> right => return @type.call "div" left right
func rem left -> right => return @type.call "rem" left right
func bit_and left -> right => return @type.call "bit_and" left right
func bit_or left -> right => return @type.call "bit_or" left right
func bit_xor left -> right => return @type.call "bit_xor" left right
func shl value -> count => return @type.call "shl" value count
func shr value -> count => return @type.call "shr" value count
func bit_not value => return value.bit_not
func eq left -> right => return @type.call "eq" left right
func ne left -> right => return @type.call "ne" left right
func lt left -> right => return @type.call "lt" left right
func le left -> right => return @type.call "le" left right
func gt left -> right => return @type.call "gt" left right
func ge left -> right => return @type.call "ge" left right

type Maybe a is data = $Some a | $Nothing
type Result [value, error] is data = $Ok value | $Err error
type Iteration [state, result] is data = $Continue state | $Done result
type Type witness is data = $Type witness
// Text stores Unicode scalar values; std/text validates external scalar arrays.
type Text = Array U32

// The expected result selects its type's ordinary `from` member.
func from value => return @type.result "from" value

// A resolver sequences through the selected type's ordinary pure/bind members.
func monad constructor => return @do.monad constructor
func F32.from value => return value.to_f32
func U32.from value => return value.to_u32
func F32.to_f32 (value: F32) => return value
func U32.to_u32 (value: U32) => return value

func identity value => return value
func apply function -> value => return function value
func pipe value -> function => return function value
func always value -> ignored => return value
func compose outer -> inner -> value => return outer (inner value)
func flip combine -> right -> left => return combine left right
func on combine -> project -> left -> right => return
  combine (project left) (project right)

func Bool.not value => return if value then false else true
func Bool.eq left -> right => return if left then right else Bool.not right
func Bool.ne left -> right => return Bool.not (Bool.eq left right)

func Type.eq left -> right => return case left, right of
  $Type a, $Type b => @type.same a b
func Type.ne left -> right => return Bool.not (Type.eq left right)

const U32.add = @u32.add
const U32.sub = @u32.sub
const U32.mul = @u32.mul
// Division/remainder require a nonzero divisor. Shifts use the low five bits.
const U32.div = @u32.div
const U32.rem = @u32.rem
const U32.bit_and = @u32.bit_and
const U32.bit_or = @u32.bit_or
const U32.bit_xor = @u32.bit_xor
func U32.bit_not value => return @u32.bit_xor value 0xFFFFFFFF
const U32.shl = @u32.shl
const U32.shr = @u32.shr
func U32.abs value => return value
const U32.eq = @u32.eq
const U32.lt = @u32.lt
func U32.ne left -> right => return Bool.not (U32.eq left right)
func U32.le left -> right => return Bool.not (U32.lt right left)
func U32.gt left -> right => return U32.lt right left
func U32.ge left -> right => return Bool.not (U32.lt left right)
const U32.to_f32 = @u32.to_f32

const F32.add = @f32.add
const F32.sub = @f32.sub
const F32.mul = @f32.mul
const F32.div = @f32.div
const F32.eq = @f32.eq
const F32.ne = @f32.ne
const F32.lt = @f32.lt
const F32.le = @f32.le
const F32.gt = @f32.gt
const F32.ge = @f32.ge
const F32.neg = @f32.neg
const F32.abs = @f32.abs
const F32.sqrt = @f32.sqrt
const F32.floor = @f32.floor
const F32.ceil = @f32.ceil
const F32.trunc = @f32.trunc
// Truncates toward zero and saturates; NaN/negative values become zero.
const F32.to_u32 = @f32.to_u32
func F32.min left -> right => return if F32.lt left right then left else right
func F32.max left -> right => return if F32.gt left right then left else right
func F32.clamp low -> high -> value => return
  F32.min high (F32.max low value)
func F32.lerp left -> right -> weight => return
  F32.add left (F32.mul (F32.sub right left) weight)
func F32.square value => return F32.mul value value
func F32.length3 x -> y -> z => return
  F32.sqrt (F32.add (F32.add (F32.square x) (F32.square y)) (F32.square z))
func F32.is_finite value => return F32.le (F32.abs value) 3.402823466e38

// A positive finite period wraps finite values into [0, period).
func F32.wrap period -> value => return do:
  let wrapped = F32.sub value (F32.mul period (F32.floor (F32.div value period)))
  if F32.ge wrapped period:
    break 0.0
  if F32.lt wrapped 0.0:
    break F32.add wrapped period
  break wrapped

func F32.lerp_angle left -> right -> weight => return do:
  let difference = F32.sub (F32.wrap 6.283185307 (F32.add (F32.sub right left) 3.141592654)) 3.141592654
  break F32.add left (F32.mul difference weight)

// Split 2*pi keeps range reduction accurate for |radians| <= 8192.
// Outside that explicit range, trig returns NaN instead of inaccurate geometry.
func f32_reduced_radians value => return do:
  if F32.gt (F32.abs value) 8192.0:
    break F32.div 0.0 0.0
  let turns = F32.floor (F32.add (F32.mul value 0.15915494309189535) 0.5)
  break F32.sub (F32.sub value (F32.mul turns 6.28125)) (F32.mul turns 0.001935307179586477)

// Fold to [-pi/2, pi/2], then evaluate the degree-11 Taylor polynomial.
func f32_sin_reduced angle => return do:
  let x = if F32.gt angle 1.570796327 then F32.sub 3.141592654 angle
    else if F32.lt angle (-1.570796327) then F32.sub (-3.141592654) angle
    else angle
  let square = F32.square x
  let term_9 = F32.add 2.755731922398589e-6 (F32.mul square (-2.505210838544172e-8))
  let term_7 = F32.add (-1.984126984126984e-4) (F32.mul square term_9)
  let term_5 = F32.add 8.333333333333333e-3 (F32.mul square term_7)
  let term_3 = F32.add (-1.666666666666667e-1) (F32.mul square term_5)
  break F32.mul x (F32.add 1.0 (F32.mul square term_3))

func f32_cos_reduced value => return do:
  let angle = F32.abs value
  let outside = F32.gt angle 1.570796327
  let x = if outside then F32.sub 3.141592654 angle else angle
  let square = F32.square x
  let term_10 = F32.add (-2.755731922398589e-7) (F32.mul square 2.08767569878681e-9)
  let term_8 = F32.add 2.48015873015873e-5 (F32.mul square term_10)
  let term_6 = F32.add (-1.388888888888889e-3) (F32.mul square term_8)
  let term_4 = F32.add 4.166666666666667e-2 (F32.mul square term_6)
  let term_2 = F32.add (-0.5) (F32.mul square term_4)
  let result = F32.add 1.0 (F32.mul square term_2)
  break if outside then F32.neg result else result

func F32.sin value => return f32_sin_reduced (f32_reduced_radians value)
func F32.cos value => return f32_cos_reduced (f32_reduced_radians value)
func F32.sin_cos value => return do:
  let angle = f32_reduced_radians value
  break (f32_sin_reduced angle, f32_cos_reduced angle)

// Like division, tan is unbounded near odd multiples of pi/2.
func F32.tan value => return do:
  let angle = f32_reduced_radians value
  break F32.div (f32_sin_reduced angle) (f32_cos_reduced angle)

const pi = 3.141592653589793
const tau = 6.283185307179586
func abs value => return value.abs
func min left -> right => return if left < right then left else right
func max left -> right => return if left > right then left else right
func clamp low -> high -> value => return min high (max low value)
func lerp left -> right => return @type.call "lerp" left right
func square value => return value * value
const sqrt = F32.sqrt
const floor = F32.floor
const ceil = F32.ceil
const trunc = F32.trunc
const sin = F32.sin
const cos = F32.cos
const tan = F32.tan
const sin_cos = F32.sin_cos
const wrap = F32.wrap
const lerp_angle = F32.lerp_angle
const is_finite = F32.is_finite
const saturate = clamp 0.0 1.0
func smoothstep low -> high -> value => return do:
  let t = saturate ((value - low) / (high - low))
  break t * t * (3.0 - 2.0 * t)

func Maybe.pure value => return $Some value
func Maybe.map transform -> candidate => return case candidate of
  $Some value => $Some (transform value)
  $Nothing => $Nothing
func Maybe.bind candidate -> next => return case candidate of
  $Some value => next value
  $Nothing => $Nothing
// Finish each callback before advancing, so iteration uses constant stack.
func Maybe.iterate initial -> step => return do:
  let state = initial
  for ever:
    use candidate <- step state
    if let $Some ($Done result) = candidate:
      break $Some result
    let $Some ($Continue next) = candidate else:
      break $Nothing
    state := next
func Maybe.unwrap_or fallback -> candidate => return case candidate of
  $Some value => value
  $Nothing => fallback
func Maybe.is_some candidate => return case candidate of
  $Some _ => true
  $Nothing => false
func Maybe.filter predicate -> candidate => return case candidate of
  $Some value => if predicate value then candidate else $Nothing
  $Nothing => $Nothing
func Maybe.flatten candidate => return case candidate of
  $Some inner => inner
  $Nothing => $Nothing
func Maybe.unwrap_or_else fallback -> candidate => return case candidate of
  $Some value => value
  $Nothing => fallback ()
func Maybe.to_result error -> candidate => return case candidate of
  $Some value => $Ok value
  $Nothing => $Err error

func Result.pure value => return $Ok value
func Result.map transform -> candidate => return case candidate of
  $Ok value => $Ok (transform value)
  $Err error => $Err error
func Result.map_error transform -> candidate => return case candidate of
  $Ok value => $Ok value
  $Err error => $Err (transform error)
func Result.bind candidate -> next => return case candidate of
  $Ok value => next value
  $Err error => $Err error
func Result.iterate initial -> step => return do:
  let state = initial
  for ever:
    use candidate <- step state
    if let $Ok ($Continue next) = candidate:
      state := next
    else:
      if let $Ok ($Done result) = candidate:
        break $Ok result
      if let $Err error = candidate:
        break $Err error
func Result.unwrap_or fallback -> candidate => return case candidate of
  $Ok value => value
  $Err _ => fallback
func Result.unwrap_or_else fallback -> candidate => return case candidate of
  $Ok value => value
  $Err _ => fallback ()
func Result.to_maybe candidate => return case candidate of
  $Ok value => $Some value
  $Err _ => $Nothing

func Array.length (values: Array a): U32 => return @array.length values
func GrowArray.length (values: GrowArray a): U32 => return @storage.length values
func ResizeArray.length (values: ResizeArray a): U32 => return @storage.length values
func View.length (values: View a): U32 => return @storage.length values
func Array.at (values: Array a) -> (index: U32) => return @array.get values index
func GrowArray.at (values: GrowArray a) -> (index: U32) => return @storage.read values index
func ResizeArray.at (values: ResizeArray a) -> (index: U32) => return @storage.read values index
func View.at (values: View a) -> (index: U32) => return @storage.read values index
func Array.from_list (values: List a): Array a => return @array.from_list values
func List.from_array (values: Array a): List a => return @list.from_array values
func List.length (values: List a): U32 => return @list.length values
func List.is_empty (values: List a): Bool => return List.length values == 0
func Array.is_empty (values: Array a): Bool => return Array.length values == 0
func Array.get (values: Array a) -> (index: U32): Maybe a => return do:
  if index < Array.length values:
    break $Some (@array.get values index)
  break $Nothing
func Array.set (values: Array a) -> (index: U32) -> (value: a): Maybe (Array a) => return do:
  if index < Array.length values:
    break $Some (@array.set values index value)
  break $Nothing

// Iteration is ordinary associated dispatch. A step returns an item and the
// next immutable cursor; retaining either cursor preserves its own position.
func List.iter values => return @list.cursor values
func Array.iter values => return @array.cursor values
func Cursor.iter (cursor: Cursor collection) => return cursor
func Cursor.next cursor => return
  if @cursor.has cursor
  then $Some (@cursor.value cursor, @cursor.advance cursor)
  else $Nothing

// Pool iteration borrows a captured range. Growth preserves its addresses and
// initial length; shortening the owner while traversal is live is rejected.
type PoolCursor a is data = $PoolCursor { values: &[a], index: U32 }
func GrowArray.iter (values: GrowArray a) => return $PoolCursor {values: &values[0..values.length], index: 0}
func ResizeArray.iter (values: ResizeArray a) => return $PoolCursor {values: &values[0..values.length], index: 0}
func View.iter (values: &[a]) => return $PoolCursor {values, index: 0}
func PoolCursor.next (cursor: PoolCursor a) => return
  if cursor.index < cursor.values.length
  then $Some (cursor.values[cursor.index], $PoolCursor {values: cursor.values, index: cursor.index + 1})
  else $Nothing

// Mutation dispatch keeps the owner mode explicit in each selected signature.
func GrowArray.push (values: GrowArray a) -> (value: a) => return @storage.push values value
func ResizeArray.push (values: ResizeArray a) -> (value: a) => return @storage.push values value
func ResizeArray.truncate (values: ResizeArray a) -> (count: U32) => return @storage.truncate values count
func Array.write (values: Array a) -> (index: U32) -> (value: a) => return @storage.write (&values[index]) value
func GrowArray.write (values: GrowArray a) -> (index: U32) -> (value: a) => return @storage.write (&values[index]) value
func ResizeArray.write (values: ResizeArray a) -> (index: U32) -> (value: a) => return @storage.write (&values[index]) value
func Array.view (values: Array a) -> (start: U32) -> (end: U32) => return @storage.view values start end
func GrowArray.view (values: GrowArray a) -> (start: U32) -> (end: U32) => return @storage.view values start end
func ResizeArray.view (values: ResizeArray a) -> (start: U32) -> (end: U32) => return @storage.view values start end
func View.view (values: &[a]) -> (start: U32) -> (end: U32) => return @storage.view values start end
