type Error=blot_error::Error;
type Module=blot_check_core::Module;
type ModuleRef=blot_check_frozen_core_validation::ModuleRef;
type Id=u32;
type List=blot_check_types::List;
type Tag=blot_check_types::Tag;
type CoreTag=blot_check_core::Tag;
type Principal=blot_check_package_contracts::Principal;
type Views=blot_check_package_contracts::Context;
type Workspace=blot_check_scheme_equations::Workspace;
fn require(value:bool)->Error {if !value {return Error.invalid_artifact;}return Error.none;}
fn contains(values:const u32[:],wanted:u32)->bool {for value in values {if value==wanted {return true;}}return false;}
fn sameOwner(first:const Module&,second:const Module&)->bool {return first.owner_id!=0 && first.owner_id==second.owner_id;}
fn authorityFree(module:const Module&,id:u32)->bool,Error {var remaining:i64=4096;return authorityDepth(module,id,0,remaining);}
recursive fn authorityRow(module:const Module&,row:u32,depth:i64,remaining:i64&)->bool,Error {for label in module.types.rowLabels(row) {let operation=module.types.operations[label];if operation.instance.decl!=0 {return false,Error.none;}for argument in module.types.list(operation.arguments) {let free,error=authorityDepth(module,argument,depth+1,remaining);if error!=Error.none || !free {return false,error;}}}return true,Error.none;}
recursive fn authorityDepth(module:const Module&,id:u32,depth:i64,remaining:i64&)->bool,Error {if depth>=128 || remaining==0 {return false,Error.invalid_artifact;}remaining-=1;let node=module.types.node(id);match node.tag {Tag.scoped,Tag.instance_version,Tag.bound,Tag.rigid,Tag.forall,Tag.existential=>{return false,Error.none;},Tag.usage=>{if node.b==blot_check_types::usageKindCode(blot_check_types::UsageKind.borrow) || node.b==blot_check_types::usageKindCode(blot_check_types::UsageKind.borrow_mut) {return false,Error.none;}return authorityDepth(module,node.a,depth+1,remaining);},Tag.function=>{let free,error=authorityDepth(module,node.a,depth+1,remaining);if error!=Error.none || !free {return false,error;}let free,error=authorityDepth(module,node.b,depth+1,remaining);if error!=Error.none || !free {return false,error;}return authorityRow(module,node.c,depth+1,remaining);},Tag.provider=>{let free,error=authorityDepth(module,node.a,depth+1,remaining);if error!=Error.none || !free {return false,error;}return authorityRow(module,node.c,depth+1,remaining);},Tag.state_provider=>{for child in [node.a,node.b,node.c] {let free,error=authorityDepth(module,child,depth+1,remaining);if error!=Error.none || !free {return false,error;}}},Tag.nominal,Tag.projection,Tag.instance_selection=>{for child in module.types.nominalArguments(node) {let free,error=authorityDepth(module,child,depth+1,remaining);if error!=Error.none || !free {return false,error;}}},Tag.record=>{for index in 0..node.b {let free,error=authorityDepth(module,module.types.recordField(node,index).ty,depth+1,remaining);if error!=Error.none || !free {return false,error;}}},Tag.product=>{for child in module.types.list(List{start:node.a,len:node.b, ..}) {let free,error=authorityDepth(module,child,depth+1,remaining);if error!=Error.none || !free {return false,error;}}},Tag.array,Tag.list,Tag.cursor,Tag.resolver=>{return authorityDepth(module,node.a,depth+1,remaining);},_=>{},}return true,Error.none;}
fn equal(module:const Module&,left:u32,right:u32,depth:i64,remaining:i64&)->bool,Error {return equalWithRows(module,left,right,List{..},depth,remaining);}
fn sameRow(module:const Module&,left:u32,right:u32,closed:List)->bool {return sameOwnedRow(module,left,right,closed,closed);}
fn sameOwnedRow(module:const Module&,left:u32,right:u32,left_rows:List,right_rows:List)->bool {if left==right {return true;}let first=module.types.row(left);let second=module.types.row(right);if module.types.rowLabels(left)!=module.types.rowLabels(right) {return false;}var a=first.tail;var b=second.tail;match a {blot_check_effects::Tail.variable value=>{if contains(module.types.list(left_rows),value.value) {a=blot_check_effects::Tail.closed;}},_=>{},}match b {blot_check_effects::Tail.variable value=>{if contains(module.types.list(right_rows),value.value) {b=blot_check_effects::Tail.closed;}},_=>{},}return a==b;}
fn equalWithRows(module:const Module&,left:u32,right:u32,closed:List,depth:i64,remaining:i64&)->bool,Error {return equalOwnedRows(module,left,right,closed,closed,depth,remaining);}
recursive fn equalOwnedRows(module:const Module&,left:u32,right:u32,left_rows:List,right_rows:List,depth:i64,remaining:i64&)->bool,Error {if depth>=128 || remaining==0 {return false,Error.invalid_artifact;}remaining-=1;if left==right {return true,Error.none;}let a=module.types.node(left);let b=module.types.node(right);if a.tag!=b.tag {return false,Error.none;}match a.tag {Tag.variable=>{return false,Error.none;},Tag.product=>{if a.b!=b.b {return false,Error.none;}let first=module.types.list(List{start:a.a,len:a.b, ..});let second=module.types.list(List{start:b.a,len:b.b, ..});for index in 0..first.len {let same,error=equalOwnedRows(module,first[index],second[index],left_rows,right_rows,depth+1,remaining);if error!=Error.none || !same {return false,error;}}return true,Error.none;},Tag.record=>{if a.b!=b.b {return false,Error.none;}for index in 0..a.b {let x=module.types.recordField(a,index);let y=module.types.recordField(b,index);if x.name!=y.name {return false,Error.none;}let same,error=equalOwnedRows(module,x.ty,y.ty,left_rows,right_rows,depth+1,remaining);if error!=Error.none || !same {return false,error;}}return true,Error.none;},Tag.nominal=>{if a.a!=b.a || a.b!=b.b {return false,Error.none;}let first=module.types.nominalArguments(a);let second=module.types.nominalArguments(b);if first.len!=second.len {return false,Error.none;}for index in 0..first.len {let same,error=equalOwnedRows(module,first[index],second[index],left_rows,right_rows,depth+1,remaining);if error!=Error.none || !same {return false,error;}}return true,Error.none;},Tag.function=>{let same,error=equalOwnedRows(module,a.a,b.a,left_rows,right_rows,depth+1,remaining);if error!=Error.none || !same {return false,error;}let same,error=equalOwnedRows(module,a.b,b.b,left_rows,right_rows,depth+1,remaining);if error!=Error.none || !same {return false,error;}return sameOwnedRow(module,a.c,b.c,left_rows,right_rows),Error.none;},Tag.existential=>{var proof=Principal{left:module.types,right:module.types,remaining:remaining, ..};if proof.validate(left,right)!=Error.none {return false,Error.none;}return true,Error.none;},Tag.state_provider=>{for pair in [[a.a,b.a],[a.b,b.b],[a.c,b.c]] {let same,error=equalOwnedRows(module,pair[0],pair[1],left_rows,right_rows,depth+1,remaining);if error!=Error.none || !same {return false,error;}}return true,Error.none;},Tag.usage,Tag.array,Tag.list,Tag.cursor,Tag.provider,Tag.resolver=>{if a.b!=b.b || a.c!=b.c {return false,Error.none;}return equalOwnedRows(module,a.a,b.a,left_rows,right_rows,depth+1,remaining);},_=>{return a.a==b.a && a.b==b.b && a.c==b.c,Error.none;},}}
fn result(module:const Module&,expected:u32,actual:u32,remaining:i64&)->Error {if actual==blot_check_types::never {return Error.none;}let same,error=equal(module,expected,actual,0,remaining);if error!=Error.none {return error;}return require(same);}
fn callable(module:const Module&,raw:u32,remaining:i64&)->blot_check_types::Node,Error {var current=raw;for iteration in 0..128 {if remaining==0 {return default<blot_check_types::Node>(),Error.invalid_artifact;}remaining-=1;let node=module.types.node(current);if node.tag!=Tag.usage && node.tag!=Tag.forall {if node.tag!=Tag.function {return default<blot_check_types::Node>(),Error.invalid_artifact;}return node,Error.none;}current=node.a;}return default<blot_check_types::Node>(),Error.invalid_artifact;}
fn nominalOwner(module:const Module&,target:blot_check_types::Node,remaining:i64&)->u32,Error {if target.tag!=Tag.nominal {return 0,Error.invalid_artifact;}var owner=blot_support::none<u32>();for family,index in module.nominals {if remaining==0 {return 0,Error.invalid_artifact;}remaining-=1;if family.identity.unit!=target.a || family.identity.decl!=target.b {continue;}if owner.present || family.constructors.len==0 {return 0,Error.invalid_artifact;}if (family.private || family.is_opaque) && family.identity.unit!=0 && family.identity.unit!=module.unit {return 0,Error.invalid_artifact;}owner=blot_support::some(index as u32);}if !owner.present {return 0,Error.invalid_artifact;}return owner.value,Error.none;}
struct DecisionOwner {callback:u32,ty:u32,breaks:bool&}
struct Locals {bindings:const u32[:]=[],parameters:const blot_check_core::Parameter[:]=[],parent:const Locals?=null}
struct LoopOwner {node:u32,parent:LoopOwner?=null,exits:bool=false}
struct ScopeOwner {identity:blot_check_types::NominalIdentity,parent:const ScopeOwner?=null,task_view:u32=0}
struct LoanOwner {region:u32,parent:const LoanOwner?=null}
struct CallOwner {module:const Module&,binding:u32,parent:const CallOwner?=null}
struct RowOwner {closed:List,generic:List,parent:const RowOwner?=null}
struct Named {workspace:Workspace?=null,m:const Module&,units:const ModuleRef[:]=[],remaining:i64&,variables:const u32[:]=[],current_scheme:blot_support::Option<blot_check_types::Scheme>=blot_support::none<blot_check_types::Scheme>(),row_variables:List=List{..},data_rows:List=List{..},row_owners:const RowOwner?=null,parameters:const blot_check_core::Parameter[:]=[],locals:const Locals?=null,loop_owner:LoopOwner?=null,scope_owner:const ScopeOwner?=null,loan_owner:const LoanOwner?=null,active_calls:const CallOwner?=null,ambient:blot_support::Option<blot_check_effects::Row>=blot_support::none<blot_check_effects::Row>(),decision_owner:const DecisionOwner?=null,resolver_callback:u32=0}
fn step(self:Named&,depth:i64)->Error {if depth>=128 || self.remaining==0 {return Error.invalid_artifact;}self.remaining-=1;return Error.none;}
fn declaredBody(self:Named&,body:const blot_check_core::Body&,parameters:const blot_check_core::Parameter[:],depth:i64)->Error {let active .= self.active_calls;while active {let error=self.step(depth);if error!=Error.none {return error;}if sameOwner(active.module,self.m) && active.binding==body.binding {return Error.none;}active .= active.parent;}let prior_parameters=self.parameters;let prior_scheme=self.current_scheme;let prior_ambient=self.ambient;let prior_decision .= self.decision_owner;let prior_callback=self.resolver_callback;let parent .= self.active_calls;self.parameters=parameters;self.current_scheme=blot_support::some(body.scheme);self.ambient=blot_support::none<blot_check_effects::Row>();let error=declaredBodyValue(self,body,parameters,depth);self.parameters=prior_parameters;self.current_scheme=prior_scheme;self.ambient=prior_ambient;self.decision_owner .= prior_decision;self.resolver_callback=prior_callback;self.active_calls .= parent;return error;}
fn declaredBodyValue(self:Named&,body:const blot_check_core::Body&,parameters:const blot_check_core::Parameter[:],depth:i64)->Error {var signature=self.m.bindings[body.binding].ty;for parameter in parameters {let arrow,error=callable(self.m,signature,self.remaining);if error!=Error.none {return error;}self.ambient=blot_support::some(self.m.types.row(arrow.c));signature=arrow.b;}self.decision_owner .= null;self.resolver_callback=0;let owner=CallOwner{module:self.m,binding:body.binding,parent:self.active_calls, ..};self.active_calls .= owner;let error=self.node(body.root,parameters,body.closed_rows,depth+1);self.active_calls .= owner.parent;return error;}
fn knownInstance(self:Named&,identity:blot_check_types::NominalIdentity)->bool,Error {if identity.decl==0 {return true,Error.none;}let owner .= self.scope_owner;while owner {let error=self.step(0);if error!=Error.none {return false,error;}if identity==owner.identity {return true,Error.none;}owner .= owner.parent;}return false,Error.none;}
fn token(self:Named&,id:u32,depth:i64)->Error {let error=self.step(depth);if error!=Error.none {return error;}var node=self.m.types.node(id);if node.tag==Tag.scoped {let known,error=self.knownInstance(blot_check_types::NominalIdentity{unit:node.b,decl:node.c, ..});if error!=Error.none {return error;}if !known {return Error.invalid_artifact;}let family=self.m.types.node(node.a);if family.tag==Tag.nominal && family.a==blot_check_task_types::view.unit && family.b==blot_check_task_types::view.decl {let owner .= self.scope_owner;while owner {let error=self.step(depth);if error!=Error.none {return error;}if owner.task_view==id {let arguments=self.m.types.nominalArguments(family);if arguments.len!=2 || self.m.types.node(arguments[1]).tag!=Tag.instance_version {return Error.invalid_artifact;}return self.data(arguments[0],depth+1);}owner .= owner.parent;}return Error.invalid_artifact;}node=self.m.types.node(node.a);}if node.tag!=Tag.nominal {return Error.invalid_artifact;}for argument in self.m.types.nominalArguments(node) {let error=self.data(argument,depth+1);if error!=Error.none {return error;}}return Error.none;}
fn dataRow(self:Named&,id:u32,depth:i64)->Error {for label in self.m.types.rowLabels(id) {let error=self.step(depth);if error!=Error.none {return error;}let operation=self.m.types.operations[label];let known,error=self.knownInstance(operation.instance);if error!=Error.none {return error;}if !known {return Error.invalid_artifact;}for argument in self.m.types.list(operation.arguments) {let error=self.data(argument,depth+1);if error!=Error.none {return error;}}}return Error.none;}
fn ownedTail(self:Named&,id:u32,closed_rows:List)->bool {let tail=self.m.types.row(id).tail;match tail {blot_check_effects::Tail.closed=>{return true;},blot_check_effects::Tail.variable value=>{if contains(self.m.types.list(closed_rows),value.value) || contains(self.m.types.list(self.row_variables),value.value) {return true;}let owner .= self.row_owners;while owner {if contains(self.m.types.list(owner.closed),value.value) || contains(self.m.types.list(owner.generic),value.value) {return true;}owner .= owner.parent;}return false;},_=>{return false;},}}
fn initializeViews(self:Named&,closed_rows:List,context:Views&,depth:i64)->Error {let error=context.initialize();if error!=Error.none {return error;}for row,index in self.m.types.effects.rows {let error=self.step(depth);if error!=Error.none {return error;}match row.tail {blot_check_effects::Tail.variable value=>{var closed=contains(self.m.types.list(closed_rows),value.value);let owner .= self.row_owners;while owner {let error=self.step(depth);if error!=Error.none {return error;}if contains(self.m.types.list(owner.closed),value.value) {closed=true;}owner .= owner.parent;}if !closed {continue;}let error=context.closed_rows.set(index);if error!=Error.none {return error;}if row.labels.len==0 {let error=context.pure_rows.set(index);if error!=Error.none {return error;}}},_=>{},}}return Error.none;}
fn binders(self:Named&,body:const blot_check_core::Body&)->const u32[:],Error {if body.runtime || body.scheme.generative.len!=0 {return [],Error.invalid_artifact;}let rows=self.m.types.list(body.scheme.row_variables);if rows.len>128 {return [],Error.invalid_artifact;}for variable,index in rows {if variable>=self.m.types.effects.variable_count || contains(rows[..index],variable) {return [],Error.invalid_artifact;}}let variables=self.m.types.list(body.scheme.variables);if variables.len>32 {return [],Error.invalid_artifact;}for variable,index in variables {if self.m.types.node(variable).tag!=Tag.variable || contains(variables[..index],variable) {return [],Error.invalid_artifact;}}return variables,Error.none;}
fn local(self:Named&,binding:u32)->bool,Error {let scope .= self.locals;while scope {for parameter in scope.parameters {let error=self.step(0);if error!=Error.none {return false,error;}if parameter.binding==binding {return true,Error.none;}}for owned in scope.bindings {let error=self.step(0);if error!=Error.none {return false,error;}if owned==binding {return true,Error.none;}}scope .= scope.parent;}return false,Error.none;}
fn constructorVariables(self:Named&,owner:u32,constructor:blot_check_core::Constructor)->const u32[:],Error {if constructor.nominal!=owner || constructor.scheme.obligations.len!=0 || constructor.scheme.row_variables.len!=0 || constructor.scheme.generative.len!=0 {return [],Error.invalid_artifact;}let variables=self.m.types.list(constructor.scheme.variables);if variables.len>32 {return [],Error.invalid_artifact;}for variable,position in variables {if self.m.types.node(variable).tag!=Tag.variable || contains(variables[..position],variable) || !contains(self.m.types.list(self.m.nominals[owner].variables),variable) {return [],Error.invalid_artifact;}}return variables,Error.none;}

recursive fn data(self:Named&,id:u32,depth:i64)->Error {let error=self.step(depth);if error!=Error.none {return error;}let node=self.m.types.node(id);match node.tag {Tag.unit,Tag.boolean,Tag.unsigned32,Tag.floating32,Tag.never=>{return Error.none;},Tag.variable=>{return require(contains(self.variables,id));},Tag.existential=>{var context=Views{types:self.m.types,remaining:self.remaining, ..};let error=context.initialize();if error!=Error.none {return error;}return context.visit(id);},Tag.array,Tag.list,Tag.cursor=>{return self.data(node.a,depth+1);},
 Tag.usage=>{let kind,valid=blot_check_types::usageKindFromCode(node.b);if !valid {return Error.invalid_artifact;}if kind==blot_check_types::UsageKind.borrow || kind==blot_check_types::UsageKind.borrow_mut {let owner .= self.loan_owner;var found=false;while owner {let error=self.step(depth);if error!=Error.none {return error;}if owner.region==node.c {found=true;}owner .= owner.parent;}if node.c==0 || !found {return Error.invalid_artifact;}}else if kind==blot_check_types::UsageKind.concurrent {if node.c!=0 || !blot_check_task_types::concurrentHost(self.m.types,node.a) {return Error.invalid_artifact;}}else if node.c!=0 || (kind!=blot_check_types::UsageKind.unique && kind!=blot_check_types::UsageKind.shared && kind!=blot_check_types::UsageKind.once && kind!=blot_check_types::UsageKind.many && kind!=blot_check_types::UsageKind.cleanup) {return Error.invalid_artifact;}return self.data(node.a,depth+1);},
 Tag.function=>{if !self.ownedTail(node.c,self.data_rows) {return Error.invalid_artifact;}let error=self.dataRow(node.c,depth+1);if error!=Error.none {return error;}let error=self.data(node.a,depth+1);if error!=Error.none {return error;}return self.data(node.b,depth+1);},Tag.product=>{for child in self.m.types.list(List{start:node.a,len:node.b, ..}) {let error=self.data(child,depth+1);if error!=Error.none {return error;}}return Error.none;},Tag.record=>{for index in 0..node.b {let error=self.data(self.m.types.recordField(node,index).ty,depth+1);if error!=Error.none {return error;}}return Error.none;},
 Tag.type_constructor=>{if node.c!=0 {return Error.invalid_artifact;}var found=false;for family in self.m.nominals {if family.identity.unit==node.a && family.identity.decl==node.b {found=true;}}return require(found);},Tag.resolver=>{if node.b!=0 || node.c!=0 || self.m.types.node(node.a).tag!=Tag.type_constructor {return Error.invalid_artifact;}return self.data(node.a,depth+1);},Tag.scoped=>{return self.token(id,depth+1);},Tag.provider=>{let error=self.token(node.a,depth+1);if error!=Error.none {return error;}return self.dataRow(node.c,depth+1);},Tag.state_provider=>{let error=self.token(node.a,depth+1);if error!=Error.none {return error;}let error=self.token(node.b,depth+1);if error!=Error.none {return error;}return self.data(node.c,depth+1);},Tag.nominal=>{return nominalData(self,id,node,depth);},_=>{return Error.invalid_artifact;},}}
fn nominalData(self:Named&,id:u32,node:blot_check_types::Node,depth:i64)->Error {if node.a==0xffffffff && (node.b==5 || node.b==6) {let arguments=self.m.types.nominalArguments(node);var count:i64=3;if node.b==5 {count=1;}if arguments.len!=count {return Error.invalid_artifact;}if node.b==5 {let action,error=callable(self.m,arguments[0],self.remaining);if error!=Error.none {return error;}if action.a!=blot_check_types::unit {return Error.invalid_artifact;}}for argument in arguments {let error=self.data(argument,depth+1);if error!=Error.none {return error;}}return Error.none;}if node.a==blot_check_task_types::handle.unit && node.b==blot_check_task_types::handle.decl {let arguments=self.m.types.nominalArguments(node);if arguments.len!=2 || !blot_check_task_types::isGroup(self.m.types,arguments[0]) || self.m.types.node(arguments[1]).tag!=Tag.function {return Error.invalid_artifact;}let error=self.token(arguments[0],depth+1);if error!=Error.none {return error;}return self.data(arguments[1],depth+1);}for child in self.m.types.nominalArguments(node) {let error=self.data(child,depth+1);if error!=Error.none {return error;}}let owner,error=nominalOwner(self.m,node,self.remaining);if error!=Error.none {return error;}let family=self.m.nominals[owner];if self.m.types.nominalArguments(node).len!=family.parameters.len {return Error.invalid_artifact;}for index,ordinal in self.m.nominalConstructors(owner) {let error=self.step(depth);if error!=Error.none {return error;}let constructor=self.m.constructors[index];if constructor.tag!=ordinal {return Error.invalid_artifact;}let variables,error=self.constructorVariables(owner,constructor);if error!=Error.none {return error;}var bindings:u32[32]=[0;32];let output,error=self.constructorResult(constructor,depth+1);if error!=Error.none {return error;}let error=self.matchType(output,id,variables,bindings,depth+1);if error!=Error.none {return error;}for binding in bindings[..variables.len] {if binding==0 {return Error.invalid_artifact;}}let calle