// Share only single-definition scalar locals inside one straight-line segment.
namespace blot_backend_wasm_local_compact;
import .runtime_ir;
import .wasm;
import .wasm_control_flow;
import .optimizer_buffers;
import support.error;
import support.option;
type Error=blot_error::Error;
type Module=blot_backend_wasm::Module;
type Function=blot_backend_runtime_ir::Function;
type Op=blot_backend_runtime_ir::Op;
type Output=blot_backend_runtime_ir::DetachedBody;
let absent:i64=0x7fffffffffffffff;
struct Use {segment:i64=absent,last:i64=0,definitions:u8=0,pinned:bool=false}
reusable[] var use_runs:Use[>..]=[];
fn boundary(op:Op)->bool {match op {blot_backend_runtime_ir::OP_block,blot_backend_runtime_ir::OP_loop,blot_backend_runtime_ir::OP_if_,blot_backend_runtime_ir::OP_else_,blot_backend_runtime_ir::OP_end,blot_backend_runtime_ir::OP_br,blot_backend_runtime_ir::OP_br_if,blot_backend_runtime_ir::OP_return_,blot_backend_runtime_ir::OP_unreachable_=>{return true;},_=>{return false;},}}
fn local(op:Op)->bool {return op==blot_backend_runtime_ir::OP_local_get || op==blot_backend_runtime_ir::OP_local_set || op==blot_backend_runtime_ir::OP_local_tee;}
fn run(module:const Module&,source:const Function&)->blot_support::Option<Output>,Error {let locals=module.locals(source);let code=blot_backend_wasm::instructions(module,source);if locals.len<2 || locals.len>0x7fffffffffffffff-source.parameters.len {return blot_support::none<Output>(),blot_error::Error.none;}let total=source.parameters.len+locals.len;if total>0xffffffff || code.len>=0xffffffff {return blot_support::none<Output>(),blot_error::Error.none;}let uses=use_runs.alloc_slice(locals.len);for &use,index in uses {use=Use{pinned:locals[index]!=blot_backend_runtime_ir::VT_i32,..};}let result,error=compact(module,source,uses,total);use_runs.free_slice(uses);return result,error;}
fn compact(module:const Module&,source:const Function&,uses:Use[:],total:i64)->blot_support::Option<Output>,Error {let code=blot_backend_wasm::instructions(module,source);var segment:i64=0;for inst,at in code {if inst.op==blot_backend_runtime_ir::OP_ownership || inst.op==blot_backend_runtime_ir::OP_resource_retire {return blot_support::none<Output>(),blot_error::Error.none;}if local(inst.op) {if inst.operand>=total {return blot_support::none<Output>(),blot_error::Error.none;}if inst.operand>=source.parameters.len {let use .= uses[inst.operand-source.parameters.len];if use.segment==absent {use.segment=segment;}if use.segment!=segment {use.pinned=true;}use.last=at;if inst.op==blot_backend_runtime_ir::OP_local_get {if use.definitions==0 {use.pinned=true;}}else if use.definitions!=255 {use.definitions+=1;}}}if boundary(inst.op) {segment+=1;}}var candidates:i64=0;for &use in uses {if use.definitions!=1 {use.pinned=true;}if !use.pinned {candidates+=1;}}if candidates<2 {return blot_support::none<Output>(),blot_error::Error.none;}var nodes:blot_backend_wasm_control_flow::Node[>..]=[];var predecessors:blot_backend_wasm_control_flow::Predecessor[>..]=[];let graph=blot_backend_wasm_control_flow::init(nodes,predecessors,code);if !graph.valid {return blot_support::none<Output>(),blot_error::Error.none;}var slots=blot_backend_optimizer_buffers::Words{..};var free=blot_backend_optimizer_buffers::Words{..};var locals=blot_backend_optimizer_buffers::Types{..};var result=blot_backend_optimizer_buffers::Code{..};let changed,error=emitCompact(module,source,uses,slots,free,locals,result);free.deinit();slots.deinit();return blot_backend_optimizer_buffers::finishOptional(locals,result,changed,error);}
fn emitCompact(module:const Module&,source:const Function&,uses:const Use[:],slots:blot_backend_optimizer_buffers::Words&,free:blot_backend_optimizer_buffers::Words&,locals:blot_backend_optimizer_buffers::Types&,result:blot_backend_optimizer_buffers::Code&)->bool,Error {let error=slots.resize(uses.len,0xffffffff as u32);if error!=blot_error::Error.none {return false,error;}let original=module.locals(source);for use,index in uses {if !use.pinned {continue;}slots.items[index]=(source.parameters.len+locals.len) as u32;let error=locals.push(original[index]);if error!=blot_error::Error.none {return false,error;}}let code=blot_backend_wasm::instructions(module,source);let error=result.ensure(code.len);if error!=blot_error::Error.none {return false,error;}for inst,at in code {var output=inst;if local(inst.op) && inst.operand>=source.parameters.len {let index=inst.operand-source.parameters.len;let use=uses[index];if slots.items[index]==0xffffffff {if free.len!=0 {slots.items[index]=free.pop();}else {slots.items[index]=(source.parameters.len+locals.len) as u32;let error=locals.push(blot_backend_runtime_ir::VT_i32);if error!=blot_error::Error.none {return false,error;}}}output.operand=slots.items[index];if !use.pinned && use.last==at {let error=free.push(slots.items[index]);if error!=blot_error::Error.none {return false,error;}}}let error=result.push(output);if error!=blot_error::Error.none {return false,error;}}return locals.len<original.len,blot_error::Error.none;}
