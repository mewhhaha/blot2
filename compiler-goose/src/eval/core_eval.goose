fn raggedBlock(self: Session&,owner: i64,id: u32,frame: Frame) -> blot_support::Option<Flow>,Error { let module=self.units[owner]; let body=module.children(id); if body.len<3||module.node(body[0]).tag!=CoreTag.bind { return blot_support::none<Flow>(),Error.none; } let initial=module.node(body[0]).b; if module.node(initial).tag!=CoreTag.array||module.children(initial).len!=0 { return blot_support::none<Flow>(),Error.none; } var facts=RaggedFacts {session:self,owner:owner,frame:frame,module:module}; let diagnostic=self.diagnostic; let prepared,error=prepare(facts,id); if error==Error.declined { self.diagnostic=diagnostic; return blot_support::none<Flow>(),Error.none; } if error!=Error.none||!prepared { return blot_support::none<Flow>(),error; } let plan=blot_backend_ragged_builder::analyze(module,id,facts); if !plan.present { return blot_support::none<Flow>(),Error.none; } var available=self.options.max_children-constantChildCount(self); if available<0 { available=0; } if available>4194303 { available=4194303; } var probe=blot_eval_eval_ragged_count::Counter<RaggedFacts> {adapter:facts,plan:plan.value,remaining:self.ragged_probe_limit,limit:available as u32}; let count,present=probe.run(); self.counters.ragged_probe_visits+=probe.visits as u64; if !present { self.counters.ragged_probe_declines++; return blot_support::none<Flow>(),Error.none; } let children=ragged_children_pool.alloc_slice(count); var region=RaggedRegion {owner:owner,frame:frame,plan:plan.value,children:children}; self.ragged_reserved_children+=count; declineConstant(self); self.ragged_region .= region; let outcome,e=raggedBlockRun(self,owner,id,frame,region,count); self.ragged_region .= null; if region.reserved { self.ragged_reserved_children-=count; } ragged_children_pool.free_slice(children); return outcome,e; }
