fn proveCalleeEdges(self:Engine&,source:u32,binding:u32,parts:const u32[:],old:const u32[:],old_rows:const u32[:],rows:u32[:],clauses:const blot_check_types::Obligation[:],edges:u32[:])->bool,blot_error::Error {for carrier,index in parts[old.len..] {let node=self.types.node(self.types.head(carrier,0));if node.tag!=blot_check_types::Tag.function || node.a!=blot_check_types::unit || node.b!=blot_check_types::unit {return false,blot_error::Error.none;}rows[index]=node.c;}for before,index in clauses {let allowed,err=self.associatedStep(source);if err!=blot_error::Error.none || !allowed {return false,err;}let clause,err=self.substitutePredicate(before,old,parts[..old.len],old_rows,rows);if err!=blot_error::Error.none {return false,err;}clause.source=source;let child,err=self.proveAndSavePredicate(clause,source);if err!=blot_error::Error.none || !child.present {return false,err;}edges[index]=child.value;}let start=self.selected_edges.len as u32;for edge in edges {self.selected_edges.append(edge);}self.proved_predicate_prerequisites=blot_check_types::List{start:start,len:edges.len as u32};self.proved_predicate_target=self.bindings[binding].external.value;if !self.bindings[binding].external.present {self.proved_predicate_target=ExternalTarget{unit:self.unit,binding:binding};}return true,blot_error::Error.none;}
