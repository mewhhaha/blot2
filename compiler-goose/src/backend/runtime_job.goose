// Private copied worker images. Every array here owns its elements; no process
// address, borrowed slice or module range escapes into the packet.
namespace blot_backend_runtime_job;
import .wasm;
import .runtime_ir;
import runtime.list_runtime;
import runtime.cohort_runtime;
import runtime.region_runtime;
import support.error;
import support.option;
type Error = blot_error::Error;
type Module = blot_backend_wasm::Module;
type IR = blot_backend_runtime_ir::Instruction;
struct FunctionImage {
    result: u8,result_role: u8,entry: bool,provider_parameter: u8,callable_layout: u32,signature: u32,parameter_roles: u64,annotations: u32,
    parameters: u8[],locals: u8[],instructions: IR[],
}
struct Image {
    version: u32 = 1,memory_model: blot_backend_wasm::MemoryModel,fixed_memory_bytes: u32,array_transport: blot_support::Option<blot_backend_wasm::ArrayTransport>,arena: blot_support::Option<blot_backend_wasm::Arena>,
    fixture_helpers_present: bool,fixture_helpers: u32[3],lists: blot_support::Option<blot_runtime_list_runtime::Runtime>,cohorts: blot_support::Option<blot_runtime_cohort_runtime::Runtime>,
    has_regions: bool,region_runtime: blot_runtime_region_runtime::Runtime,region_frame_bytes: u32,region_bytes: u32,region_mask: u32,
    host_references: blot_support::Option<blot_backend_wasm::HostReferences>,public_arena: bool,cleanup_data: blot_backend_runtime_ir::Range,defer_cycles: bool,mutable_static: bool,indirect: bool,start: blot_support::Option<u32>,
    types: u8[],names: u8[],signatures: blot_backend_runtime_ir::Signature[],imports: blot_backend_wasm::Import[],globals: blot_backend_wasm::Global[],exports: blot_backend_wasm::Export[],data: u8[],static_fields: u32[],table_functions: u32[],table_origins: blot_backend_wasm::TableOrigin[],semantic_sites: blot_backend_wasm::SemanticSite[],region_members: blot_runtime_region_runtime::Member[],region_scopes: blot_runtime_region_runtime::Scope[],functions: FunctionImage[],
}
fn copyArray<T>(source: const T[:]) -> T[] { var values: T[>..] = []; values.append(source); return copy(values); }
fn captureMembers(module: const Module&) -> blot_runtime_region_runtime::Member[] { if module.regions.present { return copyArray(module.regions.value.plan.members); } return []; }
fn captureScopes(module: const Module&) -> blot_runtime_region_runtime::Scope[] { if module.regions.present { return copyArray(module.regions.value.scopes); } return []; }
// Moved local ranges leave filler (type 0) in module.types that no range names.
// Workers validate every type, so the copy writes filler as i32; indices stay put.
fn captureTypes(module: const Module&) -> u8[] { var values: u8[>..] = []; for ty in module.types { if ty == 0 { values.push(blot_backend_runtime_ir::VT_i32); } else { values.push(ty); } } return copy(values); }
fn capture(module: const Module&) -> Image {
    var functions: FunctionImage[>..] = []; for source in module.functions { functions.push(FunctionImage { result: source.result,result_role: source.result_role,entry: source.entry,provider_parameter: source.provider_parameter,callable_layout: source.callable_layout,signature: source.signature,parameter_roles: source.parameter_roles,annotations: source.annotations,parameters: copyArray(module.parameters(source)),locals: copyArray(module.locals(source)),instructions: copyArray(blot_backend_wasm::instructions(module,source)),..}); }
    var region_runtime = blot_runtime_region_runtime::Runtime {..}; var frame_bytes: u32 = 0; var region_bytes: u32 = 0; var mask: u32 = 0; let members = captureMembers(module); let scopes = captureScopes(module); if module.regions.present { let region = module.regions.value; region_runtime = region.runtime; frame_bytes = region.plan.frame_bytes; region_bytes = region.plan.bytes; mask = region.plan.mask; }
    return Image { memory_model: module.memory_model,fixed_memory_bytes: module.fixed_memory_bytes,array_transport: module.array_transport,arena: module.arena,fixture_helpers_present: module.fixture_helpers_present,fixture_helpers: module.fixture_helpers,lists: module.lists,cohorts: module.cohorts,has_regions: module.regions.present,region_runtime: region_runtime,region_frame_bytes: frame_bytes,region_bytes: region_bytes,region_mask: mask,host_references: module.host_references,public_arena: module.public_arena,cleanup_data: module.cleanup_data,defer_cycles: module.defer_cycles,mutable_static: module.mutable_static,indirect: module.indirect,start: module.start,types: captureTypes(module),names: copy(module.names),signatures: copy(module.signatures),imports: copy(module.imports),globals: copy(module.globals),exports: copy(module.exports),data: copy(module.data),static_fields: copy(module.static_fields),table_functions: copy(module.table_functions),table_origins: copy(module.table_origins),semantic_sites: copy(module.semantic_sites),region_members: members,region_scopes: scopes,functions: copy(functions),..};
}
fn encode(module: const Module&,output: u8[>..<]&) -> Error { let image = capture(module); to_bytes([image],output); return blot_error::Error.none; }
fn validRange(range: blot_backend_runtime_ir::Range,length: i64) -> bool { return range.start >= 0 && range.len >= 0 && range.start <= length && range.len <= length - range.start; }
fn machine(ty: u8,none: bool) -> bool { return ty == blot_backend_runtime_ir::VT_i32 || ty == blot_backend_runtime_ir::VT_f32 || ty == blot_backend_runtime_ir::VT_v128 || ty == blot_backend_runtime_ir::VT_externref || (none && ty == blot_backend_runtime_ir::VT_none); }
fn validImage(image: const Image&) -> bool {
    if image.version != 1 || image.functions.len > 4294967295 || image.imports.len > 4294967295 - image.functions.len || !validRange(image.cleanup_data,image.data.len) { return false; } for ty in image.types { if !machine(ty,false) { return false; } } for signature in image.signatures { if !validRange(signature.parameters,image.types.len) || !machine(signature.result,true) { return false; } } for imported in image.imports { if !validRange(imported.module,image.names.len) || !validRange(imported.name,image.names.len) || imported.signature >= image.signatures.len { return false; } } for exported in image.exports { if !validRange(exported.name,image.names.len) { return false; } if exported.global { if exported.index >= image.globals.len { return false; } } else if exported.index >= image.functions.len { return false; } } if image.start.present && image.start.value >= image.functions.len { return false; }
    for function in image.functions { if function.signature >= image.signatures.len || !machine(function.result,true) || function.result_role > 3 { return false; } for ty in function.parameters { if !machine(ty,false) { return false; } } for ty in function.locals { if !machine(ty,false) { return false; } } var annotations: u32 = 0; for instruction in function.instructions { if instruction.op >= blot_backend_runtime_ir::op_names.len { return false; } if instruction.op == blot_backend_runtime_ir::OP_ownership { annotations++; } if instruction.op == blot_backend_runtime_ir::OP_call && instruction.operand >= image.functions.len { return false; } if instruction.op == blot_backend_runtime_ir::OP_call_import && instruction.operand >= image.imports.len { return false; } if (instruction.op == blot_backend_runtime_ir::OP_global_get || instruction.op == blot_backend_runtime_ir::OP_global_set) && instruction.operand >= image.globals.len { return false; } if (instruction.op == blot_backend_runtime_ir::OP_local_get || instruction.op == blot_backend_runtime_ir::OP_local_set || instruction.op == blot_backend_runtime_ir::OP_local_tee) && instruction.operand >= function.parameters.len + function.locals.len { return false; } if instruction.op == blot_backend_runtime_ir::OP_call_indirect && instruction.operand >= image.signatures.len { return false; } } if annotations != function.annotations { return false; } }
    return true;
}
fn withModule<C,F>(image: const Image&,context: C&) -> Error {
    if !validImage(image) { return blot_error::Error.invalid_artifact; }
    var types: u8[>..<] = []; var instructions: IR[>..<] = []; var names: u8[>..<] = []; var functions: blot_backend_runtime_ir::Function[>..<] = []; var signatures: blot_backend_runtime_ir::Signature[>..<] = []; var imports: blot_backend_wasm::Import[>..<] = []; var globals: blot_backend_wasm::Global[>..<] = []; var exports: blot_backend_wasm::Export[>..<] = []; var data: u8[>..<] = []; var static_fields: u32[>..<] = []; var table_functions: u32[>..<] = []; var table_origins: blot_backend_wasm::TableOrigin[>..<] = []; var semantic_sites: blot_backend_wasm::SemanticSite[>..<] = [];
    var module = blot_backend_wasm::init(types,instructions,names,functions,signatures,imports,globals,exports,data,static_fields,table_functions,table_origins,semantic_sites); module.types.append(image.types[..]); module.names.append(image.names[..]); module.signatures.append(image.signatures[..]); module.imports.append(image.imports[..]); module.globals.append(image.globals[..]); module.exports.append(image.exports[..]); module.data.append(image.data[..]); module.static_fields.append(image.static_fields[..]); module.table_functions.append(image.table_functions[..]); module.table_origins.append(image.table_origins[..]); module.semantic_sites.append(image.semantic_sites[..]);
    module.memory_model = image.memory_model; module.fixed_memory_bytes = image.fixed_memory_bytes; module.array_transport = image.array_transport; module.arena = image.arena; module.fixture_helpers_present = image.fixture_helpers_present; module.fixture_helpers = image.fixture_helpers; module.lists = image.lists; module.cohorts = image.cohorts; module.host_references = image.host_references; module.public_arena = image.public_arena; module.cleanup_data = image.cleanup_data; module.defer_cycles = image.defer_cycles; module.mutable_static = image.mutable_static; module.indirect = image.indirect; module.start = image.start;
    if image.has_regions { module.regions = blot_support::Option<blot_runtime_region_runtime::Prepared>{true,blot_runtime_region_runtime::Prepared { runtime: image.region_runtime,plan: blot_runtime_region_runtime::Plan { frame_bytes: image.region_frame_bytes,bytes: image.region_bytes,mask: image.region_mask,members: image.region_members[..],..},scopes: image.region_scopes[..],..}}; }
    for source in image.functions { let parameters = blot_backend_runtime_ir::Range { start: module.types.len,len: source.parameters.len,..}; module.types.append(source.parameters[..]); let body = module.publishBody(source.locals[..],source.instructions[..]); module.functions.push(blot_backend_runtime_ir::Function { parameters: parameters,result: source.result,result_role: source.result_role,entry: source.entry,provider_parameter: source.provider_parameter,callable_layout: source.callable_layout,signature: source.signature,parameter_roles: source.parameter_roles,annotations: source.annotations,locals: body.locals,instructions: body.instructions,..}); }
    let error = F(context,module); module.deinit(); return error;
}
fn decodeWithModule<C,F>(bytes: const u8[:],context: C&) -> Error { let images,valid = from_bytes<Image[]>(bytes); if !valid || images.len != 1 { return blot_error::Error.invalid_artifact; } for image in images { return withModule(image,context,F); } return blot_error::Error.invalid_artifact; }
