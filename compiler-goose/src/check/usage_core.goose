    } return Error.none;
}
fn Walker::loanResult(self: Walker&, callback: blot_check_core::ClosureInfo, depth: i64) -> Error { var context = LoanResult { self, callback, depth }; return blot_check_capability_contracts::withStore<LoanResult,loanPaths>(context); }
fn Walker::requireResourceEffect(self: Walker&) -> Error { for label in self.module.types.rowLabels(self.ambient) { let operation = self.module.types.operation(label); if operation.identity.unit == 0 && operation.identity.decl == 1 && operation.instance.unit == 0 && operation.instance.decl == 0 && operation.arguments.len == 0 { return Error.none; } } return Error.invalid_artifact; }
