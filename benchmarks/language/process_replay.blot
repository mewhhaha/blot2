effect Start: Array U32 -> U32
const state: ResizeArray U32 = #[0]
entry func planner (seed: U32): U32 => return do:
  state[0] = seed
  return seed
entry func planner_step (input: Array U32): U32 => return do:
  state[0] = @u32.add state[0] input[1]
  return state[0]
func request (seed: U32): U32 ! { Start } => return Start #[seed, 112, 108, 97, 110, 110, 101, 114]
entry func local (seed: U32): U32 => return do @effect.provider Start (func packet => return if packet[0] < 5 then packet[0] else 0):
  use admission <- request seed
  return admission
entry func live (start: Array U32 -> U32 ! { Foreign }): Array U32 => return do @effect.provider Start start:
  use a <- request 10
  use b <- request 100
  use refused <- request 500
  return #[a,b,refused]
entry func apply_tick (input: Array U32): U32 => return do:
  let world = input[0]
  for index in 1..input.length:
    world := @u32.add (@u32.mul self 33) input[index]
  return world

entry func costly (seed: U32): U32 => return seed
entry func costly_step (input: Array U32): U32 => return @u32.add input[0] input[1]
entry func bad_init (seed: U32): U32 => return @panic "init fault"
entry func bad_init_step (input: Array U32): U32 => return 0
entry func bad_step (seed: U32): U32 => return seed
entry func bad_step_step (input: Array U32): U32 => return @panic "step fault"
