// Many small arithmetic parses with real error paths (EOF, PAREN, TOKEN, DIV0),
// a fresh stack-backed AST pool per input, and direct recursive descent + eval.
import * as rng from "./rng"

const BENCH_N: U32 = 250000 // BENCH_N

const E_EOF: U32 = 1
const E_PAREN: U32 = 2
const E_TOKEN: U32 = 3
const E_DIV0: U32 = 4

type Expr is data = $Num { v: U32 } | $Neg { inner: U32 } | $Paren { inner: U32 } | $Bin { op: U8, l: U32, r: U32 }
type RunRes is data = $RunRes { val: U64, err: U32, nodes: U32 }
type EvalRes is data = $EvalRes { val: U64, err: U32 }

func push_ch (text: own #[U8]) -> (tlen: U32) -> (ch: U8): (#[U8], U32) =>
  if tlen < text.length:
    text[tlen] := ch
    return (text, tlen + 1)
  text := self.push ch
  return (text, tlen + 1)

func gen_expr (text: own #[U8]) -> (tlen: U32) -> (d: U32) -> (seed: U64): (#[U8], U32, U64) =>
  let s = rng.xs_next seed
  let k = (s & 7u64).to_u32
  if d == 0 or k == 0:
    let v = 1 + ((s >> 8u64) % 99u64).to_u32
    if v >= 10:
      let (t1, l1) = push_ch text tlen (48 + v / 10).to_u8
      text := t1
      tlen := l1
    let (t2, l2) = push_ch text tlen (48 + v % 10).to_u8
    return (t2, l2, s)
  case k of
    1 => do:
      let (t1, l1) = push_ch text tlen '-'
      return gen_expr t1 l1 (d - 1) s
    2 => do:
      let (t1, l1) = push_ch text tlen '('
      let (t2, l2, s2) = gen_expr t1 l1 (d - 1) s
      let (t3, l3) = push_ch t2 l2 ')'
      return (t3, l3, s2)
    _ => do:
      let (t1, l1, s1) = gen_expr text tlen (d - 1) s
      let op = ((s1 >> 16u64) & 3u64).to_u32
      let op_ch: U8 =
        case op of
          0 => '+'
          1 => '-'
          2 => '*'
          _ => '/'
      let (t2, l2) = push_ch t1 l1 ' '
      let (t3, l3) = push_ch t2 l2 op_ch
      let (t4, l4) = push_ch t3 l3 ' '
      return gen_expr t4 l4 (d - 1) (rng.xs_next s1)

func gen_and_corrupt (text: own #[U8]) -> (init_depth: U32) -> (init_seed: U64): (#[U8], U32) =>
  let (t0, tlen, seed) = gen_expr text 0 init_depth init_seed
  text := t0
  let kind = (seed & 15u64).to_u32
  case kind of
    0 => do:
      let i = tlen
      let patched = false
      for ever:
        if i == 0:
          break
        i := self - 1
        if text[i] == ')':
          text[i] := ' '
          patched := true
          break
      if not patched:
        text[0] := '#'
    1 => do:
      let idx = ((seed >> 8u64) % tlen.to_u64).to_u32
      text[idx] := '#'
    2 => do:
      tlen := self / 2
    3 => do:
      let (t1, l1) = push_ch text tlen ' '
      let (t2, l2) = push_ch t1 l1 '/'
      let (t3, l3) = push_ch t2 l2 ' '
      let (t4, l4) = push_ch t3 l3 '0'
      text := t4
      tlen := l4
    _ => do:
      tlen := self
  return (text, tlen)

func skip (text: #[U8]) -> (tlen: U32) -> (pos: U32): U32 =>
  let p = pos
  for ever:
    if p >= tlen:
      break
    if text[p] != ' ':
      break
    p := self + 1
  return p

func parse_factor (text: #[U8]) -> (tlen: U32) -> (pool: own #[Expr]) -> (pos: U32): (#[Expr], U32, U32, U32) =>
  let p = skip text tlen pos
  if p >= tlen:
    return (pool, p, 0, E_EOF)
  let c = text[p]
  if c >= '0' and c <= '9':
    let v: U32 = 0
    for ever:
      if p >= tlen:
        break
      let ch = text[p]
      if ch >= '0' and ch <= '9':
        v := self * 10 + (ch - '0').to_u32
        p := self + 1
      else:
        break
    let idx = pool.length
    pool := self.push ($Num { v })
    return (pool, p, idx, 0)
  if c == '-':
    let (pool1, p1, inner, err) = parse_factor text tlen pool (p + 1)
    if err != 0:
      return (pool1, p1, 0, err)
    let idx = pool1.length
    let pool2 = pool1.push ($Neg { inner })
    return (pool2, p1, idx, 0)
  if c == '(':
    let (pool1, p1, inner, err) = parse_expr text tlen pool (p + 1)
    if err != 0:
      return (pool1, p1, 0, err)
    let p2 = skip text tlen p1
    if p2 >= tlen or text[p2] != ')':
      return (pool1, p2, 0, E_PAREN)
    let idx = pool1.length
    let pool2 = pool1.push ($Paren { inner })
    return (pool2, p2 + 1, idx, 0)
  return (pool, p, 0, E_TOKEN)

func parse_term (text: #[U8]) -> (tlen: U32) -> (pool: own #[Expr]) -> (pos: U32): (#[Expr], U32, U32, U32) =>
  let (p0, pos0, lhs0, err0) = parse_factor text tlen pool pos
  if err0 != 0:
    return (p0, pos0, 0, err0)
  pool := p0
  let cur_pos = pos0
  let lhs = lhs0
  for ever:
    cur_pos := skip text tlen self
    if cur_pos >= tlen:
      break
    let op = text[cur_pos]
    if op != '*' and op != '/':
      break
    let (p1, pos1, rhs, err1) = parse_factor text tlen pool (cur_pos + 1)
    if err1 != 0:
      return (p1, pos1, 0, err1)
    let idx = p1.length
    pool := p1.push ($Bin { op, l: lhs, r: rhs })
    lhs := idx
    cur_pos := pos1
  return (pool, cur_pos, lhs, 0)

func parse_expr (text: #[U8]) -> (tlen: U32) -> (pool: own #[Expr]) -> (pos: U32): (#[Expr], U32, U32, U32) =>
  let (p0, pos0, lhs0, err0) = parse_term text tlen pool pos
  if err0 != 0:
    return (p0, pos0, 0, err0)
  pool := p0
  let cur_pos = pos0
  let lhs = lhs0
  for ever:
    cur_pos := skip text tlen self
    if cur_pos >= tlen:
      break
    let op = text[cur_pos]
    if op != '+' and op != '-':
      break
    let (p1, pos1, rhs, err1) = parse_term text tlen pool (cur_pos + 1)
    if err1 != 0:
      return (p1, pos1, 0, err1)
    let idx = p1.length
    pool := p1.push ($Bin { op, l: lhs, r: rhs })
    lhs := idx
    cur_pos := pos1
  return (pool, cur_pos, lhs, 0)

func eval_rec (pool: #[Expr]) -> (idx: U32): EvalRes =>
  case pool[idx] of
    $Num { v } => $EvalRes { val: v.to_u64, err: 0 }
    $Neg { inner } => do:
      let r = eval_rec pool inner
      if r.err != 0:
        return r
      return $EvalRes { val: 0u64 - r.val, err: 0 }
    $Paren { inner } => eval_rec pool inner
    $Bin { op, l, r } => do:
      let lr = eval_rec pool l
      if lr.err != 0:
        return lr
      let rr = eval_rec pool r
      if rr.err != 0:
        return rr
      let ev: EvalRes =
        case op of
          '+' => $EvalRes { val: lr.val + rr.val, err: 0 }
          '-' => $EvalRes { val: lr.val - rr.val, err: 0 }
          '*' => $EvalRes { val: lr.val * rr.val, err: 0 }
          _ => if rr.val == 0u64 then $EvalRes { val: 0u64, err: E_DIV0 } else $EvalRes { val: lr.val / rr.val, err: 0 }
      return ev

func run_one (text: #[U8]) -> (tlen: U32): RunRes =>
  let pool: #[Expr] = Array.with_capacity 64
  let (p, pos, root, err) = parse_expr text tlen pool 0
  let nodes = p.length
  if err != 0:
    return $RunRes { val: 0u64, err, nodes }
  let end_pos = skip text tlen pos
  if end_pos != tlen:
    return $RunRes { val: 0u64, err: E_TOKEN, nodes }
  let ev = eval_rec p root
  return $RunRes { val: ev.val, err: ev.err, nodes }

io bench (): #[U32] =>
  let seed: U64 = 12345u64
  let text: #[U8] = Array.with_capacity 128

  let ok: U32 = 0
  let e_eof: U32 = 0
  let e_paren: U32 = 0
  let e_token: U32 = 0
  let e_div0: U32 = 0
  let sum: U64 = 0u64
  let chars: I64 = 0i64
  let nodes: I64 = 0i64

  for _ in 0 .. BENCH_N:
    seed := rng.xs_next self
    let depth = 3 + (seed & 3u64).to_u32
    let (t1, tlen) = gen_and_corrupt text depth (seed >> 8u64)
    text := t1
    chars := self + tlen.to_i64
    let $RunRes { val, err, nodes: nn } = run_one text tlen
    nodes := self + nn.to_i64
    case err of
      0 => do:
        ok := self + 1
        sum := self * 31u64 + val
      1 => do:
        e_eof := self + 1
      2 => do:
        e_paren := self + 1
      3 => do:
        e_token := self + 1
      _ => do:
        e_div0 := self + 1

  let out: #[U32] = #[]
  out := rng.emit_i64 self chars
  out := rng.emit_i64 self nodes
  out := rng.emit_u32 self ok
  out := rng.emit_u32 self e_eof
  out := rng.emit_u32 self e_paren
  out := rng.emit_u32 self e_token
  out := rng.emit_u32 self e_div0
  out := rng.emit_u64 self sum
  return out
