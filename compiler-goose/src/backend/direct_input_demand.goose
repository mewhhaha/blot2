// Descending entry moves retain every logical local ID while narrowing inputs.
namespace blot_backend_direct_input_demand;
import .runtime_ir;
import .wasm;
import support.error;
type Error = blot_error::Error;
struct Result { used: bool[:],omitted: i64 }
reusable[] var used_runs: bool[>..] = [];
reusable[] var code_runs: blot_backend_runtime_ir::Instruction[>..] = [];
reusable[] var type_runs: blot_backend_runtime_ir::ValueType[>..] = [];
fn deinit(result: Result&) { if result.used.len != 0 { used_runs.free_slice(result.used); } result.used = []; }
fn canPromotePacked(module: const blot_backend_wasm::Module&,id: u32,words: i64,serialization_start: i64,result_slot: bool) -> bool,Error {
    let function = module.functions[id]; let parameters = module.parameters(id); let locals = module.locals(id); let code = blot_backend_wasm::instructions(module,id); if parameters.len != 1 || locals.len < words || function.entry || function.parameter_roles != 0 || function.callable_layout != 0 { return false,blot_error::Error.none; } if function.provider_parameter != blot_backend_runtime_ir::unknown_provider && function.provider_parameter != blot_backend_runtime_ir::no_provider { return false,blot_error::Error.none; } for ty in locals[..words] { if ty != blot_backend_runtime_ir::VT_i32 { return false,blot_error::Error.none; } }
    for instruction,index in code { if instruction.op == blot_backend_runtime_ir::OP_ownership || instruction.op == blot_backend_runtime_ir::OP_resource_retire || instruction.table_reference || instruction.table_kind != blot_backend_runtime_ir::TABLE_unknown { return false,blot_error::Error.none; } if (instruction.op == blot_backend_runtime_ir::OP_local_get || instruction.op == blot_backend_runtime_ir::OP_local_set || instruction.op == blot_backend_runtime_ir::OP_local_tee) && instruction.operand == 0 && (index < serialization_start || !result_slot) { return false,blot_error::Error.none; } }
    let used = used_runs.alloc_slice(words + 1); for &read in used { read = false; } for instruction in code { if instruction.op == blot_backend_runtime_ir::OP_local_get && instruction.operand <= words { used[instruction.operand] = true; } } var count: i64 = 0; for read in used { if read { count++; } } used_runs.free_slice(used); return count <= 512,blot_error::Error.none;
}
fn materialize(module: blot_backend_wasm::Module&,id: u32) -> Result,Error {
    let unchanged = Result { used: [],omitted: 0 , ..}; let function = module.functions[id]; let parameters = module.parameters(id); let locals = module.locals(id); let code = blot_backend_wasm::instructions(module,id); let count = parameters.len;
    if count == 0 || function.entry || function.parameter_roles != 0 || function.callable_layout != 0 { return unchanged,blot_error::Error.none; } if function.provider_parameter != blot_backend_runtime_ir::unknown_provider && function.provider_parameter != blot_backend_runtime_ir::no_provider { return unchanged,blot_error::Error.none; } for ty in parameters { if ty != blot_backend_runtime_ir::VT_i32 { return unchanged,blot_error::Error.none; } } for instruction in code { if instruction.op == blot_backend_runtime_ir::OP_ownership || instruction.op == blot_backend_runtime_ir::OP_resource_retire || instruction.table_reference || instruction.table_kind != blot_backend_runtime_ir::TABLE_unknown { return unchanged,blot_error::Error.none; } }
    let used = used_runs.alloc_slice(count); for &read in used { read = false; } for instruction in code { if instruction.op == blot_backend_runtime_ir::OP_local_get && instruction.operand < count { used[instruction.operand] = true; } } var demanded: i64 = 0; for read in used { if read { demanded++; } } if demanded == count { used_runs.free_slice(used); return unchanged,blot_error::Error.none; }
    var physical = demanded; var logical = count; var moves: i64 = 0; while logical != 0 { logical--; if !used[logical] { continue; } physical--; if logical != physical { moves++; } }
    let lowered = code_runs.alloc_slice(moves * 2 + code.len); var next: i64 = 0; physical = demanded; logical = count;
    while logical != 0 { logical--; if !used[logical] { continue; } physical--; if logical == physical { continue; } lowered[next] = blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_local_get,physical as u32); lowered[next + 1] = blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_local_set,logical as u32); next += 2; } for instruction in code { lowered[next] = instruction; next++; }
    let types = type_runs.alloc_slice(count - demanded + locals.len); next = 0; for ty in parameters[demanded..] { types[next] = ty; next++; } for ty in locals { types[next] = ty; next++; } let error = module.publishFunctionBody(id,types,lowered); type_runs.free_slice(types); if lowered.len != 0 { code_runs.free_slice(lowered); } if error != blot_error::Error.none { used_runs.free_slice(used); return unchanged,error; } module.functions[id].parameters.len = demanded; return Result { used: used,omitted: count - demanded , ..},blot_error::Error.none;
}
