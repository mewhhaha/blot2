// A bounded rectangular producer/map/flatten proof over checked Core.
namespace blot_backend_pipeline_builder;
import check.core;
import check.types;
import .function_facts;
import .known_call;
import support.option;
type Module = blot_check_core::Module;
type Tag = blot_check_core::Tag;
type ArrayOp = blot_check_core::ArrayOp;
struct Plan {
    count: u32 = 0,width: u32 = 0,outer: u32 = 0,inner: u32 = 0,value: u32 = 0,result: u32 = 0,result_source: u32 = 0,
    total: u32[18] = [0;18],total_count: i64 = 0,dependencies: blot_check_core::BindingRef[16] = [blot_check_core::BindingRef {..};16],dependency_count: i64 = 0,
}
fn depend(plan: Plan&,target: blot_check_core::BindingRef) -> bool { if plan.dependency_count == 16 { return false; } plan.dependencies[plan.dependency_count] = target; plan.dependency_count++; return true; }
struct Operation { arguments: u32[3] = [0;3],count: i64 = 0 }
recursive fn operation(units: const Module[:],owner: u32,id: u32,wanted: ArrayOp,plan: Plan&,depth: i64) -> blot_support::Option<Operation> {
    if depth >= 4 { return blot_support::none<Operation>(); } let source .= units[owner - 1];
    if source.node(id).tag == blot_check_core::Tag.array_op { if source.arrayOperation(id) != wanted { return blot_support::none<Operation>(); } let children = source.children(id); if children.len > 3 { return blot_support::none<Operation>(); } var result = Operation { count: children.len , ..}; for child,index in children { result.arguments[index] = child; } return blot_support::some(result); }
    let call = blot_backend_known_call::resolve(units,owner,id); if !call.present { return blot_support::none<Operation>(); } let wrapper = blot_backend_known_call::wrapper(units,owner,call.value); if !wrapper.present || !plan.depend(wrapper.value.target) { return blot_support::none<Operation>(); } let producer .= units[wrapper.value.target.unit - 1]; let selected = operation(units,wrapper.value.target.unit,wrapper.value.body.root,wanted,plan,depth + 1); if !selected.present { return blot_support::none<Operation>(); } var forwarded = selected.value; var used: u8 = 0;
    for &argument in forwarded.arguments[..forwarded.count] { let position = blot_backend_known_call::parameterPosition(producer,wrapper.value.target.unit,producer.bodyParameters(wrapper.value.body),argument,used); if !position.present { return blot_support::none<Operation>(); } argument = call.value.arguments[position.value]; }
    if call.value.count != forwarded.count { return blot_support::none<Operation>(); } for argument,index in forwarded.arguments[..forwarded.count] { if argument != call.value.arguments[index] { return blot_support::none<Operation>(); } } return blot_support::some(forwarded);
}
fn scalarTotal(units: const Module[:],owner: u32,id: u32,plan: Plan&) -> bool {
    let source .= units[owner - 1]; let tag = source.types.node(source.typeOf(id)).tag;
    if tag != blot_check_types::Tag.unsigned32 && tag != blot_check_types::Tag.floating32 && tag != blot_check_types::Tag.boolean && tag != blot_check_types::Tag.unit { return false; }
    if plan.total_count == 18 { return false; } plan.total[plan.total_count] = id; plan.total_count++; return true;
}
fn uniqueUse(source: const Module&,binding: u32,allowed: u32) -> bool {
    for node,index in source.nodes { if node.tag == blot_check_core::Tag.reference && blot_backend_function_facts::local(source,index as u32,binding) && index != allowed { return false; } }
    for closure in source.closures { for capture in source.extra[closure.captures.start..closure.captures.start + closure.captures.len] { if capture == binding { return false; } } }
    for carry in source.loop_carries { if carry.incoming == binding || carry.iteration == binding || carry.backedge == binding || carry.outgoing == binding { return false; } }
    for merge in source.merges { if merge.then_binding == binding || merge.else_binding == binding { return false; } } return true;
}
fn closure(source: const Module&,id: u32) -> blot_support::Option<blot_check_core::ClosureInfo> { let node = source.node(id); if node.tag != blot_check_core::Tag.closure { return blot_support::none<blot_check_core::ClosureInfo>(); } let value = source.closures[node.a]; if value.qualifier != 0 || value.parameter.binding == 0 { return blot_support::none<blot_check_core::ClosureInfo>(); } return blot_support::some(value); }
fn analyze(units: const Module[:],owner: u32,id: u32) -> blot_support::Option<Plan> {
    let source .= units[owner - 1]; if source.node(id).tag != blot_check_core::Tag.block_ { return blot_support::none<Plan>(); } let statements = source.children(id); if statements.len < 4 { return blot_support::none<Plan>(); } let first = source.node(statements[0]); let second = source.node(statements[1]); let third = source.node(statements[2]); if first.tag != blot_check_core::Tag.bind || second.tag != blot_check_core::Tag.bind || third.tag != blot_check_core::Tag.bind { return blot_support::none<Plan>(); } var plan = Plan { result: third.a,result_source: third.b , ..};
    let flattened = operation(units,owner,third.b,blot_backend_collection_ops::Op.flatten,plan,0); if !flattened.present || !blot_backend_function_facts::local(source,flattened.value.arguments[0],second.a) || !uniqueUse(source,second.a,flattened.value.arguments[0]) { return blot_support::none<Plan>(); }
    let mapped = blot_backend_known_call::resolve(units,owner,second.b); if !mapped.present { return blot_support::none<Plan>(); } let map = blot_backend_known_call::wrapper(units,owner,mapped.value); if !map.present || mapped.value.count != 2 || !plan.depend(map.value.target) { return blot_support::none<Plan>(); }
    let producer .= units[map.value.target.unit - 1]; let parameters = producer.bodyParameters(map.value.body); let generated = operation(units,map.value.target.unit,map.value.body.root,blot_backend_collection_ops::Op.generate,plan,0); if !generated.present { return blot_support::none<Plan>(); } let length = operation(units,map.value.target.unit,generated.value.arguments[0],blot_backend_collection_ops::Op.length,plan,0); if !length.present { return blot_support::none<Plan>(); } let callback = closure(producer,generated.value.arguments[1]); if !callback.present { return blot_support::none<Plan>(); }
    let apply = producer.node(callback.value.body); if apply.tag != blot_check_core::Tag.apply || !blot_backend_function_facts::local(producer,apply.a,parameters[0].binding) || !blot_backend_function_facts::local(producer,length.value.arguments[0],parameters[1].binding) { return blot_support::none<Plan>(); } let get = operation(units,map.value.target.unit,apply.b,blot_backend_collection_ops::Op.get,plan,0); if !get.present || !blot_backend_function_facts::local(producer,get.value.arguments[0],parameters[1].binding) || !blot_backend_function_facts::local(producer,get.value.arguments[1],callback.value.parameter.binding) { return blot_support::none<Plan>(); }
    if !blot_backend_function_facts::local(source,mapped.value.arguments[1],first.a) || !uniqueUse(source,first.a,mapped.value.arguments[1]) { return blot_support::none<Plan>(); } let select = closure(source,mapped.value.arguments[0]); if !select.present { return blot_support::none<Plan>(); } let selected = source.node(select.value.body); if selected.tag != blot_check_core::Tag.project || !blot_backend_function_facts::local(source,selected.a,select.value.parameter.binding) { return blot_support::none<Plan>(); } let projection = source.projection(selected.b);
    let outer = operation(units,owner,first.b,blot_backend_collection_ops::Op.generate,plan,0); if !outer.present || !scalarTotal(units,owner,outer.value.arguments[0],plan) { return blot_support::none<Plan>(); } let produced = closure(source,outer.value.arguments[1]); if !produced.present { return blot_support::none<Plan>(); } var record = produced.value.body;
    if source.node(record).tag == blot_check_core::Tag.construct { let constructor = source.constructor(source.node(record).a); let nominal = source.nominal(constructor.nominal); let projected = source.types.node(projection.source_type); if nominal.is_opaque || projected.tag != blot_check_types::Tag.nominal || nominal.identity.unit != projected.a || nominal.identity.decl != projected.b { return blot_support::none<Plan>(); } record = source.node(record).b; } else if projection.nominal.decl != 0 { return blot_support::none<Plan>(); }
    if source.node(record).tag != blot_check_core::Tag.record { return blot_support::none<Plan>(); } let ty = source.types.node(source.typeOf(record)); if ty.tag != blot_check_types::Tag.record || projection.field == 0 { return blot_support::none<Plan>(); } var child_array: u32 = 0; let destinations = source.recordDestinations(record);
    for child,index in source.children(record) { if source.types.recordField(ty,destinations[index]).name == projection.field { if child_array != 0 { return blot_support::none<Plan>(); } child_array = child; } else if !scalarTotal(units,owner,child,plan) { return blot_support::none<Plan>(); } }
    if child_array == 0 { return blot_support::none<Plan>(); } let inner = operation(units,owner,child_array,blot_backend_collection_ops::Op.generate,plan,0); if !inner.present { return blot_support::none<Plan>(); } let width = source.node(inner.value.arguments[0]); if width.tag != blot_check_core::Tag.constant || source.types.node(source.typeOf(inner.value.arguments[0])).tag != blot_check_types::Tag.unsigned32 || width.a > 4096 { return blot_support::none<Plan>(); } let lane = closure(source,inner.value.arguments[1]); if !lane.present || !scalarTotal(units,owner,lane.value.body,plan) { return blot_support::none<Plan>(); }
    plan.count = outer.value.arguments[0]; plan.width = width.a; plan.outer = produced.value.parameter.binding; plan.inner = lane.value.parameter.binding; plan.value = lane.value.body; return blot_support::some(plan);
}
