let exercise: Unit -> Result[U32,ReserveError] ! {reserve,release}
= fn () => return region@[U32](4) as r (owner,free) in do:
  let rest = do:
    case region.try_alloc@[U32](free,1):
      #Err((unused,_)) => break unused
      #Ok((unused,destination)) => do:
        let initial = builder.begin_append(destination)
        let filled = builder.append(initial,41)
        builder.discard(filled)
        break unused
  space.end(rest)
  let (next_owner,next_free) = region.reset(owner)
  let (last,answer): (Space[r],U32) = do:
    case region.try_alloc@[U32](next_free,1):
      #Err((unused,_)) => break (unused,0)
      #Ok((unused,destination)) => do:
        let packed = array.in(destination,#[42])
        let answer = open packed as [d] a in do:
          break a[0]
        break (unused,answer)
  space.end(last)
  region.close(next_owner)
  break answer
pub let run: Unit -> U32 ! {reserve,release} resources {depth:4,frame:8192} = fn () => do:
  case exercise(()):
    #Err(_) => return 0
    #Ok(answer) => return answer
