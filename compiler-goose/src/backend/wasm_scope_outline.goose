fn bankBefore(references:const Reference[:],left:u32,right:u32)->bool {if references[left].weight!=references[right].weight {return references[left].weight>references[right].weight;}return left<right;}
fn siftBank(order:u32[:],references:const Reference[:],root:i64,count:i64) {var parent=root;loop {var child=parent*2+1;if child>=count {return;}if child+1<count && bankBefore(references,order[child],order[child+1]) {child+=1;}if !bankBefore(references,order[parent],order[child]) {return;}let swap=order[parent];order[parent]=order[child];order[child]=swap;parent=child;}}
fn orderBank(mapping:u32[:],references:const Reference[:],start:i64,end:i64)->u64 {let order=word_runs.alloc_slice(end-start);var at:i64=0;var old_bytes:u64=0;for global,id in mapping {if global==absent {continue;}order[at]=id as u32;at+=1;old_bytes+=(references[id].weight+1)*uleb(global) as u64;}var parent=order.len/2;while parent!=0 {parent-=1;siftBank(order,references,parent,order.len);}var count=order.len;while count>1 {count-=1;let swap=order[0];order[0]=order[count];order[count]=swap;siftBank(order,references,0,count);}var new_bytes:u64=0;for id,index in order {let global=start+index;mapping[id]=global as u32;new_bytes+=(references[id].weight+1)*uleb(global) as u64;}word_runs.free_slice(order);return old_bytes-new_bytes;}
fn outlineError(error:Error)->Error {if error==blot_error::Error.out_of_memory {return error;}if error!=blot_error::Error.none {return blot_error::Error.outline_limit;}return blot_error::Error.none;}
fn publishFinalization(self_:Context&,prepared:const PreparedBuffer&,first_global:i64,next_global:i64)->Error {let module .= self_.target();var bodies:blot_backend_wasm::BodyPublication[>..]=[];for item in prepared.items {bodies.push(blot_backend_wasm::BodyPublication{function:item.function,body:item.body,..});}let error=module.preflightBodies(bodies);if error!=blot_error::Error.none {return outlineError(error);}for ignored in first_global..next_global {let global,error=module.addGlobal(blot_backend_runtime_ir::SC_u32,0,true);if error!=blot_error::Error.none {return outlineError(error);}}return outlineError(module.publishBodies(bodies));}
