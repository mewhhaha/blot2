type Tick is effect = { read: Unit -> U32 }
const handled = fn computation => do:
  for request in @requests computation:
    case request of
      effect Tick.read () =>
        break 42.5
      complete value =>
        break value
const create = fn action => do:
  let factory = fn callback => @computation (fn () => callback ())
  break @computation (fn () => do:
    let computation = factory action
    break handled computation
  )
entry const answer = fn () => handled (create (fn () => do:
  use Tick.read ()
  break @panic "cancelled action continued"
))
entry const folded = answer ()
