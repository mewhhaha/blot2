original=self.edge(value,EdgeKind.capture,0);if self.failure!=Error.none {return 0;}if self.semantic.nodes[original].kind!=Kind.callable || self.semantic.nodes[original].first_edge.present {self.decline();return 0;}self.target(declaring_request,original);}else if site.kind==blot_backend_activation_graph::Kind.ordinary {let receipt=self.receipt(site.function,site.at);if self.failure!=Error.none {return 0;}if !receipt.present || receipt.value.kind!=SemanticKind.allocation || site.bytes!=8 {self.decline();return 0;}value=self.semanticAt(receipt.value,context.invocation,Kind.nominal);let producer .= self.unit(receipt.value.unit);if !producer {return 0;}let node=producer.node(receipt.value.node);if node.tag!=blot_check_core::Tag.construct || node.a>=producer.constructors.len {self.decline();return 0;}let constructor=producer.constructors[node.a];if constructor.nominal>=producer.nominals.len || producer.nominals[constructor.nominal].identity!=self.semantic.nodes[value].nominal || constructor.tag!=self.semantic.nodes[value].field || node.b==0 {self.decline();return 0;}let code=self.source.instructions(self.source.functions[site.function]);if !nominalConstruction(code,site.at,constructor.tag) {self.decline();return 0;}}else {self.decline();return 0;}if self.failure!=Error.none {return 0;}if self.semantic.nodes[value].owner!=scope {self.decline();return 0;}for mapped in members {if mapped!=absent && mapped==value {self.decline();return 0;}}members[id]=value;}for context in self.contexts {if context.event.present {if self.edge(context.event.value,EdgeKind.call,1)!=owner {self.decline();return 0;}if self.failure!=Error.none {return 0;}}}self.mapStores(members,owner);return owner;}
fn nominalConstruction(code:const blot_backend_runtime_ir::Instruction[:],at:u32,tag:u32)->bool {if at+7>=code.len {return false;}return code[at+1].op==blot_backend_runtime_ir::OP_local_set && code[at+2].op==blot_backend_runtime_ir::OP_local_get && code[at+2].operand==code[at+1].operand && code[at+3].op==blot_backend_runtime_ir::OP_i32_const && !code[at+3].table_reference && code[at+3].operand==tag && code[at+4].op==blot_backend_runtime_ir::OP_i32_store && code[at+4].operand==0 && code[at+5].op==blot_backend_runtime_ir::OP_local_get && code[at+5].operand==code[at+1].operand && code[at+6].op==blot_backend_runtime_ir::OP_local_get && code[at+7].op==blot_backend_runtime_ir::OP_i32_store && code[at+7].operand==4;}
fn mapStores(self:Scan&,members:const u32[:],owner:u32) {for store in self.runtime.graph.stores {var owners=store.owners&(self.runtime.members|(1 as u64<<self.runtime.owner));while owners!=0 {let id=blot_backend_activation_graph::firstBit(owners);owners&=owners-1;let physical=self.runtime.graph.sites[id];let semantic=members[id];var expected=blot_support::none<u32>();if id==self.runtime.owner {if store.offset!=4 {continue;}let event=self.contexts[store.context].event;if event.present {expected=blot_support::some(self.edge(event.value,EdgeKind.call,2));}else {if store.values&self.runtime.members!=0 {self.decline();return;}continue;}}else if physical.kind==blot_backend_activation_graph::Kind.closure || physical.kind==blot_backend_activation_graph::Kind.ordinary {if store.offset!=4 {if store.values!=0 {self.decline();return;}continue;}if physical.kind==blot_backend_activation_graph::Kind.closure {expected=blot_support::some(self.edge(semantic,EdgeKind.capture,1));}else {expected=blot_support::some(self.edge(semantic,EdgeKind.value,0));}}else {self.decline();return;}if self.failure!=Error.none {return;}var values=store.values;var owns_expected=false;while values!=0 {let child=blot_backend_activation_graph::firstBit(values);values&=values-1;if members[child]!=absent {if members[child]!=expected.value {self.decline();return;}owns_expected=true;}else if self.runtime.graph.sites[child].kind!=blot_backend_activation_graph::Kind.static_data || self.runtime.graph.sites[child].children!=0 {self.decline();return;}}var semantic_is_member=false;for mapped in members {if mapped!=absent && mapped==expected.value {semantic_is_member=true;}}if semantic_is_member!=owns_expected {self.decline();return;}}}}

// Immutable reports retain only semantic tables. Rebuild derived hash chains
// from the same canonical fingerprints while preserving every original ID.
fn cloneEvidence(snapshot:const blot_eval_type_evidence::Snapshot&)->Evidence,Error {var result,error=blot_eval_type_evidence::init();if error!=Error.none {return Evidence{..},error;}result.nodes.clear();result.nodes.append(snapshot.nodes);result.extra.clear();result.extra.append(snapshot.extra);result.quantifier_goals.clear();result.quantifier_goals.append(snapshot.quantifier_goals);result.quantifier_obligations.clear();result.quantifier_obligations.append(snapshot.quantifier_obligations);result.next.clear();result.buckets.clear();let effects=result.effects;effects.operations.clear();effects.operations.append(snapshot.effects.operations);effects.arguments.clear();effects.arguments.append(snapshot.effects.arguments);effects.rows.clear();effects.rows.append(snapshot.effects.rows);effects.labels.clear();effects.labels.append(snapshot.effects.labels);effects.operation_next.clear();effects.row_next.clear();effects.operation_buckets.clear();effects.row_buckets.clear();for failure in [result.nodes.failure,result.extra.failure,result.quantifier_goals.failure,result.quantifier_obligations.failure,effects.operations.failure,effects.arguments.failure,effects.rows.failure,effects.labels.failure] {if failure!=Error.none {result.deinit();return Evidence{..},failure;}}let view=result.view();for node,index in snapshot.nodes {var prior:u32=0;if index>5 {var a=node.a;var b=node.b;var row=node.c;var values=view.children(index as u32);if node.tag==blot_eval_type_evidence::Tag.product || node.tag==blot_eval_type_evidence::Tag.record {a=0;b=0;row=0;}else if node.tag==blot_eval_type_evidence::Tag.nominal || node.tag==blot_eval_type_evidence::Tag.forall || node.tag==blot_eval_type_evidence::Tag.existential {row=0;}else if node.tag==blot_eval_type_evidence::Tag.projection {row=0;values=snapshot.extra[node.c+1..node.c+1+snapshot.extra[node.c]+3];}let hash=blot_eval_type_evidence::fingerprint(node.tag,a,b,row,values,view.quantifierGoals(index as u32));let head .= result.buckets.get(hash);if head {prior=head;}result.buckets.insert(hash,index as u32);}result.next.push(prior);}let effect_view=effects.view();for operation,index in snapshot.effects.operations {var prior:u32=0;if index!=0 {let hash=blot_check_effect_evidence::operationFingerprint(operation.identity,effect_view.operationArguments(index as u32),operation.instance);let head .= effects.operation_buckets.get(hash);if head {prior=head;}effects.operation_buckets.insert(hash,index as u32);}effects.operation_next.push(prior);}for row,index in snapshot.effects.rows {var prior:u32=0;if index!=0 {let hash=blot_check_effect_evidence::rowFingerprint(effect_view.rowLabels(index as u32),row.formal);let head .= effects.row_buckets.get(hash);if head {prior=head;}effects.row_buckets.insert(hash,index as u32);}effects.row_next.push(prior);}for failure in [result.nodes.failure,result.extra.failure,result.quantifier_goals.failure,result.quantifier_obligations.failure,result.next.failure,effects.operations.failure,effects.arguments.failure,effects.rows.failure,effects.labels.failure,effects.operation_next.failure,effects.row_next.failure] {if failure!=Error.none {result.deinit();return Evidence{..},failure;}}return result,Error.none;}
fn correspondence(source:const Module&,model:Model,runtime:const Cohort&,semantic:const Report&,boundary:BindingRef)->Mapping,Error {var evidence,error=cloneEvidence(semantic.evidence);if error!=Error.none {return Mapping{contexts:[],members:[],owner:0},error;}let contexts=context_runs.alloc_slice(runtime.graph.contexts.len);for &context in contexts {context=Context{invocation:0,..};}var scan=Scan{source:source,model:model,runtime:runtime,semantic:semantic,evidence:evidence,contexts:contexts,..};scan.mapContexts(boundary);if scan.failure!=Error.none {let failure=scan.failure;evidence.deinit();context_runs.free_slice(contexts);return Mapping{contexts:[],members:[],owner:0},failure;}let members=member_runs.alloc_slice(runtime.graph.sites.len);let owner=scan.mapSites(members);let failure=scan.failure;evidence.deinit();if failure!=Error.none {context_runs.free_slice(contexts);member_runs.free_slice(members);return Mapping{contexts:[],members:[],owner:0},failure;}return Mapping{contexts:contexts,members:members,owner:owner},Error.none;}
fn analyze(source:const Module&,model:Model,boundary:u32)->blot_support::Option<Intersection>,Error {let result,error=analyzeChecked(source,model,boundary);if error!=Error.none {if error==Error.out_of_memory {return blot_support::none<Intersection>(),error;}return blot_support::none<Intersection>(),Error.none;}return blot_support::some(result),Error.none;}
fn analyzeChecked(source:const Module&,model:Model,boundary:u32)->Intersection,Error {let candidate,error=blot_backend_activation_graph::cohort(source,boundary);if error!=Error.none {return default<Intersection>(),error;}if !candidate.present {return default<Intersection>(),Error.declined;}var runtime=candidate.value;var request=blot_support::none<Request>();for entry in model.functions {if entry.function==boundary {if request.present {runtime.deinit();return default<Intersection>(),Error.declined;}request=blot_support::some(entry.request);}}if !request.present {runtime.deinit();return default<Intersection>(),Error.declined;}let root=namedKey(request.value);if !root.present {runtime.deinit();return default<Intersection>(),Error.declined;}let target=root.value.target;if target.unit==0 || target.unit>model.units.len {runtime.deinit();return default<Intersection>(),Error.declined;}var owners:blot_check_frozen_core_validation::ModuleRef[>..<]=[];for &unit in model.units {owners.push(blot_check_frozen_core_validation::ModuleRef{value:unit});}var semantic,error=blot_check_capability_lifetimes::analyze(model.units[target.unit-1],owners,target);if error!=Error.none {runtime.deinit();if error==Error.out_of_memory {return default<Intersection>(),error;}return default<Intersection>(),Error.declined;}if !semantic.complete {runtime.deinit();semantic.deinit();return default<Intersection>(),Error.declined;}let mapped,error=correspondence(source,model,runtime,semantic,target);if error!=Error.none {runtime.deinit();semantic.deinit();return default<Intersection>(),error;}return Intersection{runtime:runtime,semantic:semantic,mapping:mapped},Error.none;}
