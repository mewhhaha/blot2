recursive fn expression(self_:Builder&,original:u32,depth:i64)->u32,Error {if original==0 {return 0,blot_error::Error.none;}if self_.scratch.ast_map[original]!=0 {return self_.scratch.ast_map[original],blot_error::Error.none;}if depth>=1024 {let error=self_.diagnostic(blot_check_core::Code.complexity,original);return 0,error;}let source=self_.unwrap(original);if source!=original {let id,error=self_.expression(source,depth+1);if error!=blot_error::Error.none {return 0,error;}self_.scratch.ast_map[original]=id;return id,blot_error::Error.none;}let syntax=self_.source.tree.node(source);let ty,error=self_.typeOf(source);if error!=blot_error::Error.none {return 0,error;}let special,error=expressionMetadata(self_,source,ty,depth);if error!=blot_error::Error.none {return 0,error;}var result:u32=0;if special.present {result=special.value;}else {let value,error=expressionSyntax(self_,source,syntax,ty,depth);if error!=blot_error::Error.none {return 0,error;}result=value;}self_.scratch.ast_map[source]=result;return result,blot_error::Error.none;}
