// The bootstrap prelude is ordinary Blot source. @u32.* and @f32.* are primitives.
// Operators use ordinary functions with compile-time associated dispatch.
infixr 0 ($) = apply
infixr 20 (||) = or
infixr 25 (&&) = and
infixl 5 (|>) = pipe
infix 30 (==) = eq
infix 30 (!=) = ne
infix 30 (<) = lt
infix 30 (<=) = le
infix 30 (>) = gt
infix 30 (>=) = ge
infixl 40 (|) = bit_or
infixl 45 (^) = bit_xor
infixl 50 (&) = bit_and
infixl 55 (<<) = shl
infixl 55 (>>) = shr
infixl 60 (+) = add
infixl 60 (-) = sub
infixl 70 (*) = mul
infixl 70 (/) = div
infixl 70 (%) = rem

const add = func left => return func right => return @type.call "add" left right
const sub = func left => return func right => return @type.call "sub" left right
const mul = func left => return func right => return @type.call "mul" left right
const div = func left => return func right => return @type.call "div" left right
const rem = func left => return func right => return @type.call "rem" left right
const bit_and = func left => return func right => return @type.call "bit_and" left right
const bit_or = func left => return func right => return @type.call "bit_or" left right
const bit_xor = func left => return func right => return @type.call "bit_xor" left right
const shl = func value => return func count => return @type.call "shl" value count
const shr = func value => return func count => return @type.call "shr" value count
const bit_not = func value => return value.bit_not
const eq = func left => return func right => return @type.call "eq" left right
const ne = func left => return func right => return @type.call "ne" left right
const lt = func left => return func right => return @type.call "lt" left right
const le = func left => return func right => return @type.call "le" left right
const gt = func left => return func right => return @type.call "gt" left right
const ge = func left => return func right => return @type.call "ge" left right

type Maybe a is data = #Some a | #Nothing
type Result [value, error] is data = #Ok value | #Err error
type Iteration [state, result] is data = #Continue state | #Done result
type Type witness is data = #Type witness

// The expected result selects its type's ordinary `from` member.
const from = func value => return @type.result "from" value

// A resolver sequences through the selected type's ordinary pure/bind members.
const monad = func constructor => return @do.monad constructor
const F32.from = func value => return value.to_f32
const U32.from = func value => return value.to_u32
const F32.to_f32 = func (value: F32) => return value
const U32.to_u32 = func (value: U32) => return value

const identity = func value => return value
const apply = func function => return func value => return function value
const pipe = func value => return func function => return function value
const always = func value => return func ignored => return value
const compose = func outer => return func inner => return func value => return outer (inner value)
const flip = func combine => return func right => return func left => return combine left right
const on = func combine => return func project => return func left => return func right => return
  combine (project left) (project right)

const Bool.not = func value => return case value of
  true => false
  false => true

const Type.eq = func left => return func right => return case left, right of
  #Type a, #Type b => @type.same a b
const Type.ne = func left => return func right => return Bool.not (Type.eq left right)

const U32.add = func left => return func right => return @u32.add left right
const U32.sub = func left => return func right => return @u32.sub left right
const U32.mul = func left => return func right => return @u32.mul left right
// Division/remainder require a nonzero divisor. Shifts use the low five bits.
const U32.div = func left => return func right => return @u32.div left right
const U32.rem = func left => return func right => return @u32.rem left right
const U32.bit_and = func left => return func right => return @u32.bit_and left right
const U32.bit_or = func left => return func right => return @u32.bit_or left right
const U32.bit_xor = func left => return func right => return @u32.bit_xor left right
const U32.bit_not = func value => return @u32.bit_xor value 0xFFFFFFFF
const U32.shl = func value => return func count => return @u32.shl value count
const U32.shr = func value => return func count => return @u32.shr value count
const U32.abs = func value => return value
const U32.eq = func left => return func right => return @u32.eq left right
const U32.lt = func left => return func right => return @u32.lt left right
const U32.ne = func left => return func right => return Bool.not (U32.eq left right)
const U32.le = func left => return func right => return Bool.not (U32.lt right left)
const U32.gt = func left => return func right => return U32.lt right left
const U32.ge = func left => return func right => return Bool.not (U32.lt left right)
const U32.to_f32 = func value => return @u32.to_f32 value

const F32.add = func left => return func right => return @f32.add left right
const F32.sub = func left => return func right => return @f32.sub left right
const F32.mul = func left => return func right => return @f32.mul left right
const F32.div = func left => return func right => return @f32.div left right
const F32.eq = func left => return func right => return @f32.eq left right
const F32.ne = func left => return func right => return @f32.ne left right
const F32.lt = func left => return func right => return @f32.lt left right
const F32.le = func left => return func right => return @f32.le left right
const F32.gt = func left => return func right => return @f32.gt left right
const F32.ge = func left => return func right => return @f32.ge left right
const F32.neg = func value => return @f32.neg value
const F32.abs = func value => return @f32.abs value
const F32.sqrt = func value => return @f32.sqrt value
const F32.floor = func value => return @f32.floor value
const F32.ceil = func value => return @f32.ceil value
const F32.trunc = func value => return @f32.trunc value
// Truncates toward zero and saturates; NaN/negative values become zero.
const F32.to_u32 = func value => return @f32.to_u32 value
const F32.min = func left => return func right => return case F32.lt left right of
  true => left
  false => right
const F32.max = func left => return func right => return case F32.gt left right of
  true => left
  false => right
const F32.clamp = func low => return func high => return func value => return
  F32.min high (F32.max low value)
const F32.lerp = func left => return func right => return func weight => return
  F32.add left (F32.mul (F32.sub right left) weight)
const F32.square = func value => return F32.mul value value
const F32.length3 = func x => return func y => return func z => return
  F32.sqrt (F32.add (F32.add (F32.square x) (F32.square y)) (F32.square z))
const F32.is_finite = func value => return F32.le (F32.abs value) 3.402823466e38

// A positive finite period wraps finite values into [0, period).
const F32.wrap = func period => return func value => return do:
  let wrapped = F32.sub value (F32.mul period (F32.floor (F32.div value period)))
  if F32.ge wrapped period:
    break 0.0
  if F32.lt wrapped 0.0:
    break F32.add wrapped period
  break wrapped

const F32.lerp_angle = func left => return func right => return func weight => return do:
  let difference = F32.sub (F32.wrap 6.283185307 (F32.add (F32.sub right left) 3.141592654)) 3.141592654
  break F32.add left (F32.mul difference weight)

// Split 2*pi keeps range reduction accurate for |radians| <= 8192.
// Outside that explicit range, trig returns NaN instead of inaccurate geometry.
const f32_reduced_radians = func value => return do:
  if F32.gt (F32.abs value) 8192.0:
    break F32.div 0.0 0.0
  let turns = F32.floor (F32.add (F32.mul value 0.15915494309189535) 0.5)
  break F32.sub (F32.sub value (F32.mul turns 6.28125)) (F32.mul turns 0.001935307179586477)

// Fold to [-pi/2, pi/2], then evaluate the degree-11 Taylor polynomial.
const f32_sin_reduced = func angle => return do:
  let x = case F32.gt angle 1.570796327 of
    true => F32.sub 3.141592654 angle
    false => case F32.lt angle (-1.570796327) of
      true => F32.sub (-3.141592654) angle
      false => angle
  let square = F32.square x
  let term_9 = F32.add 2.755731922398589e-6 (F32.mul square (-2.505210838544172e-8))
  let term_7 = F32.add (-1.984126984126984e-4) (F32.mul square term_9)
  let term_5 = F32.add 8.333333333333333e-3 (F32.mul square term_7)
  let term_3 = F32.add (-1.666666666666667e-1) (F32.mul square term_5)
  break F32.mul x (F32.add 1.0 (F32.mul square term_3))

const f32_cos_reduced = func value => return do:
  let angle = F32.abs value
  let outside = F32.gt angle 1.570796327
  let x = case outside of
    true => F32.sub 3.141592654 angle
    false => angle
  let square = F32.square x
  let term_10 = F32.add (-2.755731922398589e-7) (F32.mul square 2.08767569878681e-9)
  let term_8 = F32.add 2.48015873015873e-5 (F32.mul square term_10)
  let term_6 = F32.add (-1.388888888888889e-3) (F32.mul square term_8)
  let term_4 = F32.add 4.166666666666667e-2 (F32.mul square term_6)
  let term_2 = F32.add (-0.5) (F32.mul square term_4)
  let result = F32.add 1.0 (F32.mul square term_2)
  break case outside of
    true => F32.neg result
    false => result

const F32.sin = func value => return f32_sin_reduced (f32_reduced_radians value)
const F32.cos = func value => return f32_cos_reduced (f32_reduced_radians value)
const F32.sin_cos = func value => return do:
  let angle = f32_reduced_radians value
  break (f32_sin_reduced angle, f32_cos_reduced angle)

// Like division, tan is unbounded near odd multiples of pi/2.
const F32.tan = func value => return F32.div (F32.sin value) (F32.cos value)

const pi = 3.141592653589793
const tau = 6.283185307179586
const abs = func value => return value.abs
const min = func left => return func right => return case left < right of
  true => left
  false => right
const max = func left => return func right => return case left > right of
  true => left
  false => right
const clamp = func low => return func high => return func value => return min high (max low value)
const lerp = func left => return func right => return @type.call "lerp" left right
const square = func value => return value * value
const sqrt = F32.sqrt
const floor = F32.floor
const ceil = F32.ceil
const trunc = F32.trunc
const sin = F32.sin
const cos = F32.cos
const tan = F32.tan
const sin_cos = F32.sin_cos
const wrap = F32.wrap
const lerp_angle = F32.lerp_angle
const is_finite = F32.is_finite
const saturate = clamp 0.0 1.0
const smoothstep = func low => return func high => return func value => return do:
  let t = saturate ((value - low) / (high - low))
  break t * t * (3.0 - 2.0 * t)

const Maybe.pure = func value => return #Some value
const Maybe.map = func transform => return func candidate => return case candidate of
  #Some value => #Some (transform value)
  #Nothing => #Nothing
const Maybe.bind = func candidate => return func next => return case candidate of
  #Some value => next value
  #Nothing => #Nothing
// Finish each callback before advancing, so iteration uses constant stack.
const Maybe.iterate = func initial => return func step => return do:
  let state = initial
  for ever:
    use candidate <- step state
    if let #Some (#Done result) = candidate:
      break #Some result
    let #Some (#Continue next) = candidate else:
      break #Nothing
    state := next
const Maybe.unwrap_or = func fallback => return func candidate => return case candidate of
  #Some value => value
  #Nothing => fallback
const Maybe.is_some = func candidate => return case candidate of
  #Some _ => true
  #Nothing => false
const Maybe.filter = func predicate => return func candidate => return case candidate of
  #Some value => case predicate value of
    true => candidate
    false => #Nothing
  #Nothing => #Nothing
const Maybe.flatten = func candidate => return case candidate of
  #Some inner => inner
  #Nothing => #Nothing
const Maybe.unwrap_or_else = func ~fallback => return func candidate => return case candidate of
  #Some value => value
  #Nothing => @force fallback
const Maybe.to_result = func error => return func candidate => return case candidate of
  #Some value => #Ok value
  #Nothing => #Err error

const Result.pure = func value => return #Ok value
const Result.map = func transform => return func candidate => return case candidate of
  #Ok value => #Ok (transform value)
  #Err error => #Err error
const Result.map_error = func transform => return func candidate => return case candidate of
  #Ok value => #Ok value
  #Err error => #Err (transform error)
const Result.bind = func candidate => return func next => return case candidate of
  #Ok value => next value
  #Err error => #Err error
const Result.iterate = func initial => return func step => return do:
  let state = initial
  for ever:
    use candidate <- step state
    let (next, finished) = case candidate of
      #Ok (#Continue next) => (next, #Nothing)
      #Ok (#Done result) => (state, #Some (#Ok result))
      #Err error => (state, #Some (#Err error))
    if let #Some result = finished:
      break result
    state := next
const Result.unwrap_or = func fallback => return func candidate => return case candidate of
  #Ok value => value
  #Err _ => fallback
const Result.to_maybe = func candidate => return case candidate of
  #Ok value => #Some value
  #Err _ => #Nothing

const Array.length: Array a -> U32 = func values => return @array.length values
const Array.is_empty: Array a -> Bool = func values => return Array.length values == 0
const Array.get: Array a -> U32 -> Maybe a = func values => return func index => return do:
  if index < Array.length values:
    break #Some (@array.get values index)
  break #Nothing
const Array.set: Array a -> U32 -> a -> Maybe (Array a) = func values => return func index => return func value => return do:
  if index < Array.length values:
    break #Some (@array.set values index value)
  break #Nothing

// Ordinary source functions; the checked ~ parameter retains its demand mode.
const and = func (left: Bool) => return func ~(right: Bool) => return
  if left then @force right else false
const or = func (left: Bool) => return func ~(right: Bool) => return
  if left then true else @force right
