    var metadata_flags: bool[>..<] = [];
    var metadata_locals: Local[>..<] = [];
    var metadata_types: TypeArgument[>..<] = [];
    var metadata_evidence: TypeEvidence[>..<] = [];
    var metadata_callables: Callable[>..<] = [];
