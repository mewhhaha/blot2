// Captured computations are lazy and request handlers need no prelude data.
type Validate is effect = { check: U32 -> U32 }

const checked = func computation => return do:
  for request in @requests computation:
    case request of
      effect Validate.check value =>
        if value == 0:
          break 0
        yield value
      complete value =>
        break value

const addition = @computation (func () => return do:
  use left <- Validate.check 40
  use right <- Validate.check 2
  break left + right
)

entry const completed = func () => return checked addition

entry const cancelled = func () => return checked (@computation (func () => return do:
  use Validate.check 0
  break @panic "the handler returned before this statement"
))

// Rebindings carry handler state between requests. `break` runs the suffix.
const count_until_zero = func computation => return do:
  let count = 0
  for request in @requests computation:
    case request of
      effect Validate.check value =>
        if value == 0:
          break
        count := self + 1
        yield value
      complete _ =>
        break
  break count

entry const counted = func () => return count_until_zero (@computation (func () => return do:
  use Validate.check 40
  use Validate.check 2
  use Validate.check 0
  break @panic "the handler broke before this statement"
))
