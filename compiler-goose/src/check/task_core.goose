fn enclosing(module: const Module&, raw: u32, destination: u32, remaining: i64&, depth: i64) -> Error {
    let err = step(remaining, depth); if err != blot_error::Error.none { return err; } let node = module.types.node(raw);
    if blot_check_task_types::isGroup(module.types, raw) {
        for owner, id in module.nodes { let err = step(remaining, 0); if err != blot_error::Error.none { return err; } if owner.tag == blot_check_core::Tag.closure && blot_check_task_types::scopeCallback(module.types, owner.ty).present { let input = module.types.node(module.closures[owner.a].parameter.ty); if input.tag == blot_check_types::Tag.scoped && input.b == node.b && input.c == node.c { let found, err = inside(module, id as u32, destination, remaining, depth + 1); if err != blot_error::Error.none { return err; } if found { return blot_error::Error.none; } } } if owner.tag != blot_check_core::Tag.task || owner.c != blot_check_task_types::opCode(blot_check_task_types::Op.scope) { continue; } let callback = module.node(module.children(id as u32)[0]); if callback.tag != blot_check_core::Tag.closure { continue; } let input = module.types.node(module.closures[callback.a].parameter.ty); if input.tag == blot_check_types::Tag.scoped && input.b == node.b && input.c == node.c { let found, err = inside(module, id as u32, destination, remaining, depth + 1); if err != blot_error::Error.none { return err; } if found { return blot_error::Error.none; } } } return blot_error::Error.invalid_artifact;
    }
