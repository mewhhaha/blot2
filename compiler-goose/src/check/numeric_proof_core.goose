fn Checker::summaryApplied(self: Checker&, module: const Module&, inputs: SummaryInputs, id: u32, arguments: const Value[:], depth: i64) -> Value, Error {
    if id == 0 || depth >= 32 { return Value {}, Error.none; } if arguments.len == 0 { return self.summaryValue(module, inputs, id, depth); } let err = self.values.charge(1); if err != Error.none { return Value {}, err; } let node = module.node(id); if node.tag == Tag.block_ { return self.summaryBlock(module, inputs, id, arguments, depth); } if node.tag != Tag.closure { return Value {}, Error.none; } let metadata = module.closure(id); if metadata.parameter.binding == 0 || inputs.lookup(metadata.parameter.binding).present { return Value {}, Error.none; }
    for capture in module.extra[metadata.captures.start..metadata.captures.start + metadata.captures.len] { let err = self.values.charge(1); if err != Error.none { return Value {}, err; } if !inputs.lookup(capture).present { return Value {}, Error.none; } }
