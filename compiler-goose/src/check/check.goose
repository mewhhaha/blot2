fn Engine::unrestrictedAssociatedType(self:Engine&,root:u32,source:u32)->blot_error::Error {let usage,err=blot_check_usage_check::containsNominalWork(self.types,self.nominals,root,self.associated_usage_work);if err!=blot_error::Error.none {return err;}if usage {return self.diagnostic(Code.usage_evidence_mismatch,source);}return blot_error::Error.none;}
fn Engine::resolveImplementationMember(self:Engine&,ordinal:u32)->u32,blot_error::Error {
    let member=self.implementation_members[ordinal];if member.root!=0 {return member.root,blot_error::Error.none;}let index=self.implementationIndexForMember(ordinal);assert(index.present);let declaration=self.implementations[index.value];let source .= self.implementation_member_sources.get(ordinal);if !source {return 0,blot_error::Error.none;}let state .= self.implementation_member_states.get(ordinal);if state {if state==Engine_implementation_member_states_state.visiting {let err=self.diagnostic(Code.recursive_associated_type,source);if err!=blot_error::Error.none {return 0,err;}}return self.types.fresh();}
    self.implementation_member_states.insert(ordinal,Engine_implementation_member_states_state.visiting);let saved_types=self.type_env;let saved_rows=self.row_env;let saved_closed=self.closed_type_variables;let saved_implicit=self.implicit_row_parameters;let saved_defer=self.defer_associated;let saved_implementation=self.checking_implementation;
    self.type_env=TypeEnvironment{};self.row_env=RowEnvironment{};self.closed_type_variables=true;self.implicit_row_parameters=false;self.defer_associated=false;self.checking_implementation=blot_support::some(index.value);
    let root,err=resolveImplementationMemberBody(self,ordinal,member,declaration,source);self.type_env.deinit();self.row_env.deinit();self.type_env=saved_types;self.row_env=saved_rows;self.closed_type_variables=saved_closed;self.implicit_row_parameters=saved_implicit;self.defer_associated=saved_defer;self.checking_implementation=saved_implementation;return root,err;
