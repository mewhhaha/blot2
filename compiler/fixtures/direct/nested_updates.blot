type Brick is data = $Brick { from: U32, to: U32 }
type Access = { bricks: GrowArray Brick, count: Array U32 }
func shift (access: Access) -> (by: U32) => return do:
  let pinned = access
  for index in 0 .. pinned.bricks.length:
    let brick = pinned.bricks[index]
    brick.from := self + by
    pinned.bricks[index] := brick
  pinned.count[0] := 7
  return ()
entry func run (n: U32): U32 => return do:
  let bricks: GrowArray Brick = #[$Brick { from: 1, to: 2 }]
  let access = { bricks, count: #[0] }
  shift access n
  let $Brick { from, to } = access.bricks[0]
  break from * 100 + to + access.count[0]
