fn runWithSummaries(module:const Module&,function:const Function&,summaries:const Summaries&,shared:SharedScan?)->blot_support::Option<Output>,Error {let created,error=analyzeWithSummaries(module,function,summaries,shared);if error!=blot_error::Error.none {return blot_support::none<Output>(),error;}var plan=created;if plan.releases.len==0 {plan.deinit();return blot_support::none<Output>(),blot_error::Error.none;}var locals=MachineTypes{..};var code=Code{..};let error=emitLifetimeBody(module,function,plan,locals,code);plan.deinit();if error!=blot_error::Error.none {code.deinit();locals.deinit();return blot_support::none<Output>(),error;}let output,error=blot_backend_runtime_ir::cloneBody(locals.items,code.items);code.deinit();locals.deinit();return blot_support::some(output),error;}
fn emitLifetimeBody(module:const Module&,function:const Function&,plan:const Plan&,locals:MachineTypes&,code:Code&)->Error {let error=locals.append(module.locals(function));if error!=blot_error::Error.none {return error;}let original=blot_backend_wasm::instructions(module,function);let error=code.ensure(original.len+plan.releases.len);if error!=blot_error::Error.none {return error;}var condition:u32=absent;var next:i64=0;for inst,at in original {let start=next;while next<plan.releases.len && plan.releases.items[next].after==at {next+=1;}let releases=plan.releases.items[start..next];for release in releases {if release.edge==Edge.before {let error=emitRelease(code,module.arena.value.recycle,release.local);if error!=blot_error::Error.none {return error;}}}var conditional=false;for release in releases {if release.edge==Edge.when_true || release.edge==Edge.when_false {conditional=true;break;}}if conditional {if condition==absent {condition=(function.parameters.len+locals.len) as u32;let error=locals.push(blot_backend_runtime_ir::VT_i32);if error!=blot_error::Error.none {return error;}}let error=code.append([I(OP_local_tee,condition),I(OP_if_)]);if error!=blot_error::Error.none {return error;}for release in releases {if release.edge==Edge.when_true {let error=emitRelease(code,module.arena.value.recycle,release.local);if error!=blot_error::Error.none {return error;}}}let error=code.push(I(OP_else_));if error!=blot_error::Error.none {return error;}for release in releases {if release.edge==Edge.when_false {let error=emitRelease(code,module.arena.value.recycle,release.local);if error!=blot_error::Error.none {return error;}}}let error=code.append([I(OP_end),I(OP_local_get,condition)]);if error!=blot_error::Error.none {return error;}}let error=code.push(inst);if error!=blot_error::Error.none {return error;}for release in releases {if release.edge==Edge.after {let error=emitRelease(code,module.arena.value.recycle,release.local);if error!=blot_error::Error.none {return error;}}}}