// Target source design, not executable yet; see source-api.md.
// The game owns scene/editor policy. Local engine modules own reusable plumbing.
import * as ecs from "engine/ecs"
import { component, resource, Start, Event, Update, Render } from "engine/ecs"
import * as assets from "engine/assets"
import * as render from "engine/render"
import * as app from "./engine/app"
import { Frame, Title, Save, Load } from "./engine/app"
import { Io } from "./engine/platform"
import * as input from "./engine/input"
import * as keys from "./engine/keys"
import { Input, KeyPressed, FocusLost, PointerDown, PointerUp, PointerMoved, Primary, Secondary } from "./engine/input"
import * as camera from "./engine/camera"
import { OrbitCamera, OrbitControls } from "./engine/camera"
import * as spatial from "./engine/spatial"
import { Vec2, Vec3, Transform } from "./engine/spatial"
import * as boxes from "./engine/boxes"
import { Mesh } from "./engine/boxes"

#[component]
type Spin is data = Spin F32
#[component]
type Surface is data = Brass | Blue | Checker
type Mode is data = Play | Edit
#[resource]
type Editor is data = Editor {
  mode: Mode, selected: Maybe ecs.EntityId, grab_offset: Maybe Vec2,
}
type Action is data = ToggleMode | Place | Remove | Resize F32 | Rotate | CycleMaterial
  | SaveScene | LoadScene | NoAction

const camera_speed = 1.4
const spin_speed = 0.6
const ground_height = -1.4
const cube = assets.mesh "cube.mesh.json"
const brass = assets.material "brass.material.json"
const blue = assets.material "blue.material.json"
const checker = assets.material "checker.material.json"
const ground = assets.material "ground.material.json"
const highlight = assets.material "highlight.material.json"

const material = fn surface => case surface of
  Brass => brass
  Blue => blue
  Checker => checker

const key_action = fn code => case code of
  ^keys.tab => ToggleMode
  ^keys.p => Place
  ^keys.x => Remove
  ^keys.equals => Resize 1.1
  ^keys.plus => Resize 1.1
  ^keys.minus => Resize 0.9
  ^keys.r => Rotate
  ^keys.m => CycleMaterial
  ^keys.f6 => SaveScene
  ^keys.f9 => LoadScene
  _ => NoAction

const spawn_box = fn transform => fn spin => fn surface => do:
  use entity <- ecs.spawn ()
  use ecs.at entity $ fn () => do:
    use ecs.insert transform
    use ecs.insert $ Spin spin
    use ecs.insert surface
    use ecs.insert $ Mesh { geometry: cube, material: material surface }
  return entity

const seed_scene = fn () => do:
  use spawn_box (Transform {
    position: Vec3 { x: -1.4, y: -0.4, z: 0.0 }, scale: spatial.one, yaw: 0.0,
  }) 1.0 Brass
  use spawn_box (Transform {
    position: Vec3 { x: 1.4, y: -0.1, z: 0.0 },
    scale: Vec3 { x: 0.7, y: 1.3, z: 0.7 }, yaw: 0.6,
  }) (-1.0) Blue

const resize = fn factor => fn () => do:
  use transform <- ecs.get Transform
  let next = transform
  next.scale.x := F32.clamp 0.1 4.0 (self * factor)
  next.scale.y := F32.clamp 0.1 4.0 (self * factor)
  next.scale.z := F32.clamp 0.1 4.0 (self * factor)
  use ecs.set next

const rotate = fn () => do:
  use transform <- ecs.get Transform
  let next = transform
  next.yaw := spatial.wrap_angle (self + 0.2617993878)
  use ecs.set next

const cycle_material = fn () => do:
  use surface <- ecs.get Surface
  let next = case surface of
    Brass => Blue
    Blue => Checker
    Checker => Brass
  use ecs.set next
  use ecs.set $ Mesh { geometry: cube, material: material next }

// Match independent conditions together; entity effects remain explicitly scoped.
const apply_action = fn action => fn editor => fn ground_point =>
  case action, editor.mode, editor.selected, ground_point of
    SaveScene, _, _, _ => ecs.set Save
    LoadScene, _, _, _ => ecs.set Load
    ToggleMode, mode, _, _ => do:
      let next = editor
      next.mode := case mode of
        Play => Edit
        Edit => Play
      next.grab_offset := Nothing
      use ecs.set next
      return ()
    Place, Edit, _, Some point => do:
      use entity <- spawn_box (Transform {
        position: Vec3 { x: point.x, y: -0.65, z: point.z },
        scale: Vec3 { x: 0.75, y: 0.75, z: 0.75 }, yaw: 0.0,
      }) 1.0 Checker
      let next = editor
      next.selected := Some entity
      next.grab_offset := Nothing
      use ecs.set next
      return ()
    Remove, Edit, Some entity, _ => do:
      use ecs.despawn entity
      let next = editor
      next.selected := Nothing
      next.grab_offset := Nothing
      use ecs.set next
      return ()
    Resize factor, Edit, Some entity, _ => ecs.at entity (resize factor)
    Rotate, Edit, Some entity, _ => ecs.at entity rotate
    CycleMaterial, Edit, Some entity, _ => ecs.at entity cycle_material
    _, _, _, _ => ()

const select = fn controls => fn editor => fn ground_point => do:
  let next = editor
  next.selected := controls.picked
  use grab_offset <- case controls.picked, ground_point of
    Some entity, Some point => do:
      use transform <- ecs.at entity (fn () => ecs.get Transform)
      return Some (Vec2 {
        x: transform.position.x - point.x,
        y: transform.position.z - point.z,
      })
    _, _ => Nothing
  next.grab_offset := grab_offset
  use ecs.set next

const drag = fn point => fn grab => fn () => do:
  use transform <- ecs.get Transform
  let next = transform
  next.position.x := point.x + grab.x
  next.position.z := point.z + grab.y
  use ecs.set next

const edit_scene = fn () => do:
  use controls <- ecs.get Input
  use editor <- ecs.get Editor
  use orbit <- ecs.get OrbitCamera
  let point = camera.ground_point orbit controls.viewport controls.pointer ground_height
  let released = editor
  released.grab_offset := Nothing
  return case controls.event, editor.mode, editor.selected, editor.grab_offset of
    FocusLost, _, _, _ => ecs.set released
    PointerDown Secondary, _, _, _ => ecs.set released
    PointerUp Primary, _, _, _ => ecs.set released
    PointerDown Primary, Edit, _, _ => select controls editor point
    PointerMoved, Edit, Some entity, Some grab => do:
      let Some hit = point else:
        return ()
      use ecs.at entity (drag hit grab)
      return ()
    KeyPressed code, _, _, _ => apply_action (key_action code) editor point
    _, _, _, _ => ()

// Editing freezes animation so dragging and inspection stay predictable.
const animate = fn () => do:
  use editor <- ecs.get Editor
  let Play = editor.mode else:
    return ()
  use frame_value <- ecs.get Frame
  use spin_value <- ecs.get Spin
  use transform <- ecs.get Transform
  let Frame frame = frame_value
  let Spin spin = spin_value
  let next = transform
  next.yaw := spatial.wrap_angle (self + spin * spin_speed * frame.seconds)
  use ecs.set next

const draw_scene = fn () => do:
  use render.clear [0.065, 0.08, 0.105, 1.0]
  use render.ambient [0.3, 0.3, 0.34]
  use render.light_direction [-0.5, -1.0, -0.35]
  use render.light_color [0.85, 0.81, 0.72]
  use boxes.draw (Mesh { geometry: cube, material: ground }) (Transform {
    position: Vec3 { x: 0.0, y: ground_height - 0.1, z: 0.0 },
    scale: Vec3 { x: 5.0, y: 0.1, z: 4.0 }, yaw: 0.0,
  }) Nothing

const draw_selection = fn () => do:
  use editor <- ecs.get Editor
  return case editor.mode, editor.selected of
    Edit, Some entity => do:
      use ecs.at entity $ fn () => do:
        use transform <- boxes.interpolated ()
        use boxes.outline (Mesh { geometry: cube, material: highlight }) transform entity
    _, _ => ()

const describe_mode = fn () => do:
  use editor <- ecs.get Editor
  let title = case editor.mode of
    Play => "Blot — PLAY"
    Edit => "Blot — EDIT"
  use ecs.set $ Title title

// Ordinary const-time source composition; no compiler-known plugins or stages.
// Resource defaults run only on creation, never implicitly during live reload.
const sandbox = do:
  let application = app.new "Blot — PLAY"
  application := input.plugin self
  application := camera.plugin
    (OrbitCamera { yaw: 0.4, pitch: 0.45, distance: 8.0 })
    (OrbitControls {
      left: keys.left, right: keys.right, inward: keys.up, outward: keys.down,
      speed: camera_speed,
    }) self
  application := app.insert_resource (Editor {
    mode: Play, selected: Nothing, grab_offset: Nothing,
  }) self
  application := app.add_system Start seed_scene self
  application := app.add_system Event edit_scene self
  application := app.add_system Update animate self
  application := app.add_system Render draw_scene self
  application := app.add_system Render boxes.draw_mesh self
  application := app.add_system Render draw_selection self
  application := app.add_system Render describe_mode self
  return app.build application

const main = fn (io: Io) => app.bind sandbox io
