struct BranchBodies {then_body: u32,otherwise: u32}
fn branchBodies(module: const Module&,id: u32) -> blot_support::Option<BranchBodies> {let node = module.node(id);if node.tag == blot_check_core::Tag.if_stmt {return blot_support::some(BranchBodies {then_body: node.b,otherwise: node.c});}if node.tag != blot_check_core::Tag.match_ || !module.matchInfo(id).statement {return blot_support::none<BranchBodies>();}let arms = module.matchArms(id);if arms.len != 2 || arms[0].guard_ != 0 || arms[1].guard_ != 0 {return blot_support::none<BranchBodies>();}return blot_support::some(BranchBodies {then_body: arms[0].body,otherwise: arms[1].body});}
recursive fn consumedInside(module: const Module&,root: u32,consumer: u32,depth: i64) -> bool {if root == 0 || consumer == 0 || depth >= 64 {return false;}if root == consumer {return true;}let node = module.node(root);match node.tag {block_,suite=>{for child in module.children(root) {if consumedInside(module,child,consumer,depth + 1) {return true;}}return false;},bind=>{return consumedInside(module,node.b,consumer,depth + 1);},return_=>{return consumedInside(module,node.a,consumer,depth + 1);},loop_=>{return consumedInside(module,module.loopInfo(root).body,consumer,depth + 1);},if_stmt,match_=>{let branch = branchBodies(module,root);return branch.present && (consumedInside(module,branch.value.then_body,consumer,depth + 1) || consumedInside(module,branch.value.otherwise,consumer,depth + 1));},_=>{return false;},}}
recursive fn withinBudget(module: const Module&,root: u32,consumer: u32,budget: i64&,depth: i64) -> bool {if root == 0 || consumer == 0 || depth >= 64 || budget == 0 {return false;}budget--;if root == consumer {return true;}let node = module.node(root);match node.tag {block_,suite=>{for child in module.children(root) {if withinBudget(module,child,consumer,budget,depth + 1) {return true;}}return false;},bind=>{return withinBudget(module,node.b,consumer,budget,depth + 1);},return_=>{return withinBudget(module,node.a,consumer,budget,depth + 1);},loop_=>{return withinBudget(module,module.loopInfo(root).body,consumer,budget,depth + 1);},if_stmt,match_=>{let branch = branchBodies(module,root);return branch.present && (withinBudget(module,branch.value.then_body,consumer,budget,depth + 1) || withinBudget(module,branch.value.otherwise,consumer,budget,depth + 1));},_=>{return false;},}}
fn exclusiveConsumers(module: const Module&,first: u32,second: u32,budget: i64&) -> bool {if first == 0 || second == 0 || first == second {return false;}for node,index in module.nodes {if budget == 0 {return false;}budget--;let branch = branchBodies(module,index as u32);if !branch.present {continue;}if (withinBudget(module,branch.value.then_body,first,budget,0) && withinBudget(module,branch.value.otherwise,second,budget,0)) || (withinBudget(module,branch.value.otherwise,first,budget,0) && withinBudget(module,branch.value.then_body,second,budget,0)) {return true;}}return false;}
fn excludesLater(module: const Module&,exit_id: u32,consumer: u32) -> bool {if consumer <= exit_id {return false;}let exit = module.node(exit_id);var target = exit.b;if exit.tag == blot_check_core::Tag.break_ {target = module.loopInfo(exit.a).body;}return consumedInside(module,target,consumer,0);}
fn receiver(units: const Module[:],unit: u32,id: u32) -> blot_support::Option<u32> {
    let module: const Module& = units[unit - 1];let tag = module.node(id).tag;var root: u32 = 0;
    if tag == blot_check_core::Tag.array_op {let op = module.arrayOperation(id);if op != blot_backend_collection_ops::Op.set && op != blot_backend_collection_ops::Op.append && op != blot_backend_collection_ops::Op.prepend && op != blot_backend_collection_ops::Op.simd_store {return blot_support::none<u32>();}root = module.children(id)[0];}
    else if tag == blot_check_core::Tag.call || tag == blot_check_core::Tag.apply {let plan = blot_backend_collection_edit_call::analyze(units,unit,id);if !plan.present {return blot_support::none<u32>();}root = plan.value.receiver;}else {root = module.updateInfo(id).root;}
    if module.node(root).tag != blot_check_core::Tag.reference {return blot_support::none<u32>();}let reference = module.reference(root);if reference.unit != 0 || reference.binding == 0 || module.binding(reference.binding).kind != blot_reuse_principal_interface::Kind.local {return blot_support::none<u32>();}return blot_support::some(reference.binding);
}
recursive fn fresh(units: const Module[:],unit: u32,id: u32,depth: i64) -> bool {
    if blot_backend_identity_array::analyze(units,unit,id).present || depth >= 32 {return false;}let module: const Module& = units[unit - 1];let node = module.node(id);
    match node.tag {
        array,record,product,construct=>{return true;},
        block_=>{let statements = module.children(id);if statements.len == 0 {return false;}for statement in statements[..statements.len - 1] {if module.node(statement).tag != blot_check_core::Tag.bind {return false;}}let result = module.node(statements[statements.len - 1]);return result.tag == blot_check_core::Tag.return_ && fresh(units,unit,result.a,depth + 1);},
        array_op=>{match module.arrayOperation(id) {fill,generate,set,append,prepend,convert,simd_store=>{return true;},slice,concat=>{return module.types.node(node.ty).tag == blot_check_types::Tag.array;},_=>{return false;},}},
        update=>{return true;},
        call=>{if blot_backend_collection_edit_call::analyze(units,unit,id).present {return true;}let call = module.call(id);var target_unit = call.target.unit;if target_unit == 0 {target_unit = unit;}let target: const Module& = units[target_unit - 1];let body .= target.body(call.target.binding);if !body || !body.is_function || target.bodyParameters(body).len != call.arguments.len {return false;}let root = target.node(body.root);if root.tag != blot_check_core::Tag.array && root.tag != blot_check_core::Tag.array_op && root.tag != blot_check_core::Tag.call {return false;}return fresh(units,target_unit,body.root,depth + 1);},_=>{return false;},
    }
}
fn scalarType(module: const Module&,ty: u32) -> bool {let tag = module.types.node(ty).tag;return tag == blot_check_types::Tag.unit || tag == blot_check_types::Tag.boolean || tag == blot_check_types::Tag.unsigned32 || tag == blot_check_types::Tag.floating32;}
fn scalarElements(module: const Module&,collection: u32) -> bool {let ty = module.types.node(collection);return (ty.tag == blot_check_types::Tag.array || ty.tag == blot_check_types::Tag.list) && scalarType(module,ty.a);}
recursive fn freshTree(units: const Module[:],unit: u32,id: u32,depth: i64) -> bool {if depth >= 32 {return false;}let module: const Module& = units[unit - 1];let node = module.node(id);if scalarType(module,node.ty) {return true;}match node.tag {construct=>{return node.b == 0 || freshTree(units,unit,node.b,depth + 1);},record,product,array=>{for child in module.children(id) {if !freshTree(units,unit,child,depth + 1) {return false;}}return true;},array_op,call=>{let ty = module.types.node(node.ty);return (ty.tag == blot_check_types::Tag.array || ty.tag == blot_check_types::Tag.list) && scalarType(module,ty.a) && fresh(units,unit,id,depth + 1);},_=>{return false;},}}
