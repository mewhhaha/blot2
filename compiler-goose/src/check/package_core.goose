fn Walker::containsUsage(self:Walker&,root:u32)->bool,Error {let cache .= self.context.source_proofs;if cache {let result,error=cache.containsUsage(self.module,root,self.scopes.remaining);if error!=Error.none {let workspace .= self.admission.workspace;if error==Error.out_of_memory && workspace {workspace.oom=true;}return false,Error.invalid_artifact;}return result,Error.none;}var work=blot_check_usage_check::Work{remaining:self.scopes.remaining};let result,error=blot_check_usage_check::containsNominalWork(self.module.types,self.module.nominals,root,work);self.scopes.remaining=work.remaining;if error!=Error.none {return false,Error.invalid_artifact;}return result,Error.none;}
