fn patternRecordPayload(self:Builder&,source:u32,record:blot_check_types::Node,child_type:u32,child:blot_check_types::Node,payload:u32,fields:WordBuffer&)->u32,Error {for index in 0..record.b {let field=self.source.checked.types.recordField(record,index);var ty=child_type;if record.b!=1 {ty=self.tables.type_extra[child.a+index];}let error=fields.append(field.name);if error!=Error.none {return 0,error;}let error=fields.append(ty);if error!=Error.none {return 0,error;}}let range,error=self.saveTypes(fields.items);if error!=Error.none {return 0,error;}let record_type,error=self.addType(blot_check_types::Node{tag:blot_check_types::Tag.record,a:range.start,b:record.b, ..});if error!=Error.none {return 0,error;}return self.addPattern(source,blot_check_core::Pattern{tag:blot_check_core::PatternTag.record_payload,ty:record_type,a:record.b,b:payload, ..});}
fn patternProduct(self:Builder&,source:u32,ty:u32,depth:i64,children:WordBuffer&)->u32,Error {for child in self.source.tree.children(source) {let pattern,error=self.patternNode(child,depth+1);if error!=Error.none {return 0,error;}let error=children.append(pattern);if error!=Error.none {return 0,error;}}let range,error=self.save(children.items);if error!=Error.none {return 0,error;}return self.addPattern(source,blot_check_core::Pattern{tag:blot_check_core::PatternTag.product,ty:ty,a:range.start,b:range.len, ..});}
