fn deinit(self_:Owner&) {
 if self_.lease==0 {return;}assert(valid(self_));let owner=self_.lease-1;assert(leases[owner].references!=0);leases[owner].references-=1;
 if leases[owner].references!=0 {self_=Owner{..};return;}
