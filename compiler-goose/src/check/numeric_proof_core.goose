            if module.node(leaf).tag == Tag.associated { let method = module.node(leaf); let err = self.values.charge(arguments.len + 2); if err != Error.none { return Value {}, err; } var actual: Value[>..<]; for operand in [method.a, method.b] { let value, err = self.walk(operand, depth + 1); if err != Error.none { return Value {}, err; } actual.append(value); } for argument in arguments { let value, err = self.walk(argument, depth + 1); if err != Error.none { return Value {}, err; } actual.append(value); } for value in actual { let err = ordinary(value); if err != Error.none { return Value {}, err; } } for selected in self.selected { let err = self.values.charge(1); if err != Error.none { return Value {}, err; } if selected.node == leaf { return self.summaryCall(selected.target, actual, 0); } } return Value {}, Error.none; }
