//! Small 2D and 3D geometry vectors ([`Vec2`], [`Vec3`]).
//!
//! Import the types directly; arithmetic operators (`+`, `-`, `*`, `/`) follow
//! their owning type automatically.
//!
//! ```squid
//! let a = $Vec2 { x: 3.0, y: 4.0 }
//! a.length // => 5.0
//! ```

// Two-dimensional `F32` vector with componentwise `+`, `-`, scalar `*`/`/`,
// [`Vec2.dot`], [`Vec2.lerp`], [`Vec2.length`], and [`Vec2.normalized`].
type Vec2 is data = $Vec2 { x: F32, y: F32 }

// Three-dimensional `F32` vector with [`Vec3.dot`], [`Vec3.cross`],
// [`Vec3.length`], and [`Vec3.normalized`].
type Vec3 is data = $Vec3 { x: F32, y: F32, z: F32 }

func Vec2.add (a: Vec2) -> (b: Vec2): Vec2 => return
  $Vec2 { x: a.x + b.x, y: a.y + b.y }
func Vec2.sub (a: Vec2) -> (b: Vec2): Vec2 => return
  $Vec2 { x: a.x - b.x, y: a.y - b.y }
func Vec2.mul (value: Vec2) -> (scale: F32): Vec2 => return
  $Vec2 { x: value.x * scale, y: value.y * scale }
func Vec2.div (value: Vec2) -> (scale: F32): Vec2 => return
  $Vec2 { x: value.x / scale, y: value.y / scale }
func Vec2.lerp (a: Vec2) -> (b: Vec2) -> (weight: F32): Vec2 => return
  $Vec2 { x: F32.lerp a.x b.x weight, y: F32.lerp a.y b.y weight }
// Dot product of two [`Vec2`] values.
//
// ```squid
// let a = $Vec2 { x: 2.0, y: 3.0 }
// let b = $Vec2 { x: 4.0, y: 5.0 }
// a.dot b // => 23.0
// ```
func Vec2.dot (a: Vec2) -> (b: Vec2): F32 => a.x * b.x + a.y * b.y
func Vec2.length_squared (value: Vec2): F32 => Vec2.dot value value
func Vec2.length (value: Vec2): F32 => sqrt (Vec2.length_squared value)
// Zero normalizes to zero. Finite nonzero inputs scale before squaring to avoid overflow and underflow.
func Vec2.normalized (value: Vec2): Vec2 =>
  if not (F32.is_finite value.x) or not (F32.is_finite value.y):
    let length = Vec2.length value
    return if length == 0.0 then value else value / length
  let scale = F32.max (F32.abs value.x) (F32.abs value.y)
  if scale == 0.0:
    return value
  let sx = value.x / scale
  let sy = value.y / scale
  let length = sqrt (sx * sx + sy * sy)
  return $Vec2 { x: sx / length, y: sy / length }

func Vec3.add (a: Vec3) -> (b: Vec3): Vec3 => return
  $Vec3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
func Vec3.sub (a: Vec3) -> (b: Vec3): Vec3 => return
  $Vec3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }
func Vec3.mul (value: Vec3) -> (scale: F32): Vec3 => return
  $Vec3 { x: value.x * scale, y: value.y * scale, z: value.z * scale }
func Vec3.div (value: Vec3) -> (scale: F32): Vec3 => return
  $Vec3 { x: value.x / scale, y: value.y / scale, z: value.z / scale }
func Vec3.lerp (a: Vec3) -> (b: Vec3) -> (weight: F32): Vec3 => return
  $Vec3 { x: F32.lerp a.x b.x weight, y: F32.lerp a.y b.y weight, z: F32.lerp a.z b.z weight }
func Vec3.dot (a: Vec3) -> (b: Vec3): F32 => a.x * b.x + a.y * b.y + a.z * b.z
func Vec3.cross (a: Vec3) -> (b: Vec3): Vec3 => $Vec3 {
  x: a.y * b.z - a.z * b.y,
  y: a.z * b.x - a.x * b.z,
  z: a.x * b.y - a.y * b.x,
}
func Vec3.length_squared (value: Vec3): F32 => Vec3.dot value value
func Vec3.length (value: Vec3): F32 => sqrt (Vec3.length_squared value)
func Vec3.normalized (value: Vec3): Vec3 =>
  if not (F32.is_finite value.x) or not (F32.is_finite value.y) or not (F32.is_finite value.z):
    let length = Vec3.length value
    return if length == 0.0 then value else value / length
  let scale = F32.max (F32.max (F32.abs value.x) (F32.abs value.y)) (F32.abs value.z)
  if scale == 0.0:
    return value
  let sx = value.x / scale
  let sy = value.y / scale
  let sz = value.z / scale
  let length = sqrt (sx * sx + sy * sy + sz * sz)
  return $Vec3 { x: sx / length, y: sy / length, z: sz / length }
