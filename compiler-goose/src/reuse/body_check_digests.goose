fn operationDigest(source: Source,catalog: Catalog,index: i64) -> blot_support::Option<Digest> { var budget: i64=4096; return operationDigestAt(source,catalog,index,0,budget); }
fn operationDigestAt(source: Source,catalog: Catalog,index: i64,depth: i64,budget: i64&) -> blot_support::Option<Digest> {
 if depth>=128||budget==0||index>=catalog.effect_templates.len { return blot_support::none<Digest>(); } budget--; let operation_=catalog.effect_templates[index]; if operation_.family>=catalog.effect_families.len { return blot_support::none<Digest>(); } let family=catalog.effect_families[operation_.family]; if family.name==0||operation_.name==0||family.operations.len==0||family.parameters.len!=family.patterns.len { return blot_support::none<Digest>(); }
 var hash=blot_support_blake3::init(); hashWord(hash,0x45524601 as u32); let origin=catalog.unitOrigin(family.identity.unit); if !origin.present { return blot_support::none<Digest>(); } hash.update(origin.value); for symbol in [family.name,operation_.name] { let name=catalog.pool.get(symbol); hashWord(hash,name.len); hash.update(name); } hashWord(hash,digestBit(family.private)); hashWord(hash,digestBit(family.callable)); let variables=source.list(family.variables); hashWord(hash,family.variables.len); hashWord(hash,family.parameters.len);
 for parameter in source.list(family.parameters) { if !typeHash(source,parameter,hash,budget,depth+1,false,variables,[],catalog) { return blot_support::none<Digest>(); } } if family.patterns.len!=0 { if !catalog.patterns.present { return blot_support::none<Digest>(); } let patterns=catalog.patterns.value; for pattern in patterns.list(family.patterns) { if !patternHash(source,patterns,pattern,variables,catalog,hash,depth+1,budget) { return blot_support::none<Digest>(); } } }
 hashWord(hash,family.operations.len); var selected=false; for member in source.list(family.operations) { if budget==0||member>=catalog.effect_templates.len { return blot_support::none<Digest>(); } budget--; let template=catalog.effect_templates[member]; if template.family!=operation_.family||template.identity.unit!=family.identity.unit { return blot_support::none<Digest>(); } selected=selected||member==index; let name=catalog.pool.get(template.name); if name.len==0 { return blot_support::none<Digest>(); } hashWord(hash,name.len); hash.update(name); if !typeHash(source,template.parameter,hash,budget,depth+1,false,variables,[],catalog)||!typeHash(source,template.result,hash,budget,depth+1,false,variables,[],catalog) { return blot_support::none<Digest>(); } } if !selected { return blot_support::none<Digest>(); } return blot_support::some(blot_support_blake3::final(hash));
}
fn familyDigest(source: Source,catalog: Catalog,index: i64) -> blot_support::Option<Digest> { var budget: i64=4096; return familyDigestAt(source,catalog,index,0,budget); }
fn familyDigestAt(source: Source,catalog: Catalog,index: i64,depth: i64,budget: i64&) -> blot_support::Option<Digest> { if index>=catalog.effect_families.len { return blot_support::none<Digest>(); } let family=catalog.effect_families[index]; if family.operations.len==0 { return blot_support::none<Digest>(); } let member=source.list(family.operations)[0]; let recipe=operationDigestAt(source,catalog,member,depth,budget); if !recipe.present { return blot_support::none<Digest>(); } var hash=blot_support_blake3::init(); hashWord(hash,blot_parse_ast::tag_effect_type_decl); hash.update(recipe.value); return blot_support::some(blot_support_blake3::final(hash)); }
fn effectAnnotationDigest(source: Source,catalog: Catalog,tree: const Tree&,id: u32) -> blot_support::Option<Digest> {
