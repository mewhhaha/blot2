recursive fn givenInvocation(self_:Walker&,producer:const Module&,binding:u32,mapping:Principal&,depth:i64)->bool,Error {let declaration=producer.binding(binding);for caller_scheme in self_.scopes.schemes[..self_.scopes.scheme_count] {let goals,error=self_.scopes.schemeGoals(caller_scheme);if error!=blot_error::Error.none {return false,error;}for given in goals {if given.kind!=blot_check_types::ObligationKind.callee_use {continue;}if given.other!=0 || given.result!=0 || given.signature!=0 || given.name!=0 || given.operator!=blot_check_types::Operator.none {return false,blot_error::Error.invalid_artifact;}var reference=blot_check_core::BindingRef{unit:given.identity.unit,binding:given.identity.decl, ..};var steps:i64=0;loop {let error=self_.step(depth+steps);if error!=blot_error::Error.none {return false,error;}let selected,error=self_.target(reference);if error!=blot_error::Error.none {return false,error;}if !selected {return false,blot_error::Error.invalid_artifact;}let owner .= selected;if reference.binding==0 || reference.binding>=owner.bindings.len {return false,blot_error::Error.invalid_artifact;}let source=owner.binding(reference.binding);if source.kind!=blot_reuse_principal_interface::Kind.external {reference.unit=owner.unit;break;}reference=source.target;if reference.unit==0 {reference.unit=owner.unit;}steps+=1;}if reference.unit!=producer.unit || reference.binding!=binding {continue;}let identity,error=self_.canonicalCallee(given.identity,self_.module.types,given.ty);if error!=blot_error::Error.none {return false,error;}let pack=self_.module.types.node(given.ty);if pack.tag!=blot_check_types::Tag.product || pack.b!=declaration.public_variables.len+declaration.public_rows.len {return false,blot_error::Error.invalid_artifact;}var proof=mapping;if proof.publicArguments(declaration.public_variables,declaration.public_rows,self_.module.types.list(List{start:pack.a,len:pack.b, ..}))!=blot_error::Error.none {continue;}return true,blot_error::Error.none;}}return fa