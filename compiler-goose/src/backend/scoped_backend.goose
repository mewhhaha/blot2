fn compileWithOptions(workspace: blot_backend_core_backend::CompileWorkspace&,units: const blot_check_core::Module[:],entry: u32,options: CompileOptions) -> blot_backend_core_backend::Result,Error {
    let space = blot_phase_profile::enterSpace(blot_phase_profile::Space.core); var views: blot_check_frozen_core_validation::ModuleRef[>..] = []; for &module in units { views.push(blot_check_frozen_core_validation::ModuleRef { value: module,..}); }
    recursive fn compileModule() -> blot_backend_core_backend::Result,Error {
        if blot_phase_profile::currentTrace() != null && options.identity.present { for module in units { let path = options.identity.value.owner(module.unit); if path.present { blot_phase_profile::traceModule(module.unit,path.value,0); } } } if options.work_limits.expressions == 0 { return scopedFailure(workspace,entry,"Scoped emission requires a positive expression allowance"),blot_error::Error.none; }
        var reused_core: i64 = 0; var bounds_failed = false; let validation_trace = blot_phase_profile::region("owned.validate-core",entry,0,0);
        recursive fn validate() -> Error { let context = blot_check_frozen_core_validation::Context { units: views[..],..}; for &module in units { let error = blot_check_frozen_core_validation::validateBounds(module,context); if error != blot_error::Error.none { bounds_failed = true; return blot_error::Error.invalid_artifact; } } let completed = options.completed_core_validation; if completed && options.identity.present { reused_core = completed.prefix(units,entry,options.identity.value); } blot_phase_profile::detail("owned.validate.reused",entry,0,0,reused_core as u64); for &module,index in units { if index < reused_core { continue; } let error = blot_check_frozen_core_validation::validate(module,context); if error != blot_error::Error.none { return error; } } return blot_error::Error.none; }
        let validation_error = validate(); validation_trace.exit(); if validation_error != blot_error::Error.none { if validation_error == blot_error::Error.out_of_memory { return blot_backend_core_backend::emptyResult(workspace),validation_error; } var detail: const u8[:] = "Invalid scoped-storage Core evidence"; if bounds_failed { detail = "Invalid scoped-storage Core bounds"; } return scopedFailure(workspace,entry,detail),blot_error::Error.none; }
        workspace.generator.module.reset();
        recursive fn withModule() -> blot_backend_core_backend::Result,Error {
            let runtime_trace = blot_phase_profile::region("owned.runtime-generation",entry,0,0); let runtime,runtime_error = blot_runtime_data_stacks::emit(workspace.generator.module); runtime_trace.exit(); if runtime_error != blot_error::Error.none { if runtime_error == blot_error::Error.out_of_memory { return blot_backend_core_backend::emptyResult(workspace),runtime_error; } abort("invalid data-stack runtime construction"); }
            var proof_cache,proof_error = blot_check_package_core::initModulesWithInventoryBudget(units); if proof_error != blot_error::Error.none { if proof_error == blot_error::Error.out_of_memory { return blot_backend_core_backend::emptyResult(workspace),proof_error; } return scopedFailure(workspace,entry,"Invalid source proof context"),blot_error::Error.none; } let result,error = compileScoped(workspace,units,entry,options,reused_core,proof_cache,runtime); proof_cache.deinit(); return result,error;
        } let result,error = withModule(); workspace.generator.module.reset(); return result,error;
    }
    let result,error = compileModule(); space.restore(); return result,error;
}
