struct Context { session: const blot_eval_core_eval::Session& }
fn encode(context: Context&,component: Component) -> u8[>..],Error { var bytes: u8[>..]=[]; var writer=Writer {bytes}; blot_eval_worker_packet::put(writer,0x53434351 as u32); blot_eval_worker_packet::put(writer,1 as u32); blot_eval_worker_packet::writeCatalog(writer,context.session.units); blot_eval_worker_packet::writeEvidence(writer,context.session.evidenceView()); blot_eval_worker_packet::put(writer,context.session.options); blot_eval_worker_packet::put(writer,context.session.depth); blot_eval_worker_packet::put(writer,context.session.timing!=null); var stage: u8=0; match context.session.inference_stage { general=>{},specialization=>{ stage=1; },preparation=>{ stage=2; },lowering=>{ stage=3; }, } blot_eval_worker_packet::put(writer,stage); blot_eval_worker_packet::put(writer,component.budget); blot_eval_worker_packet::writeSeeds(writer,context.session); blot_eval_worker_packet::count(writer,component.members.len); for member in component.members { blot_eval_worker_packet::put(writer,member); } blot_eval_worker_packet::count(writer,component.edges.len); for edge in component.edges { blot_eval_worker_packet::put(writer,edge); }
 var originals: u32[>..<]=[]; for member in component.members { let original=member.key.lexical; if original==0 { continue; } var present=false; for prior in originals { if prior==original { present=true; break; } } if !present { originals.push(original); } } blot_eval_worker_packet::count(writer,originals.len); for original in originals { if original>context.session.specializations.lexical_inputs.inputs.len { return bytes,Error.invalid_artifact; } blot_eval_worker_packet::put(writer,original); writeInput(writer,context.session.specializations.lexical_inputs.inputs.items[original-1]); } return bytes,writer.failure;
}
struct Request { catalog: blot_eval_worker_packet::Catalog=blot_eval_worker_packet::Catalog {},evidence: blot_evidence_packet::OwnedSnapshot,options: blot_eval_core_eval::Options=blot_eval_core_eval::Options {},depth: i64=0,timing: bool=false,stage: u8=0,budget: i64=0,seeds: blot_eval_worker_packet::ScalarSeed[:]=[],component: Component=Component {[],[]},lexical: Lexical[:]=[],reply: u8[>..]& }
fn release(context: Request&) { context.catalog.deinit(); context.evidence.deinit(); blot_eval_worker_packet::scalar_seeds.free_slice(context.seeds); context.component.deinit(); for &input in context.lexical { input.input.deinit(); } lexical_inputs.free_slice(context.lexical); }
fn readRequest(reader: Reader&,context: Request&) -> Error { var signature: u32=0; var version: u32=0; blot_eval_worker_packet::get(reader,signature); blot_eval_worker_packet::get(reader,version); if reader.failure!=Error.none||signature!=0x53434351||version!=1 { return Error.invalid_artifact; } context.catalog=blot_eval_worker_packet::readCatalog(reader); if reader.failure!=Error.none { return reader.failure; } context.evidence=blot_eval_worker_packet::readEvidence(reader); if reader.failure!=Error.none { return reader.failure; } blot_eval_worker_packet::get(reader,context.options); blot_eval_worker_packet::get(reader,context.depth); blot_eval_worker_packet::get(reader,context.timing); blot_eval_worker_packet::get(reader,context.stage); blot_eval_worker_packet::get(reader,context.budget); context.seeds=blot_eval_worker_packet::readSeeds(reader); if reader.failure!=Error.none { return reader.failure; } let member_count=blot_eval_worker_packet::count(reader,16); if reader.failure!=Error.none { return reader.failure; } context.component.members=members.alloc_slice(member_count); for &member in context.component.members { blot_eval_worker_packet::get(reader,member); } let edge_count=blot_eval_worker_packet::count(reader,8); if reader.failure!=Error.none { return reader.failure; } context.component.edges=edges.alloc_slice(edge_count); for &edge in context.component.edges { blot_eval_worker_packet::get(reader,edge); if edge.from>=member_count||edge.to>=member_count { reader.failure=Error.invalid_artifact; } } let lexical_count=blot_eval_worker_packet::count(reader,4); if reader.failure!=Error.none { return reader.failure; } context.lexical=lexical_inputs.alloc_slice(lexical_count); for &lexical in context.lexical { lexical=Lexical {0,default<blot_eval_lexical_capture_inputs::Inputs>()}; } for &lexical,index in context.lexical { blot_eval_worker_packet::get(reader,lexical.original); lexical.input=readInput(reader); if lexical.original==0 { reader.failure=Error.invalid_artifact; } for prior in context.lexical[..index] { if prior.original==lexical.original { reader.failure=Error.invalid_artifact; } } if reader.failure!=Error.none { return reader.failure; } } if reader.failure!=Error.none { return reader.failure; } if reader.at!=reader.data.len||context.stage>3||context.depth<0||context.budget<0 { return Error.invalid_artifact; } return Error.none; }
fn measured(context: Request&,session: const blot_eval_core_eval::Session&) -> Error { var writer=Writer {context.reply}; blot_eval_worker_packet::put(writer,0x53434352 as u32); blot_eval_worker_packet::put(writer,1 as u32); blot_eval_worker_packet::put(writer,false); blot_eval_worker_packet::put(writer,session.summary_transitions); blot_eval_worker_packet::put(writer,session.counters); blot_eval_worker_packet::put(writer,0 as u64); return writer.failure; }
fn execute(bytes: const u8[:],retained_scratch: i64) -> u8[>..],bool,bool,Error { var reply: u8[>..]=[]; var context=Request {evidence:blot_evidence_packet::OwnedSnapshot {snapshot:blot_evidence_packet::emptySnapshot()},reply:reply}; var reader=Reader {bytes}; let error=readRequest(reader,context); if error!=Error.none { release(context); if error==Error.out_of_memory { return reply,false,false,error; } return reply,false,false,Error.none; } let validated=blot_eval_worker_packet::validate(context.catalog,blot_support::none<i64>()); if validated!=Error.none { release(context); if validated==Error.out_of_memory { return reply,false,false,validated; } return reply,false,false,Error.none; } var remaining: i64=0x7fffffffffffffff; let goals=context.evidence.snapshot.view().validateGoalTablesWithBudget(remaining); if goals!=Error.none { release(context); return reply,false,false,Error.none; } var clock=blot_backend_backend_timing::init(context.timing); let result=blot_eval_core_eval::withSession<Request,session>(context.catalog.modules,blot_native::fresh_owner_id(),context); let nanos=clock.lapNanos(); release(context); if result!=Error.none { if result==Error.out_of_memory { return reply,false,false,result; } return reply,false,false,Error.none; } if reply.len<8 { return reply,false,false,Error.invalid_artifact; } blot_bytes::put_u64(reply,reply.len-8,nanos); return reply,true,false,Error.none; }
fn session(context: Request&,private: blot_eval_core_eval::Session&) -> Error { private.options=context.options; private.semantic_job_budget=blot_support::some(context.budget); private.depth=context.depth; match context.stage { 0=>{ private.inference_stage=blot_work_counters::InferenceStage.general; },1=>{ private.inference_stage=blot_work_counters::InferenceStage.specialization; },2=>{ private.inference_stage=blot_work_counters::InferenceStage.preparation; },3=>{ private.inference_stage=blot_work_counters::InferenceStage.lowering; },_=>{ return Error.invalid_artifact; }, } let seeded=blot_eval_worker_packet::seed(private,context.seeds); if seeded!=Error.none { if seeded==Error.out_of_memory { return seeded; } return measured(context,private); } var tape,error=blot_reuse_specialization_receipt::initPooled(); if error!=Error.none { return error; } private.receipt_tape .= tape; let result=executeOwned(context,private,tape); private.receipt_tape .= null; tape.deinit(); return result; }
struct Export { key: Key,root: u32 }
fn less(left: Export,right: Export) -> bool { let a=left.key; let b=right.key; if a.target.unit!=b.target.unit { return a.target.unit<b.target.unit; } if a.target.binding!=b.target.binding { return a.target.binding<b.target.binding; } if a.lexical!=b.lexical { return a.lexical<b.lexical; } if a.inputs!=b.inputs { return a.inputs<b.inputs; } if a.expected_result!=b.expected_result { return a.expected_result<b.expected_result; } if a.expected_signature!=b.expected_signature { return a.expected_signature<b.expected_signature; } if a.source_interface!=b.source_interface { return !a.source_interface; } return !a.deferred_member&&b.deferred_member; }
fn executeOwned(context: Request&,private: blot_eval_core_eval::Session&,dependencies: blot_reuse_specialization_receipt::Tape&) -> Error { var nodes: dictionary<u32,u32>; var rows: dictionary<u32,u32>; var labels: dictionary<u32,u32>; var imports=blot_eval_semantic_evidence_import::Importer {source:context.evidence.snapshot.view(),destination:private.storage.evidence,max_depth:private.options.max_type_depth,nodes:nodes,rows:rows,labels:labels}; var lexical_origins: u32[>..<]=[]; var requested: Key[>..<]=[];
 for member in context.component.members { var key=member.key; if key.lexical!=0 { let original=key.lexical; var position: i64=-1; for known,index in lexical_origins { if known==original { position=index; break; } } if position>=0 { key.lexical=(position+1) as u32; } else { var input: const blot_eval_lexical_capture_inputs::Inputs?=null; for &candidate in context.lexical { if candidate.original==original { input .= candidate.input; break; } } if input==null { return measured(context,private); } var room=private.options.max_children-private.specializations.lexical_inputs.retained_words; if room<0 { room=0; } if input.words.len>room { return measured(context,private); } let copied,error=input.copyTyping(imports); if error!=Error.none { if error==Error.out_of_memory { return error; } return measured(context,private); } key.lexical=(lexical_origins.len+1) as u32; lexical_origins.push(original); private.specializations.lexical_inputs.inputs.push(copied); private.specializations.lexical_inputs.retained_words+=copied.words.len; private.specializations.lexical_inputs.examined_words+=copied.words.len; } }
  let inputs,error=imports.ty(key.inputs,0); if error!=Error.none { if error==Error.out_of_memory { return error; } return measured(context,private); } key.inputs=inputs; let result,e=imports.ty(key.expected_result,0); if e!=Error.none { if e==Error.out_of_memory { return e; } return measured(context,private); } key.expected_result=result; let signature,e2=imports.ty(key.expected_signature,0); if e2!=Error.none { if e2==Error.out_of_memory { return e2; } return measured(context,private); } key.expected_signature=signature; requested.push(key); let job,e3=private.specializations.call_summaries.request(private,key); if e3!=Error.none { if e3==Error.out_of_memory { return e3; } return measured(context,private); }
 }
 for edge in context.component.edges { let merged,error=private.specializations.call_summaries.components.add(edge.from,edge.to,requested.len,private.summary_transitions,private.summaryLimit()); if error!=Error.none { if error==Error.out_of_memory { return error; } return measured(context,private); } } let before_values=private.storage.values.len; let before_children=private.storage.children.len; let drained=private.specializations.call_summaries.drain(private); if drained!=Error.none { if drained==Error.out_of_memory { return drained; } return measured(context,private); }
 if private.diagnostic.present||dependencies.unknown||dependencies.nested||private.steps!=0||private.storage.values.len!=before_values||private.storage.children.len!=before_children { return measured(context,private); } for key in requested { let index=private.specializations.call_summaries.keys.get(key); if index==null||private.specializations.call_summaries.jobs.items[index].state!=blot_eval_core_eval::SummaryJobState.complete { return measured(context,private); } }
 var exports: Export[>..<]=[]; for job in private.specializations.call_summaries.jobs.items { if job.state!=blot_eval_core_eval::SummaryJobState.complete { continue; } var key=job.key; if key.lexical!=0 { if key.lexical>lexical_origins.len { return measured(context,private); } key.lexical=lexical_origins[key.lexical-1]; } exports.push(Export {key,job.result}); } ::sort(exports) { a,b=>return less(a,b); }
 var writer=Writer {context.reply}; blot_eval_worker_packet::put(writer,0x53434352 as u32); blot_eval_worker_packet::put(writer,1 as u32); blot_eval_worker_packet::put(writer,true); blot_eval_worker_packet::put(writer,private.summary_transitions); blot_eval_worker_packet::put(writer,private.counters); blot_eval_worker_packet::count(writer,exports.len); for entry in exports { blot_eval_worker_packet::put(writer,entry.key); blot_eval_worker_packet::put(writer,entry.root); } blot_eval_worker_packet::put(writer,private.component_members_published); blot_eval_worker_packet::put(writer,private.component_restarts); blot_eval_worker_packet::writeEvidence(writer,private.storage.evidence.view()); blot_eval_worker_packet::count(writer,dependencies.sources.len); for source in dependencies.sources.items { blot_eval_worker_packet::put(writer,source); } blot_eval_worker_packet::put(writer,0 as u64); return writer.failure;
}
fn decode(context: Context&,bytes: const u8[:]) -> Result,Error { var reader=Reader {bytes}; var signature: u32=0; var version: u32=0; blot_eval_worker_packet::get(reader,signature); blot_eval_worker_packet::get(reader,version); if reader.failure!=Error.none||signature!=0x53434352||version!=1 { return Result {},Error.invalid_artifact; } var result=Result {}; var present=false; blot_eval_worker_packet::get(reader,present); blot_eval_worker_packet::get(reader,result.transitions); blot_eval_worker_packet::get(reader,result.counters); if present { let count=blot_eval_worker_packet::count(reader,16); if reader.failure!=Error.none { return Result {},reader.failure; } result.keys=result_keys.alloc_slice(count); result.roots=result_roots.alloc_slice(count); for &key,index in result.keys { blot_eval_worker_packet::get(reader,key); blot_eval_worker_packet::get(reader,result.roots[index]); } blot_eval_worker_packet::get(reader,result.recursive_members); blot_eval_worker_packet::get(reader,result.restarts); let snapshot=blot_eval_worker_packet::readEvidence(reader); if reader.failure!=Error.none { result.deinit(); return Result {},reader.failure; } result.snapshot=blot_support::some(snapshot); let source_count=blot_eval_worker_packet::count(reader,8); if reader.failure!=Error.none { result.deinit(); return Result {},reader.failure; } result.sources=result_sources.alloc_slice(source_count); for &source in result.sources { blot_eval_worker_packet::get(reader,source); } }
 blot_eval_worker_packet::get(reader,result.job_nanos); if reader.failure!=Error.none||reader.at!=reader.data.len||result.transitions<0||result.recursive_members<0||result.restarts<0 { result.deinit(); if reader.failure!=Error.none { return Result {},reader.failure; } return Result {},Error.invalid_artifact; } if result.snapshot.present { let view=result.snapshot.value.snapshot.view(); var remaining: i64=0x7fffffffffffffff; let valid=view.validateGoalTablesWithBudget(remaining); if valid!=Error.none { result.deinit(); return Result {},valid; } for root in result.roots { if root==0||root>=view.nodes.len { result.deinit(); return Result {},Error.invalid_artifact; } } for key in result.keys { if key.inputs>=view.nodes.len||key.expected_result>=view.nodes.len||key.expected_signature>=view.nodes.len { result.deinit(); return Result {},Error.invalid_artifact; } } } return result,Error.none;
}
