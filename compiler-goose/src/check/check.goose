fn quantifiedAnnotation(self:Engine&,id:u32,node:blot_parse_ast::Node,scope:i64,binders:IdBuffer&)->u32,blot_error::Error {let details=self.tree.extra.items[node.c..node.c+2];var unsupported=false;for binder_id,ordinal in self.tree.list(blot_parse_ast::List{node.a,node.b}) {let binder=self.tree.node(binder_id);let universal=node.tag==blot_parse_ast::tag_type_forall && (binder.b==blot_parse_ast::bindersort_region || binder.b==blot_parse_ast::bindersort_row);if binder.b!=blot_parse_ast::bindersort_type_ && !universal {unsupported=true;let err=self.diagnostic(Code.unsupported_type,binder_id);if err!=blot_error::Error.none {return 0,err;}}for entry in self.type_env.items[scope..] {if entry.name==binder.a {unsupported=true;let err=self.diagnostic(Code.duplicate_type_parameter,binder_id);if err!=blot_error::Error.none {return 0,err;}}}let bound,err=self.types.boundType(ordinal as u32,binder.b);if err!=blot_error::Error.none {return 0,err;}let err=self.type_env.append(Engine_type_env{name:binder.a,ty:bound});if err!=blot_error::Error.none {return 0,err;}if binder.b==blot_parse_ast::bindersort_row {let row,err=self.types.rowType(bound);if err!=blot_error::Error.none {return 0,err;}let err=self.row_env.append(Engine_row_env{name:binder.a,row:row});if err!=blot_error::Error.none {return 0,err;}}let err=binders.append(bound);if err!=blot_error::Error.none {return 0,err;}}if unsupported {return self.types.fresh();}let goals,err=self.quantifierPredicates(id,binders.items,scope);if err!=blot_error::Error.none {return 0,err;}let body,error=self.quantifierBody(details[0],binders.items,goals,scope);if error!=blot_error::Error.none {equation_values.free_slice(goals);return 0,error;}var tag=blot_check_types::Tag.forall;if node.tag==blot_parse_ast::tag_type_exists {tag=blot_check_types::Tag.existential;}let result,error=self.types.quantifiedWithGoals(tag,body,binders.items,goals);equation_values.free_slice(goals);return result,error;}
fn usageAnnotation(self:Engine&,id:u32,node:blot_parse_ast::Node)->u32,blot_error::Error {let kind,valid=blot_check_types::usageKindFromCode(node.a);assert(valid);let payload,err=self.annotation(node.b);if err!=blot_error::Error.none {return 0,err;}if kind==blot_check_types::UsageKind.shared {let affine,err=blot_check_usage_check::affineNominal(self.types,self.nominals,payload);if err!=blot_error::Error.none {return 0,err;}if affine {return self.diagnosticFresh(Code.usage_evidence_mismatch,id);}}var region:u32=0;if kind==blot_check_types::UsageKind.borrow || kind==blot_check_types::UsageKind.borrow_mut {for entry in self.type_env.items {if entry.name==node.c {region=entry.ty;}}if region==0 {return self.diagnosticFresh(Code.unsupported_type,id);}}if kind==blot_check_types::UsageKind.concurrent && !blot_check_task_types::concurrentHost(self.types,payload) {let err=self.diagnostic(Code.task_host_contract,id);if err!=blot_error::Error.none {return 0,err;}}if kind==blot_check_types::UsageKind.once || kind==blot_check_types::UsageKind.many || kind==blot_check_types::UsageKind.cleanup || kind==blot_check_types::UsageKind.concurrent {if self.types.node(self.types.head(payload,0)).tag!=blot_check_types::Tag.function {return self.diagnosticFresh(Code.unsupported_type,id);}}let qualified,err=self.types.usage(payload,kind,region);if err!=blot_error::Error.none {return 0,err;}if kind==blot_check_types::UsageKind.cleanup && !blot_check_cleanup_contracts::hostNominal(self.types,self.nominals,qualified) && !blot_check_cleanup_contracts::pureNominal(self.types,self.nominals,qualified) {let err=self.diagnostic(Code.cleanup_not_safe,id);if err!=blot_error::Error.none {return 0,err;}}return qualified,blot_error::Error.none;}
fn dependentFunctionAnnotation(self:Engine&,node:blot_parse_ast::Node)->u32,blot_error::Error {let parameter,err=self.dependentParameter(node.a);if err!=blot_error::Error.none {return 0,err;}let result,err=self.annotation(node.b);if err!=blot_error::Error.none {return 0,err;}var row:u32=0;if node.c!=0 {let effects,err=self.annotationEffects(node.c);if err!=blot_error::Error.none {return 0,err;}row=effects;}return self.types.functionWithEffects(parameter,result,row);}
fn annotationProduct(self:Engine&,children:const u32[:],fields:u32[:])->u32,blot_error::Error {for child,index in children {let root,err=self.annotation(child);if err!=blot_error::Error.none {return 0,err;}fields[index]=root;}if fields.len==0 {return blot_check_types::unit,blot_error::Error.none;}return self.types.product(fields);}
fn annotationApplication(self:Engine&,id:u32,reverse:IdBuffer&)->u32,blot_error::Error {var head=id;loop {let node=self.tree.node(head);if node.tag==blot_parse_ast::tag_group {head=node.a;continue;}if node.tag!=blot_parse_ast::tag_type_apply {break;}let err=reverse.append(node.b);if err!=blot_error::Error.none {return 0,err;}head=node.a;}reverseIds(reverse.items);if self.tree.node(head).tag!=blot_parse_ast::tag_type_name {return self.diagnosticFresh(Code.unsupported_type,id);}return self.nominalAnnotation(head,reverse.items,id);}
fn Engine::obligation(self:Engine&,ty:u32,kind:blot_check_types::ObligationKind,id:u32)->blot_error::Error {return self.appendPending(PendingObligation{value:blot_check_types::Obligation{ty:ty,kind:kind,source:id},owner:self.current});}
reusable[] var row_environment_snapshots:Engine_row_env[>..];
fn Engine::quantifierRepresentatives(self:Engine&,binders:const u32[:],type_scope:i64,scope:u32)->u32[:],blot_error::Error {let values=equation_type_ids.alloc_slice(binders.len);let error=quantifierRepresentativeValues(self,binders,type_scope,scope,values);if error!=blot_error::Error.none {equation_type_ids.free_slice(values);return [],error;}return values,blot_error::Error.none;}
fn quantifierRepresentativeValues(self:Engine&,binders:const u32[:],type_scope:i64,scope:u32,representatives:u32[:])->blot_error::Error {for binder,ordinal in binders {let err=self.inferenceTransition();if err!=blot_error::Error.none {return err;}let leaf=self.types.node(binder);let representative,err=self.types.rigid(scope,ordinal as u32,leaf.b);if err!=blot_error::Error.none {return err;}representatives[ordinal]=representative;self.type_env.items[type_scope+ordinal].ty=representative;if leaf.b==blot_parse_ast::bindersort_row {let name=self.type_env.items[type_scope+ordinal].name;var index=self.row_env.items.len;while index!=0 {index-=1;if self.row_env.items[index].name!=name {continue;}let value=self.types.effects.node(self.row_env.items[index].row);match value.tail {blot_check_effects::Tail.formal payload=>{if payload.value!=binder {return blot_error::Error.type_mismatch;}},_=>{return blot_error::Error.type_mismatch;}}let row,err=self.types.rowType(representative);if err!=blot_error::Error.none {return err;}self.row_env.items[index].row=row;break;}}}return blot_error::Error.none;}
fn restoreQuantifierNames(self:Engine&,rows:const Engine_row_env[:],binders:const u32[:],type_scope:i64) {self.row_env.resize(rows.len);for row,index in rows {self.row_env.items[index]=row;}for binder,ordinal in binders {self.type_env.items[type_scope+ordinal].ty=binder;}}
fn Engine::quantifierBody(self:Engine&,source:u32,binders:const u32[:],goals:const blot_check_types::Obligation[:],type_scope:i64)->u32,blot_error::Error {let old=self.rankBoundary();let scope,err=self.types.rigidScope();if err!=blot_error::Error.none {return 0,err;}let rows=row_environment_snapshots.alloc_slice(self.row_env.items.len);for row,index in self.row_env.items {rows[index]=row;}let result,error=quantifierBodyRepresentatives(self,source,binders,goals,type_scope,scope,old);restoreQuantifierNames(self,rows,binders,type_scope);row_environment_snapshots.free_slice(rows);return result,error;}
fn quantifierBodyRepresentatives(self:Engine&,source:u32,binders:const u32[:],goals:const blot_check_types::Obligation[:],type_scope:i64,scope:u32,old:RankBoundary)->u32,blot_error::Error {let representatives,err=self.quantifierRepresentatives(binders,type_scope,scope);if err!=blot_error::Error.none {return 0,err;}let frontier=self.annotation_givens.len;let result,error=quantifierBodyGivens(self,source,binders,goals,scope,old,representatives);self.annotation_givens.resize(frontier);equation_type_ids.free_slice(representatives);return result,error;}
fn quantifierBodyGivens(self:Engine&,source:u32,binders:const u32[:],goals:const blot_check_types::Obligation[:],scope:u32,old:RankBoundary,representatives:const u32[:])->u32,blot_error::Error {for goal in goals {let instantiated,err=self.types.substituteGoal(goal,binders,representatives);if err!=blot_error::Error.none {return 0,err;}self.annotation_givens.append(instantiated);}let frontier=self.bindings.len;let body,err=self.annotation(source);if err!=blot_error::Error.none {return 0,err;}let err=self.validateRankScope(scope,old.variables,old.versions,old.rows,old.row_versions,source);if err!=blot_error::Error.none {return 0,err;}for index in frontier..self.bindings.len {let binding=self.bindings[index];if binding.kind!=Kind.parameter || self.tree.node(binding.declaration).tag!=blot_parse_ast::tag_type_binder {continue;}let resolved,err=self.types.resolve(binding.ty,0);if err!=blot_error::Error.none {return 0,err;}let ty,err=self.types.substitute(resolved,representatives,binders);if err!=blot_error::Error.none {return 0,err;}self.bindings[index].ty=ty;self.expr_types[binding.declaration]=ty;}let resolved,err=self.types.resolve(body,0);if err!=blot_error::Error.none {return 0,err;}return self.types.substitute(resolved,representatives,binders);}
fn Engine::quantifierPredicates(self:Engine&,source:u32,binders:const u32[:],type_scope:i64)->blot_check_types::Obligation[:],blot_error::Error {let where_node=self.tree.quantifier_predicates(source);if where_node==0 {return equation_values.alloc_slice(0),blot_error::Error.none;}let scope,err=self.types.rigidScope();if err!=blot_error::Error.none {return [],err;}let rows=row_environment_snapshots.alloc_slice(self.row_env.items.len);for row,index in self.row_env.items {rows[index]=row;}let result,error=quantifierPredicateRepresentatives(self,where_node,binders,type_scope,scope);restoreQuantifierNames(self,rows,binders,type_scope);row_environment_snapshots.free_slice(rows);return result,error;}
fn quantifierPredicateRepresentatives(self:Engine&,where_node:u32,binders:const u32[:],type_scope:i64,scope:u32)->blot_check_types::Obligation[:],blot_error::Error {let representatives,err=self.quantifierRepresentatives(binders,type_scope,scope);if err!=blot_error::Error.none {return [],err;}var goals=PredicateBuffer{};let result,error=quantifierPredicateGoals(self,where_node,binders,representatives,goals);goals.deinit(equation_values);equation_type_ids.free_slice(representatives);return result,error;}
fn quantifierPredicateGoals(self:Engine&,where_node:u32,binders:const u32[:],representatives:const u32[:],goals:PredicateBuffer&)->blot_check_types::Obligation[:],blot_error::Error {let syntax=self.tree.node(where_node);for source in self.tree.list(blot_parse_ast::List{syntax.a,syntax.b}) {let err=self.lowerPredicates(source,where_node,goals);if err!=blot_error::Error.none {return [],err;}}for &goal in goals.items {let normalized,err=self.resolvePredicateNonzero(goal);if err!=blot_error::Error.none {return [],err;}let restored,err=self.types.substituteGoal(normalized,representatives,binders);if err!=blot_error::Error.none {return [],err;}goal=restored;}let result=equation_values.alloc_slice(goals.items.len);for goal,index in goals.items {result[index]=goal;}return result,blot_error::Error.none;}
fn Engine::resolvePredicateNonzero(self:Engine&,before:blot_check_types::Obligation)->blot_check_types::Obligation,blot_error::Error {var result=before;for ordinal in 0..4 {var root=before.ty;if ordinal==1 {root=before.other;}else if ordinal==2 {root=before.result;}else if ordinal==3 {root=before.signature;}if root==0 {continue;}let value,err=self.types.resolve(root,0);if err!=blot_error::Error.none {return result,err;}if ordinal==0 {result.ty=value;}else if ordinal==1 {result.other=value;}else if ordinal==2 {result.result=value;}else {result.signature=value;}}return result,blot_error::Error.none;}
fn predicateValues(output:PredicateBuffer&)->const blot_check_types::Obligation[:] {return output.items;}
fn predicateValues(output:blot_check_types::Obligation[>..<]&)->const blot_check_types::Obligation[:] {return output;}
fn predicateAppend(output:PredicateBuffer&,value:blot_check_types::Obligation)->blot_error::Error {return output.append(value);}
fn predicateAppend(output:blot_check_types::Obligation[>..<]&,value:blot_check_types::Obligation)->blot_error::Error {output.append(value);return blot_error::Error.none;}
fn Engine::lowerPredicates<O>(self:Engine&,id:u32,where_node:u32,output:O&)->blot_error::Error {let node=self.tree.node(id);let selected .= self.catalogs.contract_names.get(self.catalogKey(node.a));if !selected {let predicate,err=self.lowerPredicate(id,where_node);if err!=blot_error::Error.none {return err;}if predicate.present {if predicateValues(output).len>=65536 {return blot_error::Error.type_limit;}return predicateAppend(output,predicate.value);}return blot_error::Error.none;}let index=selected;let err=self.resolveContract(index);if err!=blot_error::Error.none {return err;}let contract=self.contracts[index];let details=self.tree.extra.items[node.c..node.c+3];let syntax=self.tree.list(blot_parse_ast::List{details[0],details[1]});if node.b!=0 || details[2]!=0 || syntax.len!=contract.parameters.len {return self.diagnostic(Code.contract_arity,id);}let old=equation_type_ids.alloc_slice(contract.variables.len);for value,index in self.types.list(contract.variables) {old[index]=value;}let fresh=equation_type_ids.alloc_slice(old.len);let shapes=equation_type_ids.alloc_slice(contract.parameters.len);for value,index in self.types.list(contract.parameters) {shapes[index]=value;}let result=lowerContractParameters(self,id,where_node,contract,syntax,old,fresh,shapes,output);equation_type_ids.free_slice(shapes);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old);return result;}
fn lowerContractParameters<O>(self:Engine&,id:u32,where_node:u32,contract:Contract,syntax:const u32[:],old:const u32[:],fresh:u32[:],shapes:const u32[:],output:O&)->blot_error::Error {for &variable in fresh {let root,err=self.types.fresh();if err!=blot_error::Error.none {return err;}variable=root;}for shape,index in shapes {let actual,err=self.parameterArgument(self.parameter_patterns.list(contract.patterns)[index],syntax[index],true,0);if err!=blot_error::Error.none {return err;}let selected,err=self.types.substitute(shape,old,fresh);if err!=blot_error::Error.none {return err;}let err=self.constrain(selected,actual,syntax[index]);if err!=blot_error::Error.none {return err;}}let rows=equation_type_ids.alloc_slice(contract.row_variables.len);for row,index in self.types.list(contract.row_variables) {rows[index]=row;}let fresh_rows=equation_type_ids.alloc_slice(rows.len);let result=lowerContractRows(self,id,where_node,contract,old,fresh,shapes,rows,fresh_rows,output);equation_type_ids.free_slice(fresh_rows);equation_type_ids.free_slice(rows);return result;}
fn lowerContractRows<O>(self:Engine&,id:u32,where_node:u32,contract:Contract,old:const u32[:],fresh:const u32[:],shapes:const u32[:],rows:const u32[:],fresh_rows:u32[:],output:O&)->blot_error::Error {for &row in fresh_rows {let value,err=self.types.freshEffects();if err!=blot_error::Error.none {return err;}row=value;}if contract.requires_implementation {let application=equation_type_ids.alloc_slice(shapes.len);let pack,err=lowerContractApplication(self,shapes,old,fresh,rows,fresh_rows,application);equation_type_ids.free_slice(application);if err!=blot_error::Error.none {return err;}let err=predicateAppend(output,blot_check_types::Obligation{kind:blot_check_types::ObligationKind.contract,identity:contract.identity,ty:pack,source:id,explicit:true,qualification_unit:self.unit,qualification_span:self.tree.span(where_node)});if err!=blot_error::Error.none {return err;}}if contract.predicates.len>65536-predicateValues(output).len {return blot_error::Error.type_limit;}for before in self.contract_predicates[contract.predicates.start..contract.predicates.start+contract.predicates.len] {let predicate,err=self.substitutePredicateNonzero(before,old,fresh,rows,fresh_rows);if err!=blot_error::Error.none {return err;}predicate.source=id;predicate.qualification_unit=self.unit;predicate.qualification_span=self.tree.span(where_node);let err=predicateAppend(output,predicate);if err!=blot_error::Error.none {return err;}}return blot_error::Error.none;}
fn lowerContractApplication(self:Engine&,shapes:const u32[:],old:const u32[:],fresh:const u32[:],rows:const u32[:],fresh_rows:const u32[:],application:u32[:])->u32,blot_error::Error {for shape,index in shapes {let root,err=self.types.substituteWithRows(shape,old,fresh,rows,fresh_rows);if err!=blot_error::Error.none {return 0,err;}let resolved,err=self.types.resolve(root,0);if err!=blot_error::Error.none {return 0,err;}application[index]=resolved;}return self.types.product(application);}
fn Engine::substitutePredicateNonzero(self:Engine&,before:blot_check_types::Obligation,old:const u32[:],fresh:const u32[:],rows:const u32[:],fresh_rows:const u32[:])->blot_check_types::Obligation,blot_error::Error {var result=before;for ordinal in 0..4 {var root=before.ty;if ordinal==1 {root=before.other;}else if ordinal==2 {root=before.result;}else if ordinal==3 {root=before.signature;}if root==0 {continue;}let value,err=self.types.substituteWithRows(root,old,fresh,rows,fresh_rows);if err!=blot_error::Error.none {return result,err;}if ordinal==0 {result.ty=value;}else if ordinal==1 {result.other=value;}else if ordinal==2 {result.result=value;}else {result.signature=value;}}return result,blot_error::Error.none;}
fn Engine::lowerPredicate(self:Engine&,id:u32,where_node:u32)->blot_support::Option<blot_check_types::Obligation>,blot_error::Error {let node=self.tree.node(id);let details=self.tree.extra.items[node.c..node.c+3];let syntax=self.tree.list(blot_parse_ast::List{details[0],details[1]});let name=self.pool.get(node.a);var kind=blot_check_types::ObligationKind.type_eq;if name=="type_eq" {kind=blot_check_types::ObligationKind.type_eq;}else if name=="associated" {kind=blot_check_types::ObligationKind.dispatch;}else if name=="result" {kind=blot_check_types::ObligationKind.result_dispatch;}else if name=="receiver" {kind=blot_check_types::ObligationKind.receiver;}else if name=="merge" {kind=blot_check_types::ObligationKind.record_merge;}else if name=="field" {kind=blot_check_types::ObligationKind.field;}else if name=="update" {kind=blot_check_types::ObligationKind.update;}else if name=="operation" {kind=blot_check_types::ObligationKind.effect_operation;}else if name=="type_rep" {kind=blot_check_types::ObligationKind.type_rep;}else if name=="effect_rep" {kind=blot_check_types::ObligationKind.effect_rep;}else {let err=self.diagnostic(Code.invalid_constraint,id);return blot_support::none<blot_check_types::Obligation>(),err;}self.has_associated_types=self.has_associated_types || kind==blot_check_types::ObligationKind.type_eq;self.types.has_projections=self.types.has_projections || kind==blot_check_types::ObligationKind.type_eq;let named=kind==blot_check_types::ObligationKind.dispatch || kind==blot_check_types::ObligationKind.result_dispatch || kind==blot_check_types::ObligationKind.receiver || kind==blot_check_types::ObligationKind.field || kind==blot_check_types::ObligationKind.update;var expected=syntax.len;if kind==blot_check_types::ObligationKind.dispatch || kind==blot_check_types::ObligationKind.receiver || kind==blot_check_types::ObligationKind.update || kind==blot_check_types::ObligationKind.record_merge {expected=3;}else if kind==blot_check_types::ObligationKind.field || kind==blot_check_types::ObligationKind.result_dispatch || kind==blot_check_types::ObligationKind.type_eq {expected=2;}else if kind==blot_check_types::ObligationKind.type_rep {expected=1;}else if kind==blot_check_types::ObligationKind.effect_rep {expected=0;}let invocation=kind==blot_check_types::ObligationKind.dispatch || kind==blot_check_types::ObligationKind.result_dispatch || kind==blot_check_types::ObligationKind.receiver || kind==blot_check_types::ObligationKind.update;if (named && node.b==0) || (!named && node.b!=0) || syntax.len!=expected || (kind==blot_check_types::ObligationKind.effect_rep && details[2]==0) || (!invocation && kind!=blot_check_types::ObligationKind.effect_rep && details[2]!=0) || (kind==blot_check_types::ObligationKind.effect_operation && syntax.len==0) {let err=self.diagnostic(Code.invalid_constraint,id);return blot_support::none<blot_check_types::Obligation>(),err;}var arguments=IdBuffer{};let result,error=lowerPredicateArguments(self,id,where_node,node,details,syntax,kind,invocation,arguments);arguments.deinit(equation_type_ids);return result,error;}
fn lowerPredicateArguments(self:Engine&,id:u32,where_node:u32,node:blot_parse_ast::Node,details:const u32[:],syntax:const u32[:],kind:blot_check_types::ObligationKind,invocation:bool,arguments:IdBuffer&)->blot_support::Option<blot_check_types::Obligation>,blot_error::Error {if kind!=blot_check_types::ObligationKind.effect_operation {for argument in syntax {let root,err=self.annotation(argument);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}let err=arguments.append(root);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}}}var result=blot_check_types::Obligation{ty:blot_check_types::unit,kind:kind,source:id,name:node.b,explicit:true,qualification_span:self.tree.span(where_node),qualification_unit:self.unit};if kind==blot_check_types::ObligationKind.type_rep {result.ty=arguments.items[0];}else if kind==blot_check_types::ObligationKind.effect_operation {let operation,err=lowerOperationPredicate(self,id,where_node,syntax,arguments,result);if err!=blot_error::Error.none || !operation.present {return operation,err;}result=operation.value;}else if kind!=blot_check_types::ObligationKind.effect_rep {result.ty=arguments.items[0];if kind==blot_check_types::ObligationKind.field || kind==blot_check_types::ObligationKind.result_dispatch || kind==blot_check_types::ObligationKind.type_eq {result.result=arguments.items[1];}else {result.other=arguments.items[1];result.result=arguments.items[2];if kind==blot_check_types::ObligationKind.dispatch {result.operator=memberOperator(self.pool.get(node.b));}}}if invocation || kind==blot_check_types::ObligationKind.effect_rep {let previous=self.diagnostics.len;var row:u32=0;if details[2]==0 {let value,err=self.types.freshEffects();if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}row=value;}else {let value,err=self.annotationEffects(details[2]);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}row=value;}for &issue in self.diagnostics[previous..] {if issue.code==Code.unsupported_polymorphic_effect_label || issue.code==Code.unsupported_type {issue.code=Code.unsupported_polymorphic_effect_label;}if issue.code==Code.unsupported_polymorphic_effect_label || issue.code==Code.unknown_effect {issue.node=id;issue.span=self.tree.span(id);}}let signature,err=self.types.functionWithEffects(blot_check_types::unit,blot_check_types::unit,row);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}result.signature=signature;}return blot_support::some(result),blot_error::Error.none;}
fn lowerOperationPredicate(self:Engine&,id:u32,where_node:u32,syntax:const u32[:],arguments:IdBuffer&,before:blot_check_types::Obligation)->blot_support::Option<blot_check_types::Obligation>,blot_error::Error {let head=self.tree.node(syntax[0]);var selected=blot_support::none<u32>();if head.tag==blot_parse_ast::tag_type_name {selected=self.catalogOperationTemplate(head.a);}if !selected.present {let err=self.diagnostic(Code.invalid_constraint,id);return blot_support::none<blot_check_types::Obligation>(),err;}let template=self.effect_templates[selected.value];let family=self.effect_families[template.family];if family.callable || family.parameters.len==0 {let err=self.diagnostic(Code.invalid_constraint,id);return blot_support::none<blot_check_types::Obligation>(),err;}if syntax.len-1!=family.parameters.len {let err=self.diagnostic(Code.effect_arity,where_node);return blot_support::none<blot_check_types::Obligation>(),err;}let old=equation_type_ids.alloc_slice(family.variables.len);for value,index in self.types.list(family.variables) {old[index]=value;}let fresh=equation_type_ids.alloc_slice(old.len);let shapes=equation_type_ids.alloc_slice(family.parameters.len);for value,index in self.types.list(family.parameters) {shapes[index]=value;}let result,error=lowerOperationArguments(self,template,family,syntax[1..],old,fresh,shapes,arguments,before);equation_type_ids.free_slice(shapes);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old);return result,error;}
fn lowerOperationArguments(self:Engine&,template:EffectTemplate,family:EffectFamily,syntax:const u32[:],old:const u32[:],fresh:u32[:],shapes:const u32[:],arguments:IdBuffer&,before:blot_check_types::Obligation)->blot_support::Option<blot_check_types::Obligation>,blot_error::Error {for &variable in fresh {let root,err=self.types.fresh();if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}variable=root;}for shape,index in shapes {let argument,err=self.parameterArgument(self.parameter_patterns.list(family.patterns)[index],syntax[index],true,0);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}let selected,err=self.types.substitute(shape,old,fresh);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}let err=self.constrain(selected,argument,syntax[index]);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}let root,err=self.types.resolve(selected,0);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}let err=arguments.append(root);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}}let parameter,err=self.types.substitute(template.parameter,old,fresh);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}let output,err=self.types.substitute(template.result,old,fresh);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}let latent,err=self.types.freshEffects();if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}var row=latent;if self.current==0 && self.closed_type_variables {let label,err=self.types.internSymbolicOperation(template.identity,arguments.items);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}let established,err=self.types.effects.row([label],blot_check_effects::Tail.closed);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),blot_check_types::effectError(err);}row=established;}var result=before;let ty,err=self.types.functionWithEffects(parameter,output,row);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}result.ty=ty;result.signature=ty;let product,err=self.types.product(arguments.items);if err!=blot_error::Error.none {return blot_support::none<blot_check_types::Obligation>(),err;}result.other=product;result.identity=template.identity;return blot_support::some(result),blot_error::Error.none;}
fn Engine::beginQualification(self:Engine&,scope:u32,where_node:u32,annotation:u32,value:u32)->blot_error::Error {if where_node==0 {return blot_error::Error.none;}if annotation==0 {let err=self.diagnostic(Code.invalid_constraint,where_node);if err!=blot_error::Error.none {return err;}}let node=self.tree.node(where_node);let start=self.declared_obligations.len as u32;var predicates=PredicateBuffer{};let result=beginQualificationPredicates(self,scope,where_node,value,node,start,predicates);predicates.deinit(equation_values);return result;}
fn beginQualificationPredicates(self:Engine&,scope:u32,where_node:u32,value:u32,node:blot_parse_ast::Node,start:u32,predicates:PredicateBuffer&)->blot_error::Error {for syntax in self.tree.list(blot_parse_ast::List{node.a,node.b}) {let err=self.lowerPredicates(syntax,where_node,predicates);if err!=blot_error::Error.none {return err;}}for constraint in predicates.items {self.declared_obligations.append(constraint);let err=self.appendPending(PendingObligation{owner:self.current,value:constraint,declared:true,suspended:true});if err!=blot_error::Error.none {return err;}}self.qualifications.append(Qualification{scope:scope,owner:self.current,clauses:blot_check_types::List{start:start,len:self.declared_obligations.len as u32-start},value:value});return blot_error::Error.none;}
fn Engine::requirementOpen(self:Engine&,constraint:blot_check_types::Obligation)->bool,blot_error::Error {let include=constraint.kind!=blot_check_types::ObligationKind.dispatch && constraint.kind!=blot_check_types::ObligationKind.result_dispatch && constraint.kind!=blot_check_types::ObligationKind.receiver && constraint.kind!=blot_check_types::ObligationKind.update;var parts:u32[4]=[constraint.ty,constraint.other,constraint.result,0];if include {parts[3]=constraint.signature;}for part in parts {if part==0 {continue;}let projection,err=self.types.containsProjection(part);if err!=blot_error::Error.none || projection {return projection,err;}let values,err=self.types.freeVariables(part);if err!=blot_error::Error.none {return false,err;}if values.len!=0 {return true,blot_error::Error.none;}let rows,err=self.types.freeRowVariables(part);if err!=blot_error::Error.none {return false,err;}if rows.len!=0 {return true,blot_error::Error.none;}}return false,blot_error::Error.none;}
fn sourceRequirement(kind:blot_check_types::ObligationKind)->bool {return kind==blot_check_types::ObligationKind.type_eq || kind==blot_check_types::ObligationKind.contract || kind==blot_check_types::ObligationKind.record_merge || kind==blot_check_types::ObligationKind.dispatch || kind==blot_check_types::ObligationKind.result_dispatch || kind==blot_check_types::ObligationKind.field || kind==blot_check_types::ObligationKind.writable_field || kind==blot_check_types::ObligationKind.receiver || kind==blot_check_types::ObligationKind.update || kind==blot_check_types::ObligationKind.effect_operation || kind==blot_check_types::ObligationKind.type_rep || kind==blot_check_types::ObligationKind.effect_rep;}
fn Engine::requirementHead(self:const Engine&,wanted:blot_check_types::Obligation,declared:blot_check_types::Obligation)->bool {if wanted.kind==blot_check_types::ObligationKind.dispatch && declared.kind==blot_check_types::ObligationKind.dispatch {if wanted.name!=0 {return wanted.name==declared.name;}return wanted.operator!=blot_check_types::Operator.none && wanted.operator==declared.operator;}if wanted.kind==blot_check_types::ObligationKind.field && (declared.kind==blot_check_types::ObligationKind.field || declared.kind==blot_check_types::ObligationKind.receiver) {return wanted.name==declared.name && (declared.kind==blot_check_types::ObligationKind.field || self.types.node(self.types.head(declared.other,0)).tag==blot_check_types::Tag.unit);}if wanted.kind==blot_check_types::ObligationKind.writable_field && declared.kind==blot_check_types::ObligationKind.update {return wanted.name==declared.name;}if wanted.kind!=declared.kind {return false;}if wanted.kind==blot_check_types::ObligationKind.effect_operation || wanted.kind==blot_check_types::ObligationKind.contract {return wanted.identity==declared.identity;}return wanted.name==declared.name;}
fn Engine::unifyRequirement(self:Engine&,wanted:blot_check_types::Obligation,declared:blot_check_types::Obligation)->bool,blot_error::Error {if !self.requirementHead(wanted,declared) {return false,blot_error::Error.none;}if wanted.kind==blot_check_types::ObligationKind.contract {let left,err=self.rewriteGiven(wanted.ty,0);if err!=blot_error::Error.none {return false,err;}let right,err=self.rewriteGiven(declared.ty,0);if err!=blot_error::Error.none {return false,err;}return self.types.equalSymbolic(left,right);}if wanted.kind==blot_check_types::ObligationKind.type_eq {let left,err=self.rewriteGiven(wanted.ty,0);if err!=blot_error::Error.none {return false,err;}let right,err=self.rewriteGiven(wanted.result,0);if err!=blot_error::Error.none {return false,err;}return self.types.equalSymbolic(left,right);}let point=self.types.mark();let matched,err=unifyRequirementTrial(self,wanted,declared);if err==blot_error::Error.none && !matched {self.types.rollback(point);}return matched,err;}
fn requirementUnify(self:Engine&,left:u32,right:u32)->bool,blot_error::Error {let err=self.types.unify(left,right);if err==blot_error::Error.out_of_memory || err==blot_error::Error.type_limit {return false,err;}return err==blot_error::Error.none,blot_error::Error.none;}
fn unifyRequirementTrial(self:Engine&,wanted:blot_check_types::Obligation,declared:blot_check_types::Obligation)->bool,blot_error::Error {let matched,err=requirementUnify(self,wanted.ty,declared.ty);if err!=blot_error::Error.none || !matched {return false,err;}if wanted.kind==blot_check_types::ObligationKind.writable_field && declared.kind==blot_check_types::ObligationKind.update {let matched,err=requirementUnify(self,wanted.result,declared.other);if err!=blot_error::Error.none || !matched {return false,err;}let matched,err=requirementUnify(self,wanted.ty,declared.result);if err!=blot_error::Error.none || !matched {return false,err;}}else {if wanted.other!=0 && declared.other!=0 && wanted.kind!=blot_check_types::ObligationKind.field {let matched,err=requirementUnify(self,wanted.other,declared.other);if err!=blot_error::Error.none || !matched {return false,err;}}if wanted.result!=0 && declared.result!=0 {let matched,err=requirementUnify(self,wanted.result,declared.result);if err!=blot_error::Error.none || !matched {return false,err;}}}if wanted.signature!=0 && declared.signature!=0 {if wanted.kind==blot_check_types::ObligationKind.effect_operation {return requirementUnify(self,wanted.signature,declared.signature);}let left,err=self.types.resolve(wanted.signature,0);if err!=blot_error::Error.none {return false,err;}let right,err=self.types.resolve(declared.signature,0);if err!=blot_error::Error.none {return false,err;}let a=self.types.node(left);let b=self.types.node(right);if a.tag!=blot_check_types::Tag.function || b.tag!=blot_check_types::Tag.function {return false,blot_error::Error.none;}let ambient_signature=wanted.kind==blot_check_types::ObligationKind.dispatch || wanted.kind==blot_check_types::ObligationKind.result_dispatch;let row,err=self.types.resolveEffects(a.c,0);if err!=blot_error::Error.none {return false,err;}let ambient=self.types.row(row);var closed=false;match ambient.tail {blot_check_effects::Tail.closed=>{closed=true;},_=>{}}let pure=closed && ambient.labels.len==0;if !ambient_signature || pure {let err=self.types.unifyEffects(a.c,b.c);if err==blot_error::Error.out_of_memory {return false,err;}if err!=blot_error::Error.none {return false,blot_error::Error.none;}}}return true,blot_error::Error.none;}
fn Engine::checkQualification(self:Engine&,index:i64)->blot_error::Error {let boundary=self.qualifications[index];if boundary.checked {return blot_error::Error.none;}for use in self.qualification_uses {if use.scope==boundary.scope {let state .= self.global_states.get(use.target);assert(state!=null);if state.on_stack && !inList(self.finishing_group,use.target) {return blot_error::Error.none;}}}var ordinal:i64=0;while ordinal<self.pending.len {let err=checkQualificationPending(self,boundary,ordinal);if err!=blot_error::Error.none {return err;}ordinal+=1;}self.qualifications[index].checked=true;return blot_error::Error.none;}
fn checkQualificationPending(self:Engine&,boundary:Qualification,index:i64)->blot_error::Error {let pending=self.pending[index];if pending.scope!=boundary.scope || pending.declared || pending.covered || pending.solved || pending.local_scheme {return blot_error::Error.none;}if pending.value.kind==blot_check_types::ObligationKind.callee_use {self.pending[index].solved=true;return self.expandUse(pending,pending.expansion);}if !sourceRequirement(pending.value.kind) {return blot_error::Error.none;}let open,err=self.requirementOpen(pending.value);if err!=blot_error::Error.none {return err;}if !open {if pending.method_member && !pending.value.explicit && pending.value.kind==blot_check_types::ObligationKind.receiver && self.types.node(self.types.head(pending.value.other,0)).tag==blot_check_types::Tag.unit && pending.owner!=0 && pending.scope==self.bindings[pending.owner].declaration && self.bindings[pending.owner].scheme.root==0 {let state .= self.global_states.get(pending.owner);if state && state.state==State.complete {let receiver=self.identityOf(pending.value.ty);if receiver.present {let member .= self.catalogs.associated_members.get(AssociatedMember{identity:receiver.value,member:pending.value.name});if member && self.associated[member].binding==pending.owner {self.pending[index].suspended=true;}}}}return blot_error::Error.none;}var coverage=pending.value;if pending.method_member && !coverage.explicit && coverage.kind==blot_check_types::ObligationKind.receiver && self.types.node(self.types.head(coverage.other,0)).tag==blot_check_types::Tag.unit {coverage.kind=blot_check_types::ObligationKind.field;coverage.other=0;}var matched=false;for clause in 0..boundary.clauses.len {let declared=self.declared_obligations[boundary.clauses.start+clause];let equal,err=self.unifyRequirement(coverage,declared);if err!=blot_error::Error.none {return err;}if equal {if coverage.kind==blot_check_types::ObligationKind.result_dispatch {let resolved,err=self.types.resolve(declared.signature,0);if err!=blot_error::Error.none {return err;}let carrier=self.types.node(resolved);let signature,err=self.types.functionWithEffects(coverage.ty,coverage.result,carrier.c);if err!=blot_error::Error.none {return err;}self.dispatch_signatures[coverage.source]=signature;}matched=true;break;}}if !matched {let err=self.diagnostic(Code.missing_predicate,pending.value.source);if err!=blot_error::Error.none {return err;}if pending.origin!=0 {self.diagnostics[self.diagnostics.len-1].span=self.predicate_origins[pending.origin-1];}else {for origin in self.tree.operator_origins.items {if origin.node==pending.value.source && self.tree.node(origin.node).tag==blot_parse_ast::tag_binary {self.diagnostics[self.diagnostics.len-1].span=origin.span;break;}}}}else {self.covered_requirements.append(CoveredRequirement{scope:boundary.scope,value:pending.value});self.pending[index].covered=true;self.pending[index].suspended=true;}return blot_error::Error.none;}
fn Engine::targetRequirements(self:Engine&,target:u32,limit:i64,visited:IdBuffer&,output:PredicateBuffer&)->blot_error::Error {var work=IdBuffer{};let result=targetRequirementWork(self,target,limit,visited,output,work);work.deinit(equation_type_ids);return result;}
fn targetRequirementWork(self:Engine&,target:u32,limit:i64,visited:IdBuffer&,output:PredicateBuffer&,work:IdBuffer&)->blot_error::Error {let err=work.append(target);if err!=blot_error::Error.none {return err;}while work.items.len!=0 {let current=work.items[work.items.len-1];work.resize(work.items.len-1);let err=self.inferenceTransition();if err!=blot_error::Error.none {return err;}if inList(visited.items,current) {continue;}let err=visited.append(current);if err!=blot_error::Error.none {return err;}let scope=self.bindings[current].declaration;var qualified=false;for boundary in self.qualifications {if boundary.scope==scope {for predicate in self.declared_obligations[boundary.clauses.start..boundary.clauses.start+boundary.clauses.len] {let err=output.append(predicate);if err!=blot_error::Error.none {return err;}}qualified=true;break;}}if qualified {continue;}for pending in self.pending[..limit] {if pending.scope==scope && !pending.solved && !pending.declared && !pending.covered && !pending.local_scheme {let err=output.append(pending.value);if err!=blot_error::Error.none {return err;}}}var index=self.qualification_uses.len;while index!=0 {index-=1;let use=self.qualification_uses[index];if use.scope==scope {let err=work.append(use.target);if err!=blot_error::Error.none {return err;}}}}return blot_error::Error.none;}
fn Engine::prepareQualifications(self:Engine&,group:const u32[:])->blot_error::Error {var index:i64=0;while index<self.pending.len {let pending=self.pending[index];if pending.declared || pending.covered || pending.solved || pending.local_scheme || pending.value.kind!=blot_check_types::ObligationKind.callee_use {index+=1;continue;}var qualified=false;for boundary in self.qualifications {if boundary.scope==pending.scope && inList(group,boundary.owner) {qualified=true;break;}}if qualified {let err=self.inferenceTransition();if err!=blot_error::Error.none {return err;}self.pending[index].solved=true;let err=self.expandUse(pending,pending.expansion);if err!=blot_error::Error.none {return err;}}index+=1;}return blot_error::Error.none;}
fn Engine::expandQualificationUses(self:Engine&,group:const u32[:])->blot_error::Error {var qualified=false;for boundary in self.qualifications {if inList(group,boundary.owner) {qualified=true;break;}}if !qualified {return blot_error::Error.none;}let limit=self.pending.len;let scope=self.qualification_scope;let count=self.qualification_uses.len;let result=expandQualificationReferences(self,group,limit,count);self.qualification_scope=scope;return result;}
fn expandQualificationReferences(self:Engine&,group:const u32[:],limit:i64,count:i64)->blot_error::Error {for index in 0..count {let use=self.qualification_uses[index];if !inList(group,use.target) {continue;}var visited=IdBuffer{};var requirements=PredicateBuffer{};let result=forwardQualificationRequirements(self,use,index,limit,visited,requirements);requirements.deinit(equation_values);visited.deinit(equation_type_ids);if result!=blot_error::Error.none {return result;}}return blot_error::Error.none;}
fn forwardQualificationRequirements(self:Engine&,use:QualificationUse,index:i64,limit:i64,visited:IdBuffer&,requirements:PredicateBuffer&)->blot_error::Error {let err=self.targetRequirements(use.target,limit,visited,requirements);if err!=blot_error::Error.none {return err;}self.qualification_scope=use.scope;for constraint in requirements.items {let err=self.inferenceTransition();if err!=blot_error::Error.none {return err;}let forwarded=ForwardedRequirement{use:index,value:constraint};if self.forwarded_requirements.contains(forwarded) {continue;}var value=constraint;value.source=use.source;let origin,err=self.memberUseOrigin(value,use.source);if err!=blot_error::Error.none {return err;}let err=self.appendPending(PendingObligation{owner:use.owner,origin:origin,suspended:value.explicit && value.kind!=blot_check_types::ObligationKind.record_merge,value:value});if err!=blot_error::Error.none {return err;}self.forwarded_requirements.insert(forwarded,true);}return blot_error::Error.none;}
fn Engine::explicitRequirement(self:const Engine&,value:blot_check_types::Obligation)->bool {return value.explicit || (value.kind==blot_check_types::ObligationKind.callee_use && self.bindings[value.identity.decl].summary.has_explicit);}
