fn aggregateExpression(self:Walk&,owner:i64,id:u32,n:blot_check_core::Node,frame:Frame&,weak:bool,observe:bool,children:ValueId[:],fields:u32[:])->Flow {let module .= self.units[owner];if n.tag==CoreTag.record {if n.ty>=module.types.nodes.len {self.bad();return Flow{..};}let record=module.types.node(n.ty);if record.tag!=TypeTag.record || record.b!=children.len {self.bad();return Flow{..};}for &field,index in fields {field=module.types.recordField(record,index).name;}}for operand,index in module.children(id) {let result=self.expression(owner,operand,frame,weak,observe);if self.failed() || result.returning {return result;}var destination=index;if n.tag==CoreTag.record {destination=module.recordDestinations(id)[index];}if destination>=children.len {self.bad();return Flow{..};}children[destination]=result.value;}var kind=Kind.product;if n.tag==CoreTag.record {kind=Kind.record;}else if n.tag==CoreTag.array {kind=Kind.array;}let result=self.aggregate(Value{kind:kind,..},children,fields);self.retain(result,Site{owner:owner,node:id},weak,observe);return Flow{value:result,..};}
fn collect(units:const Module[:],session:Session&,roots:const BindingRef[:])->Result,Error {if !(session.units .== units) {return Result{edges:[],facts:[]},Error.incomplete;}var walk=Walk{units:units,session:session,..};walk.add(Value{..});for root in roots {walk.root=walk.normalize(blot_support::none<i64>(),root);let owner=walk.ownerOf(walk.root.unit,blot_support::none<i64>());let declaration=walk.body(walk.root);if walk.failed() {break;}if !declaration.runtime || declaration.is_function {walk.bad();break;}var frame=Frame{..};let site=Site{owner:owner,node:declaration.root};walk.fact(site,FactKind.body_enter,false,walk.root.binding,blot_support::none<u32>(),true);let result=walk.expression(owner,declaration.root,frame,false,true);let possible=frame.possible_return.present;frame.deinit();if walk.failed() {break;}if result.returning || possible {walk.bad();break;}var expected=blot_support::none<ScalarInterface>();if walk.values.items[result.value].kind==Kind.closure {expected=walk.scalarInterface(owner,units[owner].binding(walk.root.binding).ty);}walk.retainScalarInterface(result.value,site,false,true,expected);walk.fact(site,FactKind.body_complete,false,walk.root.binding,blot_support::none<u32>(),true);if walk.failed() {break;}}if walk.failed() {let error=walk.failure;walk.deinit();return Result{edges:[],facts:[]},error;}let edges=edge_runs.alloc_slice(walk.edges.len);for edge,index in walk.edges.items {edges[index]=edge;}let facts=fact_runs.alloc_slice(walk.facts.len);for fact,index in walk.facts.items {facts[index]=fact;}walk.deinit();return Result{edges:edges,facts:facts},Error.none;}
