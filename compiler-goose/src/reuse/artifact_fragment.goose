fn admit<G>(self_:State&,g:G&,id:u32)->bool,Error {self_.serialized_addresses.clear();let first=self_.starts[id-1];let last=self_.ends[id-1];if first==0xffffffffffffffff || last<=first {return false,blot_error::Error.none;}var roots=blot_reuse_source_value_template::WordBuffer{..};var skipped=blot_reuse_source_value_template::WordBuffer{..};let admitted,error=admitRecords(self_,g,id,first,last,roots,skipped);skipped.deinit();roots.deinit();return admitted,error;}
fn admitRecords<G>(self_:State&,g:G&,id:u32,first:u64,last:u64,roots:blot_reuse_source_value_template::WordBuffer&,skipped:blot_reuse_source_value_template::WordBuffer&)->bool,Error {var cursor=self_.metaAt(first);while cursor<self_.old.metadata.events.len {let event=self_.old.metadata.events.items[cursor];cursor+=1;if event.sequence>last {break;}match event.event {enter item=>{let child=item.job;let job=self_.old.metadata.jobs.items[child-1];for read in self_.old.metadata.static_reads.items[job.static_reads.start..job.static_reads.start+job.static_reads.len] {let matched,error=self_.matchStatic(g,read);if error!=blot_error::Error.none || !matched {return false,error;}}var constant=false;match job.request {constant=>{constant=true;},_=>{},}if constant && !scalarConstant(self_.old,job) {let selected,error=self_.aggregateConstantRequest(g,child);if error!=blot_error::Error.none || !selected.present {return false,error;}let error=roots.push(selected.value.root);if error!=blot_error::Error.none {return false,error;}let error=skipped.push(child);if error!=blot_error::Error.none {return false,error;}cursor=self_.metaAt(self_.ends[child-1]+1);continue;}if constant {let selected,error=self_.scalarConstantRequest(g,job);if error!=blot_error::Error.none || !selected.present {return false,error;}}else {let accepted,error=self_.admitJobRequest(g,child);if error!=blot_error::Error.none || !accepted {return false,error;}}},_=>{},}}var skip:i64=0;cursor=self_.emissionAt(first);while cursor<self_.old.emission.records.len {let record=self_.old.emission.records.items[cursor];if record.sequence>last {break;}while skip<skipped.items.len && self_.ends[skipped.items[skip]-1]<record.sequence {skip+=1;}if skip<skipped.items.len && record.sequence>=self_.starts[skipped.items[skip]-1] {cursor=self_.emissionAt(self_.ends[skipped.items[skip]-1]+1);continue;}let accepted,error=admitEmission(self_,g,record,cursor,last,roots.items);if error!=blot_error::Error.none || !accepted {return false,error