fn finishFacts(self:Engine&,lambda_rows:dictionary<u32,IdBuffer>&)->blot_error::Error {for decision in self.body_closed_rows {let source .= self.row_sources.get(decision.variable);if source {let known .= lambda_rows.get(source);if !known {lambda_rows.insert(source,IdBuffer{});}let list .= lambda_rows.get(source);assert(list);if !inList(list.items,decision.variable) {let err=list.append(decision.variable);if err!=blot_error::Error.none {return err;}}}}for slot in lambda_rows.slots {if slot.tag!=0 {let list,err=self.types.saveList(slot.val.items);if err!=blot_error::Error.none {return err;}self.lambda_closed_rows[slot.key]=list;}}var quantified:u32[>..]=[];for binding in self.bindings[1..] {quantified.append(self.types.list(binding.scheme.variables));}let error=finishUnsolved(self,quantified);if error!=blot_error::Error.none {return error;}return finishNormalized(self);}
fn finishUnsolved(self:Engine&,quantified:const u32[:])->blot_error::Error {for pending in self.pending {if pending.solved || pending.suspended {continue;}let resolved,err=self.types.resolve(pending.value.ty,0);if err!=blot_error::Error.none {return err;}let tag=self.types.node(resolved).tag;if tag==blot_check_types::Tag.variable && inList(quantified,resolved) {continue;}let kind=pending.value.kind;if kind==blot_check_types::ObligationKind.callee_use {continue;}if kind==blot_check_types::ObligationKind.monad_factory {let err=self.diagnostic(Code.type_constructor_required,pending.value.source);if err!=blot_error::Error.none {return err;}continue;}if kind==blot_check_types::ObligationKind.resolver_dispatch {let err=self.diagnostic(Code.missing_member,pending.value.source);if err!=blot_error::Error.none {return err;}continue;}if kind==blot_check_types::ObligationKind.effect_operation || kind==blot_check_types::ObligationKind.effect_handler || kind==blot_check_types::ObligationKind.type_head || kind==blot_check_types::ObligationKind.record_merge {continue;}if kind==blot_check_types::ObligationKind.resolver_shape {let err=self.diagnostic(Code.invalid_provider,pending.value.source);if err!=blot_error::Error.none {return err;}continue;}if kind==blot_check_types::ObligationKind.field || kind==blot_check_types::ObligationKind.writable_field {var code=Code.missing_member;if kind==blot_check_types::ObligationKind.writable_field {code=Code.missing_field;}let err=self.diagnostic(code,pending.value.source);if err!=blot_error::Error.none {return err;}if kind==blot_check_types::ObligationKind.field {let err=self.explainReceiver(pending.value.ty,pending.value.name);if err!=blot_error::Error.none {return err;}}continue;}if kind==blot_check_types::ObligationKind.result_dispatch {let destination,err=self.types.resolve(pending.value.result,0);if err!=blot_error::Error.none {return err;}var code=Code.missing_associated;if self.types.node(destination).tag==blot_check_types::Tag.variable {code=Code.ambiguous_associated;}let err=self.diagnostic(code,pending.value.source);if err!=blot_error::Error.none {return err;}let err=self.explainResult(destination,pending.value.name);if err!=blot_error::Error.none {return err;}continue;}if kind==blot_check_types::ObligationKind.dispatch {var code=Code.missing_associated;if pending.value.name==0 {code=Code.ambiguous_operator;}let err=self.diagnostic(code,pending.value.source);if err!=blot_error::Error.none {return err;}let err=self.explainDispatch(pending.value.ty,pending.value.other,pending.value.name,pending.value.operator,false);if err!=blot_error::Error.none {return err;}continue;}if tag==blot_check_types::Tag.unsigned32 || (tag==blot_check_types::Tag.floating32 && kind!=blot_check_types::ObligationKind.integer) || (tag==blot_check_types::Tag.boolean && kind==blot_check_types::ObligationKind.equality) {continue;}let err=self.diagnostic(Code.ambiguous_operator,pending.value.source);if err!=blot_error::Error.none {return err;}var detail:u8[>..<]=[];let err=blot_reuse_type_display::text(self,detail,"Unresolved ");if err!=blot_error::Error.none {return err;}let err=blot_reuse_type_display::text(self,detail,blot_check_types::obligationKindName(kind));if err!=blot_error::Error.none {return err;}let err=blot_reuse_type_display::text(self,detail," requirement for ");if err!=blot_error::Error.none {return err;}let err=blot_reuse_type_display::append(self,detail,resolved);if err!=blot_error::Error.none {return err;}if kind==blot_check_types::ObligationKind.update && pending.value.name!=0 {let err=blot_reuse_type_display::text(self,detail," at field ");if err!=blot_error::Error.none {return err;}let err=blot_reuse_type_display::text(self,detail,self.pool.get(pending.value.name));if err!=blot_error::Error.none {return err;}let err=blot_reuse_type_display::text(self,detail," with replacement ");if err!=blot_error::Error.none {return err;}let root,err=self.types.resolve(pending.value.other,0);if err!=blot_error::Error.none {return err;}let err=blot_reuse_type_display::append(self,detail,root);if err!=blot_error::Error.none {return err;}}self.diagnostics[self.diagnostics.len-1].detail=blot_support::some(ownDiagnosticText(detail));}return blot_error::Error.none;}

fn finishNormalized(self:Engine&)->blot_error::Error {
for &id in self.expr_types {if id!=0 {
{let value,err=self.types.resolve(id,0);if err!=blot_error::Error.none {return err;}id=value;}
}}
for &id in self.dispatch_signatures {if id!=0 {
{let value,err=self.types.resolve(id,0);if err!=blot_error::Error.none {return err;}id=value;}
}}
for &binding in self.bindings[1..] {
{let value,err=self.types.resolve(binding.ty,0);if err!=blot_error::Error.none {return err;}binding.ty=value;}
if binding.scheme.root!=0 {
{let value,err=self.types.resolve(binding.scheme.root,0);if err!=blot_error::Error.none {return err;}binding.scheme.root=value;}
}
}
for &block in self.resolver_blocks {
{let value,err=self.types.resolve(block.result,0);if err!=blot_error::Error.none {return err;}block.result=value;}
{let value,err=self.types.resolveEffects(block.body_effects,0);if err!=blot_error::Error.none {return err;}block.body_effects=value;}
}
for &op in self.resolver_ops {
if op.method_type!=0 {
{let value,err=self.types.resolve(op.method_type,0);if err!=blot_error::Error.none {return err;}op.method_type=value;}
}
if op.payload!=0 {
{let value,err=self.types.resolve(op.payload,0);if err!=blot_error::Error.none {return err;}op.payload=value;}
}
if op.result!=0 {
{let value,err=self.types.resolve(op.result,0);if err!=blot_error::Error.none {return err;}op.result=value;}
}
{let err=self.normalizeList(op.completed_types);if err!=blot_error::Error.none {return err;}}
}
for &join in self.resolver_joins {
{let value,err=self.types.resolve(join.ty,0);if err!=blot_error::Error.none {return err;}join.ty=value;}
{let value,err=self.types.resolve(join.result,0);if err!=blot_error::Error.none {return err;}join.result=value;}
}
for completion in self.resolver_completions {let err=self.normalizeList(completion.completed_types);if err!=blot_error::Error.none {return err;}}
for &loop in self.resolver_loops {
{let value,err=self.types.resolve(loop.cursor,0);if err!=blot_error::Error.none {return err;}loop.cursor=value;}
{let value,err=self.types.resolve(loop.step_result,0);if err!=blot_error::Error.none {return err;}loop.step_result=value;}
{let value,err=self.types.resolve(loop.suffix_result,0);if err!=blot_error::Error.none {return err;}loop.suffix_result=value;}
}
for list in self.access_types {let err=self.normalizeList(list);if err!=blot_error::Error.none {return err;}}
for &nominal in self.nominals[1..] {
{let err=self.normalizeList(nominal.parameters);if err!=blot_error::Error.none {return err;}}
{let err=self.normalizeList(nominal.variables);if err!=blot_error::Error.none {return err;}}
}
for &constructor in self.constructors[1..] {
{let value,err=self.types.resolve(constructor.scheme.root,0);if err!=blot_error::Error.none {return err;}constructor.scheme.root=value;}
{let value,err=self.types.resolve(constructor.payload,0);if err!=blot_error::Error.none {return err;}constructor.payload=value;}
{let err=self.normalizeList(constructor.scheme.variables);if err!=blot_error::Error.none {return err;}}
}
for &family in self.effect_families[1..] {
{let err=self.normalizeList(family.parameters);if err!=blot_error::Error.none {return err;}}
{let err=self.normalizeList(family.variables);if err!=blot_error::Error.none {return err;}}
}
for &template in self.effect_templates[1..] {
{let value,err=self.types.resolve(template.parameter,0);if err!=blot_error::Error.none {return err;}template.parameter=value;}
{let value,err=self.types.resolve(template.result,0);if err!=blot_error::Error.none {return err;}template.result=value;}
}
for &use in self.operation_uses {let err=self.normalizeList(use.arguments);if err!=blot_error::Error.none {return err;}
{let value,err=self.types.resolve(use.signature,0);if err!=blot_error::Error.none {return err;}use.signature=value;}
}
for &scope in self.effect_scopes {
{let value,err=self.types.resolve(scope.capability,0);if err!=blot_error::Error.none {return err;}scope.capability=value;}
{let value,err=self.types.resolve(scope.result,0);if err!=blot_error::Error.none {return err;}scope.result=value;}
{let value,err=self.types.resolveEffects(scope.body_effects,0);if err!=blot_error::Error.none {return err;}scope.body_effects=value;}
let capability=self.types.node(scope.capability);let row=self.types.row(scope.body_effects);if row.tail!=blot_check_effects::Tail.closed {let err=self.diagnostic(Code.effect_identity_scope,scope.node);if err!=blot_error::Error.none {return err;}}for label in self.types.rowLabels(scope.body_effects) {let instance=self.types.operation(label).instance;if instance.unit==capability.b && instance.decl==capability.c {let err=self.diagnostic(Code.effect_mismatch,scope.node);if err!=blot_error::Error.none {return err;}}}}

for &block in self.provider_blocks {
{let value,err=self.types.resolve(block.body_result,0);if err!=blot_error::Error.none {return err;}block.body_result=value;}
{let value,err=self.types.resolve(block.result,0);if err!=blot_error::Error.none {return err;}block.result=value;}
{let value,err=self.types.resolveEffects(block.body_effects,0);if err!=blot_error::Error.none {return err;}block.body_effects=value;}
{let value,err=self.types.resolveEffects(block.outer_effects,0);if err!=blot_error::Error.none {return err;}block.outer_effects=value;}
}
for &runner in self.effect_runners {
if runner.read_token!=0 {
{let value,err=self.types.resolve(runner.read_token,0);if err!=blot_error::Error.none {return err;}runner.read_token=value;}
}
if runner.write_token!=0 {
{let value,err=self.types.resolve(runner.write_token,0);if err!=blot_error::Error.none {return err;}runner.write_token=value;}
}
{let value,err=self.types.resolve(runner.state_type,0);if err!=blot_error::Error.none {return err;}runner.state_type=value;}
{let value,err=self.types.resolve(runner.body_result,0);if err!=blot_error::Error.none {return err;}runner.body_result=value;}
{let value,err=self.types.resolve(runner.result,0);if err!=blot_error::Error.none {return err;}runner.result=value;}
if runner.implementation_type!=0 {
{let value,err=self.types.resolve(runner.implementation_type,0);if err!=blot_error::Error.none {return err;}runner.implementation_type=value;}
}
{let value,err=self.types.resolve(runner.action_type,0);if err!=blot_error::Error.none {return err;}runner.action_type=value;}
{let value,err=self.types.resolveEffects(runner.body_effects,0);if err!=blot_error::Error.none {return err;}runner.body_effects=value;}
{let value,err=self.types.resolveEffects(runner.outer_effects,0);if err!=blot_error::Error.none {return err;}runner.outer_effects=value;}
}
for &computation in self.computations {
{let value,err=self.types.resolve(computation.ty,0);if err!=blot_error::Error.none {return err;}computation.ty=value;}
{let value,err=self.types.resolve(computation.action_type,0);if err!=blot_error::Error.none {return err;}computation.action_type=value;}
}
for &request in self.request_loops {
{let value,err=self.types.resolve(request.value_type,0);if err!=blot_error::Error.none {return err;}request.value_type=value;}
{let value,err=self.types.resolve(request.result_type,0);if err!=blot_error::Error.none {return err;}request.result_type=value;}
{let value,err=self.types.resolve(request.state_type,0);if err!=blot_error::Error.none {return err;}request.state_type=value;}
{let value,err=self.types.resolve(request.action_type,0);if err!=blot_error::Error.none {return err;}request.action_type=value;}
}
for &arm in self.request_arms {
{let value,err=self.types.resolve(arm.parameter_type,0);if err!=blot_error::Error.none {return err;}arm.parameter_type=value;}
{let value,err=self.types.resolve(arm.reply_type,0);if err!=blot_error::Error.none {return err;}arm.reply_type=value;}
{let value,err=self.types.resolve(arm.signature,0);if err!=blot_error::Error.none {return err;}arm.signature=value;}
}
for &predicate in self.obligations {
{let value,err=self.types.resolve(predicate.ty,0);if err!=blot_error::Error.none {return err;}predicate.ty=value;}
if predicate.result!=0 {
{let value,err=self.types.resolve(predicate.result,0);if err!=blot_error::Error.none {return err;}predicate.result=value;}
}
if predicate.other!=0 {
{let value,err=self.types.resolve(predicate.other,0);if err!=blot_error::Error.none {return err;}predicate.other=value;}
}
if predicate.signature!=0 {
{let value,err=self.types.resolve(predicate.signature,0);if err!=blot_error::Error.none {return err;}predicate.signature=value;}
}
}
for &requirement in self.covered_requirements {
if requirement.value.ty!=0 {
{let value,err=self.types.resolve(requirement.value.ty,0);if err!=blot_error::Error.none {return err;}requirement.value.ty=value;}
}
if requirement.value.other!=0 {
{let value,err=self.types.resolve(requirement.value.other,0);if err!=blot_error::Error.none {return err;}requirement.value.other=value;}
}
if requirement.value.result!=0 {
{let value,err=self.types.resolve(requirement.value.result,0);if err!=blot_error::Error.none {return err;}requirement.value.result=value;}
}
if requirement.value.signature!=0 {
{let value,err=self.types.resolve(requirement.value.signature,0);if err!=blot_error::Error.none {return err;}requirement.value.signature=value;}
}
}
if self.diagnostics.len==0 {for id in self.cases {let err=self.checkCoverage(id);if err!=blot_error::Error.none {return err;}}}return blot_error::Error.none;
}
fn Engine::wildcard(self:const Engine&,id:u32)->bool {if id==0 {return true;}let tag=self.tree.node(id).tag;return tag==blot_parse_ast::tag_pattern_name || tag==blot_parse_ast::tag_pattern_field;}
type CoverageRows=blot_support_pooled_buffer::Buffer<const u32[:]>;
type CoverageRanges=blot_support_pooled_buffer::Buffer<blot_check_types::List>;
reusable[] var coverage_rows:(const u32[:])[>..];
reusable[] var coverage_ranges:blot_check_types::List[>..];
struct CoverageWork {variants:IdBuffer=IdBuffer{},children:IdBuffer=IdBuffer{},words:IdBuffer=IdBuffer{},ranges:CoverageRanges=CoverageRanges{},specialized:CoverageRows=CoverageRows{}}
fn CoverageWork::deinit(self:CoverageWork&) {self.variants.deinit(equation_type_ids);self.children.deinit(equation_type_ids);self.words.deinit(equation_type_ids);self.ranges.deinit(coverage_ranges);self.specialized.deinit(coverage_rows);}
fn Engine::checkCoverage(self:Engine&,id:u32)->blot_error::Error {let node=self.tree.node(id);let input=self.tree.extra.items[node.a..node.a+2];var types=IdBuffer{};var rows=CoverageRows{};let error=checkCoverageRows(self,id,node,input,types,rows);types.deinit(equation_type_ids);rows.deinit(coverage_rows);return error;}
fn checkCoverageRows(self:Engine&,id:u32,node:blot_parse_ast::Node,input:const u32[:],types:IdBuffer&,rows:CoverageRows&)->blot_error::Error {for child in self.tree.list(blot_parse_ast::List{input[0],input[1]}) {let ty=self.expr_types[child];let resolved,err=self.types.resolve(ty,0);if err!=blot_error::Error.none {return err;}if resolved==blot_check_types::never {return blot_error::Error.none;}let err=types.append(ty);if err!=blot_error::Error.none {return err;}}for arm_id in self.tree.list(blot_parse_ast::List{node.b,node.c}) {let arm=self.tree.node(arm_id);if self.tree.extra.items[arm.c]!=0 {continue;}for row in self.tree.list(blot_parse_ast::List{arm.a,arm.b}) {let err=rows.push(self.tree.children(row),coverage_rows);if err!=blot_error::Error.none {return err;}}}var budget:i64=100000;let covered,err=self.covered(rows.items,types.items,0,budget);if err!=blot_error::Error.none {return err;}if !covered {return self.diagnostic(Code.non_exhaustive_match,id);}return blot_error::Error.none;}
recursive fn Engine::covered(self:Engine&,rows:const(const u32[:])[:],types:const u32[:],depth:i64,budget:i64&)->bool,blot_error::Error {if budget==0 || depth>=1024 {return false,blot_error::Error.type_limit;}budget-=1;if rows.len==0 {return false,blot_error::Error.none;}if types.len==0 {return true,blot_error::Error.none;}for row in rows {var all=true;for pattern in row {all=all && self.wildcard(pattern);}if all {return true,blot_error::Error.none;}}let ty,err=self.types.resolve(types[0],0);if err!=blot_error::Error.none {return false,err;}let node=self.types.node(ty);var work=CoverageWork{};let result,error=coveredVariants(self,rows,types,ty,node,depth,budget,work);work.deinit();return result,error;}
fn coveredVariants(self:Engine&,rows:const(const u32[:])[:],types:const u32[:],ty:u32,node:blot_check_types::Node,depth:i64,budget:i64&,work:CoverageWork&)->bool,blot_error::Error {match node.tag {
 blot_check_types::Tag.boolean=>{let err=work.variants.append(0);if err!=blot_error::Error.none {return false,err;}let err=work.variants.append(1);if err!=blot_error::Error.none {return false,err;}},
 blot_check_types::Tag.nominal=>{let index=self.nominalIndex(Identity{node.a,node.b});if !index.present {return false,blot_error::Error.none;}let err=work.variants.appendSlice(self.types.list(self.nominals[index.value].constructors));if err!=blot_error::Error.none {return false,err;}},
 blot_check_types::Tag.unit,blot_check_types::Tag.record,blot_check_types::Tag.product=>{let err=work.variants.append(0);if err!=blot_error::Error.none {return false,err;}},
 _=>{for row in rows {if self.wildcard(row[0]) {let err=work.specialized.push(row[1..],coverage_rows);if err!=blot_error::Error.none {return false,err;}}}return self.covered(work.specialized.items,types[1..],depth+1,budget);},}
 for variant in work.variants.items {work.children.clear();work.words.clear();work.ranges.clear();work.specialized.clear();var record_payload=blot_support::none<blot_check_types::Node>();match node.tag {
 blot_check_types::Tag.nominal=>{let use_id,err=self.constructorStorageType(variant);if err!=blot_error::Error.none {return false,err;}let use=self.types.node(use_id);if use.tag==blot_check_types::Tag.function {let err=self.constrain(use.b,ty,0);if err!=blot_error::Error.none {return false,err;}let payload,err=self.types.resolve(use.a,0);if err!=blot_error::Error.none {return false,err;}let shape=self.types.node(payload);if shape.tag==blot_check_types::Tag.record {record_payload=blot_support::some(shape);for index in 0..shape.b {let err=work.children.append(self.types.recordField(shape,index).ty);if err!=blot_error::Error.none {return false,err;}}}else {let err=work.children.append(payload);if err!=blot_error::Error.none {return false,err;}}}},
 blot_check_types::Tag.product=>{let err=work.children.appendSlice(self.types.list(blot_check_types::List{node.a,node.b}));if err!=blot_error::Error.none {return false,err;}},
 blot_check_types::Tag.record=>{for index in 0..node.b {let err=work.children.append(self.types.recordField(node,index).ty);if err!=blot_error::Error.none {return false,err;}}},_=>{},}
 let arity=work.children.items.len;let err=work.children.appendSlice(types[1..]);if err!=blot_error::Error.none {return false,err;}for row in rows {let pattern=row[0];let wildcard=self.wildcard(pattern);var syntax=blot_parse_ast::Node{tag:blot_parse_ast::tag_pattern_name,a:0,b:0,c:0};if pattern!=0 {syntax=self.tree.node(pattern);}if !wildcard {var matches=false;match node.tag {blot_check_types::Tag.boolean=>{matches=syntax.tag==blot_parse_ast::tag_pattern_boolean && syntax.a==variant;},blot_check_types::Tag.unit=>{matches=syntax.tag==blot_parse_ast::tag_pattern_product && self.tree.children(pattern).len==0;},blot_check_types::Tag.nominal=>{matches=syntax.tag==blot_parse_ast::tag_pattern_constructor && self.constructor_resolved[pattern]==variant;},blot_check_types::Tag.product=>{matches=syntax.tag==blot_parse_ast::tag_pattern_product;},blot_check_types::Tag.record=>{matches=syntax.tag==blot_parse_ast::tag_pattern_record;},_=>{},}if !matches {continue;}}if work.words.items.len>0xffffffff {return false,blot_error::Error.type_limit;}let start=work.words.items.len as u32;for index in 0..arity {let err=work.words.append(0);if err!=blot_error::Error.none {return false,err;}}
 if !wildcard {match node.tag {
 blot_check_types::Tag.nominal=>{if arity!=0 {if record_payload.present {let record=record_payload.value;let payload=self.tree.node(syntax.b);if payload.tag==blot_parse_ast::tag_pattern_record {for field in self.tree.children(syntax.b) {let slot=self.projections[field];if slot<arity {work.words.items[start+slot]=self.tree.node(field).b;}}}else if record.b==1 {work.words.items[start]=syntax.b;}else if payload.tag==blot_parse_ast::tag_pattern_product {let fields=self.tree.children(syntax.b);if fields.len!=arity {continue;}for field,index in fields {work.words.items[start+index]=field;}}}else {work.words.items[start]=syntax.b;}}},
 blot_check_types::Tag.product=>{let fields=self.tree.children(pattern);if fields.len!=arity {continue;}for field,index in fields {work.words.items[start+index]=field;}},
 blot_check_types::Tag.record=>{for field in self.tree.children(pattern) {let slot=self.projections[field];if slot<arity {work.words.items[start+slot]=self.tree.node(field).b;}}},_=>{},}}
 let err=work.words.appendSlice(row[1..]);if err!=blot_error::Error.none {return false,err;}if arity+row.len-1>0xffffffff {return false,blot_error::Error.type_limit;}let err=work.ranges.push(blot_check_types::List{start,(arity+row.len-1) as u32},coverage_ranges);if err!=blot_error::Error.none {return false,err;}}
 for range in work.ranges.items {let err=work.specialized.push(work.words.items[range.start..range.start+range.len],coverage_rows);if err!=blot_error::Error.none {return false,err;}}let covered,err=self.covered(work.specialized.items,work.children.items,depth+1,budget);if err!=blot_error::Error.none || !covered {return covered,err;}}
 return true,blot_error::Error.none;
}
fn sourceImportDiagnostic(tree:const blot_parse_ast::Tree&)->blot_support::Option<Diagnostic> {if tree.diagnostics.len!=0 {return blot_support::none<Diagnostic>();}for id in tree.roots.items {if tree.node(id).tag==blot_parse_ast::tag_import_decl {let origin=tree.span(id).start;return blot_support::some(Diagnostic{code:Code.module_loader_required,node:id,span:blot_parse_ast::Span{origin,origin}});}}return blot_support::none<Diagnostic>();}
fn hasNumericFailure(tree:const blot_parse_ast::Tree&)->bool {for node in tree.nodes.items {if node.tag==blot_parse_ast::tag_numeric_error {return true;}}return false;}
