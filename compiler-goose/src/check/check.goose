fn Engine::scalarEffectAction(self:Engine&,signature:u32,arity:u8)->bool,blot_error::Error {if arity!=1 {return false,blot_error::Error.none;}let resolved,err=self.types.resolve(signature,0);if err!=blot_error::Error.none {return false,err;}let arrow=self.types.node(resolved);if arrow.tag!=blot_check_types::Tag.function {return false,blot_error::Error.none;}let input,err=self.types.resolve(arrow.a,0);if err!=blot_error::Error.none {return false,err;}let output,err=self.types.resolve(arrow.b,0);if err!=blot_error::Error.none {return false,err;}for tag in [self.types.node(input).tag,self.types.node(output).tag] {match tag {blot_check_types::Tag.unit,blot_check_types::Tag.boolean,blot_check_types::Tag.unsigned32,blot_check_types::Tag.floating32,blot_check_types::Tag.never=>{},_=>{return false,blot_error::Error.none;}}}let row,err=self.types.resolveEffects(arrow.c,0);if err!=blot_error::Error.none {return false,err;}return self.types.row(row).labels.len!=0,blot_error::Error.none;}
fn Engine::finishCapabilityRole(self:Engine&,id:u32)->blot_error::Error {let binding=self.bindings[id];if binding.capability_flow==CapabilityFlow.unknown {var source=self.tree.value_decl(binding.declaration).body;while self.tree.node(source).tag==blot_parse_ast::tag_group {source=self.tree.node(source).a;}if self.tree.node(source).tag==blot_parse_ast::tag_name {let target=self.resolved[source];if target!=0 {let flow=self.bindings[target].capability_flow;if flow==CapabilityFlow.consume_task || flow==CapabilityFlow.spawn_task {self.bindings[id].capability_flow=flow;}}}}if binding.capability_flow!=CapabilityFlow.input_shape {return blot_error::Error.none;}if binding.scheme.generative.len!=0 {self.bindings[id].capability_flow=CapabilityFlow.unknown;}else {let scalar,err=self.scalarEffectAction(binding.ty,binding.capability_parameters.arity());if err!=blot_error::Error.none {return err;}if scalar {self.bindings[id].capability_flow=CapabilityFlow.unknown;self.bindings[id].capability_parameters=blot_check_capability_flow::Parameters{};for entry,index in self.capability_roots {if entry.binding==id {for ordinal in index..self.capability_roots.len-1 {self.capability_roots[ordinal]=self.capability_roots[ordinal+1];}self.capability_roots.resize(self.capability_roots.len-1);break;}}}}return blot_error::Error.none;}
fn Engine::publishInputFunction(self:Engine&,id:u32,arity:u8)->bool,blot_error::Error {let binding=self.bindings[id];let declaration=self.tree.value_decl(binding.declaration);if binding.scheme.generative.len!=0 {return false,blot_error::Error.none;}let scalar,err=self.scalarEffectAction(binding.ty,arity);if err!=blot_error::Error.none || scalar {return false,err;}if blot_check_capability_flow::parameterArity(self.tree,declaration.body,declaration.annotation)!=arity {return false,blot_error::Error.none;}var prototype=blot_check_capability_contracts::Store{};let result,err=publishInputPrototype(self,id,arity,declaration.body,prototype);prototype.deinit();return result,err;}
