recursive fn summaryCondition(self_: Checker&, module: const Module&, inputs: SummaryInputs, id: u32, depth: i64) -> u32, Error {
    if id == 0 || depth >= 32 { return 0, blot_error::Error.none; } let err = self_.values.charge(1); if err != blot_error::Error.none { return 0, err; } let node = module.node(id);
    if node.tag == blot_check_core::Tag.reference { let reference = module.reference(id); if reference.unit != 0 && reference.unit != module.unit { return 0, blot_error::Error.none; } let value = inputs.lookup(reference.binding); if value.present { return value.value.condition, blot_error::Error.none; } }
    if node.tag == blot_check_core::Tag.call { let value, err = self_.summaryInvocation(module, inputs, id, depth); return value.condition, err; }
    if node.tag == blot_check_core::Tag.scalar && node.c == 0 && module.types.node(node.ty).tag == blot_check_types::Tag.boolean { let left, err = self_.summaryOperand(module, inputs, node.a, depth + 1); if err != blot_error::Error.none { return 0, err; } let right, err = self_.summaryOperand(module, inputs, node.b, depth + 1); if err != blot_error::Error.none { return 0, err; } return self_.comparison(node.op, left, right); }
    if node.tag == blot_check_core::Tag.logical && (node.op == blot_check_core::Op.and_ || node.op == blot_check_core::Op.or_) { let left, err = self_.summaryCondition(module, inputs, node.a, depth + 1); if err != blot_error::Error.none { return 0, err; } let right, err = self_.summaryCondition(module, inputs, node.b, depth + 1); if err != blot_error::Error.none || (left == 0 && right == 0) { return 0, err; } return self_.condition(Condition { op: node.op, left: left, right: right , ..}); }
    if node.tag == blot_check_core::Tag.if_value && module.types.node(node.ty).tag == blot_check_types::Tag.boolean { var condition, err = self_.summaryCondition(module, inputs, node.a, depth + 1); if err != blot_error::Error.none { return 0, err; } let then_node = module.node(node.b); let else_node = module.node(node.c);
        if then_node.tag == blot_check_core::Tag.constant && else_node.tag == blot_check_core::Tag.constant && module.types.node(then_node.ty).tag == blot_check_types::Tag.boolean && module.types.node(else_node.ty).tag == blot_check_types::Tag.boolean { if then_node.a == else_node.a { return 0, blot_error::Error.none; } if then_node.a != 0 { return condition, blot_error::Error.none; } return self_.condition(Condition { negated: true, left: condition , ..}); }
        for branch, index in [node.c, node.b] { let fixed = module.node(branch); if fixed.tag != blot_check_core::Tag.constant || module.types.node(fixed.ty).tag != blot_check_types::Tag.boolean { continue; } var other = node.b; if index == 1 { other = node.c; let changed, err = self_.condition(Condition { negated: true, left: condition , ..}); if err != blot_error::Error.none { return 0, err; } condition = changed; } let right, err = self_.summaryCondition(module, inputs, other, depth + 1); if err != blot_error::Error.none { return 0, err; } var op = blot_check_core::Op.and_; if fixed.a != 0 { op = blot_check_core::Op.or_; let changed, err = self_.condition(Condition { negated: true, left: condition , ..}); if err != blot_error::Error.none { return 0, err; } condition = changed; } return self_.condition(Condition { op: op, left: condition, right: right , ..}); }
    }
    if node.tag == blot_check_core::Tag.block_ { let value, err = self_.summaryBlock(module, inputs, id, [], depth); return value.condition, err; } if node.tag == blot_check_core::Tag.suite && module.children(id).len == 1 { return self_.summaryCondition(module, inputs, module.children(id)[0], depth + 1); } if node.tag == blot_check_core::Tag.return_ { return self_.summaryCondition(module, inputs, node.a, depth + 1); } return 0, blot_error::Error.none;
}
recursive fn call(self_: Checker&, id: u32, raw: blot_check_core::BindingRef, callee_type: u32, arguments: const u32[:], depth: i64)->Value, Error {var actual:Values=Values{..};var substituted:Ids=Ids{..};let result,error=callValue(self_,id,raw,callee_type,arguments,depth,actual,substituted);blot_support_pooled_buffer::deinit(substituted,id_scratch);blot_support_pooled_buffer::deinit(actual,value_scratch);return result,error;}
recursive fn callValue(self_: Checker&, id: u32, raw: blot_check_core::BindingRef, callee_type: u32, arguments: const u32[:], depth: i64,actual:Values&,substituted:Ids&)->Value, Error {
    let selected, err = self_.target(raw); if err != blot_error::Error.none { return Value {..}, err; } let header .= contract(selected.module, selected.binding); for argument in arguments { let value, err = self_.walk(argument, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let stored=blot_support_pooled_buffer::push(actual,value,value_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} }
    if header { let err = signatureTypes(self_.module.types, callee_type, header); if err != blot_error::Error.none { return Value {..}, err; } if arguments.len > header.arity { return Value {..}, blot_error::Error.invalid_artifact; } let sized=blot_support_pooled_buffer::ensure(substituted,arguments.len,id_scratch); if sized!=blot_error::Error.none {return Value{..},sized;} setIdLength(substituted,arguments.len); for &value in substituted.items { value = 0; }
