fn deinit(self: Store&) { if self.lease==0 { return; } assert(valid(self)); self.proofs.deinit(); self.arguments.deinit(); self.members.deinit(); self.edges.deinit(); self.active_arguments.deinit(); self.active.deinit(); self.active_projections.deinit(); self.provisional_equations.deinit(); self.provisional_mappings.deinit(); self.provisional_rows.deinit(); self.next.deinit(); self.active_facts.deinit(); release(self.buckets); release(self.facts); let at=self.lease-1; states[at].live=false; states.free(at); let handle=self.handle_index; self=Store {}; if handle>=0 { handles.free(handle); } }
fn reset(self: Store) { assert(valid(self)); self.proofs.clear(); self.arguments.clear(); self.members.clear(); self.edges.clear(); self.active_arguments.clear(); self.active.clear(); self.active_projections.clear(); self.provisional_equations.clear(); self.provisional_mappings.clear(); self.provisional_rows.clear(); self.next.clear(); self.active_facts.clear(); self.buckets.clear(); self.facts.clear(); self.trace=blot_eval_implementation_trace::Record {}; self.failure=blot_support::none<Code>(); self.candidates=0; self.prerequisite_edges=0; self.hits=0; self.max_depth=0; self.owner_id=blot_native::fresh_owner_id(); }

struct LongWords { storage: u64[:]=[],items: u64[:]=[],len: i64=0,failure: Error=Error.none }
reusable[] var pool_LongWords: u64[>..]=[];
fn ensure(self: LongWords&,minimum: i64) -> Error { if self.failure!=Error.none { return self.failure; } let error=blot_support_pooled_buffer::ensure(self,minimum,pool_LongWords); if error!=Error.none { self.failure=error; } return error; }
fn push(self: LongWords&,value: u64) { if self.failure!=Error.none { return; } self.failure=blot_support_pooled_buffer::push(self,value,pool_LongWords); self.len=self.items.len; }
fn append(self: LongWords&,values: const u64[:]) { if self.failure!=Error.none { return; } self.failure=blot_support_pooled_buffer::append(self,values,pool_LongWords); self.len=self.items.len; }
fn resize(self: LongWords&,length: i64) { blot_support_pooled_buffer::resize(self,length); self.len=length; }
fn resize(self: LongWords&,length: i64,value: u64) { if length<=self.len { resize(self,length); return; } let error=ensure(self,length); if error!=Error.none { return; } for index in self.len..length { self.storage[index]=value; } self.items=self.storage[..length]; self.len=length; }
fn clear(self: LongWords&) { blot_support_pooled_buffer::clear(self); self.len=0; self.failure=Error.none; }
fn deinit(self: LongWords&) { blot_support_pooled_buffer::deinit(self,pool_LongWords); self.len=0; self.failure=Error.none; }
