import * as text from "std/text"
import { decimal, digit } from "./literals"

func letter (ch: U32): Bool => return
  (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or ch == 95

func word_char (ch: U32): Bool => return letter ch or digit ch or ch == 46 or ch == 45

func tokenize (source: Text): Result [#[Text], Text] =>
  let tokens: #[Text] = #[]
  let i = 0
  for ever:
    if i == source.length:
      return $Ok tokens
    let ch = source[i]
    let next = if i + 1 < source.length then source[i + 1] else 0
    if text.is_whitespace ch:
      i := self + 1
      continue
    if ch == 47 and next == 47:
      i := self + 2
      for j in i..source.length:
        if source[j] == 10:
          break
        i := self + 1
      continue
    if ch == 47 and next == 42:
      i := self + 2
      let levels = 1
      for ever:
        if levels == 0:
          break
        if i + 1 >= source.length:
          return $Err "Unterminated WGSL block comment"
        let a = source[i]
        let b = source[i + 1]
        if a == 47 and b == 42:
          levels := self + 1
          i := self + 2
          continue
        if a == 42 and b == 47:
          levels := self - 1
          i := self + 2
        else:
          i := self + 1
      continue
    if word_char ch:
      let start = i
      i := self + 1
      for j in i..source.length:
        let cur = source[j]
        let prev = source[j - 1]
        let exp_plus = cur == 43 and (prev == 101 or prev == 69)
        if not (word_char cur or exp_plus):
          break
        i := self + 1
      @storage.push tokens (@array.generate (i - start) (func j => return source[start + j]))
      continue
    @storage.push tokens #[ch]
    i := self + 1

func token (tokens: #[Text]) -> (i: U32): Text =>
  return if i < tokens.length then copy tokens[i] else ""

func is_token (tokens: #[Text]) -> (i: U32) -> (expected: Text): Bool =>
  return i < tokens.length and text.equal tokens[i] expected

func is_reserved_keyword (name: Text): Bool =>
  let reserved: #[Text] = #[
    "and", "as", "break", "case", "const", "continue", "copy", "data", "do",
    "effect", "else", "ever", "export", "false", "for", "fork", "freeze",
    "froM", "func", "if", "impl", "import", "in", "infix", "infixl", "infixr",
    "is", "let", "not", "of", "opaque", "or", "own", "private", "return",
    "seal", "self", "spark", "test", "then", "true", "type", "use", "where",
    "wherE", "with", "yield",
  ]
  for word in reserved:
    if text.equal name word:
      return true
  return false

func identifier (name: Text) -> (upper: Bool): Bool =>
  if name.length == 0 or text.equal name "_":
    return false
  let ch = name[0]
  if upper:
    if ch < 65 or ch > 90:
      return false
  else:
    if not ((ch >= 97 and ch <= 122) or ch == 95):
      return false
  for scalar in name:
    if not (letter scalar or digit scalar):
      return false
  return true

func field_type (ty: Text): Text =>
  if text.equal ty "f32":
    return "F32"
  if text.equal ty "u32":
    return "U32"
  if text.equal ty "bool":
    return "Bool"
  if text.equal ty "vec2f":
    return "#[2; F32]"
  if text.equal ty "vec3f":
    return "#[3; F32]"
  if text.equal ty "vec4f":
    return "#[4; F32]"
  return ""

func read_struct (tokens: #[Text]) -> (start: U32): Result [(Text, U32), Text] =>
  let name = token tokens (start + 1)
  if not (identifier name true) or not (is_token tokens (start + 2) "{"):
    return $Err "Expected WGSL struct Name { ... } with an uppercase name"
  let out = text.builder ()
  out := text.append "type " self
  out := text.append name self
  out := text.append " is data = $" self
  out := text.append name self
  out := text.append " { " self
  let i = start + 3
  let first = true
  for ever:
    let field = token tokens i
    if not (identifier field false) or not (is_token tokens (i + 1) ":"):
      return $Err (text.concat "Expected a WGSL field and type in " name)
    if is_reserved_keyword field:
      return $Err (text.join "" #["WGSL field '", field, "' in ", name, " collides with a reserved Blot keyword"])
    let ty = field_type (token tokens (i + 2))
    if ty.length == 0:
      return $Err (text.concat "Unsupported WGSL field type in " name)
    let prefix = if first then "" else ", "
    let member = text.join "" #[prefix, field, ": ", ty]
    out := text.append member self
    first := false
    i := self + 3
    if is_token tokens i ",":
      i := self + 1
    else:
      if not (is_token tokens i "}"):
        return $Err (text.concat "Expected ',' or '}' after WGSL field in " name)
    if is_token tokens i "}":
      break
  i := self + 1
  if is_token tokens i ";":
    i := self + 1
  return $Ok (text.finish (text.append " }\n" out), i)

func float_literal (raw: Text): Maybe Text =>
  if raw.length == 0:
    return $Nothing
  let end = if raw[raw.length - 1] == 102 then raw.length - 1 else raw.length
  if end == 0:
    return $Nothing
  let exp_at = end
  for i in 0..end:
    if raw[i] == 101 or raw[i] == 69:
      exp_at := i
      break
  if exp_at == end:
    let body = @array.generate end (func i => raw[i])
    return decimal body
  let mantissa = @array.generate exp_at (func i => raw[i])
  let $Some canon = decimal mantissa else:
    return $Nothing
  let exp_start = exp_at + 1
  if exp_start >= end:
    return $Nothing
  let digits_start = if raw[exp_start] == 43 or raw[exp_start] == 45 then exp_start + 1 else exp_start
  if digits_start >= end:
    return $Nothing
  for i in digits_start..end:
    if not (digit raw[i]):
      return $Nothing
  let out = text.builder ()
  out := text.append canon self
  out := text.push 101 self
  for i in exp_start..end:
    out := text.push raw[i] self
  return $Some (text.finish out)

func constant (raw: Text): Maybe (Text, Text) =>
  if text.equal raw "true" or text.equal raw "false":
    return $Some ("Bool", copy raw)
  if raw.length == 0:
    return $Nothing
  if raw[raw.length - 1] == 117:
    let $Some value = text.parse_u32 (&raw[0..raw.length - 1]) else:
      return $Nothing
    return $Some ("U32", text.from_u32 value)
  let is_float = raw[raw.length - 1] == 102
  for scalar in raw:
    if scalar == 46 or scalar == 101 or scalar == 69:
      is_float := true
      break
  if not is_float:
    let $Some int_value = text.parse_u32 raw else:
      return $Nothing
    return $Some ("U32", text.from_u32 int_value)
  let $Some value = float_literal raw else:
    return $Nothing
  return $Some ("F32", value)

func read_const (tokens: #[Text]) -> (start: U32): Result [(Text, U32), Text] =>
  let name = token tokens (start + 1)
  if not (identifier name false) or not (is_token tokens (start + 2) "=") or not (is_token tokens (start + 4) ";"):
    return $Err "Expected WGSL const name = literal;"
  if is_reserved_keyword name:
    return $Err (text.join "" #["WGSL constant '", name, "' collides with a reserved Blot keyword"])
  let $Some (ty, literal) = constant (token tokens (start + 3)) else:
    return $Err (text.concat "Unsupported WGSL constant value for " name)
  return $Ok (text.join "" #["const ", name, ": ", ty, " = ", literal, "\n"], start + 5)

func generate_declarations (tokens: #[Text]): Result [Text, Text] =>
  let out = text.builder ()
  let nesting = 0
  let i = 0
  for ever:
    if i == tokens.length:
      break
    if nesting == 0 and (is_token tokens i "struct" or is_token tokens i "const"):
      let declaration = if is_token tokens i "struct" then read_struct tokens i else read_const tokens i
      case declaration of
        $Ok (generated, next) => do:
          out := text.append generated self
          i := next
        $Err message => do:
          return $Err (copy message)
    else:
      if is_token tokens i "{":
        nesting := self + 1
      if is_token tokens i "}":
        if nesting == 0:
          return $Err "Unexpected '}' in WGSL"
        nesting := self - 1
      i := self + 1
  if nesting != 0:
    return $Err "Unclosed WGSL block"
  return $Ok (text.finish out)


io generate (source: Text): Result [Text, Text] =>
  return case tokenize source of
    $Ok tokens => generate_declarations tokens
    $Err message => $Err (copy message)
