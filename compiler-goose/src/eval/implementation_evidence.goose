fn contains(self: const FactsMap&,key: FactKey) -> bool { return self.get(key)!=null; }
fn insert(self: FactsMap&,key: FactKey,value: u32) { var view=blot_support_pooled_map::Map<FactKey,u32> {count:self.count,slots:self.slots}; blot_support_pooled_map::insert(view,key,value,pool_FactsMap); self.count=view.count; self.slots=view.slots; }
fn clear(self: FactsMap&) { for &slot in self.slots { slot.tag=0; } self.count=0; }
fn release(self: FactsMap&) { if self.slots.len!=0 { pool_FactsMap.free_slice(self.slots); } self.slots=[]; self.count=0; }
fn restore(self: FactsMap&,slots: const dictionary_slot<FactKey,u32>[:],count: i64) { release(self); self.count=count; if slots.len!=0 { self.slots=pool_FactsMap.alloc_slice(slots.len); for slot,index in slots { self.slots[index]=slot; } } }
struct State { proofs: ProofsBuffer=ProofsBuffer {},arguments: ArgumentsBuffer=ArgumentsBuffer {},members: MembersBuffer=MembersBuffer {},edges: ArgumentsBuffer=ArgumentsBuffer {},active_arguments: ArgumentsBuffer=ArgumentsBuffer {},active: ActiveBuffer=ActiveBuffer {},active_projections: ActiveProjectionsBuffer=ActiveProjectionsBuffer {},provisional_equations: ProvisionalEquationsBuffer=ProvisionalEquationsBuffer {},provisional_mappings: ProvisionalMappingsBuffer=ProvisionalMappingsBuffer {},provisional_rows: ProvisionalRowsBuffer=ProvisionalRowsBuffer {},next: ArgumentsBuffer=ArgumentsBuffer {},active_facts: ActiveFactsBuffer=ActiveFactsBuffer {},buckets: BucketsMap=BucketsMap {},facts: FactsMap=FactsMap {},owner_id: u64=0,trace: blot_eval_implementation_trace::Record=blot_eval_implementation_trace::Record {},failure: blot_support::Option<Code>=blot_support::none<Code>(),candidates: u64=0,prerequisite_edges: u64=0,hits: u64=0,max_depth: i64=0,generation: u64=0,live: bool=false }
reusable var states: State[>..]=[];
var inactive: State=State {};
var next_generation: u64=1;
struct Store { proofs: ProofsBuffer&=inactive.proofs,arguments: ArgumentsBuffer&=inactive.arguments,members: MembersBuffer&=inactive.members,edges: ArgumentsBuffer&=inactive.edges,active_arguments: ArgumentsBuffer&=inactive.active_arguments,active: ActiveBuffer&=inactive.active,active_projections: ActiveProjectionsBuffer&=inactive.active_projections,provisional_equations: ProvisionalEquationsBuffer&=inactive.provisional_equations,provisional_mappings: ProvisionalMappingsBuffer&=inactive.provisional_mappings,provisional_rows: ProvisionalRowsBuffer&=inactive.provisional_rows,next: ArgumentsBuffer&=inactive.next,active_facts: ActiveFactsBuffer&=inactive.active_facts,buckets: BucketsMap&=inactive.buckets,facts: FactsMap&=inactive.facts,owner_id: u64&=inactive.owner_id,trace: blot_eval_implementation_trace::Record&=inactive.trace,failure: blot_support::Option<Code>&=inactive.failure,candidates: u64&=inactive.candidates,prerequisite_edges: u64&=inactive.prerequisite_edges,hits: u64&=inactive.hits,max_depth: i64&=inactive.max_depth,lease: u32=0,generation: u64=0,handle_index: i64=-1 }
reusable var handles: Store[>..]=[];
fn initPooled() -> Store,Error { if next_generation==0xffffffffffffffff||states.len>=0xffffffff { return Store {},Error.out_of_memory; } let generation=next_generation; next_generation++; let index=states.alloc_index(State {owner_id:blot_native::fresh_owner_id(),generation:generation,live:true}); let state: State&=states[index]; return Store {proofs:state.proofs,arguments:state.arguments,members:state.members,edges:state.edges,active_arguments:state.active_arguments,active:state.active,active_projections:state.active_projections,provisional_equations:state.provisional_equations,provisional_mappings:state.provisional_mappings,provisional_rows:state.provisional_rows,next:state.next,active_facts:state.active_facts,buckets:state.buckets,facts:state.facts,owner_id:state.owner_id,trace:state.trace,failure:state.failure,candidates:state.candidates,prerequisite_edges:state.prerequisite_edges,hits:state.hits,max_depth:state.max_depth,lease:(index+1) as u32,generation:generation},Error.none; }
fn initPooledRef() -> Store?,Error { let initialized,error=initPooled(); if error!=Error.none { return null,error; } let at=handles.alloc_index(initialized); handles[at].handle_index=at; return handles[at],Error.none; }
fn valid(self: Store) -> bool { return self.lease!=0&&self.lease-1<states.len&&states[self.lease-1].live&&states[self.lease-1].generation==self.generation; }
fn remove(self: BucketsMap&,key: u64) -> bool { var view=blot_support_pooled_map::Map<u64,u32> {count:self.count,slots:self.slots}; let removed=blot_support_pooled_map::remove(view,key); self.count=view.count; self.slots=view.slots; return removed; }
fn remove(self: FactsMap&,key: FactKey) -> bool { var view=blot_support_pooled_map::Map<FactKey,u32> {count:self.count,slots:self.slots}; let removed=blot_support_pooled_map::remove(view,key); self.count=view.count; self.slots=view.slots; return removed; }
fn view(self: const Store&) -> View { return View {self.owner_id,self.proofs.items,self.arguments.items,self.members.items,self.edges.items}; }
struct SnapshotTables { proofs: Proof[>..]&,arguments: u32[>..]&,members: Member[>..]&,edges: u32[>..]& }
fn copyOwned(self: const Store&,target: SnapshotTables) -> Snapshot,Error { let p=target.proofs.len; let a=target.arguments.len; let m=target.members.len; let e=target.edges.len; target.proofs.append(self.proofs.items); target.arguments.append(self.arguments.items); target.members.append(self.members.items); target.edges.append(self.edges.items); return Snapshot {proofs:target.proofs[p..],arguments:target.arguments[a..],members:target.members[m..],edges:target.edges[e..]},Error.none; }
struct Work<H> { store: Store,host: H&,error: Error=Error.none }
fn fail<H>(w: Work<H>&,error: Error) -> u32 { if w.error==Error.none { w.error=error; } return 0; }
fn take<H>(w: Work<H>&,value: u32,error: Error) -> u32 { if error!=Error.none { return fail(w,error); } return value; }
fn step<H>(w: Work<H>&) -> bool {
