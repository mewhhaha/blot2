recursive fn owned(module:const Module&,context:Context,admission:Admission&)->Error {let workspace .= admission.workspace;if workspace && workspace.proved(module) {return blot_error::Error.none;}for index in 0..admission.count {let prior=admission.units[index];if prior!=0 && prior==module.owner_id {return blot_error::Error.none;}}if admission.count>=admission.units.len {return blot_error::Error.invalid_artifact;}let prior_count=admission.count;admission.units[admission.count]=module.owner_id;admission.count+=1;let error=ownedValue(module,context,admission,prior_count);if error!=blot_error::Error.none {admission.count=prior_count;}return error;}
recursive fn ownedValue(module: const Module&, context: Context, admission: Admission&, prior_count: i64) -> Error {
    var scopes = ownedViews(module.types, admission.remaining, module.obligations);
    let error = scopes.initialize();
    if error != blot_error::Error.none {
        return error;
    }
    var walker = sourceBodyWalker(module, context, scopes, admission);
    if module.bindings.len > 4096 || module.nodes.len > 4096 {
        return blot_error::Error.invalid_artifact;
    }
    for binding in module.bindings {
        if binding.kind != blot_reuse_principal_interface::Kind.external {
            continue;
        }
        let reference = binding.target;
        if reference.unit == 0 || reference.unit == module.unit {
            if binding.scheme.closed_rows.len != 0 {
                return blot_error::Error.invalid_artifact;
            }
            continue;
        }
        let selected, error = headerModule(catalog(context), module, reference.unit);
        if error != blot_error::Error.none {
            return error;
        }
        if !selected {
            return blot_error::Error.invalid_artifact;
        }
        let owner .= selected;
        let error = blot_check_scheme_equations::bounds(owner, blot_check_frozen_core_validation::Context {
            units: context.units, ..
        }
        );
        if error != blot_error::Error.none {
            return error;
        }
        if reference.binding == 0 || reference.binding >= owner.bindings.len {
            return blot_error::Error.invalid_artifact;
        }
        let original = owner.bindings[reference.binding];
        if binding.scheme.closed_rows.len == 0 && original.scheme.closed_rows.len == 0 {
            continue;
        }
        if original.kind != blot_reuse_principal_interface::Kind.global || owner.body(reference.binding) == null {
            return blot_error::Error.invalid_artifact;
        }
        let error = owned(owner, context, admission);
        if error != blot_error::Error.none {
            return error;
        }
        let error = certifiedImport(module, owner, original.scheme, binding.scheme, admission.remaining);
        if error != blot_error::Error.none {
            return error;
        }
    }
    var opening_slots = blot_check_package_contracts::Bits4096 {
        ..
    };
    var opening_bindings = blot_check_package_contracts::Bits4096 {
        ..
    };
    for node, id in module.nodes {
        if node.tag != blot_check_core::Tag.package_unpack {
            continue;
        }
        if opening_bindings.isSet(node.b) {
            return blot_error::Error.invalid_artifact;
        }
        opening_bindings.set(node.b);
        let opening = module.packageOpening(id as u32);
        for binder, ordinal in module.types.list(opening.binders) {
            let leaf = module.types.node(binder);
            if leaf.tag != blot_check_types::Tag.bound || leaf.a != ordinal || leaf.b != 0 || leaf.c != node.b || opening_slots.isSet(binder) {
                return blot_error::Error.invalid_artifact;
            }
            opening_slots.set(binder);
        }
    }
    for node, id in module.types.nodes {
        if node.tag == blot_check_types::Tag.bound && node.b == 0 && node.c != 0 && !opening_slots.isSet(id) {
            return blot_error::Error.invalid_artifact;
        }
    }
    for body in module.bodies {
        let error = walker.proveBody(body);
        if error != blot_error::Error.none {
            return error;
        }
    }
    let workspace .= admission.workspace;
    if workspace && prior_count == 0 {
        for index in 0 .. admission.count {
            let proved = admission.units[index];
            if blot_check_scheme_equations::provedOwner(workspace, proved) {
                continue;
            }
            if workspace.module_count >= workspace.modules.len {
                return blot_error::Error.invalid_artifact;
            }
            workspace.modules[workspace.module_count] = proved;
            workspace.module_count +=1;
        }
    }
    return blot_error::Error.none;
}
fn certifiedImport(module: const Module&, owner: const Module&, expected: blot_check_types::Scheme, actual: blot_check_types::Scheme, remaining: i64&) -> Error {
    var views = Views {
        types: module.types, remaining: remaining, obligations: module.obligations, ..
    };
    let error = views.initialize();
    if error != blot_error::Error.none {
        return error;
    }
    let error = views.generic(actual);
    if error != blot_error::Error.none {
        return error;
    }
    for row, id in module.types.effects.rows {
        match row.tail {
            variable tail => {
                for variable in module.types.list(actual.closed_rows) {
                    if remaining == 0 {
                        return blot_error::Error.invalid_artifact;
                    }
                    remaining -=1;
                    if tail.value != variable {
                        continue;
                    }
                    let error = views.closed_rows.set(id);
                    if error != blot_error::Error.none {
                        return error;
                    }
                    if row.labels.len == 0 {
                        let error = views.pure_rows.set(id);
                        if error != blot_error::Error.none {
                            return error;
                        }
                    }
                }
            }, _ => {
            },
        }
    }
    let error = blot_check_package_contracts::certifiedEndpoint(owner.types, module.types, remaining, views, expected, actual, owner.obligations[expected.obligations.start .. expected.obligations.start + expected.obligations.len], module.obligations[actual.obligations.start .. actual.obligations.start + actual.obligations.len]);
    if error != blot_error::Error.none {
        return error;
    }
    return blot_error::Error.none;
}

struct Walker {
 module:const Module&,origin:const Module?=null,resolver_callback:u32=0,context:Context,scopes:Views&,admission:Admission&,
 sealed:blot_check_package_contracts::Bits4096=blot_check_package_contracts::Bits4096{..},definitions:u32[4096]=[0;4096],definitions_indexed:bool=false,
 row_index:u32[4096]=[0;4096],row_index_len:i64=0,rows_indexed:bool=false,source_row_index:const u32[:]=default<const u32[:]>(),has_source_row_index:bool=false,
 closed_rows:List=List{..},foreign_allowed:bool=false,body_row:u32=0,goal_depth:i64=0,handled:u32[128]=[0;128],handled_count:i64=0,
 scope_owner:i64=0,return_owner:i64=0,loop_owner:i64=0,decision_owner:i64=0,call_owner:u32=0
}
fn knownInstance(self_:Walker&,instance:blot_check_types::NominalIdentity)->bool,Error {return self_.knownInstanceDepth(instance,0);}
recursive fn knownInstanceDepth(self_:Walker&,instance:blot_check_types::NominalIdentity,depth:i64)->bool,Error {let error=self_.step(depth);if error!=blot_error::Error.none {return false,error;}if instance.decl==0 {return instance.unit==0,blot_error::Error.none;}var owner_id=self_.scope_owner;while owner_id!=0 {let owner=blot_check_package_owner_frames::scope(owner_id);let error=self_.step(0);if error!=blot_error::Error.none {return false,error;}if owner.unit==instance.unit && owner.decl==instance.decl {return true,blot_error::Error.none;}owner_id=owner.parent;}if instance.unit==0 && instance.decl<self_.module.types.nodes.len {let selected=self_.module.types.node(instance.decl);if selected.tag!=blot_check_types::Tag.instance_selection {return false,blot_error::Error.none;}let choices=self_.module.types.nominalArguments(selected);if choices.len!=2 && choices.len!=3 {return false,blot_error::Error.invalid_artifact;}for choice in choices[..2] {let capability=self_.module.types.node(choice);if capability.tag!=blot_check_types::Tag.scoped {return false,blot_error::Error.invalid_artifact;}let known,error=self_.knownInstanceDepth(blot_check_types::NominalIdentity{unit:capability.b,decl:capability.c, ..},depth+1);if error!=blot_error::Error.none || !known {return false,error;}}return true,blot_error::Error.none;}return false,blot_error::Error.none;}
fn operationAuthority(self_:Walker&,operation:blot_check_core::OperationValue)->Error {let known,error=self_.knownInstance(operation.instance);if error!=blot_error::Error.none {return error;}if operation.witness!=0 || operation.witness_result!=0 || !known {return blot_error::Error.invalid_artifact;}if operation.instance.decl==0 {return require(operation.capability==0);}if operation.capability==0 {return blot_error::Error.invalid_artifact;}let capability=self_.module.types.node(self_.module.typeOf(operation.capability));return require(capability.tag==blot_check_types::Tag.scoped && capability.b==operation.instance.unit && capability.c==operation.instance.decl);}
fn step(self_:Walker&,depth:i64)->Error {if depth>=128 || self_.scopes.remaining==0 {return blot_error::Error.invalid_artifact;}self_.scopes.remaining-=1;return blot_error::Error.none;}
fn units(self_:Walker&)->const ModuleRef[:] {return self_.context.units;}
fn same(self_:Walker&,first:u32,second:u32)->Error {var proof=blot_check_package_contracts::PrincipalState{foreign_views:true, ..};return blot_check_package_contracts::validateEndpointState(proof,self_.module.types,self_.scopes.remaining,self_.scopes,first,second);}
fn strictSame(self_:Walker&,first:u32,second:u32)->Error {return blot_check_package_contracts::validateEndpoint(self_.module.types,self_.scopes.remaining,self_.scopes,first,second);}
fn scheme(self_:Walker&,value:blot_check_types::Scheme)->Error {return self_.schemeFor(value,0);}

var inactive_types=blot_check_core::Types{nodes:default<const blot_check_types::Node[:]>(),extra:default<const u32[:]>(), ..};var inactive_budget:i64=0;
fn invalidPrincipal()->Principal {return Principal{left:inactive_types,right:inactive_types,remaining:inactive_budget, ..};}
fn instancePrincipal(left:const blot_check_core::Types&,right:const blot_check_core::Types&,remaining:i64&,views:Views&)->Principal {
 return blot_check_package_contracts::principalFromState(left,right,remaining,views,blot_check_package_contracts::PrincipalState{foreign_views:true,..});
}
fn principalVersions(proof:Principal&,versions:const blot_check_package_contracts::VersionPair[:]) {proof.version_pairs=versions;}
fn wordContains(values:const u32[:],wanted:u32)->bool {for value in values {if value==wanted {return true;}}return false;}
recursive fn proveBody(self_:Walker&,body:blot_check_core::Body)->Error {if body.root==0 {return blot_error::Error.none;}self_.return_owner=0;self_.loop_owner=0;self_.decision_owner=0;let root=self_.module.node(body.root);if root.tag==blot_check_core::Tag.contract_method {if root.a>=self_.module.member_templates.len {return blot_error::Error.invalid_artifact;}let template=self_.module.member_templates[root.a];return require(template.binding==body.binding && body.is_function && root.c==body.parameters.len && body.scheme==self_.module.binding(body.binding).scheme);}self_.scopes.pure_rows=blot_check_package_row_facts::Facts{..};self_.scopes.closed_rows=blot_check_package_row_facts::Facts{..};self_.closed_rows=body.closed_rows;let error=self_.closeRows(body.closed_rows);if error!=blot_error::Error.none {return error;}let error=self_.providerRows(body.root,0);if error!=blot_error::Error.none {return error;}let signature=self_.module.binding(body.binding).ty;let row,error=self_.effectSignature(signature,body.parameters.len);if error!=blot_error::Error.none {return error;}self_.body_row=row;self_.foreign_allowed=self_.rowHasForeign(row);let error=self_.scopes.generic(body.scheme);if error!=blot_error::Error.none {return error;}let error=self_.scopes.visit(signature);if error!=blot_error::Error.none {return error;}let error=self_.same(signature,body.scheme.root);if error!=blot_error::Error.none {return error;}let error=self_.schemeFor(body.scheme,body.binding);if error!=blot_error::Error.none {return error;}let parent=self_.scope_owner;let error=proveBodyScoped(self_,body,signature);blot_check_package_owner_frames::restoreScopes(self_.scope_owner,parent);return error;}
recursive fn proveBodyScoped(self_:Walker&,body:blot_check_core::Body,signature:u32)->Error {
