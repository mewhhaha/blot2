        for word in 1..bytes / 4 {if point + 2 >= code.len || code[point].op != blot_backend_runtime_ir::OP_local_get || code[point].operand != local || code[point + 2].op != blot_backend_runtime_ir::OP_i32_store || code[point + 2].operand != word * 4 {return blot_support::none<Construction>();}let value = code[point + 1];
            if word == 1 {if value.op == blot_backend_runtime_ir::OP_i32_const {if value.operand != 0 || value.table_reference {return blot_support::none<Construction>();}}else if value.op == blot_backend_runtime_ir::OP_local_get {if value.operand == local || value.operand >= body.parameters.len + module.locals(body).len {return blot_support::none<Construction>();}if value.operand < body.parameters.len {if module.parameters(body)[value.operand] != blot_backend_runtime_ir::VT_i32 || blot_backend_runtime_ir::parameterRole(body,value.operand) != environment_role {return blot_support::none<Construction>();}}else if module.locals(body)[value.operand - body.parameters.len] != blot_backend_runtime_ir::VT_i32 {return blot_support::none<Construction>();}result.environment = Environment.local {value: value.operand};}else {return blot_support::none<Construction>();}}
            else if value.op != blot_backend_runtime_ir::OP_i32_const || value.operand != 0 || value.table_reference {return blot_support::none<Construction>();}point += 3;
