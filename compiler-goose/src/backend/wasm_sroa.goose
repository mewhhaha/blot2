let none:u32=0xffffffff;
struct Value {id:u32=0,offset:u32=0,constant:blot_support::Option<u32> =blot_support::none<u32>(),get:u32=none}
struct Node {parent:u32,copies:u8=0,empty:bool=false,bad:bool=false,size:u32=0,allocation:bool=false,first_copy:u32=none,last_store:u32=0,store_mask:u32=0,scope:i64=0,fields:u32=0,used_fields:u16=0,journaled:bool=false,untyped:bool=false,reference_fields:u16=0,roots:u32=0,root_fields:u16=0,shared_roots:bool=false,nullable:bool=false,journal_carrier:bool=false,zero_fields:u16=0,nonzero_fields:u16=0,control_start:i64=0,control_end:i64=0,vector:bool=false,first_store:u32=none,read:bool=false}
struct Box {value:Value,at:u32}
struct Event {input:Value=Value{..},stored:Value=Value{..},destination:u32=0,field:u32=0,allocation:u32=0,fresh:bool=false,static_words:bool=false,empty:bool=false,loop_scope:i64=0,nonzero:bool=false,boxed:bool=false,unbox:bool=false}
struct Control {height:i64,result:u32,unreachable_:bool=false,entry_unreachable:bool=false,conditional:bool=false,has_else:bool=false,then_live:bool=false,has_exit:bool=false,identity:i64=0,loop_:bool=false}
struct Nodes {storage:Node[:] = default<Node[:]>(),items:Node[:] = default<Node[:]>(),len:i64=0}
reusable[] var pool_Nodes:Node[>..]=[];
fn push(self_:Nodes&,value:Node)->Error {let error=blot_support_pooled_buffer::push(self_,value,pool_Nodes);self_.len=self_.items.len;return error;}
fn pop(self_:Nodes&)->Node {assert(self_.len!=0);let value=self_.items[self_.len-1];self_.resize(self_.len-1);return value;}
fn resize(self_:Nodes&,length:i64) {blot_support_pooled_buffer::resize(self_,length);self_.len=length;}
fn clear(self_:Nodes&) {self_.resize(0);}
fn deinit(self_:Nodes&) {blot_support_pooled_buffer::deinit(self_,pool_Nodes);self_.len=0;}
struct Values {storage:Value[:] = default<Value[:]>(),items:Value[:] = default<Value[:]>(),len:i64=0}
reusable[] var pool_Values:Value[>..]=[];
fn push(self_:Values&,value:Value)->Error {let error=blot_support_pooled_buffer::push(self_,value,pool_Values);self_.len=self_.items.len;return error;}
fn pop(self_:Values&)->Value {assert(self_.len!=0);let value=self_.items[self_.len-1];self_.resize(self_.len-1);return value;}
fn resize(self_:Values&,length:i64) {blot_support_pooled_buffer::resize(self_,length);self_.len=length;}
fn clear(self_:Values&) {self_.resize(0);}
fn deinit(self_:Values&) {blot_support_pooled_buffer::deinit(self_,pool_Values);self_.len=0;}
struct Controls {storage:Control[:] = default<Control[:]>(),items:Control[:] = default<Control[:]>(),len:i64=0}
reusable[] var pool_Controls:Control[>..]=[];
fn push(self_:Controls&,value:Control)->Error {let error=blot_support_pooled_buffer::push(self_,value,pool_Controls);self_.len=self_.items.len;return error;}
fn pop(self_:Controls&)->Control {assert(self_.len!=0);let value=self_.items[self_.len-1];self_.resize(self_.len-1);return value;}
fn resize(self_:Controls&,length:i64) {blot_support_pooled_buffer::resize(self_,length);self_.len=length;}
fn clear(self_:Controls&) {self_.resize(0);}
fn deinit(self_:Controls&) {blot_support_pooled_buffer::deinit(self_,pool_Controls);self_.len=0;}
struct Boxes {storage:Box[:] = default<Box[:]>(),items:Box[:] = default<Box[:]>(),len:i64=0}
reusable[] var pool_Boxes:Box[>..]=[];
fn push(self_:Boxes&,value:Box)->Error {let error=blot_support_pooled_buffer::push(self_,value,pool_Boxes);self_.len=self_.items.len;return error;}
fn pop(self_:Boxes&)->Box {assert(self_.len!=0);let value=self_.items[self_.len-1];self_.resize(self_.len-1);return value;}
fn resize(self_:Boxes&,length:i64) {blot_support_pooled_buffer::resize(self_,length);self_.len=length;}
fn clear(self_:Boxes&) {self_.resize(0);}
fn deinit(self_:Boxes&) {blot_support_pooled_buffer::deinit(self_,pool_Boxes);self_.len=0;}
struct Analysis {nodes:Nodes=Nodes{..},stack:Values=Values{..},controls:Controls=Controls{..},events:Event[:] = default<Event[:]>(),constants:blot_support::Option<u32>[:] = default<blot_support::Option<u32>[:]>(),constant_scopes:blot_support::Option<i64>[:] = default<blot_support::Option<i64>[:]>(),defined_scopes:blot_support::Option<i64>[:] = default<blot_support::Option<i64>[:]>(),zero_locals:const bool[:] = default<const bool[:]>(),vectors:bool=false,boxes:Boxes=Boxes{..},result_box:u32=0,unboxes:Words=Words{..},valid:bool=true,owning:bool=false,children:bool=false}
