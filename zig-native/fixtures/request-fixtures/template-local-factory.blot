type Tick is effect = { read: Unit -> U32 }
const handled = fn computation => do:
  for request in @requests computation:
    case request of
      effect Tick.read () =>
        break 42.5
      complete value =>
        break value
entry const answer = fn () => do:
  let make = fn action => @computation (fn () => action ())
  let computation = make (fn () => do:
    use Tick.read ()
    break @panic "cancelled generic computation continued"
  )
  break handled computation
