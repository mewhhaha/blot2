// Guest key values from prototype/guest-abi.md. input.receive folds ASCII letters
// to uppercase before tracking held keys and emitting key events.
const left = 0x110100
const right = 0x110101
const up = 0x110102
const down = 0x110103
const tab = 0x110104
const p = 80
const x = 88
const equals = 61
const plus = 43
const minus = 45
const r = 82
const m = 77
const f6 = 0x110206
const f9 = 0x110209
