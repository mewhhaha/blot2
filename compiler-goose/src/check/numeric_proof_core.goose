fn Checker::summaryBlock(self: Checker&, module: const Module&, inputs: SummaryInputs, id: u32, arguments: const Value[:], depth: i64) -> Value, Error {
    if depth >= 32 { return Value {}, Error.none; } var locals: Entry[>..<]; for child in module.children(id) { let err = self.values.charge(1); if err != Error.none { return Value {}, err; } let node = module.node(child); let scope = SummaryInputs.locals { locals, inputs };
        match node.tag {
            Tag.bind => { let value, err = self.summaryValue(module, scope, node.b, depth + 1); if err != Error.none { return Value {}, err; } if (value.operand == 0 && value.condition == 0) || scope.lookup(node.a).present { return Value {}, Error.none; } if locals.len >= self.values.limits.terms { return Value {}, Error.proof_analysis_limit; } locals.append(Entry { node.a, value }); },
            Tag.pattern_bind => { if node.c != 0 { return Value {}, Error.none; } let binding = opaqueReferenceBinding(module, node.a); if !binding.present { return Value {}, Error.none; } let value, err = self.summaryValue(module, scope, node.b, depth + 1); if err != Error.none { return Value {}, err; } if value.operand == 0 || value.proof.present || value.condition != 0 || scope.lookup(binding.value).present { return Value {}, Error.none; } if locals.len >= self.values.limits.terms { return Value {}, Error.proof_analysis_limit; } locals.append(Entry { binding.value, value }); },
            Tag.return_ => { if node.b != id { return Value {}, Error.none; } return self.summaryApplied(module, scope, node.a, arguments, depth + 1); }, _ => { return Value {}, Error.none; },
