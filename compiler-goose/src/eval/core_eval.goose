fn unknownPrincipalData(self: ClosureRegion&,store: const blot_check_types::Store&,root: u32) -> bool,Error { var pending: u32[>..<]=[]; var seen: dictionary<u32,bool>; pending.push(root); var edges=0; while pending.len!=0 { let id=pending[pending.len-1]; pending.resize(pending.len-1); if seen.contains(id) { continue; } if seen.count>=self.session.options.max_values { return false,Error.none; } seen.insert(id,true); let node=store.node(id); match node.tag { variable=>{ return true,Error.none; },unit,boolean,unsigned32,floating32,never,type_constructor=>{},array,list,cursor=>{ pending.push(node.a); },product,nominal=>{ var children=store.list(blot_check_types::List {node.a,node.b}); if node.tag==TypeTag.nominal { children=store.nominalArguments(node); } pending.append(children); edges=satAdd(edges,children.len); },record=>{ for index in 0..node.b { pending.push(store.recordField(node,index).ty); edges=satAdd(edges,1); } },_=>{ return false,Error.none; }, } if edges>self.session.options.max_children||pending.len>self.session.options.max_values { return false,Error.none; } } return false,Error.none; }
struct PrincipalConstraintInquiry { region: ClosureRegion&,graph: const PrincipalGraph&,constraint: Constraint,result: bool=false }
fn principalCallback(self: ClosureRegion&,graph: const PrincipalGraph&,store: const blot_check_types::Store&,c: Constraint) -> bool,Error { if !c.callback_interface||c.callback_slot>=self.session.options.max_type_depth||c.callback_stage>=self.session.options.max_type_depth { return false,Error.none; } var cursor=graph.root; for unused in 0..c.callback_slot { let arrow=store.node(cursor); if arrow.tag!=TypeTag.function { return false,Error.none; } cursor=arrow.b; } let owner=store.node(cursor); if owner.tag!=TypeTag.function { return false,Error.none; } let same,error=blot_reuse_principal_type_graph::sameOpen(store,owner.a,c.signature,self.session.options.max_type_depth,self.session.options.max_values); if error!=Error.none||!same { return false,error; } cursor=c.signature; for unused in 0..c.callback_stage { let arrow=store.node(cursor); if arrow.tag!=TypeTag.function { return false,Error.none; } cursor=arrow.b; } let rest,e=blot_reuse_principal_type_graph::sameOpen(store,cursor,c.left,self.session.options.max_type_depth,self.session.options.max_values); if e!=Error.none||!rest { return false,e; } let arrow=store.node(c.left); if arrow.tag!=TypeTag.function { return false,Error.none; } let input,e2=blot_reuse_principal_type_graph::sameOpen(store,arrow.a,c.right,self.session.options.max_type_depth,self.session.options.max_values); if e2!=Error.none||!input { return false,e2; } return blot_reuse_principal_type_graph::sameOpen(store,arrow.b,c.result,self.session.options.max_type_depth,self.session.options.max_values); }
fn unknownPrincipalConstraintInner(self: ClosureRegion&,graph: const PrincipalGraph&,store: const blot_check_types::Store&,c: Constraint) -> bool,Error {
