// The bootstrap prelude is ordinary Blot source. @u32.* and @f32.* are primitives.
// Standard operators are ordinary functions built on @type.call and @pipe.
// Boolean and/or and $ application remain language syntax.

func (+) left -> right => @type.call "add" left right
func (-) left -> right => @type.call "sub" left right
func (*) left -> right => @type.call "mul" left right
func (/) left -> right => @type.call "div" left right
func (%) left -> right => @type.call "rem" left right
func (&) left -> right => @type.call "bit_and" left right
func (|) left -> right => @type.call "bit_or" left right
func (^) left -> right => @type.call "bit_xor" left right
func (<<) value -> count => @type.call "shl" value count
func (>>) value -> count => @type.call "shr" value count
func (==) left -> right => @type.call "eq" left right
func (!=) left -> right => @type.call "ne" left right
func (<) left -> right => @type.call "lt" left right
func (<=) left -> right => @type.call "le" left right
func (>) left -> right => @type.call "gt" left right
func (>=) left -> right => @type.call "ge" left right
func (|>) value -> function => @pipe value function
func (<|) function -> value => @pipe value function

func add left -> right => @type.call "add" left right
func sub left -> right => @type.call "sub" left right
func mul left -> right => @type.call "mul" left right
func div left -> right => @type.call "div" left right
func rem left -> right => @type.call "rem" left right
func bit_and left -> right => @type.call "bit_and" left right
func bit_or left -> right => @type.call "bit_or" left right
func bit_xor left -> right => @type.call "bit_xor" left right
func shl value -> count => @type.call "shl" value count
func shr value -> count => @type.call "shr" value count
func bit_not value => value.bit_not
func eq left -> right => @type.call "eq" left right
func ne left -> right => @type.call "ne" left right
func lt left -> right => @type.call "lt" left right
func le left -> right => @type.call "le" left right
func gt left -> right => @type.call "gt" left right
func ge left -> right => @type.call "ge" left right

type Maybe a is data = $Some a | $Nothing
type Result [value, error] is data = $Ok value | $Err error
type Iteration [state, result] is data = $Continue state | $Done result
type Type witness is data = $Type witness
// Composable effect handler layers and handled computations.
type Layer [inner, outer] is data = $Layer { inner: inner, outer: outer }
type Handled [body, handler] is data = $Handled { body: body, handler: handler }
// Represented opaque handles for compiler-verified multi-core batch kernels and isolated processes.
type Kernel [ctx, item, out] is opaque = (U32, (U32, U32), (U32, U32), (U32, U32))
type Process [cfg, cmd, reply] is opaque = (U32, (U32, U32))
// Text stores Unicode scalar values; std/text validates external scalar arrays.
type Text = #[U32]

// The expected result selects its type's ordinary `from` member.
func from value => @type.result "from" value

func F32.from value => value.to_f32
func U32.from value => value.to_u32
func F32.to_f32 (value: F32) => value
func U32.to_u32 (value: U32) => value

func identity value => value
func apply function -> value => function value
func pipe value -> function => function value
func always value -> ignored => value
func compose outer -> inner -> value => outer (inner value)
func flip combine -> right -> left => combine left right
func on combine -> project -> left -> right => combine (project left) (project right)

func layer inner -> outer => $Layer { inner, outer }
func Layer.layer (self: Layer [a, b]) -> outer => $Layer { inner: self, outer }
func Function.handle f -> h => $Handled { body: f, handler: h }
func Function.run f -> arg => f arg
func Handled.handle (self: Handled [b, h]) -> next => $Handled { body: self, handler: next }

func Bool.not value => if value then false else true
func Bool.eq left -> right => if left then right else Bool.not right
func Bool.ne left -> right => Bool.not (Bool.eq left right)

func Type.eq left -> right => case left, right of
  $Type a, $Type b => @type.same a b
func Type.ne left -> right => Bool.not (Type.eq left right)

const U32.add = @u32.add
const U32.sub = @u32.sub
const U32.mul = @u32.mul
// Division/remainder require a nonzero divisor. Shifts use the low five bits.
const U32.div = @u32.div
const U32.rem = @u32.rem
const U32.bit_and = @u32.bit_and
const U32.bit_or = @u32.bit_or
const U32.bit_xor = @u32.bit_xor
func U32.bit_not value => @u32.bit_xor value 0xFFFFFFFF
const U32.shl = @u32.shl
const U32.shr = @u32.shr
func U32.abs value => value
const U32.eq = @u32.eq
const U32.ne = @u32.ne
const U32.lt = @u32.lt
const U32.le = @u32.le
const U32.gt = @u32.gt
const U32.ge = @u32.ge
const U32.to_f32 = @u32.to_f32

const F32.add = @f32.add
const F32.sub = @f32.sub
const F32.mul = @f32.mul
const F32.div = @f32.div
const F32.eq = @f32.eq
const F32.ne = @f32.ne
const F32.lt = @f32.lt
const F32.le = @f32.le
const F32.gt = @f32.gt
const F32.ge = @f32.ge
const F32.neg = @f32.neg
const F32.abs = @f32.abs
const F32.sqrt = @f32.sqrt
const F32.floor = @f32.floor
const F32.ceil = @f32.ceil
const F32.trunc = @f32.trunc
// Truncates toward zero and saturates; NaN/negative values become zero.
const F32.to_u32 = @f32.to_u32
func F32.min left -> right => if F32.lt left right then left else right
func F32.max left -> right => if F32.gt left right then left else right
func F32.clamp low -> high -> value => F32.min high (F32.max low value)
func F32.lerp left -> right -> weight => F32.add left (F32.mul (F32.sub right left) weight)
func F32.square value => F32.mul value value
func F32.length3 x -> y -> z => F32.sqrt (F32.add (F32.add (F32.square x) (F32.square y)) (F32.square z))
func F32.is_finite value => F32.le (F32.abs value) 3.402823466e38

// A positive finite period wraps finite values into [0, period).
func F32.wrap period -> value =>
  let wrapped = F32.sub value (F32.mul period (F32.floor (F32.div value period)))
  if F32.ge wrapped period:
    return 0.0
  if F32.lt wrapped 0.0:
    return F32.add wrapped period
  return wrapped

func F32.lerp_angle left -> right -> weight =>
  let difference = F32.sub (F32.wrap 6.283185307 (F32.add (F32.sub right left) 3.141592654)) 3.141592654
  return F32.add left (F32.mul difference weight)

// Split 2*pi keeps range reduction accurate for |radians| <= 8192.
// Outside that explicit range, trig returns NaN instead of inaccurate geometry.
func f32_reduced_radians value =>
  if F32.gt (F32.abs value) 8192.0:
    return F32.div 0.0 0.0
  let turns = F32.floor (F32.add (F32.mul value 0.15915494309189535) 0.5)
  return F32.sub (F32.sub value (F32.mul turns 6.28125)) (F32.mul turns 0.001935307179586477)

// Fold to [-pi/2, pi/2], then evaluate the degree-11 Taylor polynomial.
func f32_sin_reduced angle =>
  let x = if F32.gt angle 1.570796327 then F32.sub 3.141592654 angle
    else if F32.lt angle (-1.570796327) then F32.sub (-3.141592654) angle
    else angle
  let square = F32.square x
  let term_9 = F32.add 2.755731922398589e-6 (F32.mul square (-2.505210838544172e-8))
  let term_7 = F32.add (-1.984126984126984e-4) (F32.mul square term_9)
  let term_5 = F32.add 8.333333333333333e-3 (F32.mul square term_7)
  let term_3 = F32.add (-1.666666666666667e-1) (F32.mul square term_5)
  return F32.mul x (F32.add 1.0 (F32.mul square term_3))

func f32_cos_reduced value =>
  let angle = F32.abs value
  let outside = F32.gt angle 1.570796327
  let x = if outside then F32.sub 3.141592654 angle else angle
  let square = F32.square x
  let term_10 = F32.add (-2.755731922398589e-7) (F32.mul square 2.08767569878681e-9)
  let term_8 = F32.add 2.48015873015873e-5 (F32.mul square term_10)
  let term_6 = F32.add (-1.388888888888889e-3) (F32.mul square term_8)
  let term_4 = F32.add 4.166666666666667e-2 (F32.mul square term_6)
  let term_2 = F32.add (-0.5) (F32.mul square term_4)
  let result = F32.add 1.0 (F32.mul square term_2)
  return if outside then F32.neg result else result

func F32.sin value => f32_sin_reduced (f32_reduced_radians value)
func F32.cos value => f32_cos_reduced (f32_reduced_radians value)
func F32.sin_cos value =>
  let angle = f32_reduced_radians value
  return (f32_sin_reduced angle, f32_cos_reduced angle)

// Like division, tan is unbounded near odd multiples of pi/2.
func F32.tan value =>
  let angle = f32_reduced_radians value
  return F32.div (f32_sin_reduced angle) (f32_cos_reduced angle)

const pi = 3.141592653589793
const tau = 6.283185307179586
func abs value => value.abs
func min left -> right => if left < right then left else right
func max left -> right => if left > right then left else right
func clamp low -> high -> value => min high (max low value)
func lerp left -> right => @type.call "lerp" left right
func square value => value * value
const sqrt = F32.sqrt
const floor = F32.floor
const ceil = F32.ceil
const trunc = F32.trunc
const sin = F32.sin
const cos = F32.cos
const tan = F32.tan
const sin_cos = F32.sin_cos
const wrap = F32.wrap
const lerp_angle = F32.lerp_angle
const is_finite = F32.is_finite
const saturate = clamp 0.0 1.0
func smoothstep low -> high -> value =>
  let t = saturate ((value - low) / (high - low))
  return t * t * (3.0 - 2.0 * t)

func Maybe.pure value => $Some value
func Maybe.map transform -> candidate => case candidate of
  $Some value => $Some (transform value)
  $Nothing => $Nothing
func Maybe.bind candidate -> next => case candidate of
  $Some value => next value
  $Nothing => $Nothing
// Finish each callback before advancing, so iteration uses constant stack.
func Maybe.iterate initial -> step =>
  let state = initial
  for ever:
    use candidate <- step state
    if let $Some ($Done result) = candidate:
      return $Some result
    let $Some ($Continue next) = candidate else:
      return $Nothing
    state := next
func Maybe.unwrap_or fallback -> candidate => case candidate of
  $Some value => value
  $Nothing => fallback
func Maybe.is_some candidate => case candidate of
  $Some _ => true
  $Nothing => false
func Maybe.filter predicate -> candidate => case candidate of
  $Some value => if predicate value then candidate else $Nothing
  $Nothing => $Nothing
func Maybe.flatten candidate => case candidate of
  $Some inner => inner
  $Nothing => $Nothing
func Maybe.unwrap_or_else fallback -> candidate => case candidate of
  $Some value => value
  $Nothing => fallback ()
func Maybe.to_result error -> candidate => case candidate of
  $Some value => $Ok value
  $Nothing => $Err error

func Result.pure value => $Ok value
func Result.map transform -> candidate => case candidate of
  $Ok value => $Ok (transform value)
  $Err error => $Err error
func Result.map_error transform -> candidate => case candidate of
  $Ok value => $Ok value
  $Err error => $Err (transform error)
func Result.bind candidate -> next => case candidate of
  $Ok value => next value
  $Err error => $Err error
func Result.iterate initial -> step =>
  let state = initial
  for ever:
    use candidate <- step state
    if let $Ok ($Continue next) = candidate:
      state := next
    else:
      if let $Ok ($Done result) = candidate:
        return $Ok result
      if let $Err error = candidate:
        return $Err error
func Result.unwrap_or fallback -> candidate => case candidate of
  $Ok value => value
  $Err _ => fallback
func Result.unwrap_or_else fallback -> candidate => case candidate of
  $Ok value => value
  $Err _ => fallback ()
func Result.to_maybe candidate => case candidate of
  $Ok value => $Some value
  $Err _ => $Nothing

func Array.length (values: #[a]): U32 => @array.length values
func View.length (values: &[a]): U32 => @storage.length values
func Array.at (values: #[a]) -> (index: U32) => @array.get values index
func View.at (values: &[a]) -> (index: U32) => @storage.read values index
func Array.is_empty (values: #[a]): Bool => Array.length values == 0
func Array.get (values: #[a]) -> (index: U32): Maybe a =>
  if index < Array.length values:
    return $Some (@array.get values index)
  return $Nothing
func Array.set (values: #[a]) -> (index: U32) -> (value: a): Maybe #[a] =>
  if index < Array.length values:
    return $Some (@array.set values index value)
  return $Nothing

// Pool iteration borrows a captured range.
type PoolCursor a is data = $PoolCursor { values: &[a], index: U32 }
func Array.iter (values: #[a]) => $PoolCursor {values: &values[0..values.length], index: 0}
func View.iter (values: &[a]) => $PoolCursor {values, index: 0}
func PoolCursor.iter (cursor: PoolCursor a) => cursor
func PoolCursor.next (cursor: PoolCursor a) => if cursor.index < cursor.values.length then $Some (cursor.values[cursor.index], $PoolCursor {values: cursor.values, index: cursor.index + 1}) else $Nothing

// Mutation dispatch keeps the owner mode explicit in each selected signature.
func Array.with_capacity (capacity: U32): #[a] => @storage.with_capacity capacity
func Array.reserve (values: own #[a]) -> (additional: U32): #[a] =>
  return @storage.reserve values additional
func Array.extend (values: own #[a]) -> (more: #[a]): #[a] =>
  return @storage.extend values more
func Array.extend_view (values: own #[a]) -> (more: &[a]): #[a] =>
  return @storage.extend values more
func Array.push (values: own #[a]) -> (value: a): #[a] =>
  return @storage.push values value
func Array.truncate (values: own #[a]) -> (count: U32): #[a] =>
  @storage.truncate values count
  return values
func Array.pop (values: own #[a]): (#[a], a) =>
  let value = @storage.pop values
  return (values, value)
// `values.copy` is independent storage with the same elements.
func Array.copy (values: #[a]): #[a] => @storage.copy values
func Array.view (values: #[a]) -> (start: U32) -> (end: U32) => @storage.view values start end
func View.view (values: &[a]) -> (start: U32) -> (end: U32) => @storage.view values start end

// Packed sequential arrays (`%[T]`): dense, non-indexable iteration storage.
func Packed.length (values: %[a]): U32 => @storage.length values
func Packed.is_empty (values: %[a]): Bool => Packed.length values == 0
func Packed.with_capacity (capacity: U32): %[a] => @storage.with_capacity capacity
func Packed.reserve (values: own %[a]) -> (additional: U32): %[a] =>
  return @storage.reserve values additional
func Packed.push (values: own %[a]) -> (value: a): %[a] =>
  return @storage.push values value
func Packed.pop (values: own %[a]): (%[a], a) =>
  let value = @storage.pop values
  return (values, value)
func Packed.extend (values: own %[a]) -> (more: %[a]): %[a] =>
  return @storage.extend values more
func Packed.extend_array (values: own %[a]) -> (more: #[a]): %[a] =>
  return @storage.extend values more
func Packed.extend_view (values: own %[a]) -> (more: &[a]): %[a] =>
  return @storage.extend values more
func Packed.copy (values: %[a]): %[a] => @storage.copy values
func Packed.concat (left: %[a]) -> (right: %[a]): %[a] =>
  let out: %[a] = @storage.with_capacity (U32.add (Packed.length left) (Packed.length right))
  out := @storage.extend out left
  return @storage.extend out right
func Packed.to_array (values: %[a]): #[a] =>
  let out: #[a] = @storage.with_capacity (Packed.length values)
  return @storage.extend out values
func Packed.from_array (values: #[a]): %[a] =>
  let out: %[a] = @storage.with_capacity (Array.length values)
  return @storage.extend out values
func Array.to_packed (values: #[a]): %[a] => Packed.from_array values
func Array.from_packed (values: %[a]): #[a] => Packed.to_array values
func Array.extend_packed (values: own #[a]) -> (more: %[a]): #[a] =>
  return @storage.extend values more

