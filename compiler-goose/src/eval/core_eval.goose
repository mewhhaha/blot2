fn seedScalarInputs(self: Session&,current: const Session&) -> Error { if !(self.units .== current.units)||self.units.len!=current.units.len { return Error.declined; } for module,owner in self.units { let start=self.binding_offsets[owner]; for old,index in current.slots[start..start+module.bindings.len] { if old.state!=State.complete||module.bindings[index].kind!=blot_check_check::Kind.global { continue; } let body=module.body(index as u32); if body==null||body.runtime { continue; } let input=valueScalar(current,old.value); if !input.present { continue; } var expected: u32=0; if input.value.scalar==blot_backend_runtime_ir::SC_unit { expected=blot_check_types::unit; } else if input.value.scalar==blot_backend_runtime_ir::SC_bool { expected=blot_check_types::boolean; } else if input.value.scalar==blot_backend_runtime_ir::SC_u32 { expected=blot_check_types::u32_type; } else if input.value.scalar==blot_backend_runtime_ir::SC_f32 { expected=blot_check_types::f32_type; } else { continue; } if valueEvidence(current,old.value)!=expected { continue; } let copied,error=makeScalar(self,owner,body.root,input.value); if error!=Error.none { return error; } self.slots[start+index]=Slot {state:State.complete,value:copied}; } } return Error.none; }
struct RecheckProof { session: Session&,target: Target,expected: u32,result: bool=false }
fn recheckCallProof(self: Session&,reference: BindingRef,expected: u32) -> bool,Error { let first,error=target(self,blot_support::none<i64>(),reference); if error!=Error.none { return false,error; } let selected,e=external(self,first); if e!=Error.none { return false,e; } let module=self.units[selected.unit]; let body=module.body(selected.binding); if body==null||module.binding(selected.binding).kind!=blot_check_check::Kind.global||(body.runtime&&!body.is_function) { return false,Error.none; } var context=RecheckProof {self,selected,expected}; let result=withRegion<RecheckProof,recheckProofRegion>(self,context,blot_backend_backend_timing::RegionCaller {function:"recheckCallProof",line:2948}); return context.result,result; }
fn recheckProofRegion(context: RecheckProof&,region: ClosureRegion&) -> Error { let module=context.session.units[context.target.unit]; let body=module.body(context.target.binding); assert(body!=null); let arrow,error=firstOrderArrow(region,context.expected); if error!=Error.none { return evidenceFailure(context.session,context.target.unit,module.span(body.root),error); } if !arrow { return Error.none; } let solved,e=bodyEvidenceFull(region,context.target.unit,body.root,module.binding(context.target.binding).ty,body.closed_rows,body.scheme,Expected.semantic {value:context.expected},[],[]); if e!=Error.none { return evidenceFailure(context.session,context.target.unit,module.span(body.root),e); } let complete=allConstraintsSolved(region)&&solved.selected.len==0&&region.scratch.sources.len!=0; solved.deinit(); if !complete { return Error.none; } let projected,e2=project(region,region.scratch.sources[0].root); if e2!=Error.none { return evidenceFailure(context.session,context.target.unit,module.span(body.root),e2); } context.result=projected==context.expected; return Error.none; }
fn ownerOutcome(self: Session&,owner: i64,identity: blot_support::Option<blot_check_types::NominalIdentity>,op: blot_check_types::Operator,member: u32) -> blot_reuse_dispatch_explanation::Outcome,Error { if !identity.present { return blot_reuse_dispatch_explanation::Outcome.no_member,Error.none; } let selected,error=associatedTarget(self,unitId(self,owner),identity.value,member,op); if selected.present { return blot_reuse_dispatch_explanation::Outcome.incompatible,error; } return blot_reuse_dispatch_explanation::Outcome.no_member,error; }
fn rejectedCandidates(self: Session&,owner: i64,op: blot_check_types::Operator,member: u32,left: u32,right: u32,include_right: bool) -> DispatchRecord,Error { var record=DispatchRecord {op:op,member:member}; let left_identity=evidenceIdentity(self,left); let left_outcome,error=ownerOutcome(self,owner,left_identity,op,member); if error!=Error.none { return record,error; } record.add(blot_reuse_dispatch_explanation::Side.left,left,left_outcome); if member==0&&left!=0&&left==right { let tag=self.storage.evidence.node(left).tag; if tag==blot_eval_type_evidence::Tag.unsigned32||tag==blot_eval_type_evidence::Tag.floating32||tag==blot_eval_type_evidence::Tag.boolean { record.add(blot_reuse_dispatch_explanation::Side.builtin,left,blot_reuse_dispatch_explanation::Outcome.unsupported_scalar); } } let right_identity=evidenceIdentity(self,right); let same=left_identity.present&&right_identity.present&&left_identity.value==right_identity.value; if include_right&&!same { let right_outcome,e=ownerOutcome(self,owner,right_identity,op,member); if e!=Error.none { return record,e; } record.add(blot_reuse_dispatch_explanation::Side.right,right,right_outcome); } return record,Error.none; }
struct EvaluateQuery { target: BindingRef,options: Options,diagnostic_message: u8[>..<]&,result: Result=Result {} }
fn evaluate(units: const Module[:],target: BindingRef,options: Options,diagnostic_message: u8[>..<]&) -> Result,Error { var context=EvaluateQuery {target,options,diagnostic_message}; let error=withSession<EvaluateQuery,evaluateSession>(units,blot_native::fresh_owner_id(),context); return context.result,error; }
fn evaluateSession(context: EvaluateQuery&,session: Session&) -> Error { session.options=context.options; let result,error=value(session,context.target); if error==Error.out_of_memory { return error; } if error==Error.none { context.result.value=blot_support::some(result); } else if error==Error.request_unwind&&!session.diagnostic.present { session.diagnostic=blot_support::some(Diagnostic {unit:context.target.unit,span:Span {0,0},code:Code.unsupported}); } context.result.diagnostic=session.diagnostic; context.result.steps=session.steps; if context.result.diagnostic.present&&context.result.diagnostic.value.detail.len!=0 { context.diagnostic_message.clear(); context.diagnostic_message.append(context.result.diagnostic.value.detail); context.result.diagnostic.value.detail=context.diagnostic_message; } return Error.none; }

fn withSharedSession<C,F>(parent: const Session&,allocation_owner: u64,context: C&) -> Error { assert(allocation_owner!=0); var invocation=SessionFactory<C> {units:parent.units,allocation_owner:allocation_owner,context:context,parent:parent}; return blot_eval_type_evidence::withStore<SessionFactory<C>,sessionFactory<C,F>>(invocation); }
fn factorySession<C>(invocation: SessionFactory<C>&,tables: SessionTables,storage: blot_eval_eval_values::Store&,providers: blot_backend_provider_chain::Store&,proofs: blot_eval_implementation_evidence::Store&,regions: RegionStorage&,specializations: SpecializationCaches&,retained: RetainedRecords&) -> Session,Error { if invocation.parent { return initShared(invocation.parent,tables,storage,providers,proofs,regions,specializations,retained); } return init(tables,invocation.units,storage,providers,proofs,regions,specializations,retained); }
import .component_worker;
import .semantic_job_batch;
fn componentLess(left: blot_eval_component_worker::Component,right: blot_eval_component_worker::Component) -> bool { let a=left.members[0]; let b=right.members[0]; if a.key.target.unit!=b.key.target.unit { return a.key.target.unit<b.key.target.unit; } if a.key.target.binding!=b.key.target.binding { return a.key.target.binding<b.key.target.binding; } return a.index<b.index; }
fn declinePrivate(self: CallSummaries&,component: blot_eval_component_worker::Component) { for member in component.members { if member.index>=self.jobs.len { continue; } if self.jobs[member.index].key==member.key { self.jobs[member.index].private_declined=true; } } }
fn parallelReady(self: CallSummaries&,session: Session&) -> bool,Error { session.counters.semantic_component_attempts++; if !session.semantic_io_enabled { session.counters.semantic_component_no_io++; return false,Error.none; } if session.semantic_component_workers==0 { session.counters.semantic_component_disabled++; return false,Error.none; } if session.receipt_tape!=null||recordingConstant(session)||session.principal_reads!=null { session.counters.semantic_component_recording++; return false,Error.none; } if session.refinement_observation!=null { session.counters.semantic_component_observing++; return false,Error.none; } if session.summary_exhausted { session.counters.semantic_component_exhausted++; return false,Error.none; } if session.timing { let scope=session.timing.enter(blot_backend_backend_timing::Phase.semantic_coordination); let result,error=parallelReadyOwned(self,session); scope.deinit(); return result,error; } return parallelReadyOwned(self,session); }
fn parallelReadyOwned(self: CallSummaries&,session: Session&) -> bool,Error { var ready: blot_eval_component_worker::Component[>..<]=[]; let prepared=prepareComponents(self,session,ready); if prepared!=Error.none { for &component in ready { component.deinit(); } return false,prepared; } if ready.len<2 { for &component in ready { component.deinit(); } return false,Error.none; } ::sort(ready) { a,b=>componentLess(a,b); } var remaining=summaryLimit(session)-session.summary_transitions; if remaining<0 { remaining=0; } let budget=remaining/ready.len; if budget==0 { for &component in ready { component.deinit(); } return false,Error.none; } for &component in ready { component.budget=budget; } var cancellation=blot_eval_semantic_job_batch::Cancellation {}; var context=blot_eval_component_worker::Context {session}; var outcomes: blot_eval_semantic_job_batch::Outcome<blot_eval_component_worker::Result>[>..<]=[];
 var failure=Error.none; if session.timing { let scope=session.timing.enter(blot_backend_backend_timing::Phase.semantic_dispatch); let batch,error=blot_eval_semantic_job_batch::run<blot_eval_component_worker::Result,blot_eval_component_worker::Component,blot_eval_component_worker::Context,blot_eval_component_worker::execute>(ready,session.semantic_component_workers,cancellation,context,outcomes); scope.deinit(); if error!=Error.none { failure=error; } else { session.counters.semantic_component_batches++; session.counters.semantic_component_jobs+=ready.len as u64; if session.counters.max_semantic_component_workers<batch.workers { session.counters.max_semantic_component_workers=batch.workers as u64; } } }
 else { let batch,error=blot_eval_semantic_job_batch::run<blot_eval_component_worker::Result,blot_eval_component_worker::Component,blot_eval_component_worker::Context,blot_eval_component_worker::execute>(ready,session.semantic_component_workers,cancellation,context,outcomes); if error!=Error.none { failure=error; } else { session.counters.semantic_component_batches++; session.counters.semantic_component_jobs+=ready.len as u64; if session.counters.max_semantic_component_workers<batch.workers { session.counters.max_semantic_component_workers=batch.workers as u64; } } }
 var progressed=false; if failure==Error.none { let result,error=consumeComponents(self,session,ready,outcomes); progressed=result; failure=error; } for &outcome in outcomes { match outcome { complete result=>{ result.value.deinit(); },_=>{}, } } for &component in ready { component.deinit(); } if failure!=Error.none { return false,failure; } if cancellation.cancelled() { return false,Error.declined; } return progressed,Error.none;
}
fn prepareComponents(self: CallSummaries&,session: Session&,ready: blot_eval_component_worker::Component[>..<]&) -> Error { for job,index in self.jobs { if job.state!=SummaryJobState.queued||self.components.component(index as u32)!=index { continue; } var members: blot_eval_component_worker::Member[>..<]=[]; var eligible=true; for candidate,position in self.jobs { if !member(self,index,position) { continue; } if (candidate.state!=SummaryJobState.queued&&candidate.state!=SummaryJobState.waiting)||candidate.region_active||candidate.region.present||candidate.private_declined||candidate.key.lexical>session.specializations.lexical_inputs.inputs.len { eligible=false; break; } for prior in members { var same_owner=false; if candidate.key.lexical!=0||prior.key.lexical!=0 { same_owner=candidate.key.lexical!=0&&candidate.key.lexical==prior.key.lexical; } else { same_owner=candidate.key.target==prior.key.target; } if same_owner { eligible=false; } } if !eligible { break; } members.push(blot_eval_component_worker::Member {position,candidate.key}); } if !eligible { continue; } var edges: blot_eval_component_worker::Edge[>..<]=[]; for edge in self.components.edges { if !member(self,index,edge.from) { continue; } if !member(self,index,edge.to) { if self.jobs[edge.to].state!=SummaryJobState.complete&&self.jobs[edge.to].state!=SummaryJobState.declined { eligible=false; } continue; } var from: u32=0; var to: u32=0; for candidate,local in members { if candidate.index==edge.from { from=local as u32; } if candidate.index==edge.to { to=local as u32; } } edges.push(blot_eval_component_worker::Edge {from,to}); } if !eligible { continue; } ready.push(blot_eval_component_worker::create(members,edges)); } return Error.none; }
struct ComponentPublication { store: CallSummaries&,session: Session&,component: blot_eval_component_worker::Component,result: const blot_eval_component_worker::Result&,published: bool=false }
fn consumeComponents(self: CallSummaries&,session: Session&,ready: const blot_eval_component_worker::Component[:],outcomes: const blot_eval_semantic_job_batch::Outcome<blot_eval_component_worker::Result>[:]) -> bool,Error { var failed=false; var progressed=false; for outcome,index in outcomes { let component=ready[index]; match outcome {
 out_of_memory=>{ failed=true; },complete result=>{ if session.timing { session.timing.semantic_job_nanos=blot_work_counters::saturating_add(session.timing.semantic_job_nanos,result.value.job_nanos); } session.counters.merge(result.value.counters); if !summaryCharge(session,result.value.transitions) { continue; } if !result.value.snapshot.present { declinePrivate(self,component); continue; } var independent=true; for source in result.value.sources { let owner=findUnit(session,source.unit,blot_support::none<i64>()); if !owner.present||self.active.contains(Target {owner.value,source.binding}) { independent=false; break; } } if !independent { continue; } var context=ComponentPublication {self,session,component,result.value}; var error=Error.none; if session.timing { let scope=session.timing.enter(blot_backend_backend_timing::Phase.semantic_publication); error=blot_eval_type_evidence::withStore<ComponentPublication,publishPrivateComponent>(context); scope.deinit(); } else { error=blot_eval_type_evidence::withStore<ComponentPublication,publishPrivateComponent>(context); } if error!=Error.none { if error==Error.out_of_memory { failed=true; continue; } return false,error; } progressed=context.published||progressed;
 },declined=>{ declinePrivate(self,component); },_=>{},
 } } if failed { return false,Error.out_of_memory; } return progressed,Error.none; }
struct StagedComponentMember { key: CallSummaryKey,index: blot_support::Option<i64>,evidence: u32 }
fn publishPrivateComponent(context: ComponentPublication&,staged: blot_eval_type_evidence::Store&) -> Error { let self: CallSummaries&=context.store; let session: Session&=context.session; let cloned=session.storage.evidence.clone(staged); if cloned!=Error.none { return cloned; } assert(context.result.snapshot.present); var nodes: dictionary<u32,u32>; var rows: dictionary<u32,u32>; var labels: dictionary<u32,u32>; var imports=blot_eval_semantic_evidence_import::Importer {source:context.result.snapshot.value.snapshot.view(),destination:staged,max_depth:session.options.max_type_depth,nodes:nodes,rows:rows,labels:labels}; var prepared: StagedComponentMember[>..<]=[]; for member in context.component.members { let job=self.jobs[member.index]; if job.key!=member.key||job.region_active||job.region.present||job.state==SummaryJobState.declined||job.state==SummaryJobState.running { return Error.none; } } var added=0;
 for key,index in context.result.keys { if (key.lexical!=0&&self.active_lexical.contains(key.lexical))||(key.lexical==0&&self.active.contains(key.target))||key.options!=session.options { return Error.none; } var mapped_key=key; let inputs,error=imports.ty(key.inputs,0); if error!=Error.none { if error==Error.out_of_memory { return error; } return Error.none; } mapped_key.inputs=inputs; let result,e=imports.ty(key.expected_result,0); if e!=Error.none { if e==Error.out_of_memory { return e; } return Error.none; } mapped_key.expected_result=result; let signature,e2=imports.ty(key.expected_signature,0); if e2!=Error.none { if e2==Error.out_of_memory { return e2; } return Error.none; } mapped_key.expected_signature=signature; let mapped,e3=imports.ty(context.result.roots[index],0); if e3!=Error.none { if e3==Error.out_of_memory { return e3; } return Error.none; } var existing=blot_support::none<i64>(); let known=self.keys.get(mapped_key); if known { let job=self.jobs[known]; if job.region_active||job.region.present||job.state==SummaryJobState.declined||(job.state==SummaryJobState.complete&&job.result!=mapped) { return Error.none; } existing=blot_support::some<i64>(known); } else { added++; } prepared.push(StagedComponentMember {mapped_key,existing,mapped}); }
 var room=session.options.max_values-self.jobs.len; if room<0 { room=0; } if added>room { return Error.none; } self.keys.reserve(self.keys.count+added); let old_length=self.jobs.len; self.jobs.resize(old_length+added,SummaryJob {key:CallSummaryKey {target:Target {0,0},inputs:0,source_interface:false}}); self.jobs.resize(old_length); let reserved=blot_eval_type_evidence::prepareCommit(staged,session.storage.evidence); if reserved!=Error.none { return reserved; } blot_eval_type_evidence::commit(staged,session.storage.evidence);
 for entry in prepared { if entry.index.present { if self.jobs[entry.index.value].state!=SummaryJobState.complete { finish(self,session,entry.index.value,entry.evidence); } } else { self.keys.insert(entry.key,self.jobs.len); self.jobs.push(SummaryJob {key:entry.key,state:SummaryJobState.complete,result:entry.evidence}); session.split_attempts++; session.split_accepted++; } } session.component_restarts+=context.result.restarts; session.component_members_published+=context.result.recursive_members; context.published=true; return Error.none;
}

type ValueMap=blot_support_pooled_map::Map<u32,ValueId>;
struct ValuesHeader { table: ValueMap=ValueMap {},failure: Error=Error.none,generation: u64=0,live: bool=false }
reusable var values_headers: ValuesHeader[>..]=[];
reusable[] var values_slots: dictionary_slot<u32,ValueId>[>..]=[];
var inactive_values: ValuesHeader=ValuesHeader {};
var next_values_generation: u64=1;
struct PooledValues { table: ValueMap&=inactive_values.table,slots: (dictionary_slot<u32,ValueId>[:])&=inactive_values.table.slots,count: i64&=inactive_values.table.count,failure: Error&=inactive_values.failure,lease: u32=0,generation: u64=0 }
fn activate(self: PooledValues&) -> Error { if self.lease!=0 { assert(self.lease-1<values_headers.len&&values_headers[self.lease-1].live&&values_headers[self.lease-1].generation==self.generation); return Error.none; } if next_values_generation==0xffffffffffffffff||values_headers.len>=0xffffffff { return Error.out_of_memory; } let generation=next_values_generation; next_values_generation++; let at=values_headers.alloc_index(ValuesHeader {generation:generation,live:true}); self.table .= values_headers[at].table; self.slots .= values_headers[at].table.slots; self.count .= values_headers[at].table.count; self.failure .= values_headers[at].failure; self.lease=(at+1) as u32; self.generation=generation; return Error.none; }
fn get(self: PooledValues,key: u32) -> ValueId? { if self.lease==0 { return null; } return blot_support_pooled_map::get(self.table,key); }
fn insert(self: PooledValues&,key: u32,value: ValueId) { let error=activate(self); if error!=Error.none { self.failure=error; return; } blot_support_pooled_map::insert(self.table,key,value,values_slots); }
fn remove(self: PooledValues,key: u32) -> bool { if self.lease==0 { return false; } return blot_support_pooled_map::remove(self.table,key); }
fn clear(self: PooledValues) { if self.lease!=0 { blot_support_pooled_map::clear(self.table); } }
fn deinit(self: PooledValues&) { if self.lease==0 { return; } let error=activate(self); assert(error==Error.none); blot_support_pooled_map::deinit(self.table,values_slots); let at=self.lease-1; values_headers[at].live=false; values_headers.free(at); self=PooledValues {}; }
fn prepareFrame(values: PooledValues&,mappings: blot_eval_type_evidence::PooledMappings&,rows: blot_eval_type_evidence::PooledRows&) -> Error { let first=activate(values); if first!=Error.none { return first; } let second=blot_eval_type_evidence::activate(mappings); if second!=Error.none { return second; } return blot_eval_type_evidence::activate(rows); }

fn attemptClosedNodeSlots(self: Session&,unit: u32,id: u32,values: const dictionary_slot<u32,ValueId>[:]) -> ValueId,bool,Error { let saved=self.diagnostic; let value,error=closedNodeSlots(self,unit,id,values,[],[]); if error==Error.out_of_memory { return 0,false,error; } if error!=Error.none { self.diagnostic=saved; return 0,false,Error.none; } return value,true,Error.none; }

fn closeRegionTiming(session: Session&,active: bool,previous: blot_backend_backend_timing::Phase) { if active&&session.timing { blot_backend_backend_timing::account(session.timing); session.timing.active=previous; } }
fn regionElapsed(session: const Session&,started: u64) -> u64 { if session.timing==null||!session.timing.clock.enabled { return 0; } let current=blot_native::clock_ns(); if current<started { return 0; } return (current-started)/1000; }
fn recordRegionTiming(region: ClosureRegion&) { let session: Session&=region.session; if !region.timing_active||session.timing==null||!session.timing.clock.enabled||region.scratch.sources.len==0 { return; } let elapsed=regionElapsed(session,region.timing_started); if elapsed<1000 { return; } let source=region.scratch.sources[0]; let module=session.units[source.owner]; var binding=source.binding; if binding==0 { for body in module.bodies[1..] { if body.root==source.body { binding=body.binding; break; } } } var offset: u32=0; if binding!=0 { offset=module.sourceNamePoint(binding); } else if source.body!=0 { offset=module.span(source.body).start; } var name: const u8[:]=""; if session.diagnostic_context.identity.present { let found=session.diagnostic_context.identity.value.owner(unitId(session,source.owner)); if found.present { name=found.value; } } session.timing.region(blot_backend_backend_timing::Region {unit:unitId(session,source.owner),binding:binding,body:source.body,offset:offset,scopes:region.scratch.sources.len,nodes:region.solver.nodes.len,us:elapsed,principal:region.profile_principal,rejected:region.profile_rejected,input_calls:region.profile_input_calls,recorded_inputs:region.profile_recorded_inputs,output_types:region.profile_output_types,output_rows:region.profile_output_rows},name); }
