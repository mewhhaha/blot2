        match selected.environment {zero=>{},local value=>{if value.value >= body.parameters.len {return blot_support::none<Construction>();}},data_word=>{return blot_support::none<Construction>();},}
        if selected.end >= code.len || code[selected.end].op != blot_backend_runtime_ir::OP_local_get || code[selected.end].operand != selected.local.value {return blot_support::none<Construction>();}let tail = code[selected.end + 1..];if tail.len != 0 && (tail.len != 1 || tail[0].op != blot_backend_runtime_ir::OP_return_) {return blot_support::none<Construction>();}return fact;
    }return blot_support::none<Construction>();
