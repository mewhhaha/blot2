fn parameterHash(source: Source,catalog: Catalog,nominal: blot_check_check::Nominal,hash: blot_support_blake3::State&,depth: i64,budget: i64&) -> bool { if nominal.patterns.len!=nominal.parameters.len { return false; } if nominal.patterns.len==0 { return true; } if !catalog.patterns.present { return false; } let patterns=catalog.patterns.value; hashWord(hash,nominal.patterns.len); for pattern in patterns.list(nominal.patterns) { if !patternHash(source,patterns,pattern,source.list(nominal.variables),catalog,hash,depth,budget) { return false; } } return true; }
fn patternHash(source: Source,patterns: blot_check_frozen_types::Patterns,id: u32,variables: const u32[:],catalog: Catalog,hash: blot_support_blake3::State&,depth: i64,budget: i64&) -> bool {
