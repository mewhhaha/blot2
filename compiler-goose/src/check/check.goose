fn projectMethod(self:Engine&,ty:u32,name:u32,source:u32,request:blot_support::Option<PendingObligation>,index:u32)->u32,blot_error::Error {let binding=self.associated[index].binding;let state .= self.global_states.get(binding);var active=false;if state {active=state.state==State.active;}var open_self=false;if !active && request.present {let pending=request.value;if pending.owner==binding && self.bindings[binding].scheme.root==0 {let state .= self.global_states.get(binding);if state && state.state==State.complete {var requirement=pending.value;requirement.kind=blot_check_types::ObligationKind.receiver;requirement.other=blot_check_types::unit;let open,err=self.requirementOpen(requirement);if err!=blot_error::Error.none {return 0,err;}open_self=open;}}}var waiting=false;if !active && !open_self {let prepared,err=self.prepareSelectedGlobal(binding);if err!=blot_error::Error.none {return 0,err;}waiting=!prepared;}let retained=!active && self.retainsSelfMember(binding,self.associated[index]);if active || open_self || retained || waiting {let result,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}let function,err=self.invocation(ty,result);if err!=blot_error::Error.none {return 0,err;}self.dispatch_signatures[source]=function;var deferred=PendingObligation{owner:self.current,scope:self.qualification_scope,value:blot_check_types::Obligation{ty:ty,kind:blot_check_types::ObligationKind.receiver,name:name,other:blot_check_types::unit,result:result,signature:function,source:source}};if request.present {deferred=request.value;}deferred.value.ty=ty;deferred.value.kind=blot_check_types::ObligationKind.receiver;if waiting {deferred.value.kind=blot_check_types::ObligationKind.field;}deferred.value.name=name;deferred.value.other=blot_check_types::unit;deferred.value.result=result;deferred.value.signature=function;deferred.value.source=source;deferred.method_member=!waiting;deferred.wait_target=0;if waiting {deferred.wait_target=binding;}if deferred.origin==0 {le