fn Engine::selectImplementation(self:Engine&,contract:Identity,input:const u32[:],source:u32)->blot_support::Option<u32>,blot_error::Error {if self.active_evidence.len==0 {self.implementation_trace=blot_eval_implementation_trace::Record{context:self.unit,request:source,contract:contract};}let arguments=equation_type_ids.alloc_slice(input.len);for value,index in input {arguments[index]=value;}let result,err=selectImplementationResolved(self,contract,arguments,source);equation_type_ids.free_slice(arguments);return result,err;}
fn selectImplementationResolved(self:Engine&,contract:Identity,arguments:u32[:],source:u32)->blot_support::Option<u32>,blot_error::Error {for &argument in arguments {let root,err=self.types.resolve(argument,0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}argument=root;}let given,err=self.contractGiven(contract,arguments);if err!=blot_error::Error.none || given {return blot_support::none<u32>(),err;}for argument in arguments {let closed,err=self.types.equalClosed(argument,argument);if err!=blot_error::Error.none || !closed {return blot_support::none<u32>(),err;}}if self.active_evidence.len>=256 || self.active_predicates.len>=256-self.active_evidence.len {let err=self.diagnostic(Code.associated_limit,source);return blot_support::none<u32>(),err;}for active in self.active_evidence {let allowed,err=self.associatedStep(source);if err!=blot_error::Error.none || !allowed {return blot_support::none<u32>(),err;}if active.contract!=contract || active.arguments.len!=arguments.len {continue;}let same,err=contractArgumentsEqualBody(self,arguments,self.types.list(active.arguments),false);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if same {let err=self.diagnostic(Code.recursive_evidence,source);return blot_support::none<u32>(),err;}}for proof,ordinal in self.selected_proofs {let allowed,err=self.associatedStep(source);if err!=blot_error::Error.none || !allowed {return blot_support::none<u32>(),err;}if proof.kind!=blot_reuse_principal_interface::SelectedProofKind.implementation || proof.contract!=contract || proof.arguments.len!=arguments.len {continue;}let same,err=contractArgumentsEqualBody(self,arguments,self.types.list(proof.arguments),false);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if same {for declaration in self.implementations {if declaration.identity!=proof.implementation {continue;}if declaration.private && !self.privateImplementationAllowed(source) {let err=self.diagnostic(Code.private_ident