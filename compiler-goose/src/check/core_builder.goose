struct ApplicationArgument {value:u32,site:u32}
type ApplicationBuffer=blot_support_pooled_buffer::Buffer<ApplicationArgument>;
fn Builder::appliedValue(self:Builder&,source:u32,callee:u32,arguments:const u32[:],sites:const ApplicationArgument[:],depth:i64)->u32,Error {if arguments.len!=sites.len {return 0,Error.core_limit;}let first,error=self.expression(callee,depth+1);if error!=Error.none {return 0,error;}var value=first;for index in 0..arguments.len {if value==0 {return 0,Error.none;}var callable_type=self.tables.nodes[value].ty;while self.tables.type_nodes[callable_type].tag==blot_check_types::Tag.usage {callable_type=self.tables.type_nodes[callable_type].a;}let signature=self.tables.type_nodes[callable_type];if signature.tag!=blot_check_types::Tag.function && signature.tag!=blot_check_types::Tag.never && signature.tag!=blot_check_types::Tag.forall {let error=self.diagnostic(blot_check_core::Code.invalid_call,source);return 0,error;}let site=sites[sites.len-index-1].site;var instance:u32=0;if signature.tag==blot_check_types::Tag.forall {let ty,error=self.typeOf(self.source.tree.node(site).a);if error!=Error.none {return 0,error;}instance=ty;}let ty,error=self.typeOf(site);if error!=Error.none {return 0,error;}let next,error=self.make(site,blot_check_core::Node{tag:blot_check_core::Tag.apply,ty:ty,a:value,b:arguments[index],c:instance, ..});if error!=Error.none {return 0,error;}value=next;}return value,Error.none;}

