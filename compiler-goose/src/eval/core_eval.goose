 if index.bits>=array.len { return 0,failNode(self,owner,id,Code.array_bounds); } if operation==blot_backend_collection_ops::Op.get { return valueChildren(self,values[0])[index.bits],Error.none; } let charge=chargeCells(self,owner,id,array.len); if charge!=Error.none { return 0,charge; } return copyAggregate(self,owner,id,values[0],index.bits,values[2]);
