 blot_parse_ast::tag_integer,blot_parse_ast::tag_float,blot_parse_ast::tag_boolean=>{return self_.make(source,blot_check_core::Node{tag:blot_check_core::Tag.constant,ty:ty,a:syntax.a, ..});},blot_parse_ast::tag_string=>{return self_.stringExpression(source,ty);},blot_parse_ast::tag_unit=>{return self_.make(source,blot_check_core::Node{tag:blot_check_core::Tag.constant,ty:ty, ..});},
