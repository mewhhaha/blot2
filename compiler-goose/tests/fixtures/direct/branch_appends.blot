entry func collect (count: U32): Array U32 => return do:
  let rows: Array U32 = #[]
  for i in 0..count:
    case i % 5 of
      0 => do:
        rows := @array.append self i
      1 if i > 1 => do:
        rows := @array.append self (2 * i)
      1 => do:
        rows := @array.append self 99
      3 => do:
        if i % 2 == 0:
          rows := @array.append self (3 * i)
        else:
          rows := @array.append self (4 * i)
      _ => ()
  return rows
