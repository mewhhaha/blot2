@@ -0,0 +1,151 @@
+const std = @import("std");
+const T = @import("types.zig");
+const a = std.testing.allocator;
+
+test "nonempty substitution retains unchanged constructors without allocating wide records" {
+    var tracked: @import("../runtime/memory.zig").TrackedAllocator = .{ .backing = a };
+    var store = try T.Store.init(tracked.allocator());
+    defer store.deinit();
+    const irrelevant = try store.fresh();
+    var fields: [64]T.Field = undefined;
+    for (&fields, 0..) |*field, index| field.* = .{ .name = @intCast(index + 1), .ty = T.u32_type };
+    const wide = try store.record(&fields);
+    const before = tracked.counts;
+    const mark = store.mark();
+    for (0..16) |_| try std.testing.expectEqual(wide, try store.substitute(wide, &.{irrelevant}, &.{T.f32_type}));
+    try std.testing.expectEqualDeep(before, tracked.counts);
+    try std.testing.expectEqualDeep(mark, store.mark());
+    const binder = try store.boundType(0, 0);
+    const roots = [_]T.Id{
+        try store.product(&.{ wide, wide }),
+        try store.functionWithEffects(wide, T.f32_type, 0),
+        try store.array(wide),
+        try store.sequence(.list, wide),
+        try store.sequence(.cursor, wide),
+        try store.demandWithEffects(wide, 0),
+        try store.provider(wide, 0),
+        try store.stateProvider(T.u32_type, T.f32_type, wide),
+        try store.resolver(wide),
+        try store.scoped(wide, .{ .unit = 2, .decl = 7 }),
+        try store.nominal(.{ .unit = 2, .decl = 8 }, &.{ wide, wide }),
+        try store.projection(.{ .unit = 2, .decl = 9 }, 31, &.{wide}),
+        try store.usage(wide, .shared, 0),
+        try store.quantified(.forall, try store.function(binder, binder), &.{binder}),
+    };
+    const ready = store.mark();
+    for (roots) |root| try std.testing.expectEqual(root, try store.substitute(root, &.{irrelevant}, &.{T.f32_type}));
+    try std.testing.expectEqualDeep(ready, store.mark());
+}
+
+fn changedFrontier(allocator: std.mem.Allocator) !void {
+    var store = try T.Store.init(allocator);
+    defer store.deinit();
+    const variable = try store.fresh();
+    const fixed = try store.record(&.{ .{ .name = 11, .ty = T.u32_type }, .{ .name = 12, .ty = T.f32_type } });
+    var original: [9]T.Id = undefined;
+    original[0] = try store.product(&.{ fixed, variable, fixed });
+    for (1..original.len) |index| original[index] = try store.product(&.{ original[index - 1], original[index - 1], fixed });
+    const before = store.nodes.items.len;
+    var changed = try store.substitute(original[8], &.{variable}, &.{T.u32_type});
+    try std.testing.expectEqual(@as(usize, 9), store.nodes.items.len - before);
+    var remaining: usize = original.len;
+    while (remaining != 0) {
+        remaining -= 1;
+        const node = store.node(changed);
+        const parts = store.list(.{ .start = node.a, .len = node.b });
+        try std.testing.expectEqual(fixed, parts[2]);
+        if (remaining == 0) {
+            try std.testing.expectEqual(fixed, parts[0]);
+            try std.testing.expectEqual(T.u32_type, parts[1]);
+        } else {
+            try std.testing.expectEqual(parts[0], parts[1]);
+            changed = parts[0];
+        }
+    }
+    const first = try store.fresh();
+    const second = try store.fresh();
+    const left = try store.substitute(original[0], &.{variable}, &.{first});
+    const right = try store.substitute(original[0], &.{variable}, &.{second});
+    try store.unify(first, T.u32_type);
+    try store.unify(second, T.f32_type);
+    const l = store.node(try store.resolve(left, 0));
+    const r = store.node(try store.resolve(right, 0));
+    try std.testing.expectEqual(T.u32_type, store.list(.{ .start = l.a, .len = l.b })[1]);
+    try std.testing.expectEqual(T.f32_type, store.list(.{ .start = r.a, .len = r.b })[1]);
+    try std.testing.expectEqual(variable, store.list(.{ .start = store.node(original[0]).a, .len = 3 })[1]);
+}
+test "substitution copies only changed DAG frontiers through allocation failures" {
+    try changedFrontier(a);
+    try @import("../allocation_failures.zig").checkAllAllocationFailures(a, changedFrontier, .{});
+}
+
+test "unchanged substitution preserves historical cursors fresh rows and quantified ownership" {
+    var store = try T.Store.init(a);
+    defer store.deinit();
+    const irrelevant = try store.fresh();
+    const captured = try store.fresh();
+    try store.appendVersion(captured, T.u32_type);
+    const future = try store.resolve(captured, store.cursor());
+    const callback = try store.function(T.unit, future);
+    const point = store.mark();
+    try store.appendVersion(captured, T.f32_type);
+    try std.testing.expectEqual(callback, try store.substitute(callback, &.{irrelevant}, &.{T.boolean}));
+    const first = try store.openCovariant(callback);
+    const second = try store.openCovariant(callback);
+    const first_row = store.node(first).c;
+    const second_row = store.node(second).c;
+    try std.testing.expect(store.row(first_row).tail.variable != store.row(second_row).tail.variable);
+    try store.effects.unify(first_row, 0);
+    try store.effects.unify(second_row, try store.effects.row(&.{T.foreign_operation}, .closed));
+    try std.testing.expectEqual(T.f32_type, store.node(try store.resolve(first, 0)).b);
+    store.rollback(point);
+    try store.appendVersion(captured, T.boolean);
+    try std.testing.expectEqual(callback, try store.substitute(callback, &.{irrelevant}, &.{T.u32_type}));
+    try std.testing.expectEqual(T.u32_type, try store.resolve(captured, 0));
+    try std.testing.expectEqual(T.boolean, try store.resolve(future, 0));
+    const outer = try store.fresh();
+    const binder = try store.boundType(0, 0);
+    const quantified = try store.quantifiedWithGoals(.forall, try store.function(binder, binder), &.{binder}, &.{.{ .kind = .contract, .identity = .{ .unit = 2, .decl = 4 }, .ty = outer, .source = 0 }});
+    const instance = try store.substitute(quantified, &.{outer}, &.{T.u32_type});
+    const owned = store.node(instance);
+    const fresh_binder = store.list(.{ .start = owned.b, .len = owned.c })[0];
+    try std.testing.expect(fresh_binder != binder);
+    try std.testing.expectEqual(fresh_binder, store.node(owned.a).a);
+    try std.testing.expectEqual(T.u32_type, store.quantifierGoals(instance)[0].ty);
+    try std.testing.expectEqual(outer, store.quantifierGoals(quantified)[0].ty);
+}
+
+test "unchanged substitution rechecks kind history affine payloads and projection budgets" {
+    var store = try T.Store.init(a);
+    defer store.deinit();
+    const irrelevant = try store.fresh();
+    const payload = try store.fresh();
+    const shared = try store.usage(payload, .shared, 0);
+    const unique = try store.usage(T.u32_type, .unique, 0);
+    const point = store.mark();
+    try store.appendVersion(payload, unique);
+    try std.testing.expectError(error.TypeMismatch, store.substitute(shared, &.{irrelevant}, &.{T.u32_type}));
+    store.rollback(point);
+    try std.testing.expectEqual(shared, try store.substitute(shared, &.{irrelevant}, &.{T.u32_type}));
+    const product = try store.product(&.{T.u32_type});
+    const span: T.List = .{ .start = store.node(product).a, .len = 1 };
+    // Publication may rewrite owned spans after their constructor ran.
+    for ([_]T.Id{ try store.boundType(0, 1), try store.proofKind() }) |invalid| {
+        store.replaceListItem(span, 0, invalid);
+        try std.testing.expectError(error.TypeMismatch, store.substitute(product, &.{irrelevant}, &.{T.u32_type}));
+        store.replaceListItem(span, 0, T.u32_type);
+        try std.testing.expectEqual(product, try store.substitute(product, &.{irrelevant}, &.{T.u32_type}));
+    }
+    const projection = try store.projection(.{ .unit = 2, .decl = 7 }, 31, &.{product});
+    store.projection_steps = 0;
+    store.projection_limit = 2;
+    try std.testing.expectError(error.TypeLimit, store.substitute(projection, &.{irrelevant}, &.{T.u32_type}));
+    store.projection_steps = 0;
+    store.projection_limit = 100;
+    try std.testing.expectEqual(projection, try store.substitute(projection, &.{irrelevant}, &.{T.u32_type}));
+    var deep = T.u32_type;
+    for (0..1024) |_| deep = try store.array(deep);
+    store.projection_steps = 0;
+    store.projection_limit = 100_000;
+    try std.testing.expectError(error.TypeLimit, store.substitute(deep, &.{irrelevant}, &.{T.u32_type}));
+}
