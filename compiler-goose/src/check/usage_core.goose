        Tag.usage_share => { let owner = self.module.types.node(self.module.typeOf(node.a)); let shared = self.module.types.node(node.ty); if node.b != 0 || node.c != 0 || owner.tag != TypeTag.usage || owner.b != blot_check_types::usageCode(Usage.unique) || owner.c != 0 || shared.tag != TypeTag.usage || shared.b != blot_check_types::usageCode(Usage.shared) || shared.c != 0 || !blot_check_cleanup_contracts::payloadNominal(self.module.types,self.module.nominals,owner.a) || !same(self.module,owner.a,shared.a) { return Outcome.live,Error.invalid_artifact; } let flow,err = self.expression(node.a,depth+1); if err != Error.none || flow == Outcome.exit { return flow,err; } },
