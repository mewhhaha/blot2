 if module.owner_id==0 || binding==0 || binding>=module.bindings.len || module.binding(binding).kind!=blot_reuse_principal_interface::Kind.global {return blot_error::Error.invalid_artifact;
 }let body .= module.body(binding);
 if !body {return blot_error::Error.invalid_artifact;
 }let cache .= context.source_proofs;
 if cache {if !cache.owns(module) {return blot_error::Error.invalid_artifact;
 }if cache.contains(module,binding) {return blot_error::Error.none;
 }}let claim=blot_check_scheme_equations::Body{module_owner:module.owner_id,unit:module.unit,binding:binding, ..};
