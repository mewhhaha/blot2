fn Builder::loopStatement(self:Builder&,source:u32,checked_carries:const blot_check_check::LoopCarry[:],depth:i64)->u32,Error {let syntax=self.source.tree.node(source);var info=blot_check_core::LoopInfo{kind:blot_check_core::LoopKind.forever,body:0, ..};var first_source:u32=0;var end_source:u32=0;var pattern_source:u32=0;var body_source=syntax.a;match syntax.tag {blot_parse_ast::tag_forever_stmt=>{},blot_parse_ast::tag_range_stmt=>{info.kind=blot_check_core::LoopKind.range;first_source=syntax.a;end_source=syntax.b;body_source=syntax.c;},blot_parse_ast::tag_for_stmt=>{let details=self.source.tree.extra.items[syntax.c..syntax.c+3];info.kind=blot_check_core::LoopKind.range;if details[0]==0 {info.kind=blot_check_core::LoopKind.array;}first_source=syntax.b;end_source=details[0];pattern_source=syntax.a;body_source=details[1];},_=>{abort("invalid checked loop syntax");},}let id,error=self.reserve(source);if error!=Error.none {return 0,error;}if self.tables.loops.len==0xffffffff {return 0,Error.core_limit;}let catalog=self.tables.loops.len as u32;self.tables.loops.push(info);self.tables.nodes[id]=blot_check_core::Node{tag:blot_check_core::Tag.loop_,ty:blot_check_types::unit,a:catalog, ..};self.scratch.ast_map[source]=id;if checked_carries.len>0xffffffff-self.tables.loop_carries.len {return 0,Error.core_limit;}info.carries=List{start:self.tables.loop_carries.len as u32,len:checked_carries.len as u32, ..};for carry in checked_carries {self.tables.loop_carries.push(blot_check_core::LoopCarry{incoming:carry.incoming,iteration:carry.iteration,backedge:carry.backedge,outgoing:carry.outgoing, ..});}let first,error=self.expression(first_source,depth+1);if error!=Error.none {return 0,error;}info.first=first;let end,error=self.expression(end_source,depth+1);if error!=Error.none {return 0,error;}info.end=end;if pattern_source!=0 {let pattern,error=self.patternNode(pattern_source,depth+1);if error!=Error.none {return 0,error;}info.pattern=pattern;}let body,error=self.suite(body_source,depth+1);if error!=Error.none {return 0,error;}info.body=body;info.can_exit=self.tables.loops[catalog].can_exit;self.tables.loops[catalog]=info;return id,Error.none;}
fn Builder::breakStatement(self:Builder&,source:u32,target_source:u32,bindings:const u32[:])->u32,Error {let target_id=self.scratch.ast_map[target_source];if target_id==0 || self.tables.nodes[target_id].tag!=blot_check_core::Tag.loop_ {let error=self.diagnostic(blot_check_core::Code.unresolved_binding,source);return 0,error;}let continues=self.source.tree.node(source).tag==blot_parse_ast::tag_continue_stmt;if !continues {self.tables.loops[self.tables.nodes[target_id].a].can_exit=true;}var values=WordBuffer{..};for binding in bindings {if binding==0 || binding>=self.tables.bindings.len {values.deinit();let error=self.diagnostic(blot_check_core::Code.unresolved_binding,source);return 0,error;}let value,error=self.referenceNode(source,binding,self.tables.bindings[binding].ty);if error!=Error.none {values.deinit();return 0,error;}let error=values.append(value);if error!=Error.none {values.deinit();return 0,error;}}let range,error=self.save(values.items);values.deinit();if error!=Error.none {return 0,error;}var op=blot_check_core::Op.none;if continues {op=blot_check_core::Op.continue_;}return self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.break_,op:op,ty:blot_check_types::never,a:target_id,b:range.start,c:range.len, ..});}
recursive fn Builder::statement(self:Builder&,source:u32,depth:i64)->u32,Error {if depth>=1024 {let error=self.diagnostic(blot_check_core::Code.complexity,source);return 0,error;}let syntax=self.source.tree.node(source);if self.source.checked.iterator_bodies.len!=0 && self.source.checked.iterator_bodies[source]!=0 {return self.suite(self.source.checked.iterator_bodies[source],depth+1);}for control in self.source.checked.request_controls {if control.node==source {return self.requestControl(source,control,depth+1);}}for info in self.source.checked.request_loops {if info.node==source {return self.requestLoop(source,info,depth+1);}}match syntax.tag {
