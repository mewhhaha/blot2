// Random directed graph built as CSR (two-pass count-then-fill), then 4 BFS runs.
import * as rng from "./rng"

const BENCH_N: U32 = 1000000 // BENCH_N
const DEG: U32 = 8
const SOURCES: U32 = 4
const UNVISITED: U32 = 0xFFFFFFFF

func build_csr (): (#[U32], #[U32]) =>
  let ne = BENCH_N * DEG
  let esrc = @array.fill ne 0
  let edst = @array.fill ne 0
  let start = @array.fill (BENCH_N + 1) 0
  let r: U64 = 12345u64
  let n64 = BENCH_N.to_u64
  for e in 0 .. ne:
    r := rng.xs_next self
    let u = (r % n64).to_u32
    let v = ((r >> 24u64) % n64).to_u32
    esrc[e] := u
    edst[e] := v
    start[u + 1] := self + 1

  for v in 0 .. BENCH_N:
    start[v + 1] := self + start[v]

  let cursor = copy start
  let edges = @array.fill ne 0
  for e in 0 .. ne:
    let s = esrc[e]
    let pos = cursor[s]
    edges[pos] := edst[e]
    cursor[s] := pos + 1

  return (start, edges)

io bench (): #[U32] =>
  let (start, edges) = build_csr ()
  let dist = @array.fill BENCH_N UNVISITED
  let q = @array.fill BENCH_N 0
  let total: I64 = 0
  let seed: U64 = 999
  for _ in 0 .. SOURCES:
    seed := rng.xs_next self
    let src = rng.xs_mod seed BENCH_N
    for i in 0 .. BENCH_N:
      dist[i] := UNVISITED
    dist[src] := 0
    q[0] := src
    let qlen: U32 = 1
    let qh: U32 = 0
    let pass_sum: I64 = 0
    for ever:
      if qh >= qlen:
        break
      let u = q[qh]
      qh := self + 1
      let d = dist[u]
      pass_sum := self + d.to_i64
      let lo = start[u]
      let hi = start[u + 1]
      for k in lo .. hi:
        let w = edges[k]
        if dist[w] == UNVISITED:
          dist[w] := d + 1
          q[qlen] := w
          qlen := self + 1
    total := self + pass_sum

  let out: #[U32] = #[]
  out := rng.emit_u32 self (BENCH_N + BENCH_N * DEG)
  out := rng.emit_i64 self total
  return out
