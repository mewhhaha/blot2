// Real Ink ECS (`ink/ecs` + `ink/ecs/query`) benchmarks for Ink ECS vs Bevy ECS comparison.
import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"

type Pos is data = $Pos { x: F32, y: F32, z: F32 }
type Vel is data = $Vel { vx: F32, vy: F32, vz: F32 }

type EcsWorld is data = $EcsWorld {
  alive: ecs.Entities,
  entity_meta: ecs.Metadata,
  pos: ecs.Pool Pos,
  pos_meta: ecs.Metadata,
  vel: ecs.Pool Vel,
  vel_meta: ecs.Metadata,
  active: ecs.Pool Bool,
  active_meta: ecs.Metadata,
  frozen: ecs.Pool Bool,
  frozen_meta: ecs.Metadata,
  dense_key: #[U32],
  dense_ids: #[U32],
  dense_meta: #[U32],
  sparse_key: #[U32],
  sparse_ids: #[U32],
  sparse_meta: #[U32],
}

const k_pos: U32 = 1
const k_vel: U32 = 2
const k_active: U32 = 3
const k_frozen: U32 = 4

func build_world (count: U32): EcsWorld =>
  let alive = ecs.entities ()
  let entity_meta = ecs.metadata 1
  let (ids, alive, entity_meta) = ecs.spawn_many alive entity_meta count
  let pos_vals = array.generate count (func i =>
    let f = U32.to_f32 (i & 1023)
    return $Pos { x: f * 0.25, y: f * 0.5, z: f * 0.125 })
  let vel_vals = array.generate count (func i =>
    let f = U32.to_f32 ((i & 63) + 1)
    return $Vel { vx: f * 0.01, vy: f * 0.02, vz: f * 0.005 })
  let (pos, pos_meta) = ecs.insert_selected alive (ecs.pool ()) (ecs.metadata 1) ids pos_vals
  let (vel, vel_meta) = ecs.insert_selected alive (ecs.pool ()) (ecs.metadata 1) ids vel_vals
  let active: ecs.Pool Bool = ecs.pool ()
  let active_meta = ecs.metadata 1
  let frozen: ecs.Pool Bool = ecs.pool ()
  let frozen_meta = ecs.metadata 1
  for i in 0 .. count:
    if i % 10 == 0:
      let (next_a, next_am) = ecs.insert alive active active_meta i true
      active := next_a
      active_meta := next_am
    if i % 20 == 0:
      let (next_f, next_fm) = ecs.insert alive frozen frozen_meta i true
      frozen := next_f
      frozen_meta := next_fm
  let dense_filter: query.Filter = #[$query.With k_pos, $query.With k_vel, $query.All 2]
  let sparse_filter: query.Filter = #[$query.With k_pos, $query.With k_vel, $query.With k_active, $query.Without k_frozen, $query.All 4]
  let s_pos = query.source k_pos pos pos_meta #[]
  let s_vel = query.source k_vel vel vel_meta #[]
  let s_act = query.source k_active active active_meta #[]
  let s_frz = query.source k_frozen frozen frozen_meta #[]
  let (dense_key, dense_ids, dense_meta) = query.prepare alive entity_meta dense_filter #[s_pos, s_vel] #[] #[] #[0]
  let s_pos2 = query.source k_pos pos pos_meta #[]
  let s_vel2 = query.source k_vel vel vel_meta #[]
  let (sparse_key, sparse_ids, sparse_meta) = query.prepare alive entity_meta sparse_filter #[s_pos2, s_vel2, s_act, s_frz] #[] #[] #[0]
  return $EcsWorld {
    alive, entity_meta,
    pos, pos_meta,
    vel, vel_meta,
    active, active_meta,
    frozen, frozen_meta,
    dense_key, dense_ids, dense_meta,
    sparse_key, sparse_ids, sparse_meta,
  }

func checksum_pos (pos: ecs.Pool Pos): U32 =>
  let sum: U32 = 0
  for i in 0 .. pos.length:
    if let $Some ($Pos { x, y, z }) = pos[i]:
      sum := self + F32.to_u32 ((x + y + z) * 16.0)
  return sum

// Commands for persistent process:
// cmd == 1: Dense iter via direct ecs.Pool scan (100 ticks)
// cmd == 2: Dense iter via cached ink/ecs/query selection (100 ticks)
// cmd == 3: Sparse filtered iter (With Active, Without Frozen, 5% = 500 entities, 100 ticks)
// cmd == 4: Structural churn: 2,000 balanced insert/remove Active tag ops (4 x 500)
// cmd == 5: Full world snapshot copy (alive + pos + vel + active + frozen)
func world_step (st: own EcsWorld) -> (cmd: U32): (EcsWorld, U32) =>
  let $EcsWorld {
    alive, entity_meta,
    pos, pos_meta,
    vel, vel_meta,
    active, active_meta,
    frozen, frozen_meta,
    dense_key, dense_ids, dense_meta,
    sparse_key, sparse_ids, sparse_meta,
  } = st
  let out: U32 = 0
  if cmd == 1:
    let n = pos.length
    for _ in 0 .. 100:
      for i in 0 .. n:
        if let $Some ($Pos { x, y, z }) = pos[i]:
          if let $Some ($Vel { vx, vy, vz }) = vel[i]:
            pos[i] := $Some ($Pos { x: x + vx, y: y + vy, z: z + vz })
    pos_meta := ecs.bump_payload self
    out := checksum_pos pos
  if cmd == 2:
    let dense_filter: query.Filter = #[$query.With k_pos, $query.With k_vel, $query.All 2]
    let metas = #[query.source_meta k_pos pos_meta, query.source_meta k_vel vel_meta]
    if not (query.is_current entity_meta dense_filter metas dense_key dense_meta):
      let s_pos = query.source k_pos pos pos_meta #[]
      let s_vel = query.source k_vel vel vel_meta #[]
      let (dk, di, dm) = query.prepare alive entity_meta dense_filter #[s_pos, s_vel] dense_key dense_ids dense_meta
      dense_key := dk
      dense_ids := di
      dense_meta := dm
    let m = dense_ids.length
    for _ in 0 .. 100:
      for k in 0 .. m:
        let id = dense_ids[k]
        if let $Some ($Pos { x, y, z }) = pos[id]:
          if let $Some ($Vel { vx, vy, vz }) = vel[id]:
            pos[id] := $Some ($Pos { x: x + vx, y: y + vy, z: z + vz })
    pos_meta := ecs.bump_payload self
    out := checksum_pos pos
  if cmd == 3:
    let sparse_filter: query.Filter = #[$query.With k_pos, $query.With k_vel, $query.With k_active, $query.Without k_frozen, $query.All 4]
    let metas = #[query.source_meta k_pos pos_meta, query.source_meta k_vel vel_meta, query.source_meta k_active active_meta, query.source_meta k_frozen frozen_meta]
    if not (query.is_current entity_meta sparse_filter metas sparse_key sparse_meta):
      let s_pos = query.source k_pos pos pos_meta #[]
      let s_vel = query.source k_vel vel vel_meta #[]
      let s_act = query.source k_active active active_meta #[]
      let s_frz = query.source k_frozen frozen frozen_meta #[]
      let (sk, si, sm) = query.prepare alive entity_meta sparse_filter #[s_pos, s_vel, s_act, s_frz] sparse_key sparse_ids sparse_meta
      sparse_key := sk
      sparse_ids := si
      sparse_meta := sm
    let m = sparse_ids.length
    for _ in 0 .. 100:
      for k in 0 .. m:
        let id = sparse_ids[k]
        if let $Some ($Pos { x, y, z }) = pos[id]:
          if let $Some ($Vel { vx, vy, vz }) = vel[id]:
            pos[id] := $Some ($Pos { x: x + vx, y: y + vy, z: z + vz })
    pos_meta := ecs.bump_payload self
    out := checksum_pos pos
  if cmd == 4:
    for step in 0 .. 500:
      let id_rem = step * 10
      let (next_a, next_am) = ecs.remove active active_meta id_rem
      active := next_a
      active_meta := next_am
    for step in 0 .. 500:
      let id_add = step * 10 + 5
      let (next_a, next_am) = ecs.insert alive active active_meta id_add true
      active := next_a
      active_meta := next_am
    for step in 0 .. 500:
      let id_rem = step * 10 + 5
      let (next_a, next_am) = ecs.remove active active_meta id_rem
      active := next_a
      active_meta := next_am
    for step in 0 .. 500:
      let id_add = step * 10
      let (next_a, next_am) = ecs.insert alive active active_meta id_add true
      active := next_a
      active_meta := next_am
    out := ecs.membership_revision active_meta
  if cmd == 5:
    let snap_alive = @storage.copy alive
    let snap_pos = @storage.copy pos
    let snap_vel = @storage.copy vel
    let snap_act = @storage.copy active
    let snap_frz = @storage.copy frozen
    out := snap_alive.length + snap_pos.length + snap_vel.length + snap_act.length + snap_frz.length
  return ($EcsWorld {
    alive, entity_meta,
    pos, pos_meta,
    vel, vel_meta,
    active, active_meta,
    frozen, frozen_meta,
    dense_key, dense_ids, dense_meta,
    sparse_key, sparse_ids, sparse_meta,
  }, out)

entry process ink_world: Process [U32, U32, U32] = { init: build_world, step: world_step }

// Standalone batch spawn + insert benchmark (10,000 entities with Pos + Vel + Active).
entry func ecs_spawn_batch (count: U32): U32 =>
  let alive = ecs.entities ()
  let entity_meta = ecs.metadata 1
  let (ids, alive, entity_meta) = ecs.spawn_many alive entity_meta count
  let pos_vals = array.generate count (func i =>
    let f = U32.to_f32 (i & 1023)
    return $Pos { x: f * 0.25, y: f * 0.5, z: f * 0.125 })
  let vel_vals = array.generate count (func i =>
    let f = U32.to_f32 ((i & 63) + 1)
    return $Vel { vx: f * 0.01, vy: f * 0.02, vz: f * 0.005 })
  let (pos, _) = ecs.insert_selected alive (ecs.pool ()) (ecs.metadata 1) ids pos_vals
  let (vel, _) = ecs.insert_selected alive (ecs.pool ()) (ecs.metadata 1) ids vel_vals
  let active: ecs.Pool Bool = ecs.pool ()
  let active_meta = ecs.metadata 1
  for i in 0 .. count:
    if i % 10 == 0:
      let (next_a, next_am) = ecs.insert alive active active_meta i true
      active := next_a
      active_meta := next_am
  return checksum_pos pos

// SoA flat-column + spark SIMD pattern (idiomatic Blot/Ink hot-loop layout) for 10,000 entities x 100 ticks.
type SoaWorld is data = $SoaWorld { px: #[F32], py: #[F32], pz: #[F32], vx: #[F32], vy: #[F32], vz: #[F32] }

func init_soa (count: U32): SoaWorld =>
  let px = array.generate count (func i => U32.to_f32 (i & 1023) * 0.25)
  let py = array.generate count (func i => U32.to_f32 (i & 1023) * 0.5)
  let pz = array.generate count (func i => U32.to_f32 (i & 1023) * 0.125)
  let vx = array.generate count (func i => U32.to_f32 ((i & 63) + 1) * 0.01)
  let vy = array.generate count (func i => U32.to_f32 ((i & 63) + 1) * 0.02)
  let vz = array.generate count (func i => U32.to_f32 ((i & 63) + 1) * 0.005)
  return $SoaWorld { px, py, pz, vx, vy, vz }

func step_soa (st: own SoaWorld) -> (_: U32): (SoaWorld, U32) =>
  let $SoaWorld { px, py, pz, vx, vy, vz } = st
  let n = px.length
  for _ in 0 .. 100:
    px := spark #[px[i] + vx[i] | i <- 0 .. n]
    py := spark #[py[i] + vy[i] | i <- 0 .. n]
    pz := spark #[pz[i] + vz[i] | i <- 0 .. n]
  let sum: U32 = 0
  for i in 0 .. n:
    sum := self + F32.to_u32 ((px[i] + py[i] + pz[i]) * 16.0)
  return ($SoaWorld { px, py, pz, vx, vy, vz }, sum)

entry process soa_world: Process [U32, U32, U32] = { init: init_soa, step: step_soa }
