fn scopedSite(parent:const TaskCallSite&,proof:Named&)->TaskCallSite {return TaskCallSite{proof:proof,target:parent.target,reference:parent.reference,rows:parent.rows,body:parent.body,found:parent.found,..};}
fn publishSite(target:TaskCallSite&,source:const TaskCallSite&) {target.rows=source.rows;target.found=source.found;}

fn setLocalBindings(scope:Locals&,bindings:const u32[:]) {scope.bindings=bindings;}
fn setHandlerOperations(handler:Handler&,operations:const blot_check_types::Operation[:]) {handler.operations=operations;}

fn setNamedLocals(target:Named&,locals:const Locals?) {target.locals .=locals;}

fn branchScopes(first:const u32[:],second:const u32[:],parent:const Locals?)->Locals[2] {return [localScope(first,default<const blot_check_core::Parameter[:]>(),parent),localScope(second,default<const blot_check_core::Parameter[:]>(),parent)];}
