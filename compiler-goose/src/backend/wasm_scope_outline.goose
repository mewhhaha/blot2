// Closed machine ranges share a private nonreentrant root bank after source checks.
namespace blot_backend_wasm_scope_outline;
import std;
import dictionary;
import support.error;
import support.option;
import support.native;
import support.pooled_buffer;
import support.pooled_map;
import .runtime_ir;
import .wasm;
import .wasm_copy_coalesce;
import .wasm_stackify;
import .wasm_local_compact;
import .wasm_local_order;
import .wasm_simd_ops;
import .optimizer_buffers;
type Error=blot_error::Error;
type Module=blot_backend_wasm::Module;
type Function=blot_backend_runtime_ir::Function;
type Instruction=blot_backend_runtime_ir::Instruction;
type Op=blot_backend_runtime_ir::Op;
type ValueType=blot_backend_runtime_ir::ValueType;
type Output=blot_backend_runtime_ir::DetachedBody;
type Words=blot_backend_optimizer_buffers::Words;
type Code=blot_backend_optimizer_buffers::Code;
type Types=blot_backend_optimizer_buffers::Types;
let absent:u32=0xffffffff;
enum Contract {scoped_numeric_adapter_nonreentrant}
type Mode=Contract;
struct Options {verify_copy_inputs:bool=false,minimum_instructions:i64=5000,maximum_range_instructions:i64=1800000,maximum_helpers:i64=8192,maximum_control_depth:i64=1024,maximum_globals:i64=1000000,maximum_locals:i64=49000,maximum_body_bytes:i64=7500000}
struct Work {expressions:i64,layouts:i64}
struct Ticket {function:u32,start:i64,work:Work}
type Credit=Work;
struct Stats {regions:u64=0,globals:u64=0,copies_removed:u64=0,reads_forwarded:u64=0,bank_operand_bytes_saved:u64=0}
struct Total {references:i64=0,writes:i64=0}
struct Reference {function:u32=absent,weight:u64=0}
struct Helper {function:u32,root:u32,read_before_def:u32[:] = default<u32[:]>(),credit:Credit}
struct Prepared {function:u32,body:Output=Output{..}}
struct Bank {root:u32,globals:u32[:] = default<u32[:]>()}
struct Totals {storage:Total[:] = default<Total[:]>(),items:Total[:] = default<Total[:]>(),len:i64=0}
reusable[] var pool_Totals:Total[>..]=[];
fn ensure(self_:Totals&,minimum:i64)->Error {return blot_support_pooled_buffer::ensure(self_,minimum,pool_Totals);}
fn push(self_:Totals&,value:Total)->Error {let error=blot_support_pooled_buffer::push(self_,value,pool_Totals);self_.len=self_.items.len;return error;}
fn resize(self_:Totals&,length:i64,value:Total)->Error {if length<=self_.len {blot_support_pooled_buffer::resize(self_,length);self_.len=length;return blot_error::Error.none;}let error=self_.ensure(length);if error!=blot_error::Error.none {return error;}for index in self_.len..length {self_.storage[index]=value;}self_.items=self_.storage[..length];self_.len=length;return blot_error::Error.none;}
fn deinit(self_:Totals&) {blot_support_pooled_buffer::deinit(self_,pool_Totals);self_.len=0;}
struct Helpers {storage:Helper[:] = default<Helper[:]>(),items:Helper[:] = default<Helper[:]>(),len:i64=0}
reusable[] var pool_Helpers:Helper[>..]=[];
fn ensure(self_:Helpers&,minimum:i64)->Error {return blot_support_pooled_buffer::ensure(self_,minimum,pool_Helpers);}
fn push(self_:Helpers&,value:Helper)->Error {let error=blot_support_pooled_buffer::push(self_,value,pool_Helpers);self_.len=self_.items.len;return error;}
fn resize(self_:Helpers&,length:i64,value:Helper)->Error {if length<=self_.len {blot_support_pooled_buffer::resize(self_,length);self_.len=length;return blot_error::Error.none;}let error=self_.ensure(length);if error!=blot_error::Error.none {return error;}for index in self_.len..length {self_.storage[index]=value;}self_.items=self_.storage[..length];self_.len=length;return blot_error::Error.none;}
fn deinit(self_:Helpers&) {blot_support_pooled_buffer::deinit(self_,pool_Helpers);self_.len=0;}
struct PreparedBuffer {storage:Prepared[:] = default<Prepared[:]>(),items:Prepared[:] = default<Prepared[:]>(),len:i64=0}
reusable[] var pool_PreparedBuffer:Prepared[>..]=[];
fn ensure(self_:PreparedBuffer&,minimum:i64)->Error {return blot_support_pooled_buffer::ensure(self_,minimum,pool_PreparedBuffer);}
fn push(self_:PreparedBuffer&,value:Prepared)->Error {let error=blot_support_pooled_buffer::push(self_,value,pool_PreparedBuffer);self_.len=self_.items.len;return error;}
fn resize(self_:PreparedBuffer&,length:i64,value:Prepared)->Error {if length<=self_.len {blot_support_pooled_buffer::resize(self_,length);self_.len=length;return blot_error::Error.none;}let error=self_.ensure(length);if error!=blot_error::Error.none {return error;}for index in self_.len..length {self_.storage[index]=value;}self_.items=self_.storage[..length];self_.len=length;return blot_error::Error.none;}
fn deinit(self_:PreparedBuffer&) {blot_support_pooled_buffer::deinit(self_,pool_PreparedBuffer);self_.len=0;}
struct Banks {storage:Bank[:] = default<Bank[:]>(),items:Bank[:] = default<Bank[:]>(),len:i64=0}
reusable[] var pool_Banks:Bank[>..]=[];
fn ensure(self_:Banks&,minimum:i64)->Error {return blot_support_pooled_buffer::ensure(self_,minimum,pool_Banks);}
fn push(self_:Banks&,value:Bank)->Error {let error=blot_support_pooled_buffer::push(self_,value,pool_Banks);self_.len=self_.items.len;return error;}
fn resize(self_:Banks&,length:i64,value:Bank)->Error {if length<=self_.len {blot_support_pooled_buffer::resize(self_,length);self_.len=length;return blot_error::Error.none;}let error=self_.ensure(length);if error!=blot_error::Error.none {return error;}for index in self_.len..length {self_.storage[index]=value;}self_.items=self_.storage[..length];self_.len=length;return blot_error::Error.none;}
fn deinit(self_:Banks&) {blot_support_pooled_buffer::deinit(self_,pool_Banks);self_.len=0;}
struct Pending {table:blot_support_pooled_map::Map<i64,bool> =blot_support_pooled_map::Map<i64,bool>{..}}
reusable[] var pending_slots:dictionary_slot<i64,bool>[>..]=[];
fn insert(self_:Pending&,key:i64) {blot_support_pooled_map::insert(self_.table,key,true,pending_slots);}
fn remove(self_:Pending&,key:i64) {blot_support_pooled_map::remove(self_.table,key);}
fn deinit(self_:Pending&) {blot_support_pooled_map::deinit(self_.table,pending_slots);}
struct Root {function:u32,scanned:i64=0,totals:Totals=Totals{..},helpers:Words=Words{..},pending:Pending=Pending{..}}
fn deinit(self_:Root&) {self_.totals.deinit();self_.helpers.deinit();self_.pending.deinit();}
struct Roots {storage:Root[:] = default<Root[:]>(),items:Root[:] = default<Root[:]>(),len:i64=0}
reusable[] var root_runs:Root[>..]=[];
fn push(self_:Roots&,value:Root)->Error {let error=blot_support_pooled_buffer::push(self_,value,root_runs);self_.len=self_.items.len;return error;}
fn deinit(self_:Roots&) {blot_support_pooled_buffer::deinit(self_,root_runs);self_.len=0;}
struct ContextState {roots:Roots=Roots{..},helpers:Helpers=Helpers{..},stats:Stats=Stats{..},finalized:bool=false,generation:u64=0,live:bool=false}
reusable var context_states:ContextState[>..]=[];
var inactive_context:ContextState=ContextState{..};
reusable[] var word_runs:u32[>..]=[];
reusable[] var reference_runs:Reference[>..]=[];
reusable[] var flag_runs:bool[>..]=[];
struct Context {module:Module?=null,options:Options=Options{..},slot:u32=0,generation:u64=0,roots:Roots& =inactive_context.roots,helpers:Helpers& =inactive_context.helpers,stats:Stats& =inactive_context.stats,finalized:bool& =inactive_context.finalized}
fn live(self_:const Context&)->bool {return self_.slot!=0 && self_.slot<=context_states.len && context_states[self_.slot-1].live && context_states[self_.slot-1].generation==self_.generation;}
fn target(self_:const Context&)->Module& {assert(self_.live());let module .= self_.module;assert(module);return module;}
fn init(module:Module&,contract:Contract,options:Options)->Context {let generation=blot_native::fresh_owner_id();let at=context_states.alloc_index(ContextState{generation:generation,live:true,..});let owner .= context_states[at];return Context{module:module,options:options,slot:(at+1) as u32,generation:generation,roots:owner.roots,helpers:owner.helpers,stats:owner.stats,finalized:owner.finalized,..};}
fn deinit(self_:Context&) {if self_.slot==0 {return;}assert(self_.live());for &root in self_.roots.items {root.deinit();}for helper in self_.helpers.items {if helper.read_before_def.len!=0 {word_runs.free_slice(helper.read_before_def);}}self_.roots.deinit();self_.helpers.deinit();let at=self_.slot-1;context_states[at].live=false;context_states.free(at);self_=Context{..};}
fn rootIndex(self_:const Context&,function:u32)->blot_support::Option<i64> {for root,index in self_.roots.items {if root.function==function {return blot_support::some(index);}}return blot_support::none<i64>();}
fn registerRoot(self_:Context&,function:u32)->Error {let module .= self_.target();let options=self_.options;if options.maximum_globals==0 || options.maximum_globals>1000000 || options.maximum_locals>50000 || options.maximum_body_bytes>7654321 || options.minimum_instructions==0 || options.minimum_instructions>options.maximum_range_instructions {return blot_error::Error.invalid_outline;}if self_.finalized || module.memory_model!=blot_backend_wasm::MemoryModel.data_stacks || module.artifacts || function>=module.functions.len || self_.rootIndex(function).present {return blot_error::Error.invalid_outline;}return self_.roots.push(Root{function:function,..});}
fn begin(self_:const Context&,function:u32,work:Work)->blot_support::Option<Ticket> {if self_.finalized || !self_.rootIndex(function).present {return blot_support::none<Ticket>();}return blot_support::some(Ticket{function:function,start:self_.target().instructions(function).len,work:work,..});}
fn hasCoordinates(module:const Module&,function:u32)->bool {for site in module.semantic_sites {if site.function==function {return true;}}for site in module.table_origins {if site.function==function {return true;}}return false;}
fn canRewriteSuffix(self_:const Context&,function:u32,start:i64)->bool {if self_.finalized || hasCoordinates(self_.target(),function) {return false;}let selected=self_.rootIndex(function);if selected.present {let root .= self_.roots.items[selected.value];if root.scanned>start {return false;}for entry in root.pending.table.slots {if entry.tag!=0 && entry.key>=start {return false;}}}return true;}
fn local(op:Op)->bool {return op==blot_backend_runtime_ir::OP_local_get || op==blot_backend_runtime_ir::OP_local_set || op==blot_backend_runtime_ir::OP_local_tee;}
fn localType(module:const Module&,function:const Function&,id:u32)->blot_support::Option<ValueType> {if id<function.parameters.len {return blot_support::some(module.parameters(function)[id]);}let index=id-function.parameters.len;let own=module.locals(function);if index>=own.len {return blot_support::none<ValueType>();}return blot_support::some(own[index]);}
fn sync(self_:Context&,index:i64)->Error {let module .= self_.target();let function=module.functions[self_.roots.items[index].function];let root .= self_.roots.items[index];let own=module.locals(function);if own.len>0x7fffffffffffffff-function.parameters.len {return blot_error::Error.invalid_outline;}let count=function.parameters.len+own.len;let code=blot_backend_wasm::instructions(module,function);if count>=absent || count<root.totals.len || root.scanned>code.len {return blot_error::Error.invalid_outline;}let error=root.totals.resize(count,Total{..});if error!=blot_error::Error.none {return error;}for inst in code[root.scanned..] {if local(inst.op) {if inst.operand>=count {return blot_error::Error.invalid_outline;}root.totals.items[inst.operand].references+=1;if inst.op!=blot_backend_runtime_ir::OP_local_get {root.totals.items[inst.operand].writes+=1;}}}root.scanned=code.len;return blot_error::Error.none;}
fn reserveCopy(self_:Context&,function:u32)->i64,Error {let module .= self_.target();if self_.finalized || function>=module.functions.len {return 0,blot_error::Error.invalid_outline;}let index=blot_backend_wasm::instructions(module,function).len;let error=module.reserveInstructions(function,2);if error!=blot_error::Error.none {return 0,error;}let root=self_.rootIndex(function);if root.present {self_.roots.items[root.value].pending.insert(index);}let error=module.emitSlice(function,[Instruction{op:blot_backend_runtime_ir::OP_nop,..},Instruction{op:blot_backend_runtime_ir::OP_nop,..}]);return index,error;}
fn copyPair(self_:Context&,function:u32,index:i64)->Error {let module .= self_.target();if self_.finalized || function>=module.functions.len {return blot_error::Error.invalid_outline;}let code=blot_backend_wasm::instructions(module,function);if index>=code.len || code.len-index<2 {return blot_error::Error.invalid_outline;}for inst in code[index..index+2] {if inst.op!=blot_backend_runtime_ir::OP_nop || inst.table_reference || inst.table_kind!=blot_backend_runtime_ir::TABLE_unknown {return blot_error::Error.invalid_outline;}}return blot_error::Error.none;}
fn releaseCopy(self_:Context&,function:u32,index:i64)->Error {let error=self_.copyPair(function,index);if error!=blot_error::Error.none {return error;}let root=self_.rootIndex(function);if root.present {self_.roots.items[root.value].pending.remove(index);}return blot_error::Error.none;}
fn patchCopy(self_:Context&,function:u32,index:i64,src:u32,dst:u32)->Error {let error=self_.copyPair(function,index);if error!=blot_error::Error.none {return error;}let module .= self_.target();let source=module.functions[function];let own=module.locals(source);if own.len>0x7fffffffffffffff-source.parameters.len {return blot_error::Error.invalid_outline;}let count=source.parameters.len+own.len;let src_type=localType(module,source,src);let dst_type=localType(module,source,dst);if src>=count || dst>=count || !src_type.present || !dst_type.present || src_type.value!=blot_backend_runtime_ir::VT_i32 || dst_type.value!=blot_backend_runtime_ir::VT_i32 {return blot_error::Error.invalid_outline;}let selected=self_.rootIndex(function);if selected.present {let root .= self_.roots.items[selected.value];if count<root.totals.len {return blot_error::Error.invalid_outline;}let error=root.totals.resize(count,Total{..});if error!=blot_error::Error.none {return error;}if index<root.scanned {if root.scanned-index<2 {return blot_error::Error.invalid_outline;}root.totals.items[src].references+=1;root.totals.items[dst].references+=1;root.totals.items[dst].writes+=1;}root.pending.remove(index);}let first,error=module.mutableInstruction(function,index);if error!=blot_error::Error.none {return error;}let second,error=module.mutableInstruction(function,index+1);if error!=blot_error::Error.none {return error;}first.op=blot_backend_runtime_ir::OP_local_get;first.operand=src;second.op=blot_backend_runtime_ir::OP_local_set;second.operand=dst;return blot_error::Error.none;}
struct Use {references:i64=0,writes:i64=0}
struct Proof {uses:dictionary<u32,Use>&,read_before_def:dictionary<u32,bool>&}
struct ProofFrame {op:Op,height:i64,entry_poly:bool,entry_flow:bool,mark:i64,alternate:bool=false,exits:Words=Words{..},has_exit:bool=false}
fn pop(stack:ValueType[>..]&,floor:i64,poly:bool,wanted:ValueType)->bool {if stack.len==floor && poly {return true;}if stack.len<=floor {return false;}let actual=stack.pop();return wanted==blot_backend_runtime_ir::VT_none || actual==wanted;}
fn initializedValue(initialized:dictionary<u32,bool>&,id:u32)->bool {let value .= ::get(initialized,id);if !value {return false;}return value;}
fn restore(initialized:dictionary<u32,bool>&,journal:u32[>..]&,mark:i64) {for id in journal[mark..] {let value .= ::get(initialized,id);assert(value);value=false;}journal.resize(mark);}
fn mergeExit(frame:ProofFrame&,initialized:dictionary<u32,bool>&,inputs:dictionary<u32,bool>&,journal:const u32[:])->Error {if !frame.has_exit {let error=frame.exits.append(journal[frame.mark..]);if error!=blot_error::Error.none {return error;}frame.has_exit=true;return blot_error::Error.none;}var kept:i64=0;for id in frame.exits.items {if initializedValue(initialized,id) || ::contains(inputs,id) {frame.exits.items[kept]=id;kept+=1;}}frame.exits.resize(kept);return blot_error::Error.none;}
fn closeFrame(frame:ProofFrame&,initialized:dictionary<u32,bool>&,inputs:dictionary<u32,bool>&,journal:u32[>..]&,stack:ValueType[>..]&,flow:bool,poly:bool)->bool,bool,Error {if !poly && stack.len!=frame.height {return false,false,blot_error::Error.none;}if flow {let error=mergeExit(frame,initialized,inputs,journal);if error!=blot_error::Error.none {return false,false,error;}}if frame.op==blot_backend_runtime_ir::OP_if_ && !frame.alternate && frame.entry_flow {frame.has_exit=true;frame.exits.clear();}restore(initialized,journal,frame.mark);if frame.has_exit {for id in frame.exits.items {if !initializedValue(initialized,id) && !::contains(inputs,id) {::insert(initialized,id,true);journal.push(id);}}}stack.resize(frame.height);return true,frame.has_exit,blot_error::Error.none;}
fn analyzeProof(module:const Module&,source:const Function&,code:const Instruction[:],control_limit:i64,uses:dictionary<u32,Use>&,inputs:dictionary<u32,bool>&)->bool,Error {uses.clear();inputs.clear();var stack:ValueType[>..]=[];var frames:ProofFrame[>..]=[];var initialized:dictionary<u32,bool> = dictionary<u32,bool> {};var journal:u32[>..]=[];var proof=Proof{uses:uses,read_before_def:inputs,..};let admitted,error=scanProof(proof,module,source,code,control_limit,stack,frames,initialized,journal);for &frame in frames {frame.exits.deinit();}return admitted,error;}
fn scanProof(self_:Proof&,module:const Module&,source:const Function&,code:const Instruction[:],control_limit:i64,stack:ValueType[>..]&,frames:ProofFrame[>..]&,initialized:dictionary<u32,bool>&,journal:u32[>..]&)->bool,Error {var poly=false;var flow=true;for inst in code {if inst.op==blot_backend_runtime_ir::OP_ownership || inst.op==blot_backend_runtime_ir::OP_resource_retire || inst.op==blot_backend_runtime_ir::OP_wide_layouts || inst.op==blot_backend_runtime_ir::OP_return_ || inst.op==blot_backend_runtime_ir::OP_call_indirect {return false,blot_error::Error.none;}var floor:i64=0;if frames.len!=0 {floor=frames[frames.len-1].height;}if local(inst.op) {let ty=localType(module,source,inst.operand);if !ty.present || ty.value!=blot_backend_runtime_ir::VT_i32 {return false,blot_error::Error.none;}{let use .= ::get_or_insert(self_.uses,inst.operand,Use{..});use.references+=1;if inst.op!=blot_backend_runtime_ir::OP_local_get {use.writes+=1;}}if flow {if inst.op==blot_backend_runtime_ir::OP_local_get {if !initializedValue(initialized,inst.operand) {::insert(self_.read_before_def,inst.operand,true);}}else if !initializedValue(initialized,inst.operand) && !::contains(self_.read_before_def,inst.operand) {::insert(initialized,inst.operand,true);journal.push(inst.operand);}}}match inst.op {
 blot_backend_runtime_ir::OP_block,blot_backend_runtime_ir::OP_loop,blot_backend_runtime_ir::OP_if_=>{if (inst.operand!=0 && inst.operand!=blot_backend_runtime_ir::VT_none as u32) || frames.len>=control_limit {return false,blot_error::Error.none;}if inst.op==blot_backend_runtime_ir::OP_if_ && !pop(stack,floor,poly,blot_backend_runtime_ir::VT_i32) {return false,blot_error::Error.none;}frames.push(ProofFrame{op:inst.op,height:stack.len,entry_poly:poly,entry_flow:flow,mark:journal.len,..});continue;},
 blot_backend_runtime_ir::OP_else_=>{if frames.len==0 {return false,blot_error::Error.none;}let frame .= frames[frames.len-1];if frame.op!=blot_backend_runtime_ir::OP_if_ || frame.alternate || (!poly && stack.len!=frame.height) {return false,blot_error::Error.none;}if flow {let error=mergeExit(frame,initialized,self_.read_before_def,journal);if error!=blot_error::Error.none {return false,error;}}restore(initialized,journal,frame.mark);stack.resize(frame.height);frame.alternate=true;poly=frame.entry_poly;flow=frame.entry_flow;continue;},
 blot_backend_runtime_ir::OP_end=>{if frames.len==0 {return false,blot_error::Error.none;}var frame=frames.pop();let valid,reachable,error=closeFrame(frame,initialized,self_.read_before_def,journal,stack,flow,poly);frame.exits.deinit();if error!=blot_error::Error.none || !valid {return false,error;}flow=reachable;poly=frame.entry_poly;continue;},
 blot_backend_runtime_ir::OP_br,blot_backend_runtime_ir::OP_br_if=>{if inst.operand>=frames.len {return false,blot_error::Error.none;}if inst.op==blot_backend_runtime_ir::OP_br_if && !pop(stack,floor,poly,blot_backend_runtime_ir::VT_i32) {return false,blot_error::Error.none;}let target .= frames[frames.len-1-inst.operand];if flow && target.op!=blot_backend_runtime_ir::OP_loop {let error=mergeExit(target,initialized,self_.read_before_def,journal);if error!=blot_error::Error.none {return false,error;}}if inst.op==blot_backend_runtime_ir::OP_br {stack.resize(floor);poly=true;flow=false;}continue;},blot_backend_runtime_ir::OP_unreachable_=>{stack.resize(floor);poly=true;flow=false;continue;},
 blot_backend_runtime_ir::OP_call,blot_backend_runtime_ir::OP_call_import=>{if inst.op==blot_backend_runtime_ir::OP_call && inst.operand>=module.functions.len {return false,blot_error::Error.none;}if inst.op==blot_backend_runtime_ir::OP_call_import && (inst.operand>=module.imports.len || module.imports[inst.operand].signature>=module.signatures.len) {return false,blot_error::Error.none;}let signature=blot_backend_runtime_ir::call(module,inst);var at=signature.parameters.len;while at!=0 {at-=1;if !pop(stack,floor,poly,module.types[signature.parameters.start+at]) {return false,blot_error::Error.none;}}if signature.result!=blot_backend_runtime_ir::VT_none {stack.push(signature.result);}continue;},blot_backend_runtime_ir::OP_global_get,blot_backend_runtime_ir::OP_global_set=>{if inst.operand>=module.globals.len {return false,blot_error::Error.none;}},_=>{},
 }let contract=blot_backend_runtime_ir::contract(module,source,inst);if contract.arity>contract.inputs.len {return false,blot_error::Error.none;}var at=contract.arity;while at!=0 {at-=1;if !pop(stack,floor,poly,contract.inputs[at]) {return false,blot_error::Error.none;}}if contract.result!=blot_backend_runtime_ir::VT_none {stack.push(contract.result);}}return frames.len==0 && (poly || stack.len==0),blot_error::Error.none;}
enum GlobalMap {dense {values:const u32[:] = default<const u32[:]>()},sparse {map:dictionary<u32,u32>&}}
fn lookupGlobal(self_:GlobalMap,id:u32)->blot_support::Option<u32> {match self_ {sparse value=>{let item .= ::get(value.map,id);if !item {return blot_support::none<u32>();}return blot_support::some(item);},dense value=>{if id<value.values.len && value.values[id]!=absent {return blot_support::some(value.values[id]);}return blot_support::none<u32>();},}}
fn I(op:Op,operand:u32=0)->Instruction {return Instruction{op:op,operand:operand,..};}
fn prepareBody(module:const Module&,source:const Function&,code:const Instruction[:],is_root:bool,globals:GlobalMap)->Output,Error {var locals=Types{..};var out=Code{..};let error=prepareInstructions(module,source,code,is_root,globals,locals,out);if error!=blot_error::Error.none {out.deinit();locals.deinit();return Output{..},error;}let created,error=blot_backend_optimizer_buffers::finish(locals,out);if error!=blot_error::Error.none {return Output{..},error;}var result=created;let prepared,error=prepareTransforms(module,source,is_root,globals,result);if error!=blot_error::Error.none {result.deinit();return Output{..},error;}return prepared,blot_error::Error.none;}
