type Builder=blot_backend_optimizer_buffers::Builder;
struct Source {first_array:u32,second_array:u32,target:u32,first:u32,second:u32,output:u32,first_limit:u32,second_limit:u32}
fn reference(module:const Core&,id:u32)->blot_support::Option<u32> {if id==0 || module.node(id).tag!=blot_check_core::Tag.reference {return blot_support::none<u32>();}let target=module.reference(id);if target.unit!=0 && target.unit!=module.unit {return blot_support::none<u32>();}return blot_support::some(target.binding);}
fn scalarReference(module:const Core&,id:u32)->blot_support::Option<u32> {if module.node(id).ty!=blot_check_types::u32_type {return blot_support::none<u32>();}return reference(module,id);}
fn isReference(module:const Core&,id:u32,binding:u32)->bool {let result=reference(module,id);return result.present && result.value==binding;}
fn isScalar(module:const Core&,id:u32,binding:u32)->bool {let result=scalarReference(module,id);return result.present && result.value==binding;}
fn only(module:const Core&,id:u32)->u32 {if module.node(id).tag==blot_check_core::Tag.suite {let children=module.children(id);if children.len==1 {return children[0];}}return id;}
fn empty(module:const Core&,id:u32)->bool {return id==0 || (module.node(id).tag==blot_check_core::Tag.suite && module.children(id).len==0);}
struct Read {array:u32,cursor:u32}
fn read(module:const Core&,id:u32)->blot_support::Option<Read> {let node=module.node(id);if node.tag!=blot_check_core::Tag.array_op || module.arrayOperation(id)!=blot_backend_collection_ops::Op.get || node.ty!=blot_check_types::u32_type {return blot_support::none<Read>();}let args=module.children(id);if args.len!=2 {return blot_support::none<Read>();}let array=reference(module,args[0]);let cursor=scalarReference(module,args[1]);if !array.present || !cursor.present {return blot_support::none<Read>();}return blot_support::some(Read{array:array.value,cursor:cursor.value,..});}
struct Exit {cursor:u32,limit:u32}
fn exit(module:const Core&,id:u32,loop_id:u32)->blot_support::Option<Exit> {let node=module.node(id);if node.tag!=blot_check_core::Tag.if_stmt || !empty(module,node.c) || module.branchMerges(id).len!=0 {return blot_support::none<Exit>();}let condition=module.node(node.a);if condition.tag!=blot_check_core::Tag.scalar || condition.op!=blot_check_core::Op.less || condition.c!=0 {return blot_support::none<Exit>();}let stop=only(module,node.b);let done=module.node(stop);if done.tag!=blot_check_core::Tag.break_ || done.a!=loop_id || done.op!=blot_check_core::Op.none {return blot_support::none<Exit>();}let carries=module.loopCarries(loop_id);let values=module.breakValues(stop);if values.len!=carries.len {return blot_support::none<Exit>();}for value,index in values {if !isReference(module,value,carries[index].iteration) {return blot_support::none<Exit>();}}let cursor=scalarReference(module,condition.b);let limit=scalarReference(module,condition.a);if !cursor.present || !limit.present {return blot_support::none<Exit>();}return blot_support::some(Exit{cursor:cursor.value,limit:limit.value,..});}
fn increment(module:const Core&,id:u32,cursor:u32)->blot_support::Option<u32> {let node=module.node(id);if node.tag!=blot_check_core::Tag.bind {return blot_support::none<u32>();}let add=module.node(node.b);if add.tag!=blot_check_core::Tag.scalar || add.op!=blot_check_core::Op.add || add.c!=0 || add.ty!=blot_check_types::u32_type || !isScalar(module,add.a,cursor) {return blot_support::none<u32>();}let one=module.node(add.b);if one.tag!=blot_check_core::Tag.constant || one.ty!=blot_check_types::u32_type || one.a!=1 {return blot_support::none<u32>();}return blot_support::some(node.a);}
struct Arm {target:u32,output:u32,stored:u32,stepped:u32}
fn arm(module:const Core&,id:u32,input:Read)->blot_support::Option<Arm> {if module.node(id).tag!=blot_check_core::Tag.suite {return blot_support::none<Arm>();}let children=module.children(id);if children.len!=2 {return blot_support::none<Arm>();}let store=module.node(children[0]);if store.tag!=blot_check_core::Tag.bind || module.node(store.b).tag!=blot_check_core::Tag.update {return blot_support::none<Arm>();}let update=module.updateInfo(store.b);let selectors=module.updateSelectors(store.b);if selectors.len!=1 || selectors[0].kind!=blot_check_core::UpdateKind.index || selectors[0].result_type!=blot_check_types::u32_type || module.updatePath(store.b).len!=0 {return blot_support::none<Arm>();}let rhs=read(module,update.value);if !rhs.present || rhs.value!=input {return blot_support::none<Arm>();}let target=reference(module,update.root);let output=scalarReference(module,selectors[0].index);let stepped=increment(module,children[1],input.cursor);if !target.present || !output.present || !stepped.present {return blot_support::none<Arm>();}return blot_support::some(Arm{target:target.value,output:output.value,stored:store.a,stepped:stepped.value,..});}
fn merged(module:const Core&,id:u32,yes:u32,no:u32)->blot_support::Option<u32> {for merge in module.branchMerges(id) {if merge.then_binding==yes && merge.else_binding==no {return blot_support::some(merge.result);}}return blot_support::none<u32>();}
