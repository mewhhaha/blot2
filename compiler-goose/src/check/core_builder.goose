     let pa,e1=self_.projectEffectTypeSubst(arg,old_vars,new_args,depth+1);
     if e1!=blot_error::Error.none { blot_check_core_builder::deinit(sub_args); blot_check_core_builder::deinit(inner_words); return 0,e1; }
     let e2=blot_check_core_builder::append(sub_args,pa);
     if e2!=blot_error::Error.none { blot_check_core_builder::deinit(sub_args); blot_check_core_builder::deinit(inner_words); return 0,e2; }
    }
    let node,en=self_.projectEffectFamilyFromArgs(fam_opt.value,sub_args.items,depth+1,inner_words);
