    for binding in captures { if self.module.types.node(self.module.bindings[binding].ty).tag == TypeTag.erased_proof { return Value {}, Error.invalid_artifact; } let value = self.lookup(binding); if value.present { let err = ordinary(value.value); if err != Error.none { return Value {}, err; } } }
    let previous: Entry[>..<]& = self.environment; let previous_returns: Return[>..<]& = self.returns; let previous_facts: Fact[>..<]& = self.facts; let previous_loop .= self.loop;
    var environment: Entry[>..<]; var returns: Return[>..<]; var facts: Fact[>..<]; self.environment .= environment; self.returns .= returns; self.facts .= facts; self.loop .= null;
