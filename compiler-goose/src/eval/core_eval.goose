enum SummaryJobState { queued,running,waiting,complete,declined }
struct SummaryJob { key: CallSummaryKey,state: SummaryJobState=SummaryJobState.queued,region: blot_support::Option<RegionSnapshot>=blot_support::none<RegionSnapshot>(),region_active: bool=false,scope: blot_support::Option<u32>=blot_support::none<u32>(),result: u32=0,recorded: u64=0,private_declined: bool=false }
struct CallSummaryTables { keys: dictionary<CallSummaryKey,i64>&,jobs: SummaryJob[>..<]&,stack: i64[>..<]&,active: dictionary<Target,i64>&,active_lexical: dictionary<u32,i64>&,components: blot_eval_scope_components::Graph&,eligibility: dictionary<Target,bool>&,checked_requirements: dictionary<Target,bool>&,completed_interfaces: dictionary<Target,blot_support::Option<const Target[:]>>& ,public_requirements: dictionary<Target,HeaderParts>&,constant_requirements: dictionary<Target,bool>&,source_declines: dictionary<PrincipalGraphKey,bool>&,normalized_declines: dictionary<PrincipalGraphKey,bool>&,open_principals: dictionary<PrincipalGraphKey,bool>&,result_principals: dictionary<PrincipalGraphKey,bool>& }
struct CallSummaries { keys: dictionary<CallSummaryKey,i64>&,jobs: SummaryJob[>..<]&,stack: i64[>..<]&,active: dictionary<Target,i64>&,active_lexical: dictionary<u32,i64>&,components: blot_eval_scope_components::Graph&,current: blot_support::Option<i64>=blot_support::none<i64>(),restart: blot_support::Option<i64>=blot_support::none<i64>(),eligibility: dictionary<Target,bool>&,checked_requirements: dictionary<Target,bool>&,completed_interfaces: dictionary<Target,blot_support::Option<const Target[:]>>& ,completed_interface_targets: i64=0,public_requirements: dictionary<Target,HeaderParts>&,public_requirement_slots: i64=0,constant_requirements: dictionary<Target,bool>&,principals: PrincipalQueries,normalized_principals: PrincipalQueries,open_principals: dictionary<PrincipalGraphKey,bool>&,result_principals: dictionary<PrincipalGraphKey,bool>&,draining: bool=false }
fn initCallSummaries(t: CallSummaryTables) -> CallSummaries { return CallSummaries {keys:t.keys,jobs:t.jobs,stack:t.stack,active:t.active,active_lexical:t.active_lexical,components:t.components,eligibility:t.eligibility,checked_requirements:t.checked_requirements,completed_interfaces:t.completed_interfaces,public_requirements:t.public_requirements,constant_requirements:t.constant_requirements,principals:initPrincipalQueries(PrincipalClaim.source_description,t.source_declines),normalized_principals:initPrincipalQueries(PrincipalClaim.open_residual,t.normalized_declines),open_principals:t.open_principals,result_principals:t.result_principals}; }
fn member(self: const CallSummaries&,root: i64,index: i64) -> bool { return self.components.component(index as u32)==self.components.component(root as u32); }
fn request(self: CallSummaries&,session: Session&,key: CallSummaryKey) -> blot_support::Option<SummaryJob>,Error { if session.summary_exhausted { return blot_support::none<SummaryJob>(),Error.none; } var active=blot_support::none<i64>(); if key.lexical!=0 { let found=self.active_lexical.get(key.lexical); if found { active=blot_support::some<i64>(found); } } else { let found=self.active.get(key.target); if found { active=blot_support::some<i64>(found); } } if active.present { let admitted,error=dependency(self,session,active.value); if error!=Error.none||!admitted { return blot_support::none<SummaryJob>(),error; } return blot_support::some(self.jobs[active.value]),Error.none; }
 let known=self.keys.get(key); if known { let index=known; let job=self.jobs[index]; if job.state==SummaryJobState.complete||job.state==SummaryJobState.declined { return blot_support::some(job),Error.none; } let admitted,error=dependency(self,session,index); if error!=Error.none||!admitted { return blot_support::none<SummaryJob>(),error; } if job.state==SummaryJobState.queued { var at: i64=-1; for selected,position in self.stack { if selected==index { at=position; break; } } assert(at>=0); for position in at..self.stack.len-1 { self.stack[position]=self.stack[position+1]; } self.stack[self.stack.len-1]=index; } return blot_support::some(job),Error.none; }
 if self.jobs.len>=session.options.max_values { return blot_support::none<SummaryJob>(),Error.type_limit; } let index=self.jobs.len; self.keys.insert(key,index); self.jobs.push(SummaryJob {key:key}); self.stack.push(index); session.split_attempts++; let admitted,error=dependency(self,session,index); if error!=Error.none||!admitted { return blot_support::none<SummaryJob>(),error; } return blot_support::some(self.jobs[index]),Error.none;
}
fn dependency(self: CallSummaries&,session: Session&,index: i64) -> bool,Error { if !self.current.present { return summaryCharge(session,1),Error.none; } let from=self.current.value; let root=self.components.component(from as u32); if root==self.components.component(index as u32)&&root<self.components.nodes.len&&self.components.nodes[root].recursive { return false,Error.none; } let before=session.summary_transitions; let merged,error=self.components.add(from as u32,index as u32,self.jobs.len,session.summary_transitions,summaryLimit(session)); if error!=Error.none { if error==Error.out_of_memory { return false,error; } session.summary_exhausted=true; return false,Error.none; } session.summary_graph_work=satAdd(session.summary_graph_work,session.summary_transitions-before); if merged { self.restart=blot_support::some(self.components.component(from as u32) as i64); } return true,Error.none; }
fn removeSummaryFrame(self: CallSummaries&,index: i64) { for value,at in self.stack { if value!=index { continue; } for position in at..self.stack.len-1 { self.stack[position]=self.stack[position+1]; } self.stack.resize(self.stack.len-1); return; } }
fn finish(self: CallSummaries&,session: Session&,index: i64,result: u32) { let key=self.jobs[index].key; if key.lexical!=0 { self.active_lexical.remove(key.lexical); } else { self.active.remove(key.target); } if self.jobs[index].region.present { let snapshot=self.jobs[index].region.value; let error=destroySuspendedRegion(session,snapshot); assert(error==Error.none); self.jobs[index].region=blot_support::none<RegionSnapshot>(); } self.jobs[index].region_active=false; self.jobs[index].result=result; self.jobs[index].state=SummaryJobState.complete; if result==0 { self.jobs[index].state=SummaryJobState.declined; session.split_declined++; } else { session.split_accepted++; } self.jobs[index].recorded=0; if session.principal_reads { self.jobs[index].recorded=session.principal_reads.serial; } removeSummaryFrame(self,index); }
fn decline(self: CallSummaries&,session: Session&,index: i64,error: Error) -> Error { if error==Error.out_of_memory { return error; } discardDiagnostic(session); finish(self,session,index,0); return Error.none; }
fn abandonPending(self: CallSummaries&,session: Session&) { self.keys.clear(); var retained=0; for job in self.jobs { if job.state==SummaryJobState.queued||job.state==SummaryJobState.running||job.state==SummaryJobState.waiting { if job.region.present { let snapshot=job.region.value; let error=destroySuspendedRegion(session,snapshot); assert(error==Error.none); } } else { self.jobs[retained]=job; self.keys.insert(job.key,retained); retained++; } } self.jobs.resize(retained); self.stack.clear(); self.active.clear(); self.active_lexical.clear(); self.components.clear(); self.current=blot_support::none<i64>(); self.restart=blot_support::none<i64>(); }
