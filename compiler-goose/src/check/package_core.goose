recursive fn parametricBody<C>(module:const Module&,binding:u32,context:C,remaining:i64&)->Error {if binding==0 || binding>=module.bindings.len {return blot_error::Error.invalid_artifact;}let body .= module.body(binding);if !body || !body.is_function {return blot_error::Error.invalid_artifact;}var admission=packageAdmission(remaining);var scopes=ownedViews(module.types,remaining,module.obligations);let error=scopes.initialize();if error!=blot_error::Error.none {admission.deinit();return error;}var walker=sourceBodyWalker(module,contextView(context),scopes,admission);let error=walker.proveBody(body);admission.deinit();return error;}
