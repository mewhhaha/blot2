struct Location { container: ValueId,field: u32,wrapped: bool }
fn genericField(self: Session&,owner: i64,source: u32,name: u32,value: ValueId) -> Location,Error { let info=valueInfo(self,value); if info.kind==ValueKind.record { let names=recordFieldNames(self,value); if names.len!=info.len { return default<Location>(),failNode(self,owner,source,Code.unsupported); } for field,index in names { if field==name { return Location {value,index as u32,false},Error.none; } } return default<Location>(),failNode(self,owner,source,Code.unsupported); } if info.kind!=ValueKind.nominal||info.len!=1||name==0 { return default<Location>(),failNode(self,owner,source,Code.unsupported); } if (info.nominal as u32)&blot_check_types::opaque_name_bit!=0&&info.nominal>>32!=unitId(self,owner) { return default<Location>(),failNode(self,owner,source,Code.missing_field); } let location=self.field_locations.get(FieldKey {info.nominal,info.bits,name}); if location==null { return default<Location>(),failNode(self,owner,source,Code.unsupported); } let container=valueChildren(self,value)[0]; let record=valueInfo(self,container); if record.kind!=ValueKind.record||record.len!=location.len { return default<Location>(),failNode(self,owner,source,Code.unsupported); } return Location {container,location.field,true},Error.none; }
fn projectionLocation(self: Session&,owner: i64,source: u32,projection_index: u32,value: ValueId) -> Location,Error { let module=self.units[owner]; let projection=module.projection(projection_index); let variants=module.projectionVariants(projection_index); if projection.nominal.decl==0&&variants.len==0 { return genericField(self,owner,source,projection.field,value); } let info=valueInfo(self,value); if info.kind==ValueKind.record&&projection.field!=0 { return genericField(self,owner,source,projection.field,value); } var field=blot_support::none<u32>(); var container=value; var wrapped=false;
