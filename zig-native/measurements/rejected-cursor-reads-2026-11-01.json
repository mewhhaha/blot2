  "prototype": {
    "patch": {
      "path": "zig-native/measurements/rejected-cursor-reads-2026-11-01.patch",
      "sha256": "c7ab750ffd355ddf25b1cd327faa4b2ced6d34ec52cfb1d63a60a4af25bdcc98"
    },
    "applies_to_parent_source": true,
    "api": "TypeView{id,at}; child inherits selected cursor. readView pure bounded per-graph admission then full ordered validation, selectView and materializeView. openCovariantView fuses ordinary reading/covariant opening; normalization-only shared graphs reuse invocation-local answers, fresh rows remain independent.",
    "fallback": "Projection/associated/custom-depth use original resolver and original recursive key queries. Rich/rank/scoped/proof/sorted leaves decline per graph; has_rank_types alone does not disable a mixed Store. Admission capped65536including row hops/labels.",
    "consumer_boundary": "ordinaryApplication begins with concrete fused-open Id; metadata/contextual/lazy/rich child refs preserve original head and raw Id behavior. Pending products and closed keys propagate cursor into type children and operation rows. expandUse, post-solve output capture, constraint solving and final Checked/Core publication remain materialization boundaries.",
    "depth_policy": "New view API is internal and scoped to fixed-policy Engine invocations. It does not emulate eager resolver root-cache warming under arbitrary later Store.resolution_depth_limit mutation. Views retain no validation authority; later materialization uses current policy. Existing resolve/cache behavior was unchanged.",
    "ownership": "Views borrow existing solver nodes; no pointers/slices retained across array growth, solver rollback or publication. Numeric spans reread keys/inputs safely. No persistent view cache/receipt.",
    "counters": "Temporary diagnostic view counters are archived with the rejected prototype; no new fields remain in the live compiler."
  },
