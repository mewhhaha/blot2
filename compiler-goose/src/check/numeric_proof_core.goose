recursive fn closureBody(self_: Checker&, metadata: blot_check_core::ClosureInfo, previous: const Entry[:], captures: const u32[:], depth: i64) -> Value, Error {
    for binding in captures { var found = blot_support::none<Value>(); for entry in previous { if entry.binding == binding { found = blot_support::some(entry.value); } } var value = Value {..}; if found.present { value = found.value; } else { let fresh, err = self_.version(self_.module.bindings[binding].ty, binding); if err != blot_error::Error.none { return Value {..}, err; } value = fresh; } let err = self_.bind(binding, value); if err != blot_error::Error.none { return Value {..}, err; } }
    if self_.module.types.node(metadata.parameter.ty).tag == blot_check_types::Tag.erased_proof { return Value {..}, blot_error::Error.invalid_artifact; } let fresh, err = self_.version(metadata.parameter.ty, metadata.parameter.binding); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.bind(metadata.parameter.binding, fresh); if err != blot_error::Error.none { return Value {..}, err; } let value, err = self_.walk(metadata.body, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(value); if err != blot_error::Error.none { return Value {..}, err; } if self_.returns.items.len != 0 { return Value {..}, blot_error::Error.invalid_artifact; } return Value {..}, blot_error::Error.none;
}
recursive fn pattern(self_: Checker&, id: u32, depth: i64) -> Error { if id == 0 { return blot_error::Error.none; } if depth >= 128 { return blot_error::Error.proof_analysis_limit; } let err = self_.values.charge(1); if err != blot_error::Error.none { return err; } let value = self_.module.pattern(id); match value.tag {
    bind => { let fresh, err = self_.version(self_.module.bindings[value.a].ty, value.a); if err != blot_error::Error.none { return err; } return self_.bind(value.a, fresh); },
    product => { for child in self_.module.patternChildren(id) { let err = self_.pattern(child, depth + 1); if err != blot_error::Error.none { return err; } } },
    constructor, record_payload => { if value.b != 0 { return self_.pattern(value.b, depth + 1); } },
    value => { let value, err = self_.walk(value.a, depth + 1); if err != blot_error::Error.none { return err; } return ordinary(value); }, _ => {},
    } return blot_error::Error.none;
}
recursive fn ordinaryWalk(self_: Checker&, id: u32, depth: i64) -> Error { let value, err = self_.walk(id, depth + 1); if err != blot_error::Error.none { return err; } return ordinary(value); }
recursive fn walk(self_: Checker&, id: u32, depth: i64) -> Value, Error {
    if id == 0 { return Value {..}, blot_error::Error.none; } if depth >= 128 { return Value {..}, blot_error::Error.proof_analysis_limit; } let err = self_.values.charge(1); if err != blot_error::Error.none { return Value {..}, err; } let module .= self_.module; let n = module.node(id);
    match n.tag {
        task, storage => { let err = self_.operands(module.children(id), depth); return Value {..}, err; },
        staging => { return Value {..}, blot_error::Error.none; },
        constant => { if module.types.node(n.ty).tag == blot_check_types::Tag.unsigned32 { let operand, err = self_.values.intern(Term { tag: blot_check_numeric_proof_terms::Tag.literal, a: n.a , ..}); return Value { operand: operand , ..}, err; } },
        reference => { let reference = module.reference(id); if reference.unit == 0 || reference.unit == module.unit { let value = self_.lookup(reference.binding); if value.present { return value.value, blot_error::Error.none; } if module.types.node(n.ty).tag == blot_check_types::Tag.erased_proof { return Value {..}, blot_error::Error.invalid_artifact; } let binding = module.bindings[reference.binding]; if binding.kind != blot_reuse_principal_interface::Kind.global && binding.kind != blot_reuse_principal_interface::Kind.external { return Value {..}, blot_error::Error.invalid_artifact; } return self_.version(n.ty, reference.binding); } },
        proof_guard => { let left, err = self_.walk(n.a, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let right, err = self_.walk(n.b, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(left); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(right); if err != blot_error::Error.none { return Value {..}, err; } if left.operand == 0 || right.operand == 0 { return Value {..}, blot_error::Error.invalid_artifact; } let relation, err = blot_check_numeric_proof_terms::relationFromCode(n.c); if err != blot_error::Error.none { return Value {..}, blot_error::Error.invalid_artifact; } let proposition = Proposition { relation, left.operand, right.operand , ..}; let err = self_.values.view().proposition(proposition); if err != blot_error::Error.none { return Value {..}, err; }
            if self_.plan { let admitted, err = self_.query(proposition); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.plan.record(id, admitted); if err != blot_error::Error.none { return Value {..}, err; } } let err = self_.fact(Fact.order { proposition , ..}); return Value { proof: blot_support::some(proposition) , ..}, err;
        },
        bind => { let value, err = self_.walk(n.b, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } if (module.types.node(module.bindings[n.a].ty).tag == blot_check_types::Tag.erased_proof) != value.proof.present { return Value {..}, blot_error::Error.invalid_artifact; } let err = self_.bind(n.a, value); return Value {..}, err; },
        call => { let invocation = module.call(id); return self_.call(id, invocation.target, invocation.callee_type, invocation.arguments, depth); },
        apply => {return applied(self_,id,depth); },
        block_, suite => { let bindings = self_.environment.items.len; let returns = self_.returns.items.len; var exits = false; var traversal_error = blot_error::Error.none; for child in module.children(id) { let value, err = self_.walk(child, depth + 1); if err != blot_error::Error.none { traversal_error = err; break; } if value.exits { exits = true; break; } }
            if n.tag == blot_check_core::Tag.block_ { self_.environment.resize(bindings); } if traversal_error != blot_error::Error.none { return Value {..}, traversal_error; }
            if n.tag == blot_check_core::Tag.block_ { var result = blot_support::none<Value>(); let proof_result = module.types.node(n.ty).tag == blot_check_types::Tag.erased_proof; for returned in self_.returns.items[returns..] { if returned.target != id { return Value {..}, blot_error::Error.invalid_artifact; } if result.present { let combined, err = join(result.value, returned.value, proof_result); if err != blot_error::Error.none { return Value {..}, err; } result = blot_support::some(combined); } else { result = blot_support::some(returned.value); } } self_.returns.resize(returns); if proof_result && (!result.present || !result.value.proof.present) { return Value {..}, blot_error::Error.invalid_artifact; } if result.present { return result.value, blot_error::Error.none; } return self_.version(n.ty, 0); } return Value { exits: exits || module.types.node(n.ty).tag == blot_check_types::Tag.never , ..}, blot_error::Error.none;
        },
        return_ => { let value, err = self_.walk(n.a, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } if self_.returns.items.len >= self_.values.limits.terms { return Value {..}, blot_error::Error.proof_analysis_limit; } let stored=blot_support_pooled_buffer::push(self_.returns,Return { n.b, value , ..},return_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} return Value { exits: true , ..}, blot_error::Error.none; },
        if_value, if_stmt => { let condition, err = self_.walk(n.a, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(condition); if err != blot_error::Error.none { return Value {..}, err; } return self_.branches(id, condition.condition, n.b, n.c, depth); },
        closure => { return self_.closure(id, depth); },
        loop_ => { return self_.loopValue(id, depth); },
        match_ => { let err = self_.operands(module.matchInputs(id), depth); if err != blot_error::Error.none { return Value {..}, err; } let start = self_.environment.items.len; let facts = self_.facts.items.len; var result = blot_support::none<Value>(); let proof_result = module.types.node(n.ty).tag == blot_check_types::Tag.erased_proof;
            for arm in module.matchArms(id) { for row in module.armRows(arm) { for pattern in module.rowPatterns(row) { let err = self_.pattern(pattern, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } } } let condition, err = self_.walk(arm.guard_, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(condition); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.assume(condition.condition, true, 0); if err != blot_error::Error.none { return Value {..}, err; } let value, err = self_.walk(arm.body, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } if result.present { let combined, err = join(result.value, value, proof_result); if err != blot_error::Error.none { return Value {..}, err; } result = blot_support::some(combined); } else { result = blot_support::some(value); } self_.environment.resize(start); self_.facts.resize(facts); }
            if proof_result && (!result.present || !result.value.proof.present) { return Value {..}, blot_error::Error.invalid_artifact; } if result.present { return result.value, blot_error::Error.none; } return self_.version(n.ty, 0);
        },
        pattern_bind => { let subject, err = self_.walk(n.b, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(subject); if err != blot_error::Error.none { return Value {..}, err; } if n.c != 0 { let facts = self_.facts.items.len; let bindings = self_.environment.items.len; let fallback, err = self_.walk(n.c, depth + 1); self_.facts.resize(facts); self_.environment.resize(bindings); if err != blot_error::Error.none { return Value {..}, err; } if !fallback.exits { return Value {..}, blot_error::Error.invalid_artifact; } } else { let binding = opaqueReferenceBinding(module, n.a); if binding.present { let err = self_.bind(binding.value, subject); return Value {..}, err; } } let err = self_.pattern(n.a, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } },
        array_op => { return self_.arrayOperation(id, depth); },
        array => { let children = module.children(id); let err = self_.operands(children, depth); if err != blot_error::Error.none { return Value {..}, err; } let result, err = self_.version(n.ty, 0); if err != blot_error::Error.none { return result, err; } if self_.plan && result.operand != 0 { let count, err = self_.values.intern(Term { tag: blot_check_numeric_proof_terms::Tag.literal, a: children.len as u32 , ..}); if err != blot_error::Error.none { return result, err; } let length, err = self_.length(result); if err != blot_error::Error.none { return result, err; } let err = self_.order(blot_check_numeric_proof_terms::Relation.eq, length, count); if err != blot_error::Error.none { return result, err; } } return result, blot_error::Error.none; },
        break_ => { let err = self_.operands(module.children(id), depth); if err != blot_error::Error.none { return Value {..}, err; } var target .= self_.loop_; while target { if target.source == n.a { if n.op != blot_check_core::Op.continue_ { target.breaks = true; } return Value { exits: true , ..}, blot_error::Error.none; } target .= target.previous; } return Value {..}, blot_error::Error.invalid_artifact; },
        product, record, contract_method => { let err = self_.operands(module.children(id), depth); if err != blot_error::Error.none { return Value {..}, err; } },
        scalar => { let left, err = self_.walk(n.a, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let right, err = self_.walk(n.b, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(left); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(right); if err != blot_error::Error.none { return Value {..}, err; } if n.c == 0 && left.operand != 0 && right.operand != 0 && module.types.node(module.typeOf(n.a)).tag == blot_check_types::Tag.unsigned32 && module.types.node(module.typeOf(n.b)).tag == blot_check_types::Tag.unsigned32 { let comparison, err = self_.comparison(n.op, left.operand, right.operand); if err != blot_error::Error.none { return Value {..}, err; } if comparison != 0 { return Value { condition: comparison , ..}, blot_error::Error.none; } if self_.plan && module.types.node(n.ty).tag == blot_check_types::Tag.unsigned32 { return self_.arithmetic(id, n.op, left, right); } } },
        logical => { let left, err = self_.walk(n.a, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(left); if err != blot_error::Error.none { return Value {..}, err; } let facts = self_.facts.items.len; let err = self_.assume(left.condition, n.op == blot_check_core::Op.and_, 0); if err != blot_error::Error.none { return Value {..}, err; } let right, err = self_.walk(n.b, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(right); if err != blot_error::Error.none { return Value {..}, err; } self_.facts.resize(facts); let condition, err = self_.condition(Condition { op: n.op, left: left.condition, right: right.condition , ..}); return Value { condition: condition , ..}, err; },
        associated => { let left, err = self_.walk(n.a, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let right, err = self_.walk(n.b, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(left); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(right); if err != blot_error::Error.none { return Value {..}, err; } for selected in self_.selected { let err = self_.values.charge(1); if err != blot_error::Error.none { return Value {..}, err; } if selected.node == id { return self_.summaryCall(selected.target, [left, right], 0); } } },
        record_merge, type_same, effect_provider, handle => { let err = self_.ordinaryWalk(n.a, depth); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.ordinaryWalk(n.b, depth); if err != blot_error::Error.none { return Value {..}, err; } },
        construct => { if n.b != 0 { let payload, err = self_.walk(n.b, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(payload); if err != blot_error::Error.none { return Value {..}, err; } if opaqueReferenceConstructor(module, n.a) { return payload, blot_error::Error.none; } } },
        resource_release, usage_share, usage_read, package_pack, project, result_associated, computation, effect_scope => { let err = self_.ordinaryWalk(n.a, depth); if err != blot_error::Error.none { return Value {..}, err; } },
        resource_scope, state_provider => { for child in [n.a, n.b, n.c] { let err = self_.ordinaryWalk(child, depth); if err != blot_error::Error.none { return Value {..}, err; } } },
        resource_acquire, usage_borrow => { let err = self_.ordinaryWalk(n.a, depth); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.ordinaryWalk(n.b, depth); if err != blot_error::Error.none { return Value {..}, err; } },
        package_unpack => { let err = self_.ordinaryWalk(n.a, depth); if err != blot_error::Error.none { return Value {..}, err; } let frontier = self_.environment.items.len; let err = self_.bind(n.b, Value {..}); if err != blot_error::Error.none { return Value {..}, err; } let value, err = self_.walk(module.packageOpening(id).body, depth + 1); self_.environment.resize(frontier); return value, err; },
        update => { let metadata = module.updateInfo(id); let root, err = self_.walk(metadata.root, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(root); if err != blot_error::Error.none { return Value {..}, err; } if metadata.self_binding != 0 { let err = self_.bind(metadata.self_binding, root); if err != blot_error::Error.none { return Value {..}, err; } } for selector in module.updateSelectors(id) { let err = self_.ordinaryWalk(selector.index, depth); if err != blot_error::Error.none { return Value {..}, err; } } let err = self_.ordinaryWalk(metadata.value, depth); if err != blot_error::Error.none { return Value {..}, err; } if self_.plan && kind(module.types.node(n.ty).tag).present { return self_.preserveLength(id, root); } },
        resolver_op => { let err = self_.ordinaryWalk(module.resolverInfo(id).resolver, depth); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.operands(module.resolverArguments(id), depth); if err != blot_error::Error.none { return Value {..}, err; } },
        operation_value => { let metadata = module.operationValue(id); let err = self_.ordinaryWalk(metadata.capability, depth); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.ordinaryWalk(metadata.witness, depth); if err != blot_error::Error.none { return Value {..}, err; } },
        request_loop => { let metadata = module.requestLoopInfo(id); let err = self_.ordinaryWalk(metadata.computation, depth); if err != blot_error::Error.none { return Value {..}, err; } for arm in module.requestArms(id) { let err = self_.ordinaryWalk(arm.selector, depth); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.ordinaryWalk(arm.callback, depth); if err != blot_error::Error.none { return Value {..}, err; } } return self_.requestCompletion(id, metadata, depth); },
        request_decision => { let err = self_.ordinaryWalk(n.b, depth); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.ordinaryWalk(n.c, depth); if err != blot_error::Error.none { return Value {..}, err; } },
        invalid => { return Value {..}, blot_error::Error.invalid_artifact; }, panic => { return Value { exits: true , ..}, blot_error::Error.none; },
        constructor_function, primitive_function, type_constructor, effect_reflection => {},
    }
    if module.types.node(n.ty).tag == blot_check_types::Tag.erased_proof { return Value {..}, blot_error::Error.invalid_artifact; } return self_.version(n.ty, 0);
}
recursive fn loopValue(self_: Checker&, id: u32, depth: i64) -> Value, Error {
    let module .= self_.module; let metadata = module.loopInfo(id); let first, err = self_.walk(metadata.first, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let end, err = self_.walk(metadata.end, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(first); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(end); if err != blot_error::Error.none { return Value {..}, err; } let bindings = self_.environment.items.len; let facts = self_.facts.items.len;
    for carry in module.loopCarries(id) { if module.types.node(module.bindings[carry.iteration].ty).tag == blot_check_types::Tag.erased_proof { return Value {..}, blot_error::Error.invalid_artifact; } let fresh, err = self_.version(module.bindings[carry.iteration].ty, carry.iteration); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.bind(carry.iteration, fresh); if err != blot_error::Error.none { return Value {..}, err; } }
    let err = self_.pattern(metadata.pattern, depth + 1); if err != blot_error::Error.none { return Value {..}, err; }
    if metadata.kind == blot_check_core::LoopKind.range && metadata.pattern != 0 && module.pattern(metadata.pattern).tag == blot_check_core::PatternTag.bind { let index = self_.lookup(module.pattern(metadata.pattern).a); if !index.present { return Value {..}, blot_error::Error.invalid_artifact; } if first.operand != 0 && end.operand != 0 && index.value.operand != 0 { let err = self_.order(blot_check_numeric_proof_terms::Relation.le, first.operand, index.value.operand); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.order(blot_check_numeric_proof_terms::Relation.lt, index.value.operand, end.operand); if err != blot_error::Error.none { return Value {..}, err; } } }
    var loop_ = loopFrame(id,self_.loop_); var scoped=scopedChecker(self_,self_.environment,self_.returns,self_.facts,loop_); let body, err = scoped.walk(metadata.body, depth + 1); publishChecker(self_,scoped); if err != blot_error::Error.none { return Value {..}, err; } self_.facts.resize(facts); self_.environment.resize(bindings);
    for carry in module.loopCarries(id) { let fresh, err = self_.version(module.bindings[carry.outgoing].ty, carry.outgoing); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.bind(carry.outgoing, fresh); if err != blot_error::Error.none { return Value {..}, err; } }
    return Value { exits: metadata.kind == blot_check_core::LoopKind.forever && !metadata.can_exit && !loop_.breaks , ..}, blot_error::Error.none;
}
recursive fn arrayOperation(self_: Checker&, id: u32, depth: i64) -> Value, Error {
    let module .= self_.module; let operation = module.arrayOperation(id); let arguments = module.children(id); let ty = module.typeOf(id);
    if operation == blot_backend_collection_ops::Op.length && arguments.len == 1 { let collection, err = self_.walk(arguments[0], depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(collection); if err != blot_error::Error.none { return Value {..}, err; } if collection.operand == 0 { return Value {..}, blot_error::Error.invalid_artifact; } let length, err = self_.length(collection); return Value { operand: length , ..}, err; }
    if self_.plan && (operation == blot_backend_collection_ops::Op.get || operation == blot_backend_collection_ops::Op.set) { let collection, err = self_.walk(arguments[0], depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let index, err = self_.walk(arguments[1], depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(collection); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(index); if err != blot_error::Error.none { return Value {..}, err; } if arguments.len > 2 { let err = self_.operands(arguments[2..], depth); if err != blot_error::Error.none { return Value {..}, err; } } var admitted = false; if collection.operand != 0 && index.operand != 0 { let proven, err = self_.query(Proposition { blot_check_numeric_proof_terms::Relation.index, collection.operand, index.operand , ..}); if err != blot_error::Error.none { return Value {..}, err; } admitted = proven; } let err = self_.plan.record(id, admitted); if err != blot_error::Error.none { return Value {..}, err; } if operation == blot_backend_collection_ops::Op.set { return self_.preserveLength(id, collection); } return self_.version(ty, 0); }
    if self_.plan && (operation == blot_backend_collection_ops::Op.identity || operation == blot_backend_collection_ops::Op.convert) { let collection, err = self_.walk(arguments[0], depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(collection); if err != blot_error::Error.none { return Value {..}, err; } if operation == blot_backend_collection_ops::Op.identity && kind(module.types.node(ty).tag) == kind(module.types.node(module.typeOf(arguments[0])).tag) { return collection, blot_error::Error.none; } return self_.preserveLength(id, collection); }
    if self_.plan && (operation == blot_backend_collection_ops::Op.fill || operation == blot_backend_collection_ops::Op.generate) { let count, err = self_.walk(arguments[0], depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(count); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.operands(arguments[1..], depth); if err != blot_error::Error.none { return Value {..}, err; } let result, err = self_.version(ty, 0); if err != blot_error::Error.none { return result, err; } if result.operand != 0 && count.operand != 0 { let length, err = self_.length(result); if err != blot_error::Error.none { return result, err; } let err = self_.order(blot_check_numeric_proof_terms::Relation.eq, length, count.operand); if err != blot_error::Error.none { return result, err; } } return result, blot_error::Error.none; }
    let err = self_.operands(arguments, depth); if err != blot_error::Error.none { return Value {..}, err; } if module.types.node(ty).tag == blot_check_types::Tag.erased_proof { return Value {..}, blot_error::Error.invalid_artifact; } return self_.version(ty, 0);
}
recursive fn requestCompletion(self_: Checker&, id: u32, metadata: blot_check_core::RequestLoopInfo, depth: i64) -> Value, Error { let start = self_.environment.items.len; let result, err = requestCompletionBody(self_, id, metadata, depth); self_.environment.resize(start); return result, err; }
recursive fn requestCompletionBody(self_: Checker&, id: u32, metadata: blot_check_core::RequestLoopInfo, depth: i64) -> Value, Error { for binding in self_.module.requestCompletionBindings(id) { if self_.module.types.node(self_.module.bindings[binding].ty).tag == blot_check_types::Tag.erased_proof { return Value {..}, blot_error::Error.invalid_artifact; } let fresh, err = self_.version(self_.module.bindings[binding].ty, binding); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.bind(binding, fresh); if err != blot_error::Error.none { return Value {..}, err; } } let err = self_.pattern(metadata.completion_pattern, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.ordinaryWalk(metadata.completion_body, depth); if err != blot_error::Error.none { return Value {..}, err; } if self_.module.types.node(self_.module.typeOf(id)).tag == blot_check_types::Tag.erased_proof { return Value {..}, blot_error::Error.invalid_artifact; } return self_.version(self_.module.typeOf(id), 0); }
fn body(self_: Checker&, body: const blot_check_core::Body&) -> Error {
    let signature .= contract(self_.module, body.binding); let parameters = self_.module.bodyParameters(body);
    if signature { if !body.is_function || parameters.len != signature.arity { return blot_error::Error.invalid_artifact; } let err = signatureTypes(self_.module.types, self_.module.bindings[body.binding].ty, signature); if err != blot_error::Error.none { return err; } let err = signature.signature().validate(self_.values.limits); if err != blot_error::Error.none { return err; } }
    var arguments: u32[>..<]=[]; arguments.resize(parameters.len); for &value in arguments { value = 0; }
    for parameter, slot in parameters { var value, err = self_.version(parameter.ty, parameter.binding); if err != blot_error::Error.none { return err; } if self_.module.types.node(parameter.ty).tag == blot_check_types::Tag.erased_proof { if !signature { return blot_error::Error.invalid_artifact; } let proof, err = signature.signature().instantiateRequirement(self_.values, slot as u32, arguments[..slot]); if err != blot_error::Error.none { return err; } value.proof = blot_support::some(proof); let err = self_.fact(Fact.order { proof , ..}); if err != blot_error::Error.none { return err; } } arguments[slot] = value.operand; let err = self_.bind(parameter.binding, value); if err != blot_error::Error.none { return err; } }
    let result, err = self_.walk(body.root, 0); if err != blot_error::Error.none { return err; } if self_.returns.items.len != 0 { return blot_error::Error.invalid_artifact; } if result.exits { return blot_error::Error.none; }
    if signature { if signature.result.present { let expected, err = signature.signature().instantiate(self_.values, arguments); if err != blot_error::Error.none { return err; } return self_.proof(result.proof, expected[expected.len - 1]); } } return ordinary(result);
}
struct BodyContext { module: const Module&, units: const ModuleRef[:], body: const blot_check_core::Body&, selected: const Selected[:] = default<const Selected[:]>(), plan: Plan? = null, limits: Options, visits: i64 = 0 }
fn checkBody(context: BodyContext&)->Error {var environment:Entries=Entries{..};var returns:Returns=Returns{..};var facts:Facts=Facts{..};let error=checkBodyValue(context,environment,returns,facts);blot_support_pooled_buffer::deinit(facts,fact_scratch);blot_support_pooled_buffer::deinit(returns,return_scratch);blot_support_pooled_buffer::deinit(environment,entry_scratch);return error;}
fn checkBodyValue(context: BodyContext&,environment:Entries&,returns:Returns&,facts:Facts&)->Error {
    var terms: Term[>..]=[]; var index: dictionary<Term,u32> =dictionary<Term,u32>{}; var conditions: Condition[>..<]=[];
    var checker = Checker { selected: context.selected, module: context.module, units: context.units, values: blot_check_numeric_proof_terms::init(terms, index), environment: environment, returns: returns, plan: context.plan, facts: facts, conditions: conditions , ..}; checker.values.limits = context.limits;
    let err = checker.body(context.body); context.visits = checker.values.visits; terms.clear(); checker.values.deinit(); return err;
}
fn analyze(module: const Module&, units: const ModuleRef[:], limits: Options) -> Plan, Error {
    var result = plan(module); var candidate = module.has_numeric_proofs; if !candidate { for node, id in module.nodes { if node.tag == blot_check_core::Tag.array_op && (module.arrayOperation(id as u32) == blot_backend_collection_ops::Op.get || module.arrayOperation(id as u32) == blot_backend_collection_ops::Op.set) { candidate = true; break; } } } if !candidate { return result, blot_error::Error.none; }
    var remaining: i64 = 1000000; for body in module.bodies[1..] { var options = limits; options.visits = min(remaining, limits.visits); var context = BodyContext { module: module, units: units, body: body, plan: result, limits: options , ..}; let err = checkBody(context); result.visits += context.visits; if err != blot_error::Error.none { if err == blot_error::Error.out_of_memory { result.deinit(); return Plan {..}, err; } result.clear(); return result, blot_error::Error.none; } remaining -= min(remaining, context.visits); } return result, blot_error::Error.none;
}
fn analyzePrepared(module: const Module&, units: const ModuleRef[:], body: const blot_check_core::Body&, selected: const Selected[:], limits: Options) -> Plan, Error {
    var result = plan(module); if selected.len > limits.terms || body.binding == 0 || body.binding >= module.bindings.len { return result, blot_error::Error.none; } let owned .= module.body(body.binding); if !owned || !(owned .== body) || owned.binding != body.binding { return result, blot_error::Error.none; }
    var context = BodyContext { module: module, units: units, body: body, selected: selected, plan: result, limits: limits , ..}; let err = checkBody(context); result.visits = context.visits; if err != blot_error::Error.none { if err == blot_error::Error.out_of_memory { result.deinit(); return Plan {..}, err; } result.clear(); } return result, blot_error::Error.none;
}
fn validate(module: const Module&, units: const ModuleRef[:], remaining: i64&)->Error {var environment:Entries=Entries{..};var returns:Returns=Returns{..};var facts:Facts=Facts{..};let error=validateValue(module,units,remaining,environment,returns,facts);blot_support_pooled_buffer::deinit(facts,fact_scratch);blot_support_pooled_buffer::deinit(returns,return_scratch);blot_support_pooled_buffer::deinit(environment,entry_scratch);return error;}
fn validateValue(module: const Module&, units: const ModuleRef[:], remaining: i64&,environment:Entries&,returns:Returns&,facts:Facts&)->Error {
    if !module.has_numeric_proofs { return blot_error::Error.none; } let err = dataTypes(module.types, module.types.nodes); if err != blot_error::Error.none { return err; }
    var terms: Term[>..]=[]; var index: dictionary<Term,u32> =dictionary<Term,u32>{}; var conditions: Condition[>..<]=[]; var metadata = Checker { module: module, units: units, values: blot_check_numeric_proof_terms::init(terms,index), environment: environment, returns: returns, facts: facts, conditions: conditions , ..}; metadata.values.limits.visits = min(remaining, metadata.values.limits.visits); var seen: dictionary<u32,bool> =dictionary<u32,bool>{};
    for value in module.proof_contracts { if ::contains(seen,value.binding) { return blot_error::Error.invalid_artifact; } ::insert(seen,value.binding, true); let err = signatureTypes(module.types, module.bindings[value.binding].ty, value.header); if err != blot_error::Error.none { return err; } let err = value.header.signature().validateInto(metadata.values); if err != blot_error::Error.none { if err == blot_error::Error.out_of_memory { return err; } return blot_error::Error.invalid_artifact; }
        if module.bindings[value.binding].kind == blot_reuse_principal_interface::Kind.external { let selected, err = metadata.target(blot_check_core::BindingRef { binding: value.binding , ..}); if err != blot_error::Error.none { return err; } let producer .= contract(selected.module, selected.binding); if !producer || !blot_check_numeric_proof_headers::equal(value.header, producer) { return blot_error::Error.invalid_artifact; } } else if module.body(value.binding) == null { return blot_error::Error.invalid_artifact; }
    } remaining -= min(remaining, metadata.values.visits); terms.clear(); metadata.values.deinit();
    for body in module.bodies[1..] { var limits = Options {..}; limits.visits = min(remaining, limits.visits); var context = BodyContext { module: module, units: units, body: body, limits: limits , ..}; let err = checkBody(context); if err != blot_error::Error.none { if err == blot_error::Error.out_of_memory { return err; } return blot_error::Error.invalid_artifact; } remaining -= min(remaining, context.visits); } return blot_error::Error.none;
}
// Contiguous immutable module catalogs use the same admission algorithm.
// These lexical references cannot escape into the returned ID-only plan.
fn analyze(module: const Module&, units: const Module[:], limits: Options) -> Plan,Error { var owners: ModuleRef[>..<]=[]; for &unit in units { owners.push(ModuleRef {unit, ..}); } return analyze(module,owners,limits); }
fn analyzePrepared(module: const Module&, units: const Module[:], body: const blot_check_core::Body&, selected: const Selected[:], limits: Options) -> Plan,Error { var owners: ModuleRef[>..<]=[]; for &unit in units { owners.push(ModuleRef {unit, ..}); } return analyzePrepared(module,owners,body,selected,limits); }

fn loopFrame(source:u32,previous:Loop?)->Loop {return Loop{source:source,previous:previous,..};}
fn scopedChecker(parent:const Checker&,environment:Entries&,returns:Returns&,facts:Facts&,loop_:Loop?)->Checker {return Checker{selected:parent.selected,module:parent.module,units:parent.units,values:parent.values,environment:environment,returns:returns,plan:parent.plan,facts:facts,conditions:parent.conditions,degraded:parent.degraded,event:parent.event,loop_:loop_,..};}
fn publishChecker(target:Checker&,source:const Checker&) {target.values.limits=source.values.limits;target.values.visits=source.values.visits;target.values.owner_id=source.values.owner_id;target.degraded=source.degraded;target.event=source.event;}

recursive fn applied(self_:Checker&,id:u32,depth:i64)->Value, Error {var arguments:Ids=Ids{..};var actual:Values=Values{..};let result,error=appliedValue(self_,id,depth,arguments,actual);blot_support_pooled_buffer::deinit(actual,value_scratch);blot_support_pooled_buffer::deinit(arguments,id_scratch);return result,error;}
recursive fn appliedValue(self_:Checker&,id:u32,depth:i64,arguments:Ids&,actual:Values&)->Value, Error {let module .=self_.module;let n=module.node(id); var leaf = id; while module.node(leaf).tag == blot_check_core::Tag.apply { let err = self_.values.charge(1); if err != blot_error::Error.none { return Value {..}, err; } let stored=blot_support_pooled_buffer::push(arguments,module.node(leaf).b,id_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} leaf = module.node(leaf).a; } var index: i64 = 0; while index < arguments.items.len / 2 { let other = arguments.items.len - index - 1; let value = arguments.items[index]; arguments.items[index] = arguments.items[other]; arguments.items[other] = value; index += 1; }
            if module.node(leaf).tag == blot_check_core::Tag.reference { return self_.call(id, module.reference(leaf), module.typeOf(leaf), arguments.items, depth); }
            if module.node(leaf).tag == blot_check_core::Tag.associated { let method = module.node(leaf); let err = self_.values.charge(arguments.items.len + 2); if err != blot_error::Error.none { return Value {..}, err; } for operand in [method.a, method.b] { let value, err = self_.walk(operand, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let stored=blot_support_pooled_buffer::push(actual,value,value_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} } for argument in arguments.items { let value, err = self_.walk(argument, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let stored=blot_support_pooled_buffer::push(actual,value,value_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} } for value in actual.items { let err = ordinary(value); if err != blot_error::Error.none { return Value {..}, err; } } for selected in self_.selected { let err = self_.values.charge(1); if err != blot_error::Error.none { return Value {..}, err; } if selected.node == leaf { return self_.summaryCall(selected.target, actual.items, 0); } } return Value {..}, blot_error::Error.none; }
            let err = self_.ordinaryWalk(n.a, depth); if err != blot_error::Error.none { return Value {..}, err; } let err = self_.ordinaryWalk(n.b, depth); if err != blot_error::Error.none { return Value {..}, err; }
    if module.types.node(n.ty).tag == blot_check_types::Tag.erased_proof {return Value{..},blot_error::Error.invalid_artifact;} return self_.version(n.ty,0);
}

fn setIdLength(buffer:Ids&,length:i64) {buffer.items=buffer.storage[..length];}
fn summaryLocals(entries:const Entry[:],parent:const SummaryInputs&)->SummaryInputs {return SummaryInputs.locals{entries:entries,parent:parent};}
fn summaryParameters(bindings:const blot_check_core::Parameter[:],values:const Value[:])->SummaryInputs {return SummaryInputs.parameters{bindings:bindings,values:values};}
