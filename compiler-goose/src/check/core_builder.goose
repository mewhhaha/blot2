fn ifLetStatement(self:Builder&,source:u32,syntax:blot_parse_ast::Node,depth:i64)->u32,Error {let input,error=self.expression(syntax.b,depth+1);if error!=Error.none {return 0,error;}let input_range,error=self.save([input]);if error!=Error.none {return 0,error;}let pattern,error=self.patternNode(syntax.a,depth+1);if error!=Error.none {return 0,error;}let success_row,error=self.addPatternRow([pattern]);if error!=Error.none {return 0,error;}let wildcard,error=self.addPattern(source,blot_check_core::Pattern{tag:blot_check_core::PatternTag.wildcard,ty:self.tables.nodes[input].ty, ..});if error!=Error.none {return 0,error;}let fallback_row,error=self.addPatternRow([wildcard]);if error!=Error.none {return 0,error;}let suites=self.source.tree.extra.items[syntax.c..syntax.c+2];let then_body,error=self.suite(suites[0],depth+1);if error!=Error.none {return 0,error;}let else_body,error=self.suite(suites[1],depth+1);if error!=Error.none {return 0,error;}let arm_start=self.tables.match_arms.len as u32;self.tables.match_arms.append([blot_check_core::MatchArm{rows:List{start:success_row,len:1, ..},body:then_body,span:self.source.tree.span(source), ..},blot_check_core::MatchArm{rows:List{start:fallback_row,len:1, ..},body:else_body,span:self.source.tree.span(source), ..}]);let index=self.tables.matches.len as u32;self.tables.matches.push(blot_check_core::MatchInfo{inputs:input_range,arms:List{start:arm_start,len:2, ..},statement:true, ..});let id,error=self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.match_,ty:blot_check_types::unit,a:index, ..});if error!=Error.none {return 0,error;}let error=self.copyMerges(source,id);return id,error;}
fn Builder::statementArm(self:const Builder&,source:u32)->bool {return self.scratch.statement_arms.len!=0 && self.scratch.statement_arms[source]!=0;}
