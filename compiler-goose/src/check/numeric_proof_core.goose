    if node.tag == blot_check_core::Tag.block_ { let value, err = self_.summaryBlock(module, inputs, id, [], depth); return value.operand, err; }
    if node.tag == blot_check_core::Tag.suite && module.children(id).len == 1 { return self_.summaryOperand(module, inputs, module.children(id)[0], depth + 1); }
    if node.tag == blot_check_core::Tag.array_op && module.arrayOperation(id) == blot_backend_collection_ops::Op.length { let children = module.children(id); if children.len != 1 { return 0, blot_error::Error.none; } let operand, err = self_.summaryOperand(module, inputs, children[0], depth + 1); if err != blot_error::Error.none || operand == 0 { return 0, err; } let term, err = self_.values.view().get(operand); if err != blot_error::Error.none { return 0, err; } if term.kind != blot_check_numeric_proof_terms::Kind.array && term.kind != blot_check_numeric_proof_terms::Kind.list { return 0, blot_error::Error.none; } return self_.values.intern(Term { tag: blot_check_numeric_proof_terms::Tag.length, a: operand , ..}); } return 0, blot_error::Error.none;
