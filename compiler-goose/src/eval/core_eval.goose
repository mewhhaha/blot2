fn principalSameInner(context: PrincipalSame&,store: const blot_check_types::Store&) -> Error { let same,error=blot_reuse_principal_type_graph::sameOpen(store,context.left,context.right,context.region.session.options.max_type_depth,context.region.session.options.max_values); context.result=same; return error; }
