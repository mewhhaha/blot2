 else { if first.kind!=ValueKind.effect_descriptor { return Flow.value {0},failNode(self,owner,id,Code.type_mismatch); } matches=first.bits==second.bits; } var bits: u32=0; if matches { bits=1; } let result,e2=makeScalar(self,owner,id,Value {blot_backend_runtime_ir::SC_bool,bits}); return Flow.value {result},e2;
