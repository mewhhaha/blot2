fn closureBody(self: Checker&, metadata: blot_check_core::ClosureInfo, previous: const Entry[:], captures: const u32[:], depth: i64) -> Value, Error {
    for binding in captures { var found = blot_support::none<Value>(); for entry in previous { if entry.binding == binding { found = blot_support::some(entry.value); } } var value = Value {}; if found.present { value = found.value; } else { let fresh, err = self.version(self.module.bindings[binding].ty, binding); if err != Error.none { return Value {}, err; } value = fresh; } let err = self.bind(binding, value); if err != Error.none { return Value {}, err; } }
    if self.module.types.node(metadata.parameter.ty).tag == TypeTag.erased_proof { return Value {}, Error.invalid_artifact; } let fresh, err = self.version(metadata.parameter.ty, metadata.parameter.binding); if err != Error.none { return Value {}, err; } let err = self.bind(metadata.parameter.binding, fresh); if err != Error.none { return Value {}, err; } let value, err = self.walk(metadata.body, depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(value); if err != Error.none { return Value {}, err; } if self.returns.len != 0 { return Value {}, Error.invalid_artifact; } return Value {}, Error.none;
