reusable[] var pool_Values:Value[>..]=[];
fn ensure(self_:Values&,minimum:i64)->Error {return blot_support_pooled_buffer::ensure(self_,minimum,pool_Values);}
fn push(self_:Values&,value:Value)->Error {let error=blot_support_pooled_buffer::push(self_,value,pool_Values);self_.len=self_.items.len;return error;}
fn append(self_:Values&,values:const Value[:])->Error {let error=blot_support_pooled_buffer::append(self_,values,pool_Values);self_.len=self_.items.len;return error;}
fn resize(self_:Values&,length:i64) {blot_support_pooled_buffer::resize(self_,length);self_.len=length;}
fn pop(self_:Values&)->Value {assert(self_.len!=0);let value=self_.items[self_.len-1];self_.resize(self_.len-1);return value;}
fn clear(self_:Values&) {self_.resize(0);}
fn deinit(self_:Values&) {blot_support_pooled_buffer::deinit(self_,pool_Values);self_.len=0;}
