// Pure construction boundaries retain caller roots across recursive checks.
fn namedProof(workspace:Workspace?,m:const Module&,units:const ModuleRef[:],remaining:i64&,variables:List=List{..},current_scheme:blot_support::Option<blot_check_types::Scheme> =blot_support::none<blot_check_types::Scheme>(),row_variables:List=List{..},row_owners:i64=0,active_calls:const CallOwner?=null,ambient:blot_support::Option<blot_check_effects::Row> =blot_support::none<blot_check_effects::Row>())->Named {return Named{workspace:workspace,m:m,units:units,remaining:remaining,variables:variables,current_scheme:current_scheme,row_variables:row_variables,row_owners:row_owners,active_calls:active_calls,ambient:ambient,..};}
fn effectProof(workspace:Workspace?,m:const Module&,units:const ModuleRef[:],target_module:const Module&,target:blot_check_effects::Row,closed_rows:List,remaining:i64&,checked_calls:bool=false,variables:List=List{..},ambient:blot_support::Option<blot_check_effects::Row> =blot_support::none<blot_check_effects::Row>(),row_owners:i64=0,handlers:const Handler?=null)->Effects {return Effects{workspace:workspace,m:m,units:units,target_module:target_module,target:target,closed_rows:closed_rows,remaining:remaining,checked_calls:checked_calls,variables:variables,handlers:handlers,ambient:ambient,row_owners:row_owners,..};}
fn localScope(bindings:const u32[:]=default<const u32[:]>(),parameters:const blot_check_core::Parameter[:]=default<const blot_check_core::Parameter[:]>(),parent:const Locals?=null)->Locals {return Locals{bindings:bindings,parameters:parameters,parent:parent,..};}
fn loopOwner(node:u32,parent:LoopOwner?=null)->LoopOwner {return LoopOwner{node:node,parent:parent,..};}
fn loanOwner(region:u32,parent:const LoanOwner?=null)->LoanOwner {return LoanOwner{region:region,parent:parent,..};}
fn callOwner(module:const Module&,binding:u32,parent:const CallOwner?=null)->CallOwner {return CallOwner{module:module,binding:binding,parent:parent,..};}
fn decisionOwner(callback:u32,ty:u32,breaks:bool&)->DecisionOwner {return DecisionOwner{callback:callback,ty:ty,breaks:breaks,..};}
fn collectionProof(reader:Named&,closed:List)->CollectionProof {return CollectionProof{reader:reader,closed:closed,..};}
fn taskCallSite(proof:Named&,target:u32,reference:bool,rows:List,body:const blot_check_core::Body&)->TaskCallSite {return TaskCallSite{proof:proof,target:target,reference:reference,rows:rows,body:body,..};}
fn handlerScope(operations:const blot_check_types::Operation[:]=default<const blot_check_types::Operation[:]>(),parent:const Handler?=null)->Handler {return Handler{operations:operations,parent:parent,..};}
fn typeViews(types:const blot_check_core::Types&,remaining:i64&,obligations:const blot_check_core::Obligation[:]=default<const blot_check_core::Obligation[:]>(),executable:bool=false)->Views {return Views{types:types,remaining:remaining,obligations:obligations,executable:executable,..};}
fn packageContext(units:const ModuleRef[:])->blot_check_package_core::Context {return blot_check_package_core::Context{units:units,..};}

