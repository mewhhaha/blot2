fn selectedEffects(module:const Module&,units:const ModuleRef[:],id:u32,producer:const Module&,body:const blot_check_core::Body&,closed_rows:List,variables:const u32[:],formal_variables:const u32[:],substitutions:const u32[:],instance:const Principal?,row_owners:const RowOwner?,ambient:blot_support::Option<blot_check_effects::Row>,remaining:i64&,workspace:Workspace?,depth:i64)->Error {
