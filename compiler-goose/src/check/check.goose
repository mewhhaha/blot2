fn Engine::lexicalDictionaryGoal(self:Engine&,wanted:blot_check_types::Obligation)->bool,blot_error::Error {if wanted.kind!=blot_check_types::ObligationKind.contract || wanted.source==0 {return false,blot_error::Error.none;}let occurrence=self.tree.span(wanted.source);for implementation in self.rank_implementations {let err=self.inferenceTransition();if err!=blot_error::Error.none {return false,err;}if implementation.node==0 || implementation.scope==0 {continue;}var body=implementation.node;let syntax=self.tree.node(body);if syntax.tag==blot_parse_ast::tag_package_unpack {body=self.tree.extra.items[syntax.c+2];}let boundary=self.tree.span(body);if occurrence.start<boundary.start || occurrence.end>boundary.end {continue;}let owner=self.types.node(implementation.quantified);if (owner.tag!=blot_check_types::Tag.forall && owner.tag!=blot_check_types::Tag.existential) || owner.c>128 {continue;}let binders=equation_type_ids.alloc_slice(owner.c);for value,index in self.types.list(blot_check_types::List{owner.b,owner.c}) {binders[index]=value;}let goals=equation_values.alloc_slice(self.types.quantifierGoals(implementation.quantified).len);for value,index in self.types.quantifierGoals(implementation.quantified) {goals[index]=value;}let result,err=lexicalDictionaryInstance(self,wanted,implementation.scope,binders,goals);equation_values.free_slice(goals);equation_type_ids.free_slice(binders);if err!=blot_error::Error.none || result {return result,err;}}return false,blot_error::Error.none;}
fn lexicalDictionaryInstance(self:Engine&,wanted:blot_check_types::Obligation,scope:u32,binders:const u32[:],goals:const blot_check_types::Obligation[:])->bool,blot_error::Error {var replacements:u32[128]=[0;128];for binder,index in binders {let leaf=self.types.node(binder);let root,err=self.types.rigid(scope,leaf.a,leaf.b);if err!=blot_error::Error.none {return false,err;}replacements[index]=root;}for goal in goals {let err=self.inferenceTransition();if err!=blot_error::Error.none {return false,err;}if goal.kind!=wanted.kind || goal.identity!=wanted.identity {continue;}let given,err=self.types.substituteGoal(goal,binders,replacements[..binders.len]);if err!=blot_error::Error.none {return false,err;}let before,err=self.types.resolve(given.ty,0);if err!=blot_error::Error.none {return false,err;}let after,err=self.types.resolve(wanted.ty,0);if err!=blot_error::Error.none {return false,err;}let same,err=self.types.equalSymbolic(before,after);if err!=blot_error::Error.none || same {return same,err;}}return false,blot_error::Error.none;}
fn Engine::finishDictionaryGoals(self:Engine&,body:u32)->blot_error::Error {let boundary=self.tree.span(body);for ordinal in 0..self.pending.len {let pending=self.pending[ordinal];if pending.solved || pending.value.kind!=blot_check_types::ObligationKind.contract || pending.value.source==0 {continue;}let span=self.tree.span(pending.value.source);if span.start<boundary.start || span.end>boundary.end {continue;}let arguments=self.types.node(self.types.head(pending.value.ty,0));if arguments.tag!=blot_check_types::Tag.product {continue;}let given,err=self.contractGiven(pending.value.identity,self.types.list(blot_check_types::List{arguments.a,arguments.b}));if err!=blot_error::Error.none {return err;}if given {self.pending[ordinal].solved=true;}}return blot_error::Error.none;}
fn Engine::memberTemplate(self:Engine&,binding:u32,charge:bool)->blot_support::Option<blot_reuse_principal_interface::MemberTemplate>,blot_error::Error {for candidate in self.member_templates {if charge {let err=self.inferenceTransition();if err!=blot_error::Error.none {return blot_support::none<blot_reuse_principal_interface::MemberTemplate>(),err;}}if candidate.binding==binding {return blot_support::some(candidate),blot_error::Error.none;}}return blot_support::none<blot_reuse_principal_interface::MemberTemplate>(),blot_error::Error.none;}
fn Engine::finishDictionaryUses(self:Engine&,body:u32)->blot_error::Error {if self.dictionary_givens.len==0 {return blot_error::Error.none;}let boundary=self.tree.span(body);for syntax,ordinal in self.tree.nodes.items {let err=self.inferenceTransition();if err!=blot_error::Error.none {return err;}if syntax.tag!=blot_parse_ast::tag_name && syntax.tag!=blot_parse_ast::tag_field_access {continue;}let source=ordinal as u32;let span=self.tree.span(source);if span.start<boundary.start || span.end>boundary.end {continue;}let template,err=self.memberTemplate(self.resolved[source],true);if err!=blot_error::Error.none {return err;}if !template.present {continue;}var already=false;for use in self.dictionary_uses {let err=self.inferenceTransition();if err!=blot_error::Error.none {return err;}if use.source!=source {continue;}already=true;break;}if already {continue;}var selected=blot_support::none<DictionaryUse>();for given in self.dictionary_givens {let err=self.inferenceTransition();if err!=blot_error::Error.none {return err;}let goal=given.predicate;if goal.kind!=blot_check_types::ObligationKind.contract || goal.identity!=template.value.contract {continue;}let application=self.types.node(self.types.head(goal.ty,0));if application.tag!=blot_check_types::Tag.product {return blot_error::Error.type_mismatch;}let proof=blot_reuse_principal_interface::SelectedProof{implementation:Identity{0,0},contract:goal.identity,arguments:blot_check_types::List{application.a,application.b},members:blot_check_types::List{},prerequisites:blot_check_types::List{}};let matches,err=self.selectedReferenceWithGoal(source,template.value,proof,true);if err!=blot_error::Error.none {return err;}if !matches {continue;}let index .= self.catalogs.contract_identities.get(goal.identity);let contract=self.contracts[index];let member=self.memberIndex(contract,template.value.name);if !member.present {return blot_error::Error.type_mismatch;}if selected.present {let err=self.diagnostic(Code.ambiguous_qualified,sour