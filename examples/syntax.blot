// Executable syntax showcase for the current compiler, not proposed grammar.
// See DESIGN.md for language proposals. Composite values stay inside the guest.

infixl 60 `add`
infixl 70 (><) = dot

type Vec2 is data = #Vec2 { x: F32, y: F32 }
type Mode is data = #Running | #Paused
type Event is data = #Tick U32 | #SetMode Mode | #Reset

const add = func left => return func right => return U32.add left right
const dot = func left => return func right => return do:
  let #Vec2 { x: lx, y: ly } = left
  let #Vec2 { x: rx, y: ry } = right
  break lx * rx + ly * ry

const Vec2.scaled = func value => return func factor => return do:
  let #Vec2 { x, y } = value
  break #Vec2 { x: x * factor, y: y * factor }

// Demand parameters defer an expression and share its first result.
const and_then = func left => return func ~right => return
  if left then @demand right else false

const unwrap_or_else = func candidate => return func ~fallback => return case candidate of
  #Some value => value
  #Nothing => @demand fallback

entry const short_circuit = func () => return do:
  let empty: Array U32 = #[]
  break and_then false (empty[0] > 0)

entry const lazy_fallback = func () => return do:
  let empty: Array U32 = #[]
  break unwrap_or_else (#Some 42) empty[0]

entry const factorial = func value => return do:
  if value <= 1:
    break 1
  break value * factorial (value - 1)

const choose = func first => return func enabled => return func fallback => return case first, enabled, fallback of
  #Some value, true, _ => value
  _, _, #Some value => value
  _, _, _ => 0

const double_or_zero = func candidate => return do:
  let #Some value = candidate else:
    break 0
  break value * 2

const react = func event => return func ticks => return case event of
  #Tick count => ticks + count
  #SetMode #Running => ticks
  #SetMode #Paused => ticks
  #Reset => 0

entry const operator_example = 1 `add` 2 * 3
entry const recursive_example = func (value: U32) => return factorial value
entry const matching_example = func () => return choose #Nothing false (#Some (double_or_zero (#Some 21)))
entry const event_example = func () => return react (#Tick 2) 40

entry const vector_example = func () => return do:
  let position = #Vec2 { x: 3.0, y: 4.0 }
  let scaled = Vec2.scaled position 2.0
  break position >< scaled

entry const array_snapshot = func () => return do:
  let original = #[1, 2, 3]
  let next = original
  next[1] := 20
  break original[1] + next[1]

type Counter a is effect = { advance: a -> a }
const local_counter = @effect.provider (Counter.advance U32) (func value => return value + 1)

entry const provider_example = func () => return do local_counter:
  use next <- Counter.advance U32 41
  break next
