+// CanContain observes type identity and by-value fields, never a referent's
+// fields. This gate is deliberately separate from full reachability queries.
+// As in StableTypeGraph, no walk constructs, resolves or validates a type.
+struct StableCanContainGraph {
+    unordered_set<TypeExpr *> known;
+    unordered_set<TypeExpr *> identities;
+
+    bool Identity(TypeExpr *t) {
+        if (!t) return false;
+        if (identities.count(t)) return true;
+        vector<TypeExpr *> seen;
+        if (!IdentityVisit(t, seen)) return false;
+        identities.insert(t);
+        return true;
+    }
+
+    bool Ready(TypeExpr *t) {
+        if (!t) return false;
+        if (known.count(t)) return true;
+        vector<TypeExpr *> seen;
+        if (!Visit(t, seen)) return false;
+        known.insert(t);
+        return true;
+    }
+
+private:
+    bool IdentityVisit(TypeExpr *t, vector<TypeExpr *> &seen) {
+        if (!t) return false;
+        if (identities.count(t) || find(seen.begin(), seen.end(), t) != seen.end())
+            return true;
+        seen.push_back(t);
+        auto all = [&](const vector<TypeExpr *> &ts) {
+            for (auto x : ts) if (!x || !IdentityVisit(x, seen)) return false;
+            return true;
+        };
+        switch (t->kind) {
+            case TY_INT: return !t->ix || t->ix->arr;
+            case TY_FLT: case TY_BOOL: case TY_VOID: return true;
+            case TY_SLICE: return IdentityVisit(t->sub, seen);
+            case TY_REF:
+                return (t->ref->poolname.empty() || t->ref->pool) &&
+                       IdentityVisit(t->ref->sub, seen);
+            case TY_ARRAY:
+                if (t->arr->sub->kind == TY_VOID) return false;
+                if (t->arr->akind == A_FIXED && t->arr->size < 0) return false;
+                if (t->arr->sizeexpr && t->arr->size < 0) return false;
+                return IdentityVisit(t->arr->sub, seen);
+            case TY_STRUCT: {
+                // Nominal equality observes the declaration and closed args,
+                // not this node's lazily attached instance cache.
+                auto s = t->struc->st;
+                return s && !s->unknown && !s->broken &&
+                       t->struc->args.size() == s->generics.size() && all(t->struc->args);
+            }
+            case TY_ENUM: {
+                auto e = t->enu->en;
+                return e && !e->broken && t->enu->args.size() == e->generics.size() &&
+                       all(t->enu->args);
+            }
+            case TY_VARIANT:
+                return t->var->variant && IdentityVisit(t->var->adt, seen);
+            default: return false;
+        }
+    }
+
+    bool Visit(TypeExpr *t, vector<TypeExpr *> &seen) {
+        if (!t || !Identity(t)) return false;
+        if (known.count(t) || find(seen.begin(), seen.end(), t) != seen.end())
+            return true;
+        seen.push_back(t);
+        auto all = [&](const vector<TypeExpr *> &ts) {
+            for (auto x : ts) if (x && !Visit(x, seen)) return false;
+            return true;
+        };
+        switch (t->kind) {
+            case TY_ARRAY: return Visit(t->arr->sub, seen);
+            case TY_STRUCT: {
+                auto i = t->struc->inst;
+                return i && i->validated && !i->failed && all(i->ftypes);
+            }
+            case TY_ENUM: {
+                auto i = t->enu->inst;
+                if (!i || !i->validated || i->failed) return false;
+                for (auto &fs : i->vftypes) if (!all(fs)) return false;
+                return true;
+            }
+            // More conservative than the query: require every variant's fields.
+            case TY_VARIANT: return Visit(t->var->adt, seen);
+            default: return true; // Identity proved primitives and view identities.
+        }
+    }
+};
+
+// Reference reachability observes nominal arguments only for identity, but
+// follows every field and referent. Include relative referents too: loading
+// a relative reference through a plain reference makes it plain.
+struct StableReachesGraph {
+    unordered_set<TypeExpr *> known;
+
+    bool Ready(TypeExpr *t, StableCanContainGraph &identity) {
+        if (!t) return false;
+        if (known.count(t)) return true;
+        vector<TypeExpr *> seen;
+        if (!Visit(t, seen, identity)) return false;
+        // A cycle can depend on an ancestor that fails later. Publish only
+        // the root after the entire reachable closure succeeds.
+        known.insert(t);
+        return true;
+    }
+
+private:
+    bool Visit(TypeExpr *t, vector<TypeExpr *> &seen, StableCanContainGraph &identity) {
+        if (!t || !identity.Identity(t)) return false;
+        if (known.count(t) || find(seen.begin(), seen.end(), t) != seen.end()) return true;
+        seen.push_back(t);
+        auto all = [&](const vector<TypeExpr *> &ts) {
+            for (auto x : ts) if (x && !Visit(x, seen, identity)) return false;
+            return true;
+        };
+        switch (t->kind) {
+            case TY_REF: return Visit(t->ref->sub, seen, identity);
+            case TY_SLICE: return Visit(t->sub, seen, identity);
+            case TY_ARRAY: return Visit(t->arr->sub, seen, identity);
+            case TY_STRUCT: {
+                auto i = t->struc->inst;
+                return i && i->validated && !i->failed && all(i->ftypes);
+            }
+            case TY_ENUM: {
+                auto i = t->enu->inst;
+                if (!i || !i->validated || i->failed) return false;
+                for (auto &fs : i->vftypes) if (!all(fs)) return false;
+                return true;
+            }
+            case TY_VARIANT: return Visit(t->var->adt, seen, identity);
+            default: return true; // Identity already rejected unresolved kinds.
+        }
+    }
+};
+
