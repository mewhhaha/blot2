fn nominalFacts(module: const Module&) -> Error { if module.nominals.len > 4096 { return blot_error::Error.invalid_artifact; } var storage:blot_check_core::Nominal[4096]; let facts=storage[..module.nominals.len]; for value,index in module.nominals { facts[index]=value; } for &nominal in facts { if nominal.identity.unit == module.unit { nominal.affine=false; nominal.has_usage=false; } } var work=blot_check_usage_check::Work {..}; for node in module.types.nodes { let err=blot_check_usage_check::nominalShape(module.types,facts,node,work); if err != blot_error::Error.none { return blot_error::Error.invalid_artifact; } }
    for ignored in 0..facts.len { let err=work.charge(1); if err != blot_error::Error.none { return blot_error::Error.invalid_artifact; } var changed=false; for constructor in module.constructors { let err=work.charge(1); if err != blot_error::Error.none { return blot_error::Error.invalid_artifact; } if constructor.nominal >= facts.len || constructor.payload >= module.types.nodes.len { return blot_error::Error.invalid_artifact; } if constructor.payload == 0 || facts[constructor.nominal].identity.unit != module.unit { continue; } let nominal .= facts[constructor.nominal]; if !nominal.affine { let affine,err=blot_check_usage_check::affineNominalWork(module.types,facts,constructor.payload,work); if err != blot_error::Error.none { return blot_error::Error.invalid_artifact; } if affine { nominal.affine=true; changed=true; } } if !nominal.has_usage { let contains,err=blot_check_usage_check::containsNominalWork(module.types,facts,constructor.payload,work); if err != blot_error::Error.none { return blot_error::Error.invalid_artifact; } if contains { nominal.has_usage=true; changed=true; } } } if !changed { break; } }
    for proved,index in facts { let declared=module.nominals[index]; if proved.affine != declared.affine || proved.has_usage != declared.has_usage { return blot_error::Error.invalid_artifact; } } return blot_error::Error.none;
}
fn formalRegion(module: const Module&, id: u32, remaining: i64&) -> bool { for node in module.types.nodes { if remaining == 0 { return false; } remaining-=1; if node.tag != blot_check_types::Tag.forall || node.c > 128 || node.b > module.types.extra.len || node.c > module.types.extra.len-node.b { continue; } for binder,ordinal in module.types.list(blot_check_types::List {node.b,node.c, ..}) { if remaining == 0 { return false; } remaining-=1; if binder != id { continue; } if binder >= module.types.nodes.len { return false; } let bound=module.types.node(binder); if bound.tag == blot_check_types::Tag.bound && bound.b == 2 && bound.c == 0 && bound.a == ordinal { return true; } } } return false; }
fn validateRegions(module: const Module&) -> Error { var bindings:u32[4096]; var count:i64=0; var remaining:i64=65536; for node in module.nodes { if remaining == 0 { return blot_error::Error.invalid_artifact; } remaining-=1; if node.tag != blot_check_core::Tag.usage_borrow && node.tag != blot_check_core::Tag.resource_scope { continue; } var callable=node.b; if node.tag == blot_check_core::Tag.resource_scope { callable=node.c; } if count == bindings.len || callable >= module.nodes.len || module.node(callable).tag != blot_check_core::Tag.closure { return blot_error::Error.invalid_artifact; } let callback=module.closure(callable); for binding in bindings[..count] { if binding == callback.parameter.binding { return blot_error::Error.invalid_artifact; } } bindings[count]=callback.parameter.binding; count+=1; }
    for node,type_index in module.types.nodes { if remaining == 0 { return blot_error::Error.invalid_artifact; } remaining-=1; if node.tag == blot_check_types::Tag.bound && node.b == 2 { var owned=false; for binding in bindings[..count] { if binding == node.c { owned=true; break; } } if node.c == 0 { if !formalRegion(module,type_index as u32,remaining) { return blot_error::Error.invalid_artifact; } } else if !owned || node.a != 0 { return blot_error::Error.invalid_artifact; } }
        if node.tag == blot_check_types::Tag.usage { if node.b == blot_check_types::usageCode(Usage.concurrent) && !blot_check_task_types::concurrentHost(module.types,node.a) { return blot_error::Error.invalid_artifact; } let loan=node.b == blot_check_types::usageCode(Usage.borrow) || node.b == blot_check_types::usageCode(Usage.borrow_mut); if loan != (node.c != 0) { return blot_error::Error.invalid_artifact; } if loan { if node.c >= module.types.nodes.len { return blot_error::Error.invalid_artifact; } let region=module.types.node(node.c); if region.tag != blot_check_types::Tag.bound || region.b != 2 { return blot_error::Error.invalid_artifact; } } if node.b == blot_check_types::usageCode(Usage.shared) { let affine,err=blot_check_usage_check::affineNominal(module.types,module.nominals,node.a); if err != blot_error::Error.none || affine { return blot_error::Error.invalid_artifact; } } }
        let edges:u32[2]=[node.a,node.b]; var values:const u32[:]=default<const u32[:]>(); match node.tag {
            function => { values=edges; }, usage,array,list,cursor,resolver,provider,scoped => { values=edges[..1]; }, product => { values=module.types.list(blot_check_types::List {node.a,node.b, ..}); }, nominal => { values=module.types.nominalArguments(node); },
            record => { for index in 0..node.b { let field=module.types.node(module.types.recordField(node,index).ty); if field.tag == blot_check_types::Tag.bound && field.b == 2 { return blot_error::Error.invalid_artifact; } } }, _ => {},
        } for edge in values { let child=module.types.node(edge); if child.tag == blot_check_types::Tag.bound && child.b == 2 { return blot_error::Error.invalid_artifact; } }
