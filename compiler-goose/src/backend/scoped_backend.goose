fn compile(workspace: blot_backend_core_backend::CompileWorkspace&,units: const blot_check_core::Module[:],entry: u32) -> blot_backend_core_backend::Result,Error { return compileWithOptions(workspace,units,entry,CompileOptions {..}); }
