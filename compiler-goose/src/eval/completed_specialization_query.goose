type Error=blot_error::Error;
type BindingRef=blot_check_core::BindingRef;
type Record=blot_reuse_independent_call_proof::Record;
enum Reason { mode,source,domain,expected,input,scalar,call,view,plain,resource,imported }
fn reasonCode(reason: Reason) -> u32 { match reason { mode=>0,source=>1,domain=>2,expected=>3,input=>4,scalar=>5,call=>6,view=>7,plain=>8,resource=>9,imported=>10, } }
struct Stats { independent_rechecked: i64=0,independent_rejections: i64[15]=[0;15],independent_regions: u64=0,independent_nodes: u64=0,independent_reused: i64=0,independent_declined: i64=0,parallel_batches: i64=0,parallel_jobs: i64=0,parallel_workers: i64=1,recorded: i64=0,member_recorded: i64=0,member_payload_bytes: i64=0,member_reused: i64=0,complete_records: i64=0,completed_closures: i64=0,lookups: i64=0,candidates: i64=0,reused: i64=0,reasons: i64[11]=[0;11],collected_visits_removed: i64=0,source_scopes_removed: i64=0,solver_nodes_removed: i64=0,values_imported: i64=0,plain_revalidated: i64=0,enumerated_records: i64=0,longest_bucket: i64=0,empty_buckets: i64=0,root_preflight_declined: i64=0,owner_importers: i64=0,prepared_importers: i64=0,fresh_importers: i64=0,shared_gates: i64=0,gate_fresh: i64=0,shared_gate_bytes: i64=0,plan_inspections: i64=0,plan_cache_hits: i64=0,source_validation_checks: i64=0,source_validation_hits: i64=0,graph_scratch: blot_reuse_source_value_template::ScratchStats=blot_reuse_source_value_template::ScratchStats {} }
// Cached entries own only inspection metadata; query borrows stay invocation-local.
struct CachedPlan {checked:bool=false,has_plan:bool=false,root:u32=0,order:const u32[:]=default<const u32[:]>(),stats:blot_reuse_source_value_template::Stats=blot_reuse_source_value_template::Stats{},row_policy:blot_reuse_source_value_template::RowPolicy=blot_reuse_source_value_template::RowPolicy.empty_only,source_admitted:blot_support::Option<bool> =blot_support::none<bool>()}
fn ownedPlanOrder(values:const u32[:])->const u32[:] {if values.len==0 {return default<const u32[:]>();}let registered=blot_reuse_source_value_template::plan_order.realloc_slice(values,values.len);assert(blot_support::same_slice_identity(registered,values));let start=blot_reuse_source_value_template::plan_order.index_of(registered[0]);return blot_reuse_source_value_template::plan_order[start..start+values.len];}
fn publishCachedPlan(target:CachedPlan&,value:blot_support::Option<blot_reuse_source_value_template::Plan>) {
 let admitted=target.source_admitted;if !value.present {target=CachedPlan{checked:true,source_admitted:admitted,..};return;}let plan=value.value;
 target=CachedPlan{checked:true,has_plan:true,root:plan.root,order:ownedPlanOrder(plan.order),stats:plan.stats,row_policy:plan.row_policy,source_admitted:admitted};
}
fn deinit(self_:CachedPlan&) {if self_.has_plan && self_.order.len!=0 {blot_reuse_source_value_template::plan_order.free_slice(self_.order);}self_=CachedPlan{};}
fn planView(self_:State&,cached:CachedPlan)->blot_support::Option<blot_reuse_source_value_template::Plan> {if !cached.has_plan {return blot_support::none<blot_reuse_source_value_template::Plan>();}return blot_support::Option<blot_reuse_source_value_template::Plan>{true,blot_reuse_source_value_template::Plan{pools:sourcePools(self_),gate:self_.gate,root:cached.root,order:ownedPlanOrder(cached.order),stats:cached.stats,row_policy:cached.row_policy}};}

reusable[] var cached_plans: CachedPlan[>..]=[];
struct Tables { independent_calls: blot_eval_semantic_parallel::Records&,completed_worker_proofs: blot_eval_semantic_parallel::Records&,parallel_requests: blot_eval_semantic_parallel::Requests&,parallel_slots: blot_eval_semantic_parallel::Slots&,parallel_outcomes: blot_eval_semantic_parallel::Outcomes& }
struct State { owner_id: u64=blot_native::fresh_owner_id(),allocation_owner: u64=0,old: blot_reuse_artifact_capture::Capture=blot_reuse_artifact_capture::Capture{..},gate: blot_reuse_principal_reuse_gate::Gate,stats: Stats=Stats {},independent_calls: blot_eval_semantic_parallel::Records&,completed_worker_proofs: blot_eval_semantic_parallel::Records&,worker_proof_words: i64=0,recover_call_proofs: bool=true,parallel_enabled: bool=false,semantic_workers: u8=1,revalidate_plain_facts: bool=true,graph_scratch: blot_reuse_source_value_template::QueryScratch,plans: CachedPlan[:]=default<CachedPlan[:]>(),indexed: bool=false,semantic: blot_support::Option<blot_reuse_artifact_import::Importer> =blot_support::none<blot_reuse_artifact_import::Importer>(),state_owner: u64=0,generator_owner: u64=0,session_owner: u64=0,parallel_requests: blot_eval_semantic_parallel::Requests&,parallel_slots: blot_eval_semantic_parallel::Slots&,parallel_outcomes: blot_eval_semantic_parallel::Outcomes& }
fn sourcePools(self_:const State&)->const blot_reuse_code_artifacts::Pools& {return blot_reuse_code_artifacts::registeredPools(self_.old.metadata());}

fn init(allocation_owner: u64,old: const blot_reuse_artifact_capture::Capture&,units: const blot_check_core::Module[:],names: blot_support::Option<blot_backend_runtime_identity::View>,t: Tables) -> State,Error { assert(old.metadata().pools.present); let gate,error=blot_reuse_principal_reuse_gate::init(allocation_owner,blot_reuse_code_artifacts::registeredPools(old.metadata()),units,names); return State {allocation_owner:allocation_owner,old:old,gate:gate,independent_calls:t.independent_calls,completed_worker_proofs:t.completed_worker_proofs,graph_scratch:blot_reuse_source_value_template::QueryScratch {allocation_owner:allocation_owner, ..},parallel_requests:t.parallel_requests,parallel_slots:t.parallel_slots,parallel_outcomes:t.parallel_outcomes},error; }
fn initInto(result:State&,old:const blot_reuse_artifact_capture::Capture&,units:const blot_check_core::Module[:],names:blot_support::Option<blot_backend_runtime_identity::View>,stamps:blot_reuse_code_artifacts::ModuleStamps?,allocation_owner:u64,admitted:blot_support::Option<blot_reuse_principal_reuse_gate::Gate>)->Error {
 assert(old.metadata().pools.present); var admission=admitted;
 if !admission.present { let gate,error=blot_reuse_principal_reuse_gate::initWithStamps(allocation_owner,blot_reuse_code_artifacts::registeredPools(old.metadata()),units,names,stamps); if error!=blot_error::Error.none { return error; } admission=blot_support::some(gate); }
 let tables=Tables{independent_calls:result.independent_calls,completed_worker_proofs:result.completed_worker_proofs,parallel_requests:result.parallel_requests,parallel_slots:result.parallel_slots,parallel_outcomes:result.parallel_outcomes};
 result=State{allocation_owner:allocation_owner,old:old,gate:admission.value,independent_calls:tables.independent_calls,completed_worker_proofs:tables.completed_worker_proofs,graph_scratch:blot_reuse_source_value_template::QueryScratch{allocation_owner:allocation_owner, ..},parallel_requests:tables.parallel_requests,parallel_slots:tables.parallel_slots,parallel_outcomes:tables.parallel_outcomes};
 return blot_error::Error.none;
}

fn deinit(self_: State&) { for &record in self_.completed_worker_proofs.items { record.deinit(); } self_.completed_worker_proofs.clear(); for &record in self_.independent_calls.items { record.deinit(); } self_.independent_calls.clear(); self_.graph_scratch.deinit(); if self_.semantic.present { self_.semantic.value.deinit(); self_.semantic=blot_support::none<blot_reuse_artifact_import::Importer>(); } for &cached in self_.plans { cached.deinit(); } cached_plans.free_slice(self_.plans); self_.plans=default<CachedPlan[:]>(); if self_.gate.storage!=0 {self_.gate.deinit();} self_.parallel_requests.clear(); self_.parallel_slots.clear(); self_.parallel_outcomes.clear(); self_.owner_id=0; }
fn index(self_: State&) -> Error { if self_.indexed { return blot_error::Error.none; } self_.plans=cached_plans.alloc_slice(self_.old.metadata().specialization_queries.records.len); for &plan in self_.plans { plan=CachedPlan {}; } self_.indexed=true; return blot_error::Error.none; }
fn pairedImporter(self_: State&) -> blot_reuse_artifact_import::Importer&,Error { if !self_.semantic.present { let pools: const blot_reuse_code_artifacts::Pools& =sourcePools(self_); let prepared,error=blot_reuse_artifact_import::initCheckedQuery(self_.allocation_owner,pools,blot_compile_workspace::queryUnits(self_),self_.gate); if error!=blot_error::Error.none { return self_.semantic.value,error; } if prepared.present { self_.semantic=blot_support::Option<blot_reuse_artifact_import::Importer>{true,prepared.value}; self_.stats.prepared_importers++; } else { assert(pools.identity.present); let maps,e=blot_reuse_artifact_import::init(self_.allocation_owner,pools,blot_compile_workspace::queryUnits(self_),blot_support::Option<blot_backend_runtime_identity::View>{true,pools.identity.value.view()},self_.gate.units.len); if e!=blot_error::Error.none { return self_.semantic.value,e; } self_.semantic=blot_support::Option<blot_reuse_artifact_import::Importer>{true,maps}; self_.stats.fresh_importers++; } for exact,position in self_.gate.structural_units { self_.semantic.value.stable[position]=exact; } self_.stats.owner_importers++; } return self_.semantic.value,blot_error::Error.none; }
fn cachedPlan(self_: State&,position: i64) -> blot_support::Option<blot_reuse_source_value_template::Plan>,Error { let cached: CachedPlan& =self_.plans[position]; if cached.checked { self_.stats.plan_cache_hits++; return planView(self_,cached),blot_error::Error.none; } let record=self_.old.metadata().specialization_queries.records[position].dependencies; var roots=Words {};  roots.append([record.selected,record.input]); if record.member.present { let member=record.member.value; roots.push(member.function); for read in member.ready { roots.push(read.value); } } for view in record.views { roots.append([view.value,view.selected]); } for value in record.completed_closures { let snapshot=sourcePools(self_).evaluator; if value==0||value>=snapshot.values.len||snapshot.values[value].kind!=blot_eval_eval_values::ValueKind.closure||snapshot.value_evidence[value]==0 { cached.checked=true; let __cleanup_result_1_0: blot_support::Option<blot_reuse_source_value_template::Plan> = blot_support::none<blot_reuse_source_value_template::Plan>(); let __cleanup_result_1_1: Error = blot_error::Error.none; roots.deinit(); return __cleanup_result_1_0, __cleanup_result_1_1; } roots.push(value); } let inspection,error=blot_reuse_source_value_template::inspectRootsWithRows(sourcePools(self_),self_.gate,roots.items,blot_reuse_source_value_template::RowPolicy.source_declared); if error!=blot_error::Error.none { let __cleanup_result_2_0: blot_support::Option<blot_reuse_source_value_template::Plan> = blot_support::none<blot_reuse_source_value_template::Plan>(); let __cleanup_result_2_1: Error = error; roots.deinit(); return __cleanup_result_2_0, __cleanup_result_2_1; } self_.stats.plan_inspections++; publishCachedPlan(cached,inspection.plan);let result=planView(self_,cached);roots.deinit();return result,blot_error::Error.none; }
fn rootMatches<G>(self_: const State&,g: G&,old_input: u32,input: u32) -> bool { let snapshot=sourcePools(self_).evaluator; let left=snapshot.values[old_input]; let right=g.evaluator.valueInfo(input); let before=snapshot.closures[left.bits]; let current=g.evaluator.closureInfo(input); if left.scalar!=right.scalar||left.nominal!=right.nominal||left.len!=right.len||before.ty!=current.ty||before.mappings.len!=current.mappings.len||before.row_mappings.len!=current.row_mappings.len||(snapshot.value_evidence[old_input]==0)!=(g.evaluator.valueEvidence(input)==0) { return false; } for prior,position in snapshot.type_mappings[before.mappings.start..before.mappings.start+before.mappings.len] { if prior.variable!=g.evaluator.storage.type_mappings.items[current.mappings.start+position].variable { return false; } } for prior,position in snapshot.row_mappings[before.row_mappings.start..before.row_mappings.start+before.row_mappings.len] { if prior.variable!=g.evaluator.storage.row_mappings.items[current.row_mappings.start+position].variable { return false; } } return true; }
fn reject(self_: State&,reason: Reason) { self_.stats.reasons[reasonCode(reason)]++; }
fn evidence<G>(g: G&,maps: blot_reuse_artifact_import::Importer&,old: u32) -> blot_support::Option<u32>,Error { if old==0 { return blot_support::some<u32>(0),blot_error::Error.none; } return maps.importEvidence(g,old); }
fn memberReady<G>(g: G&,target: BindingRef) -> bool { if target.unit==0||target.unit>g.evaluator.units.len||target.binding>=g.evaluator.units[target.unit-1].bindings.len||g.evaluator.inquiry_regions!=0||g.evaluator.semantic_job_budget.present { return false; } let slot=g.evaluator.slots[g.evaluator.binding_offsets[target.unit-1]+target.binding]; return slot.state==blot_eval_core_eval::State.complete&&g.evaluator.memberReceiptEligible(target); }
recursive fn lookup<G>(self_: State&,g: G&,input: u32,expected: u32) -> blot_support::Option<u32>,Error { return lookupQuery(self_,g,blot_support::none<BindingRef>(),input,expected,blot_support::none<u32>()); }
fn lookupMember<G>(self_: State&,g: G&,target: BindingRef,input: u32,expected: u32) -> blot_support::Option<u32>,Error { if !memberReady(g,target) { return blot_support::none<u32>(),blot_error::Error.none; } return lookupQuery(self_,g,blot_support::some(target),input,expected,blot_support::none<u32>()); }
fn lookupMemberRecord<G>(self_: State&,g: G&,target: BindingRef,input: u32,expected: u32,position: u32) -> blot_support::Option<u32>,Error { if !memberReady(g,target) { return blot_support::none<u32>(),blot_error::Error.none; } return lookupQuery(self_,g,blot_support::some(target),input,expected,blot_support::some(position)); }
recursive fn lookupQuery<G>(self_: State&,g: G&,member: blot_support::Option<BindingRef>,input: u32,expected: u32,exact: blot_support::Option<u32>) -> blot_support::Option<u32>,Error { let timing .= g.evaluator.timing; if timing { var scope=blot_backend_backend_timing::enter(timing,blot_backend_backend_timing::Phase.query_prepare); let result,error=lookupQueryInner(self_,g,member,input,expected,exact,scope); scope.deinit(); self_.stats.graph_scratch=self_.graph_scratch.stats; return result,error; } let result,error=lookupQueryInner(self_,g,member,input,expected,exact,null); self_.stats.graph_scratch=self_.graph_scratch.stats; return result,error; }
fn phase(scope: blot_backend_backend_timing::Scope?,phase: blot_backend_backend_timing::Phase) { if scope { scope.change(phase); } }
recursive fn lookupQueryInner<G>(self_: State&,g: G&,member: blot_support::Option<BindingRef>,input: u32,expected: u32,exact: blot_support::Option<u32>,timing: blot_backend_backend_timing::Scope?) -> blot_support::Option<u32>,Error {
 self_.stats.lookups++; if !self_.gate.enabled||!(blot_support::same_slice_identity(g.evaluator.units,self_.gate.units))||g.evaluator.units.len!=self_.gate.units.len||self_.allocation_owner==0||self_.allocation_owner!=g.evaluator.allocation_owner { return blot_support::none<u32>(),blot_error::Error.none; } if input>=g.evaluator.storage.values.len||expected>=g.evaluator.storage.evidence.nodes.len { return blot_support::none<u32>(),blot_error::Error.none; } var current=blot_eval_selected_query::Source {0,0,blot_eval_eval_values::ClosureOrigin.named,0}; if member.present { if g.evaluator.valueInfo(input).kind!=blot_eval_eval_values::ValueKind.array||g.evaluator.valueEvidence(input)!=0 { return blot_support::none<u32>(),blot_error::Error.none; } current=blot_eval_selected_query::memberSource(member.value); } else { if g.evaluator.valueInfo(input).kind!=blot_eval_eval_values::ValueKind.closure||expected==0||g.evaluator.storage.evidence.node(expected).tag!=blot_eval_type_evidence::Tag.function { return blot_support::none<u32>(),blot_error::Error.none; } current=blot_eval_selected_query::source(g.evaluator.closureInfo(input)); }
 let ordinary=blot_eval_core_eval::Options {}; let options=g.evaluator.options; if options.max_values!=ordinary.max_values||options.max_children!=ordinary.max_children||options.max_depth!=ordinary.max_depth||options.max_type_depth!=ordinary.max_type_depth||options.max_steps!=ordinary.max_steps { reject(self_,Reason.resource); return blot_support::none<u32>(),blot_error::Error.none; } if (self_.state_owner!=0&&self_.state_owner!=self_.owner_id)||(self_.generator_owner!=0&&self_.generator_owner!=g.owner_id)||(self_.session_owner!=0&&self_.session_owner!=g.evaluator.owner_id) { return blot_support::none<u32>(),blot_error::Error.none; } if !member.present&&g.evaluator.storage.specialized_closures.contains(blot_eval_core_eval::ViewKey {value:input,evidence:expected}) { return blot_support::none<u32>(),blot_error::Error.none; } self_.state_owner=self_.owner_id; self_.generator_owner=g.owner_id; self_.session_owner=g.evaluator.owner_id; let indexed=index(self_); if indexed!=blot_error::Error.none { return blot_support::none<u32>(),indexed; }
 var cursor=self_.old.metadata().specialization_queries.candidates(blot_eval_selected_query::fingerprint(current,options,g.evaluator.depth),blot_reuse_semantic_query_table::Order.oldest_first); let result,error=lookupCandidates(self_,g,member,input,expected,exact,timing,current,cursor); if self_.stats.longest_bucket<cursor.inspected { self_.stats.longest_bucket=cursor.inspected; } if cursor.inspected==0 { self_.stats.empty_buckets++; } return result,error;
}
recursive fn lookupCandidates<G>(self_: State&,g: G&,member: blot_support::Option<BindingRef>,input: u32,expected: u32,exact: blot_support::Option<u32>,timing: blot_backend_backend_timing::Scope?,current: blot_eval_selected_query::Source,cursor: blot_reuse_semantic_query_table::Cursor&) -> blot_support::Option<u32>,Error {
 let pools: const blot_reuse_code_artifacts::Pools& =sourcePools(self_); loop { phase(timing,blot_backend_backend_timing::Phase.query_scan); let position=cursor.next(); if !position.present { break; } if exact.present&&position.value!=exact.value { continue; } let record: const blot_reuse_specialization_receipt::Record& =self_.old.metadata().specialization_queries.records[position.value].dependencies; self_.stats.enumerated_records++; if record.input>=pools.evaluator.values.len { continue; }
 if member.present { if !record.member.present { continue; } let old=record.member.value; if !g.evaluator.memberPrincipalsMatch(old)||old.exhausted||old.transitions>g.evaluator.options.max_summary_transitions||old.target!=member.value||!self_.gate.admits(member.value)||pools.evaluator.values[record.input].kind!=blot_eval_eval_values::ValueKind.array { continue; } if old.query_budgets!=blot_reuse_constant_receipt::queryBudgets(g.evaluator)||old.summary_work!=g.evaluator.summary_graph_work||old.principal_nodes!=g.evaluator.principal_graph_nodes||old.principal_edges!=g.evaluator.principal_graph_edges { continue; } }
 else { if record.member.present||pools.evaluator.values[record.input].kind!=blot_eval_eval_values::ValueKind.closure { continue; } let source=blot_eval_selected_query::source(pools.evaluator.closures[pools.evaluator.values[record.input].bits]); if source!=current { continue; } }
 self_.stats.candidates++; if !record.complete||record.steps!=0||record.depth!=g.evaluator.depth||record.options!=g.evaluator.options { reject(self_,Reason.mode); continue; } if g.evaluator.storage.values.len>g.evaluator.options.max_values||record.values_added>g.evaluator.options.max_values-g.evaluator.storage.values.len||g.evaluator.storage.children.len>g.evaluator.options.max_children||record.children_added>g.evaluator.options.max_children-g.evaluator.storage.children.len { reject(self_,Reason.resource); continue; }
 phase(timing,blot_backend_backend_timing::Phase.query_source); if !self_.plans[position.value].source_admitted.present { self_.stats.source_validation_checks++; self_.plans[position.value].source_admitted=blot_support::some(self_.gate.admitsReceipt(record)); } else { self_.stats.source_validation_hits++; } if !self_.plans[position.value].source_admitted.value { reject(self_,Reason.source); continue; } if !member.present&&!rootMatches(self_,g,record.input,input) { self_.stats.root_preflight_declined++; reject(self_,Reason.input); continue; }
 phase(timing,blot_backend_backend_timing::Phase.query_import); let maps,error .= pairedImporter(self_); if error!=blot_error::Error.none { return blot_support::none<u32>(),error; } if !maps.enabled { reject(self_,Reason.source); continue; } for exact,index in self_.gate.structural_units { maps.stable[index]=exact; } let imported,e=evidence(g,maps,record.expected); if e!=blot_error::Error.none { return blot_support::none<u32>(),e; } if !imported.present||imported.value!=expected { reject(self_,Reason.expected); continue; } let inspected,e2=cachedPlan(self_,position.value); if e2!=blot_error::Error.none { return blot_support::none<u32>(),e2; } if !inspected.present { reject(self_,Reason.domain); continue; }let plan=inspected.value;
 phase(timing,blot_backend_backend_timing::Phase.query_match); let anchors,e3=self_.graph_scratch.begin(plan,g); if e3!=blot_error::Error.none { if e3==blot_error::Error.out_of_memory { return blot_support::none<u32>(),e3; } reject(self_,Reason.source); continue; } let matches,e4=matchInto(self_,g,plan,maps,record.input,input,anchors); if e4!=blot_error::Error.none { return blot_support::none<u32>(),e4; } if !matches { reject(self_,Reason.input); continue; }
 if record.member.present { let old=record.member.value; var ready=true; for read in old.ready { if !self_.gate.admits(read.target) { ready=false; break; } let slot=g.evaluator.slots[g.evaluator.binding_offsets[read.target.unit-1]+read.target.binding]; if slot.state!=blot_eval_core_eval::State.complete { ready=false; break; } let matched,e5=matchInto(self_,g,plan,maps,read.value,slot.value,anchors); if e5!=blot_error::Error.none { return blot_support::none<u32>(),e5; } if !matched { ready=false; break; } } if !ready { reject(self_,Reason.input); continue; } let slot=g.evaluator.slots[g.evaluator.binding_offsets[old.target.unit-1]+old.target.binding]; let matched,e5=matchInto(self_,g,plan,maps,old.function,slot.value,anchors); if e5!=blot_error::Error.none { return blot_support::none<u32>(),e5; } if !matched { reject(self_,Reason.input); continue; } }
 phase(timing,blot_backend_backend_timing::Phase.query_validate); let result,e5=validateCandidate(self_,g,record,plan,maps,anchors,input,expected,timing); if e5!=blot_error::Error.none||result.present { return result,e5; }
 } return blot_support::none<u32>(),blot_error::Error.none;
}
fn matchInto<G>(self_: State&,g: G&,plan: blot_reuse_source_value_template::Plan,maps: blot_reuse_artifact_import::Importer&,before: u32,after: u32,anchors: u32[:]) -> bool,Error { let matched,error=plan.matchIntoWithScratch(g,maps,before,after,anchors,self_.graph_scratch); if error==blot_error::Error.declined { return false,blot_error::Error.none; } return matched,error; }
struct Candidate<G> { state: State&,g: G&,record: const blot_reuse_specialization_receipt::Record&,maps: blot_reuse_artifact_import::Importer&,anchors: u32[:],input: u32,expected: u32,timing: blot_backend_backend_timing::Scope?,proofs: Proofs&,plain: PlainMap&,batch: blot_support::Option<blot_eval_semantic_parallel::Batch> =blot_support::none<blot_eval_semantic_parallel::Batch>(),next: blot_support::Option<blot_reuse_specialization_receipt::Record> =blot_support::none<blot_reuse_specialization_receipt::Record>() }
