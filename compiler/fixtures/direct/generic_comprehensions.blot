func touching (t: U32) -> (others: &[U32]) => return if t > others.length then 3 else 0
func annotated (faces: Array U32) => return do:
  let points = #[1, 2]
  let kept = #[plane | plane <- faces, touching plane (points.view 0 points.length) >= 3]
  return kept.length
func generic faces => return do:
  let kept = #[plane | plane <- faces, plane > 3]
  return kept.length
func generic_view faces => return do:
  let points = #[1, 2]
  let kept = #[plane | plane <- faces, touching plane (points.view 0 points.length) >= 3]
  return kept.length
entry func annotated_count (n: U32): U32 => return annotated #[n, 1, 5, 7]
entry func generic_count (n: U32): U32 => return generic #[n, 1, 5, 7]
entry func generic_view_count (n: U32): U32 => return generic_view #[n, 1, 5, 7]
