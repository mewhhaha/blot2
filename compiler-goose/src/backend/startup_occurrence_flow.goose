 closure => {if n.a>=module.closures.len {self_.bad();return Flow{..};}let template=module.closures[n.a];let captures=word_runs.alloc_slice(template.captures.len);for binding,index in module.extra[template.captures.start..template.captures.start+template.captures.len] {let captured .= frame.values.get(binding);if !captured {word_runs.free_slice(captures);self_.bad();return Flow{..};}captures[index]=captured;}let result=self_.aggregate(Value{kind:Kind.closure,closure:ClosureValue{unit:self_.unitId(owner),identity:n.a,origin:blot_eval_eval_values::ClosureOrigin.anonymous,..},..},captures,[]);word_runs.free_slice(captures);return Flow{value:result,..};},
