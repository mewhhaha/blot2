 if error!=blot_error::Error.none {return invalidPrincipal(),error;
 }}if !((declaration.kind==blot_reuse_principal_interface::Kind.global && owner.body(reference.binding)!=null) || declaration.kind==blot_reuse_principal_interface::Kind.external) {return invalidPrincipal(),blot_error::Error.invalid_artifact;
