type Tree is data = #Leaf U32 | #Branch (Tree, Tree)
const make_tree = fn (depth: U32) (seed: U32) -> Tree =>
  if depth == 0 then #Leaf seed else #Branch (make_tree (depth - 1) (seed * 3 + 1), make_tree (depth - 1) (seed * 5 + 7))
const sum_tree = fn (tree: Tree) -> U32 => case tree of
  #Leaf value => value
  #Branch (left, right) => sum_tree left + sum_tree right
entry const run = fn (seed: U32) -> U32 => sum_tree (make_tree 10 seed)
