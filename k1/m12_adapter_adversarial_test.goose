import std;
import m12_adapter_schema;
import m12_adapter_build;
import m12_adapter_verify;
fn kernel()->u8[] {return "pub let project: forall [r: Region, s: Region, n: Nat, c: Nat, d: Domain] => Fn[static, Many, (View[r,{x:F32,y:F32,vx:F32,vy:F32},n,d], F32, Builder[s,{x:F32,y:F32},0,c,Append]), exists [e: Domain] => View[s,{x:F32,y:F32},n,e]] ! {read r, write s} requires [Le(n,c)] resources {depth: 2, frame: 256} = fn (source,dt,initial) => do:\n  let built = for i in 0..n carry (b = initial)\n    invariant [Eq(Init(b),i)] do:\n      next (builder.append(b, {x: source[i].x + source[i].vx * dt, y: source[i].y + source[i].vy * dt}))\n  return builder.freeze(built)\n";}
fn replace(s:u8[:],a:u8[:],b:u8[:])->u8[] {var out:u8[>..]=[];var i:i64=0;var found=false;while i<s.len {if !found && a.len<=s.len-i && s[i..i+a.len]==a {out.append(b);i+=a.len;found=true;}else {out.push(s[i]);i+=1;}}assert(found);return out;}
fn main(){let k=kernel();let a=m12_adapter_schema::source();var p,st=m12_adapter_build::build(k,a);assert(st==0);var module:u8[>..]=[];module.append(k);module.append(a);assert(m12_adapter_verify::verify(p,module) && !m12_adapter_verify::public_eligible(p,module));
 for f in 16 {for v in [-1,0,999999] {let old=p.affine;if f==0 {p.affine.initial=v;}else if f==1 {p.affine.view=v;}else if f==2 {p.affine.nat=v;}else if f==3 {p.affine.capacity=v;}else if f==4 {p.affine.loop_id=v;}else if f==5 {p.affine.index=v;}else if f==6 {p.affine.carry_id=v;}else if f==7 {p.affine.result=v;}else if f==8 {p.affine.carry_node=v;}else if f==9 {p.affine.invariant_id=v;}else if f==10 {p.affine.next_node=v;}else if f==11 {p.affine.append=v;}else if f==12 {p.affine.row=v;}else if f==13 {p.affine.freeze=v;}else if f==14 {p.affine.return_node=v;}else {p.affine.root=v;}assert(!m12_adapter_verify::verify(p,module));p.affine=old;}}
 for i in 6 {for f in 13 {let old=p.transition.steps[i];if f==0 {p.transition.steps[i].kind+=1;}else if f==1 {p.transition.steps[i].node+=1;}else if f==2 {p.transition.steps[i].site+=1;}else if f==3 {p.transition.steps[i].subject+=1;}else if f==4 {p.transition.steps[i].version+=1;}else if f==5 {p.transition.steps[i].result+=1;}else if f==6 {p.transition.steps[i].result_version+=1;}else if f==7 {p.transition.steps[i].index+=1;}else if f==8 {p.transition.steps[i].nat+=1;}else if f==9 {p.transition.steps[i].capacity+=1;}else if f==10 {p.transition.steps[i].dep1+=1;}else if f==11 {p.transition.steps[i].dep2+=1;}else {p.transition.steps[i].dep3+=1;}assert(!m12_adapter_verify::verify(p,module));p.transition.steps[i]=old;}}
 for i in p.linked.tree.nodes.len {let old=p.linked.tree.nodes[i];p.linked.tree.nodes[i].start=-1;assert(!m12_adapter_verify::verify(p,module));p.linked.tree.nodes[i]=old;}
 for i in p.linked.cap.steps.len {let old=p.linked.cap.steps[i];p.linked.cap.steps[i].kind+=1;assert(!m12_adapter_verify::verify(p,module));p.linked.cap.steps[i]=old;}
 for v in [-1,0,1,999999] {let old=p.split;p.split=v;assert(!m12_adapter_verify::verify(p,module));p.split=old;}
 for pair in [["read r, write r","read r"],["read r, write r","write r"],["pack [n,e]","pack [n,d]"],["pack [n,e]","pack [c,e]"],["#Ok(wrapped)","#Ok(input)"],["project@[r,r,n,c,d]","project@[r,r,c,n,d]"],["builder.begin_append(dst)","builder.begin_append(input)"]] {let bad=replace(a,pair[0],pair[1]);let _,v=m12_adapter_build::build(k,bad);assert(v!=0);}
 print("independent M12 source/affine/evidence mutations rejected");}
