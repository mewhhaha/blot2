fn valid(receiver:Owner)->bool {return receiver.slot!=0&&receiver.slot-1<leases.len&&leases[receiver.slot-1].live&&leases[receiver.slot-1].generation==receiver.generation;}
fn initOwner()->Owner,Error {if leases.len>=0xffffffff {return Owner{..},squid_error::Error.out_of_memory;}let generation=squid_native::fresh_owner_id();let at=leases.alloc_index(Lease{generation:generation,live:true,..});return Owner{(at+1) as u32,generation},squid_error::Error.none;}
