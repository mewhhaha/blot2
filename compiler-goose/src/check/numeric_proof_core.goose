    if node.tag == blot_check_core::Tag.reference { let reference = module.reference(id); if reference.unit != 0 && reference.unit != module.unit { return 0, blot_error::Error.none; } let value = inputs.lookup(reference.binding); if value.present { return value.value.operand, blot_error::Error.none; } }
