fn spawnFormal(module: const Module&, id: u32, units: const ModuleRef[:]) -> bool, Error { for binding, binding_id in module.bindings { if binding.capability_flow != blot_check_capability_flow::Contract.spawn_task || binding.body_id == 0 { continue; } if binding.body_id >= module.bodies.len { return false, blot_error::Error.invalid_artifact; } let body = module.bodies[binding.body_id]; if body.root != id || !body.is_function { continue; } let err = spawnWrapper(module, binding_id as u32, units); return true, err; } return false, blot_error::Error.none; }
struct SpawnValue { group: u32 = 0 }
enum SpawnApplication { partial { value: u32 }, full { group: u32, action: u32, carrier: u32 = 0 } }
fn spawnApplication(module: const Module&, id: u32, units: const ModuleRef[:]) -> blot_support::Option<SpawnApplication>, Error { let node = module.node(id);
    if node.tag == blot_check_core::Tag.apply { var remaining: i64 = 65536; let function, err = spawnValue(module, node.a, units, remaining, 0); if err != blot_error::Error.none { return blot_support::none<SpawnApplication>(), err; } if !function.present { return blot_support::none<SpawnApplication>(), blot_error::Error.none; } if function.value.group == 0 { return blot_support::some(SpawnApplication.partial { node.b , ..}), blot_error::Error.none; } return blot_support::some(SpawnApplication.full { function.value.group, node.b, node.a , ..}), blot_error::Error.none; }
    if node.tag != blot_check_core::Tag.call { return blot_support::none<SpawnApplication>(), blot_error::Error.none; } let call = module.call(id); let owner, err = ownerUnit(module, call.target.unit, units); if err != blot_error::Error.none { return blot_support::none<SpawnApplication>(), err; } if !owner { return blot_support::none<SpawnApplication>(), blot_error::Error.invalid_artifact; } if owner.binding(call.target.binding).capability_flow != blot_check_capability_flow::Contract.spawn_task { return blot_support::none<SpawnApplication>(), blot_error::Error.none; } let err = spawnWrapper(owner, call.target.binding, units); if err != blot_error::Error.none { return blot_support::none<SpawnApplication>(), err; } if call.arguments.len != 2 { return blot_support::none<SpawnApplication>(), blot_error::Error.invalid_artifact; } return blot_support::some(SpawnApplication.full { group: call.arguments[0], action: call.arguments[1] , ..}), blot_error::Error.none;
}
fn spawnValue(module: const Module&, source: u32, units: const ModuleRef[:], remaining: i64&, depth: i64) -> blot_support::Option<SpawnValue>, Error {
    let err = step(remaining, depth); if err != blot_error::Error.none { return blot_support::none<SpawnValue>(), err; } let node = module.node(source);
    if node.tag == blot_check_core::Tag.apply { let function, err = spawnValue(module, node.a, units, remaining, depth + 1); if err != blot_error::Error.none || !function.present { return function, err; } if function.value.group != 0 { return blot_support::none<SpawnValue>(), blot_error::Error.none; } return blot_support::some(SpawnValue { node.b , ..}), blot_error::Error.none; }
    if node.tag != blot_check_core::Tag.reference { return blot_support::none<SpawnValue>(), blot_error::Error.none; } let reference = module.reference(source); let owner, err = ownerUnit(module, reference.unit, units); if err != blot_error::Error.none { return blot_support::none<SpawnValue>(), err; } if !owner { return blot_support::none<SpawnValue>(), blot_error::Error.invalid_artifact; } let binding = owner.binding(reference.binding);
    if binding.capability_flow == blot_check_capability_flow::Contract.spawn_task { let err = spawnWrapper(owner, reference.binding, units); return blot_support::some(SpawnValue {..}), err; } if owner .== module && binding.kind == blot_reuse_principal_interface::Kind.local && binding.initializer != 0 { return spawnValue(module, binding.initializer, units, remaining, depth + 1); } return blot_support::none<SpawnValue>(), blot_error::Error.none;
}
struct InsideVisitor { module: const Module&, target: u32, remaining: i64&, depth: i64, found: bool = false }
fn append(self_: InsideVisitor&, child: u32) -> Error { if child == 0 || self_.found { return blot_error::Error.none; } let found, err = inside(self_.module, child, self_.target, self_.remaining, self_.depth); if err != blot_error::Error.none { return blot_error::Error.plan_limit; } self_.found = found; return blot_error::Error.none; }
fn appendSlice(self_: InsideVisitor&, children: const u32[:]) -> Error { for child in children { let err = self_.append(child); if err != blot_error::Error.none { return err; } } return blot_error::Error.none; }
fn inside(module: const Module&, root: u32, target: u32, remaining: i64&, depth: i64) -> bool, Error { let err = step(remaining, depth); if err != blot_error::Error.none { return false, err; } if root == target { return true, blot_error::Error.none; } let node = module.node(root); if node.tag == blot_check_core::Tag.closure { return inside(module, module.closures[node.a].body, target, remaining, depth + 1); } var visitor = InsideVisitor { module, target, remaining, depth + 1 , ..}; let err = blot_eval_body_recipe::appendChildren(visitor, module, root, false); if err != blot_error::Error.none { return false, blot_error::Error.invalid_artifact; } return visitor.found, blot_error::Error.none; }
fn scopeWrapper(module: const Module&, source: u32) -> bool {
    if source == 0 || source >= module.nodes.len { return false; } let node = module.node(source); if node.tag != blot_check_core::Tag.task || node.c != blot_check_task_types::opCode(blot_check_task_types::Op.scope) || node.b != 1 || node.a >= module.extra.len { return false; } let callback = module.children(source)[0]; if callback == 0 || callback >= module.nodes.len || module.node(callback).tag != blot_check_core::Tag.reference || module.node(callback).a >= module.references.len { return false; } let reference = module.reference(callback); if reference.unit != 0 && reference.unit != module.unit { return false; }
    for binding, binding_id in module.bindings { if binding.capability_flow != blot_check_capability_flow::Contract.scope_task || binding.kind != blot_reuse_principal_interface::Kind.global || binding.body_id == 0 || binding.body_id >= module.bodies.len { continue; } let body = module.bodies[binding.body_id]; if !body.is_function || body.binding != binding_id || body.root != source || body.parameters.len != 1 || body.parameters.start >= module.parameters.len { continue; } if module.parameters[body.parameters.start].binding == reference.binding { return true; } } return false;
