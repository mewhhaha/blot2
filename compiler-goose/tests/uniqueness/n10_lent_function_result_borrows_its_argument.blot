type World is data = $World { ground: Array U32, size: U32 }
lent const ground_of = func (world: World) => return world.ground
const count = func (world: own World) -> (n: U32) => return do:
  world.ground[0] := n
  break world
const run = func (n: U32) => return do:
  let world = $World { ground: #[1, 2], size: 2 }
  let ground = ground_of world
  let seen = ground[1]
  world := count world (@u32.add seen n)
  world.ground[1] := 7
  break @u32.add world.ground[0] world.ground[1]
