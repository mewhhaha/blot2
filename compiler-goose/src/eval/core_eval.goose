fn schemeRequirement(context: SchemeRequirement&,copy: blot_reuse_principal_type_graph::Copier&) -> Error { let left,error=copy.ty(context.requirement.ty,0); if error!=Error.none { return error; } context.left=left; if !context.all { return Error.none; } let right,e=copy.ty(context.requirement.other,0); if e!=Error.none { return e; } context.right=right; let result,e2=copy.ty(context.requirement.result,0); if e2!=Error.none { return e2; } context.result=result; let signature,e3=copy.ty(context.requirement.signature,0); context.signature=signature; return e3; }
fn solveSchemeUse(self: ClosureRegion&,index: i64) -> SummaryProgress,Error { let first,error=schemeImport(self,self.scratch.constraints[index]); if error!=Error.none { return SummaryProgress.open,error; } var pending: SchemeFrame[>..<]=[]; match first { open=>{ return SummaryProgress.open,Error.none; },solved=>{ self.scratch.constraints[index].solved=true; return SummaryProgress.solved,Error.none; },frame frame=>{ pending.push(frame.value); }, } let result=solveSchemeUseFrames(self,pending); for &frame in pending { frame.copy.deinit(); } if result!=Error.none { return SummaryProgress.open,result; } self.scratch.constraints[index].solved=true; return SummaryProgress.solved,Error.none; }
