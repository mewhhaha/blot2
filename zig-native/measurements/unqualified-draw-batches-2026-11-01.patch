+import { Vec3 } from "std/vector"
+import { Appearance } from "ink/render"
+import * as math from "ink/math"
+import * as transform from "ink/transform"
+
+type Header is data = $Header {mesh: U32, material: U32, matrix: math.Mat4, has_parameters: Bool, parameters: math.Vec4}
+private type Row is data = $Row {header: Header, start: U32, count: U32}
+opaque type Builder = {rows: ResizeArray Row, vectors: ResizeArray math.Vec4}
+opaque type Batch = {rows: &[Row], vectors: &[math.Vec4]}
+
+// Seed copies preserve a caller's existing vector prefix without sharing pools.
+const with_builder = func (seed: &[math.Vec4]) -> (consume: Builder -> a ! {| e}) => return do:
+  let rows: ResizeArray Row = #[]
+  let vectors: ResizeArray math.Vec4 = #[]
+  for value in seed:
+    @storage.push vectors value
+  consume ($Builder {rows, vectors})
+  return ()
+const append = func (builder: Builder) -> (header: Header) -> (payload: &[math.Vec4]) => return do:
+  let rows = builder.rows
+  let vectors = builder.vectors
+  let start = vectors.length
+  let count = payload.length
+  for index in 0 .. count:
+    @storage.push vectors payload[index]
+  @storage.push rows ($Row {header, start, count})
+  return ()
+const batch = func (builder: Builder): Batch => return do:
+  let rows = builder.rows
+  let vectors = builder.vectors
+  let row_count = rows.length
+  let vector_count = vectors.length
+  return $Batch {rows: &rows[0..row_count], vectors: &vectors[0..vector_count]}
+const count = func (seen: Batch): U32 => return seen.rows.length
+const header = func (seen: Batch) -> (index: U32): Header => return seen.rows[index].header
+const payload = func (seen: Batch) -> (index: U32): &[math.Vec4] => return do:
+  let row = seen.rows[index]
+  let vectors = seen.vectors
+  return &vectors[row.start..row.start + row.count]
+const vector_count = func (seen: Batch): U32 => return seen.vectors.length
+const vector_at = func (seen: Batch) -> (index: U32): math.Vec4 => return seen.vectors[index]
+const append_batch = func (destination: Builder) -> (source: Batch) => return do:
+  let length = count source
+  for index in 0 .. length:
+    append destination (header source index) (payload source index)
+  return ()
+const clear = func (builder: Builder) => return do:
+  @storage.truncate builder.rows 0
+  @storage.truncate builder.vectors 0
+  return ()
+
+// Exact production factory; only the result representation differs below.
+const draw = func pose => return func (appearance: Appearance) => return
+  $Header { mesh: appearance.mesh, material: appearance.material, matrix: transform.matrix pose, has_parameters: false, parameters: math.vec4 0.0 0.0 0.0 0.0 }
+
+// `mesh` in `material` at `position`, turned `yaw` about the vertical and
+// sized by `scale`: the usual way to set a model in the world.
+const placed = func (mesh: U32) => return func (material: U32) => return func (position: Vec3) => return func (yaw: F32) => return func (scale: Vec3) => return
+  draw $transform.Pose3 { position, rotation: math.Quat.yaw yaw, scale } $Appearance { mesh, material }
+
