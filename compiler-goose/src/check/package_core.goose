fn contains(self_:const Targets&,key:TargetKey)->bool {return blot_support_pooled_map::contains(self_,key);}
fn insert(self_:Targets&,key:TargetKey,value:const u32[:])->bool {return blot_support_pooled_map::insert(self_,key,value,targets_slots);}
fn deinit(self_:Targets&) {blot_support_pooled_map::deinit(self_,targets_slots);}
fn reserve(self_:Targets&,extra:i64)->Error {if extra<0 || extra>0x1555555555555555-self_.count {return blot_error::Error.out_of_memory;}let needed=self_.count+extra;var capacity=max(8,self_.slots.len);while needed*3>capacity*2 {if capacity>0x2000000000000000 {return blot_error::Error.out_of_memory;}capacity*=2;}if capacity!=self_.slots.len {blot_support_pooled_map::grow(self_,capacity,targets_slots);}return blot_error::Error.none;}
struct Catalogs {count:i64=0,slots:dictionary_slot<u32,bool>[:]=default<dictionary_slot<u32,bool>[:]>()}
reusable[] var catalogs_slots:dictionary_slot<u32,bool>[>..];
