    var dispatches = Dispatches {..}; var capacity_requests = blot_backend_storage_plan::CapacityRequests {..}; var validation_budget: i64 = 1000000; var active_calls = blot_backend_storage_calls::ActiveCalls {..}; var scalar_admission = blot_backend_storage_calls::ScalarAdmission { units,..}; var field_recipes = blot_backend_storage_field_plan::Cache {..}; var descriptor_calls = DescriptorCalls { metadata: metadata,record_metadata: records,..}; var shared_calls = blot_backend_storage_calls::Cache {..}; var outlining = blot_backend_wasm_scope_outline::init(workspace.generator.module,blot_backend_wasm_scope_outline::Contract.scoped_numeric_adapter_nonreentrant,blot_backend_wasm_scope_outline::Options {..});
