const texts: Array U32 = #[1, 2, 3, 4, 5, 6]
func part (index: U32) => return &texts[index..index + 2]
func node (id: U32) -> (label: &[U32]) => return { id, size: label.length }
func declare (item: { id: U32, size: U32 }) -> (labels: own Array U32): Array U32 => return do:
  @storage.push labels (item.id + item.size)
  return labels
func declare_all (access: own { labels: Array U32 }) -> (open: Bool): { labels: Array U32 } => return do:
  access.labels := declare (node 1 (part 0)) self
  if open:
    access.labels := declare (node 2 (part 1)) self
    for index in 0 .. 3:
      let label = part index
      if index > 0:
        access.labels := declare (node index label) self
      else:
        access.labels := declare (node 9 (part 2)) self
  return access
entry func run (n: U32): U32 => return do:
  let labels: Array U32 = #[]
  let access = declare_all { labels } (n > 0)
  let total = 0
  for v in access.labels:
    total := self + v
  break total
