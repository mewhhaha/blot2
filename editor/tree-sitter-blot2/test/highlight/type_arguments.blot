type CurriedEffect input => type output is effect = input -> output
//                 ^ type.parameter
//                       ^ operator
//                          ^ keyword.storage.type
//                               ^ type.parameter

type State a is effect = { get: Unit -> a, set: a -> Unit }
//         ^ type.parameter
//                         ^ variable.other.member
//                                         ^ variable.other.member

type Empty () is data = #Empty
//         ^ punctuation.bracket
//          ^ punctuation.bracket
//            ^ keyword.storage.type

type Ping [] is effect = #Unit -> U32
//        ^ punctuation.bracket
//         ^ punctuation.bracket
//              ^ keyword.storage.type

const first = fn (entry: (Curried U32) [Bool, a]) => entry
//                        ^ type
//                                ^ type
//                                      ^ type
//                                                ^ operator

const get = fn (witness: input -> a) -> a => State.get ()
//    ^ function
//          ^ keyword.function
//              ^ variable.parameter
//                                           ^ type
//                                           ^ !function.builtin
//                                                 ^ function.method

const set = fn value => State.set value
//    ^ function
//          ^ keyword.function
//             ^ variable.parameter
//                      ^ type
//                      ^ !function.builtin
//                            ^ variable.other.member

