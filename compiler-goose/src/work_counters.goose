// Exact deterministic counter names; diagnostic clocks never affect validity.
namespace blot_work_counters;
import std;

enum InferenceStage { general, specialization, preparation, lowering }

fn saturating_add(left: u64, right: u64) -> u64 {
    if right > 18446744073709551615 - left { return 18446744073709551615; }
    return left + right;
}

struct Frontend {
    parallel_batches: u64 = 0,
    parallel_jobs: u64 = 0,
    parallel_retries: u64 = 0,
    parallel_prepare_us: u64 = 0,
    parallel_batch_us: u64 = 0,
    parallel_capacity_us: u64 = 0,
    parallel_worker_us: u64 = 0,
    parallel_worker_cpu_us: u64 = 0,
    parallel_worker_cpu_samples: u64 = 0,
    parallel_worker_slots: u64 = 0,
    parallel_worker_jobs: u64 = 0,
    modules: u64 = 0,
    scheme_calls: u64 = 0,
    closed_array_locals: u64 = 0,
    candidate_scans: u64 = 0,
    candidates: u64 = 0,
    candidate_parts: u64 = 0,
    candidate_variables: u64 = 0,
    candidate_rows: u64 = 0,
    dependency_hits: u64 = 0,
    dependency_recomputations: u64 = 0,
    import_requests: u64 = 0,
    imported_schemes: u64 = 0,
    imported_summary_reuses: u64 = 0,
    imported_read: u64 = 0,
    type_nodes: u64 = 0,
    normalization: Normalization = default<Normalization>(),
}
fn merge(self_: Frontend&, other: Frontend) {
    self_.parallel_batches = saturating_add(self_.parallel_batches, other.parallel_batches);
    self_.parallel_jobs = saturating_add(self_.parallel_jobs, other.parallel_jobs);
    self_.parallel_retries = saturating_add(self_.parallel_retries, other.parallel_retries);
    self_.parallel_prepare_us = saturating_add(self_.parallel_prepare_us, other.parallel_prepare_us);
    self_.parallel_batch_us = saturating_add(self_.parallel_batch_us, other.parallel_batch_us);
    self_.parallel_capacity_us = saturating_add(self_.parallel_capacity_us, other.parallel_capacity_us);
    self_.parallel_worker_us = saturating_add(self_.parallel_worker_us, other.parallel_worker_us);
    self_.parallel_worker_cpu_us = saturating_add(self_.parallel_worker_cpu_us, other.parallel_worker_cpu_us);
    self_.parallel_worker_cpu_samples = saturating_add(self_.parallel_worker_cpu_samples, other.parallel_worker_cpu_samples);
    self_.parallel_worker_slots = saturating_add(self_.parallel_worker_slots, other.parallel_worker_slots);
    self_.parallel_worker_jobs = saturating_add(self_.parallel_worker_jobs, other.parallel_worker_jobs);
    self_.modules = saturating_add(self_.modules, other.modules);
    self_.scheme_calls = saturating_add(self_.scheme_calls, other.scheme_calls);
    self_.closed_array_locals = saturating_add(self_.closed_array_locals, other.closed_array_locals);
    self_.candidate_scans = saturating_add(self_.candidate_scans, other.candidate_scans);
    self_.candidates = saturating_add(self_.candidates, other.candidates);
    self_.candidate_parts = saturating_add(self_.candidate_parts, other.candidate_parts);
    self_.candidate_variables = saturating_add(self_.candidate_variables, other.candidate_variables);
    self_.candidate_rows = saturating_add(self_.candidate_rows, other.candidate_rows);
    self_.dependency_hits = saturating_add(self_.dependency_hits, other.dependency_hits);
    self_.dependency_recomputations = saturating_add(self_.dependency_recomputations, other.dependency_recomputations);
    self_.import_requests = saturating_add(self_.import_requests, other.import_requests);
    self_.imported_schemes = saturating_add(self_.imported_schemes, other.imported_schemes);
    self_.imported_summary_reuses = saturating_add(self_.imported_summary_reuses, other.imported_summary_reuses);
    self_.imported_read = saturating_add(self_.imported_read, other.imported_read);
    self_.type_nodes = saturating_add(self_.type_nodes, other.type_nodes);
    merge(self_.normalization, other.normalization);
}

struct Normalization {
    substitute_nodes_added: u64 = 0,
    substitute_depth_entries: u64 = 0,
    substitute_memo_hits: u64 = 0,
    substitute_unchanged: u64 = 0,
    resolve_nodes_added: u64 = 0,
    resolve_depth_entries: u64 = 0,
    unify_pairs: u64 = 0,
    unify_projected_pairs: u64 = 0,
    unify_resolve_calls: u64 = 0,
    unify_resolve_entries: u64 = 0,
    unify_resolve_nodes: u64 = 0,
    open_nodes_added: u64 = 0,
    open_depth_entries: u64 = 0,
    close_nodes_added: u64 = 0,
    close_depth_entries: u64 = 0,
    import_nodes_added: u64 = 0,
    import_depth_entries: u64 = 0,
    variable_views_created: u64 = 0,
    type_binders_created: u64 = 0,
    row_requests: u64 = 0,
    closed_row_hits: u64 = 0,
    epoch_row_hits: u64 = 0,
    epoch_row_probes: u64 = 0,
    epoch_row_collisions: u64 = 0,
    epoch_row_stale: u64 = 0,
    epoch_row_context_misses: u64 = 0,
    epoch_row_publications: u64 = 0,
    composite_probes: u64 = 0,
    composite_hits: u64 = 0,
    composite_collisions: u64 = 0,
    composite_stale_dependencies: u64 = 0,
    composite_future_clock_misses: u64 = 0,
    composite_frontier_declines: u64 = 0,
    composite_publications: u64 = 0,
    free_type_queries: u64 = 0,
    free_type_visits: u64 = 0,
    free_row_queries: u64 = 0,
    free_row_visits: u64 = 0,
    argument_rows: u64 = 0,
    labels: u64 = 0,
    arguments: u64 = 0,
    changed_rows: u64 = 0,
    closed_row_evictions: u64 = 0,
    interner_requests: u64 = 0,
    interner_candidates: u64 = 0,
    interner_arguments: u64 = 0,
    interner_linked: u64 = 0,
    interner_rebuilds: u64 = 0,
    closed_operation_hits: u64 = 0,
    argument_height_checks: u64 = 0,
}
fn merge(self_: Normalization&, other: Normalization) {
    self_.substitute_nodes_added = saturating_add(self_.substitute_nodes_added, other.substitute_nodes_added);
    self_.substitute_depth_entries = saturating_add(self_.substitute_depth_entries, other.substitute_depth_entries);
    self_.substitute_memo_hits = saturating_add(self_.substitute_memo_hits, other.substitute_memo_hits);
    self_.substitute_unchanged = saturating_add(self_.substitute_unchanged, other.substitute_unchanged);
    self_.resolve_nodes_added = saturating_add(self_.resolve_nodes_added, other.resolve_nodes_added);
    self_.resolve_depth_entries = saturating_add(self_.resolve_depth_entries, other.resolve_depth_entries);
    self_.unify_pairs = saturating_add(self_.unify_pairs, other.unify_pairs);
    self_.unify_projected_pairs = saturating_add(self_.unify_projected_pairs, other.unify_projected_pairs);
    self_.unify_resolve_calls = saturating_add(self_.unify_resolve_calls, other.unify_resolve_calls);
    self_.unify_resolve_entries = saturating_add(self_.unify_resolve_entries, other.unify_resolve_entries);
    self_.unify_resolve_nodes = saturating_add(self_.unify_resolve_nodes, other.unify_resolve_nodes);
    self_.open_nodes_added = saturating_add(self_.open_nodes_added, other.open_nodes_added);
    self_.open_depth_entries = saturating_add(self_.open_depth_entries, other.open_depth_entries);
    self_.close_nodes_added = saturating_add(self_.close_nodes_added, other.close_nodes_added);
    self_.close_depth_entries = saturating_add(self_.close_depth_entries, other.close_depth_entries);
    self_.import_nodes_added = saturating_add(self_.import_nodes_added, other.import_nodes_added);
    self_.import_depth_entries = saturating_add(self_.import_depth_entries, other.import_depth_entries);
    self_.variable_views_created = saturating_add(self_.variable_views_created, other.variable_views_created);
    self_.type_binders_created = saturating_add(self_.type_binders_created, other.type_binders_created);
    self_.row_requests = saturating_add(self_.row_requests, other.row_requests);
    self_.closed_row_hits = saturating_add(self_.closed_row_hits, other.closed_row_hits);
    self_.epoch_row_hits = saturating_add(self_.epoch_row_hits, other.epoch_row_hits);
    self_.epoch_row_probes = saturating_add(self_.epoch_row_probes, other.epoch_row_probes);
    self_.epoch_row_collisions = saturating_add(self_.epoch_row_collisions, other.epoch_row_collisions);
    self_.epoch_row_stale = saturating_add(self_.epoch_row_stale, other.epoch_row_stale);
    self_.epoch_row_context_misses = saturating_add(self_.epoch_row_context_misses, other.epoch_row_context_misses);
    self_.epoch_row_publications = saturating_add(self_.epoch_row_publications, other.epoch_row_publications);
    self_.composite_probes = saturating_add(self_.composite_probes, other.composite_probes);
    self_.composite_hits = saturating_add(self_.composite_hits, other.composite_hits);
    self_.composite_collisions = saturating_add(self_.composite_collisions, other.composite_collisions);
    self_.composite_stale_dependencies = saturating_add(self_.composite_stale_dependencies, other.composite_stale_dependencies);
    self_.composite_future_clock_misses = saturating_add(self_.composite_future_clock_misses, other.composite_future_clock_misses);
    self_.composite_frontier_declines = saturating_add(self_.composite_frontier_declines, other.composite_frontier_declines);
    self_.composite_publications = saturating_add(self_.composite_publications, other.composite_publications);
    self_.free_type_queries = saturating_add(self_.free_type_queries, other.free_type_queries);
    self_.free_type_visits = saturating_add(self_.free_type_visits, other.free_type_visits);
    self_.free_row_queries = saturating_add(self_.free_row_queries, other.free_row_queries);
    self_.free_row_visits = saturating_add(self_.free_row_visits, other.free_row_visits);
    self_.argument_rows = saturating_add(self_.argument_rows, other.argument_rows);
    self_.labels = saturating_add(self_.labels, other.labels);
    self_.arguments = saturating_add(self_.arguments, other.arguments);
    self_.changed_rows = saturating_add(self_.changed_rows, other.changed_rows);
    self_.closed_row_evictions = saturating_add(self_.closed_row_evictions, other.closed_row_evictions);
    self_.interner_requests = saturating_add(self_.interner_requests, other.interner_requests);
    self_.interner_candidates = saturating_add(self_.interner_candidates, other.interner_candidates);
    self_.interner_arguments = saturating_add(self_.interner_arguments, other.interner_arguments);
    self_.interner_linked = saturating_add(self_.interner_linked, other.interner_linked);
    self_.interner_rebuilds = saturating_add(self_.interner_rebuilds, other.interner_rebuilds);
    self_.closed_operation_hits = saturating_add(self_.closed_operation_hits, other.closed_operation_hits);
    self_.argument_height_checks = saturating_add(self_.argument_height_checks, other.argument_height_checks);
}

struct SchemeMembership {
    prepares: u64 = 0,
    small: u64 = 0,
    hits: u64 = 0,
    publications: u64 = 0,
    saturated: u64 = 0,
    indexed_items: u64 = 0,
}
fn merge(self_: SchemeMembership&, other: SchemeMembership) {
    self_.prepares = saturating_add(self_.prepares, other.prepares);
    self_.small = saturating_add(self_.small, other.small);
    self_.hits = saturating_add(self_.hits, other.hits);
    self_.publications = saturating_add(self_.publications, other.publications);
    self_.saturated = saturating_add(self_.saturated, other.saturated);
    self_.indexed_items = saturating_add(self_.indexed_items, other.indexed_items);
}


