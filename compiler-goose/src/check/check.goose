fn Engine::intrinsic(self:Engine&,id:u32,name:u32)->u32,blot_error::Error {
 let text=self.pool.get(name);if self.editorAt(id) {return self.captureEditor(id,0,0);}let intrinsic=blot_backend_simd_intrinsics::lookup(text);if intrinsic.present {let op=intrinsic.value;var element=blot_check_types::u32_type;if op.floating {element=blot_check_types::f32_type;}let vector,err=self.types.product([element,element,element,element]);if err!=blot_error::Error.none {return 0,err;}let lanes,err=self.types.product([blot_check_types::u32_type,blot_check_types::u32_type,blot_check_types::u32_type,blot_check_types::u32_type]);if err!=blot_error::Error.none {return 0,err;}var result_element=blot_check_types::u32_type;if op.resultLane()==blot_backend_simd_intrinsics::Lane.floating {result_element=blot_check_types::f32_type;}let output,err=self.types.product([result_element,result_element,result_element,result_element]);if err!=blot_error::Error.none {return 0,err;}let pair,err=self.types.product([vector,vector]);if err!=blot_error::Error.none {return 0,err;}match op.shape {
