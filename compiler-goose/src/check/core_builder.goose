fn Builder::application(self:Builder&,source:u32,depth:i64)->u32,Error {var backwards=ApplicationBuffer{..};var arguments=WordBuffer{..};let result,error=applicationValues(self,source,depth,backwards,arguments);arguments.deinit();backwards.deinit(application_runs);return result,error;}
fn applicationValues(self:Builder&,source:u32,depth:i64,backwards:ApplicationBuffer&,arguments:WordBuffer&)->u32,Error {var callee=source;while self.source.tree.node(callee).tag==blot_parse_ast::tag_apply {let value=self.source.tree.node(callee);let error=backwards.push(ApplicationArgument{value:value.b,site:callee, ..},application_runs);if error!=Error.none {return 0,error;}let inner=self.unwrap(value.a);if inner<self.source.checked.operation_refs.len && self.source.checked.operation_refs[inner]!=0 {callee=inner;break;}if self.source.tree.node(value.a).tag==blot_parse_ast::tag_group && self.source.tree.node(inner).tag==blot_parse_ast::tag_apply {callee=value.a;break;}callee=inner;}let syntax=self.source.tree.node(callee);let result,error=self.typeOf(source);if error!=Error.none {return 0,error;}
