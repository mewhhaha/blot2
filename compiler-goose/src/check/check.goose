 for entry,index in base {let a=left[index];let b=right[index];var shadowed=false;for later in base[index+1..] {if later.name==entry.name {shadowed=true;break;}}if shadowed || (a==entry.binding && b==entry.binding) || (then_flow.exits && else_flow.exits) {continue;}if then_flow.exits && !monadic {self.env.append(Entry{entry.name,b});continue;}if else_flow.exits && !monadic {self.env.append(Entry{entry.name,a});continue;}if !then_flow.exits && !else_flow.exits {let err=self.constrain(self.bindings[a].ty,self.bindings[b].ty,id);if err!=blot_error::Error.none {return Flow{},err;}}var selected=a;if then_flow.exits {selected=b;}let ty=self.bindings[selected].ty;let merged,err=self.addBinding(Binding{name:entry.name,declaration:id,owner:self.owner,kind:Kind.local,ty:ty,predecessor:entry.binding});if err!=blot_error::Error.none {return Flow{},err;}self.env.append(Entry{entry.name,merged});self.merges.append(Merge{node:id,result:merged,then_binding:a,else_binding:b});if monadic {let err=joins.append(ty);if err!=blot_error::Error.none {return Flow{},err;}}}
 if monadic {var join_type=blot_check_types::unit;if joins.items.len!=0 {let tuple,err=self.types.product(joins.items);if err!=blot_error::Error.none {return Flow{},err;}join_type=tuple;}var parameter:u32=0;if joins.items.len!=0 {let binding,err=self.addBinding(Binding{name:0,declaration:id,owner:self.owner,kind:Kind.local,ty:join_type,scheme:blot_check_types::Scheme{root:join_type}});if err!=blot_error::Error.none {return Flow{},err;}parameter=binding;}if self.resolver_joins.len>=0xffffffff {return Flow{},blot_error::Error.type_limit;}self.resolver_joins.append(ResolverJoin{node:id,parameter:parameter,ty:join_type,result:suffix});self.resolver_join_ids[id]=self.resolver_joins.len as u32;self.resolver_scope.result=suffix;}self.expr_types[id]=blot_check_types::unit;return Flow{exits:then_flow.exits && else_flow.exits,returns:then_flow.returns || else_flow.returns,breaks:then_flow.breaks || else_flow.breaks},blot_error::Error.none;
}
fn Engine::solveFields(self:Engine&)->blot_error::Error {return self.solveFieldsFrom(0);}
fn Engine::solveFieldsFrom(self:Engine&,start:i64)->blot_error::Error {var progress=true;while progress {progress=false;var cursor=start;loop {if self.selected_globals.len!=0 {return blot_error::Error.none;}let err=self.syncPendingQueue();if err!=blot_error::Error.none {return err;}let selected=self.pending_queue.take(cursor);if !selected.present {break;}let index=selected.value;cursor=index+1;let pending=self.pending[index];if pending.solved {self.pending_queue.complete(index);continue;}if pending.suspended {self.pending_queue.requeue(index);continue;}if pending.wait_target!=0 {let state .= self.global_states.get(pending.wait_target);assert(state);if state.state!=State.complete {self.pending_queue.requeue(index);continue;}self.pending[index].wait_target=0;}let made,err=self.attemptPending(index,pending);if err!=blot_error::Error.none {return err;}progress=progress || made;let err=self.syncPendingQueue();if err!=blot_error::Error.none {return err;}if index>=self.pending.len {continue;}let after=self.pending[index];if after.solved {self.pending_queue.complete(index);}else if after.value.kind==blot_check_types::ObligationKind.effect_operation && !after.suspended {let err=self.pending_queue.watch(self.types,index,[after.value.other,after.value.signature],false,false);if err!=blot_error::Error.none {return err;}}else if after.value.kind==blot_check_types::ObligationKind.callee_use && !after.suspended && self.calleeSettled(after.value.identity.decl) {let err=self.pending_queue.watch(self.types,index,[after.value.ty],false,false);if err!=blot_error::Error.none {return err;}}else {let input,err=self.pendingSelectionInput(after);if err!=blot_error::Error.none {return err;}if input.present {let err=self.pending_queue.watch(self.types,index,[input.value],false,false);if err!=blot_error::Error.none {return err;}}else {self.pending_queue.requeue(index);}}}}return blot_error::Error.none;}
fn Engine::pendingSelectionInput(self:Engine&,pending:PendingObligation)->blot_support::Option<u32>,blot_error::Error {if pending.suspended {return blot_support::none<u32>(),blot_error::Error.none;}var input:u32=0;match pending.value.kind {blot_check_types::ObligationKind.field,blot_check_types::ObligationKind.writable_field,blot_check_types::ObligationKind.dispatch=>{input=pending.value.ty;},blot_check_types::ObligationKind.result_dispatch=>{input=pending.value.result;},_=>{return blot_support::none<u32>(),blot_error::Error.none;},}let root,err=self.types.resolve(input,0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if self.types.node(root).tag!=blot_check_types::Tag.variable {return blot_support::none<u32>(),blot_error::Error.none;}return blot_support::some(input),blot_error::Error.none;}
fn Engine::calleeSettled(self:const Engine&,binding:u32)->bool {if binding>=self.bindings.len {return false;}if self.bindings[binding].kind==Kind.external {return true;}let state .= self.global_states.get(binding);if !state {return false;}return state.state==State.complete && !state.on_stack;}
fn Engine::syncPendingQueue(self:Engine&)->blot_error::Error {self.pending_queue.truncate(self.pending.len);while self.pending_queue.entries.len<self.pending.len {let err=self.pending_queue.add(true);if err!=blot_error::Error.none {return err;}}self.pending_queue.observe(self.types);return blot_error::Error.none;}
fn Engine::attemptPending(self:Engine&,index:i64,pending:PendingObligation)->bool,blot_error::Error {let saved=self.dependency_owner;self.dependency_owner=blot_support::some(pending.owner);let err=self.inferenceTransition();if err!=blot_error::Error.none {self.dependency_owner=saved;return false,err;}let result,error=attemptPendingBody(self,index,pending);self.dependency_owner=saved;return result,error;}
fn attemptPendingBody(self:Engine&,index:i64,pending:PendingObligation)->bool,blot_error::Error {let constraint=pending.value;let kind=constraint.kind;if kind==blot_check_types::ObligationKind.callee_use {return self.resolveUse(index);}if kind==blot_check_types::ObligationKind.record_merge {let merged,error=self.types.mergeRecords(constraint.ty,constraint.other);if error==blot_error::Error.type_mismatch {let err=self.diagnostic(Code.type_mismatch,constraint.source);if err!=blot_error::Error.none {return false,err;}self.pending[index].solved=true;return true,blot_error::Error.none;}if error!=blot_error::Error.none {return false,error;}if merged.present {let err=self.constrain(merged.value,constraint.result,constraint.source);if err!=blot_error::Error.none {return false,err;}self.pending[index].solved=true;return true,blot_error::Error.none;}return false,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.type_eq {let open,err=self.requirementOpen(constraint);if err!=blot_error::Error.none {return false,err;}if open {return false,blot_error::Error.none;}let err=self.constrain(constraint.ty,constraint.result,constraint.source);if err!=blot_error::Error.none {return false,err;}self.pending[index].solved=true;return true,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.contract {let root=self.types.node(self.types.head(constraint.ty,0));if root.tag!=blot_check_types::Tag.product {return false,blot_error::Error.none;}let selected,err=self.selectImplementation(constraint.identity,self.types.list(blot_check_types::List{root.a,root.b}),constraint.source);if err!=blot_error::Error.none {return false,err;}if selected.present {self.pending[index].solved=true;return true,blot_error::Error.none;}return false,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.collection {let root,err=self.types.resolve(constraint.ty,0);if err!=blot_error::Error.none {return false,err;}let owner=self.types.node(root);if owner.tag==blot_check_types::Tag.variable || owner.tag==blot_check_types::Tag.projection {return false,blot_error::Error.none;}let element=blot_check_storage_types::readableElement(self.types,self.types.head(constraint.ty,0));if element.present {let err=self.constrain(element.value,constraint.result,constraint.source);if err!=blot_error::Error.none {return false,err;}}else if owner.tag==blot_check_types::Tag.list {let err=self.constrain(owner.a,constraint.result,constraint.source);if err!=blot_error::Error.none {return false,err;}}else {let err=self.diagnostic(Code.type_mismatch,constraint.source);if err!=blot_error::Error.none {return false,err;}}self.pending[index].solved=true;return true,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.task_receive {let root,err=self.types.resolve(constraint.signature,0);if err!=blot_error::Error.none {return false,err;}let signature=self.types.node(root);let result,error=blot_check_task_types::receiveResult(self.types,constraint.ty,signature.c);if error==blot_error::Error.type_mismatch || error==blot_error::Error.effect_mismatch || error==blot_error::Error.infinite_effect {let err=self.diagnostic(Code.task_host_contract,constraint.source);if err!=blot_error::Error.none {return false,err;}self.pending[index].solved=true;return true,blot_error::Error.none;}if error!=blot_error::Error.none {return false,error;}if result.present {let err=self.constrain(result.value,constraint.result,constraint.source);if err!=blot_error::Error.none {return false,err;}self.pending[index].solved=true;return true,blot_error::Error.none;}return false,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.monad_factory {let root,err=self.types.resolve(constraint.ty,0);if err!=blot_error::Error.none {return false,err;}let token=self.types.node(root);if token.tag==blot_check_types::Tag.variable {return false,blot_error::Error.none;}if token.tag!=blot_check_types::Tag.type_constructor {let err=self.diagnostic(Code.type_constructor_required,constraint.source);if err!=blot_error::Error.none {return false,err;}}self.pending[index].solved=true;return true,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.resolver_dispatch {self.pending[index].suspended=true;let selected,error=self.resolverDispatch(pending);if error!=blot_error::Error.none {return false,error;}self.pending[index].suspended=false;if selected {self.pending[index].solved=true;}return selected,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.type_head {let head,err=self.witnessResult(constraint.ty);if err!=blot_error::Error.none {return false,err;}let root,err=self.types.resolve(head,0);if err!=blot_error::Error.none {return false,err;}if self.types.node(root).tag==blot_check_types::Tag.variable {return false,blot_error::Error.none;}let err=self.constrain(head,constraint.result,constraint.source);if err!=blot_error::Error.none {return false,err;}self.pending[index].solved=true;return true,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.effect_handler {let a,err=self.types.resolve(constraint.signature,0);if err!=blot_error::Error.none {return false,err;}let b,err=self.types.resolve(constraint.other,0);if err!=blot_error::Error.none {return false,err;}let extended=self.types.node(a);let residual=self.types.node(b);if extended.tag!=blot_check_types::Tag.function || residual.tag!=blot_check_types::Tag.function {return false,blot_error::Error.type_limit;}let solved,err=self.handlerEquation(constraint.ty,extended.c,residual.c,constraint.source);if err!=blot_error::Error.none {return false,err;}if solved {self.pending[index].solved=true;}return solved,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.effect_operation {let arguments,err=self.types.resolve(constraint.other,0);if err!=blot_error::Error.none {return false,err;}let closed,err=self.types.equalClosed(arguments,arguments);if err!=blot_error::Error.none {return false,err;}if !closed {return false,blot_error::Error.none;}let pack=self.types.node(arguments);if pack.tag!=blot_check_types::Tag.product {return false,blot_error::Error.type_limit;}let owned=equation_type_ids.alloc_slice(pack.b);for argument,position in self.types.list(blot_check_types::List{pack.a,pack.b}) {owned[position]=argument;}let label,row,error=internPendingOperation(self,constraint,owned);equation_type_ids.free_slice(owned);if error!=blot_error::Error.none {return false,error;}for known in self.types.rowLabels(row) {if known==label {self.pending[index].solved=true;return true,blot_error::Error.none;}}return false,blot_error::Error.none;}
 if kind==blot_check_types::ObligationKind.resolver_shape {return pendingResolverShape(self,index,constraint);}if kind==blot_check_types::ObligationKind.update {let updated,err=self.updatedFieldType(constraint.ty,constraint.name,constraint.other,constraint.source);if err!=blot_error::Error.none {return false,err;}if updated.present {let err=self.constrain(constraint.result,updated.value,constraint.source);if err!=blot_error::Error.none {return false,err;}self.pending[index].solved=true;return true,blot_error::Error.none;}return false,blot_error::Error.none;}
 if kind!=blot_check_types::ObligationKind.field && kind!=blot_check_types::ObligationKind.writable_field && kind!=blot_check_types::ObligationKind.dispatch && kind!=blot_check_types::ObligationKind.result_dispatch {return false,blot_error::Error.none;}let saved=self.ambient;if constraint.signature!=0 {let root,err=self.types.resolve(constraint.signature,0);if err!=blot_error::Error.none {return false,err;}self.ambient=self.types.node(root).c;}let selected,error=pendingMemberSelection(self,index,pending);self.ambient=saved;return selected,error;
}
fn internPendingOperation(self:Engine&,constraint:blot_check_types::Obligation,arguments:const u32[:])->u32,u32,blot_error::Error {let root,err=self.types.resolve(constraint.signature,0);if err!=blot_error::Error.none {return 0,0,err;}let signature=self.types.node(root);if signature.tag!=blot_check_types::Tag.function {return 0,0,blot_error::Error.type_limit;}let label,error=self.types.internOperation(constraint.identity,arguments);return label,signature.c,error;}
fn pendingResolverShape(self:Engine&,index:i64,constraint:blot_check_types::Obligation)->bool,blot_error::Error {let root,err=self.types.resolve(constraint.ty,0);if err!=blot_error::Error.none {return false,err;}let owner=self.types.node(root);if owner.tag==blot_check_types::Tag.variable || owner.tag==blot_check_types::Tag.projection {return false,blot_error::Error.none;}if owner.tag!=blot_check_types::Tag.resolver {let err=self.diagnostic(Code.invalid_provider,constraint.source);if err!=blot_error::Error.none {return false,err;}}else {let token_id,err=self.types.resolve(owner.a,0);if err!=blot_error::Error.none {return false,err;}let token=self.types.node(token_id);if token.tag==blot_check_types::Tag.variable {return false,blot_error::Error.none;}if token.tag!=blot_check_types::Tag.type_constructor {let err=self.diagnostic(Code.type_constructor_required,constraint.source);if err!=blot_error::Error.none {return false,err;}}else {let identity=Identity{token.a,token.b};let nominal=self.nominalIndex(identity);if !nominal.present {return false,blot_error::Error.type_limit;}let arguments=equation_type_ids.alloc_slice(self.nominals[nominal.value].parameters.len);let error=pendingResolverNominal(self,constraint,identity,arguments);equation_type_ids.free_slice(arguments);if error!=blot_error::Error.none {return false,error;}}}self.pending[index].solved=true;return true,blot_error::Error.none;}
fn pendingResolverNominal(self:Engine&,constraint:blot_check_types::Obligation,identity:Identity,arguments:u32[:])->blot_error::Error {for &argument in arguments {let fresh,err=self.types.fresh();if err!=blot_error::Error.none {return err;}argument=fresh;}let nominal,err=self.types.nominal(identity,arguments);if err!=blot_error::Error.none {return err;}return self.constrain(constraint.result,nominal,constraint.source);}
fn pendingMemberSelection(self:Engine&,index:i64,pending:PendingObligation)->bool,blot_error::Error {let constraint=pending.value;let kind=constraint.kind;var input=constraint.ty;if kind==blot_check_types::ObligationKind.result_dispatch {input=constraint.result;}let owner,err=self.types.resolve(input,0);if err!=blot_error::Error.none {return false,err;}let tag=self.types.node(owner).tag;if tag==blot_check_types::Tag.variable || tag==blot_check_types::Tag.projection {return false,blot_error::Error.none;}self.pending[index].suspended=true;let selected,error=pendingMemberValue(self,owner,pending);if error!=blot_error::Error.none {return false,error;}self.pending[index].suspended=false;if selected.present {let before=self.diagnostics.len;let err=self.constrain(constraint.result,selected.value,constraint.source);if err!=blot_error::Error.none {return false,err;}if kind==blot_check_types::ObligationKind.dispatch && self.diagnostics.len!=before && self.dispatch_side!=blot_reuse_dispatch_explanation::Side.builtin {let err=self.explainSelected(owner,constraint.other,constraint.name,constraint.operator,self.dispatch_side);if err!=blot_error::Error.none {return false,err;}}self.pending[index].solved=true;return true,blot_error::Error.none;}return false,blot_error::Error.none;}
fn pendingMemberValue(self:Engine&,owner:u32,pending:PendingObligation)->blot_support::Option<u32>,blot_error::Error {let value=pending.value;if value.kind==blot_check_types::ObligationKind.field || value.kind==blot_check_types::ObligationKind.writable_field {let result,err=self.projectField(owner,value.name,value.source,value.kind==blot_check_types::ObligationKind.writable_field,blot_support::some(pending));return blot_support::some(result.ty),err;}if value.kind==blot_check_types::ObligationKind.result_dispatch {return self.resultDispatch(value.ty,owner,value.name,value.source,pending.direct);}return self.dispatch(owner,value.other,value.name,value.operator,value.source,pending.direct);}
type KeyBuffer=blot_support_pooled_buffer::Buffer<u8>;
reusable[] var key_bytes:u8[>..];
reusable[] var key_buffers:KeyBuffer[>..];
fn KeyBuffer::byte(self:KeyBuffer&,value:u8)->blot_error::Error {return self.push(value,key_bytes);}
fn KeyBuffer::word(self:KeyBuffer&,value:u32)->blot_error::Error {for shift in 0..4 {let err=self.byte((value>>((shift*8) as u32)) as! u8);if err!=blot_error::Error.none {return err;}}return blot_error::Error.none;}
fn KeyBuffer::length(self:KeyBuffer&,value:i64)->blot_error::Error {let bits=value as u64;for shift in 0..8 {let err=self.byte((bits>>((shift*8) as u64)) as! u8);if err!=blot_error::Error.none {return err;}}return blot_error::Error.none;}
struct KeyFieldOrder {store:blot_check_types::Store,node:blot_check_types::Node,order:u32[:]}
fn KeyFieldOrder::lessThan(self:KeyFieldOrder,left:i64,right:i64)->bool {return self.store.recordField(self.node,self.order[left]).name<self.store.recordField(self.node,self.order[right]).name;}
fn KeyFieldOrder::swap(self:KeyFieldOrder,left:i64,right:i64) {let old=self.order[left];self.order[left]=self.order[right];self.order[right]=old;}
struct KeyByteOrder {values:KeyBuffer[:]}
fn KeyByteOrder::lessThan(self:KeyByteOrder,left:i64,right:i64)->bool {return self.values[left].items<self.values[right].items;}
fn KeyByteOrder::swap(self:KeyByteOrder,left:i64,right:i64) {let old=self.values[left];self.values[left]=self.values[right];self.values[right]=old;}
recursive fn Engine::closedKey(self:Engine&,ty:u32,out:KeyBuffer&,depth:i64)->bool,blot_error::Error {if depth>=256 {return false,blot_error::Error.none;}let root,err=self.types.resolve(ty,0);if err!=blot_error::Error.none {return false,err;}let value=self.types.node(root);let err=out.byte(blot_check_types::tagCode(value.tag) as! u8);if err!=blot_error::Error.none {return false,err;}match value.tag {
 blot_check_types::Tag.unit,blot_check_types::Tag.boolean,blot_check_types::Tag.unsigned32,blot_check_types::Tag.floating32,blot_check_types::Tag.never=>{return true,blot_error::Error.none;},
 blot_check_types::Tag.function=>{let row,err=self.types.resolveEffects(value.c,0);if err!=blot_error::Error.none {return false,err;}let closed,err=self.closedRowKey(row,out,depth+1);if err!=blot_error::Error.none || !closed {return closed,err;}let closed,err=self.closedKey(value.a,out,depth+1);if err!=blot_error::Error.none || !closed {return closed,err;}return self.closedKey(value.b,out,depth+1);},
 blot_check_types::Tag.product=>{let err=out.word(value.b);if err!=blot_error::Error.none {return false,err;}for index in 0..value.b {let child=self.types.list(blot_check_types::List{value.a,value.b})[index];let closed,err=self.closedKey(child,out,depth+1);if err!=blot_error::Error.none || !closed {return closed,err;}}return true,blot_error::Error.none;},
 blot_check_types::Tag.record=>{let err=out.word(value.b);if err!=blot_error::Error.none {return false,err;}let order=equation_type_ids.alloc_slice(value.b);for &slot,index in order {slot=index as u32;}blot_check_source_sort::pdqContext(0,order.len,KeyFieldOrder{self.types,value,order});let result,error=closedRecordKey(self,value,order,out,depth);equation_type_ids.free_slice(order);return result,error;},
 blot_check_types::Tag.nominal=>{let err=out.word(value.a);if err!=blot_error::Error.none {return false,err;}let err=out.word(value.b);if err!=blot_error::Error.none {return false,err;}let count=self.types.nominalArguments(value).len;let err=out.length(count);if err!=blot_error::Error.none {return false,err;}for index in 0..count {let child=self.types.nominalArguments(value)[index];let closed,err=self.closedKey(child,out,depth+1);if err!=blot_error::Error.none || !closed {return closed,err;}}return true,blot_error::Error.none;},
