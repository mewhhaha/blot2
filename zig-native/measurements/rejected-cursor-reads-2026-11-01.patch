+test "ordinary curried calls preserve intrinsic divergence and named record diagnostics" {
+    const source =
+        \\const pick = func (left: U32) -> (right: U32) => return right
+        \\const named = func (values: {left: U32, right: U32}) => return @u32.add values.left values.right
+        \\const ordinary = func () => return pick (@panic "earlier") 7
+        \\const intrinsic = func () => return @u32.add (@panic "earlier") 7
+        \\entry const answer = func (input: U32) => return named {right: pick 1 2, left: input}
+    ;
+    var valid = try Fixture.init(source);
+    defer valid.deinit();
+    try valid.valid();
+    var never: usize = 0;
+    for (valid.tree.nodes.items, 0..) |node, id| {
+        if (node.tag != .apply) continue;
+        const span = valid.tree.span(@intCast(id));
+        const text = source[span.start..span.end];
+        if (!std.mem.eql(u8, text, "pick (@panic \"earlier\") 7") and !std.mem.eql(u8, text, "@u32.add (@panic \"earlier\") 7")) continue;
+        try std.testing.expectEqual(T.never, valid.checked.expr_types[id]);
+        never += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 2), never);
+    const invalid = "const named = func (values: {left: U32, right: U32}) => return values.left\nentry const answer = named {left: 1, wrong: 2}\n";
+    var rejected = try Fixture.init(invalid);
+    defer rejected.deinit();
+    const start = std.mem.find(u8, invalid, "wrong").?;
+    try std.testing.expect(rejected.checked.diagnostics.len != 0);
+    try std.testing.expectEqual(check.Code.unknown_field, rejected.checked.diagnostics[0].code);
+    try std.testing.expectEqual(start, rejected.checked.diagnostics[0].span.start);
+}
