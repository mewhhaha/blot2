!value.present {return blot_support::none<Source>(),error;}proof.values[proof.value_len]=Value{binding:bind.a,node:value.value,..};proof.value_len+=1;}let selected,error=proof.cyclic(selectors[0].index);if error!=blot_error::Error.none || !selected {return blot_support::none<Source>(),error;}let result,error=proof.expression(update.value,0);if error!=blot_error::Error.none || !result.present {return blot_support::none<Source>(),error;}proof.output.result=result.value;if !proof.input.present || !proof.seen_state {return blot_support::none<Source>(),blot_error::Error.none;}proof.output.input=proof.input.value;let carries=module.loopCarries(id);if carries.len>32 {return blot_support::none<Source>(),blot_error::Error.none;}for carry in carries {if carry.iteration==state.value.binding {if carry.backedge!=store.a {return blot_support::none<Source>(),blot_error::Error.none;}}else if carry.backedge!=carry.iteration {return blot_support::none<Source>(),blot_error::Error.none;}}return blot_support::some(proof.output),blot_error::Error.none;}
