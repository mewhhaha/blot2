fn mapContexts(self:Scan&,boundary:BindingRef) {if self.contexts.len==0 || self.semantic.invocations.len==0 {self.decline();return;}self.contexts[0]=Context{invocation:0,..};for context,offset in self.runtime.graph.contexts[1..] {let id=offset+1;if !self.step() {return;}if context.parent>=id {self.decline();return;}let parent=self.contexts[context.parent];let parent_function=self.runtime.graph.contexts[context.parent].function;let child_request=self.request(context.function);let receipt=self.receipt(parent_function,context.at);if self.failure!=Error.none {return;}if receipt.present {let site=receipt.value;let invocation=self.semantic.invocations[parent.invocation];let unit .= self.unit(boundary.unit);if !unit {return;}let body .= unit.body(boundary.binding);if !body {self.decline();return;}var parent_target=Site{unit:boundary.unit,binding:boundary.binding,node:body.root};if invocation.callable!=0 {let target=self.semantic.nodes[invocation.callable].target;if !target.present {self.decline();return;}parent_target=target.value;}if site.unit!=parent_target.unit || site.root!=parent_target.node || site.kind!=SemanticKind.call {self.decline();return;}if invocation.callable!=0 {self.sameMappings(site,invocation.callable);}else {self.emptyMappings(site);}if self.failure!=Error.none {return;}var selected=blot_support::none<u32>();for candidate,index in self.semantic.invocations {if !self.step() {return;}if !candidate.parent.present || candidate.parent.value!=parent.invocation || candidate.caller.unit!=site.unit || candidate.caller.binding!=parent_target.binding || candidate.caller.node!=site.node {continue;}if selected.present {self.decline();return;}selected=blot_support::some(index as u32);}if selected.present {let callable=self.semantic.invocations[selected.value].callable;self.target(child_request,callable);self.contexts[id]=Context{invocation:selected.value,callable:blot_support::some(callable),..};}else {let operation=operationKey(child_request);if operation.present {var selected_event=blot_support::none<u32>();for node,index in self.semantic.nodes {if !self.step() {return;}if node.context!=parent.invocation || node.kind!=Kind.event || node.site.unit!=site.unit || node.site.binding!=parent_target.binding || node.site.node!=site.node {continue;}if selected_event.present {self.decline();return;}selected_event=blot_support::some(index as u32);}if !selected_event.present {self.decline();return;}let event=selected_event.value;self.operation(operation.value,event);self.contexts[id]=Context{invocation:parent.invocation,event:blot_support::some(event),..};}else {let callable_key=callableKey(child_request);if !callable_key.present || callable_key.value.applied!=0 {self.decline();return;}var creation=blot_support::none<u32>();for node,index in self.semantic.nodes {if !self.step() {return;}if node.context!=parent.invocation || node.site.unit!=site.unit || node.site.node!=site.node || node.kind!=Kind.callable {continue;}if creation.present {self.decline();return;}creation=blot_support::some(index as u32);}if !creation.present {self.decline();return;}let callable=creation.value;self.target(child_request,callable);self.contexts[id]=Context{invocation:parent.invocation,creation:blot_support::some(callable),callable:blot_support::some(callable),..};}}}else {let parent_request=self.request(parent_function);if self.failure!=Error.none {return;}let parent_key=callableKey(parent_request);let child_key=namedKey(child_request);if !parent_key.present || !child_key.present || !parent.callable.present {self.decline();return;}if parent_key.value.target!=child_key.value.target || parent_key.value.applied+1!=child_key.value.count {self.decline();return;}self.target(child_request,parent.callable.value);self.contexts[id]=parent;}if self.failure!=Error.none {return;}}for invocation,index in self.semantic.invocations {var mapped=false;for context in self.contexts {mapped=mapped || context.invocation==index;}if !mapped {self.decline();return;}}}
