// 16 passes of a 3x3 Gaussian blur over a WxW 8-bit image using a 3-column
// sliding window (3 loads per pixel instead of 9) over byte-packed #[U8] buffers.
import * as rng from "./rng"

const BENCH_N: U32 = 1024 // BENCH_N
const PASSES: U32 = 16

func blur_pass (src: #[U8]) -> (dst: own #[U8]) -> (w: U32): #[U8] =>
  let wm1 = w - 1
  for y in 1 .. wm1:
    let row = y * w
    let up = row - w
    let dn = row + w
    let c0 = src[up].to_u32 + (src[row].to_u32 << 1) + src[dn].to_u32
    let c1 = src[up + 1].to_u32 + (src[row + 1].to_u32 << 1) + src[dn + 1].to_u32
    for x in 1 .. wm1:
      let c2 = src[up + x + 1].to_u32 + (src[row + x + 1].to_u32 << 1) + src[dn + x + 1].to_u32
      dst[row + x] := ((c0 + (c1 << 1) + c2) >> 4).to_u8
      c0 := c1
      c1 := c2
  return dst

io bench (): #[U32] =>
  let total_px = BENCH_N * BENCH_N
  let a: #[U8] = @array.fill total_px (U32.to_u8 0)
  let b: #[U8] = @array.fill total_px (U32.to_u8 0)
  let r: U64 = 12345
  for i in 0 .. total_px:
    r := rng.xs_next self
    a[i] := r.to_u8

  for _ in 0 .. (PASSES / 2):
    b := blur_pass a self BENCH_N
    a := blur_pass b self BENCH_N

  let total: I64 = 0
  for px in a:
    total := self + px.to_i64

  let out: #[U32] = #[]
  out := rng.emit_u32 self BENCH_N
  out := rng.emit_i64 self total
  return out
