fn Engine::argumentTypeNames(self:Engine&,source:u32,depth:i64)->blot_error::Error {if depth>=1024 {return blot_error::Error.type_limit;}let node=self.tree.node(source);if node.tag==blot_parse_ast::tag_type_name {let name=self.pool.get(node.a);if name.len!=0 && ((name[0]>='a' as u8 && name[0]<='z' as u8) || name[0]=='_' as u8) && !firstDot(name).present {return blot_error::Error.none;}for builtin in ["Unit","Bool","U32","F32","Array","List","Cursor","EffectSet","EffectDescriptor"] {if name==builtin {return blot_error::Error.none;}}if !self.catalogs.nominal_names.contains(self.catalogKey(node.a)) {let err=self.diagnostic(Code.unsupported_type,source);if err!=blot_error::Error.none {return err;}self.diagnostics[self.diagnostics.len-1].span.end=self.tree.span(source).start;}return blot_error::Error.none;}if node.tag==blot_parse_ast::tag_group {return self.argumentTypeNames(node.a,depth+1);}if node.tag==blot_parse_ast::tag_type_apply || node.tag==blot_parse_ast::tag_type_function {let err=self.argumentTypeNames(node.a,depth+1);if err!=blot_error::Error.none {return err;}return self.argumentTypeNames(node.b,depth+1);}if node.tag==blot_parse_ast::tag_type_product || node.tag==blot_parse_ast::tag_type_array {for child in self.tree.children(source) {let err=self.argumentTypeNames(child,depth+1);if err!=blot_error::Error.none {return err;}}}else if node.tag==blot_parse_ast::tag_type_record {for child in self.tree.children(source) {let field=self.tree.node(child);if field.b!=0 {let err=self.argumentTypeNames(field.b,depth+1);if err!=blot_error::Error.none {return err;}}}}return blot_error::Error.none;}
