// Generate N s-expressions into a pre-sized byte buffer, parse into a
// compact 8-byte/node AST arena with error checks, then walk 4 times.
import * as rng from "./rng"

const BENCH_N: U32 = 200000 // BENCH_N
const DEPTH: U32 = 4
const PASSES: U32 = 4
const NONE_IDX: U32 = 0x3FFFFFFF

const TAG_SYM: U32 = 0
const TAG_NUM: U32 = 1
const TAG_LIST: U32 = 2

// 8 bytes per node:
//   b = (next << 2) | tag
//   a = (start << 4) | len  for Sym; v for Num; first for List.
type Sexp is data = $Sexp { a: U32, b: U32 }

func emit_sym (text: own #[U8]) -> (sym_seed: U64): #[U8] =>
  let r = sym_seed
  let n = 3 + (r % 12u64).to_u32
  for _ in 0 .. n:
    r := rng.xs_next self
    text := self.push (97 + (r % 26u64).to_u32).to_u8
  return text

func emit_uint (text: own #[U8]) -> (v: U32): #[U8] =>
  if v == 0:
    return text.push '0'
  let digits = @array.fill 8 0u8
  let n: U32 = 0
  let x = v
  for ever:
    if x == 0:
      break
    digits[n] := (48 + (x % 10)).to_u8
    n := self + 1
    x := self / 10
  for ever:
    if n == 0:
      break
    n := self - 1
    text := self.push digits[n]
  return text

func gen_form (text: own #[U8]) -> (d: U32) -> (seed: U64): (#[U8], U64) =>
  let s = rng.xs_next seed
  if d == 0 or (s & 3u64) == 0u64:
    if ((s >> 8u64) & 1u64) == 0u64:
      text := emit_sym self s
    else:
      text := emit_uint self (((s >> 16u64) % 100000u64).to_u32)
    text := self.push ' '
    return (text, s)
  text := self.push '('
  let rem = 2 + ((s >> 24u64) & 3u64).to_u32
  let cur_seed = s
  for _ in 0 .. rem:
    let (t1, s1) = gen_form text (d - 1) cur_seed
    text := t1
    cur_seed := s1
  text := self.push ')'
  text := self.push ' '
  return (text, cur_seed)

func build_text (): #[U8] =>
  let text: #[U8] = Array.with_capacity (BENCH_N * 496)
  let seed: U64 = 12345u64
  for _ in 0 .. BENCH_N:
    let (t1, s1) = gen_form text DEPTH seed
    text := t1
    seed := s1
  return text

func walk_list (pool: #[Sexp]) -> (buf: #[U8]) -> (head: U32) -> (p: U32): U32 =>
  let cur = head
  let acc: U32 = 0
  for ever:
    if cur == NONE_IDX:
      break
    let $Sexp { a, b } = pool[cur]
    let tag = b & 3
    case tag of
      0 =>
        let start = a >> 4
        let slen = a & 15
        acc := self + slen + buf[start].to_u32 + p
      1 =>
        acc := self + (a ^ p)
      _ =>
        acc := self + 1
        if a != NONE_IDX:
          acc := self + walk_list pool buf a p
    cur := b >> 2
  return acc

io bench (): #[U32] =>
  let text = build_text ()
  let text_len = text.length
  let pool: #[Sexp] = Array.with_capacity (BENCH_N * 78)
  let roots: #[U32] = Array.with_capacity BENCH_N
  let st_chain = @array.fill 16 NONE_IDX
  let sp: U32 = 0
  let pos: U32 = 0
  let err_len: U32 = 0

  for ever:
    for ever:
      if pos >= text_len:
        break
      if text[pos] != ' ':
        break
      pos := self + 1
    if pos >= text_len:
      if sp > 0:
        err_len := 8
      break
    let c = text[pos]
    if c == ')':
      if sp == 0:
        err_len := 8
        break
      pos := self + 1
      let first = st_chain[sp]
      sp := self - 1
      let prev = if sp == 0 then NONE_IDX else st_chain[sp]
      let idx = pool.length
      pool := self.push ($Sexp { a: first, b: (prev << 2) | TAG_LIST })
      if sp == 0:
        roots := self.push idx
      else:
        st_chain[sp] := idx
    else:
      if c == '(':
        pos := self + 1
        sp := self + 1
        st_chain[sp] := NONE_IDX
      else:
        let start = pos
        let prev = if sp == 0 then NONE_IDX else st_chain[sp]
        let idx = pool.length
        if c >= '0' and c <= '9':
          let v: U32 = 0
          for ever:
            if pos >= text_len:
              break
            let ch = text[pos]
            if ch >= '0' and ch <= '9':
              v := self * 10 + (ch - '0').to_u32
              pos := self + 1
            else:
              break
          pool := self.push ($Sexp { a: v, b: (prev << 2) | TAG_NUM })
        else:
          for ever:
            if pos >= text_len:
              break
            let ch = text[pos]
            if ch != ' ' and ch != '(' and ch != ')':
              pos := self + 1
            else:
              break
          let slen = pos - start
          pool := self.push ($Sexp { a: (start << 4) | slen, b: (prev << 2) | TAG_SYM })
        if sp == 0:
          roots := self.push idx
        else:
          st_chain[sp] := idx

  let total: I64 = 0i64
  for p in 0 .. PASSES:
    for ri in 0 .. roots.length:
      total := self + (walk_list pool text roots[ri] p).to_i64

  let out: #[U32] = #[]
  out := rng.emit_u32 self text_len
  out := rng.emit_u32 self pool.length
  out := rng.emit_u32 self roots.length
  out := rng.emit_u32 self err_len
  out := rng.emit_i64 self total
  return out
