fn Engine::knownOrFresh(self:Engine&,value:blot_support::Option<u32>)->u32,blot_error::Error {if value.present {return value.value,blot_error::Error.none;}return self.types.fresh();}
fn Engine::stagingApplication(self:Engine&,id:u32)->blot_support::Option<u32>,blot_error::Error {var head=id;var backwards:u32[2]=[0;2];var count:i64=0;while self.tree.node(head).tag==blot_parse_ast::tag_apply {let application=self.tree.node(head);if count<backwards.len {backwards[count]=application.b;}count+=1;head=application.a;}let syntax=self.tree.node(head);if syntax.tag!=blot_parse_ast::tag_intrinsic {return blot_support::none<u32>(),blot_error::Error.none;}let op,known=blot_check_typed_staging::lookup(self.pool.get(syntax.a));if !known {return blot_support::none<u32>(),blot_error::Error.none;}if count!=blot_check_typed_staging::arity(op) {let err=self.diagnostic(Code.call_arity,id);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let root,err=self.types.fresh();return blot_support::some(root),err;}let operand=backwards[count-1];let result,err=stagingApplicationOperation(self,id,op,operand,backwards[..count]);return blot_support::some(result),err;}
fn stagingApplicationOperation(self:Engine&,id:u32,op:blot_check_typed_staging::Op,operand:u32,backwards:const u32[:])->u32,blot_error::Error {
 if op==blot_check_typed_staging::Op.evaluate {let parent=self.ambient;let fresh,err=self.types.freshEffects();if err!=blot_error::Error.none {return 0,err;}self.ambient=fresh;let result,error=stagingEvaluate(self,operand);self.ambient=parent;return result,error;}
 if op==blot_check_typed_staging::Op.quote {if self.staging_depth>=128 {let err=self.diagnostic(Code.staging_budget,id);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}let parent=self.ambient;let fresh,err=self.types.freshEffects();if err!=blot_error::Error.none {return 0,err;}self.ambient=fresh;self.staging_depth+=1;let result,error=stagingQuote(self,id,operand,parent,fresh);self.staging_depth-=1;self.ambient=parent;return result,error;}
 if op==blot_check_typed_staging::Op.splice || op==blot_check_typed_staging::Op.lift {if self.staging_depth==0 {let err=self.diagnostic(Code.stage_unavailable,id);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}let future=self.ambient;let construction,err=self.types.freshEffects();if err!=blot_error::Error.none {return 0,err;}self.ambient=construction;self.staging_depth-=1;let value,error=self.expression(operand);self.staging_depth+=1;self.ambient=future;if error!=blot_error::Error.none {return 0,error;}let err=self.constrainEffects(construction,0,operand);if err!=blot_error::Error.none {return 0,err;}if op==blot_check_typed_staging::Op.lift {let usage,err=blot_check_usage_check::containsNominal(self.types,self.nominals,value);if err!=blot_error::Error.none {return 0,err;}var allowed=false;if !usage {let liftable,err=blot_check_typed_staging::liftable(self.types,value);if err!=blot_error::Error.none {return 0,err;}allowed=liftable;}if !allowed {let err=self.diagnostic(Code.cross_stage_authority,operand);if err!=blot_error::Error.none {return 0,err;}}return value,blot_error::Error.none;}let resolved,err=self.types.resolve(value,0);if err!=blot_error::Error.none {return 0,err;}let code=blot_check_typed_staging::codeInfo(self.types,resolved);if !code.present {let err=self.diagnostic(Code.code_shape_mismatch,operand);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}let err=self.stagingEffects(code.value.effects,id);return code.value.result,err;}
 let value,err=self.expression(operand);if err!=blot_error::Error.none {return 0,err;}if op==blot_check_typed_staging::Op.same {let right,err=self.expression(backwards[0]);if err!=blot_error::Error.none {return 0,err;}let left_resolved,err=self.types.resolve(value,0);if err!=blot_error::Error.none {return 0,err;}let left=blot_check_typed_staging::descriptorInfo(self.types,left_resolved);var valid=left.present;if valid {let right_resolved,err=self.types.resolve(right,0);if err!=blot_error::Error.none {return 0,err;}valid=blot_check_typed_staging::descriptorInfo(self.types,right_resolved).present;}if !valid {let err=self.diagnostic(Code.code_shape_mismatch,id);if err!=blot_error::Error.none {return 0,err;}}return blot_check_types::boolean,blot_error::Error.none;}
 let resolved,err=self.types.resolve(value,0);if err!=blot_error::Error.none {return 0,err;}if op==blot_check_typed_staging::Op.fields {let target=blot_check_typed_staging::descriptorInfo(self.types,resolved);if !target.present {let err=self.diagnostic(Code.code_shape_mismatch,operand);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}return self.descriptorFields(target.value,id);}let code=blot_check_typed_staging::codeInfo(self.types,resolved);if !code.present {let err=self.diagnostic(Code.code_shape_mismatch,operand);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}
 if op==blot_check_typed_staging::Op.describe {let name,error=self.pool.intern("result");if error==blot_error::Error.symbol_limit {return 0,blot_error::Error.type_limit;}if error!=blot_error::Error.none {return 0,error;}let effects,error=self.pool.intern("effects");if error==blot_error::Error.symbol_limit {return 0,blot_error::Error.type_limit;}if error!=blot_error::Error.none {return 0,error;}let descriptor,err=blot_check_typed_staging::descriptor(self.types,code.value.result);if err!=blot_error::Error.none {return 0,err;}let reflection,err=self.reflectionType(false);if err!=blot_error::Error.none {return 0,err;}return self.types.record([blot_check_types::Field{name:name,ty:descriptor},blot_check_types::Field{name:effects,ty:reflection}]);}
 if op==blot_check_typed_staging::Op.run {let resolved,err=self.types.resolveEffects(code.value.effects,0);if err!=blot_error::Error.none {return 0,err;}let latent=self.types.row(resolved);var closed=false;match latent.tail {blot_check_effects::Tail.closed=>{closed=true;},_=>{}}if latent.labels.len!=0 || !closed {let err=self.diagnostic(Code.const_effect,id);if err!=blot_error::Error.none {return 0,err;}}}else {let err=self.stagingEffects(code.value.effects,id);if err!=blot_error::Error.none {return 0,err;}}return code.value.result,blot_error::Error.none;
}
fn stagingEvaluate(self:Engine&,operand:u32)->u32,blot_error::Error {let result,err=self.expression(operand);if err!=blot_error::Error.none {return 0,err;}let err=self.constrainEffects(self.ambient,0,operand);return result,err;}
fn stagingQuote(self:Engine&,id:u32,operand:u32,parent:u32,latent:u32)->u32,blot_error::Error {let result,err=self.expression(operand);if err!=blot_error::Error.none {return 0,err;}let function,err=self.types.functionWithEffects(blot_check_types::unit,result,latent);if err!=blot_error::Error.none {return 0,err;}let certified,err=self.certifiedLambdaType(id,function,parent);if err!=blot_error::Error.none {return 0,err;}let node=self.types.node(certified);let code,err=blot_check_typed_staging::code(self.types,node.b,node.c);if err!=blot_error::Error.none {return 0,err;}let contains,err=blot_check_rank_walk::contains(self.types,code,0,false);if err!=blot_error::Error.none {return 0,err;}if contains {let err=self.diagnostic(Code.cross_stage_authority,id);if err!=blot_error::Error.none {return 0,err;}}return code,blot_error::Error.none;}
type FieldBuffer=blot_support_pooled_buffer::Buffer<blot_check_types::Field>;
fn blot_support_pooled_buffer::append(self:blot_check_check::FieldBuffer&,value:blot_check_types::Field)->blot_error::Error {return blot_support_pooled_buffer::push(self,value,blot_check_check::equation_fields);}
fn Engine::descriptorFields(self:Engine&,original:u32,source:u32)->u32,blot_error::Error {let target,err=self.types.resolve(original,0);if err!=blot_error::Error.none {return 0,err;}let shape=self.types.node(target);var fields=FieldBuffer{};let result,error=descriptorFieldsShape(self,target,shape,source,fields);fields.deinit(equation_fields);return result,error;}
fn descriptorFieldsShape(self:Engine&,target:u32,shape:blot_check_types::Node,source:u32,fields:FieldBuffer&)->u32,blot_error::Error {if shape.tag==blot_check_types::Tag.record {for index in 0..shape.b {let err=fields.append(self.types.recordField(shape,index));if err!=blot_error::Error.none {return 0,err;}}}else if shape.tag==blot_check_types::Tag.nominal {let index=self.nominalIndex(Identity{shape.a,shape.b});if !index.present {let err=self.diagnostic(Code.descriptor_private,source);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}let family=self.nominals[index.value];if family.private || family.is_opaque || family.constructors.len==0 {let err=self.diagnostic(Code.descriptor_private,source);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}let constructors=equation_type_ids.alloc_slice(family.constructors.len);for value,index in self.types.list(family.constructors) {constructors[index]=value;}let complete,err=descriptorFieldsConstructors(self,target,source,constructors,fields);equation_type_ids.free_slice(constructors);if err!=blot_error::Error.none {return 0,err;}if !complete {return self.types.fresh();}}else {let err=self.diagnostic(Code.descriptor_private,source);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}for &field in fields.items {let root,err=self.types.resolve(field.ty,0);if err!=blot_error::Error.none {return 0,err;}let descriptor,err=blot_check_typed_staging::descriptor(self.types,root);if err!=blot_error::Error.none {return 0,err;}field.ty=descriptor;}return self.types.record(fields.items);}
fn descriptorFieldsConstructors(self:Engine&,target:u32,source:u32,constructors:const u32[:],fields:FieldBuffer&)->bool,blot_error::Error {for constructor,variant in constructors {if self.constructors[constructor].scheme.variables.len>32 {let err=self.diagnostic(Code.staging_budget,source);if err!=blot_error::Error.none {return false,err;}fields.clear();return false,blot_error::Error.none;}let instance_type,err=self.constructorStorageType(constructor);if err!=blot_error::Error.none {return false,err;}let instance=self.types.node(instance_type);var payload=blot_check_types::Node{tag:blot_check_types::Tag.record};if instance.tag==blot_check_types::Tag.function {let err=self.constrain(instance.b,target,source);if err!=blot_error::Error.none {return false,err;}let root,err=self.types.resolve(instance.a,0);if err!=blot_error::Error.none {return false,err;}payload=self.types.node(root);}else {let err=self.constrain(instance_type,target,source);if err!=blot_error::Error.none {return false,err;}}if payload.tag!=blot_check_types::Tag.record {fields.clear();break;}if variant==0 {for field in 0..payload.b {let err=fields.append(self.types.recordField(payload,field));if err!=blot_error::Error.none {return false,err;}}continue;}var count:i64=0;for field in fields.items {for index in 0..payload.b {let other=self.types.recordField(payload,index);if other.name!=field.name {continue;}let err=self.constrain(field.ty,other.ty,source);if err!=blot_error::Error.none {return false,err;}fields.items[count]=field;count+=1;break;}}fields.resize(count);}return true,blot_error::Error.none;}
struct LegacyProof {engine:Engine&,evidence:blot_eval_type_evidence::Store,source:u32,remaining:i64&,observed:i64&,budget_slot:u32,budget_generation:u64}
fn LegacyProof::sync(self:LegacyProof&)->blot_error::Error {assert(self.budgetValid());let spent=self.observed-self.remaining;if spent>self.engine.types.projection_limit-self.engine.types.projection_steps {return blot_error::Error.type_limit;}self.engine.types.projection_steps+=spent;self.observed=self.remaining;return blot_error::Error.none;}
fn LegacyProof::refresh(self:LegacyProof&) {assert(self.budgetValid());self.remaining=self.engine.types.projection_limit-self.engine.types.projection_steps;self.observed=self.remaining;}
fn evidenceError(error:blot_error::Error)->blot_error::Error {if error==blot_error::Error.out_of_memory {return error;}if error==blot_error::Error.type_limit {return blot_error::Error.evidence_limit;}return blot_error::Error.type_mismatch;}
struct LegacyResolve {state:LegacyProof&,identity:Identity,member:u32,arguments:const u32[:]}
fn LegacyProof::resolve(self:LegacyProof&,identity:Identity,member:u32,arguments:const u32[:])->u32,blot_error::Error {let err=self.sync();if err!=blot_error::Error.none {return 0,evidenceError(err);}var context=LegacyResolve{self,identity,member,arguments};return blot_eval_closed_evidence_import::withImporter<LegacyResolve,legacyResolveImport,u32>(self.evidence.view(),self.engine.types,context);}
fn legacyResolveImport(context:LegacyResolve&,copy:blot_eval_closed_evidence_import::PooledImporter&)->u32,blot_error::Error {let roots=equation_type_ids.alloc_slice(context.arguments.len);let result,err=legacyResolveArguments(context,copy,roots);equation_type_ids.free_slice(roots);return result,err;}
fn legacyResolveArguments(context:LegacyResolve&,copy:blot_eval_closed_evidence_import::PooledImporter&,roots:u32[:])->u32,blot_error::Error {for argument,index in context.arguments {let root,err=copy.ty(argument,0);if err!=blot_error::Error.none {return 0,evidenceError(err);}roots[index]=root;}let projection,err=context.state.engine.types.projection(context.identity,context.member,roots);if err!=blot_error::Error.none {return 0,evidenceError(err);}let result,err=context.state.engine.normalizeAssociated(projection,context.state.source,true);if err!=blot_error::Error.none {return 0,evidenceError(err);}context.state.refresh();return context.state.evidence.projectWithBudget(context.state.engine.types,result,[],[],context.state.remaining);}
fn LegacyProof::resolver(self:LegacyProof&)->blot_eval_type_evidence::ProjectionResolver<LegacyProof> {return blot_eval_type_evidence::ProjectionResolver<LegacyProof>{context:self,remaining:self.remaining};}
struct LegacyCall {engine:Engine&,predicate:blot_check_types::Obligation&,source:u32}
fn Engine::proveLegacy(self:Engine&,predicate:blot_check_types::Obligation&,source:u32)->bool,blot_error::Error {var call=LegacyCall{self,predicate,source};let result,err=blot_eval_type_evidence::withPooledStoreValue<LegacyCall,proveLegacyWithStore,bool>(call);return result,err;}
fn proveLegacyWithStore(call:LegacyCall&,evidence:blot_eval_type_evidence::Store&)->bool,blot_error::Error {if legacy_budget_generation==0xffffffffffffffff || legacy_budgets.len>=0xffffffff {return false,blot_error::Error.out_of_memory;}let remaining=call.engine.types.projection_limit-call.engine.types.projection_steps;let generation=legacy_budget_generation;legacy_budget_generation+=1;let index=legacy_budgets.alloc_index(LegacyBudget{remaining:remaining,observed:remaining,generation:generation,live:true});var state=LegacyProof{engine:call.engine,evidence:evidence,source:call.source,remaining:legacy_budgets[index].remaining,observed:legacy_budgets[index].observed,budget_slot:index as u32,budget_generation:generation};let result,err=call.engine.proveLegacyState(state,call.predicate,call.source);let sync=state.sync();legacy_budgets[index].live=false;legacy_budgets.free(index);if err!=blot_error::Error.none {return false,err;}return result,sync;}

fn Engine::proveLegacyState(self:Engine&,state:LegacyProof&,predicate:blot_check_types::Obligation&,source:u32)->bool,blot_error::Error {var operands:u32[4]=[0;4];let roots:u32[4]=[predicate.ty,predicate.other,predicate.result,predicate.signature];for root,index in roots {if root==0 {continue;}let normalized,err=self.normalizeAssociated(root,source,true);if err!=blot_error::Error.none {return false,err;}state.refresh();let operand,err=state.evidence.projectWithBudget(self.types,normalized,[],[],state.remaining);if err==blot_error::Error.out_of_memory {return false,err;}if err==blot_error::Error.unresolved_type {let node=self.types.node(self.types.head(root,0));if index==3 && node.tag==blot_check_types::Tag.function && node.a==blot_check_types::unit && node.b==blot_check_types::unit && self.types.rowLabels(node.c).len==0 {var variable=false;match self.types.row(node.c).tail {blot_check_effects::Tail.variable payload=>{variable=true;},_=>{}}if variable {continue;}}return false,blot_error::Error.none;}if err!=blot_error::Error.none {return false,legacyError(err);}operands[index]=operand;let err=state.sync();if err!=blot_error::Error.none {return false,err;}}if predicate.kind==blot_check_types::ObligationKind.field || predicate.kind==blot_check_types::ObligationKind.writable_field {let handled,result,err=legacyField(self,state,predicate,source,operands);if err!=blot_error::Error.none || handled {return result,err;}}var candidates:blot_support::Option<u32>[2]=[blot_support::none<u32>();2];var owner=predicate.ty;var identity=blot_support::none<Identity>();if predicate.kind==blot_check_types::ObligationKind.result_dispatch {owner=predicate.result;}if predicate.kind==blot_check_types::ObligationKind.resolver_dispatch {let resolved,err=self.types.resolve(predicate.ty,0);if err!=blot_error::Error.none {return false,err;}let resolver=self.types.node(resolved);if resolver.tag!=blot_check_types::Tag.resolver {return false,blot_error::Error.none;}let resolved,err=self.types.resolve(resolver.a,0);if err!=blot_error::Error.none {return false,err;}let constructor=self.types.node(resolved);if constructor.tag!=blot_check_types::Tag.type_constructor {return false,blot_error::Error.none;}identity=blot_support::some(Identity{constructor.a,constructor.b});}else {identity=self.identityOf(owner);}if identity.present {candidates[0]=self.legacyCandidate(predicate,identity.value);}if predicate.kind==blot_check_types::ObligationKind.dispatch {let right=self.identityOf(predicate.other);if right.present {candidates[1]=self.legacyCandidate(predicate,right.value);}}for candidate,side in candidates {if side==1 && predicate.kind==blot_check_types::ObligationKind.dispatch && predicate.name==0 {let result,known=blot_eval_implementation_predicates::primitiveResult(state.evidence,predicate.operator,operands[0],operands[1]);if known {if result!=operands[2] {return false,blot_error::Error.none;}var carrier=operands[3];if carrier==0 {let value,err=state.evidence.intern(blot_eval_type_evidence::Tag.function,blot_check_types::unit,blot_check_types::unit,[]);if err!=blot_error::Error.none {return false,legacyError(err);}carrier=value;}let err=state.sync();if err!=blot_error::Error.none {return false,err;}var context=LegacyCarrier{predicate,carrier};let copied,err=blot_eval_closed_evidence_import::withImporter<LegacyCarrier,legacyCarrier,u32>(state.evidence.view(),self.types,context);if err!=blot_error::Error.none {return false,err;}predicate.signature=copied;return true,blot_error::Error.none;}}if !candidate.present {continue;}let prepared,err=self.prepareSelectedGlobal(candidate.value);if err!=blot_error::Error.none {return false,err;}if !prepared {continue;}let result,matched,err=legacyMatchCandidate(self,state,predicate,source,operands,candidate.value);if err!=blot_error::Error.none || matched {return result,err;}}return false,blot_error::Error.none;}
fn Engine::legacyCandidate(self:Engine&,predicate:blot_check_types::Obligation,identity:Identity)->blot_support::Option<u32> {if predicate.name==0 {let ordinal .= self.catalogs.associated_ops.get(AssociatedKey{identity:identity,operator:predicate.operator});if ordinal {return blot_support::some(self.associated[ordinal].binding);}}else {let ordinal .= self.catalogs.associated_members.get(AssociatedMember{identity:identity,member:predicate.name});if ordinal {return blot_support::some(self.associated[ordinal].binding);}}return blot_support::none<u32>();}
struct LegacyCarrier {predicate:blot_check_types::Obligation&,carrier:u32}
fn legacyCarrier(context:LegacyCarrier&,copy:blot_eval_closed_evidence_import::PooledImporter&)->u32,blot_error::Error {return copy.ty(context.carrier,0);}
fn legacyField(self:Engine&,state:LegacyProof&,predicate:blot_check_types::Obligation&,source:u32,operands:u32[4])->bool,bool,blot_error::Error {let record=state.evidence.node(operands[0]);if record.tag==blot_eval_type_evidence::Tag.record {let fields=state.evidence.children(operands[0]);var at:i64=0;while at<fields.len {if fields[at]==predicate.name {return true,fields[at+1]==operands[2],blot_error::Error.none;}at+=2;}}if record.tag==blot_eval_type_evidence::Tag.nominal {let identity=Identity{record.a,record.b};let selected=self.nominalIndex(identity);if !selected.present {return true,false,blot_error::Error.none;}let definition=self.nominals[selected.value];if !definition.is_opaque || definition.identity.unit==self.unit {let constructors=equation_type_ids.alloc_slice(definition.constructors.len);for value,index in self.types.list(definition.constructors) {constructors[index]=value;}let found,compatible,stopped,err=legacyFieldConstructors(self,predicate,source,constructors);equation_type_ids.free_slice(constructors);if err!=blot_error::Error.none || stopped {return true,false,err;}if found {if predicate.kind==blot_check_types::ObligationKind.field && self.catalogs.associated_members.contains(AssociatedMember{identity:identity,member:predicate.name}) {return true,false,blot_error::Error.none;}return true,compatible,blot_error::Error.none;}}}if predicate.kind==blot_check_types::ObligationKind.writable_field {return true,false,blot_error::Error.none;}return false,false,blot_error::Error.none;}
fn legacyFieldConstructors(self:Engine&,predicate:blot_check_types::Obligation,source:u32,constructors:const u32[:])->bool,bool,bool,blot_error::Error {var found=constructors.len!=0;var compatible=true;for constructor in constructors {let allowed,err=self.associatedStep(source);if err!=blot_error::Error.none || !allowed {return false,false,!allowed,err;}let root,err=self.constructorStorageType(constructor);if err!=blot_error::Error.none {return false,false,false,err;}let signature=self.types.node(root);if signature.tag!=blot_check_types::Tag.function {found=false;break;}let err=self.types.unify(signature.b,predicate.ty);if err==blot_error::Error.out_of_memory || err==blot_error::Error.type_limit {return false,false,false,err;}if err!=blot_error::Error.none {found=false;break;}let resolved,err=self.types.resolve(signature.a,0);if err!=blot_error::Error.none {return false,false,false,err;}let payload=self.types.node(resolved);if payload.tag!=blot_check_types::Tag.record {found=false;break;}var field_type:u32=0;for field in 0..payload.b {let allowed,err=self.associatedStep(source);if err!=blot_error::Error.none || !allowed {return false,false,!allowed,err;}let value=self.types.recordField(payload,field);if value.name==predicate.name {field_type=value.ty;break;}}if field_type==0 {found=false;break;}let before,err=self.types.resolve(field_type,0);if err!=blot_error::Error.none {return false,false,false,err;}let after,err=self.types.resolve(predicate.result,0);if err!=blot_error::Error.none {return false,false,false,err;}let equal,err=self.types.equalSymbolic(before,after);if err!=blot_error::Error.none {return false,false,false,err;}if !equal {compatible=false;}}return found,compatible,false,blot_error::Error.none;}
fn legacyMatchCandidate(self:Engine&,state:LegacyProof&,predicate:blot_check_types::Obligation&,source:u32,operands:u32[4],binding:u32)->bool,bool,blot_error::Error {let principal=self.bindings[binding].scheme;state.refresh();var mappings=blot_eval_type_evidence::PooledMappings{};var rows=blot_eval_type_evidence::PooledRows{};var certificates=IdBuffer{};let clauses=equation_values.alloc_slice(principal.obligations.len);for value,index in self.obligations[principal.obligations.start..principal.obligations.start+principal.obligations.len] {clauses[index]=value;}let result,matched,err=legacyMatchCandidateBody(self,state,predicate,source,operands,binding,principal,mappings,rows,certificates,clauses);equation_values.free_slice(clauses);certificates.deinit(equation_type_ids);rows.deinit();mappings.deinit();return result,matched,err;}
fn legacyMatchCandidateBody(self:Engine&,state:LegacyProof&,predicate:blot_check_types::Obligation&,source:u32,operands:u32[4],binding:u32,principal:blot_check_types::Scheme,mappings:blot_eval_type_evidence::PooledMappings&,rows:blot_eval_type_evidence::PooledRows&,certificates:IdBuffer&,clauses:blot_check_types::Obligation[:])->bool,bool,blot_error::Error {var arity:i64=2;if predicate.kind==blot_check_types::ObligationKind.field || predicate.kind==blot_check_types::ObligationKind.writable_field || predicate.kind==blot_check_types::ObligationKind.result_dispatch {arity=1;}var carrier:u32=0;var resolver=state.resolver();if predicate.kind==blot_check_types::ObligationKind.resolver_dispatch {let matched,err=state.evidence.matchLegacySignature(self.types,principal.root,operands[1],mappings,rows,resolver);if err==blot_error::Error.out_of_memory {return false,true,err;}if err==blot_error::Error.type_mismatch || err==blot_error::Error.unresolved_type {return false,true,blot_error::Error.none;}if err!=blot_error::Error.none {return false,true,legacyError(err);}if !matched {return false,false,blot_error::Error.none;}}else {let result,matched,err=state.evidence.matchPrerequisite(self.types,principal.root,operands,arity,mappings,rows,resolver);if err==blot_error::Error.out_of_memory {return false,true,err;}if err==blot_error::Error.type_mismatch || err==blot_error::Error.unresolved_type {return false,true,blot_error::Error.none;}if err!=blot_error::Error.none {return false,true,legacyError(err);}if !matched {return false,false,blot_error::Error.none;}carrier=result;}for mapping in mappings.items {if !inList(self.types.list(principal.variables),mapping.variable) {return false,true,blot_error::Error.none;}}for value in self.types.list(principal.closed_rows) {let err=certificates.append(value);if err!=blot_error::Error.none {return false,true,err;}}for certificate in self.body_closed_rows {if certificate.owner==binding {let err=certificates.append(certificate.variable);if err!=bl