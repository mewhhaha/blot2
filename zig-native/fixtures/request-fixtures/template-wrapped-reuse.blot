type Tick is effect = { read: Unit -> U32 }
const make = fn action => @computation (fn () => action ())
const whole = fn computation => do:
  for request in @requests computation:
    case request of
      effect Tick.read () =>
        break 20
      complete value =>
        break value
const floating = fn computation => do:
  for request in @requests computation:
    case request of
      effect Tick.read () =>
        break 22.5
      complete value =>
        break value
entry const answer = fn () => do:
  let value = 41
  let computation = make (fn () => do:
    use Tick.read ()
    break @panic "cancelled generic computation continued"
  )
  let alias = computation
  value := 99
  let left = whole computation
  let right = floating alias
  break @f32.add (@u32.to_f32 left) right
entry const folded = answer ()
