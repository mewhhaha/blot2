// Pure entry constructors retain caller roots without recursive local bindings.
fn packageAdmission(remaining:i64&,workspace:Workspace?=null)->Admission {return Admission{workspace:workspace,remaining:remaining, ..};}
// An inactive caller workspace keeps only owned proof state across this invocation.
