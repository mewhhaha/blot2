// Bounded scalar wrapping sums combine only when every eliminated local is private.
namespace blot_backend_wasm_row_reduce;
import .runtime_ir;
import .wasm;
import .optimizer_buffers;
import support.error;
import support.option;
type Error=blot_error::Error;
type Instruction=blot_backend_runtime_ir::Instruction;
type Op=blot_backend_runtime_ir::Op;
type Output=blot_backend_runtime_ir::DetachedBody;
type Code=blot_backend_optimizer_buffers::Code;
type Types=blot_backend_optimizer_buffers::Types;
struct Uses {reads:u8=0,writes:u8=0}
struct Plan {end:i64,accumulator:u32,base:u32,result:u32,offset:u32,words:u32}
reusable[] var use_runs:Uses[>..]=[];
fn I(op:Op,operand:u32=0)->Instruction {return Instruction{op:op,operand:operand,..};}
fn isInst(inst:Instruction,op:Op,operand:u32)->bool {return inst.op==op && inst.operand==operand;}
fn privateLocal(uses:const Uses[:],id:u32)->bool {return id<uses.len && uses[id].reads==1 && uses[id].writes==1;}
fn contiguous(offsets:const u32[:])->blot_support::Option<u32> {var first=offsets[0];for offset in offsets {first=min(first,offset);}var seen:u16=0;for offset in offsets {let difference=offset-first;if difference%4!=0 || difference/4>=offsets.len {return blot_support::none<u32>();}let bit=1 as u16<<(difference/4);if seen&bit!=0 {return blot_support::none<u32>();}seen|=bit;}return blot_support::some(first);}
fn findPlan(source:const Instruction[:],at:i64,uses:const Uses[:])->blot_support::Option<Plan> {if at>source.len || source.len-at<13 || source[at].op!=blot_backend_runtime_ir::OP_local_get || source[at+1].op!=blot_backend_runtime_ir::OP_local_set {return blot_support::none<Plan>();}let accumulator=source[at].operand;var carry=source[at+1].operand;let base=source[at+2].operand;var cursor=at+2;var offsets:u32[16]=[0;16];var count:i64=0;while count<offsets.len && cursor<=source.len && source.len-cursor>=11 {let part=source[cursor..cursor+11];if !isInst(part[0],blot_backend_runtime_ir::OP_local_get,base) || part[1].op!=blot_backend_runtime_ir::OP_i32_load || part[2].op!=blot_backend_runtime_ir::OP_local_set || !isInst(part[3],blot_backend_runtime_ir::OP_local_get,carry) || part[4].op!=blot_backend_runtime_ir::OP_local_set || !isInst(part[5],blot_backend_runtime_ir::OP_local_get,part[2].operand) || part[6].op!=blot_backend_runtime_ir::OP_local_set || !isInst(part[7],blot_backend_runtime_ir::OP_local_get,part[4].operand) || !isInst(part[8],blot_backend_runtime_ir::OP_local_get,part[6].operand) || part[9].op!=blot_backend_runtime_ir::OP_i32_add || part[10].op!=blot_backend_runtime_ir::OP_local_set {break;}if !privateLocal(uses,carry) || !privateLocal(uses,part[2].operand) || !privateLocal(uses,part[4].operand) || !privateLocal(uses,part[6].operand) {break;}offsets[count]=part[1].operand;count+=1;cursor+=11;carry=part[10].operand;}if count<8 {return blot_support::none<Plan>();}let first=contiguous(offsets[..count]);if !first.present {return blot_support::none<Plan>();}return blot_support::some(Plan{end:cursor,accumulator:accumulator,base:base,result:carry,offset:first.value,words:count as u32,..});}
fn eagerPrefix(source:const Instruction[:],at:i64)->bool {if at>source.len || source.len-at<24 {return false;}let base=source[at].operand;for index in 0..8 {let part=source[at+index*3..at+index*3+3];if !isInst(part[0],blot_backend_runtime_ir::OP_local_get,base) || part[1].op!=blot_backend_runtime_ir::OP_i32_load || part[2].op!=blot_backend_runtime_ir::OP_local_set {return false;}}return true;}
fn matchEager(source:const Instruction[:],at:i64,uses:const Uses[:])->blot_support::Option<Plan> {if !eagerPrefix(source,at) {return blot_support::none<Plan>();}let base=source[at].operand;var values:u32[16]=[0;16];var offsets:u32[16]=[0;16];var count:i64=0;var cursor=at;while count<values.len && cursor<=source.len && source.len-cursor>=3 {let part=source[cursor..cursor+3];if !isInst(part[0],blot_backend_runtime_ir::OP_local_get,base) || part[1].op!=blot_backend_runtime_ir::OP_i32_load || part[2].op!=blot_backend_runtime_ir::OP_local_set {break;}if !privateLocal(uses,part[2].operand) {return blot_support::none<Plan>();}values[count]=part[2].operand;offsets[count]=part[1].operand;count+=1;cursor+=3;}if count<8 || source.len-cursor<12 {return blot_support::none<Plan>();}let first=contiguous(offsets[..count]);if !first.present {return blot_support::none<Plan>();}let head=source[cursor..cursor+12];if head[0].op!=blot_backend_runtime_ir::OP_local_get || head[1].op!=blot_backend_runtime_ir::OP_local_set || !isInst(head[2],blot_backend_runtime_ir::OP_local_get,values[0]) || head[3].op!=blot_backend_runtime_ir::OP_local_set || !isInst(head[4],blot_backend_runtime_ir::OP_local_get,head[1].operand) || head[5].op!=blot_backend_runtime_ir::OP_local_set || !isInst(head[6],blot_backend_runtime_ir::OP_local_get,head[3].operand) || head[7].op!=blot_backend_runtime_ir::OP_local_set || !isInst(head[8],blot_backend_runtime_ir::OP_local_get,head[5].operand) || !isInst(head[9],blot_backend_runtime_ir::OP_local_get,head[7].operand) || head[10].op!=blot_backend_runtime_ir::OP_i32_add || head[11].op!=blot_backend_runtime_ir::OP_local_set {return blot_support::none<Plan>();}for index in [1,3,5,7] {if !privateLocal(uses,head[index].operand) {return blot_support::none<Plan>();}}var carry=head[11].operand;cursor+=12;for value in values[1..count] {if source.len-cursor<10 || !privateLocal(uses,carry) {return blot_support::none<Plan>();}let part=source[cursor..cursor+10];if !isInst(part[0],blot_backend_runtime_ir::OP_local_get,value) || part[1].op!=blot_backend_runtime_ir::OP_local_set || !isInst(part[2],blot_backend_runtime_ir::OP_local_get,carry) || part[3].op!=blot_backend_runtime_ir::OP_local_set || !isInst(part[4],blot_backend_runtime_ir::OP_local_get,part[1].operand) || part[5].op!=blot_backend_runtime_ir::OP_local_set || !isInst(part[6],blot_backend_runtime_ir::OP_local_get,part[3].operand) || !isInst(part[7],blot_backend_runtime_ir::OP_local_get,part[5].operand) || part[8].op!=blot_backend_runtime_ir::OP_i32_add || part[9].op!=blot_backend_runtime_ir::OP_local_set {return blot_support::none<Plan>();}for index in [1,3,5] {if !privateLocal(uses,part[index].operand) {return blot_support::none<Plan>();}}carry=part[9].operand;cursor+=10;}return blot_support::some(Plan{end:cursor,accumulator:head[0].operand,base:base,result:carry,offset:first.value,words:count as u32,..});}
fn emit(out:Code&,plan:Plan,vector:u32)->Error {let error=out.push(I(blot_backend_runtime_ir::OP_local_get,plan.accumulator));if error!=Error.none {return error;}let groups=plan.words/4;for group in 0..groups {let error=out.append([I(blot_backend_runtime_ir::OP_local_get,plan.base),I(blot_backend_runtime_ir::OP_v128_load,plan.offset+group as u32*16)]);if error!=Error.none {return error;}if group!=0 {let error=out.push(I(blot_backend_runtime_ir::OP_i32x4_add));if error!=Error.none {return error;}}}let error=out.push(I(blot_backend_runtime_ir::OP_local_set,vector));if error!=Error.none {return error;}for lane in 0..4 {let error=out.append([I(blot_backend_runtime_ir::OP_local_get,vector),I(blot_backend_runtime_ir::OP_i32x4_extract_lane,lane as u32),I(blot_backend_runtime_ir::OP_i32_add)]);if error!=Error.none {return error;}}for word in groups*4..plan.words {let error=out.append([I(blot_backend_runtime_ir::OP_local_get,plan.base),I(blot_backend_runtime_ir::OP_i32_load,plan.offset+word as u32*4),I(blot_backend_runtime_ir::OP_i32_add)]);if error!=Error.none {return error;}}return out.push(I(blot_backend_runtime_ir::OP_local_set,plan.result));}
fn run(module:const blot_backend_wasm::Module&,function:const blot_backend_runtime_ir::Function&)->blot_support::Option<Output>,Error {let source=module.instructions(function);if source.len<90 {return blot_support::none<Output>(),Error.none;}var possible=false;for at in 0..source.len-3 {if (source[at].op==blot_backend_runtime_ir::OP_local_get && source[at+1].op==blot_backend_runtime_ir::OP_local_set && source[at+2].op==blot_backend_runtime_ir::OP_local_get && source[at+3].op==blot_backend_runtime_ir::OP_i32_load) || eagerPrefix(source,at) {possible=true;break;}}if !possible {return blot_support::none<Output>(),Error.none;}let locals=module.locals(function);if locals.len>0x7fffffffffffffff-function.parameters.len {return blot_support::none<Output>(),Error.none;}let count=function.parameters.len+locals.len;if count>65536 {return blot_support::none<Output>(),Error.none;}let uses=use_runs.alloc_slice(count);for &use in uses {use=Uses{..};}for inst in source {match inst.op {blot_backend_runtime_ir::OP_local_get=>{if uses[inst.operand].reads!=255 {uses[inst.operand].reads+=1;}},blot_backend_runtime_ir::OP_local_set,blot_backend_runtime_ir::OP_local_tee=>{if uses[inst.operand].writes!=255 {uses[inst.operand].writes+=1;}},_=>{},}}var copied=Types{..};var out=Code{..};let changed,error=build(source,locals,count,uses,copied,out);use_runs.free_slice(uses);return blot_backend_optimizer_buffers::finishOptional(copied,out,changed,error);}
fn build(source:const Instruction[:],original:const blot_backend_runtime_ir::ValueType[:],count:i64,uses:const Uses[:],locals:Types&,out:Code&)->bool,Error {var changed=false;var copied:i64=0;var at:i64=0;while at<=source.len && source.len-at>=90 {var selected=findPlan(source,at,uses);if !selected.present {selected=matchEager(source,at,uses);}if !selected.present {at+=1;continue;}let plan=selected.value;if !changed {let error=locals.append(original);if error!=Error.none {return false,error;}let error=locals.push(blot_backend_runtime_ir::VT_v128);if error!=Error.none {return false,error;}changed=true;}let error=out.append(source[copied..at]);if error!=Error.none {return false,error;}let error=emit(out,plan,count as u32);if error!=Error.none {return false,error;}copied=plan.end;at=plan.end;}if !changed {return false,Error.none;}let error=out.append(source[copied..]);return true,error;}
