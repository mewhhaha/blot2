import .frozen_core_validation;
import support.structural;
import .check;
type Error = blot_error::Error;
type Module = blot_check_core::Module;
type Tag = blot_check_core::Tag;
type TypeTag = blot_check_types::Tag;
type Op = blot_check_core::Op;
type Term = blot_check_numeric_proof_terms::Term;
type TermTag = blot_check_numeric_proof_terms::Tag;
type TermKind = blot_check_numeric_proof_terms::Kind;
type Proposition = blot_check_numeric_proof_terms::Proposition;
type Relation = blot_check_numeric_proof_terms::Relation;
type Header = blot_check_numeric_proof_headers::Owned;
type Options = blot_check_numeric_proof_terms::Limits;
struct Value { operand: u32 = 0, proof: blot_support::Option<Proposition>   = blot_support::none<Proposition>(), condition: u32 = 0, exits: bool = false }
struct Entry { binding: u32, value: Value }
struct Return { target: u32, value: Value }
enum Fact { order { value: Proposition }, unequal { value: blot_check_numeric_proof_contracts::Unequal } }
struct Condition { op: Op = blot_check_core::Op.none, negated: bool = false, left: u32 = 0, right: u32 = 0, positive: blot_support::Option<Fact>   = blot_support::none<Fact>(), negative: blot_support::Option<Fact>   = blot_support::none<Fact>() }
enum SummaryInputs { parameters { bindings: const blot_check_core::Parameter[:], values: const Value[:] }, captures { entries: const Entry[:] }, locals { entries: const Entry[:], parent: const SummaryInputs& } }
recursive fn lookup(self_: SummaryInputs, binding: u32) -> blot_support::Option<Value> {
    match self_ {
        parameters input => { for parameter, index in input.bindings { if parameter.binding == binding { return blot_support::some(input.values[index]); } } },
        captures input => { var index = input.entries.len; while index != 0 { index -= 1; if input.entries[index].binding == binding { return blot_support::some(input.entries[index].value); } } },
        locals input => { var index = input.entries.len; while index != 0 { index -= 1; if input.entries[index].binding == binding { return blot_support::some(input.entries[index].value); } } return input.parent.lookup(binding); },
    } return blot_support::none<Value>();
}
struct PlanCheck { seen: bool = false, admitted: bool = false }
struct PlanLease { live: bool = false, generation: u64 = 0 }
reusable[] var plan_checks: PlanCheck[>..];
var plan_leases: PlanLease[>..<];
struct Plan { checks: PlanCheck[:] = default<PlanCheck[:]>(), visits: i64 = 0, lease: i64 = -1, generation: u64 = 0 }
fn plan(module: const Module&) -> Plan { var index: i64 = 0; while index < plan_leases.len && plan_leases[index].live { index += 1; } if index == plan_leases.len { plan_leases.push(PlanLease {..}); } plan_leases[index].generation += 1; plan_leases[index].live = true; let checks = plan_checks.alloc_slice(module.nodes.len); for &check in checks { check = PlanCheck {..}; } return Plan { checks: checks, lease: index, generation: plan_leases[index].generation , ..}; }
fn deinit(self_: Plan&) { if self_.lease >= 0 && self_.lease < plan_leases.len && plan_leases[self_.lease].live && plan_leases[self_.lease].generation == self_.generation { plan_checks.free_slice(self_.checks); plan_leases[self_.lease].live = false; } self_.checks = default<blot_check_numeric_proof_core::PlanCheck[:]>(); self_.lease = -1; }
fn admits(self_: const Plan&, id: u32) -> bool { return id < self_.checks.len && self_.checks[id].seen && self_.checks[id].admitted; }
fn record(self_: Plan&, id: u32, admitted: bool) -> Error { if id >= self_.checks.len { return blot_error::Error.invalid_artifact; } let entry .= self_.checks[id]; if !entry.seen { entry.seen = true; entry.admitted = true; } entry.admitted = entry.admitted && admitted; return blot_error::Error.none; }
fn clear(self_: Plan&) { for &entry in self_.checks { entry = PlanCheck {..}; } }
fn kind(tag: TypeTag) -> blot_support::Option<TermKind> { match tag { unsigned32 => { return blot_support::some(blot_check_numeric_proof_terms::Kind.unsigned32); }, array => { return blot_support::some(blot_check_numeric_proof_terms::Kind.array); }, list => { return blot_support::some(blot_check_numeric_proof_terms::Kind.list); }, _ => { return blot_support::none<TermKind>(); }, } }
fn opaqueReferenceConstructor(module: const Module&, catalog: u32) -> bool { if catalog >= module.constructors.len { return false; } let constructor = module.constructor(catalog); if constructor.nominal >= module.nominals.len { return false; } let nominal = module.nominal(constructor.nominal); let constructors = module.nominalConstructors(constructor.nominal); return nominal.is_opaque && !nominal.affine && !nominal.has_usage && nominal.storage.kind == blot_backend_opaque_storage::Kind.reference && constructors.len == 1 && constructors[0] == catalog; }
fn opaqueReferenceBinding(module: const Module&, id: u32) -> blot_support::Option<u32> { let pattern = module.pattern(id); if pattern.tag != blot_check_core::PatternTag.constructor || pattern.b == 0 || !opaqueReferenceConstructor(module, pattern.a) { return blot_support::none<u32>(); } let payload = module.pattern(pattern.b); if payload.tag == blot_check_core::PatternTag.bind && payload.a != 0 { return blot_support::some(payload.a); } return blot_support::none<u32>(); }
fn opaqueReferenceResult(module: const Module&, binding: u32, arguments: i64) -> bool { if binding == 0 || binding >= module.bindings.len { return false; } var ty = module.bindings[binding].ty; var wrappers: i64 = 0; while module.types.node(ty).tag == blot_check_types::Tag.forall { if wrappers == 128 { return false; } wrappers += 1; ty = module.types.node(ty).a; } for ignored in 0..arguments { let node = module.types.node(ty); if node.tag != blot_check_types::Tag.function { return false; } ty = node.b; } let result = module.types.node(ty); if result.tag != blot_check_types::Tag.nominal { return false; } for nominal, index in module.nominals { if nominal.identity.unit == result.a && nominal.identity.decl == result.b { let constructors = module.nominalConstructors(index as u32); return constructors.len == 1 && opaqueReferenceConstructor(module, constructors[0]); } } return false; }
fn contract(module: const Module&, binding: u32) -> const Header? { for &value in module.proof_contracts { if value.binding == binding { return value.header; } } return null; }
fn resolved(source: const blot_check_types::Store&, id: u32) -> u32 { return source.head(id, 0); }
fn resolved(source: const blot_check_core::Types&, id: u32) -> u32 { return id; }
fn resolved(source: blot_check_frozen_types::Source, id: u32) -> u32 { return source.head(id, 0); }
fn signatureTypes(source, root: u32, header: Header) -> Error { var ty = root; var wrappers: i64 = 0; while source.node(resolved(source, ty)).tag == blot_check_types::Tag.forall { if wrappers == 128 { return blot_error::Error.invalid_artifact; } wrappers += 1; ty = source.node(resolved(source, ty)).a; } var value_slot: i64 = 0; var proof_slot: i64 = 0;
    for slot in 0..header.arity { let arrow = source.node(resolved(source, ty)); if arrow.tag != blot_check_types::Tag.function { return blot_error::Error.invalid_artifact; } let input = source.node(resolved(source, arrow.a)).tag; let expected = kind(input); if expected.present { if value_slot >= header.value_slots.len || value_slot >= header.values.len || header.value_slots[value_slot] != slot || header.values[value_slot] != expected.value { return blot_error::Error.invalid_artifact; } value_slot += 1; } else if input == blot_check_types::Tag.erased_proof { if proof_slot >= header.proof_slots.len || header.proof_slots[proof_slot] != slot { return blot_error::Error.invalid_artifact; } proof_slot += 1; } ty = arrow.b; }
    if value_slot != header.value_slots.len || proof_slot != header.proof_slots.len || (source.node(resolved(source, ty)).tag == blot_check_types::Tag.erased_proof) != header.result.present { return blot_error::Error.invalid_artifact; } return blot_error::Error.none;
}
fn dataTypes(source, nodes: const blot_check_types::Node[:]) -> Error { for node in nodes { match node.tag {
    array, list, cursor, resolver, provider => { if source.node(node.a).tag == blot_check_types::Tag.erased_proof { return blot_error::Error.invalid_artifact; } },
    state_provider => { for child in [node.a, node.b, node.c] { if source.node(child).tag == blot_check_types::Tag.erased_proof { return blot_error::Error.invalid_artifact; } } },
    product => { for child in source.list(blot_check_types::List { node.a, node.b , ..}) { if source.node(child).tag == blot_check_types::Tag.erased_proof { return blot_error::Error.invalid_artifact; } } },
    record => { for field in 0..node.b { if source.node(source.recordField(node, field).ty).tag == blot_check_types::Tag.erased_proof { return blot_error::Error.invalid_artifact; } } },
    nominal, projection => { for child in source.nominalArguments(node) { if source.node(child).tag == blot_check_types::Tag.erased_proof { return blot_error::Error.invalid_artifact; } } }, _ => {},
    } } return blot_error::Error.none;
}
struct Selected { node: u32, target: blot_check_core::BindingRef }
struct Loop { source: u32, previous: Loop?, breaks: bool = false }
struct Target { module: const Module&, binding: u32 }
type Entries=blot_support_pooled_buffer::Buffer<Entry>;
type Returns=blot_support_pooled_buffer::Buffer<Return>;
type Facts=blot_support_pooled_buffer::Buffer<Fact>;
type Values=blot_support_pooled_buffer::Buffer<Value>;
type Ids=blot_support_pooled_buffer::Buffer<u32>;
reusable[] var entry_scratch:Entry[>..];
reusable[] var return_scratch:Return[>..];
reusable[] var fact_scratch:Fact[>..];
reusable[] var value_scratch:Value[>..];
reusable[] var id_scratch:u32[>..];
struct Checker {
    selected: const Selected[:] = default<const Selected[:]>(), module: const Module&, units: const ModuleRef[:], values: blot_check_numeric_proof_terms::Store,
    environment: Entries&, returns: Returns&, plan: Plan? = null, facts: Facts&, conditions: Condition[>..<]&,
    degraded: bool = false, event: u32 = 0, loop_: Loop? = null
}
fn owner(self_: const Checker&, unit: u32) -> const Module?, Error { if unit == 0 || unit == self_.module.unit { return self_.module, blot_error::Error.none; } for module_owner_ref in self_.units { let module: const blot_check_core::Module&  = module_owner_ref.value; if module.unit == unit { return module, blot_error::Error.none; } } return null, blot_error::Error.invalid_artifact; }
fn target(self_: const Checker&, raw: blot_check_core::BindingRef) -> Target, Error { let initial, err = self_.owner(raw.unit); if err != blot_error::Error.none { return Target { self_.module, 0 , ..}, err; } var module: const Module&  = initial; var binding = raw.binding; for ignored in 0..128 { if binding == 0 || binding >= module.bindings.len { return Target { self_.module, 0 , ..}, blot_error::Error.invalid_artifact; } let value = module.bindings[binding]; if value.kind != blot_reuse_principal_interface::Kind.external { return Target { module, binding , ..}, blot_error::Error.none; } if value.target.unit != 0 && value.target.unit != module.unit { let next, err = self_.owner(value.target.unit); if err != blot_error::Error.none { return Target { self_.module, 0 , ..}, err; } module .= next; } binding = value.target.binding; } return Target { self_.module, 0 , ..}, blot_error::Error.invalid_artifact; }
fn lookup(self_: const Checker&, binding: u32) -> blot_support::Option<Value> { var index = self_.environment.items.len; while index != 0 { index -= 1; let entry = self_.environment.items[index]; if entry.binding == binding { return blot_support::some(entry.value); } } return blot_support::none<Value>(); }
fn bind(self_: Checker&, binding: u32, value: Value) -> Error { let err = self_.values.charge(1); if err != blot_error::Error.none { return err; } if self_.environment.items.len >= self_.values.limits.terms { return blot_error::Error.proof_analysis_limit; } return blot_support_pooled_buffer::push(self_.environment,Entry { binding, value , ..},entry_scratch); }
fn version(self_: Checker&, ty: u32, binding: u32) -> Value, Error { let operand_kind = kind(self_.module.types.node(ty).tag); if !operand_kind.present { return Value {..}, blot_error::Error.none; } var term = Term { tag: blot_check_numeric_proof_terms::Tag.version, kind: operand_kind.value, a: binding, b: 1 , ..}; if binding == 0 { if self_.event == 0xffffffff { return Value {..}, blot_error::Error.proof_analysis_limit; } self_.event += 1; term.a = self_.event; term.b = 2; } let operand, err = self_.values.intern(term); return Value { operand: operand , ..}, err; }
fn ordinary(value: Value) -> Error { if value.proof.present { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; }
fn proof(self_: Checker&, actual: blot_support::Option<Proposition>, expected: Proposition) -> Error { if !actual.present { return blot_error::Error.invalid_artifact; } if actual.value == expected { return blot_error::Error.none; } let entailed, err = blot_check_numeric_proof_contracts::entails(self_.values, [actual.value], expected); if err != blot_error::Error.none { return err; } if !entailed { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; }
fn factEqual(left: Fact, right: Fact) -> bool { match left { order a => { match right { order b => { return a.value == b.value; }, _ => { return false; }, } }, unequal a => { match right { unequal b => { return a.value == b.value; }, _ => { return false; }, } }, } }
fn fact(self_: Checker&, value: Fact) -> Error { if !self_.plan || self_.degraded { return blot_error::Error.none; } for prior in self_.facts.items { if factEqual(prior, value) { return blot_error::Error.none; } } if self_.facts.items.len >= 256 { return blot_error::Error.none; } let err = self_.values.charge(1); if err != blot_error::Error.none { return err; } return blot_support_pooled_buffer::push(self_.facts,value,fact_scratch); }
fn query(self_: Checker&, goal: Proposition) -> bool, Error { if !self_.plan || self_.degraded { return false, blot_error::Error.none; } var ordered: Proposition[256]; var unequal: blot_check_numeric_proof_contracts::Unequal[256]; var order_count: i64 = 0; var unequal_count: i64 = 0; for item in self_.facts.items { match item { order payload => { ordered[order_count] = payload.value; order_count += 1; }, unequal payload => { unequal[unequal_count] = payload.value; unequal_count += 1; }, } } let result, err = blot_check_numeric_proof_contracts::entailsWithUnequal(self_.values, ordered[..order_count], unequal[..unequal_count], goal); if err == blot_error::Error.out_of_memory { return false, err; } if err == blot_error::Error.proof_analysis_limit { self_.degraded = true; } if err != blot_error::Error.none { return false, blot_error::Error.none; } return result, blot_error::Error.none; }
fn condition(self_: Checker&, value: Condition) -> u32, Error { if !self_.plan { return 0, blot_error::Error.none; } let err = self_.values.charge(1); if err != blot_error::Error.none { return 0, err; } if self_.conditions.len >= self_.values.limits.terms { return 0, blot_error::Error.proof_analysis_limit; } self_.conditions.push(value); return self_.conditions.len as u32, blot_error::Error.none; }
fn length(self_: Checker&, value: Value) -> u32, Error { if value.operand == 0 { return 0, blot_error::Error.invalid_proof_operand; } return self_.values.intern(Term { tag: blot_check_numeric_proof_terms::Tag.length, a: value.operand , ..}); }
fn order(self_: Checker&, relation: Relation, left: u32, right: u32) -> Error { return self_.fact(Fact.order { Proposition { relation, left, right } , ..}); }
fn preserveLength(self_: Checker&, id: u32, input: Value) -> Value, Error { let result, err = self_.version(self_.module.typeOf(id), 0); if err != blot_error::Error.none { return result, err; } if result.operand != 0 && input.operand != 0 { let left, err = self_.length(result); if err != blot_error::Error.none { return result, err; } let right, err = self_.length(input); if err != blot_error::Error.none { return result, err; } let err = self_.order(blot_check_numeric_proof_terms::Relation.eq, left, right); if err != blot_error::Error.none { return result, err; } } return result, blot_error::Error.none; }
fn arithmeticIdentity(self_: Checker&, op: Op, left: u32, right: u32) -> u32, Error { if left == 0 || right == 0 { return 0, blot_error::Error.none; } let lhs, err = self_.values.view().get(left); if err != blot_error::Error.none { return 0, err; } let rhs, err = self_.values.view().get(right); if err != blot_error::Error.none { return 0, err; } if lhs.kind != blot_check_numeric_proof_terms::Kind.unsigned32 || rhs.kind != blot_check_numeric_proof_terms::Kind.unsigned32 { return 0, blot_error::Error.none; }
    match op {
        add, sub, bit_or, bit_xor => { if rhs.tag == blot_check_numeric_proof_terms::Tag.literal && rhs.a == 0 { return left, blot_error::Error.none; } if op != blot_check_core::Op.sub && lhs.tag == blot_check_numeric_proof_terms::Tag.literal && lhs.a == 0 { return right, blot_error::Error.none; } if (op == blot_check_core::Op.sub || op == blot_check_core::Op.bit_xor) && left == right { return self_.values.intern(Term { tag: blot_check_numeric_proof_terms::Tag.literal, a: 0 , ..}); } if op == blot_check_core::Op.bit_or && left == right { return left, blot_error::Error.none; } },
        mul, div => { if rhs.tag == blot_check_numeric_proof_terms::Tag.literal && rhs.a == 1 { return left, blot_error::Error.none; } if op == blot_check_core::Op.mul && lhs.tag == blot_check_numeric_proof_terms::Tag.literal && lhs.a == 1 { return right, blot_error::Error.none; } },
        bit_and => { if rhs.tag == blot_check_numeric_proof_terms::Tag.literal && rhs.a == 0xffffffff { return left, blot_error::Error.none; } if lhs.tag == blot_check_numeric_proof_terms::Tag.literal && lhs.a == 0xffffffff { return right, blot_error::Error.none; } if left == right { return left, blot_error::Error.none; } },
        shift_left, shift_right => { if rhs.tag == blot_check_numeric_proof_terms::Tag.literal && rhs.a & 31 == 0 { return left, blot_error::Error.none; } }, _ => {},
    } return 0, blot_error::Error.none;
}
fn arithmetic(self_: Checker&, id: u32, op: Op, left: Value, right: Value) -> Value, Error {
    let lhs, err = self_.values.view().get(left.operand); if err != blot_error::Error.none { return Value {..}, err; } let rhs, err = self_.values.view().get(right.operand); if err != blot_error::Error.none { return Value {..}, err; }
    if lhs.tag == blot_check_numeric_proof_terms::Tag.literal && rhs.tag == blot_check_numeric_proof_terms::Tag.literal { let value, err = blot_backend_scalar_ops::evaluate(op, blot_backend_scalar_ops::Value { blot_backend_runtime_ir::SC_u32, lhs.a , ..}, blot_backend_scalar_ops::Value { blot_backend_runtime_ir::SC_u32, rhs.a , ..}); if err != blot_error::Error.none { return self_.version(self_.module.typeOf(id), 0); } if value.scalar == blot_backend_runtime_ir::SC_u32 { let operand, err = self_.values.intern(Term { tag: blot_check_numeric_proof_terms::Tag.literal, a: value.bits , ..}); return Value { operand: operand , ..}, err; } }
    let identity, err = self_.arithmeticIdentity(op, left.operand, right.operand); if err != blot_error::Error.none { return Value {..}, err; } if identity != 0 { return Value { operand: identity , ..}, blot_error::Error.none; } let result, err = self_.version(self_.module.typeOf(id), 0); if err != blot_error::Error.none || (op != blot_check_core::Op.add && op != blot_check_core::Op.sub) { return result, err; }
    let zero, err = self_.values.intern(Term { tag: blot_check_numeric_proof_terms::Tag.literal, a: 0 , ..}); if err != blot_error::Error.none { return result, err; } var fits = blot_check_numeric_proof_terms::Relation.add_fits; if op == blot_check_core::Op.sub { fits = blot_check_numeric_proof_terms::Relation.sub_fits; } let fits, err = self_.query(Proposition { fits, left.operand, right.operand , ..}); if err != blot_error::Error.none || !fits { return result, err; }
    if op == blot_check_core::Op.add { let err = self_.order(blot_check_numeric_proof_terms::Relation.le, left.operand, result.operand); if err != blot_error::Error.none { return result, err; } let err = self_.order(blot_check_numeric_proof_terms::Relation.le, right.operand, result.operand); if err != blot_error::Error.none { return result, err; } let positive, err = self_.query(Proposition { blot_check_numeric_proof_terms::Relation.lt, zero, right.operand , ..}); if err != blot_error::Error.none { return result, err; } if positive { let err = self_.order(blot_check_numeric_proof_terms::Relation.lt, left.operand, result.operand); if err != blot_error::Error.none { return result, err; } } let positive, err = self_.query(Proposition { blot_check_numeric_proof_terms::Relation.lt, zero, left.operand , ..}); if err != blot_error::Error.none { return result, err; } if positive { let err = self_.order(blot_check_numeric_proof_terms::Relation.lt, right.operand, result.operand); if err != blot_error::Error.none { return result, err; } } }
    else { let err = self_.order(blot_check_numeric_proof_terms::Relation.le, result.operand, left.operand); if err != blot_error::Error.none { return result, err; } let positive, err = self_.query(Proposition { blot_check_numeric_proof_terms::Relation.lt, zero, right.operand , ..}); if err != blot_error::Error.none { return result, err; } if positive { let err = self_.order(blot_check_numeric_proof_terms::Relation.lt, result.operand, left.operand); if err != blot_error::Error.none { return result, err; } } } return result, blot_error::Error.none;
}
recursive fn assume(self_: Checker&, id: u32, positive: bool, depth: i64)->Error {var first:Facts=Facts{..};var second:Facts=Facts{..};let error=assumeValue(self_,id,positive,depth,first,second);blot_support_pooled_buffer::deinit(second,fact_scratch);blot_support_pooled_buffer::deinit(first,fact_scratch);return error;}
recursive fn assumeValue(self_: Checker&, id: u32, positive: bool, depth: i64,first:Facts&,second:Facts&)->Error {
    if id == 0 || !self_.plan || self_.degraded { return blot_error::Error.none; } if depth >= 128 { return blot_error::Error.proof_analysis_limit; } let err = self_.values.charge(1); if err != blot_error::Error.none { return err; } let value = self_.conditions[id - 1]; if value.negated { return self_.assume(value.left, !positive, depth + 1); }
    if value.op == blot_check_core::Op.none { var selected = value.negative; if positive { selected = value.positive; } if selected.present { return self_.fact(selected.value); } return blot_error::Error.none; }
    if (value.op == blot_check_core::Op.and_ && positive) || (value.op == blot_check_core::Op.or_ && !positive) { let err = self_.assume(value.left, positive, depth + 1); if err != blot_error::Error.none { return err; } return self_.assume(value.right, positive, depth + 1); }
    let start = self_.facts.items.len; let err = self_.assume(value.left, positive, depth + 1); if err != blot_error::Error.none { return err; } let stored=blot_support_pooled_buffer::append(first,self_.facts.items[start..],fact_scratch); if stored!=blot_error::Error.none {return stored;} self_.facts.resize(start);
    let err = self_.assume(value.left, !positive, depth + 1); if err != blot_error::Error.none { return err; } let err = self_.assume(value.right, positive, depth + 1); if err != blot_error::Error.none { return err; } let stored=blot_support_pooled_buffer::append(second,self_.facts.items[start..],fact_scratch); if stored!=blot_error::Error.none {return stored;} self_.facts.resize(start);
    for item in first.items { for other in second.items { if factEqual(item, other) { let err = self_.fact(item); if err != blot_error::Error.none { return err; } break; } } } return blot_error::Error.none;
}
fn join(left: Value, right: Value, proof_result: bool) -> Value, Error { if left.exits { return right, blot_error::Error.none; } if right.exits { return left, blot_error::Error.none; } if proof_result { if !left.proof.present || !right.proof.present || left.proof.value != right.proof.value { return Value {..}, blot_error::Error.invalid_artifact; } return left, blot_error::Error.none; } let err = ordinary(left); if err != blot_error::Error.none { return Value {..}, err; } let err = ordinary(right); if err != blot_error::Error.none { return Value {..}, err; } if left == right { return left, blot_error::Error.none; } if left.operand == right.operand { return Value { operand: left.operand , ..}, blot_error::Error.none; } return Value {..}, blot_error::Error.none; }
recursive fn operands(self_: Checker&, children: const u32[:], depth: i64) -> Error { for child in children { let value, err = self_.walk(child, depth + 1); if err != blot_error::Error.none { return err; } let err = ordinary(value); if err != blot_error::Error.none { return err; } } return blot_error::Error.none; }
fn comparison(self_: Checker&, op: Op, left: u32, right: u32) -> u32, Error {
    if left == 0 || right == 0 { return 0, blot_error::Error.none; } let a, err = self_.values.view().get(left); if err != blot_error::Error.none { return 0, err; } let b, err = self_.values.view().get(right); if err != blot_error::Error.none { return 0, err; } if a.kind != blot_check_numeric_proof_terms::Kind.unsigned32 || b.kind != blot_check_numeric_proof_terms::Kind.unsigned32 { return 0, blot_error::Error.none; }
    let forward = Fact.order { Proposition { blot_check_numeric_proof_terms::Relation.lt, left, right } , ..}; let backward = Fact.order { Proposition { blot_check_numeric_proof_terms::Relation.le, right, left } , ..}; let equal = Fact.order { Proposition { blot_check_numeric_proof_terms::Relation.eq, left, right } , ..}; let unequal = Fact.unequal { blot_check_numeric_proof_contracts::Unequal { left, right } , ..}; var result = Condition {..};
