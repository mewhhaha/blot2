// Event log of variant records (Tick, Move, Say, Quit) with a packed byte pool
// for Say strings, scanned 4 times.
import * as rng from "./rng"

const BENCH_N: U32 = 2000000 // BENCH_N
const PASSES: U32 = 4

type Event is data = $Tick | $Move { id: U32, dx: I32, dy: I32 } | $Say { id: U32, start: U32, len: U32 } | $Quit { id: U32, code: U32 }

io bench (): #[U32] =>
  let log = @array.fill BENCH_N $Tick
  let text: #[U8] = #[]
  let r: U64 = 12345

  for i in 0 .. BENCH_N:
    r := rng.xs_next self
    let k = rng.xs_mod r 8
    let id = rng.xs_mod (r >> 3) 100000
    if k < 4:
      let dx = (rng.xs_mod (r >> 20) 201).to_i32 - 100
      let dy = (rng.xs_mod (r >> 40) 201).to_i32 - 100
      log[i] := $Move { id, dx, dy }
    else:
      if k < 6:
        let wr = rng.xs_next r
        let n = 4 + rng.xs_mod wr 12
        let start = text.length
        for _ in 0 .. n:
          wr := rng.xs_next self
          text := self.push (97 + rng.xs_mod wr 26).to_u8
        log[i] := $Say { id, start, len: n }
      else:
        if k < 7:
          let code = rng.xs_mod (r >> 20) 256
          log[i] := $Quit { id, code }
        else:
          log[i] := $Tick

  let total: I64 = 0
  for _ in 0 .. PASSES:
    for i in 0 .. log.length:
      case log[i] of
        $Tick => do:
          total := self + 1
        $Move { id, dx, dy } => do:
          total := self + id.to_i64 + dx.to_i64 + dy.to_i64
        $Say { id, start, len } => do:
          total := self + id.to_i64 + len.to_i64 + text[start].to_i64
        $Quit { id, code } => do:
          total := self + id.to_i64 + code.to_i64

  let out: #[U32] = #[]
  out := rng.emit_u32 self log.length
  out := rng.emit_i64 self total
  return out
