new file mode 100644
index 00000000..76e4e22d
--- /dev/null
+++ b/zig-native/tests/scalar_inline_execution.test.ts
@@ -0,0 +1,57 @@
+import { strict as assert } from "node:assert";
+import { compileAndRun } from "./reduction_helpers.ts";
+
+Deno.test("tiny scalar call trees preserve eager arguments wrapping shifts F32 and trap recovery in both tiers", async () => {
+  await compileAndRun(
+    `const shift = func (value: U32) -> (amount: U32): U32 => return value >> amount
+const quotient = func (value: U32) -> (divisor: U32): U32 => return value / divisor
+const step = func (value: U32): U32 => return do:
+  if value & 1 != 0:
+    return shift value 33 ^ 0xEDB88320
+  return shift value 33
+const negate = func (value: F32): F32 => return @f32.neg value
+const combine = func (left: U32) -> (right: U32): U32 => return left * 31 + right
+entry const answer = func (input: U32): U32 => return do:
+  let rows: GrowArray U32 = #[input]
+  let value = rows[0]
+  for index in 0 .. 11:
+    value := step value
+  return value
+entry const floating = func (input: F32): F32 => return do:
+  let rows: GrowArray F32 = #[input]
+  return negate rows[0]
+entry const division = func (input: U32): U32 => return do:
+  let rows: GrowArray U32 = #[input]
+  return quotient 42 rows[0]
+entry const order = func (input: U32): U32 => return do:
+  let rows: GrowArray U32 = #[input]
+  let bump = func (value: U32): U32 => return do:
+    rows[0] := rows[0] * 10 + value
+    return value
+  let combined = combine (bump 1) (bump 2)
+  return combined + rows[0]
+`,
+    (guest) => {
+      assert.equal(guest.abi.version, 8);
+      for (const input of [0, 1, 2, 3, 0x80000000, 0xffffffff]) {
+        let expected = input;
+        for (let index = 0; index < 11; index++) {
+          if ((expected & 1) !== 0) {
+            expected = ((expected >>> 1) ^ 0xEDB88320) >>> 0;
+          } else expected >>>= 1;
+        }
+        assert.equal(guest.call("answer", input), expected);
+      }
+      assert(Object.is(guest.call("floating", 0), -0));
+      assert(Object.is(guest.call("floating", -0), 0));
+      assert.equal(guest.call("floating", Infinity), -Infinity);
+      assert.equal(guest.call("floating", -Infinity), Infinity);
+      assert.equal(guest.call("division", 2), 21);
+      assert.throws(() => guest.call("division", 0));
+      assert.equal(guest.call("division", 3), 14);
+      assert.equal(guest.call("order", 0), 45);
+      assert.equal(guest.call("order", 1), 145);
+    },
+    { stdRoot: new URL("../../std", import.meta.url).pathname },
+  );
+});
