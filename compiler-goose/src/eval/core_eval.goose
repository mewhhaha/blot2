struct PrincipalQueries { table: PrincipalTable=blot_reuse_semantic_query_table::init<PrincipalQueryKey,PrincipalDependencies,PrincipalGraphResult,PrincipalAdapter>(PrincipalAdapter {PrincipalClaim.source_description}),claim: PrincipalClaim=PrincipalClaim.source_description,declines: PrincipalDeclinesMap& =inactive_principal_declines,owner: u64=0,units: u64=0,unit_count: i64=0,force_collision: bool=false,lookup_budget: i64=4096,inspected_positions: i64=0,inspected_dependencies: i64=0,lookup_declines: i64=0 }
fn hash(key: PrincipalGraphKey) -> u64 { var value=blot_support_wyhash::init(0); blot_structural::hash(value,key); return value.final(); }
fn initPrincipalQueries(claim: PrincipalClaim,declines: PrincipalDeclinesMap&) -> PrincipalQueries { return PrincipalQueries { table:blot_reuse_semantic_query_table::init<PrincipalQueryKey,PrincipalDependencies,PrincipalGraphResult,PrincipalAdapter>(PrincipalAdapter {claim}),claim:claim,declines:declines }; }
fn storage(self_: const PrincipalQueries&) -> blot_reuse_semantic_query_table::Storage { var result=self_.table.storage(); result.inspected_positions=self_.inspected_positions; result.inspected_dependencies=self_.inspected_dependencies; result.lookup_declines=self_.lookup_declines; return result; }
fn inspect(self_: PrincipalQueries&,remaining: i64&,dependency: bool) -> bool { if remaining==0 { self_.lookup_declines=satAdd(self_.lookup_declines,1); return false; } remaining--; if dependency { self_.inspected_dependencies=satAdd(self_.inspected_dependencies,1); } else { self_.inspected_positions=satAdd(self_.inspected_positions,1); } return true; }
fn deinit(self_: PrincipalQueries&) { self_.table.deinit(); self_.declines.clear(); self_.owner=0; self_.units=0; self_.unit_count=0; }
fn count(self_: const PrincipalQueries&) -> i64 { return self_.table.records.len+self_.declines.count; }
fn unitsIdentity(session: const Session&) -> u64 { return session.catalog_owner_id; }
fn getInner(self_: PrincipalQueries&,key: PrincipalGraphKey,session: const Session&) -> PrincipalAnswer {
 if self_.owner!=session.owner_id||self_.units!=unitsIdentity(session)||self_.unit_count!=session.units.len { return PrincipalAnswer {}; } if self_.claim==PrincipalClaim.source_description&&self_.declines.contains(key) { return PrincipalAnswer {found:true}; }
 let adapter=PrincipalAdapter {self_.claim}; var cursor=self_.table.candidates(adapter.fingerprint(PrincipalQueryKey {key,self_.claim,self_.force_collision}),blot_reuse_semantic_query_table::Order.oldest_first); var remaining=self_.lookup_budget;
 loop { let position=cursor.next(); if !position.present { break; } if !inspect(self_,remaining,false) { return PrincipalAnswer {}; } let record=self_.table.records[position.value]; if record.key.source!=key { continue; } var valid=true;
  for fact,index in record.dependencies.plain { if !inspect(self_,remaining,true) { return PrincipalAnswer {}; } if !fact.read { continue; } var actual=blot_support::none<bool>(); let known=session.specializations.plain_nominals.get(fact.key); if known { actual=blot_support::some<bool>(known); } if record.dependencies.has_writes { var prior=index; while prior!=0 { prior--; if !inspect(self_,remaining,true) { return PrincipalAnswer {}; } let write=record.dependencies.plain[prior]; if !write.read&&write.key==fact.key { actual=blot_support::some(write.plain); break; } } } if fact.present { valid=valid&&actual.present&&actual.value==fact.plain; } else { valid=valid&&!actual.present; } if !valid { break; } }
