fn Engine::selectedReference(self:Engine&,source:u32,template:blot_reuse_principal_interface::MemberTemplate,proof:blot_reuse_principal_interface::SelectedProof)->bool,blot_error::Error {return self.selectedReferenceWithGoal(source,template,proof,false);}
fn Engine::selectedReferenceWithGoal(self:Engine&,source:u32,template:blot_reuse_principal_interface::MemberTemplate,proof:blot_reuse_principal_interface::SelectedProof,lexical:bool)->bool,blot_error::Error {if template.contract!=proof.contract {return false,blot_error::Error.none;}let actual,err=self.types.resolve(self.expr_types[source],0);if err!=blot_error::Error.none {return false,err;}if actual==0 || self.types.node(actual).tag!=blot_check_types::Tag.function {return false,blot_error::Error.none;}let index .= self.catalogs.contract_identities.get(template.contract);let contract=self.contracts[index];let member=self.contract_members[self.memberIndex(contract,template.name).value];let old=equation_type_ids.alloc_slice(contract.variables.len);for value,index in self.types.list(contract.variables) {old[index]=value;}let old_rows=equation_type_ids.alloc_slice(contract.row_variables.len);for value,index in self.types.list(contract.row_variables) {old_rows[index]=value;}let fresh=equation_type_ids.alloc_slice(old.len);let rows=equation_type_ids.alloc_slice(old_rows.len);let mark=self.types.mark();let result,error=selectedReferenceTrial(self,actual,member,contract,proof,lexical,old,old_rows,fresh,rows);self.types.rollback(mark);equation_type_ids.free_slice(rows);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old_rows);equation_type_ids.free_slice(old);return result,error;}
fn selectedReferenceTrial(self:Engine&,actual_root:u32,member:ContractMember,contract:Contract,proof:blot_reuse_principal_interface::SelectedProof,lexical:bool,old:const u32[:],old_rows:const u32[:],fresh:u32[:],rows:u32[:])->bool,blot_error::Error {for &variable in fresh {let root,err=self.types.fresh();if err!=blot_error::Error.none {return false,err;}variable=root;}for &row in rows {let root,err=self.types.freshEffects();if err!=blot_error::Error.none {return false,err;}row=root;}let root,err=self.types.substituteWithRows(member.root,old,fresh,old_rows,rows);if err!=blot_error::Error.none {return false,err;}var expected=root;var actual=actual_root;while self.types.node(self.types.head(expected,0)).tag==blot_check_types::Tag.function && self.types.node(actual).tag==blot_check_types::Tag.function {let left=self.types.node(self.types.head(expected,0));let right=self.types.node(actual);let err=self.types.unifyPattern(left.a,right.a);if err==blot_error::Error.out_of_memory || err==blot_error::Error.type_limit {return false,err;}if err!=blot_error::Error.none {return false,blot_error::Error.none;}expected=left.b;actual=right.b;}if contract.parameters.len!=proof.arguments.len {return false,blot_error::Error.none;}for ordinal in 0..contract.parameters.len {let substituted,err=self.types.substituteWithRows(self.types.list(contract.parameters)[ordinal],old,fresh,old_rows,rows);if err!=blot_error::Error.none {return false,err;}let input,err=self.types.resolve(substituted,0);if err!=blot_error::Error.none {return false,err;}let argument=self.types.list(proof.arguments)[ordinal];if lexical {let err=self.types.unifyPattern(input,argument);if err==blot_error::Error.out_of_memory || err==blot_error::Error.type_limit {return false,err;}if err!=blot_error::Error.none {return false,blot_error::Error.none;}}else {let closed,err=self.types.equalClosed(input,input);if err!=blot_error::Error.none || !closed {return false,err;}}let before,err=self.types.resolve(input,0);if err!=blot_err