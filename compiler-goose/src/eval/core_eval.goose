enum RequirementPart { ty { value: u32 },row { value: u32 } }
fn publicRequirementOperand(self: ClosureRegion&,target: Target,root: u32,parts: HeaderParts&) -> bool,Error { let module=self.session.units[target.unit]; let binding=module.binding(target.binding); var pending: RequirementPart[>..<]=[]; var seen: dictionary<u64,bool>; pending.push(RequirementPart.ty {root}); while pending.len!=0 { let part=pending[pending.len-1]; pending.resize(pending.len-1); var key: u64=0; match part { ty p=>{ key=p.value; },row p=>{ key=(1 as u64)<<32|p.value; }, } if seen.contains(key) { continue; } if seen.count>=self.session.options.max_values { return false,Error.none; } seen.insert(key,true); match part {
 row p=>{ let row=module.types.row(p.value); match row.tail { parameter=>{ return false,Error.none; },variable variable=>{ var found=false; for public,index in module.types.list(binding.public_rows) { if public==variable.value { parts.mask[binding.public_variables.len+index]=true; found=true; break; } } if !found { parts.has_private=true; } },_=>{}, } for label in module.types.rowLabels(p.value) { for argument in module.types.operationArguments(label) { pending.push(RequirementPart.ty {argument}); } } },
 ty p=>{ let node=module.types.node(p.value); match node.tag { variable=>{ var found=false; for variable,index in module.types.list(binding.public_variables) { if variable==p.value { parts.mask[index]=true; found=true; break; } } if !found { parts.has_private=true; } },instance_version,forall,existential,bound,rigid,absent,projection,scoped,instance_selection,erased_proof=>{ return false,Error.none; },unit,boolean,unsigned32,floating32,never,type_constructor=>{},usage,array,list,cursor,resolver=>{ pending.push(RequirementPart.ty {node.a}); },function,provider=>{ pending.push(RequirementPart.ty {node.a}); if node.tag==TypeTag.function { pending.push(RequirementPart.ty {node.b}); } pending.push(RequirementPart.row {node.c}); },state_provider=>{ for child in [node.a,node.b,node.c] { pending.push(RequirementPart.ty {child}); } },product,nominal=>{ var children=module.types.list(blot_check_types::List {node.a,node.b}); if node.tag==TypeTag.nominal { children=module.types.nominalArguments(node); } for child in children { pending.push(RequirementPart.ty {child}); } },record=>{ for index in 0..node.b { pending.push(RequirementPart.ty {module.types.recordField(node,index).ty}); } }, } },
