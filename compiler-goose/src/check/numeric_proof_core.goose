        greater => { result.positive = blot_support::some<Fact>(Fact.order { Proposition { blot_check_numeric_proof_terms::Relation.lt, right, left } , ..}); result.negative = blot_support::some<Fact>(Fact.order { Proposition { blot_check_numeric_proof_terms::Relation.le, left, right } , ..}); },
        greater_equal => { result.positive = blot_support::some(backward); result.negative = blot_support::some(forward); },
