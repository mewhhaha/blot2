    blot_check_core::PatternTag.product => { for child in self.module.patternChildren(id) { let err = self.pattern(child, depth + 1); if err != Error.none { return err; } } },
    blot_check_core::PatternTag.constructor, blot_check_core::PatternTag.record_payload => { if value.b != 0 { return self.pattern(value.b, depth + 1); } },
    blot_check_core::PatternTag.value => { let value, err = self.walk(value.a, depth + 1); if err != Error.none { return err; } return ordinary(value); }, _ => {},
    } return Error.none;
}
fn Checker::ordinaryWalk(self: Checker&, id: u32, depth: i64) -> Error { let value, err = self.walk(id, depth + 1); if err != Error.none { return err; } return ordinary(value); }
