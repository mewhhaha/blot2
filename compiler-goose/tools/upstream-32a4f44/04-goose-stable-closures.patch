 namespace goose {
 
+// Optional per-compilation observations. Count-based samples survive a bounded
+// failing prefix without adding per-query clock reads or retaining AST facts.
+struct StableQueryProfile {
+    const char *name;
+    bool enabled = [] { auto value = getenv("GOOSE_CHECKER_PROFILE"); return value && *value; }();
+    uint64_t hits = 0, misses = 0, rejected = 0, building = 0, unstable = 0, events = 0;
+    void Report() const {
+        if (!enabled) return;
+        fprintf(stderr, "GOOSE_CHECKER_PROFILE cache=%s hits=%llu misses=%llu rejected=%llu building=%llu unstable=%llu\n",
+                name, (unsigned long long)hits, (unsigned long long)misses,
+                (unsigned long long)rejected, (unsigned long long)building,
+                (unsigned long long)unstable);
+    }
+    void Tick() { if ((++events & ((UINT64_C(1) << 20) - 1)) == 0) Report(); }
+    void Hit() { if (enabled) { ++hits; Tick(); } }
+    void Miss() { if (enabled) { ++misses; Tick(); } }
+    void Reject() { if (enabled) { ++rejected; Tick(); } }
+    void Slow(bool typesbuilding) {
+        if (!enabled) return;
+        ++rejected;
+        if (typesbuilding) ++building;
+        else ++unstable;
+        Tick();
+    }
+    ~StableQueryProfile() { Report(); }
+};
+
 // The checker owns this for one compilation. Construction/qualification of
