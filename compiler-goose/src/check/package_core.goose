fn Walker::solverInstance(self:Walker&,solver:blot_check_scheme_equations::Solver&,owner:const Module&,binding:u32,expected:u32,version_pairs:const blot_check_package_contracts::VersionPair[:])->Principal,Error {var maps=ImportMaps{};let value,error=solverInstanceValue(self,solver,owner,binding,expected,version_pairs,maps);maps.deinit();return value,error;}
fn solverInstanceValue(self:Walker&,solver:blot_check_scheme_equations::Solver&,owner:const Module&,binding:u32,expected:u32,version_pairs:const blot_check_package_contracts::VersionPair[:],maps:ImportMaps&)->Principal,Error {if self.admission.source_bodies {if owner.binding(binding).kind==blot_check_core::BindingKind.global {let error=sourceBody(owner,binding,self.context,self.admission);if error!=Error.none {return invalidPrincipal(),error;}}}else {let origin .= self.origin;if !origin || !sameModule(owner,origin) {let error=owned(owner,self.context,self.admission);if error!=Error.none {return invalidPrincipal(),error;}}}let scheme=owner.binding(binding).scheme;var frozen=default<blot_check_frozen_types::Graph>();let copied,error=solver.importer(owner,frozen,scheme,maps.tables());if error!=Error.none {return invalidPrincipal(),solver.readerError(error);}var copy=copied;let actual,error=solver.copy(copy,scheme.root);if error!=Error.none {return invalidPrincipal(),solver.readerError(error);}var proof=Principal{left:self.scopes.types,right:self.scopes.types,remaining:self.scopes.remaining,views:self.scopes,foreign_views:true};proof.version_pairs=version_pairs;let error=proof.validate(actual,expected);if error!=Error.none {return invalidPrincipal(),error;}let error=self.solverGoals(solver,owner,scheme,copy,0);if error!=Error.none {return invalidPrincipal(),error;}proof.version_pairs=[];return proof,Error.none;}
reusable[] var pending_goal_runs:blot_check_core::Obligation[>..];
fn Walker::solverGoals(self:Walker&,solver:blot_check_scheme_equations::Solver&,producer:const Module&,scheme:blot_check_types::Scheme,copy:blot_check_check_scheme_import::Copier&,depth:i64)->Error {let source_goals=producer.obligations[scheme.obligations.start..scheme.obligations.start+scheme.obligations.len];let pending=pending_goal_runs.alloc_slice(source_goals.len);let error=solverGoalsValue(self,solver,producer,source_goals,copy,depth,pending);pending_goal_runs.free_slice(pending);return error;}
fn solverGoalsValue(self:Walker&,solver:blot_check_scheme_equations::Solver&,producer:const Module&,source_goals:const blot_check_core::Obligation[:],copy:blot_check_check_scheme_import::Copier&,depth:i64,pending:blot_check_core::Obligation[:])->Error {for goal,index in source_goals {pending[index]=goal;let value,error=solver.copy(copy,goal.ty);if error!=Error.none {return solver.readerError(error);}pending[index].ty=value;let value,error=solver.copy(copy,goal.other);if error!=Error.none {return solver.readerError(error);}pending[index].other=value;let value,error=solver.copy(copy,goal.result);if error!=Error.none {return solver.readerError(error);}pending[index].result=value;let value,error=solver.copy(copy,goal.signature);if error!=Error.none {return solver.readerError(error);}pending[index].signature=value;}var count=pending.len;while count!=0 {let error=self.step(depth);if error!=Error.none {return error;}var progress=false;if self.admission.source_bodies {var physical_progress=true;while physical_progress && count!=0 {physical_progress=false;for &goal in pending {if goal.ty==0 || (goal.kind!=blot_check_types::ObligationKind.field && goal.kind!=blot_check_types::ObligationKind.writable_field) {continue;}let error=self.step(depth);if error!=Error.none {return error;}goal.ty=solver.store.head(goal.ty,0);let physical,error=self.physicalField(goal,depth+1);if error!=Error.none {return error;}if !physical {continue;}for field in 0..3 {let error=self.step(depth);if error!=Error.none {return error;}match field {0=>{goal.other=solver.store.head(goal.other,0);},1=>{goal.result=solver.store.head(goal.result,0);},_=>{goal.signature=solver.store.head(goal.signature,0);},}}let point=solver.store.mark();let solved,error=self.closedGoal(goal,depth+1);if error!=Error.none {return error;}if !solved {solver.rollback(point);if solver.oom {return Error.invalid_artifact;}continue;}goal.ty=0;count-=1;progress=true;physical_progress=true;}}}for &goal in pending {if goal.ty==0 {continu