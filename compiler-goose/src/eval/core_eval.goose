struct ConstantRun { session: Session&,resolved: Target,body: const blot_check_core::Body&,frame: Frame&,reference: BindingRef,inputs: blot_reuse_constant_receipt::Inputs,recordable: bool,outcome: blot_support::Option<ValueId>,pending: blot_support::Option<blot_reuse_constant_receipt::Record> }
fn runConstantRecording(context: ConstantRun&,recording: blot_reuse_constant_receipt::Recorder&) -> Error {
 let self=context.session;
 if self.retain_constant_receipts&&context.recordable { let error=recording.captureInputs(context.inputs); if error!=Error.none { return error; } self.constant_recorder .= recording; }
 defer self.constant_recorder .= null;
 let flow,error=expression(self,context.resolved.unit,context.body.root,context.frame); if error!=Error.none { return error; }
 match flow { value v=>{ context.outcome=blot_support::some(v.value); },_=>{ return fail(self,context.resolved.unit,context.body.span,Code.unsupported); }, }
 if self.constant_recorder!=null { let record,e=recording.finish(self,context.reference,context.outcome.value,blot_reuse_constant_receipt::Inputs {context.frame.mappings,context.frame.row_mappings}); if e!=Error.none { return e; } context.pending=record; } return Error.none;
}
fn constantInner(self: Session&,resolved: Target) -> ValueId,Error {
