fn appendFunction(self: ClosureRegion&,function: u32) -> Error { let index=self.scratch.source_functions.len; self.scratch.source_functions.push(function); if self.building_principal { self.scratch.principal_actions.push(PrincipalAction.function {index as u32}); } return Error.none; }
