// Explicit four-lane operations. These aliases are ordinary product types, so
// lanes can be constructed, destructured and passed through normal functions.
// Every operation with a scalar counterpart gives bit-identical lanes.
type U32x4 = (U32, U32, U32, U32)
type F32x4 = (F32, F32, F32, F32)
func u32_splat (value: U32) : U32x4 => (value, value, value, value)
func f32_splat (value: F32) : F32x4 => (value, value, value, value)
func u32_add left -> right => @simd.u32x4.add left right
func u32_sub left -> right => @simd.u32x4.sub left right
func u32_mul left -> right => @simd.u32x4.mul left right
func u32_and left -> right => @simd.u32x4.bit_and left right
func u32_or left -> right => @simd.u32x4.bit_or left right
func u32_xor left -> right => @simd.u32x4.bit_xor left right
func f32_add left -> right => @simd.f32x4.add left right
func f32_sub left -> right => @simd.f32x4.sub left right
func f32_mul left -> right => @simd.f32x4.mul left right
func f32_div left -> right => @simd.f32x4.div left right
func f32_abs value => @simd.f32x4.abs value
func f32_neg value => @simd.f32x4.neg value
func f32_sqrt value => @simd.f32x4.sqrt value
func f32_ceil value => @simd.f32x4.ceil value
func f32_floor value => @simd.f32x4.floor value
func f32_trunc value => @simd.f32x4.trunc value
func to_f32 value => @simd.u32x4.to_f32 value
func to_u32 value => @simd.f32x4.to_u32 value
// Signed conversions use two's-complement U32 lane bits. Float-to-signed
// truncates toward zero and saturates, including zero for NaN.
func to_f32_signed value => @simd.u32x4.to_f32_signed value
func to_u32_signed value => @simd.f32x4.to_u32_signed value

// Shifts take a scalar count, which wraps modulo 32 like the U32 `<<`/`>>`.
// `u32_sar` shifts in copies of each lane's top bit.
func u32_shl (count: U32) -> lanes => @simd.u32x4.shl lanes count
func u32_shr (count: U32) -> lanes => @simd.u32x4.shr lanes count
func u32_sar (count: U32) -> lanes => @simd.u32x4.sar lanes count

// `f32_min a b` is the prelude's `min a b`, `if a < b then a else b`, in each
// lane, including its NaN and signed-zero choices; `f32_max` likewise.
func f32_min left -> right => @simd.f32x4.min left right
func f32_max left -> right => @simd.f32x4.max left right
func u32_min left -> right => @simd.u32x4.min left right
func u32_max left -> right => @simd.u32x4.max left right

// Comparisons give a U32x4 mask: all ones where the scalar comparison holds,
// zero elsewhere. Unsigned comparisons follow U32 ordering.
func f32_eq left -> right => @simd.f32x4.eq left right
func f32_ne left -> right => @simd.f32x4.ne left right
func f32_lt left -> right => @simd.f32x4.lt left right
func f32_le left -> right => @simd.f32x4.le left right
func f32_gt left -> right => @simd.f32x4.gt left right
func f32_ge left -> right => @simd.f32x4.ge left right
func u32_eq left -> right => @simd.u32x4.eq left right
func u32_ne left -> right => @simd.u32x4.ne left right
func u32_lt left -> right => @simd.u32x4.lt left right
func u32_le left -> right => @simd.u32x4.le left right
func u32_gt left -> right => @simd.u32x4.gt left right
func u32_ge left -> right => @simd.u32x4.ge left right

// Selection is bitwise: a mask bit of one takes `yes`, zero takes `no`.
func f32_select (mask: U32x4) -> yes -> no => @simd.f32x4.select mask (yes, no)
func u32_select (mask: U32x4) -> yes -> no => @simd.u32x4.select mask (yes, no)
// There is no I32 surface type. Flip the sign bit to compare U32 lanes as
// two's-complement signed words, then use the same masks and selection.
const u32_sign_mask = (0x80000000, 0x80000000, 0x80000000, 0x80000000)
func u32_lt_signed left -> right => u32_lt (u32_xor left u32_sign_mask) (u32_xor right u32_sign_mask)
func u32_le_signed left -> right => u32_le (u32_xor left u32_sign_mask) (u32_xor right u32_sign_mask)
func u32_gt_signed left -> right => u32_gt (u32_xor left u32_sign_mask) (u32_xor right u32_sign_mask)
func u32_ge_signed left -> right => u32_ge (u32_xor left u32_sign_mask) (u32_xor right u32_sign_mask)
func u32_min_signed left -> right => u32_select (u32_lt_signed left right) left right
func u32_max_signed left -> right => u32_select (u32_gt_signed left right) left right
// Wasm SIMD has no integer divide. Keep U32's quotient and divide-by-zero
// behavior with four scalar lanes until a vector reciprocal is appropriate.
func u32_div (left: U32x4) -> (right: U32x4) =>
  let (a, b, c, d) = left
  let (e, f, g, h) = right
  return (@u32.div a e, @u32.div b f, @u32.div c g, @u32.div d h)
func u32_not lanes => @simd.u32x4.not lanes
func u32_andnot left -> right => @simd.u32x4.andnot left right
func any_true mask => @simd.u32x4.any_true mask
func all_true mask => @simd.u32x4.all_true mask

// Lane selectors must be literal U32 values at a direct, fully applied call.
// Shuffle indices 0-3 take lanes from `left`, 4-7 from `right`.
func f32_shuffle lanes -> left -> right => @simd.f32x4.shuffle lanes (left, right)
func f32_swizzle lanes -> value => @simd.f32x4.swizzle lanes value
func f32_broadcast (lane: U32) -> value => @simd.f32x4.broadcast value lane
func u32_shuffle lanes -> left -> right => @simd.u32x4.shuffle lanes (left, right)
func u32_swizzle lanes -> value => @simd.u32x4.swizzle lanes value
func u32_broadcast (lane: U32) -> value => @simd.u32x4.broadcast value lane

// Bit reinterpretation keeps every bit, including NaN payloads.
func f32_bits lanes => @simd.f32x4.bits lanes
func f32_from_bits lanes => @simd.u32x4.from_bits lanes

// Opt-in fused or unfused `a * b + c` and `-(a * b) + c`. Their rounding
// depends on the host; nothing else selects them implicitly.
func f32_relaxed_madd a -> b -> c => @simd.f32x4.relaxed_madd a (b, c)
func f32_relaxed_nmadd a -> b -> c => @simd.f32x4.relaxed_nmadd a (b, c)

// One range check precedes the index arithmetic, so a wrapping index cannot
// select unrelated lanes. Loads copy four elements; a store takes the Array
// over, replaces four elements in place and gives it back.
// U32, F32 and Bool elements are supported.
func load index -> values => @simd.load values index
func store index -> lanes -> (values: own #[a]) => @simd.store values index lanes

// Reductions never reassociate implicitly. The pairwise variant is an explicit
// choice of grouping and can round differently from the left-to-right version.
func f32_sum (values: F32x4) =>
  let (a, b, c, d) = values
  return ((a + b) + c) + d
func f32_sum_pairwise (values: F32x4) =>
  let (a, b, c, d) = values
  return (a + b) + (c + d)
func u32_sum (values: U32x4) =>
  let (a, b, c, d) = values
  return ((a + b) + c) + d
// Dot products group exactly like std/vector's `Vec3.dot`, left to right:
// `((a.x * b.x + a.y * b.y) + a.z * b.z) + a.w * b.w`; `f32_dot3` ignores lane 3.
func f32_dot (left: F32x4) -> (right: F32x4) =>
  let (x, y, z, w) = f32_mul left right
  return ((x + y) + z) + w
func f32_dot3 (left: F32x4) -> (right: F32x4) =>
  let (x, y, z, _) = f32_mul left right
  return (x + y) + z

// Explicit 128-bit wide vectors: 2-lane F64, 2-lane U64 masks, 16-lane packed
// U8 bytes, and 8-lane packed 16-bit integers. Each stays in a single v128
// register via shadow tracking and lowers to two 64-bit words across boundaries.
type F64x2 = (F64, F64)
type U64x2 = (U64, U64)
type U8x16 = (U64, U64)
type I16x8 = (U64, U64)

func f64_splat (value: F64): F64x2 => (value, value)
func f64_add (left: F64x2) -> (right: F64x2): F64x2 => @simd.f64x2.add left right
func f64_sub (left: F64x2) -> (right: F64x2): F64x2 => @simd.f64x2.sub left right
func f64_mul (left: F64x2) -> (right: F64x2): F64x2 => @simd.f64x2.mul left right
func f64_div (left: F64x2) -> (right: F64x2): F64x2 => @simd.f64x2.div left right
func f64_min (left: F64x2) -> (right: F64x2): F64x2 => @simd.f64x2.min left right
func f64_max (left: F64x2) -> (right: F64x2): F64x2 => @simd.f64x2.max left right
func f64_abs (value: F64x2): F64x2 => @simd.f64x2.abs value
func f64_neg (value: F64x2): F64x2 => @simd.f64x2.neg value
func f64_ceil (value: F64x2): F64x2 => @simd.f64x2.ceil value
func f64_floor (value: F64x2): F64x2 => @simd.f64x2.floor value
func f64_trunc (value: F64x2): F64x2 => @simd.f64x2.trunc value
func f64_sqrt (value: F64x2): F64x2 => @simd.f64x2.sqrt value
func f64_eq (left: F64x2) -> (right: F64x2): U64x2 => @simd.f64x2.eq left right
func f64_ne (left: F64x2) -> (right: F64x2): U64x2 => @simd.f64x2.ne left right
func f64_lt (left: F64x2) -> (right: F64x2): U64x2 => @simd.f64x2.lt left right
func f64_le (left: F64x2) -> (right: F64x2): U64x2 => @simd.f64x2.le left right
func f64_gt (left: F64x2) -> (right: F64x2): U64x2 => @simd.f64x2.gt left right
func f64_ge (left: F64x2) -> (right: F64x2): U64x2 => @simd.f64x2.ge left right
func f64_select (mask: U64x2) -> (yes: F64x2) -> (no: F64x2): F64x2 => @simd.f64x2.select mask (yes, no)
func f64_bits (lanes: F64x2): U64x2 => @simd.f64x2.bits lanes
func f64_from_bits (lanes: U64x2): F64x2 => @simd.u64x2.from_bits lanes
func f64_relaxed_madd (a: F64x2) -> (b: F64x2) -> (c: F64x2): F64x2 => @simd.f64x2.relaxed_madd a (b, c)
func f64_relaxed_nmadd (a: F64x2) -> (b: F64x2) -> (c: F64x2): F64x2 => @simd.f64x2.relaxed_nmadd a (b, c)
func f64_sum (values: F64x2): F64 =>
  let (a, b) = values
  return a + b
func f64_dot (left: F64x2) -> (right: F64x2): F64 =>
  let (a, b) = f64_mul left right
  return a + b

func u64_and (left: U64x2) -> (right: U64x2): U64x2 => @simd.u64x2.bit_and left right
func u64_or (left: U64x2) -> (right: U64x2): U64x2 => @simd.u64x2.bit_or left right
func u64_xor (left: U64x2) -> (right: U64x2): U64x2 => @simd.u64x2.bit_xor left right
func u64_andnot (left: U64x2) -> (right: U64x2): U64x2 => @simd.u64x2.andnot left right
func u64_not (lanes: U64x2): U64x2 => @simd.u64x2.not lanes
func u64_select (mask: U64x2) -> (yes: U64x2) -> (no: U64x2): U64x2 => @simd.u64x2.select mask (yes, no)
func u64_any_true (mask: U64x2): Bool => @simd.u64x2.any_true mask
func u64_all_true (mask: U64x2): Bool => @simd.u64x2.all_true mask

func u8_splat (value: U8): U8x16 => @simd.u8x16.splat value
func u8_add (left: U8x16) -> (right: U8x16): U8x16 => @simd.u8x16.add left right
func u8_sub (left: U8x16) -> (right: U8x16): U8x16 => @simd.u8x16.sub left right
func u8_min (left: U8x16) -> (right: U8x16): U8x16 => @simd.u8x16.min left right
func u8_max (left: U8x16) -> (right: U8x16): U8x16 => @simd.u8x16.max left right
func u8_eq (left: U8x16) -> (right: U8x16): U8x16 => @simd.u8x16.eq left right
func u8_avgr (left: U8x16) -> (right: U8x16): U8x16 => @simd.u8x16.avgr left right
func u8_bitmask (lanes: U8x16): U32 => @simd.u8x16.bitmask lanes
func u8_narrow (low: I16x8) -> (high: I16x8): U8x16 => @simd.u8x16.narrow low high

func i16_splat (value: U32): I16x8 => @simd.i16x8.splat value
func i16_extend_low_u (bytes: U8x16): I16x8 => @simd.i16x8.extend_low_u bytes
func i16_extend_high_u (bytes: U8x16): I16x8 => @simd.i16x8.extend_high_u bytes
func i16_add (left: I16x8) -> (right: I16x8): I16x8 => @simd.i16x8.add left right
func i16_sub (left: I16x8) -> (right: I16x8): I16x8 => @simd.i16x8.sub left right
func i16_mul (left: I16x8) -> (right: I16x8): I16x8 => @simd.i16x8.mul left right
func i16_shl (count: U32) -> (lanes: I16x8): I16x8 => @simd.i16x8.shl lanes count
func i16_shr_u (count: U32) -> (lanes: I16x8): I16x8 => @simd.i16x8.shr_u lanes count
func i16_shr_s (count: U32) -> (lanes: I16x8): I16x8 => @simd.i16x8.shr_s lanes count
func i16_min (left: I16x8) -> (right: I16x8): I16x8 => @simd.i16x8.min left right
func i16_max (left: I16x8) -> (right: I16x8): I16x8 => @simd.i16x8.max left right

func load_u8x16 (index: U32) -> values: U8x16 => @simd.load_u8x16 values index
func store_u8x16 (index: U32) -> (lanes: U8x16) -> (values: own #[U8]): #[U8] => @simd.store_u8x16 values index lanes
func load_f64x2 (index: U32) -> values: F64x2 => @simd.load_f64x2 values index
func store_f64x2 (index: U32) -> (lanes: F64x2) -> (values: own #[F64]): #[F64] => @simd.store_f64x2 values index lanes
