fn installBindings(frame: Frame&,bound: Bound[:]) { for entry in bound { let previous=frame.values.get(entry.binding); entry.previous=blot_support::none<ValueId>(); if previous { entry.previous=blot_support::some(previous); } frame.values.insert(entry.binding,entry.value); } }
fn restoreBindings(frame: Frame&,bound: const Bound[:]) { var index=bound.len; while index!=0 { index--; let entry=bound[index]; if entry.previous.present { frame.values.insert(entry.binding,entry.previous.value); } else { frame.values.remove(entry.binding); } } }
fn matchPattern(self: Session&,owner: i64,pattern_id: u32,value: ValueId,frame: Frame&,bound: Bound[>..<]&,nesting: i64) -> bool,Error { let module=self.units[owner]; let pattern=module.pattern(pattern_id); var available=self.options.max_depth-self.depth; if available<0 { available=0; } if self.steps>=self.options.max_steps||nesting>=available { return false,fail(self,owner,pattern.span,Code.constant_fuel); } self.steps++; if self.constant_recorder { var relative=self.depth-self.constant_recorder.base_depth; if relative<0 { relative=0; } relative=satAdd(satAdd(relative,nesting),1); if relative>self.constant_recorder.depth { self.constant_recorder.depth=relative; } }
