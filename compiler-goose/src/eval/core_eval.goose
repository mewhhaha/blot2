struct PrincipalProvider { generator: blot_backend_core_backend::Generator& }
struct PrincipalGraphProvider { generator: blot_backend_core_backend::Generator& }
enum CodeProjection { physical { value: blot_eval_specialization::PhysicalProjection& },owned { value: blot_eval_specialization::OwnedProjection& },static_code { value: blot_backend_core_backend::StaticCodeProjection& } }
fn mapping(projection: CodeProjection,solver: blot_check_types::Store&,variable: u32,root: u32) -> Error {
 match projection { physical p=>{ return p.value.mapping(solver,variable,root); },owned p=>{ return p.value.mapping(solver,variable,root); },static_code p=>{ return p.value.mapping(solver,variable,root); }, }
}
fn instance(projection: CodeProjection,unit: u32,variable: u32) -> blot_support::Option<blot_check_types::NominalIdentity> { match projection { owned p=>{ return p.value.instance(unit,variable); },_=>{ return blot_support::none<blot_check_types::NominalIdentity>(); }, } }
struct PrincipalGraphKey { target: Target,source_interface: bool,deferred_member: bool,options: Options }
struct PrincipalTypeImport { source: u32,graph: u32 }
struct PrincipalRowImport { source: u32,graph: u32 }
enum PrincipalAction { constraint { value: u32 },alias { value: u32 },function { value: u32 },reference { value: u32 } }
struct PrincipalGraph {
 owner_id: u64=blot_native::fresh_owner_id(),key: PrincipalGraphKey,leases: i64=1,retention_eligible: bool=false,
 types: blot_check_types::StoreSnapshot,node_count: i64=0,base_edge_count: i64=0,owned_bytes: i64=0,pool_index: i64=-1,root: u32=0,imports: const PrincipalTypeImport[:]=[],rows: const PrincipalRowImport[:]=[],requirements: const Constraint[:]=[],constraints: const Constraint[:]=[],aliases: const DataAlias[:]=[],functions: const u32[:]=[],arguments: const u32[:]=[],references: const Target[:]=[],actions: const PrincipalAction[:]=[],source_complete: bool=false,dependencies: const BindingRef[:]=[],plain_reads: const blot_reuse_specialization_receipt::PlainFact[:]=[],untracked_reads: bool=false,foreign_sources: bool=false,foreign_types_only: bool=false
}
fn nodeCount(self: const PrincipalGraph&) -> i64 { return self.node_count; }
fn edgeCount(self: const PrincipalGraph&) -> i64 {
 var count=self.base_edge_count+self.actions.len+self.imports.len+self.rows.len+self.arguments.len+self.aliases.len*2+self.functions.len+self.references.len+self.dependencies.len+self.plain_reads.len;
 for c in self.constraints { count+=5+c.diagnostic_name.len; } for c in self.requirements { count+=5+c.diagnostic_name.len; } return count;
}
fn retain(self: PrincipalGraph&) { assert(self.leases!=0x7fffffffffffffff); self.leases++; }
fn hash(key: FieldKey) -> u64 { return ::hash_combine(::hash_combine(::hash(key.family),::hash(key.tag)),::hash(key.name)); }
fn hash(key: Target) -> u64 { return ::hash_combine(::hash(key.unit),::hash(key.binding)); }
fn hash(key: CallProofKey) -> u64 { return ::hash_combine(hash(key.target),::hash(key.evidence)); }
struct SessionTables {
 binding_offsets: i64[>..<]&,node_offsets: i64[>..<]&,slots: Slot[>..<]&,visited_nodes: bool[>..<]&,pending: Target[>..<]&,capability_scopes: ValueId[>..<]&,break_values: ValueId[>..<]&,field_locations: dictionary<FieldKey,FieldLocation>&,request_cells: RequestCell[>..<]&,request_handlers: RequestHandler[>..<]&,owned_diagnostic_message: u8[>..<]&
}
struct Session {
 owner_id: u64=blot_native::fresh_owner_id(),catalog_owner_id: u64=blot_native::fresh_owner_id(),allocation_owner: u64=0,generator: blot_backend_core_backend::Generator?=null,
 inference_stage: blot_work_counters::InferenceStage=blot_work_counters::InferenceStage.general,dense_unit_ids: bool=false,
 retained: RetainedRecords&,specializations: SpecializationCaches&,regions: RegionStorage&,storage: blot_eval_eval_values::Store&,providers: blot_backend_provider_chain::Store&,
 semantic_io_enabled: bool=false,semantic_component_workers: u8=0,semantic_job_budget: blot_support::Option<i64>=blot_support::none<i64>(),timing: blot_backend_backend_timing::Work?=null,
 split_attempts: i64=0,split_accepted: i64=0,split_declined: i64=0,summary_eligibility_visits: i64=0,inquiry_regions: i64=0,constant_inference_serial: u64=0,summary_transitions: i64=0,summary_exhausted: bool=false,summary_graph_work: i64=0,component_restarts: i64=0,component_members_published: i64=0,reuse_principal_graphs: bool=true,principal_graph_builds: i64=0,principal_graph_imports: i64=0,principal_graph_deferred: i64=0,principal_graph_nodes: i64=0,principal_graph_edges: i64=0,
 counters: blot_work_counters::Counters=blot_work_counters::Counters {},closed_source_imports: i64=0,closed_source_reused: i64=0,evidence_import_requests: i64=0,evidence_import_reused: i64=0,
 retain_constant_receipts: bool=false,minimum_constant_steps: i64=blot_reuse_constant_receipt::minimum_steps,constant_receipt_retry: bool=false,constant_provider_enabled: bool=false,constant_recorder: blot_reuse_constant_receipt::Recorder?=null,constant_stats: blot_reuse_constant_receipt::Stats=blot_reuse_constant_receipt::Stats {},
 retain_specialization_receipts: bool=false,specialization_provider_enabled: bool=false,receipt_tape: blot_reuse_specialization_receipt::Tape?=null,member_trace: blot_reuse_specialization_receipt::MemberTrace?=null,refinement_observation: blot_reuse_refinement_receipt::Observation?=null,principal_provider_enabled: bool=false,principal_graph_provider_enabled: bool=false,principal_regions: i64=0,principal_recordings: u64=0,principal_reads: blot_reuse_principal_inputs::Recorder?=null,principal_plain_reads: blot_reuse_principal_inputs::Recorder?=null,
 owned_diagnostic_message: u8[>..<]&,diagnostic_context: DiagnosticContext=DiagnosticContext {},specialization_origin: blot_support::Option<SourceLocation>=blot_support::none<SourceLocation>(),proofs: ProofStats=ProofStats {},units: const Module[:],capability_scopes: ValueId[>..<]&,options: Options=Options {},closed_constructor: bool=false,steps: i64=0,constant_value_debt: i64=0,constant_child_debt: i64=0,diagnostic: blot_support::Option<Diagnostic>=blot_support::none<Diagnostic>(),traced_bodies: i64=0,traced_nodes: i64=0,
 binding_offsets: const i64[:],node_offsets: const i64[:],slots: Slot[:],visited_nodes: bool[>..<]&,node_count: i64=0,borrowed_tables: bool=false,pending: Target[>..<]&,draining_pending: bool=false,indexed_region: IndexedRegion?=null,ragged_region: RaggedRegion?=null,ragged_probe_limit: i64=blot_backend_ragged_builder::probe_limit,ragged_reserved_children: i64=0,generator_origin: blot_support::Option<blot_check_staging_origins::Source>=blot_support::none<blot_check_staging_origins::Source>(),staging_trace: blot_check_staging_origins::Trace=blot_check_staging_origins::Trace {},
 implementation_proofs: blot_eval_implementation_evidence::Store&,associated_remaining: i64=1000000,has_implementations: bool=false,has_generative_sources: bool=false,break_values: ValueId[>..<]&,field_locations: dictionary<FieldKey,FieldLocation>&,request_cells: RequestCell[>..<]&,request_handlers: RequestHandler[>..<]&,request_owner: u32=0,demanded: i64=0,depth: i64=0,call_depth: i64=0
}
struct StageScope { session: Session&,previous: blot_work_counters::InferenceStage }
fn deinit(self: StageScope) { self.session.inference_stage=self.previous; }
fn enterInferenceStage(self: Session&,stage: blot_work_counters::InferenceStage) -> StageScope { let result=StageScope {self,self.inference_stage}; self.inference_stage=stage; return result; }
fn slotStateCode(state: State) -> u8 { match state { unseen=>0,evaluating=>1,complete=>2, } }
fn recordingConstant(self: const Session&) -> bool { if self.constant_recorder==null { return false; } return self.constant_recorder.eligible; }
fn declineConstant(self: Session&) { if self.constant_recorder { self.constant_recorder.eligible=false; } self.constant_recorder .= null; }
fn observeConstantInference(self: Session&) { if self.constant_inference_serial!=0xffffffffffffffff { self.constant_inference_serial++; } declineConstant(self); }
fn satAdd(a: i64,b: i64) -> i64 { if b>0x7fffffffffffffff-a { return 0x7fffffffffffffff; } return a+b; }
fn constantValueCount(self: const Session&) -> i64 { return satAdd(self.storage.values.len,self.constant_value_debt); }
fn constantChildCount(self: const Session&) -> i64 { return satAdd(self.storage.children.len,self.constant_child_debt); }
fn summaryLimit(self: const Session&) -> i64 { if self.semantic_job_budget.present&&self.semantic_job_budget.value<self.options.max_summary_transitions { return self.semantic_job_budget.value; } return self.options.max_summary_transitions; }
fn summaryCharge(self: Session&,count: i64) -> bool { if self.summary_exhausted { return false; } var available=summaryLimit(self)-self.summary_transitions; if available<0 { available=0; } if count>available { self.summary_exhausted=true; return false; } self.summary_transitions+=count; return true; }
struct FirstFamily { module: i64,nominal: i64,family: u64 }
fn init(t: SessionTables,units: const Module[:],storage: blot_eval_eval_values::Store&,providers: blot_backend_provider_chain::Store&,implementation_proofs: blot_eval_implementation_evidence::Store&,regions: RegionStorage&,specializations: SpecializationCaches&,retained: RetainedRecords&) -> Session,Error {
 var has_implementations=false; var has_generative_sources=false; var dense=true; var binding_count: i64=0; var node_count: i64=0;
 for module,index in units {
  dense=dense&&(module.unit==0||module.unit==index+1); has_implementations=has_implementations||module.implementations.len!=0||module.member_templates.len!=0; has_generative_sources=has_generative_sources||blot_reuse_source_value_template::moduleGenerative(module);
  t.binding_offsets.push(binding_count); t.node_offsets.push(node_count); if module.bindings.len>0x7fffffffffffffff-binding_count||module.nodes.len>0x7fffffffffffffff-node_count { return emptySession(t,units,storage,providers,implementation_proofs,regions,specializations,retained),Error.out_of_memory; } binding_count+=module.bindings.len; node_count+=module.nodes.len;
 }
 for i in 0..binding_count { t.slots.push(Slot {}); }
 var families: dictionary<u64,bool>; var firsts: FirstFamily[>..]=[];
 for module,index in units { var unit_id=module.unit; if unit_id==0 { unit_id=(index+1) as u32; }
  for nominal,nominal_index in module.nominals { if nominal.identity.decl==0 { continue; } var owner=nominal.identity.unit; if owner==0 { owner=unit_id; } let family=(owner as u64)<<32|nominal.identity.decl; if families.contains(family) { continue; } families.insert(family,true); firsts.push(FirstFamily {index,nominal_index,family}); }
 }
 for first in firsts { let module=units[first.module]; let nominal=module.nominals[first.nominal];
  for constructor_index in module.extra[nominal.constructors.start..nominal.constructors.start+nominal.constructors.len] { let constructor=module.constructor(constructor_index); if constructor.payload==0 { continue; } let payload=module.types.node(constructor.payload); if payload.tag!=TypeTag.record { continue; }
   for field in 0..payload.b { t.field_locations.insert(FieldKey {first.family,constructor.tag,module.types.recordField(payload,field).name},FieldLocation {field as u32,payload.b}); }
  }
 }
 return Session {allocation_owner:regions.region_arena_pool.original,retained:retained,specializations:specializations,regions:regions,storage:storage,providers:providers,units:units,dense_unit_ids:dense,owned_diagnostic_message:t.owned_diagnostic_message,capability_scopes:t.capability_scopes,binding_offsets:t.binding_offsets,node_offsets:t.node_offsets,slots:t.slots,visited_nodes:t.visited_nodes,node_count:node_count,pending:t.pending,implementation_proofs:implementation_proofs,associated_remaining:blot_inference_limits::configured(),has_implementations:has_implementations,has_generative_sources:has_generative_sources,break_values:t.break_values,field_locations:t.field_locations,request_cells:t.request_cells,request_handlers:t.request_handlers},Error.none;
}
fn initShared(parent: const Session&,t: SessionTables,storage: blot_eval_eval_values::Store&,providers: blot_backend_provider_chain::Store&,implementation_proofs: blot_eval_implementation_evidence::Store&,regions: RegionStorage&,specializations: SpecializationCaches&,retained: RetainedRecords&) -> Session,Error {
 for i in 0..parent.slots.len { t.slots.push(Slot {}); }
 return Session {catalog_owner_id:parent.catalog_owner_id,allocation_owner:regions.region_arena_pool.original,retained:retained,specializations:specializations,regions:regions,storage:storage,providers:providers,units:parent.units,dense_unit_ids:parent.dense_unit_ids,owned_diagnostic_message:t.owned_diagnostic_message,capability_scopes:t.capability_scopes,binding_offsets:parent.binding_offsets,node_offsets:parent.node_offsets,slots:t.slots,visited_nodes:t.visited_nodes,node_count:parent.node_count,borrowed_tables:true,inference_stage:parent.inference_stage,pending:t.pending,implementation_proofs:implementation_proofs,associated_remaining:blot_inference_limits::configured(),has_implementations:parent.has_implementations,has_generative_sources:parent.has_generative_sources,break_values:t.break_values,field_locations:parent.field_locations,request_cells:t.request_cells,request_handlers:t.request_handlers},Error.none;
}
fn diagnosticIdentity(self: const Session&) -> blot_support::Option<blot_backend_runtime_identity::View> { return self.diagnostic_context.identity; }
fn copySolvedTypes(values: const Mapping[:]) -> Mapping[:] { let result=solved_types.alloc_slice(values.len); for value,index in values { result[index]=value; } return result; }
fn releaseSolvedTypes(values: const Mapping[:]) { solved_types.free_slice(values); }
fn copySolvedRows(values: const RowMapping[:]) -> RowMapping[:] { let result=solved_rows.alloc_slice(values.len); for value,index in values { result[index]=value; } return result; }
fn releaseSolvedRows(values: const RowMapping[:]) { solved_rows.free_slice(values); }
fn valueInfo(self: const Session&,id: ValueId) -> ValueInfo { return self.storage.values[id]; }
fn valueChildren(self: const Session&,id: ValueId) -> const ValueId[:] { let info=valueInfo(self,id); return self.storage.children[info.start..info.start+info.len]; }
fn providerInfo(self: const Session&,id: ValueId) -> blot_backend_provider_chain::Provider { let info=valueInfo(self,id); assert(info.kind==ValueKind.provider&&info.len==1); return blot_backend_provider_chain::Provider {operation:info.bits,implementation:valueChildren(self,id)[0]}; }
fn stateProviderInfo(self: const Session&,id: ValueId) -> blot_backend_provider_chain::StateProvider { let info=valueInfo(self,id); assert(info.kind==ValueKind.state_provider&&info.len==1); return blot_backend_provider_chain::StateProvider {read:info.bits,write:info.nominal as u32,initial:valueChildren(self,id)[0]}; }
fn valueScalar(self: const Session&,id: ValueId) -> blot_support::Option<Value> { let info=valueInfo(self,id); if info.kind!=ValueKind.scalar { return blot_support::none<Value>(); } return blot_support::some(Value {info.scalar,info.bits}); }
fn constructorTag(self: const Session&,id: ValueId) -> blot_support::Option<u32> { let info=valueInfo(self,id); if info.kind!=ValueKind.nominal { return blot_support::none<u32>(); } return blot_support::some(info.bits); }
fn closureInfo(self: const Session&,id: ValueId) -> ClosureValue { let info=valueInfo(self,id); assert(info.kind==ValueKind.closure); return self.storage.closures[info.bits]; }
fn valueEvidence(self: const Session&,id: ValueId) -> u32 { return self.storage.value_evidence[id]; }
fn evidenceStore(self: Session&) -> blot_eval_type_evidence::Store& { return self.storage.evidence; }
fn evidenceView(self: const Session&) -> blot_eval_type_evidence::View { return self.storage.evidence.view(); }
fn recordFieldNames(self: const Session&,id: ValueId) -> const u32[:] { let span=self.storage.record_layouts[self.storage.value_records[id]]; return self.storage.field_names[span.start..span.start+span.len]; }
fn snapshot(self: const Session&) -> View { return self.storage.view(self.implementation_proofs.view()); }
fn copySnapshot(self: const Session&,target: blot_eval_eval_values::SnapshotTables) -> Snapshot,Error { return self.storage.copySnapshot(self.implementation_proofs,target); }
fn unitId(self: const Session&,index: i64) -> u32 { if self.units[index].unit!=0 { return self.units[index].unit; } return (index+1) as u32; }
fn unitIndex(self: const Session&,unit: u32) -> blot_support::Option<i64> {
 if self.dense_unit_ids&&unit!=0 { if unit<=self.units.len { return blot_support::some((unit-1) as i64); } return blot_support::none<i64>(); }
 for module,index in self.units { if module.unit==unit||(module.unit==0&&index+1==unit) { return blot_support::some(index); } } return blot_support::none<i64>();
}
fn fail(self: Session&,owner: i64,span: Span,code: Code) -> Error { if !self.diagnostic.present { var unit: u32=0; if owner<self.units.len { unit=unitId(self,owner); } self.diagnostic=blot_support::some(Diagnostic {unit:unit,span:span,code:code,origins:self.staging_trace}); } return Error.declined; }
fn failNode(self: Session&,owner: i64,id: u32,code: Code) -> Error { return fail(self,owner,self.units[owner].span(id),code); }
fn anchorSpecialization(self: Session&,origin: blot_support::Option<SourceLocation>) {
 if !origin.present||!self.diagnostic.present { return; } let use=origin.value; let code=self.diagnostic.value.code;
 if code!=Code.missing_associated&&code!=Code.ambiguous_associated&&code!=Code.ambiguous_operator&&code!=Code.missing_member&&code!=Code.missing_field&&code!=Code.ambiguous_qualified&&code!=Code.type_mismatch&&code!=Code.effect_mismatch&&code!=Code.invalid_provider&&code!=Code.type_constructor_required { return; }
 if self.diagnostic.value.related.present||(self.diagnostic.value.unit==use.unit&&self.diagnostic.value.span==use.span) { return; }
 self.diagnostic.value.related=blot_support::some(SourceLocation {self.diagnostic.value.unit,self.diagnostic.value.span}); self.diagnostic.value.unit=use.unit; self.diagnostic.value.span=use.span;
}
fn invocationOrigin(self: Session&,owner: i64,source: u32,dependent: bool) -> blot_support::Option<SourceLocation> { return sourceInvocationOrigin(self.specialization_origin,self.diagnostic_context.entry,unitId(self,owner),self.units[owner].span(source),dependent); }
fn dispatchContexts(self: Session&,owner: i64,id: u32,call_origin: blot_support::Option<SourceLocation>,record: DispatchRecord&) {
 if id==0||record.context_len!=0 { return; }
 if call_origin.present&&call_origin.value.unit!=0&&call_origin.value.unit<=self.units.len { let origin=call_origin.value; let caller=self.units[origin.unit-1];
  for item,index in caller.nodes { if item.tag!=CoreTag.call { continue; } let span=caller.span(index as u32); if span.start!=origin.span.start||span.end!=origin.span.end { continue; } let arguments=caller.children(index as u32); if arguments.len!=2 { continue; }
   record.contexts=[DispatchContext {DispatchContextKind.left_operand,origin.unit,caller.span(arguments[0])},DispatchContext {DispatchContextKind.right_operand,origin.unit,caller.span(arguments[1])}]; record.context_len=2; return;
  }
 }
 let module=self.units[owner]; let node=module.node(id); if node.tag!=CoreTag.associated||node.a==0||node.b==0 { return; } let unit=unitId(self,owner);
 record.contexts=[DispatchContext {DispatchContextKind.left_operand,unit,module.span(node.a)},DispatchContext {DispatchContextKind.right_operand,unit,module.span(node.b)}]; record.context_len=2;
}
fn failDispatch(self: Session&,owner: i64,id: u32,code: Code,record: DispatchRecord) -> Error { let fresh=!self.diagnostic.present; let error=failNode(self,owner,id,code); if fresh { var explained=record; dispatchContexts(self,owner,id,self.specialization_origin,explained); self.diagnostic.value.dispatch=blot_support::some(explained); } return error; }
fn findUnit(self: const Session&,id: u32,owner: blot_support::Option<i64>) -> blot_support::Option<i64> {
 if id==0 { if owner.present { return owner; } if self.units.len==1 { return blot_support::some(0 as i64); } return blot_support::none<i64>(); }
 if id<=self.units.len&&unitId(self,id-1)==id { return blot_support::some((id-1) as i64); } for index in 0..self.units.len { if unitId(self,index)==id { return blot_support::some(index); } } return blot_support::none<i64>();
}
fn target(self: Session&,owner: blot_support::Option<i64>,reference: BindingRef) -> Target,Error {
 let found=findUnit(self,reference.unit,owner); if !found.present { var location=self.units.len; if owner.present { location=owner.value; } return Target {0,0},fail(self,location,Span {0,0},Code.unsupported); }
 if reference.binding==0||reference.binding>=self.units[found.value].bindings.len { return Target {0,0},fail(self,found.value,Span {0,0},Code.unsupported); } return Target {found.value,reference.binding},Error.none;
}
fn external(self: Session&,initial: Target) -> Target,Error {
 var resolved=initial; var seen: Target[256]; var count=0;
 loop { let binding=self.units[resolved.unit].binding(resolved.binding); if binding.kind!=blot_check_check::Kind.external { return resolved,Error.none; }
  for previous in seen[..count] { if previous==resolved { return resolved,fail(self,resolved.unit,binding.span,Code.cycle); } } if count==256 { return resolved,fail(self,resolved.unit,binding.span,Code.constant_fuel); } seen[count]=resolved; count++;
  let next,error=target(self,blot_support::some(resolved.unit),binding.target); if error!=Error.none { return resolved,error; } resolved=next;
 }
}
fn slot(self: Session&,location: Target) -> Slot& { return self.slots[self.binding_offsets[location.unit]+location.binding]; }
fn bindingTraced(self: Session&,reference: BindingRef) -> bool,Error { let first,e=target(self,blot_support::none<i64>(),reference); if e!=Error.none { return false,e; } let resolved,error=external(self,first); if error!=Error.none { return false,error; } return slot(self,resolved).traced,Error.none; }
fn cachedBindingValue(self: Session&,reference: BindingRef) -> ValueId,bool,Error { let first,e=target(self,blot_support::none<i64>(),reference); if e!=Error.none { return 0,false,e; } let resolved,error=external(self,first); if error!=Error.none { return 0,false,error; } let stored=slot(self,resolved); return stored.value,stored.state==State.complete,Error.none; }
fn readyConstantAnchor(self: const Session&,reference: BindingRef) -> blot_support::Option<ValueId> {
 if reference.unit==0||reference.binding==0 { return blot_support::none<ValueId>(); } let owner=findUnit(self,reference.unit,blot_support::none<i64>()); if !owner.present { return blot_support::none<ValueId>(); }
 if reference.binding>=self.units[owner.value].bindings.len||self.units[owner.value].binding(reference.binding).kind!=blot_check_check::Kind.global { return blot_support::none<ValueId>(); }
 if self.binding_offsets[owner.value]>0x7fffffffffffffff-reference.binding { return blot_support::none<ValueId>(); } let index=self.binding_offsets[owner.value]+reference.binding; if index>=self.slots.len||self.slots[index].state!=State.complete { return blot_support::none<ValueId>(); } return blot_support::some(self.slots[index].value);
}
fn makeScalar(self: Session&,owner: i64,source: u32,value: Value) -> ValueId,Error { if value.scalar==blot_backend_runtime_ir::SC_unit { return 0,Error.none; } if constantValueCount(self)>=self.options.max_values||self.storage.values.len>=0xffffffff { return 0,failNode(self,owner,source,Code.constant_fuel); } return self.storage.scalar(value); }
fn makeAggregate(self: Session&,owner: i64,source: u32,kind: ValueKind,nominal: u64,tag: u32,children: const ValueId[:]) -> ValueId,Error {
 var available=self.options.max_children-constantChildCount(self); if available<0 { available=0; } available-=self.ragged_reserved_children; if available<0 { available=0; }
 if constantValueCount(self)>=self.options.max_values||self.storage.values.len>=0xffffffff||children.len>available||children.len>0xffffffff-self.storage.children.len { return 0,failNode(self,owner,source,Code.constant_fuel); } return self.storage.aggregate(kind,nominal,tag,children);
}
fn makeClosure(self: Session&,owner: i64,source: u32,metadata: ClosureValue,captures: const ValueId[:]) -> ValueId,Error {
 if self.storage.closures.len>=0xffffffff { return 0,failNode(self,owner,source,Code.constant_fuel); } let index=self.storage.closures.len as u32; let id,error=makeAggregate(self,owner,source,ValueKind.closure,0,index,captures); if error!=Error.none { return 0,error; } self.storage.closures.push(metadata); return id,Error.none;
}
fn copyAggregate(self: Session&,owner: i64,source: u32,original: ValueId,field: u32,replacement: ValueId) -> ValueId,Error {
 let info=valueInfo(self,original); if field>=info.len { return 0,failNode(self,owner,source,Code.unsupported); } var available=self.options.max_children-constantChildCount(self); if available<0 { available=0; }
 if constantValueCount(self)>=self.options.max_values||self.storage.values.len>=0xffffffff||info.len>available||info.len>0xffffffff-self.storage.children.len { return 0,failNode(self,owner,source,Code.constant_fuel); }
 let id=self.storage.values.len as ValueId; let start=self.storage.children.len as u32; var copy: ValueId[>..]=[]; copy.append(valueChildren(self,original)); self.storage.children.append(copy); self.storage.children[start+field]=replacement; self.storage.values.push(ValueInfo {nominal:info.nominal,start:start,len:info.len,bits:info.bits,kind:info.kind}); self.storage.value_evidence.push(valueEvidence(self,original)); self.storage.value_records.push(self.storage.value_records[original]); return id,Error.none;
}
fn copyFrozenAggregate(self: Session&,owner: i64,source: u32,original: ValueId,replacements: const FrozenCapture[:],metadata: blot_support::Option<ClosureValue>) -> ValueId,Error {
 let info=valueInfo(self,original); var available=self.options.max_children-constantChildCount(self); if available<0 { available=0; }
 if constantValueCount(self)>=self.options.max_values||self.storage.values.len>=0xffffffff||info.len>available||info.len>0xffffffff-self.storage.children.len||(metadata.present&&self.storage.closures.len>=0xffffffff) { return 0,failNode(self,owner,source,Code.constant_fuel); }
 let id=self.storage.values.len as ValueId; let start=self.storage.children.len as u32; var copy: ValueId[>..]=[]; copy.append(valueChildren(self,original)); self.storage.children.append(copy); for replacement in replacements { self.storage.children[start+replacement.slot]=replacement.value; }
 var kind=info.kind; var nominal=info.nominal; var bits=info.bits; if metadata.present { kind=ValueKind.closure; nominal=0; bits=self.storage.closures.len as u32; }
 self.storage.values.push(ValueInfo {nominal:nominal,start:start,len:info.len,bits:bits,kind:kind}); self.storage.value_evidence.push(0); self.storage.value_records.push(0); if metadata.present { self.storage.closures.push(metadata.value); }
 let origin=blot_check_staging_origins::generator(self.storage.code_origins,original); if origin.present { self.storage.code_origins.push(blot_check_staging_origins::Record {id,origin.value}); } self.counters.frozen_capture_published_bytes+=info.len*4; return id,Error.none;
}
fn chargeCells(self: Session&,owner: i64,source: u32,count: i64) -> Error { var available=self.options.max_steps-self.steps; if available<0 { available=0; } if count>available { self.steps=self.options.max_steps; return failNode(self,owner,source,Code.constant_fuel); } self.steps+=count; return Error.none; }
fn requireScalar(self: Session&,owner: i64,source: u32,id: ValueId) -> Value,Error { let value=valueScalar(self,id); if !value.present { return default<Value>(),failNode(self,owner,source,Code.unsupported); } return value.value,Error.none; }
fn implementationContext(self: const Session&,owner: i64) -> u32 { if self.specialization_origin.present { return self.specialization_origin.value.unit; } return unitId(self,owner); }
fn privateImplementationMethod(self: const Session&,owner: i64,binding: u32) -> bool {
 if !self.has_implementations { return false; } let module=self.units[owner]; for declaration in module.implementations { if !declaration.private||declaration.identity.unit!=unitId(self,owner) { continue; }
  for member in module.implementation_members[declaration.members.start..declaration.members.start+declaration.members.len] { if member.kind==blot_check_core::ImplementationMemberKind.value&&(member.target.unit==0||member.target.unit==unitId(self,owner))&&member.target.binding==binding { return true; } }
 } return false;
}
fn implementationUseContext(self: const Session&,owner: i64,source: u32) -> u32 {
 let module=self.units[owner]; for use in module.selected_uses { if use.node!=source { continue; } let proof=module.selected_proofs[use.proof]; if proof.kind==blot_check_core::SelectedProofKind.implementation { if proof.context==0 { return unitId(self,owner); } return proof.context; } }
 if self.has_implementations&&source!=0 { let span=module.span(source); for body in module.bodies { if span.start<body.span.start||span.end>body.span.end { continue; } if privateImplementationMethod(self,owner,body.binding) { return unitId(self,owner); } } } return implementationContext(self,owner);
}
fn prepare(self: Session&,reference: BindingRef) -> Error { let initial,error=target(self,blot_support::none<i64>(),reference); if error!=Error.none { return error; } return prepareWork(self,Work.binding {initial}); }
fn prepareWork(self: Session&,initial: Work) -> Error {
 if self.diagnostic.present { return Error.declined; } if self.visited_nodes.len!=self.node_count { self.visited_nodes.clear(); self.visited_nodes.resize(self.node_count,false); }
 let pending_start=self.pending.len; var work: Work[>..<]=[]; work.push(initial);
 while work.len!=0 { let item=work[work.len-1]; work.resize(work.len-1);
  match item {
   binding raw=>{ let resolved,error=external(self,raw.value); if error!=Error.none { return error; } let module=self.units[resolved.unit]; let binding=module.binding(resolved.binding); if binding.kind!=blot_check_check::Kind.global||slot(self,resolved).traced { continue; } let body=module.body(resolved.binding); if body==null { return fail(self,resolved.unit,binding.span,Code.unsupported); } if body.runtime&&!self.options.trace_runtime_dependencies { return fail(self,resolved.unit,body.span,Code.unsupported); } slot(self,resolved).traced=true; self.traced_bodies++; if !body.is_function&&!body.runtime { self.pending.push(resolved); } work.push(Work.node {resolved.unit,body.root}); },
   node operation=>{
    if operation.id==0 { continue; } let owner=operation.unit; let module=self.units[owner]; if operation.id>=module.nodes.len { return fail(self,owner,Span {0,0},Code.unsupported); } let seen=self.node_offsets[owner]+operation.id; if self.visited_nodes[seen] { continue; } self.visited_nodes[seen]=true; self.traced_nodes++; let n=module.node(operation.id);
    var lo=0; var hi=module.erased_declaration_references.len; while lo<hi { let mid=lo+(hi-lo)/2; if module.erased_declaration_references[mid].node<operation.id { lo=mid+1; } else { hi=mid; } } if lo<module.erased_declaration_references.len&&module.erased_declaration_references[lo].node==operation.id { let location,error=target(self,blot_support::some(owner),module.erased_declaration_references[lo].target); if error!=Error.none { return error; } work.push(Work.binding {location}); }
    let tag=n.tag;
    if tag==CoreTag.staging { if n.a!=0 { work.push(Work.node {owner,n.a}); } if n.b!=0 { work.push(Work.node {owner,n.b}); } }
    else if tag==CoreTag.task||tag==CoreTag.package_pack { for child in module.children(operation.id) { work.push(Work.node {owner,child}); } }
    else if tag==CoreTag.usage_share||tag==CoreTag.usage_read||tag==CoreTag.resource_release||tag==CoreTag.return_||tag==CoreTag.result_associated||tag==CoreTag.project||tag==CoreTag.computation||tag==CoreTag.effect_scope { work.push(Work.node {owner,n.a}); }
    else if tag==CoreTag.package_unpack { work.push(Work.node {owner,module.packageOpening(operation.id).body}); work.push(Work.node {owner,n.a}); }
    else if tag==CoreTag.reference { let location,error=target(self,blot_support::some(owner),module.reference(operation.id)); if error!=Error.none { return error; } work.push(Work.binding {location}); }
    else if tag==CoreTag.resource_acquire||tag==CoreTag.usage_borrow||tag==CoreTag.scalar||tag==CoreTag.logical||tag==CoreTag.associated||tag==CoreTag.record_merge||tag==CoreTag.type_same||tag==CoreTag.effect_provider||tag==CoreTag.handle||tag==CoreTag.proof_guard||tag==CoreTag.apply { if n.b!=0 { work.push(Work.node {owner,n.b}); } work.push(Work.node {owner,n.a}); }
    else if tag==CoreTag.call||tag==CoreTag.contract_method||tag==CoreTag.block_||tag==CoreTag.suite||tag==CoreTag.product||tag==CoreTag.record||tag==CoreTag.array||tag==CoreTag.array_op||tag==CoreTag.storage { let children=module.children(operation.id); var index=children.len; while index!=0 { index--; work.push(Work.node {owner,children[index]}); } if tag==CoreTag.call { let location,error=target(self,blot_support::some(owner),module.call(operation.id).target); if error!=Error.none { return error; } work.push(Work.binding {location}); } }
    else if tag==CoreTag.resource_scope||tag==CoreTag.if_value||tag==CoreTag.if_stmt||tag==CoreTag.state_provider { if n.c!=0 { work.push(Work.node {owner,n.c}); } work.push(Work.node {owner,n.b}); work.push(Work.node {owner,n.a}); }
    else if tag==CoreTag.bind { work.push(Work.node {owner,n.b}); }
    else if tag==CoreTag.construct { if n.b!=0 { work.push(Work.node {owner,n.b}); } }
    else if tag==CoreTag.closure { work.push(Work.node {owner,module.closure(operation.id).body}); }
    else if tag==CoreTag.effect_reflection { let kind,known=blot_check_check::reflectionKindFromCode(n.a); if known&&(kind==blot_check_check::ReflectionKind.count||kind==blot_check_check::ReflectionKind.has||kind==blot_check_check::ReflectionKind.same) { work.push(Work.node {owner,n.b}); } if n.c!=0 { work.push(Work.node {owner,n.c}); } }
    else if tag==CoreTag.request_decision { if n.c!=0 { work.push(Work.node {owner,n.c}); } if n.b!=0 { work.push(Work.node {owner,n.b}); } }
    else if tag==CoreTag.request_loop { let info=module.requestLoopInfo(operation.id); work.push(Work.node {owner,info.completion_body}); work.push(Work.pattern {owner,info.completion_pattern}); for arm in module.requestArms(operation.id) { work.push(Work.node {owner,arm.callback}); } work.push(Work.node {owner,info.computation}); }
    else if tag==CoreTag.resolver_op { let info=module.resolverInfo(operation.id); let children=module.resolverArguments(operation.id); var index=children.len; while index!=0 { index--; work.push(Work.node {owner,children[index]}); } work.push(Work.node {owner,info.resolver}); if info.method.binding!=0 { let location,error=target(self,blot_support::some(owner),info.method); if error!=Error.none { return error; } work.push(Work.binding {location}); } }
    else if tag==CoreTag.pattern_bind { if n.c!=0 { work.push(Work.node {owner,n.c}); } work.push(Work.pattern {owner,n.a}); work.push(Work.node {owner,n.b}); }
    else if tag==CoreTag.match_ { let arms=module.matchArms(operation.id); var a=arms.len; while a!=0 { a--; let arm=arms[a]; work.push(Work.node {owner,arm.body}); if arm.guard!=0 { work.push(Work.node {owner,arm.guard}); } let rows=module.armRows(arm); var r=rows.len; while r!=0 { r--; let patterns=module.rowPatterns(rows[r]); var p=patterns.len; while p!=0 { p--; work.push(Work.pattern {owner,patterns[p]}); } } } let inputs=module.matchInputs(operation.id); var index=inputs.len; while index!=0 { index--; work.push(Work.node {owner,inputs[index]}); } }
    else if tag==CoreTag.update { let info=module.updateInfo(operation.id); work.push(Work.node {owner,info.value}); work.push(Work.node {owner,info.root}); }
    else if tag==CoreTag.loop_ { let info=module.loopInfo(operation.id); work.push(Work.node {owner,info.body}); if info.pattern!=0 { work.push(Work.pattern {owner,info.pattern}); } if info.end!=0 { work.push(Work.node {owner,info.end}); } if info.first!=0 { work.push(Work.node {owner,info.first}); } }
    else if tag==CoreTag.break_ { let children=module.breakValues(operation.id); var index=children.len; while index!=0 { index--; work.push(Work.node {owner,children[index]}); } }
