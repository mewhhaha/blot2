effect Start: Array U32 -> U32

func planner_init (seed: U32): U32 => return seed
func planner_step (st: own U32) -> (delta: U32): (U32, U32) =>
  let next = @u32.add st delta
  return (next, next)

#process const planner: Process [U32, U32, U32] = { init: planner_init, step: planner_step }

func request (config: U32): U32 ! { Start } => return Start #[config, 112, 108, 97, 110, 110, 101, 114]

io local (config: U32): U32 => return do @effect.provider Start (func (packet: Array U32) => return packet[0]):
  use endpoint <- request config
  return endpoint

io live (host: Array U32 -> U32 ! { Foreign }) => return do @effect.provider Start host:
  use endpoint <- request 11
  return endpoint

io twice (xs: Array U32): Array U32 => return spark #[@u32.mul x 2 | x <- xs]
io spark_mix (xs: Array U32): Array U32 => return spark #[@u32.bit_xor (@u32.mul x 1664525) 1013904223 | x <- xs]
io ordinary_mix (xs: Array U32): Array U32 => return #[@u32.bit_xor (@u32.mul x 1664525) 1013904223 | x <- xs]
io indexed_mix (xs: Array U32): Array U32 => return @array.generate xs.length (func i => return @u32.bit_xor (@u32.mul xs[i] 1664525) 1013904223)

#kernel func mix_kernel (x: U32): U32 => return @u32.bit_xor (@u32.mul x 1664525) 1013904223
