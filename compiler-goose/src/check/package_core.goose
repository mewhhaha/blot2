types.node(binders[index*2+1]).tag!=blot_check_types::Tag.scoped {return Error.invalid_artifact;}let error=self.scopes.visit(binders[index*2]);if error!=Error.none {return error;}let error=self.scopes.visit(binders[index*2+1]);if error!=Error.none {return error;}}return Error.none;}
fn rowVariable(types:const blot_check_core::Types&,row:u32)->u32 {match types.row(row).tail {blot_check_effects::Tail.variable value=>{return value.value;},_=>{abort("row variable index contains a closed row");},}}
