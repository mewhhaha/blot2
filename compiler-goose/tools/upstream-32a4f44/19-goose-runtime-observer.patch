diff --color -ru source-precision/src/runtime/runtime.h source-observer/src/runtime/runtime.h
--- a/src/runtime/runtime.h	2026-11-11 18:19:47.419433487 +0100
+++ b/src/runtime/runtime.h	2026-11-12 00:26:13.194601912 +0100
@@ -173,6 +173,24 @@
 #define GS_API static
 #endif
 
+/* Private observation ABI. Callbacks must allocate nothing; a refusal callback
+   must terminate the candidate rather than resume a half-mutated pool. */
+enum {
+    GS_OBS_POOL_ALLOC = 1, GS_OBS_POOL_REALLOC = 2, GS_OBS_POOL_FREE = 3,
+    GS_OBS_REGION_RESERVE = 4, GS_OBS_REGISTRY_ALLOC = 5,
+    GS_OBS_STACK_REQUEST = 6, GS_OBS_REGION_RELEASE = 7,
+    GS_OBS_POOL_CAPACITY_GROW = 8, GS_OBS_POOL_REUSE = 9
+};
+typedef void (*gs_observer_event_fn)(int, uint64_t, uint64_t, uint64_t, uint64_t);
+typedef int (*gs_observer_try_fn)(int, uint64_t, uint64_t);
+typedef void (*gs_observer_oom_fn)(int, uint64_t);
+GS_API void gs_runtime_observer_install(gs_observer_event_fn event,
+    gs_observer_try_fn attempt, gs_observer_oom_fn oom);
+GS_API void gs_observer_attempt(int kind, uint64_t owner, uint64_t bytes);
+GS_API void gs_observer_pool_commit(int kind, uint64_t owner, uint64_t old_bytes,
+    uint64_t new_bytes, uint64_t before, uint64_t after);
+GS_API void gs_observer_stack_request(const void *stack, const uint8_t *at, uint64_t n);
+
 #define GS_CAT_(a, b) a##b
 #define GS_CAT(a, b) GS_CAT_(a, b)
 #ifdef GS_RUNTIME_VERSION
diff --color -ru source-precision/src/runtime/runtime_impl.h source-observer/src/runtime/runtime_impl.h
--- a/src/runtime/runtime_impl.h	2026-11-11 18:19:47.419433487 +0100
+++ b/src/runtime/runtime_impl.h	2026-11-12 00:26:13.217018674 +0100
@@ -54,6 +54,37 @@
     gs_end(1);
 }
 
+static gs_observer_event_fn gs_observer_event;
+static gs_observer_try_fn gs_observer_try;
+static gs_observer_oom_fn gs_observer_refusal;
+
+GS_API void gs_runtime_observer_install(gs_observer_event_fn event,
+    gs_observer_try_fn attempt, gs_observer_oom_fn oom) {
+    gs_observer_event = event;
+    gs_observer_try = attempt;
+    gs_observer_refusal = oom;
+}
+
+/* Only explicit allocator refusals or selected synthetic mutation failpoints
+   reach this path. Generic panic, invalid sizes and signals never do. */
+static GS_NORETURN void gs_observer_oom(int kind, uint64_t bytes) {
+    if (gs_observer_refusal) gs_observer_refusal(kind, bytes);
+    gs_panic("out of memory at observed allocation");
+}
+GS_API void gs_observer_attempt(int kind, uint64_t owner, uint64_t bytes) {
+    if (gs_observer_try && gs_observer_try(kind, owner, bytes))
+        gs_observer_oom(kind, bytes);
+}
+GS_API void gs_observer_pool_commit(int kind, uint64_t owner, uint64_t old_bytes,
+    uint64_t new_bytes, uint64_t before, uint64_t after) {
+    if (!gs_observer_event) return;
+    gs_observer_event(kind, owner, old_bytes, new_bytes, after);
+    if (after > before)
+        gs_observer_event(GS_OBS_POOL_CAPACITY_GROW, owner, before, after, 0);
+    else if (new_bytes > old_bytes)
+        gs_observer_event(GS_OBS_POOL_REUSE, owner, 0, new_bytes - old_bytes, 0);
+}
+
 /* Where an abort in a contained worker returns to (gs_run_contained), and
    the message it leaves there for thread_wait; NULL on every other thread. */
 typedef struct {
@@ -215,6 +246,26 @@
    worked it out, so a reservation past it is a compiler bug. */
 static GS_TLS long gs_regions_cap;
 
+/* Explicit requests are observed even on native mmap-backed data stacks.
+   This is requested capacity, not committed physical pages or scratch liveness.
+   The checks classify malformed sizes as runtime bugs, never as OOM. */
+GS_API void gs_observer_stack_request(const void *stack, const uint8_t *at, uint64_t n) {
+    if (!gs_observer_try && !gs_observer_event) return;
+    for (long i = 0; i < gs_nregions; i++) {
+        const gs_region *r = &gs_regions[i];
+        if (r->stack != stack) continue;
+        uintptr_t offset = (uintptr_t)at - (uintptr_t)r->base;
+        if (offset > r->usable || n > r->usable - offset)
+            gs_panic("data stack overflow: observed capacity request outside region");
+        if (n) gs_observer_attempt(GS_OBS_STACK_REQUEST, (uint64_t)(uintptr_t)stack, n);
+        if (gs_observer_event)
+            gs_observer_event(GS_OBS_STACK_REQUEST, (uint64_t)(uintptr_t)stack,
+                offset, n, r->usable);
+        return;
+    }
+    gs_panic("observed capacity request uses an unregistered stack");
+}
+
