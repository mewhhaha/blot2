    if !artifact.present {return false,blot_error::Error.invalid_path;}var inputs=blot_reuse_project::FileInputs{..};var bytes:u8[>..<]=[];let error=inputs.read(artifact.value,67108864+212,bytes);if error!=blot_error::Error.none {return false,error;}metrics.artifact_bytes=bytes.len;var stats=blot_reuse_dependency_project_loader::Stats{..};var frozen,error=blot_reuse_dependency_project_loader::load(inputs,bytes[..],compiler,settings(options),options,stats);bytes.clear();if error!=blot_error::Error.none {return false,error;}let result,failure=buildLoaded(executor,workspace,writer,entry,output,artifact.value,options,frozen,stats,metrics,backend_options);frozen.deinit();return result,failure;
}
fn buildLoaded<E,S>(executor:E&,workspace:Workspace&,writer:S&,entry:const u8[:],output:const u8[:],artifact:const u8[:],options:Options,frozen:OwnedFrozen&,stats:blot_reuse_dependency_project_loader::Stats,metrics:Metrics&,backend_options:CompileOptions)->bool,Error {
    metrics.decode_us=stats.decode_us;metrics.validation_us=stats.validation_us;metrics.source_us=stats.source_us;metrics.source_bytes=stats.source_bytes;payloadMetrics(frozen.value,metrics);var inputs=blot_reuse_project::FileInputs{..};var entry_identity:u8[>..<]=[];let error=inputs.canonical(entry,entry_identity);if error!=blot_error::Error.none {return false,error;}var destination:u8[>..<]=[];let exists,error=existingOutput(output,destination);if error!=blot_error::Error.none {return false,error;}if exists {if destination==entry_identity {return false,blot_error::Error.output_is_source;}for module in frozen.value.modules {if destination==module.identity.normalized_path {return false,blot_error::Error.output_is_source;}}var artifact_identity:u8[>..<]=[];let error=inputs.canonical(artifact,artifact_identity);if error!=blot_error::Error.none {return false,error;}if destination==artifact_identity {return false,blot_error::Error.output_is_artifact;}}
    var protected_output=blot_support::none<const u8[:]>();if exists {protected_output=blot_support::some<const u8[:]>(destination[..]);}let at=blot_native::clock_ns();var composed,error=blot_reuse_partial_dependency::compileOwnedWithOptions(executor,workspace,entry_identity[..],protected_output,options,frozen,backend_options);if error!=blot_error::Error.none {return false,error;}metrics.source_bytes=composed.source_bytes;metrics.cached_modules=composed.cached_modules;metrics.fresh_modules=composed.fresh_modules;metrics.compile_us=elapsed(at);metrics.syntax_nodes=composed.result.stats.syntax_nodes;metrics.body_elaborations=composed.result.stats.body_elaborations;metrics.body_lowerings=composed.result.stats.body_lowerings;
    let rejected,error=writeResultDiagnostics(writer,composed,entry_identity);if error!=blot_error::Error.none || rejected {composed.deinit();return false,error;}metrics.wasm_bytes=composed.result.compiled.bytes.len;let error=publish(output,composed.result.compiled.bytes.items);composed.deinit();return error==blot_error::Error.none,error;
}
fn writeResultDiagnostics<S>(writer:S&,result:blot_reuse_partial_dependency::Result&,entry:const u8[:])->bool,Error {
    var rejected=false;var filename=entry;if result.diagnostic_filename.present {filename=result.diagnostic_filename.value;}if result.result.diagnostic.present {let error=result.result.diagnostic.value.write(writer,filename);if error!=blot_error::Error.none {return false,error;}rejected=true;}
    if result.result.compiled.diagnostic.present {let issue=result.result.compiled.diagnostic.value;var code:const u8[:]="";match issue.code {const for <N,V> in variants<blot_backend_core_backend::Code> {V=>{code=N;},}}var bytes:u8[>..]=[];var json=blot_json::Writer{out:bytes,options:blot_json::Options{..},..};json.beginObject();json.field("kind","diagnostic");json.field("filename",filename);json.field("stage","emit");json.field("unit",issue.unit);json.field("code",code);json.field("start",issue.span.start);json.field("end",issue.span.end);json.field("message",issue.message());json.key("related");if issue.related.present {if !result.related_filename.present {return false,blot_error::Error.missing_related_filename;}json.write(blot_check_diagnostic_location::init(result.related_filename.value,issue.related.value.span));}else {json.nullValue();}json.key("details");if result.result.compiled.explanation!=null {json.beginObject();json.field("explanation",result.result.compiled.explanation);json.endObject();}else {json.nullValue();}if result.origins.entries.len!=0 {json.field("origins",result.origins.entries);}json.endObject();if json.failure!=blot_error::Error.none {return false,json.failure;}bytes.push('\n');let error=writer.writeAll(bytes[..]);if error!=blot_error::Error.none {return false,error;}rejected=true;}return rejected,blot_error::Error.none;
}
struct FailureWire {kind:const u8[:]="diagnostic",filename:const u8[:],stage:const u8[:]="dependencies",code:const u8[:],start:u32=0,end:u32=0,message:const u8[:]="Dependency artifact operation declined; no source fallback performed"}
struct MetricsWire {kind:const u8[:]="cache_metrics",compiler_identity:const u8[:],operation:const u8[:],filename:const u8[:],success:bool,error_name:Text,total_us:i64,work:Metrics,memory:blot_runtime_memory::Counts}
fn processWithOptions<E,S>(executor:E&,workspace:Workspace&,writer:S&,create:bool,entry:const u8[:],output:const u8[:],artifact:Text,options:Options,compiler:Digest,backend_options:CompileOptions)->bool,Error {
    var metrics=Metrics{..};let started=blot_native::clock_ns();let success,failure=work(executor,workspace,writer,create,entry,output,artifact,options,compiler,metrics,backend_options);var error_name=blot_support::none<const u8[:]>();if failure!=blot_error::Error.none {error_name=blot_support::some(blot_error::error_name(failure));let error=emit(writer,FailureWire{filename:entry,code:error_name.value,..});if error!=blot_error::Error.none {return false,error;}}
    var identity:u8[64]=[0;64];let digits="0123456789abcdef";for byte,index in compiler {identity[index*2]=digits[byte>>4];identity[index*2+1]=digits[byte&15];}var operation:const u8[:]="build";if create {operation="create";}let error=emit(writer,MetricsWire{compiler_identity:identity[..],operation:operation,filename:entry,success:success,error_name:error_name,total_us:elapsed(started),work:metrics,memory:blot_runtime_memory::Counts{..},..});return success,error;
}
fn process<E,S>(executor:E&,workspace:Workspace&,writer:S&,create:bool,entry:const u8[:],output:const u8[:],artifact:Text,options:Options,compiler:Digest)->bool,Error {return processWithOptions(executor,workspace,writer,create,entry,output,artifact,options,compiler,CompileOptions{..});}

fn selectedSetting(value:blot_support::Option<const u8[:]>)->const u8[:] {if value.present {return value.value;}return default<const u8[:]>();}
