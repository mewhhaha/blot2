fn Engine::operationApplication(self:Engine&,id:u32)->blot_support::Option<u32>,blot_error::Error {var head=id;loop {let syntax=self.tree.node(head);if syntax.tag==blot_parse_ast::tag_group {head=syntax.a;continue;}if syntax.tag!=blot_parse_ast::tag_apply {break;}head=syntax.a;}if self.tree.node(head).tag!=blot_parse_ast::tag_name {return blot_support::none<u32>(),blot_error::Error.none;}let template,err=self.operationTemplate(self.tree.node(head).a);if err!=blot_error::Error.none || !template.present {return blot_support::none<u32>(),err;}let family=self.effect_families[self.effect_templates[template.value].family];if family.parameters.len==0 {return blot_support::none<u32>(),blot_error::Error.none;}var reverse=IdBuffer{};var arguments=IdBuffer{};let result,error=operationApplications(self,id,template.value,family,reverse,arguments);arguments.deinit(equation_type_ids);reverse.deinit(equation_type_ids);return result,error;}
fn operationApplications(self:Engine&,id:u32,template:u32,family:EffectFamily,reverse:IdBuffer&,arguments:IdBuffer&)->blot_support::Option<u32>,blot_error::Error {let count=family.parameters.len;var probe=id;loop {let syntax=self.tree.node(probe);if syntax.tag==blot_parse_ast::tag_group {probe=syntax.a;continue;}if syntax.tag!=blot_parse_ast::tag_apply {break;}let err=reverse.append(probe);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}probe=syntax.a;}if reverse.items.len<count {return blot_support::none<u32>(),blot_error::Error.none;}reverseIds(reverse.items);let runtime=reverse.items.len>=count*2;for application,ordinal in reverse.items[..count] {let syntax=self.tree.node(application).b;let possible,err=self.possibleParameterArgument(self.parameter_patterns.list(family.patterns)[ordinal],syntax,runtime,0);if err!=blot_error::Error.none || !possible {return blot_support::none<u32>(),err;}let err=arguments.append(syntax);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}}if reverse.items.len>count {let possible,err=self.possibleOperationType(self.tree.node(reverse.items[count]).b,false,0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if possible {let err=self.diagnostic(Code.type_arity,id);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let root,err=self.types.fresh();return blot_support::some(root),err;}}let specialized=reverse.items[count-1];let initial,err=self.operationValue(specialized,template,blot_support::some(arguments.items));if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}var ty=initial;self.expr_types[specialized]=ty;for application in reverse.items[count..] {let syntax=self.tree.node(application);let argument,err=self.checkArgument(syntax.b);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if self.active_effect_scopes!=0 {let footprint,err=self.scopeFootprint(argument,0);if err!=blot_error::Error.none {return blot_support::