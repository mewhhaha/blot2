fn principalInstantiated(self:Walker&,owner:const Module&,binding:u32,declaration:blot_check_core::Binding,endpoint:blot_check_types::Scheme,proof:Principal&)->Error {let error=self.instantiatedGoals(owner,binding,declaration.scheme,proof,0);if error!=Error.none {return error;}if self.admission.source_bodies && self.scopes.source_instances {for witness in proof.scheme_row_witnesses[..endpoint.row_variables.len] {let error=self.step(0);if error!=Error.none {return error;}if !witness.present {continue;}match self.module.types.row(witness.value.row).tail {blot_check_effects::Tail.variable tail=>{let error=self.scopes.instance_rows.set(tail.value);if error!=Error.none {return error;}},_=>{},}}}proof.instance=List{};proof.instance_rows=List{};for witness in proof.witnesses[..endpoint.variables.len] {if witness==0 {continue;}if declaration.capability_flow==blot_check_check::CapabilityFlow.identity || declaration.capability_flow==blot_check_check::CapabilityFlow.consume_task || declaration.capability_flow==blot_check_check::CapabilityFlow.spawn_task {continue;}let usage,error=self.containsUsage(witness);if error!=Error.none {return error;}if usage {return Error.invalid_artifact;}}if self.admission.source_bodies && self.scopes.source_instances {for witness in proof.witnesses[..endpoint.variables.len] {if witness!=0 {let error=self.scopes.sourceInstance(witness,0);if error!=Error.none {return error;}}}}return Error.none;}
fn Walker::invocationVersions(self:Walker&,owner:const Module&,reference:blot_check_core::BindingRef,expected:u32,pairs:blot_check_package_contracts::VersionPair[:])->i64,Error {let scheme=owner.binding(reference.binding).scheme;if scheme.generative.len==0 || self.call_owner==0 {return 0,Error.none;}let call=blot_check_capability_flow::coreCall(self.module,self.call_owner);if !call.present || call.value.target!=reference || call.value.signature!=expected {return 0,Error.none;}let initialized,error=blot_check_generative_relocation::init(owner,self.module,scheme,call.value.signature,self.module.typeOf(self.call_owner),call.value.len,self.module.span(self.call_owner).end+1);if error!=Error.none {return 0,error;}var relation=initialized;if self.module.node(self.call_owner).tag==blot_check_core::Tag.apply {let error=relation.applications(self.call_owner);if error!=Error.none {return 0,error;}}let used=65536-relation.remaining;if used>self.scopes.remaining {return 0,Error.invalid_artifact;}self.scopes.remaining-=used;for pair,index in relation.fresh_pairs[..relation.fresh_pair_len] {pairs[index]=blot_check_package_contracts::VersionPair{left:owner.types.node(pair.before),right:self.module.types.node(pair.after)};}return relation.fresh_pair_len,Error.none;}
struct ImportMaps {mapping:blot_check_check_scheme_import::WordMap=blot_check_check_scheme_import::WordMap{},row_variables:blot_check_check_scheme_import::WordMap=blot_check_check_scheme_import::WordMap{},rows:blot_check_check_scheme_import::WordMap=blot_check_check_scheme_import::WordMap{},labels:blot_check_check_scheme_import::WordMap=blot_check_check_scheme_import::WordMap{},scopes:blot_check_check_scheme_import::WordMap=blot_check_check_scheme_import::WordMap{}}
