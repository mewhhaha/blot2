            let at,at_error = elementIndex(self_,module,id,args[0],start); if at_error != blot_error::Error.none { return Value {..},at_error; } let address = out.temp(); out.value(args[0].token); out.value(args[0].epoch_low); out.value(args[0].epoch_high); out.value(args[0].word); out.value(at); out.call(self_.runtime.functions.address); out.set(address); if out.failure != blot_error::Error.none { return Value {..},out.failure; }
            if op == blot_backend_collection_ops::Op.simd_store { let vector,error = vectorLocal(self_,module,id,args[2]); if error != blot_error::Error.none { return Value {..},error; } if self_.metadata.values[args[2].fields.start].floating != element.floating { return Value {..},unsupported(self_,module,id); } out.value(address); out.value(vector); out.op(blot_backend_runtime_ir::OP_v128_store); if out.failure != blot_error::Error.none { return Value {..},out.failure; } return args[0],blot_error::Error.none; }
            let vector_id,vector_error = self_.module.addLocal(self_.c.function,blot_backend_runtime_ir::VT_v128); if vector_error != blot_error::Error.none { return Value {..},vector_error; } let vector = Local { id: vector_id , ..}; out.value(address); out.op(blot_backend_runtime_ir::OP_v128_load); out.set(vector); if out.failure != blot_error::Error.none { return Value {..},out.failure; }
            let result_shape,shape_error = shape(self_,module,id,module.typeOf(id),0); if shape_error != blot_error::Error.none { return Value {..},shape_error; } let result,result_error = temporary(self_,result_shape); if result_error != blot_error::Error.none { return Value {..},result_error; } for lane in 0..result.fields.len { let field = self_.metadata.values[result.fields.start + lane]; out.value(vector); out.op(blot_backend_runtime_ir::OP_i32x4_extract_lane,lane as u32); out.set(field.word); } if out.failure != blot_error::Error.none { return Value {..},out.failure; } return result,blot_error::Error.none;
        },
