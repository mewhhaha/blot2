// Small geometry values. Import the types; their operators follow their owner.
type Vec2 is data = $Vec2 { x: F32, y: F32 }
type Vec3 is data = $Vec3 { x: F32, y: F32, z: F32 }

func Vec2.add (a: Vec2) -> (b: Vec2): Vec2 => return
  $Vec2 { x: a.x + b.x, y: a.y + b.y }
func Vec2.sub (a: Vec2) -> (b: Vec2): Vec2 => return
  $Vec2 { x: a.x - b.x, y: a.y - b.y }
func Vec2.mul (value: Vec2) -> (scale: F32): Vec2 => return
  $Vec2 { x: value.x * scale, y: value.y * scale }
func Vec2.div (value: Vec2) -> (scale: F32): Vec2 => return
  $Vec2 { x: value.x / scale, y: value.y / scale }
func Vec2.lerp (a: Vec2) -> (b: Vec2) -> (weight: F32): Vec2 => return
  $Vec2 { x: F32.lerp a.x b.x weight, y: F32.lerp a.y b.y weight }
func Vec2.dot (a: Vec2) -> (b: Vec2): F32 => return a.x * b.x + a.y * b.y
func Vec2.length_squared value => return Vec2.dot value value
func Vec2.length value => return sqrt (Vec2.length_squared value)
// Zero normalizes to zero. Other inputs follow F32 arithmetic.
func Vec2.normalized value => return do:
  let length = Vec2.length value
  break if length == 0.0 then value else value / length

func Vec3.add (a: Vec3) -> (b: Vec3): Vec3 => return
  $Vec3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
func Vec3.sub (a: Vec3) -> (b: Vec3): Vec3 => return
  $Vec3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }
func Vec3.mul (value: Vec3) -> (scale: F32): Vec3 => return
  $Vec3 { x: value.x * scale, y: value.y * scale, z: value.z * scale }
func Vec3.div (value: Vec3) -> (scale: F32): Vec3 => return
  $Vec3 { x: value.x / scale, y: value.y / scale, z: value.z / scale }
func Vec3.lerp (a: Vec3) -> (b: Vec3) -> (weight: F32): Vec3 => return
  $Vec3 { x: F32.lerp a.x b.x weight, y: F32.lerp a.y b.y weight, z: F32.lerp a.z b.z weight }
func Vec3.dot (a: Vec3) -> (b: Vec3): F32 => return a.x * b.x + a.y * b.y + a.z * b.z
func Vec3.cross (a: Vec3) -> (b: Vec3): Vec3 => return $Vec3 {
  x: a.y * b.z - a.z * b.y,
  y: a.z * b.x - a.x * b.z,
  z: a.x * b.y - a.y * b.x,
}
func Vec3.length_squared value => return Vec3.dot value value
func Vec3.length value => return sqrt (Vec3.length_squared value)
func Vec3.normalized value => return do:
  let length = Vec3.length value
  break if length == 0.0 then value else value / length
