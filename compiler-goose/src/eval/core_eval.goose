struct StageScope { session: Session&,previous: blot_work_counters::InferenceStage }
fn deinit(self_: StageScope) { self_.session.inference_stage=self_.previous; }
fn enterInferenceStage(self_: Session&,stage: blot_work_counters::InferenceStage) -> StageScope { let result=StageScope {self_,self_.inference_stage}; self_.inference_stage=stage; return result; }
fn slotStateCode(state: State) -> u8 { match state { unseen=>0,evaluating=>1,complete=>2, } }
fn recordingConstant(self_: const Session&) -> bool { if self_.constant_recorder==null { return false; } return requireReference(self_.constant_recorder).eligible; }
fn declineConstant(self_: Session&) { if self_.constant_recorder { requireReference(self_.constant_recorder).eligible=false; } self_.constant_recorder .= null; }
fn observeConstantInference(self_: Session&) { if self_.constant_inference_serial!=0xffffffffffffffff { self_.constant_inference_serial++; } declineConstant(self_); }
fn satAdd(a: i64,b: i64) -> i64 { if b>0x7fffffffffffffff-a { return 0x7fffffffffffffff; } return a+b; }
fn constantValueCount(self_: const Session&) -> i64 { return satAdd(self_.storage.values.len,self_.constant_value_debt); }
fn constantChildCount(self_: const Session&) -> i64 { return satAdd(self_.storage.children.len,self_.constant_child_debt); }
fn summaryLimit(self_: const Session&) -> i64 { if self_.semantic_job_budget.present&&self_.semantic_job_budget.value<self_.options.max_summary_transitions { return self_.semantic_job_budget.value; } return self_.options.max_summary_transitions; }
fn summaryCharge(self_: Session&,count: i64) -> bool { if self_.summary_exhausted { return false; } var available=summaryLimit(self_)-self_.summary_transitions; if available<0 { available=0; } if count>available { self_.summary_exhausted=true; return false; } self_.summary_transitions+=count; return true; }
