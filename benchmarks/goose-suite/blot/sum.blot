// Control benchmark: build a flat U32 array of N values in [0, 1000),
// then scan it 8 times accumulating sum(x ^ p).
import * as rng from "./rng"

const BENCH_N: U32 = 1000000 // BENCH_N
const PASSES: U32 = 8

io bench (): #[U32] =>
  let arr: #[U32] = #[]
  let r = rng.u64_from_u32 12345
  for _ in 0 .. BENCH_N:
    r := rng.xs_next self
    arr := self.push (rng.xs_mod_small r 1000)

  let total = rng.u64_zero ()
  for p in 0 .. PASSES:
    let chunk: U32 = 0
    let count: U32 = 0
    for i in 0 .. arr.length:
      chunk := self + (arr[i] ^ p)
      count := self + 1
      if count == 2097152:
        total := rng.u64_add_u32 self chunk
        chunk := 0
        count := 0
    if count > 0:
      total := rng.u64_add_u32 self chunk

  let out: #[U32] = #[]
  out := rng.emit_u32 self arr.length
  out := rng.emit_i64 self total
  return out
