fn require(ok:bool)->Error {if !ok {return blot_error::Error.invalid_artifact;}return blot_error::Error.none;}
struct ModuleCatalog {references:const ModuleRef[:]=default<const ModuleRef[:]>(),modules:const Module[:]=default<const Module[:]>()}
fn len(self_:ModuleCatalog)->i64 {if self_.modules.len!=0 {return self_.modules.len;}return self_.references.len;}
fn at(self_:ModuleCatalog,index:i64)->const Module& {if self_.modules.len!=0 {return self_.modules[index];}return self_.references[index].value;}
fn sameModule(left:const Module&,right:const Module&)->bool {return left.owner_id!=0 && left.owner_id==right.owner_id;}
fn sameHeader(left:const Module&,right:const Module&)->bool {return sameModule(left,right) && left==right;}
struct TargetKey {unit:u32,target_unit:u32,target_binding:u32}
struct FactKey {unit:u32,root:u32}
struct HeaderKey {producer:blot_check_core::BindingRef,kind:blot_check_types::ObligationKind,name:u32,operator:blot_check_types::Operator,identity:blot_check_types::NominalIdentity}
fn hash(key:TargetKey)->u64 {return ::hash_combine(::hash_combine(::hash(key.unit),::hash(key.target_unit)),::hash(key.target_binding));}
fn hash(key:FactKey)->u64 {return ::hash_combine(::hash(key.unit),::hash(key.root));}
fn hash(key:HeaderKey)->u64 {
 var value=blot_check_core::hash(key.producer);
 value=::hash_combine(value,::hash(blot_check_types::obligationKindCode(key.kind)));
 value=::hash_combine(value,::hash(key.name));
 value=::hash_combine(value,::hash(blot_check_types::operatorCode(key.operator)));
 value=::hash_combine(value,::hash(key.identity.unit));
 return ::hash_combine(value,::hash(key.identity.decl));
}
struct Completed {count:i64=0,slots:dictionary_slot<blot_check_core::BindingRef,bool>[:]=default<dictionary_slot<blot_check_core::BindingRef,bool>[:]>()}
reusable[] var completed_slots:dictionary_slot<blot_check_core::BindingRef,bool>[>..];
fn get(self_:const Completed&,key:blot_check_core::BindingRef)->bool? {return blot_support_pooled_map::get(self_,key);}
fn contains(self_:const Completed&,key:blot_check_core::BindingRef)->bool {return blot_support_pooled_map::contains(self_,key);}
fn insert(self_:Completed&,key:blot_check_core::BindingRef,value:bool)->bool {return blot_support_pooled_map::insert(self_,key,value,completed_slots);}
fn deinit(self_:Completed&) {blot_support_pooled_map::deinit(self_,completed_slots);}
fn reserve(self_:Completed&,extra:i64)->Error {if extra<0 || extra>0x1555555555555555-self_.count {return blot_error::Error.out_of_memory;}let needed=self_.count+extra;var capacity=max(8,self_.slots.len);while needed*3>capacity*2 {if capacity>0x2000000000000000 {return blot_error::Error.out_of_memory;}capacity*=2;}if capacity!=self_.slots.len {blot_support_pooled_map::grow(self_,capacity,completed_slots);}return blot_error::Error.none;}
struct Targets {count:i64=0,slots:dictionary_slot<TargetKey,const u32[:]>[:]=default<dictionary_slot<TargetKey,const u32[:]>[:]>()}
reusable[] var targets_slots:dictionary_slot<TargetKey,const u32[:]>[>..];
