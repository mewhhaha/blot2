fn replayEmission<G>(self:State&,g:G&,record:blot_reuse_artifact_emitter::Record,request:Request,job:u32)->Error {match record.event {
 EmitEvent.signature item=>{let value,error=self.signature(g,item.id);return error;},
 EmitEvent.function item=>{let fact=self.old.emission.functions[item.id];if fact.owner!=0 || self.staticHelper(fact,record.owner) {let signature,error=self.signature(g,item.signature);if error!=Error.none {return error;}let actual,error=g.module.addTypedFunctionForSignature(signature,item.result_role);if error!=Error.none {return error;}self.functions[item.id]=actual;if fact.owner!=0 {return g.publishRetained(request,actual);}return g.publishRetainedStatic(actual);}return self.ensureRuntimeFunction(g,fact.role);},
