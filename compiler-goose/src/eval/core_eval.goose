struct PublicRequirements { region: ClosureRegion&,visited: dictionary<Target,HeaderAnalysis>&,pending: HeaderVisit[>..<]&,slots: i64=0,published: bool=false,result: blot_support::Option<HeaderParts>=blot_support::none<HeaderParts>() }
fn publicRequirements(self: ClosureRegion&,root: Target) -> blot_support::Option<HeaderParts>,Error { let store: CallSummaries&=self.session.specializations.call_summaries; let known=store.public_requirements.get(root); if known { return blot_support::some<HeaderParts>(known),Error.none; } if store.public_requirements.count>=self.session.options.max_values { return blot_support::none<HeaderParts>(),Error.none; } var visited: dictionary<Target,HeaderAnalysis>; var pending: HeaderVisit[>..<]=[]; var context=PublicRequirements {self,visited,pending}; let error=publicRequirementsInner(context,root); if !context.published { for entry in visited.slots { if entry.tag!=0 { header_masks_pool.free_slice(entry.val.header.mask); } } } return context.result,error; }
fn addHeaderAnalysis(context: PublicRequirements&,target: Target) -> bool { let binding=context.region.session.units[target.unit].binding(target.binding); if binding.public_variables.len>0x7fffffffffffffff-binding.public_rows.len { return false; } let count=binding.public_variables.len+binding.public_rows.len; let store: CallSummaries&=context.region.session.specializations.call_summaries; var room=context.region.session.options.max_children-store.public_requirement_slots; if room<0 { room=0; } if context.slots>room||count>room-context.slots { return false; } let mask=header_masks_pool.alloc_slice(count); for index in 0..count { mask[index]=false; } context.visited.insert(target,HeaderAnalysis {HeaderParts {mask}}); context.slots+=count; context.pending.push(HeaderVisit {target}); return true; }
fn publicRequirementsInner(context: PublicRequirements&,root: Target) -> Error { let self: ClosureRegion&=context.region; let store: CallSummaries&=self.session.specializations.call_summaries; if !addHeaderAnalysis(context,root) { return Error.none; } var edges=0; while context.pending.len!=0 { let last=context.pending.len-1; let frame=context.pending[last]; let module=self.session.units[frame.target.unit]; let scheme=module.binding(frame.target.binding).scheme; if frame.next==scheme.obligations.len { let entry .= context.visited.get(frame.target); assert(entry!=null); entry.complete=true; context.pending.resize(last); continue; } edges++; if edges>self.session.options.max_children { return Error.none; } let requirement=module.obligations[scheme.obligations.start+frame.next];
 if requirement.kind==blot_check_types::ObligationKind.callee_use { let child,error=schemeTarget(self,frame.target.unit,requirement.identity); if error!=Error.none { return error; } let child_binding=self.session.units[child.unit].binding(child.binding); if !child_binding.has_explicit { context.pending[last].next++; continue; } var child_parts=blot_support::none<HeaderParts>(); let known=store.public_requirements.get(child); if known { child_parts=blot_support::some<HeaderParts>(known); } else { let visited=context.visited.get(child); if visited { if !visited.complete { return Error.none; } child_parts=blot_support::some(visited.header); } else { var room=self.session.options.max_values-store.public_requirements.count; if room<0 { room=0; } if context.visited.count>=room||!addHeaderAnalysis(context,child) { return Error.none; } continue; } } let product=module.types.node(requirement.ty); if product.tag!=TypeTag.product||product.b!=child_parts.value.mask.len { return Error.unresolved_type; } let parts .= context.visited.get(frame.target); assert(parts!=null); parts.header.has_private=parts.header.has_private||child_parts.value.has_private; for operand,index in module.types.list(blot_check_types::List {product.a,product.b}) { if !child_parts.value.mask[index] { continue; } let accepted,e=publicRequirementOperand(self,frame.target,operand,parts.header); if e!=Error.none||!accepted { return e; } }
 } else if requirement.explicit { for operand in [requirement.ty,requirement.other,requirement.result,requirement.signature] { if operand!=0&&operand==requirement.signature&&autonomousRowCarrier(self,frame.target,requirement) { continue; } if operand==0 { continue; } let parts .= context.visited.get(frame.target); assert(parts!=null); let accepted,error=publicRequirementOperand(self,frame.target,operand,parts.header); if error!=Error.none||!accepted { return error; } } } context.pending[last].next++;
 } var room=self.session.options.max_values-store.public_requirements.count; if room<0 { room=0; } if context.visited.count>room { return Error.none; } for entry in context.visited.slots { if entry.tag!=0 { store.public_requirements.insert(entry.key,entry.val.header); } } store.public_requirement_slots+=context.slots; context.published=true; let result=store.public_requirements.get(root); assert(result!=null); context.result=blot_support::some<HeaderParts>(result); return Error.none; }
