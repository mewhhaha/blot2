] {let old=typed_dispatch::compile(s);let new=primary_dispatch::compile(s);if old.status==0 {both+=1;assert(primary_dispatch::previous_recognizes(s));let failed=primary_dispatch::compile_with_fault(s,7);assert(failed.status!=0 && failed.wasm.len==0);if new.status!=0 {old_only+=1;}else {if old.argument!=new.argument || old.result!=new.result || old.wasm[..]!=new.wasm[..] {print("target mismatch ",s);assert(false);}}}else if new.status==0 {new_only+=1;}else if old.status!=new.status {errors+=1;}}assert(old_only==0 && errors==0 && both>0 && new_only>0);print("primary dispatcher literal corpus parity passed; old accepts ",both," new accepts ",new_only);}