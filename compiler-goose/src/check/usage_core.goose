    if term.tag == blot_check_capability_contracts::Tag.parameter || term.tag == blot_check_capability_contracts::Tag.unknown || term.tag == blot_check_capability_contracts::Tag.authority { return Error.invalid_artifact; }
    if term.tag == blot_check_capability_contracts::Tag.wrapped || term.tag == blot_check_capability_contracts::Tag.project || term.tag == blot_check_capability_contracts::Tag.elements { needed[term.a] = true; }
