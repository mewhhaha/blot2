recursive fn owned(module:const Module&,context:Context,admission:Admission&)->Error {let workspace .= admission.workspace;if workspace && workspace.proved(module) {return Error.none;}for index in 0..admission.count {let prior .= admission.units[index];if prior && sameModule(prior,module) {return Error.none;}}if admission.count>=admission.units.len {return Error.invalid_artifact;}let prior_count=admission.count;admission.units[admission.count] .= module;admission.count+=1;let error=ownedValue(module,context,admission,prior_count);if error!=Error.none {admission.count=prior_count;}return error;}
fn ownedValue(module:const Module&,context:Context,admission:Admission&,prior_count:i64)->Error {var scopes=Views{types:module.types,remaining:admission.remaining,executable:true,obligations:module.obligations, ..};let error=scopes.initialize();if error!=Error.none {return error;}if module.bindings.len>4096 || module.nodes.len>4096 {return Error.invalid_artifact;}for binding in module.bindings {if binding.kind!=blot_check_core::BindingKind.external {continue;}let reference=binding.target;if reference.unit==0 || reference.unit==module.unit {if binding.scheme.closed_rows.len!=0 {return Error.invalid_artifact;}continue;}let selected,error=headerModule(catalog(context),module,reference.unit);if error!=Error.none {return error;}let owner .= selected;let error=blot_check_scheme_equations::bounds(admission.workspace,owner,blot_check_frozen_core_validation::Context{units:context.units, ..});if error!=Error.none {return error;}if reference.binding==0 || reference.binding>=owner.bindings.len {return Error.invalid_artifact;}let original=owner.bindings[reference.binding];if binding.scheme.closed_rows.len==0 && original.scheme.closed_rows.len==0 {continue;}if original.kind!=blot_check_core::BindingKind.global || owner.body(reference.binding)==null {return Error.invalid_artifact;}let error=owned(owner,context,admission);if error!=Error.none {return error;}var views=Views{types:module.types,remaining:admission.remaining,obligations:module.obligations, ..};let error=views.initialize();if error!=Error.none {return error;}let error=views.generic(binding.scheme);if error!=Error.none {return error;}for row,id in module.types.effects.rows {match row.tail {blot_check_effects::Tail.variable tail=>{for variable in module.types.list(binding.scheme.closed_rows) {if admission.remaining==0 {return Error.invalid_artifact;}admission.remaining-=1;if tail.value!=variable {continue;}let error=views.closed_rows.set(id);if error!=Error.none {return error;}if row.labels.len==0 {let error=views.pure_ro