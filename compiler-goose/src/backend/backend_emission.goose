        record_payload=>{ if info.kind != blot_eval_eval_values::ValueKind.record || info.len != pattern.a { return false,blot_error::Error.none; } let canonical,error = generator.evaluator.recordPayload(owner.unit_id,pattern_id,value); if error == blot_error::Error.out_of_memory { return false,error; } if error != blot_error::Error.none { return false,generator.evaluationFailure(); } return staticPattern(owner,pattern.b,canonical,bindings,depth + 1); },
        constructor=>{ if info.kind != blot_eval_eval_values::ValueKind.nominal { return false,blot_error::Error.none; } let constructor = source.constructor(pattern.a); let family = source.nominal(constructor.nominal).identity; var unit = family.unit; if unit == 0 { unit = owner.unit_id; } let identity = (unit as u64 << 32) | family.decl as u64; if info.nominal != identity || info.bits != constructor.tag { return false,blot_error::Error.none; } if pattern.b == 0 { return true,blot_error::Error.none; } let children = generator.evaluator.valueChildren(value); if children.len != 1 { return false,blot_error::Error.none; } return staticPattern(owner,pattern.b,children[0],bindings,depth + 1); },
        product=>{ if info.kind != blot_eval_eval_values::ValueKind.product && info.kind != blot_eval_eval_values::ValueKind.record { return false,blot_error::Error.none; } let patterns = source.patternChildren(pattern_id); let children = generator.evaluator.valueChildren(value); if patterns.len != children.len { return false,blot_error::Error.none; } let record = source.types.node(pattern.ty); let names = generator.evaluator.recordFieldNames(value);
            for child_pattern,index in patterns { var slot = index; if info.kind == blot_eval_eval_values::ValueKind.record { if record.tag != blot_check_types::Tag.record { return false,blot_error::Error.none; } let name = source.types.recordField(record,index).name; var found = false; for field,field_slot in names { if field == name { slot = field_slot; found = true; break; } } if !found { return false,blot_error::Error.none; } } let matched,error = staticPattern(owner,child_pattern,children[slot],bindings,depth + 1); if error != blot_error::Error.none || !matched { return matched,error; } } return true,blot_error::Error.none;
        },_=>{ return false,blot_error::Error.none; },
    }
}
recursive fn prepareStaticPattern(owner: Owner&,id: u32) -> blot_support::Option<StaticBinding[:]>,Error {
    assert(owner.preparing); let generator .= owner.generator(); let source .= generator.unit(owner.unit_id); let node = source.node(id); let ty,type_error = generator.representations.store.fromType(source,source.typeOf(node.b),owner.mappings()); if type_error == blot_error::Error.none { if !hasErasedType(owner,ty,0) { return blot_support::none<StaticBinding[:]>(),blot_error::Error.none; } } else if type_error == blot_error::Error.out_of_memory { return blot_support::none<StaticBinding[:]>(),type_error; }
    let value,value_error = staticReference(owner,node.b); if value_error != blot_error::Error.none || !value.present { return blot_support::none<StaticBinding[:]>(),value_error; } var bindings = BindingBuffer {..}; let matched,error = staticPattern(owner,node.a,value.value,bindings,0); var result = blot_support::none<StaticBinding[:]>(); if error == blot_error::Error.none && matched { var copy: StaticBinding[:] = default<StaticBinding[:]>(); if bindings.items.len != 0 { copy = owned_bindings.alloc_slice(bindings.items.len); for binding,index in bindings.items { copy[index] = binding; } } result = blot_support::some(copy); } bindings.deinit(); return result,error;
}
fn staticPatternBinding(owner: Owner&,id: u32) -> bool,Error { match resolvedPlan(owner,id) { pattern selected=>{ if !selected.value.present { return false,blot_error::Error.none; } for binding in selected.value.value { owner.static_values.insert(binding.binding,binding.value); } return true,blot_error::Error.none; },_=>{ return false,blot_error::Error.none; }, } }
recursive fn patternBinding(owner: Owner&,id: u32,depth: i64) -> Error {
    let generator .= owner.generator(); let source .= generator.unit(owner.unit_id); let node = source.node(id); let static_binding,static_error = staticPatternBinding(owner,id); if static_error != blot_error::Error.none || static_binding { return static_error; }
    match resolvedPlan(owner,id) { collection_step=>{ let stepped,error = emitCollectionStep(owner,id,depth); return error; },collection_pattern=>{ return blot_error::Error.none; },private_pattern selected=>{ let view,error = privateCursorRow(owner,id,selected.value); if error != blot_error::Error.none { return error; } if view.present { return bindRowViewPattern(owner,id,node.a,view.value); } },_=>{}, }
    let scalar_type,scalar_error = scalar(owner,node.b); if scalar_error != blot_error::Error.none { return scalar_error; } let local,local_error = generator.module.addLocal(owner.function_id,blot_backend_runtime_ir::machine(scalar_type)); if local_error != blot_error::Error.none { return local_error; } let value = expression(owner,node.b,depth + 1); if value != blot_error::Error.none { return value; } let saved = emit(owner,blot_backend_runtime_ir::OP_local_set,local); if saved != blot_error::Error.none { return saved; } if irrefutableBindingPattern(source,node.a,0) { return matchPattern(owner,id,node.a,local,owner.labels,depth + 1); }
    let completion = emit(owner,blot_backend_runtime_ir::OP_block); if completion != blot_error::Error.none { return completion; } let completed = owner.labels; owner.labels++; let failure = emit(owner,blot_backend_runtime_ir::OP_block); if failure != blot_error::Error.none { return failure; } let failed = owner.labels; owner.labels++; let matched = matchPattern(owner,id,node.a,local,failed,depth + 1); if matched != blot_error::Error.none { return matched; } let accepted = emit(owner,blot_backend_runtime_ir::OP_br,owner.labels - 1 - completed); if accepted != blot_error::Error.none { return accepted; } owner.labels--; let failed_end = emit(owner,blot_backend_runtime_ir::OP_end); if failed_end != blot_error::Error.none { return failed_end; }
    if node.c == 0 { let unreachable = emit(owner,blot_backend_runtime_ir::OP_unreachable_); if unreachable != blot_error::Error.none { return unreachable; } } else { let terminated,error = suite(owner,node.c,depth + 1); if error != blot_error::Error.none { return error; } if !terminated { return generator.fail(owner.unit_id,id,blot_check_diagnostic_code::Code.unsupported); } } owner.labels--; return emit(owner,blot_backend_runtime_ir::OP_end);
}
fn mergeBranch(owner: Owner&,join: blot_backend_resolved_flow::Join,left: bool) -> Error { let source .= owner.generator().unit(owner.unit_id); for merge_index in 0..(join.merges.len as i64) { let merge = blot_backend_resolved_flow::mergeAt(source,join.merges,merge_index); var binding = merge.else_binding; if left { binding = merge.then_binding; } let local = heldLocal(owner,binding); if !local.present { return owner.generator().fail(owner.unit_id,join.node,blot_check_diagnostic_code::Code.unsupported); } let loaded = emit(owner,blot_backend_runtime_ir::OP_local_get,local.value); if loaded != blot_error::Error.none { return loaded; } let saved = save(owner,merge.result,join.node); if saved != blot_error::Error.none { return saved; } } return blot_error::Error.none; }

fn selectedTypeChildren<S>(source:const S&,node:blot_check_types::Node)->const u32[:] {if node.tag==blot_check_types::Tag.product {return source.list(blot_check_types::List{node.a,node.b});}return source.nominalArguments(node);}
fn selectedRemaining(arguments:const u32[:],count:i64,captured:bool)->const u32[:] {if !captured {return arguments[count..];}return default<const u32[:]>();}
fn selectedRecordDestinations<M>(source:const M&,id:u32,record:bool)->const u32[:] {if record {return source.recordDestinations(id);}return default<const u32[:]>();}
