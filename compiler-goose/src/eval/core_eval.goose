fn patternBindingExpression(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let n=self.units[owner].node(id); let operand,e=expression(self,owner,n.b,frame); if e!=Error.none||!isValue(operand) { return operand,e; } var bound: Bound[>..<]=[]; let matched,error=matchPattern(self,owner,n.a,flowValue(operand),frame,bound,0); if error!=Error.none { return Flow.value {0},error; } if matched { installBindings(frame,bound); return Flow.value {0},Error.none; } if n.c==0 { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } return expression(self,owner,n.c,frame); }
fn expressionInner(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error {
 if self.principal_reads { self.principal_reads.invalidate(blot_reuse_principal_inputs::Rejection.evaluate); } if id==0 { return Flow.value {0},Error.none; } let module=self.units[owner]; if id>=module.nodes.len { return Flow.value {0},fail(self,owner,Span {0,0},Code.unsupported); } if self.steps>=self.options.max_steps||self.depth>=self.options.max_depth { return Flow.value {0},failNode(self,owner,id,Code.constant_fuel); } self.steps++; self.depth++; if self.constant_recorder { self.constant_recorder.observe(self); } defer self.depth--;
 let n=module.node(id); if self.indexed_region { if self.indexed_region.owner==owner&&self.indexed_region.frame .== frame { for edit in self.indexed_region.plan.edits[..self.indexed_region.plan.edit_count] { if edit.update==id { return indexedEdit(self,self.indexed_region,edit); } } } }
 match n.tag {
  task=>{ return Flow.value {0},failNode(self,owner,id,Code.const_effect); },staging=>{ return stagingExpression(self,owner,id,frame); },constant=>{ let value,error=literal(self,owner,id,frame); return Flow.value {value},error; },contract_method=>{ return contractMethod(self,owner,id,frame); },reference=>{ return referenceExpression(self,owner,id,frame); },
  product,record,array=>{ let outcome,error=aggregate(self,owner,id,frame); if error==Error.none&&self.ragged_region&&isValue(outcome) { if self.ragged_region.owner==owner&&self.ragged_region.frame .== frame&&self.ragged_region.plan.storage.initial==id { self.ragged_region.original=flowValue(outcome); } } return outcome,error; },record_merge=>{ return recordMerge(self,owner,id,frame); },array_op=>{ return arrayOperation(self,owner,id,frame); },storage=>{ return Flow.value {0},fail(self,owner,module.span(id),Code.stage_unavailable); },closure=>{ return closureExpression(self,owner,id,frame); },type_constructor=>{ return typeConstructorExpression(self,owner,id,frame); },
  computation=>{ let action,e=expression(self,owner,n.a,frame); if e!=Error.none||!isValue(action) { return action,e; } if valueInfo(self,flowValue(action)).kind!=ValueKind.closure { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } let value,error=makeAggregate(self,owner,id,ValueKind.computation,0,0,[flowValue(action)]); return Flow.value {value},error; },
  request_decision=>{ let payload,e=expression(self,owner,n.b,frame); if e!=Error.none||!isValue(payload) { return payload,e; } let state,e2=expression(self,owner,n.c,frame); if e2!=Error.none||!isValue(state) { return state,e2; } let value,error=makeAggregate(self,owner,id,ValueKind.request_decision,0,n.a,[flowValue(payload),flowValue(state)]); return Flow.value {value},error; },request_loop=>{ return requestLoop(self,owner,id,frame); },resolver_op=>{ return resolverOperation(self,owner,id,frame); },
  constructor_function=>{ let value,error=makeClosure(self,owner,id,ClosureValue {origin:ClosureOrigin.constructor,unit:unitId(self,owner),identity:n.a},[]); return Flow.value {value},error; },primitive_function=>{ let value,error=makeClosure(self,owner,id,ClosureValue {origin:ClosureOrigin.primitive,unit:unitId(self,owner),identity:n.a,ty:n.ty},[]); return Flow.value {value},error; },effect_reflection=>{ return reflectionExpression(self,owner,id,frame); },effect_scope=>{ return effectScope(self,owner,id,frame); },operation_value=>{ return operationExpression(self,owner,id,frame); },effect_provider=>{ return providerExpression(self,owner,id,frame); },state_provider=>{ return stateProviderExpression(self,owner,id,frame); },handle=>{ return handle(self,owner,id,frame); },
  panic=>{ if !self.diagnostic.present { self.diagnostic=blot_support::some(Diagnostic {unit:unitId(self,owner),span:module.span(id),code:Code.const_panic,detail:module.panicMessage(id)}); } return Flow.value {0},Error.declined; },apply=>{ return applicationExpression(self,owner,id,frame); },associated=>{ return dispatch(self,owner,id,frame); },result_associated=>{ return resultDispatch(self,owner,id,frame); },type_same=>{ return sameTypeExpression(self,owner,id,frame); },construct=>{ return constructExpression(self,owner,id,frame); },project=>{ let operand,error=expression(self,owner,n.a,frame); if error!=Error.none||!isValue(operand) { return operand,error; } return memberValue(self,owner,id,n.b,flowValue(operand),frame); },match_=>{ return match(self,owner,id,frame); },pattern_bind=>{ return patternBindingExpression(self,owner,id,frame); },update=>{ return update(self,owner,id,frame); },scalar=>{ return scalarExpression(self,owner,id,frame); },logical=>{ return logicalExpression(self,owner,id,frame); },call=>{ return call(self,owner,id,frame); },if_value,if_stmt=>{ return branchExpression(self,owner,id,frame); },
  block_,suite=>{ if n.tag==CoreTag.block_&&self.ragged_region==null&&self.indexed_region==null&&self.ragged_probe_limit!=0 { let outcome,present,error=raggedBlock(self,owner,id,frame); if error!=Error.none||present { return outcome,error; } } return blockChildren(self,owner,id,frame); },resource_acquire,resource_release,resource_scope=>{ return Flow.value {0},failNode(self,owner,id,Code.unsupported); },usage_borrow=>{ return usageBorrow(self,owner,id,frame); },usage_share=>{ declineConstant(self); let operand,error=expression(self,owner,n.a,frame); if error!=Error.none||!isValue(operand) { return operand,error; } let actual,e=projectType(self,owner,id,n.ty,frame.mappings,frame.row_mappings); if e!=Error.none { return Flow.value {0},e; } let value,e2=typedView(self,owner,id,flowValue(operand),actual); return Flow.value {value},e2; },usage_read=>{ return usageReadExpression(self,owner,id,frame); },package_pack=>{ return packagePack(self,owner,id,frame); },package_unpack=>{ return packageUnpack(self,owner,id,frame); },bind=>{ return bindingExpression(self,owner,id,frame); },
  return_=>{ let outcome,error=expression(self,owner,n.a,frame); if error!=Error.none||!isValue(outcome) { return outcome,error; } return Flow.returning {n.b,flowValue(outcome)},Error.none; },loop_=>{ return loop(self,owner,id,frame); },break_=>{ return breakFlow(self,owner,id,frame); },proof_guard=>{ return proofGuard(self,owner,id,frame); },invalid=>{ return Flow.value {0},failNode(self,owner,id,Code.unsupported); },
 }
}
fn nominalIdentity(self: const Session&,owner: i64,unit: u32,declaration: u32) -> u64 { var selected=unit; if selected==0 { selected=unitId(self,owner); } return (selected as u64)<<32|declaration; }
fn usageBorrow(self: Session&,owner: i64,source: u32,caller: Frame&) -> Flow,Error { if recordingConstant(self) { declineConstant(self); } let module=self.units[owner]; let node=module.node(source); let input,error=expression(self,owner,node.a,caller); if error!=Error.none||!isValue(input) { return input,error; } let callback=module.closure(node.b); var values: dictionary<u32,ValueId>; var mappings: Mapping[>..<]=[]; var rows: RowMapping[>..<]=[]; mappings.append(caller.mappings); rows.append(caller.row_mappings); var callee=Frame {staged:caller.staged,providers:caller.providers,values:values,mappings:mappings,row_mappings:rows};
 for binding in module.extra[callback.captures.start..callback.captures.start+callback.captures.len] { let local=caller.values.get(binding); var captured: ValueId=0; if local { captured=local; } else { let value,e=richValue(self,BindingRef {unitId(self,owner),binding}); if e!=Error.none { return Flow.value {0},e; } captured=value; } values.insert(binding,captured); }
 if constantValueCount(self)>=self.options.max_values||self.storage.values.len>=0xffffffff { return Flow.value {0},failNode(self,owner,source,Code.constant_fuel); } let view=self.storage.values.len as ValueId; self.storage.values.push(valueInfo(self,flowValue(input))); self.storage.value_evidence.push(0); self.storage.value_records.push(self.storage.value_records[flowValue(input)]); values.insert(callback.parameter.binding,view); if self.call_depth>=self.options.max_call_depth { return Flow.value {0},failNode(self,owner,source,Code.constant_recursion); } self.call_depth++; defer self.call_depth--; return expression(self,owner,callback.body,callee);
}
fn proofGuard(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let node=self.units[owner].node(id); let relation,known=blot_check_numeric_proof_terms::relationFromCode(node.c); if known!=Error.none { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } let first,e=expression(self,owner,node.a,frame); if e!=Error.none||!isValue(first) { return first,e; } let second,e2=expression(self,owner,node.b,frame); if e2!=Error.none||!isValue(second) { return second,e2; } var left: u32=0;
