fn length(self_: RaggedFacts,value: ValueId) -> blot_support::Option<u32> { let info=valueInfo(self_.session,value); if info.kind!=blot_eval_eval_values::ValueKind.array&&info.kind!=blot_eval_eval_values::ValueKind.list { return blot_support::none<u32>(); } return blot_support::some(info.len); }
fn project(self_: RaggedFacts,id: u32,value: ValueId) -> blot_support::Option<blot_eval_eval_ragged_count::Value> { let projection=self_.module.projection(self_.module.node(id).b); let info=valueInfo(self_.session,value); if info.kind==blot_eval_eval_values::ValueKind.record { for name,index in recordFieldNames(self_.session,value) { if name==projection.field { return blot_support::some(blot_eval_eval_ragged_count::Value {is_borrowed:true,borrowed:valueChildren(self_.session,value)[index]}); } } return blot_support::none<blot_eval_eval_ragged_count::Value>(); } var container=value; var field=blot_support::none<u32>(); let variants=self_.module.projectionVariants(self_.module.node(id).b); if info.kind==blot_eval_eval_values::ValueKind.nominal { if info.len!=1 { return blot_support::none<blot_eval_eval_ragged_count::Value>(); } container=valueChildren(self_.session,value)[0]; for variant in variants { if variant.tag==info.bits { field=blot_support::some(variant.field); break; } } } else if projection.nominal.decl==0&&variants.len==1 { field=blot_support::some(variants[0].field); } if !field.present { return blot_support::none<blot_eval_eval_ragged_count::Value>(); } let payload=valueInfo(self_.session,container); if (payload.kind!=blot_eval_eval_values::ValueKind.product&&payload.kind!=blot_eval_eval_values::ValueKind.record)||field.value>=payload.len { return blot_support::none<blot_eval_eval_ragged_count::Value>(); } return blot_support::some(blot_eval_eval_ragged_count::Value {is_borrowed:true,borrowed:valueChildren(self_.session,container)[field.value]}); }
