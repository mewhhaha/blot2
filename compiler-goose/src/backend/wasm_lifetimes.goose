fn I(op:Op,operand:u32=0)->Instruction {return Instruction{operand:operand,op:op,..};}
fn emitRelease(code:Code&,recycle:u32,local:u32)->Error {return code.append([I(OP_local_get,local),I(OP_call,recycle)]);}
