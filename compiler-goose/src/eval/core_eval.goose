fn get(self: PrincipalQueries&,key: PrincipalGraphKey,session: const Session&) -> PrincipalAnswer { let result=getInner(self,key,session); if session.member_trace { var outcome=blot_reuse_specialization_receipt::PrincipalOutcome.missing; if result.found { outcome=blot_reuse_specialization_receipt::PrincipalOutcome.graph; if self.claim==PrincipalClaim.source_description&&result.graph==null { outcome=blot_reuse_specialization_receipt::PrincipalOutcome.declined; } } session.member_trace.append(blot_reuse_specialization_receipt::PrincipalRead {target:BindingRef {unitId(session,key.target.unit),key.target.binding},open:self.claim==PrincipalClaim.open_residual,source_interface:key.source_interface,deferred_member:key.deferred_member,outcome:outcome}); } return result; }
fn contains(self: PrincipalQueries&,key: PrincipalGraphKey,session: const Session&) -> bool { return get(self,key,session).found; }
fn put(self: PrincipalQueries&,key: PrincipalGraphKey,value: PrincipalGraph?,session: Session&) -> bool,Error {
 if session.member_trace { session.member_trace.complete=false; } if self.owner!=0 { if self.owner!=session.owner_id||self.units!=unitsIdentity(session)||self.unit_count!=session.units.len { return false,Error.none; } } else { self.owner=session.owner_id; self.units=unitsIdentity(session); self.unit_count=session.units.len; }
 if value==null { if self.claim!=PrincipalClaim.source_description||self.declines.count>=self.table.limits.records { return false,Error.none; } self.declines.insert(key,true); return true,Error.none; }
 let sources=principal_dependency_sources.alloc_slice(value.dependencies.len); for source,index in value.dependencies { sources[index]=source; } let plain=principal_dependency_plain.alloc_slice(value.plain_reads.len); var writes=false; for fact,index in value.plain_reads { plain[index]=fact; writes=writes||!fact.read; }
 var candidate=blot_reuse_semantic_query_table::Candidate<PrincipalQueryKey,PrincipalDependencies,PrincipalGraphResult,PrincipalAdapter> {owner:blot_native::fresh_owner_id(),record:blot_support::some(PrincipalRecord {key:PrincipalQueryKey {key,self.claim,self.force_collision},dependencies:PrincipalDependencies {sources,plain,writes},value:PrincipalGraphResult {value}}),adapter:PrincipalAdapter {self.claim}};
 let prepared,error=self.table.prepare(candidate); if error!=Error.none||!prepared.present { principal_dependency_sources.free_slice(sources); principal_dependency_plain.free_slice(plain); candidate.record=blot_support::none<PrincipalRecord>(); return false,error; } self.table.publish(prepared.value,candidate); return true,Error.none;
}
struct RetainedPrincipalGraphs { queries: PrincipalQueries }
fn initRetainedPrincipalGraphs(declines: dictionary<PrincipalGraphKey,bool>&) -> RetainedPrincipalGraphs { return RetainedPrincipalGraphs {initPrincipalQueries(PrincipalClaim.source_description,declines)}; }
fn deinit(self: RetainedPrincipalGraphs&) { self.queries.deinit(); }
fn capture(self: RetainedPrincipalGraphs&,session: Session&) -> Error { assert(self.queries.count()==0); for record in session.specializations.call_summaries.principals.table.records { let graph: PrincipalGraph?=record.value.graph; if graph==null||!graph.retention_eligible { continue; } let accepted,error=self.queries.put(graph.key,graph,session); if error!=Error.none { return error; } if !accepted { continue; } retain(graph); session.counters.principal_graph_retained++; session.counters.principal_graph_retained_bytes+=satAdd(principalGraphBytes(),graph.owned_bytes) as u64; } return Error.none; }
fn lookup<G>(self: const RetainedPrincipalGraphs&,key: PrincipalGraphKey,gate: const G&) -> PrincipalGraph? { if !gate.admits(BindingRef {(key.target.unit+1) as u32,key.target.binding}) { return null; } let adapter=PrincipalAdapter {PrincipalClaim.source_description}; var cursor=self.queries.table.candidates(adapter.fingerprint(PrincipalQueryKey {key,PrincipalClaim.source_description}),blot_reuse_semantic_query_table::Order.oldest_first); var remaining=self.queries.lookup_budget;
 loop { let position=cursor.next(); if !position.present { break; } if remaining==0 { return null; } remaining--; let record=self.queries.table.records[position.value]; if record.key.source!=key { continue; } let graph: PrincipalGraph?=record.value.graph; if graph==null||!graph.retention_eligible { continue; } var valid=true; for source in graph.dependencies { if remaining==0 { return null; } remaining--; if !gate.admits(source) { valid=false; break; } } if !valid { continue; } for source in graph.references { if remaining==0 { return null; } remaining--; if !gate.admits(BindingRef {(source.unit+1) as u32,source.binding}) { valid=false; break; } } if valid { return graph; } } return null;
}
reusable var principal_graph_pool: PrincipalGraph[>..]=[];
reusable[] var principal_import_pool: PrincipalTypeImport[>..]=[];
reusable[] var principal_row_import_pool: PrincipalRowImport[>..]=[];
reusable[] var principal_constraint_pool: Constraint[>..]=[];
reusable[] var principal_alias_pool: DataAlias[>..]=[];
reusable[] var principal_words_pool: u32[>..]=[];
reusable[] var principal_targets_pool: Target[>..]=[];
reusable[] var principal_actions_pool: PrincipalAction[>..]=[];
reusable[] var principal_sources_pool: BindingRef[>..]=[];
reusable[] var principal_plain_pool: blot_reuse_specialization_receipt::PlainFact[>..]=[];
reusable[] var principal_names_pool: u8[>..]=[];
fn principalGraphBytes() -> i64 { return 407+blot_check_types::snapshotMetadataBytes(); }
fn constraintBytes() -> i64 { return 4+13+4+4+4+1+12+8+1+9+4+16+9+1+1+4+4+4+4+4+4+8+8+1+4+4+1+1+1+1+1; }
fn copyPrincipalConstraints(values: const Constraint[:]) -> const Constraint[:] { let output=principal_constraint_pool.alloc_slice(values.len); for value,index in values { var copy=value; let name=principal_names_pool.alloc_slice(value.diagnostic_name.len); for byte,offset in value.diagnostic_name { name[offset]=byte; } copy.diagnostic_name=name; output[index]=copy; } return output; }
fn createPrincipalGraph(description: PrincipalGraph) -> PrincipalGraph&,Error {
 var graph=description; graph.owner_id=blot_native::fresh_owner_id(); graph.leases=1;
 let imports=principal_import_pool.alloc_slice(description.imports.len); for value,index in description.imports { imports[index]=value; } graph.imports=imports;
 let rows=principal_row_import_pool.alloc_slice(description.rows.len); for value,index in description.rows { rows[index]=value; } graph.rows=rows; graph.requirements=copyPrincipalConstraints(description.requirements); graph.constraints=copyPrincipalConstraints(description.constraints);
