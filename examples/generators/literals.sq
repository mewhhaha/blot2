import * as text from "std/text"

func digit (ch: U32): Bool => return ch >= 48 and ch <= 57

// Canonicalize a signed decimal spelling to a Squid F32 literal. The
// examples accept plain decimal notation, with an optional fractional part.
func decimal (value: Text): Maybe Text =>
  if value.length == 0:
    return $Nothing
  let start = if value[0] == 45 then 1 else 0
  let end = start
  for i in start..value.length:
    if not (digit value[i]):
      break
    end := self + 1
  if end == start:
    return $Nothing
  let out = text.builder ()
  if start == 1:
    out := text.push 45 self
  let first = start
  for i in start..end:
    if value[i] != 48 or i == end - 1:
      break
    first := self + 1
  for i in first..end:
    out := text.push value[i] self
  if end == value.length:
    return $Some (text.finish (text.append ".0" out))
  if value[end] != 46 or end + 1 == value.length:
    return $Nothing
  out := text.push 46 self
  for i in (end + 1)..value.length:
    if not (digit value[i]):
      return $Nothing
    out := text.push value[i] self
  return $Some (text.finish out)
