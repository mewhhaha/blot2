  if error!=blot_error::Error.none {return error;}
  if metadata.name!=0 {let nerr=self_.saveFieldName(metadata.name);if nerr!=blot_error::Error.none {return nerr;}}
  self_.tables.constructors.push(blot_check_core::Constructor{identity:metadata.identity,nominal:metadata.nominal,tag:metadata.tag,scheme:scheme,payload:payload,name:metadata.name,..});
 }
