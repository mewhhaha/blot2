Speed: RootCandidates joins candidates by root through an index once there
are 16 or more (Roots::Add was linear per add); Roots::Join is Add's join.

diff --git a/src/ast.h b/src/ast.h
index 0ce2b94..97c0f31 100644
--- a/src/ast.h
+++ b/src/ast.h
@@ -590,20 +590,22 @@ struct Roots {
     // alternative was read out of a container only where every value joined
     // at its root was read out of that one (RootAlt::from).
     bool Add(const RootAlt &a) {
-        for (auto &b : alts) {
-            if (b.root != a.root) continue;
-            auto before = b;
-            b.exact = b.exact && a.exact;
-            b.slotread = b.slotread && a.slotread;
-            b.classread = b.classread && a.classread;
-            b.projected = b.projected && a.projected;
-            b.argcopy = b.argcopy && a.argcopy;
-            if (b.from != a.from) b.from = nullptr;
-            return b != before;
-        }
+        for (auto &b : alts)
+            if (b.root == a.root) return Join(b, a);
         alts.push_back(a);
         return true;
     }
+    // Add's join of a into b, the alternative with a's root.
+    static bool Join(RootAlt &b, const RootAlt &a) {
+        auto before = b;
+        b.exact = b.exact && a.exact;
+        b.slotread = b.slotread && a.slotread;
+        b.classread = b.classread && a.classread;
+        b.projected = b.projected && a.projected;
+        b.argcopy = b.argcopy && a.argcopy;
+        if (b.from != a.from) b.from = nullptr;
+        return b != before;
+    }
     bool Add(const Roots &o) {
         auto changed = !unknown && o.unknown;
         unknown = unknown || o.unknown;
diff --git a/src/typecheck_types.h b/src/typecheck_types.h
