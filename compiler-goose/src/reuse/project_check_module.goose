fn importExport(self_:Engine&,imports:blot_check_check::ImportedBinding[>..<]&,headers:blot_check_check::SourceHeader[>..<]&,catalogs:blot_check_check::ImportedCatalog[>..<]&,source_catalogs:blot_check_check::SourceCatalog[>..<]&,producer:CatalogModule,exported:Export,name:u32,namespace_:u32,origin:u32)->Error {
