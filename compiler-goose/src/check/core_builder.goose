fn caseFallback(self:Builder&,source:u32,arms:const u32[:],level:i64,inputs:const u32[:],depth:i64,binders:WordBuffer&,references:WordBuffer&)->blot_check_core::MatchArm,Error {if arms.len-level==1 {for input in inputs {let wildcard,error=self.addPattern(source,blot_check_core::Pattern{tag:blot_check_core::PatternTag.wildcard,ty:self.tables.nodes[input].ty, ..});if error!=Error.none {return blot_check_core::MatchArm{..},error;}let error=binders.append(wildcard);if error!=Error.none {return blot_check_core::MatchArm{..},error;}}let row,error=self.addPatternRow(binders.items);return blot_check_core::MatchArm{rows:List{start:row,len:1, ..},body:0,span:self.source.tree.span(source), ..},error;}let next=arms[level+1];for input in inputs {let ty=self.tables.nodes[input].ty;if self.tables.bindings.len==0xffffffff {return blot_check_core::MatchArm{..},Error.core_limit;}let binding=self.tables.bindings.len as u32;self.tables.bindings.push(blot_check_core::Binding{kind:blot_check_core::BindingKind.local,ty:ty,scheme:blot_check_types::Scheme{root:ty, ..},target:blot_check_core::BindingRef{binding:0, ..},span:self.source.tree.span(next), ..});let pattern,error=self.addPattern(next,blot_check_core::Pattern{tag:blot_check_core::PatternTag.bind,ty:ty,a:binding, ..});if error!=Error.none {return blot_check_core::MatchArm{..},error;}let error=binders.append(pattern);if error!=Error.none {return blot_check_core::MatchArm{..},error;}let reference,error=self.referenceNode(next,binding,ty);if error!=Error.none {return blot_check_core::MatchArm{..},error;}let error=references.append(reference);if error!=Error.none {return blot_check_core::MatchArm{..},error;}}let row,error=self.addPatternRow(binders.items);if error!=Error.none {return blot_check_core::MatchArm{..},error;}let rest,error=self.caseLevel(source,arms,level+1,references.items,depth+1);if error!=Error.none {return blot_check_core::MatchArm{..},error;}let children,error=self.save([rest]);if error!=Error.none {return blot_check_c