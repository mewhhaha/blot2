// Runtime guard failure keeps the original scalar loop and its valid-prefix writes.
namespace blot_backend_wasm_bulk_loop;
import check.core;
import check.types;
import .runtime_ir;
import .collection_ops;
import .wasm_bit_recurrence;
import .optimizer_buffers;
import support.error;
import support.option;
type Error=blot_error::Error;
type Core=blot_check_core::Module;
type CoreTag=blot_check_core::Tag;
type BindingRef=blot_check_core::BindingRef;
type Instruction=blot_backend_runtime_ir::Instruction;
type Op=blot_backend_runtime_ir::Op;
type Output=blot_backend_runtime_ir::DetachedBody;
enum SourceReplacement {copy {input:BindingRef},fill {bits:u32}}
struct Source {target:BindingRef,replacement:SourceReplacement,scalar:u32}
fn reference(module:const Core&,id:u32)->blot_support::Option<BindingRef> {if module.node(id).tag!=blot_check_core::Tag.reference {return blot_support::none<BindingRef>();}var result=module.reference(id);if result.unit==0 {result.unit=module.unit;}return blot_support::some(result);}
fn iteratorReference(module:const Core&,id:u32,binding:u32)->bool {let selected=reference(module,id);return selected.present && selected.value.unit==module.unit && selected.value.binding==binding;}
fn source(module:const Core&,id:u32)->blot_support::Option<Source> {let info=module.loopInfo(id);if info.kind!=blot_check_core::LoopKind.range || info.can_exit || info.pattern==0 {return blot_support::none<Source>();}let first=module.node(info.first);let end=module.node(info.end);if first.tag==blot_check_core::Tag.constant && end.tag==blot_check_core::Tag.constant && first.ty==blot_check_types::u32_type && end.ty==blot_check_types::u32_type {if first.a>=end.a || end.a-first.a<16 {return blot_support::none<Source>();}}let pattern=module.patterns[info.pattern];if pattern.tag!=blot_check_core::PatternTag.bind || pattern.ty!=blot_check_types::u32_type {return blot_support::none<Source>();}var body=info.body;if module.node(body).tag==blot_check_core::Tag.suite {let children=module.children(body);if children.len!=1 {return blot_support::none<Source>();}body=children[0];}let assignment=module.node(body);if assignment.tag!=blot_check_core::Tag.bind || module.node(assignment.b).tag!=blot_check_core::Tag.update {return blot_support::none<Source>();}let update=module.updateInfo(assignment.b);let selectors=module.updateSelectors(assignment.b);if selectors.len!=1 || selectors[0].kind!=blot_check_core::UpdateKind.index || module.updatePath(assignment.b).len!=0 || !iteratorReference(module,selectors[0].index,pattern.a) {return blot_support::none<Source>();}let scalar=selectors[0].result_type;if scalar!=blot_check_types::u32_type && scalar!=blot_check_types::boolean && scalar!=blot_check_types::f32_type {return blot_support::none<Source>();}let target=reference(module,update.root);if !target.present || target.value.unit!=module.unit {return blot_support::none<Source>();}let carries=module.loopCarries(id);if carries.len>32 {return blot_support::none<Source>();}for carry in carries {if carry.backedge==carry.iteration {continue;}if carry.backedge!=assignment.a || carry.iteration!=target.value.binding {return blot_support::none<Source>();}}let rhs=module.node(update.value);if rhs.ty!=scalar {return blot_support::none<Source>();}if rhs.tag==blot_check_core::Tag.constant {return blot_support::some(Source{target:target.value,replacement:SourceReplacement.fill{bits:rhs.a,..},scalar:scalar,..});}if rhs.tag!=blot_check_core::Tag.array_op || module.arrayOperation(update.value)!=blot_backend_collection_ops::Op.get {return blot_support::none<Source>();}let arguments=module.children(update.value);if arguments.len!=2 || !iteratorReference(module,arguments[1],pattern.a) {return blot_support::none<Source>();}let input=reference(module,arguments[0]);if !input.present || input.value.unit!=module.unit {return blot_support::none<Source>();}return blot_support::some(Source{target:target.value,replacement:SourceReplacement.copy{input:input.value,..},scalar:scalar,..});}
struct Descriptor {word:u32,token:u32,epoch_low:u32,epoch_high:u32}
enum Replacement {copy {input:Descriptor},fill {bits:u32}}
struct Plan {target:Descriptor,replacement:Replacement,iterator:u32,end:u32,length_function:u32,next_local:u32}
struct Builder {locals:blot_backend_optimizer_buffers::Types=blot_backend_optimizer_buffers::Types{..},code:blot_backend_optimizer_buffers::Code=blot_backend_optimizer_buffers::Code{..},next_local:u32}
fn I(op:Op,operand:u32=0)->Instruction {return Instruction{operand:operand,op:op,..};}
fn L(local:u32)->Instruction {return I(blot_backend_runtime_ir::OP_local_get,local);}
fn C(bits:u32)->Instruction {return I(blot_backend_runtime_ir::OP_i32_const,bits);}
fn temp(self_:Builder&)->u32,Error {let local=self_.next_local;self_.next_local+=1;let error=self_.locals.push(blot_backend_runtime_ir::VT_i32);return local,error;}
fn length(self_:Builder&,descriptor:Descriptor,function:u32)->u32,Error {let result,error=self_.temp();if error!=blot_error::Error.none {return 0,error;}let error=self_.code.append([L(descriptor.token),L(descriptor.epoch_low),L(descriptor.epoch_high),L(descriptor.word),I(blot_backend_runtime_ir::OP_call,function),I(blot_backend_runtime_ir::OP_local_set,result)]);return result,error;}
fn guard_(self_:Builder&,descriptor:Descriptor,end:u32,length:u32)->Error {return self_.code.append([L(end),L(length),I(blot_backend_runtime_ir::OP_i32_le_u),L(descriptor.word),I(blot_backend_runtime_ir::OP_i32_load,12),C(4),I(blot_backend_runtime_ir::OP_i32_eq),I(blot_backend_runtime_ir::OP_i32_and),L(descriptor.word),C(0xffffffef),I(blot_backend_runtime_ir::OP_i32_le_u),I(blot_backend_runtime_ir::OP_i32_and),L(end),C(0xffffffef),L(descriptor.word),I(blot_backend_runtime_ir::OP_i32_sub),C(2),I(blot_backend_runtime_ir::OP_i32_shr_u),I(blot_backend_runtime_ir::OP_i32_le_u),I(blot_backend_runtime_ir::OP_i32_and),I(blot_backend_runtime_ir::OP_if_)]);}
fn address(self_:Builder&,descriptor:Descriptor,iterator:u32)->u32,Error {let result,error=self_.temp();if error!=blot_error::Error.none {return 0,error;}let error=self_.code.append([L(descriptor.word),C(16),I(blot_backend_runtime_ir::OP_i32_add),L(iterator),C(4),I(blot_backend_runtime_ir::OP_i32_mul),I(blot_backend_runtime_ir::OP_i32_add),I(blot_backend_runtime_ir::OP_local_set,result)]);return result,error;}
fn fill(self_:Builder&,target:u32,bytes:u32,bits:u32)->Error {let byte=bits&255;if bits==byte*0x01010101 {return self_.code.append([L(target),C(byte),L(bytes),I(blot_backend_runtime_ir::OP_memory_fill)]);}let filled,error=self_.temp();if error!=blot_error::Error.none {return error;}let chunk,error=self_.temp();if error!=blot_error::Error.none {return error;}return self_.code.append([L(target),C(bits),I(blot_backend_runtime_ir::OP_i32_store),C(4),I(blot_backend_runtime_ir::OP_local_set,filled),I(blot_backend_runtime_ir::OP_block),I(blot_backend_runtime_ir::OP_loop),L(filled),L(bytes),I(blot_backend_runtime_ir::OP_i32_ge_u),I(blot_backend_runtime_ir::OP_br_if,1),L(bytes),L(filled),I(blot_backend_runtime_ir::OP_i32_sub),I(blot_backend_runtime_ir::OP_local_set,chunk),L(filled),L(chunk),I(blot_backend_runtime_ir::OP_i32_lt_u),I(blot_backend_runtime_ir::OP_if_),L(filled),I(blot_backend_runtime_ir::OP_local_set,chunk),I(blot_backend_runtime_ir::OP_end),L(target),L(filled),I(blot_backend_runtime_ir::OP_i32_add),L(target),L(chunk),I(blot_backend_runtime_ir::OP_memory_copy),L(filled),L(chunk),I(blot_backend_runtime_ir::OP_i32_add),I(blot_backend_runtime_ir::OP_local_set,filled),I(blot_backend_runtime_ir::OP_br),I(blot_backend_runtime_ir::OP_end),I(blot_backend_runtime_ir::OP_end)]);}
fn emit(original:const Instruction[:],body_start:i64,body_end:i64,plan:Plan)->blot_support::Option<Output>,Error {if original.len>4096 || !blot_backend_wasm_bit_recurrence::canonicalLoop(original,body_start,body_end,plan.iterator,plan.end) {return blot_support::none<Output>(),blot_error::Error.none;}var builder=Builder{next_local:plan.next_local,..};let error=build(builder,original,plan);return blot_backend_optimizer_buffers::finishOptional(builder.locals,builder.code,true,error);}
fn build(self_:Builder&,original:const Instruction[:],plan:Plan)->Error {let safe,error=self_.temp();if error!=blot_error::Error.none {return error;}let bytes,error=self_.temp();if error!=blot_error::Error.none {return error;}let error=self_.code.append([C(0),I(blot_backend_runtime_ir::OP_local_set,safe),L(plan.iterator),L(plan.end),I(blot_backend_runtime_ir::OP_i32_lt_u),L(plan.end),L(plan.iterator),I(blot_backend_runtime_ir::OP_i32_sub),C(16),I(blot_backend_runtime_ir::OP_i32_ge_u),I(blot_backend_runtime_ir::OP_i32_and),I(blot_backend_runtime_ir::OP_if_)]);if error!=blot_error::Error.none {return error;}let target_length,error=self_.length(plan.target,plan.length_function);if error!=blot_error::Error.none {return error;}let error=self_.guard_(plan.target,plan.end,target_length);if error!=blot_error::Error.none {return error;}let target,error=self_.address(plan.target,plan.iterator);if error!=blot_error::Error.none {return error;}let error=self_.code.append([L(plan.end),L(plan.iterator),I(blot_backend_runtime_ir::OP_i32_sub),C(4),I(blot_backend_runtime_ir::OP_i32_mul),I(blot_backend_runtime_ir::OP_local_set,bytes)]);if error!=blot_error::Error.none {return error;}var input:u32=0;match plan.replacement {fill=>{let error=self_.code.append([C(1),I(blot_backend_runtime_ir::OP_local_set,safe)]);if error!=blot_error::Error.none {return error;}},copy item=>{let input_length,error=self_.length(item.input,plan.length_function);if error!=blot_error::Error.none {return error;}let error=self_.guard_(item.input,plan.end,input_length);if error!=blot_error::Error.none {return error;}let address,error=self_.address(item.input,plan.iterator);if error!=blot_error::Error.none {return error;}input=address;let error=self_.code.append([L(target),L(input),I(blot_backend_runtime_ir::OP_i32_le_u),L(target),L(input),I(blot_backend_runtime_ir::OP_i32_sub),L(bytes),I(blot_backend_runtime_ir::OP_i32_ge_u),I(blot_backend_runtime_ir::OP_i32_or),I(blot_backend_runtime_ir::OP_local_set,safe),I(blot_backend_runtime_ir::OP_end)]);if error!=blot_error::Error.none {return error;}},}let error=self_.code.append([I(blot_backend_runtime_ir::OP_end),I(blot_backend_runtime_ir::OP_end),L(safe),I(blot_backend_runtime_ir::OP_if_)]);if error!=blot_error::Error.none {return error;}match plan.replacement {copy=>{let error=self_.code.append([L(target),L(input),L(bytes),I(blot_backend_runtime_ir::OP_memory_copy)]);if error!=blot_error::Error.none {return error;}},fill item=>{let error=self_.fill(target,bytes,item.bits);if error!=blot_error::Error.none {return error;}},}let error=self_.code.append([L(plan.end),I(blot_backend_runtime_ir::OP_local_set,plan.iterator),I(blot_backend_runtime_ir::OP_else_)]);if error!=blot_error::Error.none {return error;}let error=self_.code.append(original);if error!=blot_error::Error.none {return error;}return self_.code.push(I(blot_backend_runtime_ir::OP_end));}
