reusable[] var principal_dependency_plain: blot_reuse_specialization_receipt::PlainFact[>..]=[];
fn deinit(self_: PrincipalDependencies&) { principal_dependency_sources.free_slice(self_.sources); principal_dependency_plain.free_slice(self_.plain); self_.sources=default<blot_eval_core_eval::BindingRef[:]>(); self_.plain=default<blot_reuse_specialization_receipt::PlainFact[:]>(); }
struct PrincipalGraphResult { graph: PrincipalGraph?=null }
fn deinit(self_: PrincipalGraphResult&) { let graph .=self_.graph;if graph { deinit(graph); } self_.graph .= null; }
struct PrincipalAdapter { claim: PrincipalClaim }
type PrincipalRecord=blot_reuse_semantic_query_table::OwnedRecord<PrincipalQueryKey,PrincipalDependencies,PrincipalGraphResult,PrincipalAdapter>;
type PrincipalTable=blot_reuse_semantic_query_table::Table<PrincipalQueryKey,PrincipalDependencies,PrincipalGraphResult,PrincipalAdapter>;
reusable[] var principal_query_records: PrincipalRecord[>..]=[];
fn fingerprint(self_: PrincipalAdapter,key: PrincipalQueryKey) -> u64 { if key.forced { return 0; } var hash=blot_support_wyhash::init(0); blot_structural::hash(hash,key.source); return hash.final(); }
fn complete(self_: PrincipalAdapter,record: PrincipalRecord) -> bool { let graph: PrincipalGraph?=record.value.graph; if graph==null { return false; } if record.key.claim_!=self_.claim||graph.root==0||record.key.source!=graph.key||record.dependencies.sources.len!=graph.dependencies.len||record.dependencies.plain.len!=graph.plain_reads.len { return false; } for left,index in record.dependencies.sources { if left!=graph.dependencies[index] { return false; } } for left,index in record.dependencies.plain { if left!=graph.plain_reads[index] { return false; } } var writes=false; for fact in record.dependencies.plain { writes=writes||!fact.read; } return writes==record.dependencies.has_writes; }
fn bytes(self_: PrincipalAdapter,record: PrincipalRecord) -> i64 { let graph=record.value.graph;if !graph { return 0; } return satAdd(satAdd(principalGraphBytes(),graph.owned_bytes),record.dependencies.sources.len*8+record.dependencies.plain.len*11); }
fn allocateRecords(self_: PrincipalAdapter,len: i64) -> PrincipalRecord[:],Error { return principal_query_records.alloc_slice(len),blot_error::Error.none; }
fn releaseRecords(self_: PrincipalAdapter,records: const PrincipalRecord[:]) { principal_query_records.free_slice(records); }
fn recordBytes(self_: PrincipalAdapter) -> i64 { return 12+2+60+1+1+16+16+1+8; }
struct SummaryKeysMap { count: i64=0,slots: dictionary_slot<CallSummaryKey,i64>[:]=default<dictionary_slot<CallSummaryKey,i64>[:]>() }
reusable[] var pool_SummaryKeysMap: dictionary_slot<CallSummaryKey,i64>[>..]=[];
fn get(self_: const SummaryKeysMap&,key: CallSummaryKey) -> i64? { return blot_support_pooled_map::getSlots(self_.slots,key); }
fn contains(self_: const SummaryKeysMap&,key: CallSummaryKey) -> bool { return self_.get(key)!=null; }
fn insert(self_: SummaryKeysMap&,key: CallSummaryKey,value: i64) { var view=blot_support_pooled_map::Map<CallSummaryKey,i64> {count:self_.count,slots:self_.slots}; blot_support_pooled_map::insert(view,key,value,pool_SummaryKeysMap); self_.count=view.count; self_.slots=view.slots; }
fn remove(self_: SummaryKeysMap&,key: CallSummaryKey) { var view=blot_support_pooled_map::Map<CallSummaryKey,i64> {count:self_.count,slots:self_.slots}; blot_support_pooled_map::remove(view,key); self_.count=view.count; self_.slots=view.slots; }
fn clear(self_: SummaryKeysMap&) { for &slot in self_.slots { slot.tag=0; } self_.count=0; }
fn reserve(self_: SummaryKeysMap&,needed: i64) {
 if needed<=0||needed<=self_.slots.len-(self_.slots.len+2)/3 {return;}
 var capacity=max(8,self_.slots.len);while needed>capacity-(capacity+2)/3 {assert(capacity<=0x3fffffffffffffff);capacity*=2;}
 var view=blot_support_pooled_map::Map<CallSummaryKey,i64> {count:self_.count,slots:self_.slots};blot_support_pooled_map::grow(view,capacity,pool_SummaryKeysMap);self_.slots=view.slots;
}
fn release(self_: SummaryKeysMap&) { if self_.slots.len!=0 { pool_SummaryKeysMap.free_slice(self_.slots); } self_.slots=default<dictionary_slot<CallSummaryKey,i64>[:]>(); self_.count=0; }

