fn ordinal(source: const Project&,unit: u32) -> u32,Error { if unit==0||unit>source.units.len||unit==source.entry { return 0,blot_error::Error.invalid_artifact; } if unit<source.entry { return unit,blot_error::Error.none; } return unit-1,blot_error::Error.none; }
fn mapped(units: const u32[:],id: u32) -> u32,Error { if id==0||id==0xffffffff { return id,blot_error::Error.none; } if id>units.len||units[id-1]==0 { return 0,blot_error::Error.invalid_artifact; } return units[id-1],blot_error::Error.none; }
