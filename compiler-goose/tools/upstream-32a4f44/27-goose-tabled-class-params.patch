+// MapClass where ClassParam just gave p and view (p in range of args).
+inline Roots TypeCheck::MapClassAt(FnSpec *spec, VarDef *root, int p, bool view,
+                                   const vector<Val> &args) {
     auto base = view ? ViewClassOf(spec, p) : spec->params[p]->ref.Root();
     return ProjectClass(root, base, view ? args[p].held.AsRoots()
                                         : ClassArgRoots(spec->argtypes[p], args[p]));
