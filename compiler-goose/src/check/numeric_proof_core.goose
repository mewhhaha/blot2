}
fn Checker::call(self: Checker&, id: u32, raw: blot_check_core::BindingRef, callee_type: u32, arguments: const u32[:], depth: i64) -> Value, Error {
    let selected, err = self.target(raw); if err != Error.none { return Value {}, err; } let header .= contract(selected.module, selected.binding); var actual: Value[>..<]; for argument in arguments { let value, err = self.walk(argument, depth + 1); if err != Error.none { return Value {}, err; } actual.append(value); }
    if header { let err = signatureTypes(self.module.types, callee_type, header); if err != Error.none { return Value {}, err; } if arguments.len > header.arity { return Value {}, Error.invalid_artifact; } var substituted: u32[>..<]; substituted.resize(arguments.len); for &value in substituted { value = 0; }
        for value, slot in actual { if contains(header.proof_slots, slot as u32) { if !value.proof.present { return Value {}, Error.invalid_artifact; } let expected, err = header.signature().instantiateRequirement(self.values, slot as u32, substituted[..slot]); if err != Error.none { return Value {}, err; } let err = self.proof(value.proof, expected); if err != Error.none { return Value {}, err; } } else { let err = ordinary(value); if err != Error.none { return Value {}, err; } if contains(header.value_slots, slot as u32) { if value.operand == 0 { return Value {}, Error.invalid_artifact; } substituted[slot] = value.operand; } } }
        if self.module.types.node(self.module.typeOf(id)).tag == TypeTag.erased_proof { if !header.result.present || arguments.len != header.arity { return Value {}, Error.invalid_artifact; } let propositions, err = header.signature().instantiate(self.values, substituted); if err != Error.none { return Value {}, err; } let result = propositions[propositions.len - 1]; let err = self.fact(Fact.order { result }); return Value { proof: blot_support::some(result) }, err; }
    } else { for value in actual { let err = ordinary(value); if err != Error.none { return Value {}, err; } } if self.module.types.node(self.module.typeOf(id)).tag == TypeTag.erased_proof { return Value {}, Error.invalid_artifact; } }
    if self.plan { let tag = self.module.types.node(self.module.typeOf(id)).tag; if tag == TypeTag.boolean || kind(tag).present || opaqueReferenceResult(selected.module, selected.binding, arguments.len) { let value, err = self.summaryCall(raw, actual, 0); if err != Error.none { return Value {}, err; } if value.operand != 0 || value.condition != 0 { return value, Error.none; } } } return self.version(self.module.typeOf(id), 0);
}
fn contains(values: const u32[:], target: u32) -> bool { for value in values { if value == target { return true; } } return false; }
fn Checker::branches(self: Checker&, id: u32, condition: u32, left_id: u32, right_id: u32, depth: i64) -> Value, Error {
    let start = self.environment.len; let facts = self.facts.len; let err = self.assume(condition, true, 0); if err != Error.none { return Value {}, err; } let left, err = self.walk(left_id, depth + 1); if err != Error.none { return Value {}, err; }
    var left_facts: Fact[>..<]; left_facts.append(self.facts[facts..]); self.facts.resize(facts); var left_bindings: Entry[>..<]; left_bindings.append(self.environment[start..]); self.environment.resize(start);
    let err = self.assume(condition, false, 0); if err != Error.none { return Value {}, err; } let right, err = self.walk(right_id, depth + 1); if err != Error.none { return Value {}, err; } var right_facts: Fact[>..<]; right_facts.append(self.facts[facts..]); self.facts.resize(facts); var right_bindings: Entry[>..<]; right_bindings.append(self.environment[start..]); self.environment.resize(start);
    if left.exits { if !right.exits { for item in right_facts { let err = self.fact(item); if err != Error.none { return Value {}, err; } } } } else if right.exits { for item in left_facts { let err = self.fact(item); if err != Error.none { return Value {}, err; } } } else { for item in left_facts { for other in right_facts { if factEqual(item, other) { let err = self.fact(item); if err != Error.none { return Value {}, err; } break; } } } }
    for merge in self.module.branchMerges(id) { var then_value = self.lookup(merge.then_binding); var else_value = self.lookup(merge.else_binding); for entry in left_bindings { if entry.binding == merge.then_binding { then_value = blot_support::some(entry.value); } } for entry in right_bindings { if entry.binding == merge.else_binding { else_value = blot_support::some(entry.value); } } var a = Value {}; var b = Value {}; if then_value.present { a = then_value.value; } if else_value.present { b = else_value.value; }
        var value, err = join(a, b, self.module.types.node(self.module.bindings[merge.result].ty).tag == TypeTag.erased_proof); if err != Error.none { return Value {}, err; } if value.operand == 0 && !value.proof.present { let fresh, err = self.version(self.module.bindings[merge.result].ty, merge.result); if err != Error.none { return Value {}, err; } value = fresh; } let err = self.bind(merge.result, value); if err != Error.none { return Value {}, err; }
    }
