type ArmBuffer=blot_support_pooled_buffer::Buffer<blot_check_core::MatchArm>;
fn Builder::caseExpression(self:Builder&,source:u32,ty:u32,depth:i64)->u32,Error {let syntax=self.source.tree.node(source);let inputs=self.source.tree.extra.items[syntax.a..syntax.a+2];var values=WordBuffer{..};var patterns=WordBuffer{..};var arms=ArmBuffer{..};let result,error=caseExpressionArms(self,source,ty,depth,syntax,inputs,values,patterns,arms);values.deinit();patterns.deinit();arms.deinit(arm_runs);return result,error;}
fn caseExpressionArms(self:Builder&,source:u32,ty:u32,depth:i64,syntax:blot_parse_ast::Node,inputs:const u32[:],values:WordBuffer&,patterns:WordBuffer&,arms:ArmBuffer&)->u32,Error {for input in self.source.tree.list(blot_parse_ast::List{inputs[0],inputs[1], ..}) {let value,error=self.expression(input,depth+1);if error!=Error.none {return 0,error;}let error=values.append(value);if error!=Error.none {return 0,error;}}let input_range,error=self.save(values.items);if error!=Error.none {return 0,error;}for arm_source in self.source.tree.list(blot_parse_ast::List{syntax.b,syntax.c, ..}) {let arm=self.source.tree.node(arm_source);let row_start=self.tables.pattern_rows.len as u32;for row_source in self.source.tree.list(blot_parse_ast::List{arm.a,arm.b, ..}) {patterns.clear();for pattern_source in self.source.tree.children(row_source) {let pattern,error=self.patternNode(pattern_source,depth+1);if error!=Error.none {return 0,error;}let error=patterns.append(pattern);if error!=Error.none {return 0,error;}}let ignored,error=self.addPatternRow(patterns.items);if error!=Error.none {return 0,error;}}let row_range=List{row_start,(self.tables.pattern_rows.len-row_start) as u32, ..};let details=self.source.tree.extra.items[arm.c..arm.c+2];let guard,error=self.expression(details[0],depth+1);if error!=Error.none {return 0,error;}let body,error=self.expression(details[1],depth+1);if error!=Error.none {return 0,error;}let error=arms.push(blot_check_core::MatchArm{rows:row_range,guard:guard,body:body,span:self.source.tree.span(arm_source), ..},arm_runs);if error!=Error.none {return 0,error;}}let start=self.tables.match_arms.len as u32;self.tables.match_arms.append(arms.items);let index=self.tables.matches.len as u32;self.tables.matches.push(blot_check_core::MatchInfo{inputs:input_range,arms:List{start,arms.items.len as u32, ..}, ..});return self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.match_,ty:ty,a:index, ..});}
fn Builder::noteCapture(self:Builder&,binding:u32,epoch:u32,captures:WordBuffer&)->Error {if binding==0 || self.tables.bindings[binding].kind==blot_check_core::BindingKind.global || self.tables.bindings[binding].kind==blot_check_core::BindingKind.external {return Error.none;}if self.scratch.reference_epochs[binding]==epoch {return Error.none;}self.scratch.reference_epochs[binding]=epoch;return captures.append(binding);}
recursive fn Builder::patternCaptures(self:Builder&,id:u32,epoch:u32,captures:WordBuffer&,depth:i64)->Error {if id==0 {return Error.none;}if depth>=1024 {return Error.core_limit;}let value=self.tables.patterns[id];match value.tag {blot_check_core::PatternTag.bind=>{self.scratch.definition_epochs[value.a]=epoch;},blot_check_core::PatternTag.value=>{return self.nodeCaptures(value.a,epoch,captures,depth+1);},blot_check_core::PatternTag.product=>{for child in self.tables.extra[value.a..value.a+value.b] {let error=self.patternCaptures(child,epoch,captures,depth+1);if error!=Error.none {return error;}}},blot_check_core::PatternTag.constructor,blot_check_core::PatternTag.record_payload=>{return self.patternCaptures(value.b,epoch,captures,depth+1);},_=>{},}return Error.none;}
