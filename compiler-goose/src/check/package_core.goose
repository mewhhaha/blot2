type Workspace=blot_check_scheme_equations::Workspace;
fn require(ok:bool)->Error {if !ok {return Error.invalid_artifact;}return Error.none;}
struct ModuleCatalog {references:const ModuleRef[:]=[],modules:const Module[:]=[]}
fn len(self:ModuleCatalog)->i64 {if self.modules.len!=0 {return self.modules.len;}return self.references.len;}
fn at(self:ModuleCatalog,index:i64)->const Module& {if self.modules.len!=0 {return self.modules[index];}return self.references[index].value;}
fn sameModule(left:const Module&,right:const Module&)->bool {return left.owner_id!=0 && left.owner_id==right.owner_id;}
fn sameHeader(left:const Module&,right:const Module&)->bool {return sameModule(left,right) && left==right;}
struct TargetKey {unit:u32,target_unit:u32,target_binding:u32}
struct FactKey {unit:u32,root:u32}
struct HeaderKey {producer:blot_check_core::BindingRef,kind:blot_check_types::ObligationKind,name:u32,operator:blot_check_types::Operator,identity:blot_check_types::NominalIdentity}
struct Completed {count:i64=0,slots:dictionary_slot<blot_check_core::BindingRef,bool>[:]=[]}
reusable[] var completed_slots:dictionary_slot<blot_check_core::BindingRef,bool>[>..];
fn get(self:const Completed&,key:blot_check_core::BindingRef)->bool? {return blot_support_pooled_map::get(self,key);}
fn contains(self:const Completed&,key:blot_check_core::BindingRef)->bool {return blot_support_pooled_map::contains(self,key);}
fn insert(self:Completed&,key:blot_check_core::BindingRef,value:bool)->bool {return blot_support_pooled_map::insert(self,key,value,completed_slots);}
fn deinit(self:Completed&) {blot_support_pooled_map::deinit(self,completed_slots);}
fn reserve(self:Completed&,extra:i64)->Error {if extra<0 || extra>0x1555555555555555-self.count {return Error.out_of_memory;}let needed=self.count+extra;var capacity=max(8,self.slots.len);while needed*3>capacity*2 {if capacity>0x2000000000000000 {return Error.out_of_memory;}capacity*=2;}if capacity!=self.slots.len {blot_support_pooled_map::grow(self,capacity,completed_slots);}return Error.none;}
struct Targets {count:i64=0,slots:dictionary_slot<TargetKey,const u32[:]>[:]=[]}
reusable[] var targets_slots:dictionary_slot<TargetKey,const u32[:]>[>..];
fn get(self:const Targets&,key:TargetKey)->const u32[:]? {return blot_support_pooled_map::get(self,key);}
fn contains(self:const Targets&,key:TargetKey)->bool {return blot_support_pooled_map::contains(self,key);}
fn insert(self:Targets&,key:TargetKey,value:const u32[:])->bool {return blot_support_pooled_map::insert(self,key,value,targets_slots);}
fn deinit(self:Targets&) {blot_support_pooled_map::deinit(self,targets_slots);}
fn reserve(self:Targets&,extra:i64)->Error {if extra<0 || extra>0x1555555555555555-self.count {return Error.out_of_memory;}let needed=self.count+extra;var capacity=max(8,self.slots.len);while needed*3>capacity*2 {if capacity>0x2000000000000000 {return Error.out_of_memory;}capacity*=2;}if capacity!=self.slots.len {blot_support_pooled_map::grow(self,capacity,targets_slots);}return Error.none;}
struct Catalogs {count:i64=0,slots:dictionary_slot<u32,bool>[:]=[]}
reusable[] var catalogs_slots:dictionary_slot<u32,bool>[>..];
fn get(self:const Catalogs&,key:u32)->bool? {return blot_support_pooled_map::get(self,key);}
fn contains(self:const Catalogs&,key:u32)->bool {return blot_support_pooled_map::contains(self,key);}
fn insert(self:Catalogs&,key:u32,value:bool)->bool {return blot_support_pooled_map::insert(self,key,value,catalogs_slots);}
fn deinit(self:Catalogs&) {blot_support_pooled_map::deinit(self,catalogs_slots);}
fn reserve(self:Catalogs&,extra:i64)->Error {if extra<0 || extra>0x1555555555555555-self.count {return Error.out_of_memory;}let needed=self.count+extra;var capacity=max(8,self.slots.len);while needed*3>capacity*2 {if capacity>0x2000000000000000 {return Error.out_of_memory;}capacity*=2;}if capacity!=self.slots.len {blot_support_pooled_map::grow(self,capacity,catalogs_slots);}return Error.none;}
struct UsageFacts {count:i64=0,slots:dictionary_slot<FactKey,bool>[:]=[]}
reusable[] var usagefacts_slots:dictionary_slot<FactKey,bool>[>..];
fn get(self:const UsageFacts&,key:FactKey)->bool? {return blot_support_pooled_map::get(self,key);}
fn contains(self:const UsageFacts&,key:FactKey)->bool {return blot_support_pooled_map::contains(self,key);}
fn insert(self:UsageFacts&,key:FactKey,value:bool)->bool {return blot_support_pooled_map::insert(self,key,value,usagefacts_slots);}
fn deinit(self:UsageFacts&) {blot_support_pooled_map::deinit(self,usagefacts_slots);}
fn reserve(self:UsageFacts&,extra:i64)->Error {if extra<0 || extra>0x1555555555555555-self.count {return Error.out_of_memory;}let needed=self.count+extra;var capacity=max(8,self.slots.len);while needed*3>capacity*2 {if capacity>0x2000000000000000 {return Error.out_of_memory;}capacity*=2;}if capacity!=self.slots.len {blot_support_pooled_map::grow(self,capacity,usagefacts_slots);}return Error.none;}
struct AbsentHeaders {count:i64=0,slots:dictionary_slot<HeaderKey,bool>[:]=[]}
reusable[] var absentheaders_slots:dictionary_slot<HeaderKey,bool>[>..];
fn get(self:const AbsentHeaders&,key:HeaderKey)->bool? {return blot_support_pooled_map::get(self,key);}
fn contains(self:const AbsentHeaders&,key:HeaderKey)->bool {return blot_support_pooled_map::contains(self,key);}
fn insert(self:AbsentHeaders&,key:HeaderKey,value:bool)->bool {return blot_support_pooled_map::insert(self,key,value,absentheaders_slots);}
fn deinit(self:AbsentHeaders&) {blot_support_pooled_map::deinit(self,absentheaders_slots);}
