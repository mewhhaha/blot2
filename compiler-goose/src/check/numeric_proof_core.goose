        Tag.array_op => { return self.arrayOperation(id, depth); },
        Tag.array => { let children = module.children(id); let err = self.operands(children, depth); if err != Error.none { return Value {}, err; } let result, err = self.version(n.ty, 0); if err != Error.none { return result, err; } if self.plan && result.operand != 0 { let count, err = self.values.intern(Term { tag: TermTag.literal, a: children.len as u32 }); if err != Error.none { return result, err; } let length, err = self.length(result); if err != Error.none { return result, err; } let err = self.order(Relation.eq, length, count); if err != Error.none { return result, err; } } return result, Error.none; },
        Tag.break_ => { let err = self.operands(module.children(id), depth); if err != Error.none { return Value {}, err; } var target .= self.loop; while target { if target.source == n.a { if n.op != Op.continue_ { target.breaks = true; } return Value { exits: true }, Error.none; } target .= target.previous; } return Value {}, Error.invalid_artifact; },
        Tag.product, Tag.record, Tag.contract_method => { let err = self.operands(module.children(id), depth); if err != Error.none { return Value {}, err; } },
        Tag.scalar => { let left, err = self.walk(n.a, depth + 1); if err != Error.none { return Value {}, err; } let right, err = self.walk(n.b, depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(left); if err != Error.none { return Value {}, err; } let err = ordinary(right); if err != Error.none { return Value {}, err; } if n.c == 0 && left.operand != 0 && right.operand != 0 && module.types.node(module.typeOf(n.a)).tag == TypeTag.unsigned32 && module.types.node(module.typeOf(n.b)).tag == TypeTag.unsigned32 { let comparison, err = self.comparison(n.op, left.operand, right.operand); if err != Error.none { return Value {}, err; } if comparison != 0 { return Value { condition: comparison }, Error.none; } if self.plan && module.types.node(n.ty).tag == TypeTag.unsigned32 { return self.arithmetic(id, n.op, left, right); } } },
        Tag.logical => { let left, err = self.walk(n.a, depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(left); if err != Error.none { return Value {}, err; } let facts = self.facts.len; let err = self.assume(left.condition, n.op == Op.and_, 0); if err != Error.none { return Value {}, err; } let right, err = self.walk(n.b, depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(right); if err != Error.none { return Value {}, err; } self.facts.resize(facts); let condition, err = self.condition(Condition { op: n.op, left: left.condition, right: right.condition }); return Value { condition: condition }, err; },
        Tag.associated => { let left, err = self.walk(n.a, depth + 1); if err != Error.none { return Value {}, err; } let right, err = self.walk(n.b, depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(left); if err != Error.none { return Value {}, err; } let err = ordinary(right); if err != Error.none { return Value {}, err; } for selected in self.selected { let err = self.values.charge(1); if err != Error.none { return Value {}, err; } if selected.node == id { return self.summaryCall(selected.target, [left, right], 0); } } },
        Tag.record_merge, Tag.type_same, Tag.effect_provider, Tag.handle => { let err = self.ordinaryWalk(n.a, depth); if err != Error.none { return Value {}, err; } let err = self.ordinaryWalk(n.b, depth); if err != Error.none { return Value {}, err; } },
        Tag.construct => { if n.b != 0 { let payload, err = self.walk(n.b, depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(payload); if err != Error.none { return Value {}, err; } if opaqueReferenceConstructor(module, n.a) { return payload, Error.none; } } },
        Tag.resource_release, Tag.usage_share, Tag.usage_read, Tag.package_pack, Tag.project, Tag.result_associated, Tag.computation, Tag.effect_scope => { let err = self.ordinaryWalk(n.a, depth); if err != Error.none { return Value {}, err; } },
        Tag.resource_scope, Tag.state_provider => { for child in [n.a, n.b, n.c] { let err = self.ordinaryWalk(child, depth); if err != Error.none { return Value {}, err; } } },
        Tag.resource_acquire, Tag.usage_borrow => { let err = self.ordinaryWalk(n.a, depth); if err != Error.none { return Value {}, err; } let err = self.ordinaryWalk(n.b, depth); if err != Error.none { return Value {}, err; } },
        Tag.package_unpack => { let err = self.ordinaryWalk(n.a, depth); if err != Error.none { return Value {}, err; } let frontier = self.environment.len; let err = self.bind(n.b, Value {}); if err != Error.none { return Value {}, err; } let value, err = self.walk(module.packageOpening(id).body, depth + 1); self.environment.resize(frontier); return value, err; },
        Tag.update => { let metadata = module.updateInfo(id); let root, err = self.walk(metadata.root, depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(root); if err != Error.none { return Value {}, err; } if metadata.self_binding != 0 { let err = self.bind(metadata.self_binding, root); if err != Error.none { return Value {}, err; } } for selector in module.updateSelectors(id) { let err = self.ordinaryWalk(selector.index, depth); if err != Error.none { return Value {}, err; } } let err = self.ordinaryWalk(metadata.value, depth); if err != Error.none { return Value {}, err; } if self.plan && kind(module.types.node(n.ty).tag).present { return self.preserveLength(id, root); } },
        Tag.resolver_op => { let err = self.ordinaryWalk(module.resolverInfo(id).resolver, depth); if err != Error.none { return Value {}, err; } let err = self.operands(module.resolverArguments(id), depth); if err != Error.none { return Value {}, err; } },
        Tag.operation_value => { let metadata = module.operationValue(id); let err = self.ordinaryWalk(metadata.capability, depth); if err != Error.none { return Value {}, err; } let err = self.ordinaryWalk(metadata.witness, depth); if err != Error.none { return Value {}, err; } },
        Tag.request_loop => { let metadata = module.requestLoopInfo(id); let err = self.ordinaryWalk(metadata.computation, depth); if err != Error.none { return Value {}, err; } for arm in module.requestArms(id) { let err = self.ordinaryWalk(arm.selector, depth); if err != Error.none { return Value {}, err; } let err = self.ordinaryWalk(arm.callback, depth); if err != Error.none { return Value {}, err; } } return self.requestCompletion(id, metadata, depth); },
        Tag.request_decision => { let err = self.ordinaryWalk(n.b, depth); if err != Error.none { return Value {}, err; } let err = self.ordinaryWalk(n.c, depth); if err != Error.none { return Value {}, err; } },
        Tag.invalid => { return Value {}, Error.invalid_artifact; }, Tag.panic => { return Value { exits: true }, Error.none; },
        Tag.constructor_function, Tag.primitive_function, Tag.type_constructor, Tag.effect_reflection => {},
    }
    if module.types.node(n.ty).tag == TypeTag.erased_proof { return Value {}, Error.invalid_artifact; } return self.version(n.ty, 0);
}
fn Checker::loopValue(self: Checker&, id: u32, depth: i64) -> Value, Error {
    let module .= self.module; let metadata = module.loopInfo(id); let first, err = self.walk(metadata.first, depth + 1); if err != Error.none { return Value {}, err; } let end, err = self.walk(metadata.end, depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(first); if err != Error.none { return Value {}, err; } let err = ordinary(end); if err != Error.none { return Value {}, err; } let bindings = self.environment.len; let facts = self.facts.len;
    for carry in module.loopCarries(id) { if module.types.node(module.bindings[carry.iteration].ty).tag == TypeTag.erased_proof { return Value {}, Error.invalid_artifact; } let fresh, err = self.version(module.bindings[carry.iteration].ty, carry.iteration); if err != Error.none { return Value {}, err; } let err = self.bind(carry.iteration, fresh); if err != Error.none { return Value {}, err; } }
    let err = self.pattern(metadata.pattern, depth + 1); if err != Error.none { return Value {}, err; }
    if metadata.kind == blot_check_core::LoopKind.range && metadata.pattern != 0 && module.pattern(metadata.pattern).tag == blot_check_core::PatternTag.bind { let index = self.lookup(module.pattern(metadata.pattern).a); if !index.present { return Value {}, Error.invalid_artifact; } if first.operand != 0 && end.operand != 0 && index.value.operand != 0 { let err = self.order(Relation.le, first.operand, index.value.operand); if err != Error.none { return Value {}, err; } let err = self.order(Relation.lt, index.value.operand, end.operand); if err != Error.none { return Value {}, err; } } }
    var loop = Loop { id, self.loop }; self.loop .= loop; let body, err = self.walk(metadata.body, depth + 1); self.loop .= loop.previous; if err != Error.none { return Value {}, err; } self.facts.resize(facts); self.environment.resize(bindings);
    for carry in module.loopCarries(id) { let fresh, err = self.version(module.bindings[carry.outgoing].ty, carry.outgoing); if err != Error.none { return Value {}, err; } let err = self.bind(carry.outgoing, fresh); if err != Error.none { return Value {}, err; } }
    return Value { exits: metadata.kind == blot_check_core::LoopKind.forever && !metadata.can_exit && !loop.breaks }, Error.none;
}
fn Checker::arrayOperation(self: Checker&, id: u32, depth: i64) -> Value, Error {
    let module .= self.module; let operation = module.arrayOperation(id); let arguments = module.children(id); let ty = module.typeOf(id);
    if operation == blot_backend_collection_ops::Op.length && arguments.len == 1 { let collection, err = self.walk(arguments[0], depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(collection); if err != Error.none { return Value {}, err; } if collection.operand == 0 { return Value {}, Error.invalid_artifact; } let length, err = self.length(collection); return Value { operand: length }, err; }
    if self.plan && (operation == blot_backend_collection_ops::Op.get || operation == blot_backend_collection_ops::Op.set) { let collection, err = self.walk(arguments[0], depth + 1); if err != Error.none { return Value {}, err; } let index, err = self.walk(arguments[1], depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(collection); if err != Error.none { return Value {}, err; } let err = ordinary(index); if err != Error.none { return Value {}, err; } if arguments.len > 2 { let err = self.operands(arguments[2..], depth); if err != Error.none { return Value {}, err; } } var admitted = false; if collection.operand != 0 && index.operand != 0 { let proven, err = self.query(Proposition { Relation.index, collection.operand, index.operand }); if err != Error.none { return Value {}, err; } admitted = proven; } let err = self.plan.record(id, admitted); if err != Error.none { return Value {}, err; } if operation == blot_backend_collection_ops::Op.set { return self.preserveLength(id, collection); } return self.version(ty, 0); }
    if self.plan && (operation == blot_backend_collection_ops::Op.identity || operation == blot_backend_collection_ops::Op.convert) { let collection, err = self.walk(arguments[0], depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(collection); if err != Error.none { return Value {}, err; } if operation == blot_backend_collection_ops::Op.identity && kind(module.types.node(ty).tag) == kind(module.types.node(module.typeOf(arguments[0])).tag) { return collection, Error.none; } return self.preserveLength(id, collection); }
    if self.plan && (operation == blot_backend_collection_ops::Op.fill || operation == blot_backend_collection_ops::Op.generate) { let count, err = self.walk(arguments[0], depth + 1); if err != Error.none { return Value {}, err; } let err = ordinary(count); if err != Error.none { return Value {}, err; } let err = self.operands(arguments[1..], depth); if err != Error.none { return Value {}, err; } let result, err = self.version(ty, 0); if err != Error.none { return result, err; } if result.operand != 0 && count.operand != 0 { let length, err = self.length(result); if err != Error.none { return result, err; } let err = self.order(Relation.eq, length, count.operand); if err != Error.none { return result, err; } } return result, Error.none; }
    let err = self.operands(arguments, depth); if err != Error.none { return Value {}, err; } if module.types.node(ty).tag == TypeTag.erased_proof { return Value {}, Error.invalid_artifact; } return self.version(ty, 0);
}
fn Checker::requestCompletion(self: Checker&, id: u32, metadata: blot_check_core::RequestLoopInfo, depth: i64) -> Value, Error { let start = self.environment.len; let result, err = requestCompletionBody(self, id, metadata, depth); self.environment.resize(start); return result, err; }
fn requestCompletionBody(self: Checker&, id: u32, metadata: blot_check_core::RequestLoopInfo, depth: i64) -> Value, Error { for binding in self.module.requestCompletionBindings(id) { if self.module.types.node(self.module.bindings[binding].ty).tag == TypeTag.erased_proof { return Value {}, Error.invalid_artifact; } let fresh, err = self.version(self.module.bindings[binding].ty, binding); if err != Error.none { return Value {}, err; } let err = self.bind(binding, fresh); if err != Error.none { return Value {}, err; } } let err = self.pattern(metadata.completion_pattern, depth + 1); if err != Error.none { return Value {}, err; } let err = self.ordinaryWalk(metadata.completion_body, depth); if err != Error.none { return Value {}, err; } if self.module.types.node(self.module.typeOf(id)).tag == TypeTag.erased_proof { return Value {}, Error.invalid_artifact; } return self.version(self.module.typeOf(id), 0); }
fn Checker::body(self: Checker&, body: const blot_check_core::Body&) -> Error {
    let signature .= contract(self.module, body.binding); let parameters = self.module.bodyParameters(body);
    if signature { if !body.is_function || parameters.len != signature.arity { return Error.invalid_artifact; } let err = signatureTypes(self.module.types, self.module.bindings[body.binding].ty, signature); if err != Error.none { return err; } let err = signature.signature().validate(self.values.limits); if err != Error.none { return err; } }
    var arguments: u32[>..<]; arguments.resize(parameters.len); for &value in arguments { value = 0; }
    for parameter, slot in parameters { var value, err = self.version(parameter.ty, parameter.binding); if err != Error.none { return err; } if self.module.types.node(parameter.ty).tag == TypeTag.erased_proof { if !signature { return Error.invalid_artifact; } let proof, err = signature.signature().instantiateRequirement(self.values, slot as u32, arguments[..slot]); if err != Error.none { return err; } value.proof = blot_support::some(proof); let err = self.fact(Fact.order { proof }); if err != Error.none { return err; } } arguments[slot] = value.operand; let err = self.bind(parameter.binding, value); if err != Error.none { return err; } }
    let result, err = self.walk(body.root, 0); if err != Error.none { return err; } if self.returns.len != 0 { return Error.invalid_artifact; } if result.exits { return Error.none; }
    if signature { if signature.result.present { let expected, err = signature.signature().instantiate(self.values, arguments); if err != Error.none { return err; } return self.proof(result.proof, expected[expected.len - 1]); } } return ordinary(result);
}
struct BodyContext { module: const Module&, units: const ModuleRef[:], body: const blot_check_core::Body&, selected: const Selected[:] = [], plan: Plan? = null, limits: Options, visits: i64 = 0 }
fn checkBody(context: BodyContext&) -> Error {
    var terms: Term[>..<]; var index: dictionary<Term,u32>; var environment: Entry[>..<]; var returns: Return[>..<]; var facts: Fact[>..<]; var conditions: Condition[>..<];
    var checker = Checker { selected: context.selected, module: context.module, units: context.units, values: blot_check_numeric_proof_terms::init(terms, index), environment: environment, returns: returns, plan: context.plan, facts: facts, conditions: conditions }; checker.values.limits = context.limits;
    let err = checker.body(context.body); context.visits = checker.values.visits; checker.values.deinit(); return err;
}
fn analyze(module: const Module&, units: const ModuleRef[:], limits: Options) -> Plan, Error {
    var result = plan(module); var candidate = module.has_numeric_proofs; if !candidate { for node, id in module.nodes { if node.tag == Tag.array_op && (module.arrayOperation(id as u32) == blot_backend_collection_ops::Op.get || module.arrayOperation(id as u32) == blot_backend_collection_ops::Op.set) { candidate = true; break; } } } if !candidate { return result, Error.none; }
    var remaining: i64 = 1000000; for body in module.bodies[1..] { var options = limits; options.visits = min(remaining, limits.visits); var context = BodyContext { module: module, units: units, body: body, plan: result, limits: options }; let err = checkBody(context); result.visits += context.visits; if err != Error.none { if err == Error.out_of_memory { result.deinit(); return Plan {}, err; } result.clear(); return result, Error.none; } remaining -= min(remaining, context.visits); } return result, Error.none;
}
fn analyzePrepared(module: const Module&, units: const ModuleRef[:], body: const blot_check_core::Body&, selected: const Selected[:], limits: Options) -> Plan, Error {
    var result = plan(module); if selected.len > limits.terms || body.binding == 0 || body.binding >= module.bindings.len { return result, Error.none; } let owned .= module.body(body.binding); if !owned || !(owned .== body) || owned.binding != body.binding { return result, Error.none; }
    var context = BodyContext { module: module, units: units, body: body, selected: selected, plan: result, limits: limits }; let err = checkBody(context); result.visits = context.visits; if err != Error.none { if err == Error.out_of_memory { result.deinit(); return Plan {}, err; } result.clear(); } return result, Error.none;
}
fn validate(module: const Module&, units: const ModuleRef[:], remaining: i64&) -> Error {
    if !module.has_numeric_proofs { return Error.none; } let err = dataTypes(module.types, module.types.nodes); if err != Error.none { return err; }
    var terms: Term[>..<]; var index: dictionary<Term,u32>; var environment: Entry[>..<]; var returns: Return[>..<]; var facts: Fact[>..<]; var conditions: Condition[>..<]; var metadata = Checker { module: module, units: units, values: blot_check_numeric_proof_terms::init(terms,index), environment: environment, returns: returns, facts: facts, conditions: conditions }; metadata.values.limits.visits = min(remaining, metadata.values.limits.visits); var seen: dictionary<u32,bool>;
    for value in module.proof_contracts { if seen.contains(value.binding) { return Error.invalid_artifact; } seen.insert(value.binding, true); let err = signatureTypes(module.types, module.bindings[value.binding].ty, value.header); if err != Error.none { return err; } let err = value.header.signature().validateInto(metadata.values); if err != Error.none { if err == Error.out_of_memory { return err; } return Error.invalid_artifact; }
        if module.bindings[value.binding].kind == blot_check_check::Kind.external { let selected, err = metadata.target(blot_check_core::BindingRef { binding: value.binding }); if err != Error.none { return err; } let producer .= contract(selected.module, selected.binding); if !producer || !blot_check_numeric_proof_headers::equal(value.header, producer) { return Error.invalid_artifact; } } else if module.body(value.binding) == null { return Error.invalid_artifact; }
    } remaining -= min(remaining, metadata.values.visits); metadata.values.deinit();
    for body in module.bodies[1..] { var limits = Options {}; limits.visits = min(remaining, limits.visits); var context = BodyContext { module: module, units: units, body: body, limits: limits }; let err = checkBody(context); if err != Error.none { if err == Error.out_of_memory { return err; } return Error.invalid_artifact; } remaining -= min(remaining, context.visits); } return Error.none;
}
// Contiguous immutable module catalogs use the same admission algorithm.
// These lexical references cannot escape into the returned ID-only plan.
fn analyze(module: const Module&, units: const Module[:], limits: Options) -> Plan,Error { var owners: ModuleRef[>..<]; for &unit in units { owners.append(ModuleRef {unit}); } return analyze(module,owners,limits); }
fn analyzePrepared(module: const Module&, units: const Module[:], body: const blot_check_core::Body&, selected: const Selected[:], limits: Options) -> Plan,Error { var owners: ModuleRef[>..<]; for &unit in units { owners.append(ModuleRef {unit}); } return analyzePrepared(module,owners,body,selected,limits); }
