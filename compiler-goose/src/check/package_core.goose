struct RowOrder {types:const blot_check_core::Types&,remaining:i64&,rows:u32[:]}
fn RowOrder::lessThan(self:RowOrder,left:i64,right:i64)->bool {self.remaining=max(0,self.remaining-1);return rowVariable(self.types,self.rows[left])<rowVariable(self.types,self.rows[right]);}
fn RowOrder::swap(self:RowOrder,left:i64,right:i64) {let value=self.rows[left];self.rows[left]=self.rows[right];self.rows[right]=value;}
fn Walker::sortRows(self:Walker&,rows:u32[:])->Error {blot_check_source_sort::pdqContext(0,rows.len,RowOrder{types:self.module.types,remaining:self.scopes.remaining,rows:rows});return require(self.scopes.remaining!=0);}
