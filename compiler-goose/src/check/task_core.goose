    if view.present { for owner, id in module.nodes { let err = step(remaining, 0); if err != blot_error::Error.none { return err; } if owner.tag != blot_check_core::Tag.task || owner.c != blot_check_task_types::opCode(blot_check_task_types::Op.split) { continue; } let operands = module.children(id as u32); let callback = module.closure(operands[2]); let product = module.types.node(callback.parameter.ty); if product.tag != blot_check_types::Tag.product { continue; } for input in module.types.list(blot_check_types::List { product.a, product.b , ..}) { let candidate = blot_check_task_types::viewInfo(module.types, input); if !candidate.present { continue; } if candidate.value.scope == view.value.scope && candidate.value.version == view.value.version { let found, err = inside(module, id as u32, destination, remaining, depth + 1); if err != blot_error::Error.none { return err; } if found { return blot_error::Error.none; } } } } return blot_error::Error.invalid_artifact; }
    match node.tag {
