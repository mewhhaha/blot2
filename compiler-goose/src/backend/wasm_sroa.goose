reusable[] var constant_runs:blot_support::Option<u32>[>..]=[];
reusable[] var scope_runs:blot_support::Option<i64>[>..]=[];
reusable[] var flag_runs:bool[>..]=[];
fn add(self_:Analysis&,bad:bool,size:u32)->u32,Error {let id=self_.nodes.len as u32;let error=self_.nodes.push(Node{parent:id,bad:bad,size:size,..});return id,error;}
fn root(self_:Analysis&,initial:u32)->u32 {var id=initial;while self_.nodes.items[id].parent!=id {id=self_.nodes.items[id].parent;}var next=initial;while next!=id {let parent=self_.nodes.items[next].parent;self_.nodes.items[next].parent=id;next=parent;}return id;}
fn escape(self_:Analysis&,value:Value) {if value.id!=0 {self_.nodes.items[self_.root(value.id)].bad=true;}}
fn join(self_:Analysis&,dst:u32,value:Value) {let target=self_.root(dst);if self_.children && value.id==0 && value.constant.present && value.constant.value==0 {self_.nodes.items[target].nullable=true;return;}if value.id==0 || value.offset!=0 {self_.nodes.items[target].bad=true;self_.escape(value);return;}let source=self_.root(value.id);if target==source {return;}let right=self_.nodes.items[source];let left .= self_.nodes.items[target];left.bad=left.bad || right.bad || (left.size!=0 && right.size!=0 && left.size!=right.size);if left.size!=0 && right.size!=0 && (left.reference_fields!=right.reference_fields || left.journal_carrier!=right.journal_carrier) {left.bad=true;}left.size=max(left.size,right.size);left.reference_fields|=right.reference_fields;left.journaled=left.journaled || right.journaled;left.untyped=left.untyped || right.untyped;left.nullable=left.nullable || right.nullable;left.journal_carrier=left.journal_carrier || right.journal_carrier;left.zero_fields|=right.zero_fields;left.nonzero_fields|=right.nonzero_fields;self_.nodes.items[source].parent=target;}
fn push(self_:Analysis&,value:Value)->Error {return self_.stack.push(value);}
fn dominates(self_:const Analysis&,scope:blot_support::Option<i64>)->bool {if !scope.present {return false;}if scope.value==0 {return true;}for control in self_.controls.items {if control.identity==scope.value {return true;}}return false;}
fn currentScope(self_:const Analysis&)->i64 {if self_.controls.len==0 {return 0;}return self_.controls.items[self_.controls.len-1].identity;}
fn pop(self_:Analysis&)->Value {var floor:i64=0;if self_.controls.len!=0 {floor=self_.controls.items[self_.controls.len-1].height;}if self_.stack.len>floor {return self_.stack.pop();}return Value{..};}
fn record(self_:Analysis&,at:i64,dst:u32,value:Value) {let empty=value.id!=0 && value.offset==0 && self_.nodes.items[value.id].empty;self_.events[at].empty=empty;self_.nodes.items[dst].copies=min(self_.nodes.items[dst].copies+1,2);self_.nodes.items[dst].empty=empty && self_.nodes.items[dst].copies==1;self_.events[at].input=value;self_.events[at].destination=dst;if value.id!=0 {self_.nodes.items[value.id].first_copy=min(self_.nodes.items[value.id].first_copy,at as u32);}}
fn copy(self_:Analysis&,at:i64,dst:u32,value:Value) {self_.record(at,dst,value);self_.join(dst,value);}
fn closeArm(self_:Analysis&,at:i64) {let control=self_.controls.items[self_.controls.len-1];if !control.unreachable_ && control.result!=0 {self_.copy(at,control.result,self_.pop());}self_.stack.resize(control.height);}
fn dead(self_:Analysis&) {if self_.controls.len!=0 {let control .= self_.controls.items[self_.controls.len-1];control.unreachable_=true;self_.stack.resize(control.height);}else {self_.stack.clear();}}
fn call(self_:Analysis&,parameters:i64,result:ValueType,boxable:bool)->Error {for index in 0..parameters {let value=self_.pop();if boxable {let error=self_.box(value);if error!=blot_error::Error.none {return error;}}else {self_.escape(value);}}if result!=blot_backend_runtime_ir::VT_none {return self_.push(Value{..});}return blot_error::Error.none;}
fn box(self_:Analysis&,value:Value)->Error {if !self_.vectors || value.id==0 || value.offset!=0 || value.get==none {self_.escape(value);return blot_error::Error.none;}self_.nodes.items[value.id].first_copy=min(self_.nodes.items[value.id].first_copy,value.get);return self_.boxes.push(Box{value:value,at:value.get,..});}
fn boxResult(self_:Analysis&,value:Value,at:u32)->Error {if !self_.vectors || value.get!=none || value.id==0 || value.offset!=0 {return self_.box(value);}var site=at;if at==none {site=max(0,self_.events.len-1) as u32;}self_.nodes.items[value.id].first_copy=min(self_.nodes.items[value.id].first_copy,site);return self_.boxes.push(Box{value:value,at:at,..});}
fn loopScope(self_:const Analysis&)->i64 {var index=self_.controls.len;while index!=0 {index-=1;let control=self_.controls.items[index];if control.loop_ {return control.identity;}}return 0;}
fn countBits(value:u32)->u32 {var bits=value;var count:u32=0;while bits!=0 {bits&=bits-1;count+=1;}return count;}
fn selected(self_:Analysis&,id:u32)->bool {if id==0 {return false;}let node=self_.nodes.items[self_.root(id)];return !node.bad && node.size!=0 && !(node.journaled && node.untyped);}
fn vector(self_:Analysis&,id:u32)->bool {return self_.nodes.items[self_.root(id)].vector;}
fn fieldLocal(self_:const Analysis&,id:u32,field:u32)->u32 {let node=self_.nodes.items[id];let lower=(1 as u32<<field)-1;assert(node.used_fields&(1 as u16<<field)!=0);return node.fields+countBits((node.used_fields as u32) &lower);}
fn fieldRoot(self_:Analysis&,id:u32,field:u32)->blot_support::Option<u32> {let node=self_.nodes.items[id];let family=self_.root(id);var owner=id;if self_.nodes.items[family].shared_roots {owner=family;}let references=self_.nodes.items[family].reference_fields&self_.nodes.items[owner].root_fields;if node.used_fields&references&(1 as u16<<field)==0 {return blot_support::none<u32>();}let lower=(1 as u32<<field)-1;return blot_support::some(self_.nodes.items[owner].roots+countBits((references as u32) &lower));}
fn deinit(self_:Analysis&) {self_.nodes.deinit();self_.stack.deinit();self_.controls.deinit();self_.boxes.deinit();self_.unboxes.deinit();if self_.events.len!=0 {event_runs.free_slice(self_.events);}if self_.constants.len!=0 {constant_runs.free_slice(self_.constants);}if self_.constant_scopes.len!=0 {scope_runs.free_slice(self_.constant_scopes);}if self_.defined_scopes.len!=0 {scope_runs.free_slice(self_.defined_scopes);}self_=Analysis{..};}
fn wrappedAdd(left:u32,right:u32)->u32 {return (left as u64+right as u64) as! u32;}
fn scan(self_:Analysis&,module:const Module&,function:const Function&,locals:const ValueType[:],instructions:const Instruction[:])->Error {for inst,at in instructions {self_.events[at].loop_scope=self_.loopScope();let error=scanInstruction(self_,module,function,locals,instructions,inst,at);if error!=blot_error::Error.none {return error;}if !self_.valid {return blot_error::Error.none;}}if function.result!=blot_backend_runtime_ir::VT_none {let error=self_.boxResult(self_.pop(),none);if error!=blot_error::Error.none {return error;}}return qualifyFamilies(self_,instructions);}
