 blot_parse_ast::tag_return_stmt=>{if syntax.b!=0 || self.scratch.return_target==0 {let error=self.diagnostic(blot_check_core::Code.unsupported,source);return 0,error;}let value,error=self.expression(syntax.a,depth+1);if error!=Error.none {return 0,error;}return self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.return_,ty:blot_check_types::never,a:value,b:self.scratch.return_target, ..});},
 blot_parse_ast::tag_function_return_stmt=>{if self.scratch.function_target==0 {let error=self.diagnostic(blot_check_core::Code.unsupported,source);return 0,error;}let value,error=self.expression(syntax.a,depth+1);if error!=Error.none {return 0,error;}return self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.return_,ty:blot_check_types::never,a:value,b:self.scratch.function_target, ..});},
