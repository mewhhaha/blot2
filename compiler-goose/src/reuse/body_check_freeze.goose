 if is_contract {let member=node.c+1+extra[node.c];let name,error=ownFieldName(work.fields,catalog.pool.get(extra[member]));{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }extra[member]=name;}node.a=slot+1;node.b=0;
 }
