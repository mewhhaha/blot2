}
fn returnedBinders(self:Scan&,id:u32)->Error {let optional=blot_check_capability_flow::coreCall(self.module,id);if !optional.present {return Error.none;}let call=optional.value;let owner,err=self.ownerModule(call.target.unit);if err!=Error.none {return err;}if call.target.binding>=owner.bindings.len {return Error.invalid_artifact;}let binding=owner.bindings[call.target.binding];let scheme=binding.scheme;if scheme.generative.len==0 {return Error.none;}if binding.body_id==0 || binding.body_id>=owner.bodies.len || owner.bodies[binding.body_id].parameters.len<call.len {return Error.none;}var map,err=blot_check_generative_relocation::init(owner,self.module,scheme,call.signature,self.module.node(id).ty,call.len,self.module.span(id).end+1);if err!=Error.none {return err;}let err=map.applications(id);if err!=Error.none {return err;}let words=owner.types.list(scheme.generative);
    for index in 0..words.len/2 {let arrow=map.get(words[index*2]);if !arrow.present {continue;}var remaining:i64=65536;let reachable,err=self.reachable(self.module.node(id).ty,arrow.value,0,remaining);if err!=Error.none {return err;}if !reachable {continue;}let selected=map.get(words[index*2+1]);if !selected.present {return Error.invalid_artifact;}let err=self.fact(arrow.value,selected.value,id);if err!=Error.none {return err;}}
    return Error.none;
}
fn callRows(self:Scan&,id:u32,arrow:u32,value:u32,row:u32,depth:i64)->Error {for label in self.module.types.rowLabels(row) {let operation=self.module.types.operation(label);if operation.instance.unit!=0 || operation.instance.decl==0 {continue;}for node,index in self.module.types.nodes {if node.tag==TypeTag.scoped && node.b==0 && node.c==operation.instance.decl {let err=self.callResult(id,arrow,value,index as u32,depth+1);if err!=Error.none {return err;}break;}}}return Error.none;}
fn expression(self:Scan&,vertex:i64,declaring_arrow:u32,declaring_value:u32,application_parent:u32,depth:i64)->Error {
    if depth>=128 || self.remaining==0 {return Error.invalid_artifact;}self.remaining-=1;let item=self.graph.item(vertex);var arrow=declaring_arrow;var value=declaring_value;
    if item.kind==blot_check_frozen_core_validation::Kind.node {if item.id==0 {return Error.none;}let id=item.id as u32;let n=self.module.node(id);let selected=self.selected(n.ty);if selected.present {let term=selected.value;let args=self.module.types.nominalArguments(term);let version=self.module.types.node(args[2]);if n.tag==Tag.if_value {if term.a!=self.module.unit || version.a!=self.module.unit || version.b!=self.module.span(id).end+1 {return Error.invalid_artifact;}let err=self.sites.claim(version,id);if err!=Error.none {return err;}let a,err=self.same(args[0],self.module.node(n.b).ty);if err!=Error.none || !a {return Error.invalid_artifact;}let b,err=self.same(args[1],self.module.node(n.c).ty);if err!=Error.none || !b {return Error.invalid_artifact;}let err=self.fact(arrow,n.ty,value);if err!=Error.none {return err;}}}if n.tag==Tag.closure {arrow=n.ty;value=id;}}
    var slot:i64=0;while true {let child=self.graph.edge(vertex,slot);if !child.present {break;}var parent:u32=0;if item.kind==blot_check_frozen_core_validation::Kind.node && item.id!=0 {let node=self.module.node(item.id as u32);let target=self.graph.item(child.value);if node.tag==Tag.apply && target.kind==blot_check_frozen_core_validation::Kind.node && target.id==node.a {parent=item.id as u32;if application_parent!=0 {parent=application_parent;}}}let err=self.expression(child.value,arrow,value,parent,depth+1);if err!=Error.none {return err;}slot+=1;}
    if item.kind==blot_check_frozen_core_validation::Kind.node && item.id!=0 {let id=item.id as u32;let node=self.module.node(id);if application_parent==0 && (node.tag==Tag.call || node.tag==Tag.apply) {let call=blot_check_capability_flow::coreCall(self.module,id);if call.present {let owner,err=self.ownerModule(call.value.target.unit);if err!=Error.none {return err;}if call.value.target.binding>=owner.bindings.len {return Error.invalid_artifact;}let formal,err=self.formalBinder(id,blot_support::none<blot_check_types::Node>(),owner,call.value);if err!=Error.none {return err;}}let err=self.callResult(id,arrow,value,node.ty,0);if err!=Error.none {return err;}return self.returnedBinders(id);}}
    return Error.none;
}
fn reachable(self:const Scan&,root:u32,arrow:u32,depth:i64,remaining:i64&)->bool,Error {if root==0 {return false,Error.none;}if depth>=128 || remaining==0 {return false,Error.invalid_artifact;}remaining-=1;let n=self.module.types.node(root);if n.tag==TypeTag.function {let same,err=self.arrow(root,arrow);if err!=Error.none || same {return same,err;}let found,err=self.reachable(n.a,arrow,depth+1,remaining);if err!=Error.none || found {return found,err;}return self.reachable(n.b,arrow,depth+1,remaining);}match n.tag {
    TypeTag.usage,TypeTag.array,TypeTag.list,TypeTag.cursor,TypeTag.resolver,TypeTag.provider=>{return self.reachable(n.a,arrow,depth+1,remaining);},
    TypeTag.state_provider=>{for child in [n.a,n.b,n.c] {let found,err=self.reachable(child,arrow,depth+1,remaining);if err!=Error.none || found {return found,err;}}},
    TypeTag.product=>{for child in self.module.types.list(blot_check_types::List{n.a,n.b, ..}) {let found,err=self.reachable(child,arrow,depth+1,remaining);if err!=Error.none || found {return found,err;}}},
    TypeTag.record=>{for index in 0..n.b {let found,err=self.reachable(self.module.types.recordField(n,index).ty,arrow,depth+1,remaining);if err!=Error.none || found {return found,err;}}},
    TypeTag.nominal=>{for child in self.module.types.nominalArguments(n) {let found,err=self.reachable(child,arrow,depth+1,remaining);if err!=Error.none || found {return found,err;}}},_=>{},
    }return false,Error.none;
}
fn scheme(self:const Scan&,value:blot_check_types::Scheme)->Error {let words=self.module.types.list(value.generative);for index in 0..words.len/2 {var found=false;for fact in self.facts[..self.len] {let arrow,err=self.arrow(words[index*2],fact.arrow);if err!=Error.none {return err;}if !arrow {continue;}let same,err=self.same(words[index*2+1],fact.selected);if err!=Error.none {return err;}if same {found=true;break;}}if !found {return Error.invalid_artifact;}}
    for fact in self.facts[..self.len] {var remaining:i64=65536;let reachable,err=self.reachable(value.root,fact.arrow,0,remaining);if err!=Error.none {return err;}if !reachable {continue;}var found=false;for index in 0..words.len/2 {let arrow,err=self.arrow(words[index*2],fact.arrow);if err!=Error.none {return err;}if !arrow {continue;}let same,err=self.same(words[index*2+1],fact.selected);if err!=Error.none {return err;}if same {found=true;break;}}if !found {return Error.invalid_artifact;}}
    return Error.none;
}
fn validate(module:const Module&,owners:const ModuleRef[:])->Error {var active=false;for node in module.types.nodes {if node.tag==TypeTag.instance_version {active=true;break;}}if !active {return Error.none;}var sites=Sites{..};for body in module.bodies {if body.root==0 {continue;}let graph,err=blot_check_frozen_core_validation::initGraph(module);if err!=Error.none {return err;}var scan=Scan{module:module,owners:owners,graph:graph,sites:sites,variables:body.scheme.variables, ..};var arrow:u32=0;var root=body.scheme.root;if module.types.node(root).tag==TypeTag.forall {root=module.types.node(root).a;}for ignored in module.bodyParameters(body) {let n=module.types.node(root);if n.tag!=TypeTag.function {return Error.invalid_artifact;}arrow=root;root=n.b;}let err=scan.expression(scan.graph.vertex(blot_check_frozen_core_validation::Kind.node,body.root),arrow,0,0,0);if err!=Error.none {return err;}let err=scan.scheme(body.scheme);if err!=Error.none {return err;}let err=scan.scheme(module.bindings[body.binding].scheme);if err!=Error.none {return err;}}return Error.none;}
