        TypeTag.provider => {let err=self.callResult(id,arrow,value,n.a,depth+1);if err!=Error.none {return err;}return self.callRows(id,arrow,value,n.c,depth+1);},
        TypeTag.usage,TypeTag.array,TypeTag.list,TypeTag.cursor,TypeTag.resolver => {return self.callResult(id,arrow,value,n.a,depth+1);},
        TypeTag.state_provider => {for child in [n.a,n.b,n.c] {let err=self.callResult(id,arrow,value,child,depth+1);if err!=Error.none {return err;}}},
        TypeTag.product => {for child in self.module.types.list(blot_check_types::List{n.a,n.b, ..}) {let err=self.callResult(id,arrow,value,child,depth+1);if err!=Error.none {return err;}}},
        TypeTag.record => {for index in 0..n.b {let err=self.callResult(id,arrow,value,self.module.types.recordField(n,index).ty,depth+1);if err!=Error.none {return err;}}},
        TypeTag.nominal => {for child in self.module.types.nominalArguments(n) {let err=self.callResult(id,arrow,value,child,depth+1);if err!=Error.none {return err;}}},_=>{},
    }return Error.none;
}
fn calledBinder(self:const Scan&,id:u32,selection:blot_check_types::Node)->Error {let optional=blot_check_capability_flow::coreCall(self.module,id);if !optional.present {return Error.invalid_artifact;}let call=optional.value;let owner,err=self.ownerModule(call.target.unit);if err!=Error.none {return err;}if call.target.binding>=owner.bindings.len {return Error.invalid_artifact;}let formal,err=self.formalBinder(id,blot_support::some(selection),owner,call);if err!=Error.none || formal {return err;}let binding=owner.bindings[call.target.binding];let scheme=binding.scheme;
    if binding.kind==blot_check_check::Kind.local {if !(owner .== self.module) || binding.initializer==0 {return Error.invalid_artifact;}let valid,err=self.callbackValue(binding.initializer,scheme.root,0);if err!=Error.none {return err;}if !valid {return Error.invalid_artifact;}}else if binding.kind!=blot_check_check::Kind.global {return Error.invalid_artifact;}
    if call.len==0 || call.len>16 || scheme.root>=owner.types.nodes.len {return Error.invalid_artifact;}var declaring:u32=0;var root=scheme.root;for ignored in 0..call.len {if root>=owner.types.nodes.len {return Error.invalid_artifact;}let value=owner.types.node(root);if value.tag!=TypeTag.function {return Error.invalid_artifact;}declaring=root;root=value.b;}
