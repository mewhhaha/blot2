fn rcState(module:const Module&,function:const Function&,state:Analysis&,plan:RcPlan&)->Error {let code=blot_backend_wasm::instructions(module,function);let arena=module.arena.value;for &owner in state.allocations.items {let inst=code[owner.definition];if inst.op!=OP_call || !arena.isAllocation(inst.operand) {continue;}var mask:u32=0;if inst.operand!=arena.allocate_scalar {if owner.annotations==absent || owner.size%4!=0 {plan.admitted=false;continue;}let roles=code[owner.annotations..owner.annotations+owner.annotation_count];var tail=blot_backend_runtime_ir::ROLE_scalar;for word in 0..owner.size/4 {let role=blot_backend_runtime_ir::wordRole(roles,word);if role!=blot_backend_runtime_ir::ROLE_scalar && role!=blot_backend_runtime_ir::ROLE_reference {plan.admitted=false;break;}if word<31 {if role==blot_backend_runtime_ir::ROLE_reference {mask|=1 as u32 << word as u32;}}else if word==31 {tail=role;if role==blot_backend_runtime_ir::ROLE_reference {mask|=0x80000000;}}else if role!=tail {plan.admitted=false;break;}}}owner.rc_mask=blot_support::some(mask);let error=plan.allocations.push(RcAllocation{at:owner.definition,mask:mask,..});if error!=blot_error::Error.none {return error;}}var calls:i64=0;for inst in code {if inst.op==OP_call && arena.isAllocation(inst.operand) {calls+=1;}}if calls!=plan.allocations.len {plan.admitted=false;}for write in state.rc_writes.items {let owner=state.allocations.items[write.owner-1];if owner.rc_mask.present && owner.rc_mask.value==0 {continue;}if owner.local==absent {plan.admitted=false;continue;}let error=plan.writes.push(RcPublication{at:write.at,local:owner.local,kind:write.kind,..});if error!=blot_error::Error.none {return error;}}return blot_error::Error.none;}
