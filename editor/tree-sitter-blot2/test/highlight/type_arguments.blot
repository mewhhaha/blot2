//         ^ punctuation.bracket
//              ^ keyword.storage.type

const first = func (entry: (Curried U32) [Bool, a]) => return entry
//                          ^ type
//                                  ^ type
//                                        ^ type
//                                                  ^ operator

const get = func (witness: input -> a) : a => return State.get ()
//    ^ function
//          ^ keyword.function
//                ^ variable.parameter
//                                                   ^ type
//                                                   ^ !function.builtin
//                                                         ^ function.method

const set = func value => return State.set value
//    ^ function
//          ^ keyword.function
//               ^ variable.parameter
//                               ^ type
//                               ^ !function.builtin
//                                     ^ variable.other.member

