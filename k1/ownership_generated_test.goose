import ownership_parse;
import ownership_check;
import ownership_runtime;
import owned_scalar_source;
import owned_scalar_runtime;
fn run(source:u8[:], owner:u8[:], flagname:u8[:], mode:i64) {
 var tree=ownership_parse::parse(source);assert(tree.status==0);var contract=ownership_check::Contract {owner:owner,flag:flagname,return_mode:mode};assert(ownership_check::check(tree.tree,source,contract)==0);
 let payload="owned@[ScalarPayload[_],#Cancelled](0) as r free in do:\n  seal(free,4294967295)\n";
 let core=owned_scalar_source::parse(payload);assert(core.status==0);var clock=owned_scalar_runtime::Clock {};var state=owned_scalar_runtime::State {};assert(owned_scalar_runtime::initialize(state,clock));
 for flag in [false,true] {let made=owned_scalar_runtime::construct(state,payload,core.core);assert(made.status==0);
  let result=ownership_runtime::run(tree.tree,source,contract,state,made.handle,flag);assert(result.status==0 && state.loan_count==0);
  if mode==1 {assert(result.returned_owner && owned_scalar_runtime::live(state,result.handle));assert(owned_scalar_runtime::close(state,result.handle).status==0);}
  else {assert(state.slot==0 && state.bitmap[0]==0);if mode==2 {assert(result.value==4294967295);}}
 }
}
