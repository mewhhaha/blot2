fn groupOwner(module: const Module&, units: const ModuleRef[:], source: u32, remaining: i64&) -> u32, Error {
    var current = source; for ignored in 0..128 { let err = step(remaining, 0); if err != blot_error::Error.none { return 0, err; } let node = module.node(current);
        if node.tag == blot_check_core::Tag.call { let call = module.call(current); if call.arguments.len != 1 { return 0, blot_error::Error.invalid_artifact; } let producer, err = ownerUnit(module, call.target.unit, units); if err != blot_error::Error.none { return 0, err; } if !producer { return 0, blot_error::Error.invalid_artifact; } let body .= producer.body(call.target.binding); if !body || !blot_check_capability_flow::unaryCoreWithOwners(producer, body, blot_check_capability_flow::Contract.identity, units) { return 0, blot_error::Error.invalid_artifact; } current = call.arguments[0]; continue; }
        if node.tag != blot_check_core::Tag.reference { return 0, blot_error::Error.invalid_artifact; } let reference = module.reference(current); if reference.unit != 0 && reference.unit != module.unit { return 0, blot_error::Error.invalid_artifact; } let binding = module.binding(reference.binding); if binding.kind == blot_reuse_principal_interface::Kind.local && binding.initializer != 0 { current = binding.initializer; continue; } if binding.kind != blot_reuse_principal_interface::Kind.parameter || !blot_check_task_types::isGroup(module.types, binding.ty) { return 0, blot_error::Error.invalid_artifact; }
        for owner, id in module.nodes { let err = step(remaining, 0); if err != blot_error::Error.none { return 0, err; } if owner.tag == blot_check_core::Tag.closure && blot_check_task_types::scopeCallback(module.types, owner.ty).present && module.closures[owner.a].parameter.binding == reference.binding { return id as u32, blot_error::Error.none; } if owner.tag != blot_check_core::Tag.task || owner.c != blot_check_task_types::opCode(blot_check_task_types::Op.scope) { continue; } let callback = module.node(module.children(id as u32)[0]); if callback.tag == blot_check_core::Tag.closure && module.closures[callback.a].parameter.binding == reference.binding { return id as u32, blot_error::Error.none; } } return 0, blot_error::Error.invalid_artifact;
