fn Engine::projectField(self:Engine&,original:u32,name:u32,source:u32,writable:bool,request:blot_support::Option<PendingObligation>)->FieldProjection,blot_error::Error {let ty,err=self.types.resolve(original,0);if err!=blot_error::Error.none {return FieldProjection{},err;}let node=self.types.node(ty);if node.tag==blot_check_types::Tag.variable || node.tag==blot_check_types::Tag.projection {let result,err=self.types.fresh();if err!=blot_error::Error.none {return FieldProjection{},err;}let origin,err=self.projectionOrigin(source,name,!writable);if err!=blot_error::Error.none {return FieldProjection{},err;}var kind=blot_check_types::ObligationKind.field;var signature:u32=0;if writable {kind=blot_check_types::ObligationKind.writable_field;}else {let function,err=self.invocation(ty,result);if err!=blot_error::Error.none {return FieldProjection{},err;}signature=function;}let err=self.appendPending(PendingObligation{owner:self.current,origin:origin,value:blot_check_types::Obligation{ty:ty,kind:kind,name:name,result:result,signature:signature,source:source}});if err!=blot_error::Error.none {return FieldProjection{},err;}let projection=self.projection_catalog.len as u32;self.projection_catalog.append(Projection{nominal:Identity{0,0},field:name,variants:blot_check_types::List{}});return FieldProjection{result,projection},blot_error::Error.none;}var variants=IdBuffer{};let result,error=projectKnownField(self,ty,node,name,source,writable,request,variants);variants.deinit(equation_type_ids);return result,error;}
