// Lazy adapters are ordinary source types and associated functions. `iter`
// starts an iteration; `next` returns Maybe (item, next_cursor). No adapter
// names have special meaning to the compiler.

type Range is data = $Range { current: U32, end: U32 }
func range start -> end => return $Range { current: start, end }
func Range.iter (cursor: Range) => return cursor
func Range.next (cursor: Range) => return
  if cursor.current >= cursor.end then $Nothing
  else $Some (cursor.current, $Range { current: cursor.current + 1, end: cursor.end })

type Take i is data = $Take { remaining: U32, cursor: i }
func take count -> values => return $Take { remaining: count, cursor: values.iter }
func Take.iter (cursor: Take i) => return cursor
func Take.next (state: Take i) => return do:
  if state.remaining == 0:
    break $Nothing
  use step <- state.cursor.next
  let $Some (value, rest) = step else:
    break $Nothing
  break $Some (value, $Take { remaining: state.remaining - 1, cursor: rest })

type TakeWhile [i, p] is data = $TakeWhile { cursor: i, predicate: p }
func take_while predicate -> values => return $TakeWhile { cursor: values.iter, predicate }
func TakeWhile.iter (cursor: TakeWhile [i, p]) => return cursor
func TakeWhile.next (state: TakeWhile [i, p]) => return do:
  use step <- state.cursor.next
  let $Some (value, rest) = step else:
    break $Nothing
  use accepted <- state.predicate value
  if accepted:
    break $Some (value, $TakeWhile { cursor: rest, predicate: state.predicate })
  break $Nothing

type Map [i, f] is data = $Map { cursor: i, transform: f }
func map transform -> values => return $Map { cursor: values.iter, transform }
func Map.iter (cursor: Map [i, f]) => return cursor
func Map.next (state: Map [i, f]) => return do:
  use step <- state.cursor.next
  let $Some (value, rest) = step else:
    break $Nothing
  use result <- state.transform value
  break $Some (result, $Map { cursor: rest, transform: state.transform })

type Filter [i, p] is data = $Filter { cursor: i, predicate: p }
func filter predicate -> values => return $Filter { cursor: values.iter, predicate }
func Filter.iter (cursor: Filter [i, p]) => return cursor
func Filter.next (state: Filter [i, p]) => return do:
  let cursor = state.cursor
  for ever:
    use step <- cursor.next
    let $Some (value, rest) = step else:
      break $Nothing
    use accepted <- state.predicate value
    if accepted:
      break $Some (value, $Filter { cursor: rest, predicate: state.predicate })
    cursor := rest

type Enumerate i is data = $Enumerate { index: U32, cursor: i }
func enumerate values => return $Enumerate { index: 0, cursor: values.iter }
func Enumerate.iter (cursor: Enumerate i) => return cursor
func Enumerate.next (state: Enumerate i) => return do:
  use step <- state.cursor.next
  let $Some (value, rest) = step else:
    break $Nothing
  break $Some ((state.index, value), $Enumerate { index: state.index + 1, cursor: rest })

type Zip [l, r] is data = $Zip { left: l, right: r }
func zip left -> right => return $Zip { left: left.iter, right: right.iter }
func Zip.iter (cursor: Zip [l, r]) => return cursor
// Pull left, then right. An exhausted left never polls the right. If right
// ends first, the last unpaired left item has already been pulled.
func Zip.next (state: Zip [l, r]) => return do:
  use left <- state.left.next
  let $Some (a, left_rest) = left else:
    break $Nothing
  use right <- state.right.next
  let $Some (b, right_rest) = right else:
    break $Nothing
  break $Some ((a, b), $Zip { left: left_rest, right: right_rest })

type ZipStrict [l, r] is data = $ZipStrict { left: l, right: r }
func zip_strict left -> right => return $ZipStrict { left: left.iter, right: right.iter }
func ZipStrict.iter (cursor: ZipStrict [l, r]) => return cursor
func ZipStrict.next (state: ZipStrict [l, r]) => return do:
  use left <- state.left.next
  use right <- state.right.next
  break case left, right of
    $Nothing, $Nothing => $Nothing
    $Some (a, left_rest), $Some (b, right_rest) =>
      $Some ((a, b), $ZipStrict { left: left_rest, right: right_rest })
    _, _ => @panic "zip_strict inputs have different lengths"

type Windows [i, a] is data = $Windows { width: U32, cursor: i, buffer: List a }
// Full overlapping windows, each a persistent list snapshot. Width zero is
// rejected, and an input shorter than the width yields no windows.
func windows width -> values => return
  if width == 0 then @panic "windows requires a positive width"
  else $Windows { width, cursor: values.iter, buffer: [] }
func Windows.iter (cursor: Windows [i, a]) => return cursor
func Windows.next (state: Windows [i, a]) => return do:
  let cursor = state.cursor
  let buffer = state.buffer
  for ever:
    if buffer.length == state.width:
      break
    use step <- cursor.next
    let $Some (value, rest) = step else:
      break $Nothing
    buffer := [...self, value]
    cursor := rest
  let rest = @list.slice buffer 1 (state.width - 1)
  break $Some (buffer, $Windows { width: state.width, cursor, buffer: rest })

func fold_left reduce -> initial -> values => return do:
  let state = initial
  for value in values:
    use next <- reduce state value
    state := next
  break state

func collect_list values => return do:
  let collected = []
  for value in values:
    collected := [...self, value]
  break collected
func collect_array values => return Array.from_list (collect_list values)
func any predicate -> values => return do:
  for value in values:
    use accepted <- predicate value
    if accepted:
      break true
  break false
func all predicate -> values => return do:
  for value in values:
    use accepted <- predicate value
    if Bool.not accepted:
      break false
  break true
