fn Builder::allBindings(self:Builder&)->Error {for value,index in self.source.checked.bindings {var has_explicit=value.summary.has_explicit;for requirement in self.source.checked.obligations[value.scheme.obligations.start..value.scheme.obligations.start+value.scheme.obligations.len] {has_explicit=has_explicit || requirement.explicit || (requirement.kind==blot_check_types::ObligationKind.callee_use && self.source.checked.bindings[requirement.identity.decl].summary.has_explicit);}var capability_flow=blot_check_check::CapabilityFlow.unknown;var capability_parameters=blot_check_capability_flow::Parameters{..};if value.kind==blot_check_core::BindingKind.global {capability_flow=value.capability_flow;capability_parameters=value.capability_parameters;}let ty,error=self.projectType(value.ty,0);if error!=Error.none {return error;}let scheme,error=self.projectScheme(value.scheme,value.kind==blot_check_core::BindingKind.local);if error!=Error.none {return error;}let public_variables,error=self.projectPublic(value.summary.public_variables,false);if error!=Error.none {return error;}let public_rows,error=self.projectPublic(value.summary.public_rows,true);if error!=Error.none {return error;}var target=blot_check_core::BindingRef{binding:0, ..};if index!=0 {target=self.target(index as u32);}self.tables.bindings.push(blot_check_core::Binding{capability_flow:capability_flow,capability_parameters:capability_parameters,private:value.private,kind:value.kind,ty:ty,scheme:scheme,public_variables:public_variables,public_rows:public_rows,has_explicit:has_explicit,target:target,span:self.source.tree.span(value.declaration), ..});if value.kind==blot_check_core::BindingKind.parameter && value.scheme.root==0 && value.scheme.variables.len==0 && value.scheme.row_variables.len==0 && value.scheme.closed_rows.len==0 && value.scheme.obligations.len==0 {self.tables.bindings[index].scheme.root=self.tables.bindings[index].ty;}}return Error.none;}
