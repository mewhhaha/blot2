fn Engine::implementationEquation(self:Engine&,contract:Identity,name:u32,arguments:const u32[:])->blot_support::Option<u32>,blot_error::Error {let index=self.activeImplementation();if !index.present {return blot_support::none<u32>(),blot_error::Error.none;}let declaration=self.implementations[index.value];if contract!=declaration.contract || arguments.len!=declaration.head.len {return blot_support::none<u32>(),blot_error::Error.none;}let member=self.implementationMemberIndex(declaration,name);if !member.present || self.implementation_members[member.value].kind!=blot_reuse_principal_interface::ImplementationMemberKind.type_ {return blot_support::none<u32>(),blot_error::Error.none;}var same=true;for ordinal in 0..arguments.len {let equal,err=self.types.equalSymbolic(arguments[ordinal],self.types.list(declaration.head)[ordinal]);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if !equal {same=false;}}
    if !same {let state .= self.implementation_member_states.get(member.value);if state && state==Engine_implementation_member_states_state.visiting {let rigid,err=blot_eval_implementation_patterns::matchesRigid(self.types,declaration,arguments);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if rigid {let source .= self.implementation_member_sources.get(member.value);assert(source!=null);let err=self.diagnostic(Code.recursive_associated_type,source);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let fresh,err=self.types.fresh();return blot_support::some(fresh),err;}}return blot_support::none<u32>(),blot_error::Error.none;}
    let root,err=self.resolveImplementationMember(member.value);return blot_support::some(root),err;
