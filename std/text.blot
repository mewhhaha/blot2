// Text is an Array U32 of Unicode scalar values. Equality compares scalar
// sequences exactly; it does not normalize Unicode.
const empty: Text = ""
func length (value: Text) => return value.length
func is_empty (value: Text) => return value.length == 0
func at index -> (value: Text) => return value[index]
func concat (left: Text) -> (right: Text) : Text => return @array.concat left right

func equal (left: Text) -> (right: Text) : Bool => return do:
  if left.length != right.length:
    break false
  for index in 0..left.length:
    if left[index] != right[index]:
      return false
  break true

func valid_scalar value => return
  value <= 0x10FFFF and (value < 0xD800 or value > 0xDFFF)
func from_scalars (values: Array U32) : Maybe Text => return do:
  for value in values:
    if Bool.not (valid_scalar value):
      return $Nothing
  break $Some values
func scalars (value: Text) => return value

// Append into a persistent List; one conversion produces the final Array.
type Builder = List U32
func builder () : Builder => return []
func push scalar -> (out: Builder) => return [...out, scalar]
func append (value: Text) -> (out: Builder) : Builder => return do:
  let result = out
  for scalar in value:
    result := [...self, scalar]
  break result
func finish (out: Builder) : Text => return Array.from_list out
func join (separator: Text) -> (pieces: Array Text) : Text => return do:
  let out = builder ()
  let first = true
  for piece in pieces:
    if Bool.not first:
      out := append separator self
    out := append piece self
    first := false
  break finish out

func decimal_digits value -> collected => return
  if value < 10 then [value + 48, ...collected]
  else decimal_digits (value / 10) [value % 10 + 48, ...collected]
func from_u32 (value: U32) : Text => return
  Array.from_list (decimal_digits value [])
func append_u32 value -> out => return append (from_u32 value) out

// Fixed decimal places (0..6), rounded half away from zero. Return Nothing
// for NaN, infinities, excessive precision, or a scaled value outside U32.
func from_f32_fixed (places: U32) -> (value: F32) : Maybe Text => return do:
  if places > 6 or Bool.not (F32.is_finite value):
    return $Nothing
  let factor = 1
  for ignored in 0..places:
    factor := self * 10
  let scaled = F32.floor (F32.abs value * F32.from factor + 0.5)
  if scaled >= 4294967296.0:
    return $Nothing
  let rounded = F32.to_u32 scaled
  let out = builder ()
  if value < 0.0:
    out := append "-" self
  out := append (from_u32 (rounded / factor)) self
  if places > 0:
    out := push 46 self
    let divisor = factor / 10
    for ignored in 0..places:
      out := push (48 + (rounded / divisor) % 10) self
      if divisor > 1:
        divisor := self / 10
  break $Some (finish out)

// Libraries and applications can provide their own Format implementations.
type Format a is contract = { const format: a -> Text }
impl Decimal : Format U32 = { const format = func value => return from_u32 value }
impl Boolean : Format Bool = {
  const format = func value => return if value then "true" else "false",
}
func format (value: a): Text where { Format a } => return Format.format value
func format_sequence (values: Array a): Text where { Format a } => return do:
  let out = append "[" (builder ())
  let first = true
  for value in values:
    if Bool.not first:
      out := append ", " self
    out := append (format value) self
    first := false
  break finish (append "]" out)
impl Sequence a : Format (Array a) where { Format a } = {
  const format = func values => return format_sequence values,
}
