import * as tree from "./_summary_tree"

type Fold [i, a, s, f] is opaque = {
  width: U32,
  cursor: i,
  step: f,
  initial: s,
  window: Maybe #[a],
}
private func fold_window step -> initial -> (values: #[a]) =>
  let acc = initial
  for index in 0..values.length:
    use next <- step acc values[index]
    acc := next
  return acc
func fold step -> initial -> (width: U32) -> values =>
  if @u32.eq width 0:
    return panic "rolling requires a positive width"
  return $Fold { width, cursor: values.iter, step, initial, window: $Nothing }
func Fold.iter (state: Fold [i, a, s, f]) => state
func Fold.next (state: Fold [i, a, s, f]) => case state.window of
  $Nothing => do:
    let cursor = state.cursor
    let buf: #[a] = #[]
    for _ in 0..state.width:
      use step <- cursor.next
      let $Some (value, rest) = step else:
        return $Nothing
      buf := @array.append self value
      cursor := rest
    use total <- fold_window state.step state.initial buf
    break $Some (total, $Fold { width: state.width, cursor, step: state.step, initial: state.initial, window: $Some buf })
  $Some previous => do:
    use step <- state.cursor.next
    let $Some (value, rest) = step else:
      break $Nothing
    let next_buf = @array.append (@array.slice previous 1 (@u32.sub state.width 1)) value
    use total <- fold_window state.step state.initial next_buf
    break $Some (total, $Fold { width: state.width, cursor: rest, step: state.step, initial: state.initial, window: $Some next_buf })

type Monoid [i, s, f] is opaque = {
  width: U32,
  cursor: i,
  combine: f,
  identity: s,
  window: Maybe (tree.Tree s),
}
func monoid (combine: s -> s -> s) -> (identity: s) -> (width: U32) -> values =>
  if @u32.eq width 0:
    return panic "rolling requires a positive width"
  return $Monoid { width, cursor: values.iter, combine, identity, window: $Nothing }
func Monoid.iter (state: Monoid [i, s, f]) => state
func Monoid.next (state: Monoid [i, s, f]) => case state.window of
  $Nothing => do:
    use result <- tree.read state.identity state.width state.cursor
    let $Some (buffer, rest) = result else:
      break $Nothing
    let summarized = tree.reduce state.combine buffer
    break $Some (tree.total state.identity summarized, $Monoid { width: state.width, cursor: rest, combine: state.combine, identity: state.identity, window: $Some summarized })
  $Some previous => do:
    use step <- state.cursor.next
    let $Some (value, rest) = step else:
      break $Nothing
    let summarized = tree.shift state.combine value previous
    break $Some (tree.total state.identity summarized, $Monoid { width: state.width, cursor: rest, combine: state.combine, identity: state.identity, window: $Some summarized })

type Group [i, s, f, g] is opaque = {
  width: U32,
  cursor: i,
  combine: f,
  inverse: g,
  identity: s,
  window: Maybe (tree.Tree s),
  total: s,
}
func group (combine: s -> s -> s) -> (inverse: s -> s) -> (identity: s) -> (width: U32) -> values =>
  if @u32.eq width 0:
    return panic "rolling requires a positive width"
  return $Group { width, cursor: values.iter, combine, inverse, identity, window: $Nothing, total: identity }
func Group.iter (state: Group [i, s, f, g]) => state
func Group.next (state: Group [i, s, f, g]) => case state.window of
  $Nothing => do:
    use result <- tree.read state.identity state.width state.cursor
    let $Some (buffer, rest) = result else:
      break $Nothing
    let total = tree.fold state.combine state.identity buffer
    break $Some (total, $Group { width: state.width, cursor: rest, combine: state.combine, inverse: state.inverse, identity: state.identity, window: $Some buffer, total })
  $Some previous => do:
    use step <- state.cursor.next
    let $Some (value, rest) = step else:
      break $Nothing
    let total = state.combine (state.combine (state.inverse (tree.first previous)) state.total) value
    let identity = state.identity
    let unused = func left -> right => identity
    let buffer = tree.shift unused value previous
    break $Some (total, $Group { width: state.width, cursor: rest, combine: state.combine, inverse: state.inverse, identity: state.identity, window: $Some buffer, total })
