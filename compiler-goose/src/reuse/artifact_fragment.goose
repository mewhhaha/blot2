 EmitEvent.parameter_roles item=>{if self.ownedFunction(item.function,record.owner) {let function,error=self.resolveFunction(g,item.function);if error!=Error.none {return error;}return g.module.setParameterRoles(function,item.roles);}},
 EmitEvent.provider_parameter item=>{if self.ownedFunction(item.function,record.owner) {let function,error=self.resolveFunction(g,item.function);if error!=Error.none {return error;}return g.module.setProviderParameter(function,item.index);}},
 EmitEvent.callable_layout item=>{if self.ownedFunction(item.function,record.owner) {let ty,error=self.importer.importCallableLayout(g,item.layout,self.declaredCallableLayout(job));if error!=Error.none {return error;}if !ty.present || g.representations.store.node(ty.value).tag!=blot_backend_layout::Tag.function {return Error.invalid_function_reference;}let function,error=self.resolveFunction(g,item.function);if error!=Error.none {return error;}return g.module.setCallableLayout(function,ty.value);}},
 EmitEvent.semantic_site item=>{let site=item.value;if self.ownedFunction(site.function,record.owner) {let mapped,error=self.importer.importSemanticSite(g,site);if error!=Error.none {return error;}if !mapped.present {return Error.invalid_function_reference;}var imported=mapped.value;let function,error=self.resolveFunction(g,site.function);if error!=Error.none {return error;}imported.function=function;if imported.place!=g.module.functions[function].instructions.len {return Error.invalid_function_reference;}return g.module.recordSemanticSite(imported);}},
 EmitEvent.instruction item=>{if self.ownedFunction(item.function,record.owner) {let function,error=self.resolveFunction(g,item.function);if error!=Error.none {return error;}return emitInstruction(self,g,function,blot_reuse_artifact_emitter::SymbolicInstruction{op:item.op,operand:item.operand,..});}},
 EmitEvent.instruction_run run=>{if self.ownedFunction(run.function,record.owner) {let instructions=self.old.emission.instructionRun(run.instructions);if !instructions.present || instructions.value.len==0 {return Error.invalid_function_reference;}let function,error=self.resolveFunction(g,run.function);if error!=Error.none {return error;}for item in instructions.value {let error=emitInstruction(self,g,function,item);if error!=Error.none {return error;}}}},
 EmitEvent.import_ item=>{let value,error=self.importFunction(g,item.id);return error;},EmitEvent.operation_symbol item=>{let value,error=self.operation(g,item.id);return error;},
 EmitEvent.data item=>{if item.address==0 {return self.ensureArena(g);}let actual,error=g.module.staticBytes(self.old.emission.bytes.items[item.bytes.start..item.bytes.start+item.bytes.len]);if error!=Error.none {return error;}let error=self.addresses.push(Address{original:item.address,actual:actual,len:item.bytes.len,owner:record.owner,..});if error!=Error.none {return error;}return self.publishSerialized(g,item.address,actual,item.bytes.len);},
 EmitEvent.data_word item=>{let actual,error=self.resolveAddress(item.address);if error!=Error.none {return error;}if item.operand.role==Role.operation {blot_bytes::put_u32(g.module.data,actual,0);let symbol,error=self.operation(g,item.operand.value);if error!=Error.none {return error;}let error=g.planning.runtime_operations.dataWord(g.module,actual,symbol);if error==Error.out_of_memory {return error;}if error!=Error.none {return Error.invalid_function_reference;}}else {let relocated,error=self.resolveOperand(g,item.operand);if error!=Error.none {return error;}blot_bytes::put_u32(g.module.data,actual,relocated);return g.module.dataReference(actual,Operand{role:item.operand.role,value:relocated,..});}},
 EmitEvent.global item=>{let value,error=self.global(g,item.id);return error;},EmitEvent.arena=>{return self.ensureArena(g);},EmitEvent.host_references=>{return self.ensureHost(g);},EmitEvent.lists=>{return self.ensureLists(g);},
 EmitEvent.list_extension item=>{if item.address.present {let value,error=g.module.ensureUncheckedListAddress();if error!=Error.none {return error;}}if item.set.present {let value,error=g.module.ensureUncheckedListSet();if error!=Error.none {return error;}}if item.snapshot.present {let value,error=g.module.ensureListSnapshot();if error!=Error.none {return error;}}return self.ensureLists(g);},
 EmitEvent.demand item=>{if item.hit {match item.kind {blot_reuse_artifact_emitter::ResourceKind.arena=>{return self.ensureArena(g);},blot_reuse_artifact_emitter::ResourceKind.host_references=>{return self.ensureHost(g);},blot_reuse_artifact_emitter::ResourceKind.lists=>{return self.ensureLists(g);},blot_reuse_artifact_emitter::ResourceKind.operation=>{let value,error=self.operation(g,item.id);return error;},_=>{},}}},
 EmitEvent.global_bits item=>{if !self.arena.present {return Error.none;}let old=self.arena.value;let wide=blot_runtime_shared_rc::shaped_mode;if item.id!=old.rc_enabled || item.bits.value&wide==0 {return Error.none;}let error=self.ensureArena(g);if error!=Error.none {return error;}let flag=g.module.arena.value.rc_enabled;let bits=g.module.globals[flag].bits|wide;let journal .= g.module.artifacts;if journal {let error=journal.append(EmitEvent.global_bits{id:flag,bits:Operand{value:bits,..},..});if error!=Error.none {return error;}}g.module.globals[flag].bits=bits;},
 EmitEvent.mutable_static=>{g.module.mutable_static=true;},EmitEvent.static_field item=>{let address,error=self.resolveAddress(item.address);if error!=Error.none {return error;}return g.module.staticField(address,item.role);},
