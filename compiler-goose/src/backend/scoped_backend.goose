        if !self_.destination.present { let plan = blot_backend_private_append_region::analyzeConversion(module,id); if plan.present { let added = self_.append_regions.push(AppendRegion { unit: module.unit,plan: plan.value , ..}); if added != blot_error::Error.none { return Value {..},added; } } }
        let inputs = module.children(id); if inputs.len > 3 || inputs.len == 0 { return Value {..},unsupported(self_,module,id); } var args: Value[3];
        for input,index in inputs { let value,error = expression(self_,module,input,depth + 1); if error != blot_error::Error.none || value.terminated { return value,error; } args[index] = value; let protected = self_.protected.push(value); if protected != blot_error::Error.none { return Value {..},protected; } }
        return collectionInputs(self_,module,id,depth,args);
    } let result,error = prepareCollection(); self_.protected.resize(protected_before); self_.append_regions.resize(region_count); return result,error;
}
recursive fn collectionInputs(self_: Generator&,module: const blot_check_core::Module&,id: u32,depth: i64,args: Value[3]) -> Value,Error {
