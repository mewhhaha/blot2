fn storage(self: const PrincipalQueries&) -> blot_reuse_semantic_query_table::Storage { var result=self.table.storage(); result.inspected_positions=self.inspected_positions; result.inspected_dependencies=self.inspected_dependencies; result.lookup_declines=self.lookup_declines; return result; }
fn inspect(self: PrincipalQueries&,remaining: i64&,dependency: bool) -> bool { if remaining==0 { self.lookup_declines=satAdd(self.lookup_declines,1); return false; } remaining--; if dependency { self.inspected_dependencies=satAdd(self.inspected_dependencies,1); } else { self.inspected_positions=satAdd(self.inspected_positions,1); } return true; }
