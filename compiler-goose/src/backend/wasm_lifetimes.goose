fn publishes(module:const Module&,function:const Function&)->bool {for inst in blot_backend_wasm::instructions(module,function) {match inst.op {OP_i32_store,OP_f32_store,OP_v128_store,OP_memory_copy,OP_memory_fill=>{return true;},OP_call=>{if module.arena.value.isAllocation(inst.operand) {return true;}},_=>{},}}return false;}
