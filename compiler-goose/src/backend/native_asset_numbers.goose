    if exponent < -1022 {return blot_native::f64_from_bits(sign | quotient);}if quotient == 9007199254740992 {quotient >>= 1;exponent++;}if exponent > 1023 {return blot_native::f64_from_bits(sign | 9218868437227405312);}let bits = sign | ((exponent + 1023) as u64 << 52) | (quotient & 4503599627370495);return blot_native::f64_from_bits(bits);
}
fn digit(byte: u8) -> bool {return byte >= '0' && byte <= '9';}
fn decimal(text: const u8[:]) -> f64,bool {
    var at: i64 = 0;var negative = false;if at < text.len && (text[at] == '-' || text[at] == '+') {negative = text[at] == '-';at++;}var numerator = Big {..};var kept: i64 = 0;var significant: i64 = 0;var fraction: i64 = 0;var any = false;var nonzero = false;var point = false;var sticky = false;
    while at < text.len {
        let byte = text[at];if byte == '.' && !point {point = true;at++;continue;}if !digit(byte) {break;}any = true;if point {fraction++;}if byte != '0' {nonzero = true;}if nonzero {significant++;if kept < 1152 {numerator.multiplyAdd(10,(byte - '0') as u32);kept++;}else if byte != '0' {sticky = true;}}at++;
    }
