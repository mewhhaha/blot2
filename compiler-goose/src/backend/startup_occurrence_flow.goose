 call => {let call=module.call(id);let target=self_.normalize(blot_support::some(owner),call.target);let target_owner=self_.ownerOf(target.unit,blot_support::none<i64>());if self_.failed() {return Flow{..};}let target_binding=self_.units[target_owner].binding(target.binding);if target_binding.kind==blot_reuse_principal_interface::Kind.local || target_binding.kind==blot_reuse_principal_interface::Kind.parameter {if target_owner!=owner {self_.bad();return Flow{..};}let stored .= frame.values.get(target.binding);if !stored {self_.bad();return Flow{..};}var function=stored;for argument in call.arguments {let result=self_.expression(owner,argument,frame,weak,observe);if self_.failed() || result.returning {return result;}function=self_.invoke(function,[result.value],site,weak,observe,false);if self_.failed() {return Flow{..};}}return Flow{value:function,..};}let declaration=self_.body(target);if self_.failed() {return Flow{..};}var function:ValueId=0;if declaration.is_function {function=self_.named(target);}else {function=self_.constant(target);}if declaration.runtime {self_.emit(site,target,EdgeKind.runtime_read,weak,observe);}let producer=self_.ownerOf(target.unit,blot_support::none<i64>());if self_.failed() {return Flow{..};}let parameters=self_.units[producer].bodyParameters(declaration);var consumed:i64=0;if declaration.is_function {consumed=min(call.arguments.len,parameters.len);}let arguments=word_runs.alloc_slice(consumed);var early=blot_support::none<Flow>();for argument,index in call.arguments[..consumed] {let result=self_.expression(owner,argument,frame,weak,observe);if self_.failed() || result.returning {early=blot_support::some(result);break;}arguments[index]=result.value;}if early.present {word_runs.free_slice(arguments);return early.value;}if declaration.is_function {function=self_.invoke(function,arguments,site,weak,observe,false);}word_runs.free_slice(arguments);if self_.failed() {return Flow{..};}for argument in call.arguments[consumed..] {let result=self_.expression(owner,argument,frame,weak,observe);if self_.failed() || result.returning {return result;}function=self_.invoke(function,[result.value],site,weak,observe,false);if self_.failed() {return Flow{..};}}return Flow{value:function,..};},
