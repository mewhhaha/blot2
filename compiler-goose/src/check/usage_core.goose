}
fn requestLoop(self_: Walker&, source: u32, node: blot_check_core::Node, depth: i64) -> Outcome,Error { if node.a >= self_.module.request_loops.len || node.b != 0 || node.c != 0 || node.op != blot_check_core::Op.none { return Outcome.live,blot_error::Error.invalid_artifact; } let loop_=self_.module.requestLoopInfo(source); if loop_.computation == 0 || loop_.completion_body == 0 || loop_.arms.start > self_.module.request_arms.len || loop_.arms.len > self_.module.request_arms.len-loop_.arms.start { return Outcome.live,blot_error::Error.invalid_artifact; } let flow,err=self_.expression(loop_.computation,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } let mark=self_.snapshot_len; let result,err=requestLoopBody(self_,source,loop_,depth); self_.snapshot_len=mark; return result,err; }
fn requestLoopBody(self_: Walker&, source: u32, loop_: blot_check_core::RequestLoopInfo, depth: i64) -> Outcome,Error { let count=self_.len; let before,err=self_.snapshot(); if err != blot_error::Error.none { return Outcome.live,err; } for arm in self_.module.requestArms(source) { let flow,err=self_.expression(arm.callback,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } for after,index in self_.states[..count] { let prior=before[index]; if after.first != prior.first || after.loan != prior.loan { return Outcome.live,blot_error::Error.invalid_artifact; } } self_.len=count; } if loop_.carries.len != 0 { return Outcome.live,blot_error::Error.invalid_artifact; } if loop_.completion_pattern != 0 { let err=self_.pattern(loop_.completion_pattern,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } } let flow,err=self_.expression(loop_.completion_body,depth+1); self_.len=count; return Outcome.live,err; }
fn loopValue(self_: Walker&, source: u32, node: blot_check_core::Node, depth: i64) -> Outcome,Error { let loop_=self_.module.loops[node.a]; let flow,err=self_.expression(loop_.first,depth+1); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } let flow,err=self_.expression(loop_.end,depth+1); if err != blot_error::Error.none || flow == Outcome.exit { return flow,err; } let mark=self_.snapshot_len; let outer .= self_.breaks; let result,err=loopBody(self_,source,loop_,depth); self_.breaks .= outer; self_.snapshot_len=mark; return result,err; }
fn loopBody(self_: Walker&, source: u32, loop_: blot_check_core::LoopInfo, depth: i64) -> Outcome,Error { let count=self_.len; let before,err=self_.snapshot(); if err != blot_error::Error.none { return Outcome.live,err; } let joined,err=self_.snapshot(); if err != blot_error::Error.none { return Outcome.live,err; } var frame=ExitFrame {target:source,joined:joined, ..}; self_.breaks .= frame; if loop_.pattern != 0 { let err=self_.pattern(loop_.pattern,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } } let flow,err=self_.expression(loop_.body,depth+1); if err != blot_error::Error.none { return Outcome.live,err; } self_.len=count; let single=self_.singleIteration(loop_); if flow == Outcome.live && !single { for after,index in self_.states[..count] { if after.first != before[index].first { return Outcome.live,blot_error::Error.invalid_artifact; } } } if flow == Outcome.live && single { self_.record(frame); } copy(self_.states[..count],frame.joined); if (loop_.kind == blot_check_core::LoopKind.forever || single) && !frame.seen { return Outcome.exit,blot_error::Error.none; } return Outcome.live,blot_error::Error.none; }
fn relevant(module: const Module&, body: blot_check_core::Body) -> bool,Error { let contains,err=blot_check_usage_check::containsNominal(module.types,module.nominals,module.bindings[body.binding].ty); if err != blot_error::Error.none { return false,blot_error::Error.invalid_artifact; } if contains { return true,blot_error::Error.none; } var pending:u32[>..<]; var seen:dictionary<u32,bool>; var walk=blot_eval_body_recipe::Walk {work:pending,seen:seen, ..}; let err=walk.append(body.root); if err != blot_error::Error.none { return false,blot_error::Error.invalid_artifact; }
    while true { let id,present,err=walk.next(); if err != blot_error::Error.none { return false,blot_error::Error.invalid_artifact; } if !present { break; } if walk.count > 65536 { return false,blot_error::Error.invalid_artifact; } let node=module.nodes[id]; if node.ty >= module.types.nodes.len { return false,blot_error::Error.invalid_artifact; } let contains,err=blot_check_usage_check::containsNominal(module.types,module.nominals,node.ty); if err != blot_error::Error.none { return false,blot_error::Error.invalid_artifact; } if contains { return true,blot_error::Error.none; } if node.tag == blot_check_core::Tag.closure { if node.a >= module.closures.len { return false,blot_error::Error.invalid_artifact; } let err=walk.append(module.closures[node.a].body); if err != blot_error::Error.none { return false,blot_error::Error.invalid_artifact; } } if node.tag == blot_check_core::Tag.computation && (node.a == 0 || node.a >= module.nodes.len) { return false,blot_error::Error.invalid_artifact; } if node.tag == blot_check_core::Tag.request_loop { if node.a >= module.request_loops.len { return false,blot_error::Error.invalid_artifact; } let loop_=module.requestLoopInfo(id); if loop_.computation == 0 || loop_.completion_body == 0 || loop_.arms.start > module.request_arms.len || loop_.arms.len > module.request_arms.len-loop_.arms.start { return false,blot_error::Error.invalid_artifact; } } let err=blot_eval_body_recipe::appendChildren(walk,module,id,true); if err != blot_error::Error.none { return false,blot_error::Error.invalid_artifact; }
