// Independent deterministic 250-graph oracle (seed 0x94671). Expected results
// were generated with Python transitive closure and explicit Eq components;
// neither graph construction nor expected results call the Goose engine.
import std;
import proofgraph_engine;
import proofgraph_validate;
fn run(source:u8[:], n:i64, conflict:bool, classes:u8[:], exp:u8[:]) {
 var probe=proofgraph_engine::Job {};let begin=proofgraph_engine::begin(source,probe);
 if conflict {assert(begin.status==6 && probe.failed);return;} assert(begin.status==0);
 for i in n {let t=proofgraph_engine::term((i+1) as u32);let root=proofgraph_engine::root(probe,(i+1) as u32);assert(root.status==0 && root.id==classes[i]);assert(proofgraph_validate::verify_class(source,probe,t,classes[i]).status==0);}assert(proofgraph_engine::finish(probe).status==0);
 var k:i64=0;for l in n {for r in n {for strict in [false,true] {var job=proofgraph_engine::Job {};assert(proofgraph_engine::begin(source,job).status==0);let a=proofgraph_engine::term((l+1) as u32);let b=proofgraph_engine::term((r+1) as u32);let q=proofgraph_engine::query(job,a,b,strict);if exp[k]==0 {assert(q.status==5);}else {assert(q.status==0 && proofgraph_validate::verify(source,job,q.proof,a,b,strict).status==0);assert(proofgraph_engine::drop(job).status==0);}assert(proofgraph_engine::finish(job).status==0 && job.meter.proof_edges==0);k+=1;}}}
}
