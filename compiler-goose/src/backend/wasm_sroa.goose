struct Cost {scopes:Budget[65]=[Budget{..};65],loops:i64=0,valid:bool=true}
fn costs(module:const Module&,instructions:const Instruction[:])->Cost {var value=Cost{..};var controls:i64[256]=[0;256];var depth:i64=0;var current:i64=0;for inst,at in instructions {match inst.op {blot_backend_runtime_ir::OP_block,blot_backend_runtime_ir::OP_loop,blot_backend_runtime_ir::OP_if_=>{if depth==controls.len {value.valid=false;return value;}controls[depth]=current;depth+=1;if inst.op==blot_backend_runtime_ir::OP_loop {value.loops+=1;if value.loops==value.scopes.len {value.valid=false;return value;}current=value.loops;}},blot_backend_runtime_ir::OP_end=>{if depth==0 {value.valid=false;return value;}depth-=1;current=controls[depth];},_=>{},}if inst.op==blot_backend_runtime_ir::OP_call && module.arena.value.isAllocation(inst.operand) && !blot_backend_runtime_ir::hasJournalCarrier(instructions,at) {value.scopes[current].allocations+=1;}if inst.op==blot_backend_runtime_ir::OP_ownership {let fact=blot_backend_runtime_ir::ownership(inst.operand);if fact.kind==blot_backend_runtime_ir::OWN_scope && fact.chunk==4 {value.scopes[current].publications+=1;}}}return value;}
fn run(module:const Module&,function:const Function&)->blot_support::Option<Output>,Error {return runWithRoots(module,function,false);}
fn runWithRoots(module:const Module&,function:const Function&,owning:bool)->blot_support::Option<Output>,Error {let selected,error=runMode(module,function,owning,true);if error!=blot_error::Error.none || !selected.present {return blot_support::none<Output>(),error;}var output=selected.value;let before=costs(module,blot_backend_wasm::instructions(module,function));let after=costs(module,output.instructions);var admitted=before.valid && after.valid && before.loops==after.loops;if admitted {for left,index in before.scopes {let right=after.scopes[index];if right.allocations>left.allocations || (right.publications>left.publications && right.publications-left.publications>=2*(left.allocations-right.allocations)) {admitted=false;break;}}}if !admitted {output.deinit();return runMode(module,function,owning,false);}return blot_support::some(output),blot_error::Error.none;}
fn runMode(module:const Module&,function:const Function&,owning:bool,children:bool)->blot_support::Option<Output>,Error {if !module.arena.present {return blot_support::none<Output>(),blot_error::Error.none;}var output=blot_support::none<Output>();var previous:i64=0x7fffffffffffffff;var rounds:i64=0;while children || rounds<4 {rounds+=1;let locals=if output.present {output.value.locals}else {module.locals(function)};let instructions=if output.present {output.value.instructions}else {blot_backend_wasm::instructions(module,function)};var allocations:i64=0;for inst,index in instructions {if inst.op==blot_backend_runtime_ir::OP_call && module.arena.value.isAllocation(inst.operand) && index!=0 && instructions[index-1].op==blot_backend_runtime_ir::OP_i32_const && instructions[index-1].operand<=64 {allocations+=1;}}if allocations==0 || allocations>=previous {break;}previous=allocations;let next,error=pass(module,function,locals,instructions,owning,children);if error!=blot_error::Error.none {if output.present {output.value.deinit();}return blot_support::none<Output>(),error;}if !next.present {break;}if output.present {output.value.deinit();}output=next;}if output.present {let error=pruneFieldRoots(module,owning,function.parameters.len,output.value);if error!=blot_error::Error.none {output.value.deinit();return blot_support::none<Output>(),error;}}return output,blot_error::Error.none;}
