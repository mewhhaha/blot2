        if self_.module.types.node(self_.module.typeOf(id)).tag == blot_check_types::Tag.erased_proof { if !header.result.present || arguments.len != header.arity { return Value {..}, blot_error::Error.invalid_artifact; } let propositions, err = header.signature().instantiate(self_.values, substituted.items); if err != blot_error::Error.none { return Value {..}, err; } let result = propositions[propositions.len - 1]; let err = self_.fact(Fact.order { result , ..}); return Value { proof: blot_support::some(result) , ..}, err; }
    } else { for value in actual.items { let err = ordinary(value); if err != blot_error::Error.none { return Value {..}, err; } } if self_.module.types.node(self_.module.typeOf(id)).tag == blot_check_types::Tag.erased_proof { return Value {..}, blot_error::Error.invalid_artifact; } }
    if self_.plan { let tag = self_.module.types.node(self_.module.typeOf(id)).tag; if tag == blot_check_types::Tag.boolean || kind(tag).present || opaqueReferenceResult(selected.module, selected.binding, arguments.len) { let value, err = self_.summaryCall(raw, actual.items, 0); if err != blot_error::Error.none { return Value {..}, err; } if value.operand != 0 || value.condition != 0 { return value, blot_error::Error.none; } } } return self_.version(self_.module.typeOf(id), 0);
