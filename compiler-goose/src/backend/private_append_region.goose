// Private empty-List accumulation preserves original expression execution.
namespace blot_backend_private_append_region;
import check.core;
import check.types;
import .collection_ops;
import .function_facts;
import support.option;
type Module = blot_check_core::Module;
type OptionBinding = blot_support::Option<u32>;
struct Plan {initial: u32,append: u32 = 0,conversion: u32 = 0}
struct Frame {id: u32,index: i64,iteration: u32,count: i64,exhaustions: i64 = 0}
struct Analyzer {module: const Module&,plan: Plan,aliases: u32[64] = [0;64],alias_count: i64 = 0,expressions: u32[64] = [0;64],expression_count: i64 = 0,loops: i64 = 0,remaining: i64 = 256,frames: Frame[16] = [Frame {..};16],frame_count: i64 = 0,other_carries: u32[64] = [0;64],other_count: i64 = 0}
fn step(self: Analyzer&) -> bool {if self.remaining == 0 {return false;}self.remaining--;return true;}
fn other(self: Analyzer&,binding: u32) -> bool {if self.other_count == 64 {return false;}self.other_carries[self.other_count] = binding;self.other_count++;return true;}
fn alias(self: const Analyzer&,binding: u32) -> bool {for candidate in self.aliases[..self.alias_count] {if candidate == binding {return true;}}return false;}
fn add(self: Analyzer&,binding: u32) -> bool {if self.alias(binding) {return true;}if self.alias_count == 64 {return false;}self.aliases[self.alias_count] = binding;self.alias_count++;return true;}
fn expression(self: Analyzer&,id: u32) -> bool {if id == 0 {return true;}if self.expression_count == 64 {return false;}self.expressions[self.expression_count] = id;self.expression_count++;return true;}
fn local(self: const Analyzer&,id: u32,binding: u32) -> bool {return blot_backend_function_facts::local(self.module,id,binding);}
recursive fn pattern(self: Analyzer&,id: u32) -> bool {if id == 0 {return true;}if !self.step() {return false;}let pattern = self.module.pattern(id);match pattern.tag {bind=>{return self.other(pattern.a);},wildcard,constant=>{return true;},product=>{for child in self.module.extra[pattern.a..pattern.a + pattern.b] {if !self.pattern(child) {return false;}}return true;},constructor,record_payload=>{return self.pattern(pattern.b);},_=>{return false;},}}
recursive fn exhaustion(self: Analyzer&,id: u32) -> bool {if id == 0 || self.frame_count == 0 || !self.step() {return false;}let node = self.module.node(id);if node.tag == blot_check_core::Tag.suite || node.tag == blot_check_core::Tag.block_ {let children = self.module.children(id);return children.len == 1 && self.exhaustion(children[0]);}let frame_index = self.frame_count - 1;let frame = self.frames[frame_index];if node.tag != blot_check_core::Tag.break_ || node.op != blot_check_core::Op.none || node.a != frame.id {return false;}let values = self.module.breakValues(id);if values.len != frame.count || !self.local(values[frame.index],frame.iteration) {return false;}for value,index in values {if index != frame.index && !self.expression(value) {return false;}}self.frames[frame_index].exhaustions++;return true;}
fn append(self: Analyzer&,id: u32,incoming: u32) -> bool {
    let module .= self.module;var append_id = id;var receiver = incoming;var payload: u32 = 0;
    if module.node(id).tag == blot_check_core::Tag.block_ {let children = module.children(id);if children.len != 3 {return false;}let first = module.node(children[0]);let second = module.node(children[1]);let last = module.node(children[2]);if first.tag != blot_check_core::Tag.bind || second.tag != blot_check_core::Tag.bind || last.tag != blot_check_core::Tag.return_ || last.b != id {return false;}if !self.local(first.b,incoming) || !self.add(first.a) {return false;}receiver = first.a;append_id = last.a;if module.node(append_id).tag != blot_check_core::Tag.array_op || module.arrayOperation(append_id) != blot_backend_collection_ops::Op.append {return false;}let operands = module.children(append_id);if operands.len != 2 || !self.local(operands[1],second.a) {return false;}payload = second.b;}
    if module.node(append_id).tag != blot_check_core::Tag.array_op || module.arrayOperation(append_id) != blot_backend_collection_ops::Op.append || self.plan.append != 0 {return false;}let operands = module.children(append_id);if operands.len != 2 || !self.local(operands[0],receiver) {return false;}var expression = payload;if expression == 0 {expression = operands[1];}if !self.expression(expression) {return false;}self.plan.append = append_id;return true;
}
recursive fn suite(self: Analyzer&,id: u32,incoming: u32) -> OptionBinding {if id == 0 {return blot_support::some(incoming);}if !self.step() {return blot_support::none<u32>();}let node = self.module.node(id);if node.tag != blot_check_core::Tag.block_ && node.tag != blot_check_core::Tag.suite {return self.region(id,incoming);}var current = incoming;for child in self.module.children(id) {let next = self.region(child,current);if !next.present {return next;}current = next.value;}return blot_support::some(current);}
recursive fn region(self: Analyzer&,id: u32,incoming: u32) -> OptionBinding {
    if !self.step() {return blot_support::none<u32>();}let module .= self.module;let node = module.node(id);
    match node.tag {
        suite=>{return self.suite(id,incoming);},
        loop_=>{
            let info = module.loopInfo(id);let carries = module.loopCarries(id);var selected = blot_support::none<i64>();for carry,index in carries {if carry.incoming == incoming {if selected.present {return blot_support::none<u32>();}selected = blot_support::some(index);}}if !selected.present {return blot_support::none<u32>();}let index = selected.value;let carry = carries[index];
            for other,ordinal in carries {if ordinal != index {if !self.other(other.incoming) || !self.other(other.iteration) || !self.other(other.backedge) || !self.other(other.outgoing) {return blot_support::none<u32>();}}}
            if !self.add(carry.iteration) || !self.add(carry.backedge) || !self.add(carry.outgoing) || !self.expression(info.first) || !self.expression(info.end) || !self.pattern(info.pattern) || self.frame_count == 16 {return blot_support::none<u32>();}
            let frame_index = self.frame_count;self.frames[frame_index] = Frame {id,index,iteration: carry.iteration,count: carries.len,..};self.frame_count++;let out = self.suite(info.body,carry.iteration);self.frame_count--;if !out.present || out.value != carry.backedge {return blot_support::none<u32>();}
            var needs_exhaustion = info.can_exit;match info.kind {forever=>{needs_exhaustion = true;},_=>{},}if needs_exhaustion && self.frames[frame_index].exhaustions == 0 {return blot_support::none<u32>();}self.loops++;return blot_support::some(carry.outgoing);
        },
        pattern_bind=>{if self.frame_count == 0 || incoming != self.frames[self.frame_count - 1].iteration {return blot_support::none<u32>();}if !self.pattern(node.a) || !self.expression(node.b) || !self.exhaustion(node.c) {return blot_support::none<u32>();}return blot_support::some(incoming);},
        if_stmt=>{if !self.expression(node.a) {return blot_support::none<u32>();}let merges = module.branchMerges(id);if merges.len != 1 || merges[0].else_binding != incoming {return blot_support::none<u32>();}let alternate = self.suite(node.c,incoming);if !alternate.present || alternate.value != incoming {return blot_support::none<u32>();}let selected = self.suite(node.b,incoming);if !selected.present || selected.value != merges[0].then_binding || !self.add(merges[0].result) {return blot_support::none<u32>();}return blot_support::some(merges[0].result);},
        bind=>{if self.append(node.b,incoming) || self.local(node.b,incoming) {if !self.add(node.a) {return blot_support::none<u32>();}return blot_support::some(node.a);}if self.alias(node.a) || !self.expression(node.b) {return blot_support::none<u32>();}return blot_support::some(incoming);},_=>{return blot_support::none<u32>();},
    }
}
recursive fn independent(self: Analyzer&,id: u32) -> bool {if id == 0 {return true;}if !self.step() {return false;}let module .= self.module;let node = module.node(id);match node.tag {constant,panic=>{return true;},reference=>{let reference = module.reference(id);return (reference.unit != 0 && reference.unit != module.unit) || !self.alias(reference.binding);},scalar,associated,apply,logical=>{return self.independent(node.a) && self.independent(node.b);},project=>{return self.independent(node.a);},construct=>{return self.independent(node.b);},if_value=>{return self.independent(node.a) && self.independent(node.b) && self.independent(node.c);},array,array_op,product,record=>{for child in module.children(id) {if !self.independent(child) {return false;}}return true;},call=>{for child in module.call(id).arguments {if !self.independent(child) {return false;}}return true;},closure=>{for capture in module.closureCaptures(id) {if !self.step() || self.alias(capture) {return false;}}return true;},_=>{return false;},}}
fn analyzeBlock(module: const Module&,id: u32,conversion: u32,converted: u32) -> blot_support::Option<Plan> {
    if module.node(id).tag != blot_check_core::Tag.block_ {return blot_support::none<Plan>();}let statements = module.children(id);if statements.len < 3 || statements.len > 19 {return blot_support::none<Plan>();}let first = module.node(statements[0]);let last = module.node(statements[statements.len - 1]);if first.tag != blot_check_core::Tag.bind || last.tag != blot_check_core::Tag.return_ || last.b != id {return blot_support::none<Plan>();}
    if module.node(first.b).tag != blot_check_core::Tag.array || module.children(first.b).len != 0 || module.types.node(module.typeOf(first.b)).tag != blot_check_types::Tag.list {return blot_support::none<Plan>();}var analyzer = Analyzer {module,plan: Plan {initial: first.b,conversion,..},..};if !analyzer.add(first.a) {return blot_support::none<Plan>();}var outgoing = first.a;
    for statement in statements[1..statements.len - 1] {let next = analyzer.region(statement,outgoing);if !next.present {return blot_support::none<Plan>();}outgoing = next.value;}
    if analyzer.loops == 0 || analyzer.plan.append == 0 || !analyzer.local(converted,outgoing) {return blot_support::none<Plan>();}for binding in analyzer.other_carries[..analyzer.other_count] {if analyzer.alias(binding) {return blot_support::none<Plan>();}}for expression in analyzer.expressions[..analyzer.expression_count] {if !analyzer.independent(expression) {return blot_support::none<Plan>();}}return blot_support::some(analyzer.plan);
}
fn analyze(module: const Module&,id: u32) -> blot_support::Option<Plan> {if module.node(id).tag != blot_check_core::Tag.block_ {return blot_support::none<Plan>();}let statements = module.children(id);if statements.len == 0 {return blot_support::none<Plan>();}let last = module.node(statements[statements.len - 1]);if last.tag != blot_check_core::Tag.return_ || last.b != id || module.node(last.a).tag != blot_check_core::Tag.array_op || module.arrayOperation(last.a) != blot_backend_collection_ops::Op.convert || module.types.node(module.typeOf(last.a)).tag != blot_check_types::Tag.array {return blot_support::none<Plan>();}let converted = module.children(last.a);if converted.len != 1 {return blot_support::none<Plan>();}return analyzeBlock(module,id,last.a,converted[0]);}
fn analyzeConversion(module: const Module&,id: u32) -> blot_support::Option<Plan> {if module.node(id).tag != blot_check_core::Tag.array_op || module.arrayOperation(id) != blot_backend_collection_ops::Op.convert || module.types.node(module.typeOf(id)).tag != blot_check_types::Tag.array {return blot_support::none<Plan>();}let inputs = module.children(id);if inputs.len != 1 || module.node(inputs[0]).tag != blot_check_core::Tag.block_ || module.types.node(module.typeOf(inputs[0])).tag != blot_check_types::Tag.list {return blot_support::none<Plan>();}let statements = module.children(inputs[0]);if statements.len == 0 {return blot_support::none<Plan>();}let last = module.node(statements[statements.len - 1]);if last.tag != blot_check_core::Tag.return_ || last.b != inputs[0] {return blot_support::none<Plan>();}return analyzeBlock(module,inputs[0],id,last.a);}
