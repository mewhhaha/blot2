 }return Error.none;}
fn replayChild<G>(self:State&,g:G&,child:u32)->Error {let old .= self.old.metadata.jobs.items[child-1];var constant=false;match old.request {Request.constant=>{constant=true;},_=>{},}if constant && !scalarConstant(self.old,old) {let admitted .= self.aggregate_constants.get(child);if !admitted {return Error.invalid_function_reference;}let actual,error=g.replayConstant(admitted.request);if error!=Error.none {return error;}let error=self.constant_addresses.push(Address{original:admitted.root,actual:actual,len:1,owner:child,..});if error!=Error.none {return error;}self.stats.reused_aggregate_constants+=1;}else if constant {let request,error=self.scalarConstantRequest(g,old);if error!=Error.none {return error;}if !request.present {return Error.invalid_function_reference;}let error=g.replayScalarConstant(request.value);if error!=Error.none {return error;}self.stats.reused_scalar_constants+=1;}else {let request,error=self.importer.importRequest(g,old.request);if error!=Error.none {return error;}if !request.present {return Error.invalid_function_reference;}let actual,error=g.replayRequest(request.value);if error!=Error.none {return error;}if old.function.present {self.functions[old.function.value]=actual;}}return Error.none;}
fn reconstruct<G>(self:State&,g:G&,id:u32,request:Request,scope:blot_reuse_code_artifacts::Scope?)->u32,Error {let job .= self.old.metadata.jobs.items[id-1];if !job.function.present {return 0,Error.invalid_function_reference;}let old_function=job.function.value;var meta=self.metaAt(self.starts[id-1]);var emission=self.emissionAt(self.starts[id-1]);let end=self.ends[id-1];loop {var next_meta:u64=0xffffffffffffffff;var next_emission:u64=0xffffffffffffffff;if meta<self.old.metadata.events.len {next_meta=self.old.metadata.events.items[meta].sequence;}if emission<self.old.emission.records.len {next_emission=self.old.emission.records.items[emission].sequence;}if min(next_meta,next_emission)>end {break;}if next_meta<next_emission {let event=self.old.metadata.events.items[meta].event;meta+=1;match event {MetaEvent.enter item=>{let child=item.job;if child!=id {let error=self.replayChild(g,child);if error!=Error.none {return 0,error;}meta=self.metaAt(self.ends[child-1]+1);emission=self.emissionAt(self.ends[child-1]+1);}},MetaEvent.reserve=>{let actor .= scope;if actor {let error=actor.reserve(self.functions[old_function]);if error!=Error.none {return 0,error;}}},_=>{},}continue;}let record=self.old.emission.records.items[emission];emission+=1;let error=self.replayEmission(g,record,request,id);if error!=Error.none {return 0,error;}}let actual=self.functions[old_function];if actual==absent {return 0,Error.invalid_function_reference;}var template=blot_support::none<u32>();if job.result_template.present {let imported,error=self.importer.importResultTemplate(g,job.result_template.value);if error!=Error.none {return 0,error;}if !imported.present {return 0,Error.invalid_function_reference;}template=imported;}let error=g.publishRetainedResult(request,template);if error!=Error.none {return 0,error;}let actor .= scope;if actor {let error=publishScope(self,g,job,actor,actual,template);if error!=Error.none {return 0,error;}}match request {Request.named=>{self.stats.reused_named+=1;},Request.closure=>{self.stats.reused_closures+=1;},_=>{},}return actual,Error.none;}
fn publishScope<G>(self:State&,g:G&,job:const Job&,actor:blot_reuse_code_artifacts::Scope&,actual:u32,template:blot_support::Option<u32>)->Error {for read in self.old.metadata.static_reads.items[job.static_reads.start..job.static_reads.start+job.static_reads.len] {let value .= self.static_matches.get(staticKey(read));if !value {return Error.invalid_function_reference;}let error=actor.context.readStaticValue(blot_check_core::BindingRef{unit:self.importer.unit_map[read.target.unit-1],binding:read.target.binding,..},value);if error!=Error.none {return error;}}for target in self.old.metadata.inline_bodies.items[job.inline_bodies.start..job.inline_bodies.start+job.inline_bodies.len] {let mapped=self.importer.unit_map[target.unit-1];if mapped==0 {return Error.invalid_function_reference;}let error=actor.context.readInlineBody(blot_check_core::BindingRef{unit:mapped,binding:target.binding,..});if error!=Error.none {return error;}}if job.solved {let imported,error=self.importer.importSolved(g,job);if error!=Error.none {return error;}if !imported.present {return Error.invalid_function_reference;}var solved=imported.value;let error=actor.solved(solved.mappings,solved.rows,solved.templates);solved.deinit();if error!=Error.none {return error;}}return actor.complete(actual,template);}
