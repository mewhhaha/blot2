fn copyFrame(self:Walk&,frame:const Frame&)->Frame {var result=Frame{possible_return:frame.possible_return,..};for entry in frame.values.table.slots {if entry.tag!=0 {result.values.insert(entry.key,entry.val);}}return result;}
fn join(self:Walk&,left:ValueId,right:ValueId)->ValueId {if self.failed() {return 0;}if left==right {return left;}var l=self.values.items[left];let r=self.values.items[right];if l.kind!=Kind.scalar || r.kind!=Kind.scalar || l.scalar.scalar!=r.scalar.scalar {return self.bad();}if !l.known || !r.known || l.scalar.bits!=r.scalar.bits {l.known=false;}if l.actual!=r.actual {l.actual=blot_support::none<u32>();}if l.provenance!=r.provenance {l.provenance=Provenance.waiting;}return self.add(l);}
