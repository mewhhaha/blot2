 global_bits item=>{if !self_.arena.present {return blot_error::Error.none;}let old=self_.arena.value;let wide=blot_runtime_shared_rc::shaped_mode;if item.id!=old.rc_enabled || item.bits.value&wide==0 {return blot_error::Error.none;}let error=self_.ensureArena(g);if error!=blot_error::Error.none {return error;}let flag=g.module.arena.value.rc_enabled;let bits=g.module.globals[flag].bits|wide;let journal .= g.module.artifacts;if journal {let error=journal.append(blot_reuse_artifact_emitter::Event.global_bits{id:flag,bits:Operand{value:bits,..},..});if error!=blot_error::Error.none {return error;}}g.module.globals[flag].bits=bits;},
 mutable_static=>{g.module.mutable_static=true;},static_field item=>{let address,error=self_.resolveAddress(item.address);if error!=blot_error::Error.none {return error;}return g.module.staticField(address,item.role);},
 export_,start,public_arena,public_owners,cleanup_data=>{return blot_error::Error.invalid_function_reference;},
 }return blot_error::Error.none;}
fn replayChild<G>(self_:State&,g:G&,child:u32)->Error {let old .= self_.old.metadata.jobs.items[child-1];var constant=false;match old.request {constant=>{constant=true;},_=>{},}if constant && !scalarConstant(self_.old,old) {let admitted .= self_.aggregate_constants.get(child);if !admitted {return blot_error::Error.invalid_function_reference;}let actual,error=g.replayConstant(admitted.request);if error!=blot_error::Error.none {return error;}let error=self_.constant_addresses.push(Address{original:admitted.root,actual:actual,len:1,owner:child,..});if error!=blot_error::Error.none {return error;}self_.stats.reused_aggregate_constants+=1;}else if constant {let request,error=self_.scalarConstantRequest(g,old);if error!=blot_error::Error.none {return error;}if !request.present {return blot_error::Error.invalid_function_reference;}let error=g.replayScalarConstant(request.value);if error!=blot_error::Error.none {return error;}self_.stats.reused_scalar_constants+=1;}else {let request,error=self_.importer.importRequest(g,old.request);if error!=blot_error::Error.none {return error;}if !request.present {return blot_error::Error.invalid_function_reference;}let actual,error=g.replayRequest(request.value);if error!=blot_error::Error.none {return error;}if old.function.present {self_.functions[old.function.value]=actual;}}return blot_error::Error.none;}
fn reconstruct<G>(self_:State&,g:G&,id:u32,request:Request,scope:blot_reuse_code_artifacts::Scope?)->u32,Error {let job .= self_.old.metadata.jobs.items[id-1];if !job.function.present {return 0,blot_error::Error.invalid_function_reference;}let old_function=job.function.value;var meta=self_.metaAt(self_.starts[id-1]);var emission=self_.emissionAt(self_.starts[id-1]);let end=self_.ends[id-1];loop {var next_meta:u64=0xffffffffffffffff;var next_emission:u64=0xffffffffffffffff;if meta<self_.old.metadata.events.len {next_meta=self_.old.metadata.events.items[meta].sequence;}if emission<self_.old.emission.records.len {next_emission=self_.old.emission.records.items[emission].sequence;}if min(next_meta,next_emission)>end {break;}if next_meta<next_emission {let event=self_.old.metadata.events.items[meta].event;meta+=1;match event {enter item=>{let child=item.job;if child!=id {let error=self_.replayChild(g,child);if error!=blot_error::Error.none {return 0,error;}meta=self_.metaAt(self_.ends[child-1]+1);emission=self_.emissionAt(self_.ends[child-1]+1);}},reserve=>{let actor .= scope;if actor {let error=actor.reserve(self_.functions[old_function]);if error!=blot_error::Error.none {return 0,error;}}},_=>{},}continue;}let record=self_.old.emission.records.items[emission];emission+=1;let error=self_.replayEmission(g,record,request,id);if error!=blot_error::Error.none {return 0,error;}}let actual=self_.functions[old_function];if actual==absent {return 0,blot_error::Error.invalid_function_reference;}var template=blot_support::none<u32>();if job.result_template.present {let imported,error=self_.importer.importResultTemplate(g,job.result_template.value);if error!=blot_error::Error.none {return 0,error;}if !imported.present {return 0,blot_error::Error.invalid_function_reference;}template=imported;}let error=g.publishRetainedResult(request,template);if error!=blot_error::Error.none {return 0,error;}let actor .= scope;if actor {let error=publishScope(self_,g,job,actor,actual,template);if error!=blot_error::Error.none {return 0,error;}}match request {named=>{self_.stats.reused_named+=1;},closure=>{self_.stats.reused_closures+=1;},_=>{},}return actual,blot_error::Error.none;}
fn publishScope<G>(self_:State&,g:G&,job:const Job&,actor:blot_reuse_code_artifacts::Scope&,actual:u32,template:blot_support::Option<u32>)->Error {for read in self_.old.metadata.static_reads.items[job.static_reads.start..job.static_reads.start+job.static_reads.len] {let value .= self_.static_matches.get(staticKey(read));if !value {return blot_error::Error.invalid_function_reference;}let error=actor.context.readStaticValue(blot_check_core::BindingRef{unit:self_.importer.unit_map[read.target.unit-1],binding:read.target.binding,..},value);if error!=blot_error::Error.none {return error;}}for target in self_.old.metadata.inline_bodies.items[job.inline_bodies.start..job.inline_bodies.start+job.inline_bodies.len] {let mapped=self_.importer.unit_map[target.unit-1];if mapped==0 {return blot_error::Error.invalid_function_reference;}let error=actor.context.readInlineBody(blot_check_core::BindingRef{unit:mapped,binding:target.binding,..});if error!=blot_error::Error.none {return error;}}if job.solved {let imported,error=self_.importer.importSolved(g,job);if error!=blot_error::Error.none {return error;}if !imported.present {return blot_error::Error.invalid_function_reference;}var solved=imported.value;let error=actor.solved(solved.mappings,solved.rows,solved.templates);solved.deinit();if error!=blot_error::Error.none {return error;}}return actor.complete(actual,template);}
