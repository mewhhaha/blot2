import i08_header_parse; import i08_typed_shape; import i08_bound_shape; fn main(){
{let s="pub let project: forall [r: Region, s: Region, n: Nat, c: Nat, d: Domain] => Fn[static, Many, (View[r,{x:F32,y:F32,vx:F32,vy:F32},n,d], F32, Builder[s,{x:F32,y:F32},0,c,Append]), exists [e: Domain] => View[s,{x:F32,y:F32},n,e]] ! {read r, write s} requires [Le(n,c)] resources {depth: 2, frame: 256} = fn (source,dt,initial) => do:\n  let built = for i in 0..n carry (b = initial) do:\n    let part = for j in 0..n carry (q = b) do:\n      next (builder.append(q, {x: source[i].x + source[i].vx * dt, y: source[i].y + source[i].vy * dt}))\n    next (part)\n  return builder.freeze(built)\n";var p,st=i08_header_parse::parse(s);assert(st==0 && i08_typed_shape::verify(p,s));assert(i08_bound_shape::verify(p,s)==true);}
{let s="pub let project: forall [r: Region, s: Region, n: Nat, c: Nat, d: Domain] => Fn[static, Many, (View[r,{x:F32,y:F32,vx:F32,vy:F32},n,d], F32, Builder[s,{x:F32,y:F32},0,c,Append]), exists [e: Domain] => View[s,{x:F32,y:F32},n,e]] ! {read r, write s} requires [Le(n,c)] resources {depth: 2, frame: 256} = fn (source,dt,initial) => do:\n  let built = for i in 0..n carry (b = initial) do:\n    let part = for j in 0..n carry (q = b) do:\n      next (builder.append(q, {x: source[j].x + source[j].vx * dt, y: source[j].y + source[j].vy * dt}))\n    next (part)\n  return builder.freeze(built)\n";var p,st=i08_header_parse::parse(s);assert(st==0 && i08_typed_shape::verify(p,s));assert(i08_bound_shape::verify(p,s)==true);}
{let s="pub let project: forall [r: Region, s: Region, n: Nat, c: Nat, d: Domain] => Fn[static, Many, (View[r,{x:F32,y:F32,vx:F32,vy:F32},n,d], F32, Builder[s,{x:F32,y:F32},0,c,Append]), exists [e: Domain] => View[s,{x:F32,y:F32},n,e]] ! {read r, write s} requires [Le(n,c)] resources {depth: 2, frame: 256} = fn (source,dt,initial) => do:\n  let built = for i in 0..n carry (b = initial) do:\n    let part = for j in 0..n carry (q = b) do:\n      next (builder.append(q, {x: source[c].x + source[c].vx * dt, y: source[c].y + source[c].vy * dt}))\n    next (part)\n  return builder.freeze(built)\n";var p,st=i08_header_parse::parse(s);assert(st==0 && i08_typed_shape::verify(p,s));assert(i08_bound_shape::verify(p,s)==false);}
{let s="pub let project: forall [r: Region, s: Region, n: Nat, c: Nat, d: Domain] => Fn[static, Many, (View[r,{x:F32,y:F32,vx:F32,vy:F32},n,d], F32, Builder[s,{x:F32,y:F32},0,c,Append]), exists [e: Domain] => View[s,{x:F32,y:F32},n,e]] ! {read r, write s} requires [Le(n,c)] resources {depth: 2, frame: 256} = fn (source,dt,initial) => do:\n  let built = for i in 0..n carry (b = initial) do:\n    let part = for j in 0..n carry (q = b) do:\n      next (builder.append(q, {x: source[0].x + source[0].vx * dt, y: source[0].y + source[0].vy * dt}))\n    next (part)\n  return builder.freeze(built)\n";var p,st=i08_header_parse::parse(s);assert(st==0 && i08_typed_shape::verify(p,s));assert(i08_bound_shape::verify(p,s)==false);}
print("nested I08 body scope controls passed");}