// Text is an Array U32 of Unicode scalar values. Equality compares scalar
// sequences exactly; it does not normalize Unicode.
const empty: Text = ""
func length (value: Text) => return value.length
func is_empty (value: Text) => return value.length == 0
func at index -> (value: Text) => return value[index]
func concat (left: Text) -> (right: Text) : Text => return @array.concat left right

func equal (left: Text) -> (right: Text) : Bool => return do:
  if left.length != right.length:
    break false
  for index in 0..left.length:
    if left[index] != right[index]:
      return false
  break true

func valid_scalar value => return
  value <= 0x10FFFF and (value < 0xD800 or value > 0xDFFF)
// Both take the array over: a Text is its scalars, so nothing is copied.
func from_scalars (values: own Array U32) : Maybe Text => return do:
  for value in values:
    if Bool.not (valid_scalar value):
      return $Nothing
  break $Some values
func scalars (value: own Text) => return value

// Unicode White_Space, excluding the zero-width space and BOM.
func is_whitespace (value: U32): Bool => return
  (value >= 9 and value <= 13)
  or value == 0x20 or value == 0x85 or value == 0xA0
  or value == 0x1680 or (value >= 0x2000 and value <= 0x200A)
  or value == 0x2028 or value == 0x2029 or value == 0x202F
  or value == 0x205F or value == 0x3000

// Borrowed, nonempty words separated by Unicode whitespace. The input owns
// the scalars; taking a word or copying the cursor does not copy the text.
type Words is data = $Words { source: &[U32], index: U32 }
func split_whitespace (source: Text): Words => return
  $Words { source: &source[0..source.length], index: 0 }
func Words.iter (cursor: Words): Words => return cursor
func Words.next (cursor: Words): Maybe (&[U32], Words) => do:
  let source = cursor.source
  let start = cursor.index
  for index in start..source.length:
    if Bool.not (is_whitespace source[index]):
      break
    start := self + 1
  if start >= source.length:
    return $Nothing
  let end = start
  for index in start..source.length:
    if is_whitespace source[index]:
      break
    end := self + 1
  return $Some (&source[start..end], $Words { source, index: end })

// Split on LF, removing a CR immediately before it. Interior empty lines
// remain, but an empty input or a final LF does not add a line.
type Lines is data = $Lines { source: &[U32], index: U32 }
func lines (source: Text): Lines => return
  $Lines { source: &source[0..source.length], index: 0 }
func Lines.iter (cursor: Lines): Lines => return cursor
func Lines.next (cursor: Lines): Maybe (&[U32], Lines) => do:
  let source = cursor.source
  let start = cursor.index
  if start >= source.length:
    return $Nothing
  for index in start..source.length:
    if source[index] == 10:
      let end = if index > start and source[index - 1] == 13 then index - 1 else index
      return $Some (&source[start..end], $Lines { source, index: index + 1 })
  return $Some (&source[start..source.length], $Lines { source, index: source.length })

// Accept a nonempty sequence of ASCII decimal digits, including a borrowed
// text slice. Reject signs, whitespace, other characters and U32 overflow.
func parse_u32 value: Maybe U32 => do:
  if value.length == 0:
    return $Nothing
  let result = 0
  for ch in value:
    if ch < 48 or ch > 57:
      return $Nothing
    let digit: U32 = ch - 48
    if result > (0xFFFF_FFFF - digit) / 10:
      return $Nothing
    result := self * 10 + digit
  return $Some result

// Append into a persistent List; one conversion produces the final Array.
type Builder = List U32
func builder () : Builder => return []
func push scalar -> (out: Builder) => return [...out, scalar]
func append (value: Text) -> (out: Builder) : Builder => return do:
  let result = out
  for scalar in value:
    result := [...self, scalar]
  break result
func finish (out: Builder) : Text => return Array.from_list out
func join (separator: Text) -> (pieces: Array Text) : Text => return do:
  let out = builder ()
  let first = true
  for piece in pieces:
    if Bool.not first:
      out := append separator self
    out := append piece self
    first := false
  break finish out

func decimal_digits value -> collected => return
  if value < 10 then [value + 48, ...collected]
  else decimal_digits (value / 10) [value % 10 + 48, ...collected]
func from_u32 (value: U32) : Text => return
  Array.from_list (decimal_digits value [])
func append_u32 value -> out => return append (from_u32 value) out

// Fixed decimal places (0..6), rounded half away from zero. Return Nothing
// for NaN, infinities, excessive precision, or a scaled value outside U32.
func from_f32_fixed (places: U32) -> (value: F32) : Maybe Text => return do:
  if places > 6 or Bool.not (F32.is_finite value):
    return $Nothing
  let factor = 1
  for ignored in 0..places:
    factor := self * 10
  let scaled = F32.floor (F32.abs value * F32.from factor + 0.5)
  if scaled >= 4294967296.0:
    return $Nothing
  let rounded = F32.to_u32 scaled
  let out = builder ()
  if value < 0.0:
    out := append "-" self
  out := append (from_u32 (rounded / factor)) self
  if places > 0:
    out := push 46 self
    let divisor = factor / 10
    for ignored in 0..places:
      out := push (48 + (rounded / divisor) % 10) self
      if divisor > 1:
        divisor := self / 10
  break $Some (finish out)

// Libraries and applications can provide their own Format implementations.
type Format a is contract = { const format: a -> Text }
impl Decimal : Format U32 = { const format = func value => return from_u32 value }
impl Boolean : Format Bool = {
  const format = func value => return if value then "true" else "false",
}
func format (value: a): Text where { Format a } => return Format.format value
func format_sequence (values: Array a): Text where { Format a } => return do:
  let out = append "[" (builder ())
  let first = true
  for value in values:
    if Bool.not first:
      out := append ", " self
    out := append (format value) self
    first := false
  break finish (append "]" out)
impl Sequence a : Format (Array a) where { Format a } = {
  const format = func values => return format_sequence values,
}
