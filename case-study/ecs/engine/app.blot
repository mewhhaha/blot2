// Source proposal: descriptors, imports and state resolvers are not executable yet.
import * as ecs from "engine/ecs"
import { resource, Start, Event, Update, Render } from "engine/ecs"
import * as render from "engine/render"
import * as snapshot from "engine/snapshot"
import { Io, FileIo, WindowIo, RenderIo, Application, HostError, InvalidSnapshot, FrameInput, Viewport, InputEvent } from "./platform"

#[resource]
export data Frame = Frame FrameInput
#[resource]
export data PendingInput = PendingInput (Maybe InputEvent)
#[resource]
export data Title = Title Text
#[resource]
export data SnapshotRequest = Idle | Save | Load

// Descriptor values exist at const time; they are not boxed runtime systems.
data Builder = Builder { registrations: Array ecs.Descriptor }

export fn new title => Builder {
  registrations: [
    ecs.resource (Title title),
    ecs.resource Idle,
    ecs.resource (PendingInput Nothing),
    ecs.resource (Frame (FrameInput {
      seconds: 0.0, alpha: 0.0, viewport: Viewport { width: 1.0, height: 1.0 },
    })),
  ],
}

export fn insert_resource value => fn builder => do:
  let next = builder
  next.registrations := [...self, ecs.resource value]
  return next

// Register before erasing into Descriptor: an array of callbacks could unify
// their distinct effect rows and lose each system's individual query accesses.
// Registration order within a stage is explicit, not inferred from conflicts.
export fn add_system stage => fn (const system) => fn builder => do:
  let next = builder
  next.registrations := [...self, ecs.system (stage, system)]
  return next

export fn build (const builder: Builder) => ecs.build builder.registrations

fn create_world (const simulation) => fn () => do:
  let (world, ()) = do ecs.scope (simulation.create ()):
    use simulation.run Start
    return ()
  return ecs.checkpoint world

fn advance_world (const simulation) => fn world => fn frame => do:
  if Bool.not (F32.is_finite frame.seconds):
    use @panic "Delta time must be finite"
  if F32.lt frame.seconds 0.0:
    use @panic "Delta time must be between 0 and 0.25 seconds"
  if F32.gt frame.seconds 0.25:
    use @panic "Delta time must be between 0 and 0.25 seconds"
  let (next_world, ()) = do ecs.scope (ecs.checkpoint world):
    use ecs.set (Frame frame)
    use simulation.run Update
    return ()
  return next_world

fn apply_event (const simulation) => fn (files: FileIo) => fn world => fn event => do:
  let (next_world, request) = do ecs.scope world:
    use ecs.set (PendingInput (Some event))
    use simulation.run Event
    use request <- ecs.get SnapshotRequest
    use ecs.set Idle
    use ecs.set (PendingInput Nothing)
    return request
  return case request of
    Idle => Ok next_world
    Save => do:
      let bytes = snapshot.encode (simulation.schema, next_world)
      use written <- files.write bytes
      return Result.map (fn () => next_world) (Result.map_error HostError written)
    Load => do:
      use loaded <- files.read ()
      return case loaded of
        Err error => Err (HostError error)
        Ok bytes => Result.map ecs.checkpoint
          (Result.map_error InvalidSnapshot (snapshot.decode (simulation.schema, bytes)))

fn render_frame (const simulation) => fn (window: WindowIo) => fn (renderer: RenderIo) => fn world => fn frame => do:
  if Bool.not (F32.is_finite frame.alpha):
    use @panic "Interpolation alpha must be finite"
  if F32.lt frame.alpha 0.0:
    use @panic "Interpolation alpha must be between 0 and 1"
  if F32.gt frame.alpha 1.0:
    use @panic "Interpolation alpha must be between 0 and 1"
  let (_, (packet, title)) = do ecs.scope world:
    use ecs.set (Frame frame)
    use collected <- render.collect (fn () => do:
      use simulation.run Render
      use title_value <- ecs.get Title
      let Title title = title_value
      return title)
    return collected
  use titled <- window.set_title title
  let Ok () = titled else:
    return Result.map_error HostError titled
  use submitted <- renderer.submit packet
  return Result.map_error HostError submitted

// create is first-launch only. Reload rebinds capabilities around retained state.
export fn bind (const simulation) => fn (io: Io) => Application {
  create: create_world simulation,
  event: apply_event simulation io.files,
  update: advance_world simulation,
  render: render_frame simulation io.window io.render,
}
