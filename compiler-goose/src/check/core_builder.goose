fn Builder::callableType(self:Builder&,original:u32)->blot_check_types::Node,Error {var id=original;for count in 0..128 {let node=self.tables.type_nodes[id];if node.tag!=blot_check_types::Tag.usage && node.tag!=blot_check_types::Tag.forall {return node,Error.none;}id=node.a;}return blot_check_types::Node{..},Error.core_limit;}
fn Builder::namedCall(self:Builder&,source:u32,binding:u32,arguments:const u32[:],result:u32)->u32,Error {var callee_type=result;if self.scratch.signature_sources.len!=0 && self.scratch.signature_sources[source]!=0 {let ty,error=self.projectType(self.scratch.signature_sources[source],0);if error!=Error.none {return 0,error;}callee_type=ty;}else {var index=arguments.len;while index!=0 {index-=1;let ty,error=self.addType(blot_check_types::Node{tag:blot_check_types::Tag.function,a:self.tables.nodes[arguments[index]].ty,b:callee_type, ..});if error!=Error.none {return 0,error;}callee_type=ty;}}let kind=self.source.checked.bindings[binding].kind;let returned,error=self.callableType(result);if error!=Error.none {return 0,error;}if kind==blot_check_core::BindingKind.local || kind==blot_check_core::BindingKind.parameter || returned.tag==blot_check_types::Tag.function {let initial,error=self.referenceNode(source,binding,callee_type);if error!=Error.none {return 0,error;}var value=initial;for argument in arguments {let signature,error=self.callableType(self.tables.nodes[value].ty);if error!=Error.none {return 0,error;}if signature.tag!=blot_check_types::Tag.function {let error=self.diagnostic(blot_check_core::Code.invalid_call,source);return 0,error;}let next,error=self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.apply,ty:signature.b,a:value,b:argument, ..});if error!=Error.none {return 0,error;}value=next;}return value,Error.none;}return self.typedNamedCall(source,binding,arguments,result,callee_type);}
