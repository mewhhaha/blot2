// Copies disappear only when every original read forwards in the logical-local tree.
namespace blot_backend_wasm_copy_coalesce;
import std;
import dictionary;
import .runtime_ir;
import .wasm;
import .optimizer_buffers;
import support.error;
import support.option;
type Error=blot_error::Error;
type Instruction=blot_backend_runtime_ir::Instruction;
type Op=blot_backend_runtime_ir::Op;
type Module=blot_backend_wasm::Module;
type Function=blot_backend_runtime_ir::Function;
type Output=blot_backend_runtime_ir::DetachedBody;
let absent:i64=0x7fffffffffffffff;
struct Body {function:u32,instructions:const Instruction[:] = default<const Instruction[:]>()}
struct Result {bodies:Body[:] = default<Body[:]>(),aliases:u32[:] = default<u32[:]>(),removed_copies:i64=0,forwarded_reads:i64=0}
reusable[] var body_runs:Body[>..]=[];
reusable[] var alias_runs:u32[>..]=[];
reusable[] var code_runs:Instruction[>..]=[];
fn release(code:const Instruction[:]) {if code.len==0 {return;}let first:const Instruction& =code[0];let at=code_runs.index_of(first);assert(at>=0);code_runs.free_slice(code_runs[at..at+code.len]);}
fn deinit(self_:Result&) {for body in self_.bodies {release(body.instructions);}if self_.bodies.len!=0 {body_runs.free_slice(self_.bodies);}if self_.aliases.len!=0 {alias_runs.free_slice(self_.aliases);}self_=Result{..};}
struct Alias {source:u32,version:i64,segment:i64,scope:i64}
struct Use {writes:u8=0,reads:i64=0,forwarded:i64=0,pair:i64=absent,body:i64=0,copy_source:u32=0,version:i64=0,stable:bool=false,alias:blot_support::Option<Alias> =blot_support::none<Alias>(),accepted:bool=false}
struct Frame {body:i64,next:i64=0,controls:i64=0}
struct Control {scope:i64,kind:Op,otherwise:bool=false}
reusable[] var use_runs:Use[>..]=[];
fn neutral(inst:Instruction)->bool {return !inst.table_reference && inst.table_kind==blot_backend_runtime_ir::TABLE_unknown;}
fn local(op:Op)->bool {return op==blot_backend_runtime_ir::OP_local_get || op==blot_backend_runtime_ir::OP_local_set || op==blot_backend_runtime_ir::OP_local_tee;}
fn boundary(op:Op)->bool {return op==blot_backend_runtime_ir::OP_loop || op==blot_backend_runtime_ir::OP_br || op==blot_backend_runtime_ir::OP_br_if;}
fn numeric(module:const Module&,source:const Function&,id:u32)->bool {if id<source.parameters.len {return module.parameters(source)[id]==blot_backend_runtime_ir::VT_i32;}return module.locals(source)[id-source.parameters.len]==blot_backend_runtime_ir::VT_i32;}
fn canonical(uses:const Use[:],id:u32,segment:i64,scopes:const bool[:])->u32 {if uses[id].alias.present {let alias=uses[id].alias.value;let immutable=uses[alias.source].writes==0 || uses[alias.source].stable;if (alias.segment==segment || immutable) && scopes[alias.scope] && uses[alias.source].version==alias.version {return alias.source;}}return id;}
fn run(module:const Module&,source:const Function&,bodies:const Body[:])->blot_support::Option<Result>,Error {let locals=module.locals(source);if bodies.len==0 || locals.len==0 || locals.len>0x7fffffffffffffff-source.parameters.len {return blot_support::none<Result>(),blot_error::Error.none;}let total=source.parameters.len+locals.len;if total>0xffffffff || bodies.len>0xffffffff {return blot_support::none<Result>(),blot_error::Error.none;}var ids:dictionary<u32,i64> = dictionary<u32,i64> {};var offsets:i64[>..]=[];var counts:i64[>..]=[];var length:i64=0;for body,index in bodies {if ids.contains(body.function) {return blot_support::none<Result>(),blot_error::Error.none;}ids.insert(body.function,index);offsets.push(length);counts.push(0);if body.instructions.len>0x7fffffffffffffff-length {return blot_support::none<Result>(),blot_error::Error.none;}length+=body.instructions.len;if length>=0xffffffff {return blot_support::none<Result>(),blot_error::Error.none;}}let uses=use_runs.alloc_slice(total);for &use in uses {use=Use{..};}let accepted=admit(module,source,bodies,ids,offsets,counts,uses,total);if !accepted {use_runs.free_slice(uses);return blot_support::none<Result>(),blot_error::Error.none;}let forwarded=walk(bodies,ids,offsets,uses);if !forwarded {use_runs.free_slice(uses);return blot_support::none<Result>(),blot_error::Error.none;}let result,error=publish(bodies,offsets,counts,uses,total);use_runs.free_slice(uses);return result,error;}
fn admit(module:const Module&,source:const Function&,bodies:const Body[:],ids:const dictionary<u32,i64>&,offsets:const i64[:],counts:i64[:],uses:Use[:],total:i64)->bool {for body,index in bodies {for inst,at in body.instructions {if inst.op==blot_backend_runtime_ir::OP_ownership || inst.op==blot_backend_runtime_ir::OP_resource_retire || inst.op==blot_backend_runtime_ir::OP_wide_layouts {return false;}if inst.op==blot_backend_runtime_ir::OP_return_ && index!=0 {return false;}if inst.op==blot_backend_runtime_ir::OP_call {let callee .= ids.get(inst.operand);if callee {if !neutral(inst) || callee==0 || counts[callee]!=0 {return false;}counts[callee]=1;}}if !local(inst.op) {continue;}if inst.operand>=total || !neutral(inst) {return false;}let use .= uses[inst.operand];if inst.op==blot_backend_runtime_ir::OP_local_get {use.reads+=1;continue;}if use.writes!=255 {use.writes+=1;}if inst.op!=blot_backend_runtime_ir::OP_local_set || inst.operand<source.parameters.len || at==0 || !numeric(module,source,inst.operand) {continue;}let previous=body.instructions[at-1];if previous.op!=blot_backend_runtime_ir::OP_local_get || previous.operand>=total || !neutral(previous) || previous.operand==inst.operand || !numeric(module,source,previous.operand) {continue;}use.pair=offsets[index]+at;use.body=index;use.copy_source=previous.operand;}}for count in counts[1..] {if count!=1 {return false;}}for use in uses {if use.writes==1 && use.pair!=absent {return true;}}return false;}
fn walk(bodies:const Body[:],ids:const dictionary<u32,i64>&,offsets:const i64[:],uses:Use[:])->bool {var frames:Frame[>..]=[];var controls:Control[>..]=[];var scopes:bool[>..]=[];frames.push(Frame{body:0,..});scopes.push(true);var visited:i64=1;var segment:i64=0;var loops:i64=0;while frames.len!=0 {let frame_index=frames.len-1;let frame=frames[frame_index];let code=bodies[frame.body].instructions;if frame.next==code.len {if controls.len!=frame.controls {return false;}frames.pop();continue;}let at=frame.next;frames[frame_index].next+=1;let flat=offsets[frame.body]+at;let inst=code[at];if frame.body!=0 && (inst.op==blot_backend_runtime_ir::OP_br || inst.op==blot_backend_runtime_ir::OP_br_if) && inst.operand>=controls.len-frame.controls {return false;}if inst.op==blot_backend_runtime_ir::OP_call {let callee .= ids.get(inst.operand);if callee {frames.push(Frame{body:callee,controls:controls.len,..});visited+=1;continue;}}if inst.op==blot_backend_runtime_ir::OP_local_get {if canonical(uses,inst.operand,segment,scopes)!=inst.operand {uses[inst.operand].forwarded+=1;}}else if local(inst.op) {let use .= uses[inst.operand];use.version+=1;use.stable=use.writes==1 && loops==0;use.alias=blot_support::none<Alias>();if use.writes==1 && use.pair==flat {let src=canonical(uses,code[at-1].operand,segment,scopes);var scope:i64=0;if controls.len!=0 {scope=controls[controls.len-1].scope;}use.alias=blot_support::some(Alias{source:src,version:uses[src].version,segment:segment,scope:scope,..});}}match inst.op {blot_backend_runtime_ir::OP_block,blot_backend_runtime_ir::OP_if_,blot_backend_runtime_ir::OP_loop=>{let scope=scopes.len;scopes.push(true);controls.push(Control{scope:scope,kind:inst.op,..});if inst.op==blot_backend_runtime_ir::OP_loop {loops+=1;}},blot_backend_runtime_ir::OP_else_=>{if controls.len<=frame.controls {return false;}let control .= controls[controls.len-1];if control.kind!=blot_backend_runtime_ir::OP_if_ || control.otherwise {return false;}scopes[control.scope]=false;control.scope=scopes.len;control.otherwise=true;scopes.push(true);},blot_backend_runtime_ir::OP_end=>{if controls.len<=frame.controls {return false;}let closed=controls.pop();scopes[closed.scope]=false;if closed.kind==blot_backend_runtime_ir::OP_loop {loops-=1;}},_=>{},}if boundary(inst.op) {segment+=1;}}return visited==bodies.len;}
fn publish(bodies:const Body[:],offsets:const i64[:],counts:i64[:],uses:Use[:],total:i64)->blot_support::Option<Result>,Error {var removed:i64=0;for body,index in bodies {counts[index]=body.instructions.len;}for &use in uses {use.accepted=use.writes==1 && use.pair!=absent && use.reads==use.forwarded;if !use.accepted {continue;}removed+=1;counts[use.body]-=2;}if removed==0 {return blot_support::none<Result>(),blot_error::Error.none;}var result=Result{bodies:body_runs.alloc_slice(bodies.len),aliases:alias_runs.alloc_slice(total),removed_copies:removed,..};for &output,index in result.bodies {output=Body{function:bodies[index].function,..};}for use,index in uses {result.aliases[index]=index as u32;if use.accepted {result.aliases[index]=use.copy_source;}}for id in 0..total {var target=result.aliases[id];while result.aliases[target]!=target {target=result.aliases[target];}var current=id as u32;while result.aliases[current]!=target {let next=result.aliases[current];result.aliases[current]=target;current=next;}}for body,index in bodies {let count=counts[index];let offset=offsets[index];let instructions=code_runs.alloc_slice(count);result.bodies[index].instructions=instructions;var at:i64=0;var written:i64=0;while at<body.instructions.len {var inst=body.instructions[at];if inst.op==blot_backend_runtime_ir::OP_local_get && at+1<body.instructions.len {let next=body.instructions[at+1];if next.op==blot_backend_runtime_ir::OP_local_set && uses[next.operand].accepted && uses[next.operand].pair==offset+at+1 {at+=2;continue;}}if inst.op==blot_backend_runtime_ir::OP_local_get && uses[inst.operand].accepted {inst.operand=result.aliases[inst.operand];result.forwarded_reads+=1;}instructions[written]=inst;written+=1;at+=1;}assert(written==count);}return blot_support::some(result),blot_error::Error.none;}
fn runSingle(module:const Module&,source:const Function&)->blot_support::Option<Output>,Error {let selected,error=run(module,source,[Body{function:0xffffffff,instructions:blot_backend_wasm::instructions(module,source),..}]);if error!=blot_error::Error.none || !selected.present {return blot_support::none<Output>(),error;}var result=selected.value;var locals=blot_backend_optimizer_buffers::Types{..};var code=blot_backend_optimizer_buffers::Code{..};let error=singleBody(module,source,result,locals,code);result.deinit();return blot_backend_optimizer_buffers::finishOptional(locals,code,true,error);}
fn singleBody(module:const Module&,source:const Function&,result:Result&,locals:blot_backend_optimizer_buffers::Types&,code:blot_backend_optimizer_buffers::Code&)->Error {let error=code.append(result.bodies[0].instructions);if error!=blot_error::Error.none {return error;}for ty,index in module.locals(source) {let id=source.parameters.len+index;if result.aliases[id]!=id {continue;}result.aliases[id]=(source.parameters.len+locals.len) as u32;let error=locals.push(ty);if error!=blot_error::Error.none {return error;}}for &inst in code.items {if local(inst.op) {inst.operand=result.aliases[inst.operand];}}return blot_error::Error.none;}
