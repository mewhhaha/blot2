fn annotationEffectArguments(self:Engine&,family:EffectFamily,member:blot_support::Option<u32>,syntax:const u32[:],shapes:const u32[:],old:const u32[:],fresh:u32[:],arguments:u32[:],labels:IdBuffer&)->blot_error::Error {for &variable in fresh {let root,err=self.types.fresh();if err!=blot_error::Error.none {return err;}variable=root;}for origin,index in syntax {let argument,err=self.parameterArgument(self.parameter_patterns.list(family.patterns)[index],origin,true,0);if err!=blot_error::Error.none {return err;}let selected,err=self.types.substitute(shapes[index],old,fresh);if err!=blot_error::Error.none {return err;}let err=self.constrain(argument,selected,origin);if err!=blot_error::Error.none {return err;}let resolved,err=self.types.resolve(selected,0);if err!=blot_error::Error.none {return err;}arguments[index]=resolved;}var count=family.operations.len;if member.present {count=1;}let operations=equation_type_ids.alloc_slice(count);if member.present {operations[0]=member.value;}else {for value,index in self.types.list(family.operations) {operations[index]=value;}}let error=annotationOperationLabels(self,operations,arguments,labels);equation_type_ids.free_slice(operations);return error;}
fn annotationOperationLabels(self:Engine&,operations:const u32[:],arguments:const u32[:],labels:IdBuffer&)->blot_error::Error {for operation in operations {let label,err=self.types.internSymbolicOperation(self.effect_templates[operation].identity,arguments);if err!=blot_error::Error.none {return err;}let err=labels.append(label);if err!=blot_error::Error.none {return err;}}return blot_error::Error.none;}
fn Engine::constructorPayloadAnnotation(self:Engine&,id:u32)->u32,blot_error::Error {let node=self.tree.node(id);if node.tag!=blot_parse_ast::tag_type_record {return self.annotation(id);}let fields=self.tree.children(id);if self.tree.type_conversion_origin(id)!=self.tree.span(id).start {for field,index in fields {for earlier in fields[..index] {if self.tree.node(field).a==self.tree.node(earlier).a {let err=self.diagnostic(Code.duplicate_type_field,id);if err!=blot_error::Error.none {return 0,err;}let issue .= self.diagnostics[self.diagnostics.len-1];issue.span.end=issue.span.start;issue.symbol=self.tree.node(field).a;return self.types.fresh();}}}let err=self.diagnostic(Code.type_argument,id);if err!=blot_error::Error.none {return 0,err;}let point=self.tree.type_conversion_origin(id);self.diagnostics[self.diagnostics.len-1].span=blot_parse_ast::Span{point,point};return self.types.fresh();}return self.recordAnnotation(id);}
fn Engine::recordAnnotation(self:Engine&,id:u32)->u32,blot_error::Error {var fields=FieldBuffer{};let result,err=recordAnnotationFields(self,id,fields);fields.deinit(equation_fields);return result,err;}
fn recordAnnotationFields(self:Engine&,id:u32,fields:FieldBuffer&)->u32,blot_error::Error {for child in self.tree.children(id) {let field=self.tree.node(child);for prior in fields.items {if prior.name==field.a {let err=self.diagnostic(Code.duplicate_field,child);if err!=blot_error::Error.none {return 0,err;}}}var ty:u32=0;if field.b==0 {let root,err=self.typeVariable(field.a,child);if err!=blot_error::Error.none {return 0,err;}ty=root;}else {let root,err=self.annotation(field.b);if err!=blot_error::Error.none {return 0,err;}ty=root;}let err=fields.append(blot_check_types::Field{name:field.a,ty:ty});if err!=blot_error::Error.none {return 0,err;}}return self.types.record(fields.items);}
fn Engine::dependentParameter(self:Engine&,id:u32)->u32,blot_error::Error {let binder=self.tree.node(id);let descriptor,err=self.capabilityDescriptorAnnotation(binder.b);if err!=blot_error::Error.none {return 0,err;}var parameter:u32=0;if !descriptor.present {if !self.proof_header_active {return self.diagnosticFresh(Code.effect_identity_scope,id);}let root,err=self.annotation(binder.b);if err!=blot_error::Error.none {return 0,err;}parameter=root;}else {let root,err=self.types.capabilityParameter(descriptor.value);if err!=blot_error::Error.none {return 0,err;}parameter=root;}let binding,err=self.addBinding(Binding{name:binder.a,declaration:id,owner:id,kind:Kind.parameter,ty:parameter});if err!=blot_error::Error.none {return 0,err;}self.env.append(Entry{name:binder.a,binding:binding});self.expr_types[id]=parameter;return parameter,blot_error::Error.none;}
fn Engine::validateRankScope(self:Engine&,scope:u32,old_variables:i64,old_versions:i64,old_rows:i64,old_row_versions:i64,source:u32)->blot_error::Error {let writes=self.types.versions.len-old_versions;if writes>4096 || self.types.effects.versions.len-old_row_versions>4096-writes {return blot_error::Error.type_limit;}for index in old_versions..self.types.versions.len {let write=self.types.versions[index];if write.variable<old_variables {let rigid,err=self.types.containsRigid(write.replacement,scope);if err!=blot_error::Error.none {return err;}if rigid {return self.diagnostic(Code.skolem_escape,source);}}}for index in old_row_versions..self.types.effects.versions.len {let write=self.types.effects.versions[index];if write.variable<old_rows {let rigid,err=self.types.containsRigidRow(write.replacement,scope);if err!=blot_error::Error.none {return err;}if rigid {return self.diagnostic(Code.skolem_escape,source);}}}return blot_error::Error.none;}
