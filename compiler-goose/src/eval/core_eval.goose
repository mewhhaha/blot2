type ValueMap=blot_support_pooled_map::Map<u32,ValueId>;
struct ValuesHeader { table: ValueMap=ValueMap {},failure: Error=blot_error::Error.none,generation: u64=0,live: bool=false }
reusable var values_headers: ValuesHeader[>..]=[];
reusable[] var values_slots: dictionary_slot<u32,ValueId>[>..]=[];
var inactive_values: ValuesHeader=ValuesHeader {};
var next_values_generation: u64=1;
struct PooledValues { table: ValueMap& =inactive_values.table,slots: (dictionary_slot<u32,ValueId>[:])& =inactive_values.table.slots,count: i64& =inactive_values.table.count,failure: Error& =inactive_values.failure,lease: u32=0,generation: u64=0 }
fn activate(self_: PooledValues&) -> Error { if self_.lease!=0 { assert(self_.lease-1<values_headers.len&&values_headers[self_.lease-1].live&&values_headers[self_.lease-1].generation==self_.generation); return blot_error::Error.none; } if next_values_generation==0xffffffffffffffff||values_headers.len>=0xffffffff { return blot_error::Error.out_of_memory; } let generation=next_values_generation; next_values_generation++; let at=values_headers.alloc_index(ValuesHeader {generation:generation,live:true}); self_.table .= values_headers[at].table; self_.slots .= values_headers[at].table.slots; self_.count .= values_headers[at].table.count; self_.failure .= values_headers[at].failure; self_.lease=(at+1) as u32; self_.generation=generation; return blot_error::Error.none; }
fn get(self_: PooledValues,key: u32) -> ValueId? { if self_.lease==0 { return null; } return blot_support_pooled_map::get(self_.table,key); }
fn insert(self_: PooledValues&,key: u32,value: ValueId) { let error=activate(self_); if error!=blot_error::Error.none { self_.failure=error; return; } blot_support_pooled_map::insert(self_.table,key,value,values_slots); }
fn remove(self_: PooledValues,key: u32) -> bool { if self_.lease==0 { return false; } return blot_support_pooled_map::remove(self_.table,key); }
fn clear(self_: PooledValues) { if self_.lease!=0 { blot_support_pooled_map::clear(self_.table); } }
fn deinit(self_: PooledValues&) { if self_.lease==0 { return; } let error=activate(self_); assert(error==blot_error::Error.none); blot_support_pooled_map::deinit(self_.table,values_slots); let at=self_.lease-1; values_headers[at].live=false; values_headers.free(at); self_=PooledValues {}; }
