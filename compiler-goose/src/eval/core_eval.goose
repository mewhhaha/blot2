fn freeze(self: ClosureRegion&,scope: u32) -> ValueId,Error { let existing=self.scratch.frozen.get(scope); if existing { return existing,Error.none; } let source=self.scratch.sources[scope]; let actual,error=project(self,source.root); if error!=Error.none { return 0,error; } if actual==0 { return 0,Error.unresolved_type; } var replacements: FrozenCapture[>..<]=[]; for edge in self.scratch.edges { if edge.parent!=scope { continue; } let value,e=freeze(self,edge.child); if e!=Error.none { return 0,e; } replacements.push(FrozenCapture {edge.slot,value}); } self.session.counters.frozen_edge_scratch_bytes+=replacements.len*8; let kind=valueInfo(self.session,source.value).kind; if kind!=ValueKind.closure { if kind==ValueKind.scalar { return typedView(self.session,source.owner,source.body,source.value,actual); } let copied,e=copyFrozenAggregate(self.session,source.owner,source.body,source.value,replacements,blot_support::none<ClosureValue>()); if e!=Error.none { return 0,e; } self.session.storage.value_records[copied]=self.session.storage.value_records[source.value]; let typed,e2=typedView(self.session,source.owner,source.body,copied,actual); if e2!=Error.none { return 0,e2; } self.scratch.frozen.insert(scope,typed); return typed,Error.none; } var metadata=closureInfo(self.session,source.value); let solved,e=exportSolved(self,scope); if e!=Error.none { return 0,e; } let mappings,e2=captureMappings(self.session,source.owner,source.body,solved.types); if e2!=Error.none { solved.deinit(); return 0,e2; } metadata.mappings=mappings; let rows,e3=captureRowMappings(self.session,source.owner,source.body,solved.rows); if e3!=Error.none { solved.deinit(); return 0,e3; } metadata.row_mappings=rows; let header,e4=copyFrozenAggregate(self.session,source.owner,source.body,source.value,replacements,blot_support::some(metadata)); solved.deinit(); if e4!=Error.none { return 0,e4; } let result,e5=typedView(self.session,source.owner,source.body,header,actual); if e5!=Error.none { return 0,e5