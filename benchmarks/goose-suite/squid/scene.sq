// Scene graph: arena of nodes with unboxed 12-field 3x3 F32 rotation + vec3
// translation and direct recursive build & transform propagation.
import * as rng from "./rng"

const BENCH_N: U32 = 13 // BENCH_N
const FRAMES: U32 = 16

type Xf is data = $Xf { m0: F32, m1: F32, m2: F32, m3: F32, m4: F32, m5: F32, m6: F32, m7: F32, m8: F32, tx: F32, ty: F32, tz: F32 }
type SNode is data = $SNode { id: U32, local: Xf, world: Xf, klen: U32, k0: U32, k1: U32, k2: U32, k3: U32 }

func ident_xf (): Xf => $Xf { m0: 1.0, m1: 0.0, m2: 0.0, m3: 0.0, m4: 1.0, m5: 0.0, m6: 0.0, m7: 0.0, m8: 1.0, tx: 0.0, ty: 0.0, tz: 0.0 }

func make_rotation (seed: U64) -> (tx: F32) -> (ty: F32) -> (tz: F32): Xf =>
  let axis = (seed % 3u64).to_u32
  let quarter = ((seed >> 8u64) & 3u64).to_u32
  let c: F32 = if quarter == 0 then 1.0 else if quarter == 2 then -1.0 else 0.0
  let s: F32 = if quarter == 1 then 1.0 else if quarter == 3 then -1.0 else 0.0
  if axis == 0:
    return $Xf { m0: 1.0, m1: 0.0, m2: 0.0, m3: 0.0, m4: c, m5: 0.0 - s, m6: 0.0, m7: s, m8: c, tx, ty, tz }
  if axis == 1:
    return $Xf { m0: c, m1: 0.0, m2: s, m3: 0.0, m4: 1.0, m5: 0.0, m6: 0.0 - s, m7: 0.0, m8: c, tx, ty, tz }
  return $Xf { m0: c, m1: 0.0 - s, m2: 0.0, m3: s, m4: c, m5: 0.0, m6: 0.0, m7: 0.0, m8: 1.0, tx, ty, tz }

func build_rec (pool: own #[SNode]) -> (d: U32) -> (seed: U64) -> (ident: Xf): #[SNode] =>
  let r = rng.xs_next seed
  let idx = pool.length
  let tx = U32.to_f32 (((r >> 16u64) % 9u64).to_u32)
  let ty = U32.to_f32 (((r >> 24u64) % 9u64).to_u32)
  let tz = U32.to_f32 (((r >> 32u64) % 9u64).to_u32)
  let loc = make_rotation r tx ty tz
  pool := self.push ($SNode { id: idx, local: loc, world: ident, klen: 0, k0: 0, k1: 0, k2: 0, k3: 0 })
  if d == 0:
    return pool
  let cn = 1 + ((r >> 40u64) & 3u64).to_u32
  let k0: U32 = 0
  let k1: U32 = 0
  let k2: U32 = 0
  let k3: U32 = 0
  for ci in 0 .. cn:
    let cidx = pool.length
    case ci of
      0 =>
        k0 := cidx
      1 =>
        k1 := cidx
      2 =>
        k2 := cidx
      _ =>
        k3 := cidx
    pool := build_rec self (d - 1) (rng.xs_next (r + ci.to_u64)) ident
  pool[idx].klen := cn
  pool[idx].k0 := k0
  pool[idx].k1 := k1
  pool[idx].k2 := k2
  pool[idx].k3 := k3
  return pool

func compose (p: Xf) -> (l: Xf): Xf => $Xf {
  m0: p.m0 * l.m0 + p.m1 * l.m3 + p.m2 * l.m6,
  m1: p.m0 * l.m1 + p.m1 * l.m4 + p.m2 * l.m7,
  m2: p.m0 * l.m2 + p.m1 * l.m5 + p.m2 * l.m8,
  m3: p.m3 * l.m0 + p.m4 * l.m3 + p.m5 * l.m6,
  m4: p.m3 * l.m1 + p.m4 * l.m4 + p.m5 * l.m7,
  m5: p.m3 * l.m2 + p.m4 * l.m5 + p.m5 * l.m8,
  m6: p.m6 * l.m0 + p.m7 * l.m3 + p.m8 * l.m6,
  m7: p.m6 * l.m1 + p.m7 * l.m4 + p.m8 * l.m7,
  m8: p.m6 * l.m2 + p.m7 * l.m5 + p.m8 * l.m8,
  tx: p.m0 * l.tx + p.m1 * l.ty + p.m2 * l.tz + p.tx,
  ty: p.m3 * l.tx + p.m4 * l.ty + p.m5 * l.tz + p.ty,
  tz: p.m6 * l.tx + p.m7 * l.ty + p.m8 * l.tz + p.tz,
}

func update_rec (pool: own #[SNode]) -> (idx: U32) -> (parent: Xf): #[SNode] =>
  let w = compose parent pool[idx].local
  pool[idx].world := w
  let kl = pool[idx].klen
  if kl > 0:
    pool := update_rec self pool[idx].k0 w
  if kl > 1:
    pool := update_rec self pool[idx].k1 w
  if kl > 2:
    pool := update_rec self pool[idx].k2 w
  if kl > 3:
    pool := update_rec self pool[idx].k3 w
  return pool

io bench (): #[U32] =>
  let ident = ident_xf ()
  let pool = build_rec (Array.with_capacity 65536) BENCH_N 12345u64 ident
  let total: I64 = 0i64
  for f in 0 .. FRAMES:
    let step = U32.to_f32 (f % 5)
    let fmod = f % 7
    for i in 0 .. pool.length:
      if (pool[i].id % 7) == fmod:
        pool[i].local.tx := step
        pool[i].local.tz := 8.0 - step
    pool := update_rec self 0 ident
    for i in 0 .. pool.length:
      let w = pool[i].world
      total := self + (w.tx + w.ty + w.tz).to_i64

  let out: #[U32] = #[]
  out := rng.emit_u32 self pool.length
  out := rng.emit_i64 self total
  return out
