Speed: HolderMayPointInto's direct-store scan and EachHolderRoot's walk read a
holder's own store events through the holder index (patch 08) instead of
scanning the whole program-wide log from `from` for every variable at every
shrink. Same events, same order; debug builds assert a visit appends nothing.

diff --git a/src/typecheck.h b/src/typecheck.h
index 56eb254..174a06a 100644
--- a/src/typecheck.h
+++ b/src/typecheck.h
@@ -2761,7 +2761,15 @@ struct TypeCheck {
 #endif
             for (auto at = begin; at != ids->end(); ++at) {
                 if (holderstoreindex.profile) ++holderstoreindex.visits;
-                if (visit(*at)) return true;
+#ifndef NDEBUG
+                auto events = storeevents.size();
+                auto postings = ids->size();
+#endif
+                auto stop = visit(*at);
+                // A visit reads the log; it neither appends nor re-indexes
+                // (the scan it replaces would see a new event).
+                assert(storeevents.size() == events && ids->size() == postings);
+                if (stop) return true;
             }
             return false;
         }
