type Tick is effect = { read: Unit -> F32 }
const keep = func ~value => return func () => return @demand value
const handled = func computation => return do:
  for request in @requests computation:
    case request of
      effect Tick.read () =>
        yield 42.5
      complete value =>
        break value
const create = func action => return do:
  let delayed = keep (action ())
  break @computation (func () => return delayed ())
entry const answer = func () => return do:
  let computation = create (func () => return Tick.read ())
  break handled computation
entry const folded = answer ()
