fn resolverNode(self_:Builder&,source:u32,original:blot_check_core::ResolverInfo,arguments:const u32[:],result:u32)->u32,Error {var info=original;let stored,error=self_.save(arguments);if error!=blot_error::Error.none {return 0,error;}info.arguments=stored;if self_.tables.resolver_ops.len==0xffffffff {return 0,blot_error::Error.core_limit;}let index=self_.tables.resolver_ops.len as u32;self_.tables.resolver_ops.push(info);return self_.make(source,blot_check_core::Node{tag:blot_check_core::Tag.resolver_op,ty:result,a:index, ..});}
