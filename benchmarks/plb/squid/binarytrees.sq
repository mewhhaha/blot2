// PLB binarytrees: direct recursion over a fresh pre-sized stack-backed arena
// per tree (reclaimed in one store on function exit).
import * as buf from "./buf"

const MIN_DEPTH: U32 = 4
const NONE: U32 = 0xFFFFFFFF

type Node is data = $Node { l: U32, r: U32 }

func build_tree (pool: own #[Node]) -> (d: U32): (#[Node], U32) =>
  if d == 0:
    let idx = pool.length
    pool := self.push ($Node { l: NONE, r: NONE })
    return (pool, idx)
  let (p1, l) = build_tree pool (d - 1)
  let (p2, r) = build_tree p1 (d - 1)
  let idx = p2.length
  let p3 = p2.push ($Node { l, r })
  return (p3, idx)

func check_tree (pool: #[Node]) -> (idx: U32): U32 =>
  let nd = pool[idx]
  if nd.l == NONE:
    return 1
  return 1 + check_tree pool nd.l + check_tree pool nd.r

func tree_check (depth: U32): U32 =>
  let pool: #[Node] = Array.with_capacity ((1 << (depth + 1)) - 1)
  let (p, root) = build_tree pool depth
  return check_tree p root

io bench (inp: #[U32]): #[U32] =>
  let n = inp[0]
  let max_depth = if n < MIN_DEPTH + 2 then MIN_DEPTH + 2 else n
  let (w, l, c) = buf.new_buf ()

  let stretch = tree_check (max_depth + 1)
  let (w1, l1, c1) = buf.push_text w l c "stretch tree of depth "
  let (w2, l2, c2) = buf.push_u32 w1 l1 c1 (max_depth + 1)
  let (w3, l3, c3) = buf.push_text w2 l2 c2 "\t check: "
  let (w4, l4, c4) = buf.push_u32 w3 l3 c3 stretch
  let (w5, l5, c5) = buf.push_b w4 l4 c4 10
  w := w5
  l := l5
  c := c5

  let long_cap = (1 << (max_depth + 1)) - 1
  let (long_pool, lroot) = build_tree (Array.with_capacity long_cap) max_depth

  let d: U32 = MIN_DEPTH
  for ever:
    if d > max_depth:
      break
    let iters: U32 = 1 << (max_depth - d + MIN_DEPTH)
    let chk: U32 = 0
    for _ in 0 .. iters:
      chk := self + tree_check d
    let (wa, la, ca) = buf.push_u32 w l c iters
    let (wb, lb, cb) = buf.push_text wa la ca "\t trees of depth "
    let (wc, lc, cc) = buf.push_u32 wb lb cb d
    let (wd, ld, cd) = buf.push_text wc lc cc "\t check: "
    let (we, le, ce) = buf.push_u32 wd ld cd chk
    let (wf, lf, cf) = buf.push_b we le ce 10
    w := wf
    l := lf
    c := cf
    d := self + 2

  let lchk = check_tree long_pool lroot
  let (wa, la, ca) = buf.push_text w l c "long lived tree of depth "
  let (wb, lb, cb) = buf.push_u32 wa la ca max_depth
  let (wc, lc, cc) = buf.push_text wb lb cb "\t check: "
  let (wd, ld, cd) = buf.push_u32 wc lc cc lchk
  let (we, le, ce) = buf.push_b wd ld cd 10
  return buf.finish_buf we le ce
