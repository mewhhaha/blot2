fn schemeInputs(self: ClosureRegion&,target: Target,root: u32,header: HeaderParts) -> u32,Error { let binding=self.session.units[target.unit].binding(target.binding); let resolved,error=self.solver.resolve(root,0); if error!=Error.none { return 0,error; } let product=self.solver.node(resolved); if product.tag!=TypeTag.product||product.b!=header.mask.len { return 0,Error.unresolved_type; } var instance: u32[>..<]=[]; instance.append(self.solver.list(blot_check_types::List {product.a,product.b})); var parts: u32[>..<]=[];
 for operand,slot in instance { if !header.mask[slot] { continue; } let actual,e=self.solver.resolve(operand,0); if e!=Error.none { return 0,e; } if slot<binding.public_variables.len { let closed,e2=project(self,actual); if e2!=Error.none { return 0,e2; } if header.has_private&&closed==0 { return 0,Error.none; } if closed==0 { parts.append([0,actual]); } else { parts.append([2,closed]); } } else { let carrier=self.solver.node(actual); if carrier.tag!=TypeTag.function||carrier.a!=blot_check_types::unit||carrier.b!=blot_check_types::unit { return 0,Error.unresolved_type; } let row,e2=self.solver.resolveEffects(carrier.c,0); if e2!=Error.none { return 0,e2; } let view=self.solver.row(row); if header.has_private&&view.tail!=blot_check_effects::Tail.closed { return 0,Error.none; } var closed: u32=0; if view.tail==blot_check_effects::Tail.closed { let evidence,e3=self.session.storage.evidence.projectEffects(self.solver,row,[],[]); if e3!=Error.none&&e3!=Error.unresolved_type { return 0,e3; } if e3==Error.none { closed=evidence; } } if header.has_private&&closed==0&&row!=0 { return 0,Error.none; } if view.tail==blot_check_effects::Tail.closed&&(closed!=0||row==0) { parts.append([3,closed]); continue; } var tail_code: u32=0; var tail_value: u32=0; match view.tail { closed=>{},variable v=>{ tail_code=1; tail_value=v.value; },parameter p=>{ tail_code=2; tail_value=p.value; },formal f=>{ tail_code=3; tail_value=f.value; }, } parts.append([1,view.cursor,tail_code,tail_value,view.labels.len as u32]); parts.append(self.solver.rowLabels(row)); } if parts.len>self.session.options.max_children { return 0,Error.none; }
 } var key: u8[>..<]=[]; for word in parts { for shift in 0..4 { key.push((word>>((shift*8) as u32)) as! u8); } } let inputs: SchemeInputs&=self.scratch.scheme_inputs; let known=inputs.keys.get(key); if known { return known,Error.none; } var room=self.session.options.max_children-inputs.parts; if room<0 { room=0; } if inputs.keys.count>=self.session.options.max_values||inputs.keys.count==0xffffffff||parts.len>room { return 0,Error.none; } let owned=scheme_input_bytes.alloc_slice(key.len); for byte,index in key { owned[index]=byte; } let id=(inputs.keys.count+1) as u32; inputs.keys.insert(owned,id); inputs.parts+=parts.len; return id,Error.none;
}
reusable[] var scheme_copy_slots: dictionary_slot<u32,u32>[>..]=[];
struct SchemeCopyState { types: const dictionary_slot<u32,u32>[:]=[],variables: const dictionary_slot<u32,u32>[:]=[],rows: const dictionary_slot<u32,u32>[:]=[],row_variables: const dictionary_slot<u32,u32>[:]=[],labels: const dictionary_slot<u32,u32>[:]=[],types_count: i64=0,variables_count: i64=0,rows_count: i64=0,row_variables_count: i64=0,labels_count: i64=0 }
struct SchemeFrame { use: Constraint,key: SchemeInstance,copy: SchemeCopyState=SchemeCopyState {},next: u32=0 }
enum SchemeImport { solved,open,frame { value: SchemeFrame } }
fn deinit(self: SchemeCopyState&) { scheme_copy_slots.free_slice(self.types); scheme_copy_slots.free_slice(self.variables); scheme_copy_slots.free_slice(self.rows); scheme_copy_slots.free_slice(self.row_variables); scheme_copy_slots.free_slice(self.labels); self=SchemeCopyState {}; }
fn saveSchemeMap(previous: const dictionary_slot<u32,u32>[:],map: const dictionary<u32,u32>&) -> const dictionary_slot<u32,u32>[:] { let slots=scheme_copy_slots.alloc_slice(map.slots.len); for value,index in map.slots { slots[index]=value; } scheme_copy_slots.free_slice(previous); return slots; }
struct SchemeCopyInvocation<C> { region: ClosureRegion&,frame: SchemeFrame&,context: C& }
fn withSchemeCopy<C,F>(self: ClosureRegion&,frame: SchemeFrame&,context: C&) -> Error { let source=self.session.units[frame.use.target.unit].types; let graph=blot_check_frozen_types::Graph {source.nodes,source.extra,source.effects.rows,source.effects.labels,source.operations,source.effects.variable_count,source.quantifier_goals,source.quantifier_obligations}; var remaining: i64=0x7fffffffffffffff; var observed=self.solver.projection_steps; var invocation=SchemeCopyInvocation<C> {self,frame,context}; return blot_reuse_principal_type_graph::withFrozenCopy<SchemeCopyInvocation<C>,schemeCopyInvoke<C,F>>(blot_check_frozen_types::Source.frozen {graph},self.solver,self.session.options.max_type_depth,self.session.options.max_values,remaining,observed,invocation); }
fn schemeCopyInvoke<C,F>(context: SchemeCopyInvocation<C>&,copy: blot_reuse_principal_type_graph::Copier&) -> Error { let state: SchemeCopyState&=context.frame.copy; copy.types.slots.append(state.types); copy.types.count=state.types_count; copy.variables.slots.append(state.variables); copy.variables.count=state.variables_count; copy.rows.slots.append(state.rows); copy.rows.count=state.rows_count; copy.row_variables.slots.append(state.row_variables); copy.row_variables.count=state.row_variables_count; copy.labels.slots.append(state.labels); copy.labels.count=state.labels_count; let error=F(context.context,copy); state.types=saveSchemeMap(state.types,copy.types); state.variables=saveSchemeMap(state.variables,copy.variables); state.rows=saveSchemeMap(state.rows,copy.rows); state.row_variables=saveSchemeMap(state.row_variables,copy.row_variables); state.labels=saveSchemeMap(state.labels,copy.labels); state.types_count=copy.types.count; state.variables_count=copy.variables.count; state.rows_count=copy.rows.count; state.row_variables_count=copy.row_variables.count; state.labels_count=copy.labels.count; return error; }
struct SchemeSeed { region: ClosureRegion&,use: Constraint,instance: const u32[:],public: u32,constant: bool,open: bool=false }
fn schemeSeed(context: SchemeSeed&,copy: blot_reuse_principal_type_graph::Copier&) -> Error { let self: ClosureRegion&=context.region; let module=self.session.units[context.use.target.unit]; let binding=module.binding(context.use.target.binding); for variable,index in module.types.list(binding.public_variables) { let actual=context.instance[index]; copy.types.insert(variable,actual); copy.variables.insert(module.types.node(variable).a,actual); } for variable,index in module.types.list(binding.public_rows) { copy.row_variables.insert(variable,self.solver.node(context.instance[binding.public_variables.len+index]).c); }
 if self.partial_principal&&context.public==0&&!context.constant { var unknown=true; for ty in context.instance[..binding.public_variables.len] { if !unknown { break; } let resolved,error=self.solver.resolve(ty,0); if error!=Error.none { return error; } unknown=self.solver.node(resolved).tag==TypeTag.variable; } for ty in context.instance[binding.public_variables.len..] { let resolved,error=self.solver.resolve(ty,0); if error!=Error.none { return error; } let carrier=self.solver.node(resolved); let row_id,e=self.solver.resolveEffects(carrier.c,0); if e!=Error.none { return e; } let row=self.solver.row(row_id); unknown=unknown&&row.labels.len==0&&row.tail!=blot_check_effects::Tail.parameter; } if unknown { let root,error=copy.ty(binding.scheme.root,0); if error!=Error.none { return error; } let retained,e=retainOpenPrincipal(self,Constraint {target:context.use.target,scope:context.use.scope,node:context.use.node,left:root,result:0,deferred_member:context.use.deferred_member}); if e!=Error.none { return e; } if retained { self.principal_only_used=true; self.session.principal_graph_deferred++; self.session.counters.principal_graph_deferred++; context.open=true; } } } return Error.none; }
fn schemeImport(self: ClosureRegion&,use: Constraint) -> SchemeImport,Error { let public,error=project(self,use.left); if error!=Error.none { return SchemeImport.solved,error; } let cacheable=self.solver.closed_generation!=0xffff&&self.solver.effects.physical_epoch!=0xffffffffffffffff; var constant=false; if public==0 { let value,e=constantRequirements(self,use.target); if e!=Error.none { return SchemeImport.solved,e; } constant=value; } var open: u32=0; if cacheable&&public==0&&!constant { let mask,e=publicRequirements(self,use.target); if e!=Error.none { return SchemeImport.solved,e; } if mask.present { let value,e2=schemeInputs(self,use.target,use.left,mask.value); if e2!=Error.none { return SchemeImport.solved,e2; } open=value; } } var keyed_public: u32=0; if cacheable { keyed_public=public; } let key=SchemeInstance {target:use.target,public:keyed_public,deferred_member:use.deferred_member,open:open,constant:cacheable&&constant,physical:self.solver.effects.physical_epoch,generation:self.solver.closed_generation}; if (key.public!=0||key.open!=0||key.constant)&&self.scratch.scheme_instances.contains(key) { return SchemeImport.solved,Error.none; } let module=self.session.units[use.target.unit]; let binding=module.binding(use.target.binding); let resolved,e=self.solver.resolve(use.left,0); if e!=Error.none { return SchemeImport.solved,e; } let product=self.solver.node(resolved); if product.tag!=TypeTag.product||product.b!=binding.public_variables.len+binding.public_rows.len { return SchemeImport.solved,Error.unresolved_type; } var instance: u32[>..<]=[]; instance.append(self.solver.list(blot_check_types::List {product.a,product.b})); var frame=SchemeFrame {use:use,key:key}; var context=SchemeSeed {self,use,instance,public,constant}; let seeded=withSchemeCopy<SchemeSeed,schemeSeed>(self,frame,context); if seeded!=Error.none||context.open { frame.copy.deinit(); if context.open&&seeded==Error.none { return SchemeImport.open,Error.none; } return SchemeImport.solved,seed