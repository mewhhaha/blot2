fn principalInstantiated(self:Walker&,owner:const Module&,binding:u32,declaration:blot_check_core::Binding,endpoint:blot_check_types::Scheme,proof:Principal&)->Error {let error=self.instantiatedGoals(owner,binding,declaration.scheme,proof,0);if error!=Error.none {return error;}if self.admission.source_bodies && self.scopes.source_instances {for witness in proof.scheme_row_witnesses[..endpoint.row_variables.len] {let error=self.step(0);if error!=Error.none {return error;}if !witness.present {continue;}match self.module.types.row(witness.value.row).tail {blot_check_effects::Tail.variable tail=>{let error=self.scopes.instance_rows.set(tail.value);if error!=Error.none {return error;}},_=>{},}}}proof.instance=List{..};proof.instance_rows=List{..};for witness in proof.witnesses[..endpoint.variables.len] {if witness==0 {continue;}if declaration.capability_flow==blot_check_check::CapabilityFlow.identity || declaration.capability_flow==blot_check_check::CapabilityFlow.consume_task || declaration.capability_flow==blot_check_check::CapabilityFlow.spawn_task {continue;}let usage,error=self.containsUsage(witness);if error!=Error.none {return error;}if usage {return Error.invalid_artifact;}}if self.admission.source_bodies && self.scopes.source_instances {for witness in proof.witnesses[..endpoint.variables.len] {if witness!=0 {let error=self.scopes.sourceInstance(witness,0);if error!=Error.none {return error;}}}}return Error.none;}
