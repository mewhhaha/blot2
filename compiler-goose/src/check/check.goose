fn Engine::constrainCollection(self:Engine&,owner:u32,element:u32,source:u32)->blot_error::Error {let actual=blot_check_storage_types::readableElement(self.types,self.types.head(owner,0));if actual.present {return self.constrain(element,actual.value,source);}let tag=self.types.node(self.types.head(owner,0)).tag;if tag==blot_check_types::Tag.variable {return self.appendPending(PendingObligation{owner:self.current,value:blot_check_types::Obligation{kind:blot_check_types::ObligationKind.collection,ty:owner,result:element,source:source}});}var sequence_tag=blot_check_types::Tag.array;if tag==blot_check_types::Tag.list {sequence_tag=blot_check_types::Tag.list;}let sequence,err=self.types.sequence(sequence_tag,element);if err!=blot_error::Error.none {return err;}return self.constrain(owner,sequence,source);}
