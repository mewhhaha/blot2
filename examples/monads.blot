// The adapter is an ordinary prelude function. Named resolver values work too.
const try = monad Maybe

const add_present = fn left => fn right => do try:
  use first <- left
  use second <- right
  return first + second

entry const present = fn () =>
  Maybe.unwrap_or 0 (add_present (#Some 40) (#Some 2))

const stop = fn () => do monad Maybe:
  use #Nothing
  return @panic "a failed bind skips this continuation"

entry const absent = fn () => Maybe.unwrap_or 42 (stop ())

const checked = fn candidate => do monad Result:
  use value <- candidate
  return $ #Ok (value + 2)

entry const result = fn () => Result.unwrap_or 0 (checked (#Ok 40))

// Monadic loops use Maybe.iterate, whose steps finish before the next begins.
const sum_present = fn count => do try:
  let total = 0
  for index in 0 .. count:
    use value <- #Some 1
    total := self + value
  return total

entry const large_loop = fn () => Maybe.unwrap_or 0 (sum_present 100000)

// The same iteration protocol is available through ordinary function calls.
const step = fn count =>
  if count < 42 then #Some (#Continue (count + 1)) else #Some (#Done count)
entry const iterated = fn () => Maybe.unwrap_or 0 (Maybe.iterate 0 step)
