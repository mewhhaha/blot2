     unordered_set<TypeExpr *> known;
 
     bool Ready(TypeExpr *t) {
-        if (!t) return false;
-        if (known.count(t)) return true;
+        if (!t) { profile.Miss(); profile.Reject(); return false; }
+        if (known.count(t)) { profile.Hit(); return true; }
+        profile.Miss();
         vector<TypeExpr *> seen;
-        if (!Visit(t, seen)) return false;
-        // Cache only the root after the WHOLE graph succeeded. A descendant
-        // in a cycle may have depended on an ancestor that later fails.
+        if (!Visit(t, seen)) { profile.Reject(); return false; }
+        // Every visited node is stable only after the WHOLE closure succeeds.
+        // A cycle may depend on an ancestor whose later field rejects it.
+        known.insert(seen.begin(), seen.end());
         known.insert(t);
         return true;
     }
