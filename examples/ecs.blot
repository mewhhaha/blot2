// Target-language design specimen, not an executable compiler input yet.
// ecs_runtime.blot is the executable scalar/explicit-host-provider port.
// Engine APIs and compiler-intrinsic spellings below are still proposals.

import * as ecs from "engine/ecs"
import { component, resource, Update } from "engine/ecs"
import { add, mul } from "std/ops"

infixl 60 (+) = add
infixl 70 (*) = mul

// Tags are imported const-time declaration transforms, not reserved ECS words.
// Nominal identity comes from the defining module/declaration, not this spelling.
#[component]
data Position = Position { x: F32, y: F32 }

#[component]
data Velocity = Velocity { x: F32, y: F32 }

#[component]
data Ghost = Ghost { remaining: F32 }

#[resource]
data Time = Time { seconds: F32 }

fn read_position () => do:
  use position <- ecs.get Position
  return position

// get and set perform typed Read/Write effects; wrappers retain those effects.
// use sequences a computation; it does not supply storage or handle its effects.

fn move () => do:
  use position <- read_position ()
  use velocity <- ecs.get Velocity
  use time <- ecs.get Time
  let next = position
  next.x := self + velocity.x * time.seconds
  next.y := self + velocity.y * time.seconds
  use ecs.set next
  return ()

// Inferred effects include Read Position through the helper, Read Velocity,
// Read Time, and Write Position. The entity query requires Position + Velocity;
// Time registers world-level resource storage, not an entity requirement.

fn add_ghost () => do:
  use ecs.insert (Ghost { remaining: 1.0 })
  return ()

// Insert Ghost registers storage but does not require Ghost to be present first.
// No system scan invents component values or attaches components to entities.
// Both bare use statements above mean use _ <-; discarding keeps their effects.

const game = ecs.build [
  ecs.system (Update, move),
  ecs.system (Update, add_ghost),
]

type World = game.world_type

// PROPOSAL: an explicit provider boundary, not an implicit global world.
// run invokes move under this world/entity and returns (next_world, ()).
// Component reads/writes target entity; resource reads/writes target world.
// Earlier world/component values remain unchanged; set advances provider state.
export fn move_entity (world: World, entity: ecs.EntityId) =>
  ecs.run (world, entity, move)

// PROPOSAL: the same boundary via a resolver value carrying world/entity state.
// ecs.scope keeps direct bindings and finishes with (next_world, result).
fn move_entity_scoped (world: World, entity: ecs.EntityId) =>
  do ecs.scope (world, entity):
    use move ()
    return ()

// The generated update queries matching entities, runs each system with a
// scoped provider, and returns the next world. It does not retain a global world.
export fn update (world: World) -> World => game.update world

// Build runs only after the selected functions' type/effect rows are resolved.
// It inspects move/add_ghost before the runner handles their ECS effects.
// run handles only ECS effects; any other effects still reach its caller.
// Missing providers at executable boundaries must fail, not choose a world.
// Type and effect descriptors are compile-time values, not runtime reflection.
// Code-only edits can reuse storage when identities, layouts, and ABI agree.
// Provider execution and generated worlds are not implemented by the bootstrap.

// PROPOSAL: ordinary functions can run in a const context. These parameters
// require const-known arguments; runtime input cannot select a representation.
fn vector_type (const element: Type) => fn (const lanes: U32) -> Type =>
  @type.simd (element, lanes)

type F32x4 = vector_type F32 4

fn F32x4.add (left: F32x4) => fn (right: F32x4) -> F32x4 =>
  @simd.f32x4.add left right

// First-class arrays keep their array representation; this explicit load
// produces a native 128-bit vector, not a record or an array of boxed numbers.
fn load_four (values: Array F32) => fn (offset: U32) -> F32x4 =>
  @simd.load (F32x4, values, offset)

// This load must check bounds. Its exact intrinsic API and alignment rules are
// open; relaxed SIMD and implicit auto-vectorization are not baseline promises.
