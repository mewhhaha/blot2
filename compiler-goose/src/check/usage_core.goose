        Tag.request_decision => { if node.a > blot_check_core::requestDecisionKindCode(blot_check_core::RequestDecisionKind.break_) { return Outcome.live,Error.invalid_artifact; } for child in [node.b,node.c] { if child != 0 { let flow,err = self.expression(child,depth+1); if err != Error.none { return Outcome.live,err; } } } return Outcome.exit,Error.none; },
        Tag.request_loop => { return self.requestLoop(source,node,depth); },
        Tag.pattern_bind => { let flow,err = self.expression(node.b,depth+1); if err != Error.none || flow == Outcome.exit { return flow,err; } if node.c != 0 { let count=self.len; let mark=self.snapshot_len; let before,err=self.snapshot(); if err != Error.none { return Outcome.live,err; } let flow,err=self.expression(node.c,depth+1); self.len=count; copy(self.states[..count],before); self.snapshot_len=mark; if err != Error.none { return Outcome.live,err; } } let err=self.pattern(node.a,depth+1); if err != Error.none { return Outcome.live,err; } },
        Tag.package_unpack => { let flow,err=self.expression(node.a,depth+1); if err != Error.none || flow == Outcome.exit { return flow,err; } let err=self.introduce(node.b); if err != Error.none { return Outcome.live,err; } return self.expression(self.module.extra[node.c],depth+1); },
        Tag.loop_ => { return self.loopValue(source,node,depth); },
        _ => { return Outcome.live,Error.invalid_artifact; },
