fn Engine::operationTemplate(self:Engine&,name:u32)->blot_support::Option<u32>,blot_error::Error {if self.lookup(name).present {return blot_support::none<u32>(),blot_error::Error.none;}let global,err=self.globalBinding(name);if err!=blot_error::Error.none || global.present {return blot_support::none<u32>(),err;}let text=self.pool.get(name);let separator=firstDot(text);var end=text.len;if separator.present {end=separator.value;}let root,known=self.pool.lookup(text[..end]);if known && (self.lookup(root).present || self.hasGlobal(root)) {return blot_support::none<u32>(),blot_error::Error.none;}return self.catalogOperationTemplate(name),blot_error::Error.none;}
