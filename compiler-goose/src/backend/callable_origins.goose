    }else {
        if origin.place % 4 != 0 || origin.place > module.data.len || bytes > module.data.len - origin.place {return blot_support::none<Construction>();}if blot_bytes::get_u32(module.data,origin.place) != origin.target {return blot_support::none<Construction>();}for field in module.static_fields {if (field & ~3 as u32) == origin.place {return blot_support::none<Construction>();}}result.environment = Environment.data_word {value: origin.place + 4};result.end = origin.place + bytes;
