{
  "tasks": {
    "build:compiler": "deno run --allow-read --allow-run=sh scripts/build_compiler.ts",
    "build:compiler:pgo": "sh compiler-goose/build.sh --pgo",
    "build:compiler:dev": "deno run --allow-read --allow-run=sh scripts/build_compiler.ts --dev",
    "blot": "deno run --allow-read --allow-write --allow-run --allow-env=HOME,XDG_CACHE_HOME,BPM_CACHE_DIR host/cli.ts",
    "bpm": "deno run --allow-read --allow-write --allow-run=git --allow-env=HOME,XDG_CACHE_HOME,BPM_CACHE_DIR host/bpm.ts",
    "test:bpm": "deno test --allow-read --allow-write --allow-run tests/host/packages.test.ts tests/host/cli_packages.test.ts tests/host/bpm.test.ts -- compiler-goose/build/blotc-goose",
    "generate:parser": "deno run --allow-read=. --allow-write=generated scripts/generate_parser.ts",
    "generate": "deno task generate:parser",
    "generate:editor": "cd editor/tree-sitter-blot2 && tree-sitter generate --abi 14 --js-runtime native",
    "check:editor": "deno task generate:editor && cd editor/tree-sitter-blot2 && XDG_CACHE_HOME=\"$PWD/.cache\" tree-sitter test --config-path cli-config.json && XDG_CACHE_HOME=\"$PWD/.cache\" tree-sitter parse --config-path cli-config.json --grammar-path . --quiet ../../examples/syntax.blot ../../examples/ecs.blot ../../examples/host_capabilities.blot ../../examples/host_io.blot",
    "helix:install": "deno task check:editor && deno task test:editor && deno run --allow-env=HOME,XDG_CONFIG_HOME --allow-read --allow-write --allow-run=tree-sitter,hx editor/helix/install.ts",
    "helix:highlight": "deno task check:editor && deno task test:editor && deno run --allow-env=HOME,XDG_CONFIG_HOME --allow-read --allow-write --allow-run=tree-sitter,hx editor/helix/install.ts --highlight-only",
    "bench:compile": "deno run --allow-all benchmarks/tools/bench_compile.ts",
    "bench:idiomatic": "deno run --allow-all benchmarks/tools/bench_idiomatic.ts",
    "profile:compile": "deno run --allow-all benchmarks/tools/profile_compile.ts",
    "test:editor": "deno test --allow-read=editor tests/tooling/helix_languages.test.ts",
    "test:guest": "deno run --allow-read --allow-write --allow-run --allow-env scripts/test_compiler.ts --guest",
    "test:std": "deno task blot test tests/std",
    "test:zig-project": "deno test --allow-read --allow-write --allow-run --allow-env=BLOT_CLIENT_TEST_AMBIENT tests/guest/zig_project_transport.test.ts tests/guest/zig_project_client.test.ts -- compiler-goose/build/blotc-goose",
    "test:compiler": "deno run --allow-read --allow-write --allow-run --allow-env scripts/test_compiler.ts",
    "test:compiler:dev": "deno run --allow-read --allow-write --allow-run --allow-env scripts/test_compiler.ts --dev",
    "test:compiler:stress": "deno task build:compiler && deno test --allow-read --allow-write --allow-run tests/guest/stage_chain_budget.stress.ts -- compiler-goose/build/blotc-goose",
    "test:compiler:tasks": "deno test --allow-read --allow-write --allow-run --allow-env tests/tooling/test_compiler.test.ts tests/tooling/bench_compile.test.ts tests/tooling/compiler_gate_state.test.ts tests/tooling/build_compiler.test.ts",
    "test": "deno task test:editor && deno task test:compiler && deno task test:std",
    "check": "deno fmt --check mod.ts deno.json host tests scripts editor/helix .github && deno check mod.ts host/cli.ts host/installed_cli.ts scripts/*.ts && deno task test",
    "package:pack": "deno run --allow-read --allow-write=generated/compiler scripts/pack_native.ts",
    "package:build": "deno task build:compiler && deno task package:pack",
    "package:check": "deno task package:build && deno publish --dry-run --allow-dirty"
  },
  "imports": {
    "@mewhhaha/baba": "npm:@jsr/mewhhaha__baba@9.0.1"
  },
  "fmt": {
    "exclude": [
      "generated",
      "editor/tree-sitter-blot2/src",
      "build",
      "compiler-goose",
      "tests/guest"
    ]
  },
  "name": "@mewhhaha/blot",
  "version": "0.2.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./host/installed_cli.ts",
    "./diagnostics": "./host/diagnostics.ts",
    "./bpm": "./host/bpm.ts",
    "./packages": "./host/packages.ts",
    "./test": "./host/test_runner.ts",
    "./doc": "./host/doc.ts",
    "./processes": "./host/processes.ts",
    "./kernels": "./host/kernels.ts",
    "./runtime": "./host/runtime.ts",
    "./guest": "./host/guest.ts",
    "./zig-project": "./host/zig_project_client.ts",
    "./format": "./host/format.ts",
    "./derive": "./host/derive.ts",
    "./derive-cli": "./host/derive_cli.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "CHEATSHEET.md",
      "skills/blot/SKILL.md",
      "skills/blot-diagnostics/SKILL.md",
      "skills/agent-loops/SKILL.md",
      "mod.ts",
      "host/cli.ts",
      "host/doc.ts",
      "host/doc_html.ts",
      "docs/host/doc.md",
      "host/test_runner.ts",
      "host/test_worker.ts",
      "host/diagnostics.ts",
      "host/guest.ts",
      "host/kernels.ts",
      "host/kernel_worker.ts",
      "host/processes.ts",
      "host/process_subprocess.ts",
      "host/runtime.ts",
      "host/cleanup_data.ts",
      "host/resource_journal.ts",
      "host/task_runtime.ts",
      "host/task_guest.ts",
      "docs/language/guide.md",
      "host/installed_cli.ts",
      "host/bpm.ts",
      "host/packages.ts",
      "docs/host/packages.md",
      "host/packaged_native.ts",
      "host/zig_project_client.ts",
      "host/editor_completion.ts",
      "host/lsp.ts",
      "host/lsp_protocol.ts",
      "host/type_diagnostics.ts",
      "host/assets.ts",
      "host/generators.ts",
      "host/native_assets.ts",
      "host/format.ts",
      "host/text.ts",
      "host/derive.ts",
      "docs/host/derive.md",
      "host/syntax.ts",
      "host/postfix_syntax.ts",
      "host/parser_source.ts",
      "host/numeric_parser.ts",
      "generated/compiler/blotc.gz",
      "generated/parser/wasm/cst-schema.json",
      "generated/parser/wasm/mod.ts",
      "generated/parser/wasm/parser.plan",
      "generated/parser/wasm/parser.wasm",
      "generated/parser/wasm/syntax.ts",
      "host/derive_cli.ts",
      "std/*.blot",
      "blot-workspace.yaml"
    ]
  }
}
