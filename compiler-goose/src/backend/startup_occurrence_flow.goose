fn push(self_:Edges&,value:Edge) {if self_.failure!=blot_error::Error.none {return;}self_.failure=blot_support_pooled_buffer::push(self_,value,pool_Edges);self_.len=self_.items.len;}
fn append(self_:Edges&,values:const Edge[:]) {if self_.failure!=blot_error::Error.none {return;}self_.failure=blot_support_pooled_buffer::append(self_,values,pool_Edges);self_.len=self_.items.len;}
