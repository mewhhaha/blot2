type Read is effect = { get: Unit -> U32 }
const make = func value => return func other => return do:
  use seed <- Read.get ()
  break @u32.add value (@u32.add seed other)
const compose = func first => return func second => return func value => return first (second value)
const add_forty = make 40
const provider = @effect.provider Read.get (func () => return 1)
entry const answer = func () => return do provider:
  let increment = func value => return @u32.add value 1
  use result <- (compose increment add_forty) 0
  break result
entry const folded = answer ()
