// Exact xorshift64 and shared checksum operations.
const FNV_OFFSET: U64 = 0xCBF29CE484222325

func xs_next (x: U64): U64 =>
  let a = x ^ (x << 13)
  let b = a ^ (a >> 7)
  return b ^ (b << 17)

func xs_mod (x: U64) -> (k: U32): U32 =>
  return (x % k.to_u64).to_u32

func sq_div_u32 (a: U32) -> (d: U32): U32 =>
  let wide = a.to_u64
  return ((wide * wide) / d.to_u64).to_u32

func fnv_step (h: U64) -> (byte: U8): U64 =>
  return (h ^ byte.to_u64) * 1099511628211

// Checksum lines use a tag followed by two little-endian U32 words in ABI 8.
func emit_u64 (out: own #[U32]) -> (v: U64): #[U32] =>
  out := self.push 0
  out := self.push v.to_u32
  out := self.push (v >> 32).to_u32
  return out

func emit_i64 (out: own #[U32]) -> (v: I64): #[U32] =>
  out := self.push 1
  out := self.push v.to_u32
  out := self.push (v >> 32).to_u32
  return out

func emit_u32 (out: own #[U32]) -> (v: U32): #[U32] =>
  out := self.push 2
  out := self.push v
  out := self.push 0
  return out
