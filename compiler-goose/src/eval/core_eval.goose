fn selected(self_: RaggedFacts&,id: u32) -> blot_support::Option<blot_check_primitive_operator::Operation>,Error { let n=self_.module.node(id); if n.tag==blot_check_core::Tag.scalar&&n.c==0 { return blot_support::some(blot_check_primitive_operator::Operation {op:n.op}),blot_error::Error.none; } var first=n.a; var second=n.b; if n.tag==blot_check_core::Tag.call { let args=self_.module.children(id); if args.len!=2 { return blot_support::none<blot_check_primitive_operator::Operation>(),blot_error::Error.none; } first=args[0]; second=args[1]; } let left,error=projectType(self_.session,self_.owner,id,self_.module.typeOf(first),self_.frame.mappings.items,self_.frame.row_mappings.items); if error!=blot_error::Error.none { return blot_support::none<blot_check_primitive_operator::Operation>(),error; } let right,e=projectType(self_.session,self_.owner,id,self_.module.typeOf(second),self_.frame.mappings.items,self_.frame.row_mappings.items); if e!=blot_error::Error.none { return blot_support::none<blot_check_primitive_operator::Operation>(),e; } if left==0||left!=right { return blot_support::none<blot_check_primitive_operator::Operation>(),blot_error::Error.none; } let tag=self_.session.storage.evidence.node(left).tag; if tag!=blot_eval_type_evidence::Tag.unsigned32&&tag!=blot_eval_type_evidence::Tag.floating32&&tag!=blot_eval_type_evidence::Tag.boolean { return blot_support::none<blot_check_primitive_operator::Operation>(),blot_error::Error.none; }
 if n.tag==blot_check_core::Tag.call { var machine=blot_backend_runtime_ir::SC_u32; if tag==blot_eval_type_evidence::Tag.floating32 { machine=blot_backend_runtime_ir::SC_f32; } if tag==blot_eval_type_evidence::Tag.boolean { machine=blot_backend_runtime_ir::SC_bool; } var target=self_.module.call(id).target; if target.unit==0 { target.unit=unitId(self_.session,self_.owner); } return blot_check_primitive_operator::analyzeTyped(self_.session.units,target,machine),blot_error::Error.none; } var member: u32=0; if n.tag==blot_check_core::Tag.associated { member=n.c; } let identity=evidenceIdentity(self_.session,left); if !identity.present { return blot_support::none<blot_check_primitive_operator::Operation>(),blot_error::Error.none; } let target,e2=associatedTarget(self_.session,unitId(self_.session,self_.owner),identity.value,member,operator(n.op)); if e2!=blot_error::Error.none { return blot_support::none<blot_check_primitive_operator::Operation>(),e2; } if target.present { return blot_check_primitive_operator::analyze(self_.session.units,target.value),blot_error::Error.none; } if member!=0||n.op==blot_check_core::Op.none { return blot_support::none<blot_check_primitive_operator::Operation>(),blot_error::Error.none; } return blot_support::some(blot_check_primitive_operator::Operation {op:n.op}),blot_error::Error.none; }
fn operation(self_: RaggedFacts,id: u32) -> blot_support::Option<blot_check_primitive_operator::Operation> { for entry in self_.operations[..self_.operation_count] { if entry.id==id { return blot_support::some(entry.operation); } } return blot_support::none<blot_check_primitive_operator::Operation>(); }
