type Error=blot_error::Error;
type Module=blot_check_core::Module;
type ModuleRef=blot_check_frozen_core_validation::ModuleRef;
type Id=u32;
type List=blot_check_types::List;
type Tag=blot_check_types::Tag;
type CoreTag=blot_check_core::Tag;
type Principal=blot_check_package_contracts::Principal;
type Views=blot_check_package_contracts::Context;
type Workspace=blot_check_scheme_equations::Workspace;
fn require(value:bool)->Error {if !value {return blot_error::Error.invalid_artifact;}return blot_error::Error.none;}
fn contains(values:const u32[:],wanted:u32)->bool {for value in values {if value==wanted {return true;}}return false;}
fn sameOwner(first:const Module&,second:const Module&)->bool {return first.owner_id!=0 && first.owner_id==second.owner_id;}
fn authorityFree(module:const Module&,id:u32)->bool,Error {var remaining:i64=4096;return authorityDepth(module,id,0,remaining);}
recursive fn authorityRow(module:const Module&,row:u32,depth:i64,remaining:i64&)->bool,Error {for label in module.types.rowLabels(row) {let operation=module.types.operations[label];if operation.instance.decl!=0 {return false,blot_error::Error.none;}for argument in module.types.list(operation.arguments) {let free,error=authorityDepth(module,argument,depth+1,remaining);if error!=blot_error::Error.none || !free {return false,error;}}}return true,blot_error::Error.none;}
recursive fn authorityDepth(module:const Module&,id:u32,depth:i64,remaining:i64&)->bool,Error {if depth>=128 || remaining==0 {return false,blot_error::Error.invalid_artifact;}remaining-=1;let node=module.types.node(id);match node.tag {scoped,instance_version,bound,rigid,forall,existential=>{return false,blot_error::Error.none;},usage=>{if node.b==blot_check_types::usageKindCode(blot_parse_ast::usagekind_borrow) || node.b==blot_check_types::usageKindCode(blot_parse_ast::usagekind_borrow_mut) {return false,blot_error::Error.none;}return authorityDepth(module,node.a,depth+1,remaining);},function=>{let free,error=authorityDepth(module,node.a,depth+1,remaining);if error!=blot_error::Error.none || !free {return false,error;}let free,error=authorityDepth(module,node.b,depth+1,remaining);if error!=blot_error::Error.none || !free {return false,error;}return authorityRow(module,node.c,depth+1,remaining);},provider=>{let free,error=authorityDepth(module,node.a,depth+1,remaining);if error!=blot_error::Error.none || !free {return false,error;}return authorityRow(module,node.c,depth+1,remaining);},state_provider=>{for child in [node.a,node.b,node.c] {let free,error=authorityDepth(module,child,depth+1,remaining);if error!=blot_error::Error.none || !free {return false,error;}}},nominal,projection,instance_selection=>{for child in module.types.nominalArguments(node) {let free,error=authorityDepth(module,child,depth+1,remaining);if error!=blot_error::Error.none || !free {return false,error;}}},record=>{for index in 0..node.b {let free,error=authorityDepth(module,module.types.recordField(node,index).ty,depth+1,remaining);if error!=blot_error::Error.none || !free {return false,error;}}},product=>{for child in module.types.list(List{start:node.a,len:node.b, ..}) {let free,error=authorityDepth(module,child,depth+1,remaining);if error!=blot_error::Error.none || !free {return false,error;}}},array,list,cursor,resolver=>{return authorityDepth(module,node.a,depth+1,remaining);},_=>{},}return true,blot_error::Error.none;}
fn equal(module:const Module&,left:u32,right:u32,depth:i64,remaining:i64&)->bool,Error {return equalWithRows(module,left,right,List{..},depth,remaining);}
fn sameRow(module:const Module&,left:u32,right:u32,closed:List)->bool {return sameOwnedRow(module,left,right,closed,closed);}
fn sameOwnedRow(module:const Module&,left:u32,right:u32,left_rows:List,right_rows:List)->bool {if left==right {return true;}let first=module.types.row(left);let second=module.types.row(right);if module.types.rowLabels(left)!=module.types.rowLabels(right) {return false;}var a=first.tail;var b=second.tail;match a {variable value=>{if contains(module.types.list(left_rows),value.value) {a=blot_check_effects::Tail.closed;}},_=>{},}match b {variable value=>{if contains(module.types.list(right_rows),value.value) {b=blot_check_effects::Tail.closed;}},_=>{},}return a==b;}
fn equalWithRows(module:const Module&,left:u32,right:u32,closed:List,depth:i64,remaining:i64&)->bool,Error {return equalOwnedRows(module,left,right,closed,closed,depth,remaining);}
recursive fn equalOwnedRows(module:const Module&,left:u32,right:u32,left_rows:List,right_rows:List,depth:i64,remaining:i64&)->bool,Error {if depth>=128 || remaining==0 {return false,blot_error::Error.invalid_artifact;}remaining-=1;if left==right {return true,blot_error::Error.none;}let a=module.types.node(left);let b=module.types.node(right);if a.tag!=b.tag {return false,blot_error::Error.none;}match a.tag {variable=>{return false,blot_error::Error.none;},product=>{if a.b!=b.b {return false,blot_error::Error.none;}let first=module.types.list(List{start:a.a,len:a.b, ..});let second=module.types.list(List{start:b.a,len:b.b, ..});for index in 0..first.len {let same,error=equalOwnedRows(module,first[index],second[index],left_rows,right_rows,depth+1,remaining);if error!=blot_error::Error.none || !same {return false,error;}}return true,blot_error::Error.none;},record=>{if a.b!=b.b {return false,blot_error::Error.none;}for index in 0..a.b {let x=module.types.recordField(a,index);let y=module.types.recordField(b,index);if x.name!=y.name {return false,blot_error::Error.none;}let same,error=equalOwnedRows(module,x.ty,y.ty,left_rows,right_rows,depth+1,remaining);if error!=blot_error::Error.none || !same {return false,error;}}return true,blot_error::Error.none;},nominal=>{if a.a!=b.a || a.b!=b.b {return false,blot_error::Error.none;}let first=module.types.nominalArguments(a);let second=module.types.nominalArguments(b);if first.len!=second.len {return false,blot_error::Error.none;}for index in 0..first.len {let same,error=equalOwnedRows(module,first[index],second[index],left_rows,right_rows,depth+1,remaining);if error!=blot_error::Error.none || !same {return false,error;}}return true,blot_error::Error.none;},function=>{let same,error=equalOwnedRows(module,a.a,b.a,left_rows,right_rows,depth+1,remaining);if error!=blot_error::Error.none || !same {return false,error;}let same,error=equalOwnedRows(module,a.b,b.b,left_rows,right_rows,depth+1,remaining);if error!=blot_error::Error.none || !same {return false,error;}return sameOwnedRow(module,a.c,b.c,left_rows,right_rows),blot_error::Error.none;},existential=>{if blot_check_package_contracts::validateEndpoint(module.types,remaining,null,left,right)!=blot_error::Error.none {return false,blot_error::Error.none;}return true,blot_error::Error.none;},state_provider=>{for pair in [[a.a,b.a],[a.b,b.b],[a.c,b.c]] {let same,error=equalOwnedRows(module,pair[0],pair[1],left_rows,right_rows,depth+1,remaining);if error!=blot_error::Error.none || !same {return false,error;}}return true,blot_error::Error.none;},usage,array,list,cursor,provider,resolver=>{if a.b!=b.b || a.c!=b.c {return false,blot_error::Error.none;}return equalOwnedRows(module,a.a,b.a,left_rows,right_rows,depth+1,remaining);},_=>{return a.a==b.a && a.b==b.b && a.c==b.c,blot_error::Error.none;},}}
fn result(module:const Module&,expected:u32,actual:u32,remaining:i64&)->Error {if actual==blot_check_types::never {return blot_error::Error.none;}let same,error=equal(module,expected,actual,0,remaining);if error!=blot_error::Error.none {return error;}return require(same);}
fn callable(module:const Module&,raw:u32,remaining:i64&)->blot_check_types::Node,Error {var current=raw;for iteration in 0..128 {if remaining==0 {return default<blot_check_types::Node>(),blot_error::Error.invalid_artifact;}remaining-=1;let node=module.types.node(current);if node.tag!=blot_check_types::Tag.usage && node.tag!=blot_check_types::Tag.forall {if node.tag!=blot_check_types::Tag.function {return default<blot_check_types::Node>(),blot_error::Error.invalid_artifact;}return node,blot_error::Error.none;}current=node.a;}return default<blot_check_types::Node>(),blot_error::Error.invalid_artifact;}
fn nominalOwner(module:const Module&,target:blot_check_types::Node,remaining:i64&)->u32,Error {if target.tag!=blot_check_types::Tag.nominal {return 0,blot_error::Error.invalid_artifact;}var owner=blot_support::none<u32>();for family,index in module.nominals {if remaining==0 {return 0,blot_error::Error.invalid_artifact;}remaining-=1;if family.identity.unit!=target.a || family.identity.decl!=target.b {continue;}if owner.present || family.constructors.len==0 {return 0,blot_error::Error.invalid_artifact;}if (family.private || family.is_opaque) && family.identity.unit!=0 && family.identity.unit!=module.unit {return 0,blot_error::Error.invalid_artifact;}owner=blot_support::some(index as u32);}if !owner.present {return 0,blot_error::Error.invalid_artifact;}return owner.value,blot_error::Error.none;}
struct DecisionOwner {callback:u32,ty:u32,breaks:bool&}
struct Locals {bindings:const u32[:]=default<const u32[:]>(),parameters:const blot_check_core::Parameter[:]=default<const blot_check_core::Parameter[:]>(),parent:const Locals?=null}
struct LoopOwner {node:u32,parent:LoopOwner?=null,exits:bool=false}
struct ScopeOwner {identity:blot_check_types::NominalIdentity,parent:i64=0,task_view:u32=0}
reusable var scope_frames:ScopeOwner[>..];
fn pushScopeOwner(identity:blot_check_types::NominalIdentity,parent:i64,view:u32)->i64 {return scope_frames.alloc_index(ScopeOwner{identity:identity,parent:parent,task_view:view,..})+1;}
fn restoreScopes(self_:Named&,prior:i64) {while self_.scope_owner!=prior {assert(self_.scope_owner!=0);let index=self_.scope_owner-1;self_.scope_owner=scope_frames[index].parent;scope_frames.free(index);}}
struct LoanOwner {region:u32,parent:const LoanOwner?=null}
struct CallOwner {module:const Module&,binding:u32,parent:const CallOwner?=null}
struct RowOwner {closed:List,generic:List,parent:i64=0}
reusable var row_frames:RowOwner[>..];
fn pushRowOwner(closed:List,generic_rows:List,parent:i64)->i64 {return row_frames.alloc_index(RowOwner{closed:closed,generic:generic_rows,parent:parent,..})+1;}
fn restoreRows<S>(state:S&,prior:i64) {while state.row_owners!=prior {assert(state.row_owners!=0);let index=state.row_owners-1;state.row_owners=row_frames[index].parent;row_frames.free(index);}}
struct Named {workspace:Workspace?=null,m:const Module&,units:const ModuleRef[:]=default<const ModuleRef[:]>(),remaining:i64&,variables:List=List{..},current_scheme:blot_support::Option<blot_check_types::Scheme> =blot_support::none<blot_check_types::Scheme>(),row_variables:List=List{..},data_rows:List=List{..},row_owners:i64=0,locals:const Locals?=null,loop_owner:LoopOwner?=null,scope_owner:i64=0,loan_owner:const LoanOwner?=null,active_calls:const CallOwner?=null,ambient:blot_support::Option<blot_check_effects::Row> =blot_support::none<blot_check_effects::Row>(),decision_owner:const DecisionOwner?=null,resolver_callback:u32=0}
fn step(self_:Named&,depth:i64)->Error {if depth>=128 || self_.remaining==0 {return blot_error::Error.invalid_artifact;}self_.remaining-=1;return blot_error::Error.none;}
recursive fn declaredBody(self_:Named&,body:const blot_check_core::Body&,parameters:const blot_check_core::Parameter[:],depth:i64)->Error {var active .= self_.active_calls;while active {let error=self_.step(depth);if error!=blot_error::Error.none {return error;}if sameOwner(active.module,self_.m) && active.binding==body.binding {return blot_error::Error.none;}active .= active.parent;}let prior_scheme=self_.current_scheme;let prior_ambient=self_.ambient;let prior_callback=self_.resolver_callback;var scoped=scopedNamed(self_,self_.locals,self_.loop_owner,self_.loan_owner,self_.active_calls,null);scoped.current_scheme=blot_support::some(body.scheme);scoped.ambient=blot_support::none<blot_check_effects::Row>();let error=declaredBodyValue(scoped,body,parameters,depth);scoped.current_scheme=prior_scheme;scoped.ambient=prior_ambient;scoped.resolver_callback=prior_callback;publishNamed(self_,scoped);return error;}
recursive fn declaredBodyValue(self_:Named&,body:const blot_check_core::Body&,parameters:const blot_check_core::Parameter[:],depth:i64)->Error {var signature=self_.m.bindings[body.binding].ty;for parameter in parameters {let arrow,error=callable(self_.m,signature,self_.remaining);if error!=blot_error::Error.none {return error;}self_.ambient=blot_support::some(self_.m.types.row(arrow.c));signature=arrow.b;}let owner=callOwner(self_.m,body.binding,self_.active_calls);var scoped=scopedNamed(self_,self_.locals,self_.loop_owner,self_.loan_owner,owner,null);scoped.resolver_callback=0;let error=scoped.node(body.root,parameters,body.closed_rows,depth+1);publishNamed(self_,scoped);return error;}
fn knownInstance(self_:Named&,identity:blot_check_types::NominalIdentity)->bool,Error {if identity.decl==0 {return true,blot_error::Error.none;}var scope_index=self_.scope_owner;while scope_index!=0 {let owner=scope_frames[scope_index-1];let error=self_.step(0);if error!=blot_error::Error.none {return false,error;}if identity==owner.identity {return true,blot_error::Error.none;}scope_index=owner.parent;}return false,blot_error::Error.none;}
recursive fn token(self_:Named&,id:u32,depth:i64)->Error {let error=self_.step(depth);if error!=blot_error::Error.none {return error;}var node=self_.m.types.node(id);if node.tag==blot_check_types::Tag.scoped {let known,error=self_.knownInstance(blot_check_types::NominalIdentity{unit:node.b,decl:node.c, ..});if error!=blot_error::Error.none {return error;}if !known {return blot_error::Error.invalid_artifact;}let family=self_.m.types.node(node.a);if family.tag==blot_check_types::Tag.nominal && family.a==blot_check_task_types::view.unit && family.b==blot_check_task_types::view.decl {var scope_index=self_.scope_owner;while scope_index!=0 {let owner=scope_frames[scope_index-1];let error=self_.step(depth);if error!=blot_error::Error.none {return error;}if owner.task_view==id {let arguments=self_.m.types.nominalArguments(family);if arguments.len!=2 || self_.m.types.node(arguments[1]).tag!=blot_check_types::Tag.instance_version {return blot_error::Error.invalid_artifact;}return self_.data(arguments[0],depth+1);}scope_index=owner.parent;}return blot_error::Error.invalid_artifact;}node=self_.m.types.node(node.a);}if node.tag!=blot_check_types::Tag.nominal {return blot_error::Error.invalid_artifact;}for argument in self_.m.types.nominalArguments(node) {let error=self_.data(argument,depth+1);if error!=blot_error::Error.none {return error;}}return blot_error::Error.none;}
recursive fn dataRow(self_:Named&,id:u32,depth:i64)->Error {for label in self_.m.types.rowLabels(id) {let error=self_.step(depth);if error!=blot_error::Error.none {return error;}let operation=self_.m.types.operations[label];let known,error=self_.knownInstance(operation.instance);if error!=blot_error::Error.none {return error;}if !known {return blot_error::Error.invalid_artifact;}for argument in self_.m.types.list(operation.arguments) {let error=self_.data(argument,depth+1);if error!=blot_error::Error.none {return error;}}}return blot_error::Error.none;}
fn ownedTail(self_:Named&,id:u32,closed_rows:List)->bool {let tail=self_.m.types.row(id).tail;match tail {closed=>{return true;},variable value=>{if contains(self_.m.types.list(closed_rows),value.value) || contains(self_.m.types.list(self_.row_variables),value.value) {return true;}var row_index=self_.row_owners;while row_index!=0 {let owner=row_frames[row_index-1];if contains(self_.m.types.list(owner.closed),value.value) || contains(self_.m.types.list(owner.generic),value.value) {return true;}row_index=owner.parent;}return false;},_=>{return false;},}}
fn initializeViews(self_:Named&,closed_rows:List,context:Views&,depth:i64)->Error {let error=context.initialize();if error!=blot_error::Error.none {return error;}for row,index in self_.m.types.effects.rows {let error=self_.step(depth);if error!=blot_error::Error.none {return error;}match row.tail {variable value=>{var closed=contains(self_.m.types.list(closed_rows),value.value);var row_index=self_.row_owners;while row_index!=0 {let owner=row_frames[row_index-1];let error=self_.step(depth);if error!=blot_error::Error.none {return error;}if contains(self_.m.types.list(owner.closed),value.value) {closed=true;}row_index=owner.parent;}if !closed {continue;}let error=context.closed_rows.set(index);if error!=blot_error::Error.none {return error;}if row.labels.len==0 {let error=context.pure_rows.set(index);if error!=blot_error::Error.none {return error;}}},_=>{},}}return blot_error::Error.none;}
fn binders(self_:Named&,body:const blot_check_core::Body&)->const u32[:],Error {if body.runtime || body.scheme.generative.len!=0 {return default<const u32[:]>(),blot_error::Error.invalid_artifact;}let rows=self_.m.types.list(body.scheme.row_variables);if rows.len>128 {return default<const u32[:]>(),blot_error::Error.invalid_artifact;}for variable,index in rows {if variable>=self_.m.types.effects.variable_count || contains(rows[..index],variable) {return default<const u32[:]>(),blot_error::Error.invalid_artifact;}}let variables=self_.m.types.list(body.scheme.variables);if variables.len>32 {return default<const u32[:]>(),blot_error::Error.invalid_artifact;}for variable,index in variables {if self_.m.types.node(variable).tag!=blot_check_types::Tag.variable || contains(variables[..index],variable) {return default<const u32[:]>(),blot_error::Error.invalid_artifact;}}return variables,blot_error::Error.none;}
fn local(self_:Named&,binding:u32)->bool,Error {var scope .= self_.locals;while scope {for parameter in scope.parameters {let error=self_.step(0);if error!=blot_error::Error.none {return false,error;}if parameter.binding==binding {return true,blot_error::Error.none;}}for owned in scope.bindings {let error=self_.step(0);if error!=blot_error::Error.none {return false,error;}if owned==binding {return true,blot_error::Error.none;}}scope .= scope.parent;}return false,blot_error::Error.none;}
fn constructorVariables(self_:Named&,owner:u32,constructor:blot_check_core::Constructor)->const u32[:],Error {if constructor.nominal!=owner || constructor.scheme.obligations.len!=0 || constructor.scheme.row_variables.len!=0 || constructor.scheme.generative.len!=0 {return default<const u32[:]>(),blot_error::Error.invalid_artifact;}let variables=self_.m.types.list(constructor.scheme.variables);if variables.len>32 {return default<const u32[:]>(),blot_error::Error.invalid_artifact;}for variable,position in variables {if self_.m.types.node(variable).tag!=blot_check_types::Tag.variable || contains(variables[..position],variable) || !contains(self_.m.types.list(self_.m.nominals[owner].variables),variable) {return default<const u32[:]>(),blot_error::Error.invalid_artifact;}}return variables,blot_error::Error.none;}

fn existentialData(types:const blot_check_core::Types&,remaining:i64&,id:u32)->Error {var context=Views{types:types,remaining:remaining,..};let error=context.initialize();if error!=blot_error::Error.none {return error;}return context.visit(id);}
recursive fn data(self_:Named&,id:u32,depth:i64)->Error {let error=self_.step(depth);if error!=blot_error::Error.none {return error;}let node=self_.m.types.node(id);match node.tag {unit,boolean,unsigned32,floating32,never=>{return blot_error::Error.none;},variable=>{return require(contains(self_.m.types.list(self_.variables),id));},existential=>{return existentialData(self_.m.types,self_.remaining,id);},array,list,cursor=>{return self_.data(node.a,depth+1);},
 usage=>{let kind,valid=blot_check_types::usageKindFromCode(node.b);if !valid {return blot_error::Error.invalid_artifact;}if kind==blot_parse_ast::usagekind_borrow || kind==blot_parse_ast::usagekind_borrow_mut {var owner .= self_.loan_owner;var found=false;while owner {let error=self_.step(depth);if error!=blot_error::Error.none {return error;}if owner.region==node.c {found=true;}owner .= owner.parent;}if node.c==0 || !found {return blot_error::Error.invalid_artifact;}}else if kind==blot_parse_ast::usagekind_concurrent {if node.c!=0 || !blot_check_task_types::concurrentHost(self_.m.types,node.a) {return blot_error::Error.invalid_artifact;}}else if node.c!=0 || (kind!=blot_parse_ast::usagekind_unique && kind!=blot_parse_ast::usagekind_shared && kind!=blot_parse_ast::usagekind_once && kind!=blot_parse_ast::usagekind_many && kind!=blot_parse_ast::usagekind_cleanup) {return blot_error::Error.invalid_artifact;}return self_.data(node.a,depth+1);},
