recursive fn expressionOperation(self_:Builder&,source:u32,ty:u32,depth:i64,operation:u32)->u32,Error {let checked .= self_.source.checked;if operation>checked.operation_uses.len {return 0,blot_error::Error.core_limit;}let use=checked.operation_uses[operation-1];if use.template==0 || use.template>=checked.effect_templates.len {return 0,blot_error::Error.core_limit;}let catalog=self_.tables.operation_values.len as u32;let arguments,error=self_.projectedTypeList(use.arguments);if error!=blot_error::Error.none {return 0,error;}let signature,error=self_.projectType(use.signature,0);if error!=blot_error::Error.none {return 0,error;}let instance,error=self_.projectInstance(use.instance,0);if error!=blot_error::Error.none {return 0,error;}var capability:u32=0;if use.capability_binding!=0 {let capability_type,error=self_.projectType(checked.bindings[use.capability_binding].ty,0);if error!=blot_error::Error.none {return 0,error;}let reference,error=self_.projectedReference(source,use.capability_binding,capability_type,use.node);if error!=blot_error::Error.none {return 0,error;}capability=reference;}else if use.capability!=0 {let value,error=self_.expression(use.capability,depth+1);if error!=blot_error::Error.none {return 0,error;}capability=value;}self_.tables.operation_values.push(blot_check_core::OperationValue{identity:checked.effect_templates[use.template].identity,arguments:arguments,signature:signature,instance:instance,capability:capability, ..});var operation_type=signature;if use.call==blot_check_check::OperationUse_call.value {operation_type=ty;}let operation_node,error=self_.make(source,blot_check_core::Node{tag:blot_check_core::Tag.operation_value,ty:operation_type,a:catalog, ..});if error!=blot_error::Error.none {return 0,error;}if use.call==blot_check_check::OperationUse_call.value {return operation_node,blot_error::Error.none;}var prefix=WordBuffer{..};let result,error=operationCall(self_,source,ty,depth,catalog,operation_node,use,prefix);blot_check_core_build