struct AbsentHeaders {count:i64=0,slots:dictionary_slot<HeaderKey,bool>[:]=default<dictionary_slot<HeaderKey,bool>[:]>()}
reusable[] var absentheaders_slots:dictionary_slot<HeaderKey,bool>[>..];
