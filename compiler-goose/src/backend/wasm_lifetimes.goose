let OP_br=blot_backend_runtime_ir::OP_br;
let OP_br_if=blot_backend_runtime_ir::OP_br_if;
let OP_return_=blot_backend_runtime_ir::OP_return_;
let OP_unreachable_=blot_backend_runtime_ir::OP_unreachable_;
let OP_drop=blot_backend_runtime_ir::OP_drop;
recursive fn scan(self_:Analysis&,module:const Module&,function:const Function&,summaries:const Summaries&)->Error {let instructions=blot_backend_wasm::instructions(module,function);for inst,index in instructions {self_.at=index as u32;let error=scanInstruction(self_,module,function,summaries,instructions,inst,index);if error!=blot_error::Error.none {return error;}if !self_.valid {return blot_error::Error.none;}}if function.result!=blot_backend_runtime_ir::VT_none {if self_.stack.len!=0 {let error=self_.recordResult(self_.pop());if error!=blot_error::Error.none {return error;}}else if self_.result_owner==0 {self_.result_owner=absent;}}if self_.controls.len!=0 {self_.valid=false;}if self_.valid {return self_.validateReferences();}return blot_error::Error.none;}
fn scanInstruction(self_:Analysis&,module:const Module&,function:const Function&,summaries:const Summaries&,instructions:const Instruction[:],inst:Instruction,index:i64)->Error {match inst.op {
 OP_ownership=>{let scope=blot_backend_runtime_ir::ownership(inst.operand);if scope.kind!=blot_backend_runtime_ir::OWN_scope {return blot_error::Error.none;}match scope.chunk {2,5,6=>{return self_.escape(self_.locals[scope.roles]);},3=>{let error=self_.escape(self_.locals[scope.roles]);if error!=blot_error::Error.none {return error;}self_.locals[scope.roles]=Value{..};},4=>{let error=self_.use(self_.locals[scope.roles&8191]);if error!=blot_error::Error.none {return error;}return self_.escape(self_.locals[scope.roles>>13]);},_=>{},}},
 OP_i32_const=>{var value=Value{..};if !inst.table_reference {value.constant=blot_support::some(inst.operand);}return self_.push(value);},OP_f32_const,OP_global_get,OP_memory_size,OP_host_ref_null,OP_host_ref_size=>{return self_.push(Value{..});},
 OP_local_get=>{var value=self_.locals[inst.operand];if !self_.dominates(value.scope) {let error=self_.escape(value);if error!=blot_error::Error.none {return error;}value.constant=blot_support::none<u32>();}if value.region!=self_.region {value.constant=blot_support::none<u32>();}if value.owner==0 && !value.constant.present && inst.operand>=function.parameters.len {self_.read_unset[inst.operand]=true;}let error=self_.use(value);if error!=blot_error::Error.none {return error;}return self_.push(value);},
 OP_local_set,OP_local_tee=>{var value=self_.pop();let error=self_.use(value);if error!=blot_error::Error.none {return error;}if self_.writes[inst.operand]!=1 || self_.read_unset[inst.operand] {let error=self_.escape(value);if error!=blot_error::Error.none {return error;}let error=self_.escape(self_.locals[inst.operand]);if error!=blot_error::Error.none {return error;}value.constant=blot_support::none<u32>();value.owner=0;}value.region=self_.region;value.scope=0;if self_.controls.len!=0 {value.scope=self_.controls.items[self_.controls.len-1].identity;}self_.locals[inst.operand]=value;if value.owner!=0 && value.offset==0 {let owner .= self_.allocations.items[value.owner-1];if owner.local==absent {owner.local=inst.operand;}}if inst.op==OP_local_tee {return self_.push(value);}},
 OP_i32_add=>{return scanAdd(self_);},OP_i32_mul=>{let right=self_.pop();let left=self_.pop();let error=self_.escape(left);if error!=blot_error::Error.none {return error;}let error=self_.escape(right);if error!=blot_error::Error.none {return error;}var value=Value{..};if left.constant.present && right.constant.present {value.constant=blot_support::some((left.constant.value as u64*right.constant.value as u64) as! u32);}return self_.push(value);},
 OP_i32_load,OP_f32_load,OP_v128_load=>{return scanLoad(self_,inst,instructions);},OP_i32_store,OP_f32_store,OP_v128_store=>{return scanStore(self_,inst,index,instructions,summaries);},OP_memory_copy,OP_memory_fill=>{return scanCopy(self_,inst);},
 OP_call=>{return scanCall(self_,module,function,summaries,inst,index);},OP_call_indirect=>{let error=self_.escape(self_.pop());if error!=blot_error::Error.none {return error;}let signature=blot_backend_runtime_ir::call(module,inst);return self_.opaqueCall(signature.parameters.len,signature.result);},OP_call_import=>{let signature=blot_backend_runtime_ir::call(module,inst);return self_.opaqueCall(signature.parameters.len,signature.result);},
 OP_block,OP_loop,OP_if_=>{self_.segment+=1;if inst.op==OP_if_ {let error=self_.escape(self_.pop());if error!=blot_error::Error.none {return error;}}return self_.controls.push(Control{height:self_.stack.len,result:inst.operand!=0 && inst.operand!=blot_backend_runtime_ir::VT_none as u32,identity:self_.at+1,..});},
 OP_else_=>{self_.segment+=1;if self_.controls.len==0 {self_.valid=false;return blot_error::Error.none;}let error=self_.closeArm();if error!=blot_error::Error.none {return error;}self_.controls.items[self_.controls.len-1].identity=self_.at+1;},OP_end=>{self_.segment+=1;if self_.controls.len==0 {self_.valid=false;return blot_error::Error.none;}let error=self_.closeArm();if error!=blot_error::Error.none {return error;}let control=self_.controls.pop();if control.result {return self_.push(Value{..});}},
 OP_br,OP_br_if=>{self_.segment+=1;if inst.op==OP_br_if {let error=self_.escape(self_.pop());if error!=blot_error::Error.none {return error;}}for value in self_.stack.items {let error=self_.escape(value);if error!=blot_error::Error.none {return error;}}if inst.op==OP_br {return self_.dead();}},
 OP_return_=>{self_.segment+=1;if function.result!=blot_backend_runtime_ir::VT_none {let error=self_.recordResult(self_.pop());if error!=blot_error::Error.none {return error;}}return self_.dead();},OP_unreachable_=>{self_.segment+=1;return self_.dead();},OP_drop=>{return self_.use(self_.pop());},
 _=>{let contract=blot_backend_runtime_ir::contract(module,function,inst);for argument in 0..contract.arity {let error=self_.escape(self_.pop());if error!=blot_error::Error.none {return error;}}if contract.result!=blot_backend_runtime_ir::VT_none {return self_.push(Value{..});}},
 }return blot_error::Error.none;}
fn scanAdd(self_:Analysis&)->Error {var right=self_.pop();var left=self_.pop();if left.constant.present {let swap=left;left=right;right=swap;}let error=self_.use(left);if error!=blot_error::Error.none {return error;}let error=self_.use(right);if error!=blot_error::Error.none {return error;}if right.constant.present {let offset=right.constant.value;if left.constant.present {return self_.push(Value{constant:blot_support::some((left.constant.value as u64+offset as u64) as! u32),..});}if offset<=0xffffffff-left.offset {left.offset+=offset;return self_.push(left);}let error=self_.escape(left);if error!=blot_error::Error.none {return error;}return self_.push(Value{..});}let error=self_.escape(left);if error!=blot_error::Error.none {return error;}let error=self_.escape(right);if error!=blot_error::Error.none {return error;}var owner:u32=0;if right.owner==0 {owner=left.owner;}return self_.push(Value{owner:owner,offset:absent,..});}
fn scanLoad(self_:Analysis&,inst:Instruction,instructions:const Instruction[:])->Error {let address=self_.pop();var reference=blot_support::none<u32>();if inst.op==OP_i32_load {reference=self_.field(address,inst.operand);}var id:u32=absent;if reference.present {id=reference.value;}let error=self_.memory(address,inst.operand,blot_support::some(blot_backend_runtime_ir::fixed(inst.op).bytes as u32),AccessKind.read,id);if error!=blot_error::Error.none {return error;}if inst.op==OP_i32_load && !reference.present && address.owner!=0 {let parent=self_.allocations.items[address.owner-1];var offset:u32=absent;if inst.operand<=0xffffffff-address.offset {offset=address.offset+inst.operand;}var followed=false;if parent.rc_mask.present && blot_runtime_runtime_layout::referenceWord(parent.rc_mask.value,offset/4) {followed=true;}if parent.annotations!=absent && blot_backend_runtime_ir::wordRole(instructions[parent.annotations..parent.annotations+parent.annotation_count],offset/4)!=blot_backend_runtime_ir::ROLE_scalar {followed=true;}if followed {let error=self_.escape(address);if error!=blot_error::Error.none {return error;}}}if reference.present {return self_.push(self_.references.items[reference.value].child);}return self_.push(Value{..});}
fn scanStore(self_:Analysis&,inst:Instruction,index:i64,instructions:const Instruction[:],summaries:const Summaries&)->Error {let value=self_.pop();let address=self_.pop();let bytes=blot_backend_runtime_ir::fixed(inst.op).bytes as u32;let error=self_.memory(address,inst.operand,blot_support::some(bytes),AccessKind.write,absent);if error!=blot_error::Error.none {return error;}let scalar_store=blot_backend_runtime_ir::hasScalarStore(instructions,index);let checked_scalar=scalar_store && value.owner==0 && self_.scalarStoreAddress(address,inst.operand,bytes,instructions);if scalar_store && !checked_scalar {self_.rc_valid=false;}if !checked_scalar {if address.owner==0 {self_.rc_valid=false;}else if inst.op==OP_v128_store {let mask=self_.allocations.items[address.owner-1].rc_mask;if !mask.present || mask.value!=0 {self_.rc_valid=false;}}else if !self_.scalarSlot(address,inst.operand,instructions) {var kind=RcWriteKind.word;if inst.op==OP_f32_store {kind=RcWriteKind.float_word;}let error=self_.rc_writes.push(RcWrite{at:self_.at,owner:address.owner,kind:kind,..});if error!=blot_error::Error.none {return error;}}}if inst.op==OP_i32_store {return self_.storeReference(address,inst.operand,value,instructions,summaries);}return self_.escape(value);}
fn scanCopy(self_:Analysis&,inst:Instruction)->Error {let bytes=self_.pop();let source=self_.pop();let error=self_.escape(bytes);if error!=blot_error::Error.none {return error;}if inst.op==OP_memory_copy {let error=self_.memory(source,0,bytes.constant,AccessKind.read,absent);if error!=blot_error::Error.none {return error;}}else {let error=self_.escape(source);if error!=blot_error::Error.none {return error;}}let target=self_.pop();if inst.op==OP_memory_copy && target.owner!=0 {let error=self_.rc_writes.push(RcWrite{at:self_.at,owner:target.owner,kind:RcWriteKind.copy,..});if error!=blot_error::Error.none {return error;}}else {var fresh_clear=false;if inst.op==OP_memory_fill && target.owner!=0 && source.constant.present && source.constant.value==0 && target.offset==0 && bytes.constant.present {let owner=self_.allocations.items[target.owner-1];fresh_clear=bytes.constant.value==owner.size && owner.accesses==absent && !owner.escaped;}if !fresh_clear {self_.rc_valid=false;}}return self_.memory(target,0,bytes.constant,AccessKind.write,absent);}
fn scanCall(self_:Analysis&,module:const Module&,function:const Function&,summaries:const Summaries&,inst:Instruction,index:i64)->Error {let callee=blot_backend_runtime_ir::call(module,inst);if callee.ownership==blot_backend_runtime_ir::CALL_allocate || callee.ownership==blot_backend_runtime_ir::CALL_allocate_scalar || callee.ownership==blot_backend_runtime_ir::CALL_allocate_typed || callee.ownership==blot_backend_runtime_ir::CALL_allocate_shaped || callee.ownership==blot_backend_runtime_ir::CALL_allocate_cohort || callee.ownership==blot_backend_runtime_ir::CALL_allocate_region {return scanAllocationCall(self_,module,function,callee,inst,index);}if callee.ownership==blot_backend_runtime_ir::CALL_borrow_region {let offset=self_.pop();let error=self_.escape(self_.pop());if error!=blot_error::Error.none {return error;}var bytes=blot_support::none<u32>();for member in module.regions.value.plan.members {if offset.constant.present && offset.constant.value==member.offset {bytes=blot_support::some(member.bytes);}}if bytes.present {let error=self_.allocation(bytes.value);if error!=blot_error::Error.none {return error;}let view .= self_.allocations.items[self_.allocations.len-1];view.parameter=true;view.escaped=true;view.rc_mask=blot_support::some(0 as u32);}else {self_.rc_valid=false;return self_.push(Value{..});}return blot_error::Error.none;}let summary,error=summaries.get(inst.operand);if error!=blot_error::Error.none {return error;}for argument in 0..callee.parameters.len {let parameter=summary.parameters[callee.parameters.len-1-argument];let value=self_.pop();var error=blot_error::Error.none;if parameter.escapes || summary.invalidates {error=self_.escape(value);}else {error=self_.memory(value,0,blot_support::some(parameter.bytes),AccessKind.read,absent);}if error!=blot_error::Error.none {return error;}}if summary.owned_result_bytes.present {let error=self_.allocation(summary.owned_result_bytes.value);if error!=blot_error::Error.none {return error;}}else if callee.result