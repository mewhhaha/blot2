fn Engine::scopeFootprint(self:Engine&,root:u32,depth:i64)->bool,blot_error::Error {var remaining:i64=65536;return self.scopeFootprintDepth(root,depth,remaining,[],FootprintBoundary{});}
fn Engine::identityFootprint(self:Engine&,identity:Identity,boundary:FootprintBoundary)->bool,blot_error::Error {if boundary.task_group!=0 {var destination=blot_support::none<i64>();for scope,index in self.scope_lifetimes {if self.types.head(scope,0)==self.types.head(boundary.task_group,0) {destination=blot_support::some(index);}}if !destination.present {return true,blot_error::Error.none;}for scope,index in self.scope_lifetimes {let capability=self.types.node(self.types.head(scope,0));if !blot_check_task_types::isRegion(self.types,self.types.head(scope,0)) {continue;}if capability.b==identity.unit && capability.c==identity.decl {return index>destination.value,blot_error::Error.none;}}return true,blot_error::Error.none;}if boundary.rank_scope!=0 && identity.unit!=0 {return false,blot_error::Error.none;}if boundary.loan!=0 {return false,blot_error::Error.none;}if identity.unit==0 && identity.decl!=0 && self.types.node(identity.decl).tag==blot_check_types::Tag.instance_selection {var remaining:i64=65536;return self.scopeFootprintDepth(identity.decl,0,remaining,[],boundary);}if boundary.storage_depth.present {if identity.unit==0 && identity.decl==0 {return false,blot_error::Error.none;}for capability in self.scope_lifetimes[..boundary.storage_depth.value] {let root,err=self.types.resolve(capability,0);if err!=blot_error::Error.none {return false,err;}let value=self.types.node(root);if value.tag==blot_check_types::Tag.scoped && value.b==identity.unit && value.c==identity.decl {return false,blot_error::Error.none;}}return true,blot_error::Error.none;}if boundary.rank_scope!=0 {return false,blot_error::Error.none;}if boundary.exiting.present {return boundary.exiting.value==identity,blot_error::Error.none;}return true,blot_error::Error.none;}
fn Engine::scopeFootprintDepth(self:Engine&,root:u32,depth:i64,remaining:i64&,inherited:const u32[:],boundary:FootprintBoundary)->bool,blot_error::Error {if depth>=128 || remaining==0 {let err=self.diagnostic(Code.capability_analysis_limit,self.owner);return true,err;}remaining-=1;if boundary.rank_scope!=0 {return blot_check_rank_walk::containsExcept(self.types,root,boundary.rank_scope,inherited,remaining);}let resolved,err=self.types.resolve(root,0);if err!=blot_error::Error.none {return false,err;}let value=self.types.node(resolved);match value.tag {
 blot_check_types::Tag.variable=>{return !inList(inherited,resolved),blot_error::Error.none;},
 blot_check_types::Tag.scoped=>{if boundary.capture_usage {return true,blot_error::Error.none;}if value.b==0 && self.types.node(value.c).tag==blot_check_types::Tag.instance_selection {return self.scopeFootprintDepth(value.c,depth+1,remaining,inherited,boundary);}return self.identityFootprint(Identity{value.b,value.c},boundary);},
