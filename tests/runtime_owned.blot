let region_unit: Unit -> Result[Unit,ReserveError] ! {reserve,release}
= fn () => return region@[Unit](0) as r (owner,free) in do:
  space.end(free)
  region.close(owner)
  break ()

type UnitPayload[r: Region] = Unit
let owned_unit:
  Unit -> Result[Unit,#Reserve(ReserveError) | #Body(#Cancelled)]
  ! {reserve,release}
= fn () => do:
  let built = owned@[UnitPayload[_],#Cancelled](0) as r free in do:
    seal(free,())
  case built:
    #Err(error) => return #Err(error)
    #Ok(handle) => do:
      let value = owned.open(handle) as r payload in do:
        break payload
      owned.close(handle)
      return #Ok(value)


pub let region_run: Unit -> U32 ! {reserve,release} resources {depth: 4, frame: 4096}
= fn () => do:
  case region_unit(()):
    #Ok(_) => return 1
    #Err(_) => return 0

pub let owned_run: Unit -> U32 ! {reserve,release} resources {depth: 4, frame: 4096}
= fn () => do:
  case owned_unit(()):
    #Ok(_) => return 1
    #Err(_) => return 0
