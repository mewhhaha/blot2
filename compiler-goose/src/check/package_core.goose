struct ScopeOwner {identity:blot_check_types::NominalIdentity,parent:const ScopeOwner?=null}
struct ControlOwner {node:u32,parent:const ControlOwner?=null}
struct DecisionOwner {callback:u32,ty:u32}
struct Walker {
 module:const Module&,origin:const Module?=null,resolver_callback:u32=0,context:Context,scopes:Views&,admission:Admission&,
 sealed:blot_check_package_contracts::Bits4096=blot_check_package_contracts::Bits4096{..},definitions:u32[4096]=[0;4096],definitions_indexed:bool=false,
