// Target composite ABI values; this does not extend the compiler's scalar ABI.
import { RenderFrame } from "engine/render"
import { DecodeError } from "engine/snapshot"
import { Bytes } from "std/bytes"
import { IoError } from "std/host"

type Viewport is data = Viewport { width: F32, height: F32 }
type InputEvent is data = InputEvent {
  kind: U32, key: U32, button: U32,
  pointer_x: F32, pointer_y: F32, wheel_delta: F32,
  picked: U32, pick_valid: U32, viewport: Viewport,
}
type FrameInput is data = FrameInput {
  seconds: F32, alpha: F32, viewport: Viewport,
}
type WindowIo is data = WindowIo {
  set_title: Text -> Result [Unit, IoError] ! {Foreign},
}
type RenderIo is data = RenderIo {
  submit: RenderFrame -> Result [Unit, IoError] ! {Foreign},
}
// One host-authorized save slot, not arbitrary filesystem access.
type FileIo is data = FileIo {
  read: Unit -> Result [Bytes, IoError] ! {Foreign},
  write: Bytes -> Result [Unit, IoError] ! {Foreign},
}
type Io is data = Io { window: WindowIo, render: RenderIo, files: FileIo }
type ApplicationError is data = HostError IoError | InvalidSnapshot DecodeError
type Application world is data = Application {
  create: Unit -> world,
  event: world -> (InputEvent -> Result [world, ApplicationError] ! {Foreign}),
  update: world -> FrameInput -> world,
  render: world -> (FrameInput -> Result [Unit, ApplicationError] ! {Foreign}),
}
