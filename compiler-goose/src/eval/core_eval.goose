fn appendConstraint(self: ClosureRegion&,original: Constraint) -> Error { var value=original; if value.use_node==0 { value.use_node=self.current_use; } value.origin=blot_support::none<SourceLocation>(); if !self.building_principal { value.origin=self.current_origin; } if value.diagnostic_name.len!=0 { let bytes=region_constraint_names.alloc_slice(value.diagnostic_name.len); for byte,index in value.diagnostic_name { bytes[index]=byte; } let first: const u8&=bytes[0]; self.scratch.constraint_names.push(ConstraintNameLease {region_constraint_names.index_of(first),bytes.len}); value.diagnostic_name=bytes; } let index=self.scratch.constraints.len; self.scratch.constraints.push(value); if self.building_principal { self.scratch.principal_actions.push(PrincipalAction.constraint {index as u32}); } return Error.none; }
