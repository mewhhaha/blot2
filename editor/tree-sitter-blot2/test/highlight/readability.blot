import { Vec3 } from "std/vector.blot"
//              ^ keyword.control.import

const from = func value => return value
//    ^ function
entry const normalized = func value => return from value / 6555.0
//                                            ^ variable

const and_then = func left => return func right => return if left then right () else false

const invoke = func callback => return callback ()
//    ^^^^^^ function

const same = func a => return func b => return if :a == :b then true else false
const project = .x
const choose = func value => return case value of
  $Some a | $Some a if a > 0 => a
  _ => 0
