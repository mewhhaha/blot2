fn Engine::parameterBinding(self:Engine&,name:u32,source:u32)->ParameterAnnotation,blot_error::Error {for prior in self.type_env.items {if prior.name==name {let err=self.diagnostic(Code.duplicate_type_parameter,source);if err!=blot_error::Error.none {return ParameterAnnotation{},err;}break;}}let ty,err=self.typeVariable(name,source);if err!=blot_error::Error.none {return ParameterAnnotation{},err;}let pattern,err=self.parameter_patterns.add(blot_check_parameter_patterns::Node{kind:blot_check_parameter_patterns::Kind.binding,a:ty});return ParameterAnnotation{ty,pattern},err;}
fn Engine::scalarArgumentPossible(self:Engine&,source:u32,allow_unit:bool,depth:i64)->bool,blot_error::Error {if depth>=1024 {return false,blot_error::Error.type_limit;}let node=self.tree.node(source);if node.tag==blot_parse_ast::tag_group {return self.scalarArgumentPossible(node.a,allow_unit,depth+1);}if node.tag==blot_parse_ast::tag_array {return false,blot_error::Error.none;}if node.tag==blot_parse_ast::tag_product {for child in self.tree.children(source) {let possible,err=self.scalarArgumentPossible(child,true,depth+1);if err!=blot_error::Error.none || !possible {return false,err;}}return true,blot_error::Error.none;}return self.possibleOperationType(source,allow_unit,depth+1);}
