import viewcall_parse; fn main(){
{let s="let get: forall [r: Region, n: Nat, d: Domain] => Fn[static, Many, (View[r,U32,n,d], U32, U32), U32] ! {read r} resources {depth: 1, frame: 0} = fn (v,i,j) => do:\n  if i < v.length:\n    return v[i]\n  else:\n    return 0\nlet get: forall [rr: Region, nn: Nat, dd: Domain] => Fn[static, Many, (View[rr,U32,nn,dd], U32, U32), U32] ! {read rr} resources {depth: 2, frame: 0} = fn (vv,ii,jj) => do:\n  return get@[rr,nn,dd](vv,ii,jj)\n";let _,status=viewcall_parse::parse(s);assert(status!=0);}
{let s="let get: forall [r: Region, n: Nat, d: Domain] => Fn[static, Many, (View[r,U32,n,d], U32, U32), U32] ! {read r} resources {depth: 1, frame: 0} = fn (v,i,j) => do:\n  if i < v.length:\n    return v[i]\n  else:\n    return 0\nlet relay: forall [get: Region, nn: Nat, dd: Domain] => Fn[static, Many, (View[get,U32,nn,dd], U32, U32), U32] ! {read get} resources {depth: 2, frame: 0} = fn (vv,ii,jj) => do:\n  return get@[get,nn,dd](vv,ii,jj)\n";let _,status=viewcall_parse::parse(s);assert(status!=0);}
{let s="let get: forall [r: Region, n: Nat, d: Domain] => Fn[static, Many, (View[r,U32,n,d], U32, U32), U32] ! {read r} resources {depth: 1, frame: 0} = fn (v,i,j) => do:\n  if i < v.length:\n    return v[i]\n  else:\n    return 0\nlet relay: forall [rr: Region, get: Nat, dd: Domain] => Fn[static, Many, (View[rr,U32,get,dd], U32, U32), U32] ! {read rr} resources {depth: 2, frame: 0} = fn (vv,ii,jj) => do:\n  return get@[rr,get,dd](vv,ii,jj)\n";let _,status=viewcall_parse::parse(s);assert(status!=0);}
{let s="let get: forall [r: Region, n: Nat, d: Domain] => Fn[static, Many, (View[r,U32,n,d], U32, U32), U32] ! {read r} resources {depth: 1, frame: 0} = fn (v,i,j) => do:\n  if i < v.length:\n    return v[i]\n  else:\n    return 0\nlet relay: forall [rr: Region, nn: Nat, get: Domain] => Fn[static, Many, (View[rr,U32,nn,get], U32, U32), U32] ! {read rr} resources {depth: 2, frame: 0} = fn (vv,ii,jj) => do:\n  return get@[rr,nn,get](vv,ii,jj)\n";let _,status=viewcall_parse::parse(s);assert(status!=0);}
{let s="let get: forall [r: Region, n: Nat, d: Domain] => Fn[static, Many, (View[r,U32,n,d], U32, U32), U32] ! {read r} resources {depth: 1, frame: 0} = fn (v,i,j) => do:\n  if i < v.length:\n    return v[i]\n  else:\n    return 0\nlet relay: forall [rr: Region, nn: Nat, dd: Domain] => Fn[static, Many, (View[rr,U32,nn,dd], U32, U32), U32] ! {read rr} resources {depth: 2, frame: 0} = fn (get,ii,jj) => do:\n  return get@[rr,nn,dd](get,ii,jj)\n";let _,status=viewcall_parse::parse(s);assert(status!=0);}
{let s="let get: forall [r: Region, n: Nat, d: Domain] => Fn[static, Many, (View[r,U32,n,d], U32, U32), U32] ! {read r} resources {depth: 1, frame: 0} = fn (v,i,j) => do:\n  if i < v.length:\n    return v[i]\n  else:\n    return 0\nlet relay: forall [rr: Region, nn: Nat, dd: Domain] => Fn[static, Many, (View[rr,U32,nn,dd], U32, U32), U32] ! {read rr} resources {depth: 2, frame: 0} = fn (vv,get,jj) => do:\n  return get@[rr,nn,dd](vv,get,jj)\n";let _,status=viewcall_parse::parse(s);assert(status!=0);}
{let s="let get: forall [r: Region, n: Nat, d: Domain] => Fn[static, Many, (View[r,U32,n,d], U32, U32), U32] ! {read r} resources {depth: 1, frame: 0} = fn (v,i,j) => do:\n  if i < v.length:\n    return v[i]\n  else:\n    return 0\nlet relay: forall [rr: Region, nn: Nat, dd: Domain] => Fn[static, Many, (View[rr,U32,nn,dd], U32, U32), U32] ! {read rr} resources {depth: 2, frame: 0} = fn (vv,ii,get) => do:\n  return get@[rr,nn,dd](vv,ii,get)\n";let _,status=viewcall_parse::parse(s);assert(status!=0);}
print("all seven lexical callee shadow cases rejected");}