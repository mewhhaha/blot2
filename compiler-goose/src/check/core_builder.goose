  for oi in 0..op_n {
   let tmpl_idx=op_nodes[oi*2];
   let field_or_slot=op_nodes[oi*2+1];
   let tmpl=checked.effect_templates[tmpl_idx];
   let op_sig,serr=self_.projectType(saved_types[arg_n+oi],0);
