        blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_local_get,walk.storage),blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_i32_const,8),blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_i32_add),blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_local_set,walk.top)]); if initialized != blot_error::Error.none { return initialized; }
    let storage = module.emit(function,blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_local_get,walk.storage)); if storage != blot_error::Error.none { return storage; } var bound: blot_error::Error;
    if size.present { bound = module.emit(function,blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_local_get,size.value)); } else { bound = module.emit(function,blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_i32_const,bytes)); } if bound != blot_error::Error.none { return bound; }
