fn packageWitnesses(module: const Module&) -> Error { var work=blot_check_usage_check::Work {..}; for node in module.nodes { let err=work.charge(1); if err != blot_error::Error.none { return blot_error::Error.invalid_artifact; } if node.tag != blot_check_core::Tag.package_pack { continue; } if node.b > module.types.extra.len || node.c > module.types.extra.len-node.b { return blot_error::Error.invalid_artifact; } for witness in module.types.list(blot_check_types::List {node.b,node.c, ..}) { let contains,err=blot_check_usage_check::containsNominalWork(module.types,module.nominals,witness,work); if err != blot_error::Error.none || contains { return blot_error::Error.invalid_artifact; } } } return blot_error::Error.none; }
fn physicallyCaptures(module: const Module&, root: u32, binding: u32, remaining: i64&) -> bool,Error { var walker=Walker {module:module,len:1,remaining:min(remaining,65536), ..}; let budget=walker.remaining; walker.states[0]=State {binding:binding, ..}; var found:bool[4096]=[false;4096]; let err=walker.capture(root,found,0); remaining-=budget-walker.remaining; return found[0],err; }
fn validate(module: const Module&) -> Error { let err=blot_check_closed_nominal_storage::validate(module); if err != blot_error::Error.none { return err; } for nominal in module.nominals { if (nominal.affine && !nominal.has_usage) || (nominal.has_usage && !module.has_usage_contracts) { return blot_error::Error.invalid_artifact; } } if !module.has_usage_contracts { return blot_error::Error.none; } for node in module.nodes { if node.ty >= module.types.nodes.len { return blot_error::Error.invalid_artifact; } }
    let err=nominalFacts(module); if err != blot_error::Error.none { return err; } let err=packageWitnesses(module); if err != blot_error::Error.none { return err; } let err=validateRegions(module); if err != blot_error::Error.none { return err; } let err=blot_check_cleanup_contracts::validate(module); if err != blot_error::Error.none { return err; } var walker=Walker {module:module, ..};
    for body in module.bodies { if body.root == 0 { continue; } walker.len=0; walker.snapshot_len=0; walker.remaining=65536; walker.ambient=0; walker.region_count=0; var header,err=walker.quantified(module.bindings[body.binding].ty); if err != blot_error::Error.none { return err; } for ignored in module.parameters[body.parameters.start..body.parameters.start+body.parameters.len] { if header.tag != blot_check_types::Tag.function { return blot_error::Error.invalid_artifact; } walker.ambient=header.c; header=module.types.node(header.b); } var required,err=relevant(module,body); if err != blot_error::Error.none { return err; } for parameter in module.parameters[body.parameters.start..body.parameters.start+body.parameters.len] { let err=walker.introduce(parameter.binding); if err != blot_error::Error.none { return err; } required=required || walker.len != 0; } if required { let flow,err=walker.expression(body.root,0); if err != blot_error::Error.none { return err; } }
    } return blot_error::Error.none;
}
