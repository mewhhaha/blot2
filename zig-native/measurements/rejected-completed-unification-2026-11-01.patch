+test "completed unification preserves historical record functions and reuses unchanged open children" {
+    var entries: [2]u64 = undefined;
+    for ([_]bool{ false, true }, 0..) |enabled, mode| {
+        var store = try Store.initWithOptions(std.testing.allocator, .{ .completed_unification = enabled, .resolution_cache = false });
+        defer store.deinit();
+        const leaf = try store.fresh();
+        const alias = try store.fresh();
+        const owner = try store.fresh();
+        try store.appendVersion(leaf, boolean);
+        try store.appendVersion(owner, try store.record(&.{.{ .name = 7, .ty = try store.function(leaf, alias) }}));
+        try store.appendVersion(leaf, alias);
+        try store.appendVersion(alias, u32_type);
+        try store.appendVersion(alias, f32_type);
+        const expected = try store.record(&.{.{ .name = 7, .ty = try store.function(u32_type, u32_type) }});
+        try store.unify(owner, expected);
+        const resolved = store.node(try store.resolve(owner, 0));
+        try std.testing.expectEqual(Tag.record, resolved.tag);
+        const field = store.recordField(resolved, 0);
+        try std.testing.expectEqual(@as(u32, 7), field.name);
+        const signature = store.node(field.ty);
+        try std.testing.expectEqual(Tag.function, signature.tag);
+        try std.testing.expectEqual(u32_type, signature.a);
+        try std.testing.expectEqual(u32_type, signature.b);
+        // The direct leaf still sees its earlier write, unlike owner's view.
+        try std.testing.expectEqual(boolean, try store.resolve(leaf, 0));
+        const wrong = try store.record(&.{.{ .name = 7, .ty = try store.function(u32_type, f32_type) }});
+        const point = store.mark();
+        try std.testing.expectError(error.TypeMismatch, store.unify(owner, wrong));
+        try std.testing.expectEqualDeep(point, store.mark());
+
+        const open = try store.fresh();
+        const left_child = try store.function(open, open);
+        const right_child = try store.function(open, open);
+        const left = try store.product(&.{ left_child, left_child, left_child });
+        const right = try store.product(&.{ right_child, right_child, right_child });
+        const before_entries = store.normalization.unify_resolve_entries;
+        const before_reused = store.normalization.unify_completed_pairs;
+        try store.unify(left, right);
+        entries[mode] = store.normalization.unify_resolve_entries - before_entries;
+        if (enabled) {
+            try std.testing.expect(store.normalization.unify_completed_pairs > before_reused);
+        } else {
+            try std.testing.expectEqual(before_reused, store.normalization.unify_completed_pairs);
+        }
+        try std.testing.expectEqual(Tag.variable, store.node(try store.resolve(open, 0)).tag);
+    }
+    try std.testing.expect(entries[1] < entries[0]);
+}
+
+test "completed unification invalidates queued children after type and latent row writes" {
+    for ([_]bool{ false, true }) |enabled| {
+        var store = try Store.initWithOptions(std.testing.allocator, .{ .completed_unification = enabled });
+        defer store.deinit();
+        const x = try store.fresh();
+        const left = try store.function(x, x);
+        const right = try store.function(u32_type, f32_type);
+        const point = store.mark();
+        try std.testing.expectError(error.TypeMismatch, store.unify(left, right));
+        try std.testing.expectEqualDeep(point, store.mark());
+        try std.testing.expectEqual(x, try store.resolve(x, 0));
+        const y = try store.fresh();
+        const recursive = try store.function(y, try store.array(y));
+        const occurs_point = store.mark();
+        try std.testing.expectError(error.InfiniteType, store.unify(left, recursive));
+        try std.testing.expectEqualDeep(occurs_point, store.mark());
+        try std.testing.expectEqual(y, try store.resolve(y, 0));
+        // A solved first callback changes the row visible in the queued second
+        // callback, even though neither callback writes a type variable.
+        const row = try store.freshEffects();
+        const callback = try store.functionWithEffects(unit, u32_type, row);
+        const impure = try store.functionWithEffects(unit, u32_type, try store.effects.row(&.{foreign_operation}, .closed));
+        const pure = try store.function(unit, u32_type);
+        const callbacks = try store.product(&.{ callback, callback });
+        const incompatible = try store.product(&.{ impure, pure });
+        const row_point = store.mark();
+        const cursor = store.cursor();
+        try std.testing.expectError(error.EffectMismatch, store.unify(callbacks, incompatible));
+        try std.testing.expectEqualDeep(row_point, store.mark());
+        try std.testing.expectEqual(cursor, store.cursor());
+        try std.testing.expectEqual(Effects.Tail.variable, std.meta.activeTag(store.row(try store.resolveEffects(row, 0)).tail));
+        const compatible = try store.product(&.{ impure, impure });
+        const type_epoch = store.mutation_epoch;
+        const effect_epoch = store.effects.mutation_epoch;
+        const resolve_calls = store.normalization.unify_resolve_calls;
+        try store.unify(callbacks, compatible);
+        try std.testing.expectEqual(type_epoch, store.mutation_epoch);
+        try std.testing.expect(store.effects.mutation_epoch > effect_epoch);
+        // Parent preparation and the stale second callback must both resolve.
+        // The row write alone revokes the latter's completed parent receipt.
+        try std.testing.expect(store.normalization.unify_resolve_calls - resolve_calls >= 4);
+        const result = store.node(try store.resolve(callbacks, 0));
+        for (store.list(.{ .start = result.a, .len = result.b })) |child| {
+            const signature = store.node(child);
+            try std.testing.expectEqualSlices(Effects.Label, &.{foreign_operation}, store.rowLabels(signature.c));
+            try std.testing.expectEqual(Effects.Tail.closed, std.meta.activeTag(store.row(signature.c).tail));
+        }
+    }
+}
+
+fn completedUnificationFailureLaw(allocator: std.mem.Allocator) !void {
+    // This law is called only by the allocation-failure runner, which supplies
+    // a FailingAllocator. Disable its one injected fault for transaction retry.
+    const failing: *std.testing.FailingAllocator = @ptrCast(@alignCast(allocator.ptr));
+    var store = try Store.init(allocator);
+    defer store.deinit();
+    const x = try store.fresh();
+    var open: [40]Id = undefined;
+    var closed: [40]Id = undefined;
+    @memset(&open, x);
+    @memset(&closed, u32_type);
+    const left = try store.function(x, try store.product(&open));
+    const right = try store.function(u32_type, try store.product(&closed));
+    const point = store.mark();
+    store.unify(left, right) catch |err| {
+        try std.testing.expectEqualDeep(point, store.mark());
+        try std.testing.expectEqual(Tag.variable, store.node(x).tag);
+        const fail_index = failing.fail_index;
+        failing.fail_index = std.math.maxInt(usize);
+        defer failing.fail_index = fail_index;
+        try store.unify(left, right);
+        try std.testing.expectEqual(u32_type, try store.resolve(x, 0));
+        return err;
+    };
+    try std.testing.expectEqual(u32_type, try store.resolve(x, 0));
+}
+
+test "completed unification rolls back every allocation failure and permits retry" {
+    try @import("../allocation_failures.zig").checkAllAllocationFailures(std.testing.allocator, completedUnificationFailureLaw, .{});
+}
+
+test "completed unification preserves warm parent cold child depth failures" {
+    for ([_]bool{ false, true }) |enabled| {
+        for ([_]usize{ 2, 1024 }) |height| {
+            var store = try Store.initWithOptions(std.testing.allocator, .{ .completed_unification = enabled, .composite_cache = false });
+            defer store.deinit();
+            const leaf = try store.fresh();
+            var child = leaf;
+            for (0..height) |_| child = try store.array(child);
+            const left = try store.product(&.{child});
+            const right = try store.product(&.{child});
+            try store.appendVersion(leaf, u32_type);
+            store.resolution_depth_limit = 2048;
+            if (height == 2) store.resolution_depth_limit = 1024;
+            _ = try store.resolve(left, 0);
+            _ = try store.resolve(right, 0);
+            store.resolution_depth_limit = height;
+            // Root-query hits retain their original limit history. Their
+            // uncached children must still undergo the ordinary depth check.
+            _ = try store.resolve(left, 0);
+            _ = try store.resolve(right, 0);
+            const point = store.mark();
+            const reused = store.normalization.unify_completed_pairs;
+            try std.testing.expectError(error.TypeLimit, store.unify(left, right));
+            try std.testing.expectEqualDeep(point, store.mark());
+            try std.testing.expectEqual(reused, store.normalization.unify_completed_pairs);
+        }
+    }
+}
