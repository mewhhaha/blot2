{
  "tasks": {
    "build:compiler": "deno run --allow-read --allow-write --allow-run=zig scripts/build_compiler.ts",
    "build:compiler:dev": "deno run --allow-read --allow-write --allow-run=zig scripts/build_compiler.ts --dev",
    "blot": "deno run --allow-read --allow-write --allow-run --allow-env=HOME,XDG_CACHE_HOME,BPM_CACHE_DIR compiler/cli.ts",
    "bpm": "deno run --allow-read --allow-write --allow-run=git --allow-env=HOME,XDG_CACHE_HOME,BPM_CACHE_DIR compiler/bpm.ts",
    "test:bpm": "deno test --allow-read --allow-write --allow-run compiler/packages.test.ts compiler/cli_packages.test.ts compiler/bpm.test.ts -- zig-native/zig-out/bin/blotc",
    "generate:parser": "deno run --allow-read=. --allow-write=generated scripts/generate_parser.ts",
    "generate": "deno task generate:parser",
    "generate:editor": "cd editor/tree-sitter-blot2 && tree-sitter generate --abi 14 --js-runtime native",
    "check:editor": "deno task generate:editor && cd editor/tree-sitter-blot2 && XDG_CACHE_HOME=\"$PWD/.cache\" tree-sitter test --config-path cli-config.json && XDG_CACHE_HOME=\"$PWD/.cache\" tree-sitter parse --config-path cli-config.json --grammar-path . --quiet ../../examples/syntax.blot ../../examples/ecs.blot ../../examples/host_capabilities.blot ../../examples/host_io.blot",
    "helix:install": "deno task check:editor && deno task test:editor && deno run --allow-env=HOME,XDG_CONFIG_HOME --allow-read --allow-write --allow-run=tree-sitter,hx scripts/setup_helix.ts",
    "bench:compile": "deno run --allow-all scripts/bench_compile.ts",
    "profile:compile": "deno run --allow-all scripts/bench/profile_compile.ts",
    "test:editor": "deno test --allow-read=editor scripts/helix_languages.test.ts",
    "test:native": "cd zig-native && zig build test -Doptimize=safe",
    "test:guest": "deno run --allow-read --allow-write --allow-run --allow-env scripts/test_compiler.ts --guest",
    "test:zig-project": "deno test --allow-read --allow-write --allow-run --allow-env=BLOT_CLIENT_TEST_AMBIENT zig-native/tests/zig_project_transport.test.ts zig-native/tests/zig_project_client.test.ts -- zig-native/zig-out/bin/blotc",
    "test:compiler": "deno run --allow-read --allow-write --allow-run --allow-env scripts/test_compiler.ts",
    "test:compiler:dev": "deno run --allow-read --allow-write --allow-run --allow-env scripts/test_compiler.ts --dev",
    "test:compiler:stress": "deno task build:compiler && deno test --allow-read --allow-write --allow-run zig-native/tests/stage_chain_budget.stress.ts -- zig-native/zig-out/bin/blotc",
    "test:compiler:tasks": "deno test --allow-read --allow-write --allow-run --allow-env scripts/test_compiler.test.ts scripts/bench_compile.test.ts scripts/compiler_gate_state.test.ts scripts/compiler_fingerprint.test.ts scripts/compiler_fixtures.test.ts scripts/build_compiler.test.ts scripts/native_test_runner.test.ts scripts/lint_zig.test.ts",
    "test": "deno task test:editor && deno task test:compiler",
    "check": "deno fmt --check mod.ts deno.json compiler scripts .github && deno check mod.ts compiler/cli.ts compiler/installed_cli.ts scripts/*.ts && deno task lint:zig && deno task test",
    "lint:zig": "deno run --allow-env=ZIG_ANALYZER --allow-read --allow-write --allow-run scripts/lint_zig.ts",
    "package:pack": "deno run --allow-read --allow-write=generated/compiler scripts/pack_native.ts",
    "package:build": "deno task build:compiler && deno task package:pack",
    "package:check": "deno task package:build && deno publish --dry-run --allow-dirty",
    "lint:zig:dev": "deno run --allow-env=ZIG_ANALYZER --allow-read --allow-write --allow-run scripts/lint_zig.ts --changed",
    "test:native:inventory": "deno run --allow-env=ZIG --allow-read --allow-write --allow-run scripts/native_test_inventory.ts"
  },
  "imports": {
    "@mewhhaha/baba": "npm:@jsr/mewhhaha__baba@9.0.1"
  },
  "fmt": {
    "exclude": [
      "generated",
      "editor/tree-sitter-blot2/src",
      "build",
      "zig-native",
      ".zig-cache"
    ]
  },
  "name": "@mewhhaha/blot",
  "version": "0.2.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./compiler/installed_cli.ts",
    "./bpm": "./compiler/bpm.ts",
    "./packages": "./compiler/packages.ts",
    "./guest": "./compiler/guest.ts",
    "./zig-project": "./compiler/zig_project_client.ts",
    "./format": "./compiler/format.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "mod.ts",
      "compiler/cli.ts",
      "compiler/guest.ts",
      "compiler/cleanup_data.ts",
      "compiler/resource_journal.ts",
      "compiler/task_runtime.ts",
      "compiler/task_guest.ts",
      "compiler/guide.md",
      "compiler/installed_cli.ts",
      "compiler/bpm.ts",
      "compiler/packages.ts",
      "compiler/packages.md",
      "compiler/packaged_native.ts",
      "compiler/zig_project_client.ts",
      "compiler/editor_completion.ts",
      "compiler/lsp.ts",
      "compiler/lsp_protocol.ts",
      "compiler/type_diagnostics.ts",
      "compiler/assets.ts",
      "compiler/native_assets.ts",
      "compiler/format.ts",
      "compiler/syntax.ts",
      "compiler/postfix_syntax.ts",
      "compiler/parser_source.ts",
      "compiler/numeric_parser.ts",
      "generated/compiler/blotc.gz",
      "generated/wasm/cst-schema.json",
      "generated/wasm/mod.ts",
      "generated/wasm/parser.plan",
      "generated/wasm/parser.wasm",
      "generated/wasm/syntax.ts",
      "std/*.blot",
      "blot-workspace.yaml"
    ]
  }
}
