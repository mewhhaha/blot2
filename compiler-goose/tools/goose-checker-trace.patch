+// Explicit low-frequency progress; never formats type graphs or reads a clock
+// in a query. The clock belongs only to coarse named root boundaries.
+enum class CheckerEngine { TypeEq, Reached, Reaches, Candidates, Shrink, Flow, Array, Count };
+struct CheckerTrace {
+    bool enabled = [] { auto value = getenv("GOOSE_CHECKER_TRACE"); return value && *value; }();
+    const char *stage = "none";
+    string_view root = "-", body = "-";
+    const void *spec = nullptr;
+    array<uint64_t, (size_t)CheckerEngine::Count> calls {};
+    bool Tick(CheckerEngine engine) {
+        if (!enabled) return false;
+        auto i = (size_t)engine;
+        unsigned shift = 14;
+        if (engine == CheckerEngine::TypeEq) shift = 20;
+        if (engine == CheckerEngine::Candidates || engine == CheckerEngine::Shrink ||
+            engine == CheckerEngine::Flow) shift = 12;
+        return (++calls[i] & ((UINT64_C(1) << shift) - 1)) == 0;
+    }
+    void Report(const char *event, const char *engine = "-", int64_t ns = 0) const {
+        if (!enabled) return;
+        fprintf(stderr, "GOOSE_CHECKER_TRACE event=%s stage=%s root=%.*s body=%.*s spec=%p engine=%s ns=%lld type_eq=%llu reached=%llu reaches=%llu candidates=%llu shrink=%llu flow=%llu array=%llu\n",
+                event, stage, (int)root.size(), root.data(), (int)body.size(), body.data(), spec,
+                engine, (long long)ns, (unsigned long long)calls[0], (unsigned long long)calls[1],
+                (unsigned long long)calls[2], (unsigned long long)calls[3],
+                (unsigned long long)calls[4], (unsigned long long)calls[5],
+                (unsigned long long)calls[6]);
+    }
+};
+struct CheckerTraceRoot {
+    CheckerTrace &trace;
+    const char *stage;
+    string_view root;
+    chrono::steady_clock::time_point from;
+    CheckerTraceRoot(CheckerTrace &t, const char *s, string_view name)
+        : trace(t), stage(t.stage), root(t.root) {
+        if (!trace.enabled) return;
+        trace.stage = s; trace.root = name;
+        from = chrono::steady_clock::now();
+        trace.Report("begin");
+    }
+    ~CheckerTraceRoot() {
+        if (!trace.enabled) return;
+        auto ns = chrono::duration_cast<chrono::nanoseconds>(chrono::steady_clock::now() - from).count();
+        trace.Report("end", "-", ns);
+        trace.stage = stage; trace.root = root;
+    }
+};
+struct CheckerTraceBody {
+    CheckerTrace &trace;
+    string_view body;
+    const void *spec;
+    CheckerTraceBody(CheckerTrace &t, string_view name, const void *s)
+        : trace(t), body(t.body), spec(t.spec) {
+        if (trace.enabled) { trace.body = name; trace.spec = s; }
+    }
+    ~CheckerTraceBody() { if (trace.enabled) { trace.body = body; trace.spec = spec; } }
+};
+
 struct CheckerRootProfile {
