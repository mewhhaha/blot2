fn emitRcBody(module:const Module&,function:const Function&,plan:const RcPlan&,locals:MachineTypes&,code:Code&)->Error {let error=locals.append(module.locals(function));if error!=blot_error::Error.none {return error;}let original=blot_backend_wasm::instructions(module,function);let error=code.ensure(original.len+plan.allocations.len+7*plan.writes.len);if error!=blot_error::Error.none {return error;}let scratch=(function.parameters.len+locals.len) as u32;let error=locals.append([blot_backend_runtime_ir::VT_i32,blot_backend_runtime_ir::VT_i32,blot_backend_runtime_ir::VT_i32]);if error!=blot_error::Error.none {return error;}var allocation:i64=0;var write:i64=0;for inst,at in original {if allocation<plan.allocations.len && plan.allocations.items[allocation].at==at {let error=code.append([I(OP_i32_const,plan.allocations.items[allocation].mask),Instruction{operand:module.arena.value.allocate_typed,op:OP_call,origin:inst.origin,..}]);if error!=blot_error::Error.none {return error;}allocation+=1;}else if write<plan.writes.len && plan.writes.items[write].at==at {let site=plan.writes.items[write];if site.kind==RcWriteKind.word || site.kind==RcWriteKind.float_word {if site.kind==RcWriteKind.float_word {let error=code.push(I(blot_backend_runtime_ir::OP_i32_reinterpret_f32));if error!=blot_error::Error.none {return error;}}let error=code.append([I(OP_local_set,scratch),I(OP_local_set,scratch+1),I(OP_local_get,site.local),I(OP_local_get,scratch+1),I(OP_i32_const,inst.operand),I(OP_i32_add),I(OP_local_get,scratch),Instruction{operand:module.arena.value.store_word,op:OP_call,origin:inst.origin,..}]);if error!=blot_error::Error.none {return error;}}else {let error=code.append([I(OP_local_set,scratch),I(OP_local_set,scratch+1),I(OP_local_set,scratch+2),I(OP_local_get,site.local),I(OP_local_get,scratch+2),I(OP_local_get,scratch+1),I(OP_local_get,scratch),Instruction{operand:module.arena.value.copy_words,op:OP_call,origin:inst.origin,..}]);if error!=blot_error::Error.none {return error