fn blot_work_counters::blotStructuralHash<StructuralSink>(value:blot_work_counters::Normalization,sink:StructuralSink&) {blot_structural::hashFields(sink,value);}
fn equal<StructuralLeft>(left:StructuralLeft,right:blot_work_counters::SchemeMembership)->bool {return equalFields(left,right);}
fn blot_work_counters::blotStructuralHash<StructuralSink>(value:blot_work_counters::SchemeMembership,sink:StructuralSink&) {blot_structural::hashFields(sink,value);}
fn equal<StructuralLeft>(left:StructuralLeft,right:blot_reuse_principal_interface::Kind)->bool {return left==right;}
fn blot_reuse_principal_interface::blotStructuralHash<StructuralSink>(value:blot_reuse_principal_interface::Kind,sink:StructuralSink&) {match value {global=>{blot_structural::hash(sink,0 as u8);},local=>{blot_structural::hash(sink,1 as u8);},parameter=>{blot_structural::hash(sink,2 as u8);},external=>{blot_structural::hash(sink,3 as u8);},}}
fn equal<StructuralLeft>(left:StructuralLeft,right:blot_reuse_principal_interface::ContractMemberKind)->bool {return left==right;}
fn blot_reuse_principal_interface::blotStructuralHash<StructuralSink>(value:blot_reuse_principal_interface::ContractMemberKind,sink:StructuralSink&) {match value {defined_type=>{blot_structural::hash(sink,0 as u8);},abstract_type=>{blot_structural::hash(sink,1 as u8);},value=>{blot_structural::hash(sink,2 as u8);},}}
fn equal<StructuralLeft>(left:StructuralLeft,right:blot_reuse_principal_interface::ImplementationMemberKind)->bool {return left==right;}
fn blot_reuse_principal_interface::blotStructuralHash<StructuralSink>(value:blot_reuse_principal_interface::ImplementationMemberKind,sink:StructuralSink&) {match value {type_=>{blot_structural::hash(sink,0 as u8);},value=>{blot_structural::hash(sink,1 as u8);},}}
fn equal<StructuralLeft>(left:StructuralLeft,right:blot_reuse_principal_interface::SelectedProofKind)->bool {return left==right;}
fn blot_reuse_principal_interface::blotStructuralHash<StructuralSink>(value:blot_reuse_principal_interface::SelectedProofKind,sink:StructuralSink&) {match value {implementation=>{blot_structural::hash(sink,0 as u8);},predicate=>{blot_structural::hash(sink,1 as u8);},}}
fn equal<StructuralLeft>(left:StructuralLeft,right:blot_backend_opaque_storage::Kind)->bool {return left==right;}
fn blot_backend_opaque_storage::blotStructuralHash<StructuralSink>(value:blot_backend_opaque_storage::Kind,sink:StructuralSink&) {match value {unknown=>{blot_structural::hash(sink,0 as u8);},unit=>{blot_structural::hash(sink,1 as u8);},boolean=>{blot_structural::hash(sink,2 as u8);},unsigned32=>{blot_structural::hash(sink,3 as u8);},floating32=>{blot_structural::hash(sink,4 as u8);},reference=>{blot_structural::hash(sink,5 as u8);},parameter=>{blot_structural::hash(sink,6 as u8);},}}
fn equal(left:blot_backend_layout::Tag,right:blot_backend_layout::Tag)->bool {return left==right;}
fn equal(left:blot_eval_eval_values::ValueKind,right:blot_eval_eval_values::ValueKind)->bool {return left==right;}
fn equal(left:blot_eval_eval_values::ClosureOrigin,right:blot_eval_eval_values::ClosureOrigin)->bool {return left==right;}
fn equal(left:blot_eval_type_evidence::Tag,right:blot_eval_type_evidence::Tag)->bool {return left==right;}
fn equal(left:blot_eval_implementation_evidence::ProofKind,right:blot_eval_implementation_evidence::ProofKind)->bool {return left==right;}
fn equal(left:blot_reuse_code_artifacts::Request,right:blot_reuse_code_artifacts::Request)->bool {match left {named a=>{match right {named b=>{return equal(a.key,b.key);},_=>{return false;}}},closure a=>{match right {closure b=>{return equal(a.key,b.key);},_=>{return false;}}},callable a=>{match right {callable b=>{return equal(a.key,b.key);},_=>{return false;}}},constructor a=>{match right {constructor b=>{return equal(a.key,b.key);},_=>{return false;}}},primitive a=>{match right {primitive b=>{return equal(a.key,b.key);},_=>{return false;}}},operation a=>{match right {operation b=>{return equal(a.key,b.key);},_=>{return false;}}},host a=>{match right {host b=>{return equal(a.key,b.key);},_=>{return false;}}},constant a=>{match right {constant b=>{return equal(a.key,b.key);},_=>{return false;}}},runtime_global a=>{match right {runtime_global b=>{return equal(a.target,b.target);},_=>{return false;}}},}}
fn equal(left:blot_reuse_code_artifacts::OperationLocation,right:blot_reuse_code_artifacts::OperationLocation)->bool {match left {instruction a=>{match right {instruction b=>{return equal(a.function,b.function) && equal(a.index,b.index);},_=>{return false;}}},word a=>{match right {word b=>{return equal(a.address,b.address);},_=>{return false;}}},}}
