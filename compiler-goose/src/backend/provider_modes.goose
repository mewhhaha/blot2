// Exact frame modes authorize only complete checked operation patterns.
namespace blot_backend_provider_modes;
import std;
import backend.runtime_ir;
import backend.wasm;
import backend.provider_origins;
import backend.provider_flow;
import support.error;
import support.option;
import support.pooled_buffer;
type Error=blot_error::Error;
type Role=blot_backend_runtime_ir::Role;
type ValueType=blot_backend_runtime_ir::ValueType;
type Op=blot_backend_runtime_ir::Op;
type Instruction=blot_backend_runtime_ir::Instruction;
type Module=blot_backend_wasm::Module;
enum Access {unsupported,read,write}
struct Mode {operation:u32,access:Access,role:Role,machine:ValueType}
struct Modes {storage:Mode[:] = default<Mode[:]>(),items:Mode[:] = default<Mode[:]>(),len:i64=0}
reusable[] var mode_runs:Mode[>..]=[];
struct Catalog {entries:Modes=Modes{..},saturated:bool=false}
fn deinit(self_:Catalog&) {blot_support_pooled_buffer::deinit(self_.entries,mode_runs);self_=Catalog{..};}
fn init(module:const Module&)->Catalog,Error {let result,error=initMode(module,false);if error!=blot_error::Error.none {return Catalog{..},error;}if !result.present {return Catalog{..},blot_error::Error.none;}return result.value,blot_error::Error.none;}
fn initProtected(module:const Module&)->blot_support::Option<Catalog>,Error {return initMode(module,true);}
fn initMode(module:const Module&,protected:bool)->blot_support::Option<Catalog>,Error {
    var found=false;for body in module.functions {for inst in blot_backend_wasm::instructions(module,body) {if inst.op==blot_backend_runtime_ir::OP_ownership {let mark=blot_backend_runtime_ir::ownership(inst.operand);if mark.kind==blot_backend_runtime_ir::OWN_rest && mark.chunk==blot_backend_provider_origins::begin_chunk {found=true;}}}}if !found {return blot_support::none<Catalog>(),blot_error::Error.none;}
    var accepted=false;var error=blot_error::Error.none;if protected {let valid,failure=blot_backend_provider_flow::protectedActivations(module);accepted=valid;error=failure;}else {let valid,failure=blot_backend_provider_flow::complete(module);accepted=valid;error=failure;}if error!=blot_error::Error.none {return blot_support::none<Catalog>(),error;}if !accepted {return blot_support::none<Catalog>(),blot_error::Error.none;}
    var result=Catalog{..};for body in module.functions {for inst,at in blot_backend_wasm::instructions(module,body) {if inst.op!=blot_backend_runtime_ir::OP_ownership {continue;}let mark=blot_backend_runtime_ir::ownership(inst.operand);if mark.kind!=blot_backend_runtime_ir::OWN_rest || mark.chunk!=blot_backend_provider_origins::begin_chunk {continue;}let fact=blot_backend_provider_origins::constructor(module,body,at);assert(fact.present);var access=Access.unsupported;if fact.value.kind==4 && (!fact.value.write.present || fact.value.write.value!=fact.value.read) {access=Access.read;}let error=result.add(Mode{fact.value.read,access,fact.value.value_role,fact.value.value_machine});if error!=blot_error::Error.none {result.deinit();return blot_support::none<Catalog>(),error;}if fact.value.write.present {var access=Access.unsupported;if fact.value.kind==4 && fact.value.read!=fact.value.write.value {access=Access.write;}let error=result.add(Mode{fact.value.write.value,access,fact.value.value_role,fact.value.value_machine});if error!=blot_error::Error.none {result.deinit();return blot_support::none<Catalog>(),error;}}}}
    sortModes(result.entries.items);return blot_support::some(result),blot_error::Error.none;
}
fn add(self_:Catalog&,mode:Mode)->Error {if self_.saturated {return blot_error::Error.none;}for &existing in self_.entries.items {if existing.operation==mode.operation {if existing!=mode {existing=Mode{mode.operation,Access.unsupported,blot_backend_runtime_ir::ROLE_unknown,blot_backend_runtime_ir::VT_none};}return blot_error::Error.none;}}if self_.entries.len==4096 {blot_support_pooled_buffer::clear(self_.entries);self_.entries.len=0;self_.saturated=true;return blot_error::Error.none;}let error=blot_support_pooled_buffer::push(self_.entries,mode,mode_runs);self_.entries.len=self_.entries.items.len;return error;}
fn sift(items:Mode[:],root:i64,end:i64) {var parent=root;loop {var child=parent*2+1;if child>=end {return;}if child+1<end && items[child].operation<items[child+1].operation {child++;}if items[parent].operation>=items[child].operation {return;}let old=items[parent];items[parent]=items[child];items[child]=old;parent=child;}}
fn sortModes(items:Mode[:]) {var start=items.len/2;while start!=0 {start--;sift(items,start,items.len);}var end=items.len;while end>1 {end--;let old=items[0];items[0]=items[end];items[end]=old;sift(items,0,end);}}
fn lookup(self_:const Catalog&,operation:u32)->blot_support::Option<Mode> {for item in self_.entries.items {if item.operation==operation {return blot_support::some(item);}}return blot_support::none<Mode>();}
struct Expected {op:Op,operand:u32=0}
fn exact(inst:Instruction,op:Op,operand:u32)->bool {return inst.op==op && inst.operand==operand && !inst.table_reference;}
fn matches(code:const Instruction[:],expected:const Expected[:])->bool {if code.len<expected.len {return false;}for want,index in expected {if !exact(code[index],want.op,want.operand) {return false;}}return true;}
struct Lookup {mode:Mode,local:u32}
// A view borrows flat instruction/type runs. It owns no detached artifact.
struct FunctionView {parameters:const ValueType[:],result:ValueType,result_role:Role,entry:bool,provider_parameter:u8,parameter_roles:u64,locals:const ValueType[:],instructions:const Instruction[:]}
fn functionView(module:const Module&,source:const blot_backend_runtime_ir::Function&)->FunctionView {return FunctionView{module.parameters(source),source.result,source.result_role,source.entry,source.provider_parameter,source.parameter_roles,module.locals(source),blot_backend_wasm::instructions(module,source)};}
fn checkedLookup<F>(catalog:const Catalog&,source:const F&,access:Access)->blot_support::Option<Lookup> {
    if source.entry || source.provider_parameter!=2 || source.parameters.len!=3 || source.parameters[0]!=blot_backend_runtime_ir::VT_i32 || source.parameters[2]!=blot_backend_runtime_ir::VT_i32 {return blot_support::none<Lookup>();}
    if access==Access.read && (source.parameters[1]!=blot_backend_runtime_ir::VT_i32 || source.parameter_roles!=blot_backend_runtime_ir::packParameterRoles([blot_backend_runtime_ir::ROLE_reference,blot_backend_runtime_ir::ROLE_scalar,blot_backend_runtime_ir::ROLE_reference][..])) {return blot_support::none<Lookup>();}
    let code=source.instructions;if code.len<50 || code.len>4096 || code[1].op!=blot_backend_runtime_ir::OP_local_set || code[11].op!=blot_backend_runtime_ir::OP_i32_const || code[11].table_reference {return blot_support::none<Lookup>();}let selected=catalog.lookup(code[11].operand);if !selected.present {return blot_support::none<Lookup>();}let mode=selected.value;if mode.access!=access || (mode.machine!=blot_backend_runtime_ir::VT_i32 && mode.machine!=blot_backend_runtime_ir::VT_f32) {return blot_support::none<Lookup>();}
    match access {read=>{if mode.role!=source.result_role || mode.machine!=source.result {return blot_support::none<Lookup>();}},write=>{if (mode.role!=blot_backend_runtime_ir::ROLE_scalar && mode.role!=blot_backend_runtime_ir::ROLE_reference) || source.parameters[1]!=mode.machine || source.parameter_roles!=blot_backend_runtime_ir::packParameterRoles([blot_backend_runtime_ir::ROLE_reference,mode.role,blot_backend_runtime_ir::ROLE_reference][..]) || source.result!=blot_backend_runtime_ir::VT_i32 || source.result_role!=blot_backend_runtime_ir::ROLE_scalar {return blot_support::none<Lookup>();}},unsupported=>{return blot_support::none<Lookup>();}}
    let local=code[1].operand;if local<source.parameters.len || local>=source.parameters.len+source.locals.len || source.locals[local-source.parameters.len]!=blot_backend_runtime_ir::VT_i32 {return blot_support::none<Lookup>();}
    let expected=[
        Expected{blot_backend_runtime_ir::OP_local_get,2},Expected{blot_backend_runtime_ir::OP_local_set,local},Expected{blot_backend_runtime_ir::OP_block,..},Expected{blot_backend_runtime_ir::OP_loop,..},
        Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_i32_eqz,..},Expected{blot_backend_runtime_ir::OP_if_,..},Expected{blot_backend_runtime_ir::OP_unreachable_,..},
        Expected{blot_backend_runtime_ir::OP_end,..},Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_i32_load,..},Expected{blot_backend_runtime_ir::OP_i32_const,mode.operation},
        Expected{blot_backend_runtime_ir::OP_i32_eq,..},Expected{blot_backend_runtime_ir::OP_br_if,1},Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_i32_load,12},
        Expected{blot_backend_runtime_ir::OP_i32_const,4},Expected{blot_backend_runtime_ir::OP_i32_eq,..},Expected{blot_backend_runtime_ir::OP_if_,..},Expected{blot_backend_runtime_ir::OP_local_get,local},
        Expected{blot_backend_runtime_ir::OP_i32_load,16},Expected{blot_backend_runtime_ir::OP_i32_const,mode.operation},Expected{blot_backend_runtime_ir::OP_i32_eq,..},Expected{blot_backend_runtime_ir::OP_br_if,2},
        Expected{blot_backend_runtime_ir::OP_end,..},Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_i32_load,8},Expected{blot_backend_runtime_ir::OP_local_set,local},
        Expected{blot_backend_runtime_ir::OP_br,..},Expected{blot_backend_runtime_ir::OP_end,..},Expected{blot_backend_runtime_ir::OP_end,..},
    ];if !matches(code,expected[..]) {return blot_support::none<Lookup>();}return blot_support::some(Lookup{mode,local});
}
fn alternative(code:const Instruction[:])->bool {var depth:i64=1;for inst,at in code {if inst.op==blot_backend_runtime_ir::OP_block || inst.op==blot_backend_runtime_ir::OP_loop || inst.op==blot_backend_runtime_ir::OP_if_ {depth++;}else if inst.op==blot_backend_runtime_ir::OP_end {if depth==0 {return false;}depth--;if depth==0 && at+1!=code.len {return false;}}}return depth==0;}
fn readOperation<F>(catalog:const Catalog&,source:const F&)->blot_support::Option<Mode> {
    let found=checkedLookup(catalog,source,Access.read);if !found.present {return blot_support::none<Mode>();}let selected=found.value.mode;let local=found.value.local;let code=source.instructions;var load=blot_backend_runtime_ir::OP_i32_load;if source.result==blot_backend_runtime_ir::VT_f32 {load=blot_backend_runtime_ir::OP_f32_load;}
    let expected=[Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_i32_load,12},Expected{blot_backend_runtime_ir::OP_i32_const,4},Expected{blot_backend_runtime_ir::OP_i32_eq,..},Expected{blot_backend_runtime_ir::OP_if_,source.result as u32},Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_i32_load,..},Expected{blot_backend_runtime_ir::OP_i32_const,selected.operation},Expected{blot_backend_runtime_ir::OP_i32_eq,..},Expected{blot_backend_runtime_ir::OP_if_,source.result as u32},Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{load,4},Expected{blot_backend_runtime_ir::OP_else_,..},Expected{blot_backend_runtime_ir::OP_unreachable_,..},Expected{blot_backend_runtime_ir::OP_end,..},Expected{blot_backend_runtime_ir::OP_else_,..}];if !matches(code[31..],expected[..]) || !alternative(code[47..]) {return blot_support::none<Mode>();}return blot_support::some(selected);
}
fn writeOperation<F>(module:const Module&,catalog:const Catalog&,source:const F&)->blot_support::Option<Mode> {
    if !module.arena.present {return blot_support::none<Mode>();}let found=checkedLookup(catalog,source,Access.write);if !found.present {return blot_support::none<Mode>();}let selected=found.value.mode;let local=found.value.local;let code=source.instructions;
    let expected=[Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_i32_load,12},Expected{blot_backend_runtime_ir::OP_i32_const,4},Expected{blot_backend_runtime_ir::OP_i32_eq,..},Expected{blot_backend_runtime_ir::OP_if_,blot_backend_runtime_ir::VT_i32 as u32},Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_i32_load,..},Expected{blot_backend_runtime_ir::OP_i32_const,selected.operation},Expected{blot_backend_runtime_ir::OP_i32_eq,..},Expected{blot_backend_runtime_ir::OP_if_,blot_backend_runtime_ir::VT_i32 as u32},Expected{blot_backend_runtime_ir::OP_unreachable_,..},Expected{blot_backend_runtime_ir::OP_else_,..},Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_local_get,local},Expected{blot_backend_runtime_ir::OP_i32_const,4},Expected{blot_backend_runtime_ir::OP_i32_add,..},Expected{blot_backend_runtime_ir::OP_local_get,1}];if !matches(code[31..],expected[..]) {return blot_support::none<Mode>();}var at:i64=48;if selected.machine==blot_backend_runtime_ir::VT_f32 {if !exact(code[at],blot_backend_runtime_ir::OP_i32_reinterpret_f32,0) {return blot_support::none<Mode>();}at++;}let tail=[Expected{blot_backend_runtime_ir::OP_call,module.arena.value.store_word},Expected{blot_backend_runtime_ir::OP_i32_const,..},Expected{blot_backend_runtime_ir::OP_end,..},Expected{blot_backend_runtime_ir::OP_else_,..}];if !matches(code[at..],tail[..]) || at+4>code.len || !alternative(code[at+4..]) {return blot_support::none<Mode>();}return blot_support::some(selected);
}
fn specialize<F>(catalog:const Catalog&,source:const F&)->blot_support::Option<blot_backend_runtime_ir::DetachedBody>,Error {if !readOperation(catalog,source).present {return blot_support::none<blot_backend_runtime_ir::DetachedBody>(),blot_error::Error.none;}var code:Instruction[>..<]=[];code.append(source.instructions[..47]);code.push(blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_unreachable_));code.push(blot_backend_runtime_ir::instruction(blot_backend_runtime_ir::OP_end));let result,error=blot_backend_runtime_ir::cloneBody(source.locals,code[..]);if error!=blot_error::Error.none {return blot_support::none<blot_backend_runtime_ir::DetachedBody>(),error;}return blot_support::some(result),blot_error::Error.none;}
