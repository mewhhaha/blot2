        Tag.staging => { return Value {}, Error.none; },
        Tag.constant => { if module.types.node(n.ty).tag == TypeTag.unsigned32 { let operand, err = self.values.intern(Term { tag: TermTag.literal, a: n.a }); return Value { operand: operand }, err; } },
