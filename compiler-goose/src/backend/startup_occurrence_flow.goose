reusable[] var fact_runs:Fact[>..]=[];
reusable[] var word_runs:u32[>..]=[];
fn deinit(self_:Result&) {if self_.edges.len!=0 {edge_runs.free_slice(self_.edges);}if self_.facts.len!=0 {fact_runs.free_slice(self_.facts);}self_=Result{edges:[],facts:[]};}
