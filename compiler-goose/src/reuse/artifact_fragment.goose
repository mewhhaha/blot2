 function item=>{let function=self_.old.emission.functions[item.id];if function.role==blot_reuse_artifact_emitter::FunctionRole.static_closure && !self_.staticHelper(function,record.owner) {return false,blot_error::Error.none;}},
 callable_layout item=>{let owner=record.owner;if owner==0 || owner>self_.old.metadata.jobs.len {return false,blot_error::Error.none;}let job=self_.old.metadata.jobs.items[owner-1];let declared=self_.declaredCallableLayout(owner);if !job.function.present || job.function.value!=item.function || !declared.present || declared.value!=item.layout {return false,blot_error::Error.none;}let ty,error=self_.importer.importCallableLayout(g,item.layout,declared);if error!=blot_error::Error.none || !ty.present {return false,error;}if g.representations.store.node(ty.value).tag!=blot_backend_layout::Tag.function {return false,blot_error::Error.none;}},
 semantic_site item=>{let site=item.value;if site.function>=self_.old.emission.functions.len {return false,blot_error::Error.none;}let function=self_.old.emission.functions[site.function];if site.place>=function.instructions.len {return false,blot_error::Error.none;}let instruction=self_.old.emission.instructions[function.instructions.start+site.place];if site.kind==blot_backend_wasm::SemanticKind.diagnostic_memory {if blot_backend_runtime_ir::fixed(instruction.op).bytes==0 && instruction.op!=blot_backend_runtime_ir::OP_memory_copy && instruction.op!=blot_backend_runtime_ir::OP_memory_fill {return false,blot_error::Error.none;}}else if instruction.op!=blot_backend_runtime_ir::OP_call && instruction.op!=blot_backend_runtime_ir::OP_call_indirect && instruction.op!=blot_backend_runtime_ir::OP_call_import {return false,blot_error::Error.none;}if site.kind==blot_backend_wasm::SemanticKind.allocation {if !self_.old.emission.arena.present || instruction.op!=blot_backend_runtime_ir::OP_call || !self_.old.emission.arena.value.isAllocation(instruction.operand.value) {return false,blot_error::Error.none;}}let imported,error=self_.importer.importSemanticSite(g,site);if error!=blot_error::Error.none || !imported.present {return false,error;}},
 instruction item=>{return self_.admitOperand(g,item.operand,record.owner,roots);},
