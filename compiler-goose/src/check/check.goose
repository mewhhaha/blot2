reusable[] var precise_use_values:blot_reuse_principal_interface::SelectedUse[>..];
reusable[] var precise_seen_slots:dictionary_slot<u64,bool>[>..];
fn Engine::finishSelectedUses(self:Engine&)->blot_error::Error {if self.selected_uses.len==0 {return blot_error::Error.none;}var uses=blot_support_pooled_buffer::Buffer<blot_reuse_principal_interface::SelectedUse>{};var seen=blot_support_pooled_map::Map<u64,bool>{};let err=finishSelectedUsesBody(self,uses,seen);if err==blot_error::Error.none {self.selected_uses.clear();for use in uses.items {self.selected_uses.append(use);}}blot_support_pooled_map::deinit(seen,precise_seen_slots);blot_support_pooled_buffer::deinit(uses,precise_use_values);return err;}
fn finishSelectedUsesBody(self:Engine&,uses:blot_support_pooled_buffer::Buffer<blot_reuse_principal_interface::SelectedUse>&,seen:blot_support_pooled_map::Map<u64,bool>&)->blot_error::Error {for node,ordinal in self.tree.nodes.items {let allowed,err=self.associatedStep(ordinal as u32);if err!=blot_error::Error.none || !allowed {return err;}if node.tag!=blot_parse_ast::tag_name && node.tag!=blot_parse_ast::tag_field_access {continue;}let template,err=self.memberTemplate(self.resolved[ordinal],false);if err!=blot_error::Error.none {return err;}if !template.present {continue;}let span=self.tree.span(ordinal as u32);for use in self.selected_uses {let allowed,err=self.associatedStep(ordinal as u32);if err!=blot_error::Error.none || !allowed {return err;}let enclosing=self.tree.span(use.source);if span.start<enclosing.start || span.end>enclosing.end {continue;}let matches,err=self.selectedReference(ordinal as u32,template.value,self.selected_proofs[use.proof]);if err!=blot_error::Error.none {return err;}if !matches {continue;}let key=((ordinal as u64)<<32)|(use.proof as u64);if seen.contains(key) {continue;}blot_support_pooled_map::insert(seen,key,true,precise_seen_slots);let err=blot_support_pooled_buffer::push(uses,blot_reuse_principal_interface::SelectedUse{source:ordinal as u32,proof:use.proof},precise_use_values);if err!=blot_error::Error.none {return err;}}}return blot_error::Error.none;}
fn Engine::contractHeaders(self:Engine&)->blot_error::Error {for id in self.tree.roots.items {let node=self.tree.node(id);if node.tag!=blot_parse_ast::tag_contract_decl {continue;}let key=Qualified{namespace:0,member:node.a};if self.catalogs.contract_names.contains(key) || self.catalogs.nominal_names.contains(key) {let err=self.diagnostic(Code.duplicate_name,id);if err!=blot_error::Error.none {return err;}continue;}let meta=self.tree.extra.items[node.c..node.c+4];if meta[3]!=0 {let err=self.diagnostic(Code.unsupported_attribute,id);if err!=blot_error::Error.none {return err;}}self.type_env.clear();self.row_env.clear();let parameters=equation_type_ids.alloc_slice(meta[1]);let patterns=equation_type_ids.alloc_slice(meta[1]);let result=contractHeaderParameters(self,id,node,key,meta,parameters,patterns);equation_type_ids.free_slice(patterns);equation_type_ids.free_slice(parameters);if result!=blot_error::Error.none {return result;}}self.type_env.clear();self.row_env.clear();return blot_error::Error.none;}
fn contractHeaderParameters(self:Engine&,id:u32,node:blot_parse_ast::Node,key:Qualified,meta:const u32[:],parameters:u32[:],patterns:u32[:])->blot_error::Error {for parameter,index in self.tree.list(blot_parse_ast::List{start:meta[0],len:meta[1]}) {let parsed,err=self.parameterAnnotation(parameter,0);if err!=blot_error::Error.none {return err;}parameters[index]=parsed.ty;patterns[index]=parsed.pattern;}let names=equation_type_ids.alloc_slice(self.type_env.items.len);let variables=equation_type_ids.alloc_slice(names.len);for entry,index in self.type_env.items {names[index]=entry.name;variables[index]=entry.ty;}let row_names=equation_type_ids.alloc_slice(self.row_env.items.len);let row_parameters=equation_type_ids.alloc_slice(row_names.len);for entry,index in self.row_env.items {row_names[index]=entry.name;row_parameters[index]=entry.row;}let result=contractHeaderBody(self,id,node,key,parameters,patterns,names,variables,row_names,row_parameters);equation_type_ids.free_slice(row_parameters);equation_type_ids.free_slice(row_names);equation_type_ids.free_slice(variables);equation_type_ids.free_slice(names);return result;}
fn contractHeaderBody(self:Engine&,id:u32,node:blot_parse_ast::Node,key:Qualified,parameters:const u32[:],patterns:const u32[:],names:const u32[:],variables:const u32[:],row_names:const u32[:],row_parameters:const u32[:])->blot_error::Error {let index=self.contracts.len as u32;let identity=Identity{unit:self.unit,decl:blot_check_types::opaque_name_bit|node.a};let product,err=self.types.product(parameters);if err!=blot_error::Error.none {return err;}let header_rows,err=self.types.freeRowVariables(product);if err!=blot_error::Error.none {return err;}let body=self.tree.node(node.b);let start=self.contract_members.len as u32;var requires=false;for child in self.tree.list(blot_parse_ast::List{body.a,body.b}) {let item=self.tree.node(child);if item.tag!=blot_parse_ast::tag_contract_type_member && item.tag!=blot_parse_ast::tag_contract_value_member {continue;}let allowed,err=self.associatedStep(child);if err!=blot_error::Error.none {return err;}if !allowed {continue;}var duplicate=false;for member in self.contract_members[start..] {if member.name==item.a {duplicate=true;}}if duplicate {let err=self.diagnostic(Code.duplicate_name,child);if err!=blot_error::Error.none {return err;}continue;}var kind=blot_reuse_principal_interface::ContractMemberKind.defined_type;if item.tag==blot_parse_ast::tag_contract_value_member {kind=blot_reuse_principal_interface::ContractMemberKind.value;}else if item.b==0 {kind=blot_reuse_principal_interface::ContractMemberKind.abstract_type;}requires=requires || kind!=blot_reuse_principal_interface::ContractMemberKind.defined_type;let member=self.contract_members.len as u32;self.contract_members.append(ContractMember{contract:identity,name:item.a,kind:kind});self.member_sources.insert(member,child);}let members=blot_check_types::List{start:start,len:self.contract_members.len as u32-start};self.has_associated_types=self.has_associated_types || members.len!=0;let parameter_list,err=self.types.saveList(parameters);if err!=blot_error::Error.none {return err;}let pattern_list,err=self.parameter_patterns.saveList(patterns);if err!=blot_error::Error.none {return err;}let variable_list,err=self.types.saveList(variables);if err!=blot_error::Error.none {return err;}let name_list,err=self.types.saveList(names);if err!=blot_error::Error.none {return err;}let row_list,err=self.types.saveList(header_rows);if err!=blot_error::Error.none {return err;}let row_name_list,err=self.types.saveList(row_names);if err!=blot_error::Error.none {return err;}let row_parameters_list,err=self.types.saveList(row_parameters);if err!=blot_error::Error.none {return err;}self.contracts.append(Contract{declaration:id,private:self.tree.declaration_traits(id).private,identity:identity,name:node.a,parameters:parameter_list,patterns:pattern_list,variables:variable_list,parameter_names:name_list,members:members,requires_implementation:requires,row_variables:row_list,row_parameter_names:row_name_list,row_parameters:row_parameters_list});self.catalogs.contract_names.insert(key,index);self.catalogs.contract_identities.insert(identity,index);return blot_error::Error.none;}
fn Engine::resolveContract(self:Engine&,index:u32)->blot_error::Error {let contract=self.contracts[index];if contract.identity.unit!=self.unit {return blot_error::Error.none;}let state .= self.contract_states.get(index);if state {if state==Engine_contract_states_state.visiting {return self.diagnostic(Code.recursive_contract,contract.declaration);}return blot_error::Error.none;}if self.contract_depth>=256 {return blot_error::Error.type_limit;}self.contract_depth+=1;self.contract_states.insert(index,Engine_contract_states_state.visiting);let saved_types=self.type_env;let saved_rows=self.row_env;let saved_closed=self.closed_type_variables;let saved_alias_rows=self.implicit_row_parameters;self.type_env=TypeEnvironment{};self.row_env=RowEnvironment{};self.closed_type_variables=true;self.implicit_row_parameters=true;let result=resolveContractBody(self,index,contract);self.type_env.deinit();self.row_env.deinit();self.type_env=saved_types;self.row_env=saved_rows;self.closed_type_variables=saved_closed;self.implicit_row_parameters=saved_alias_rows;self.contract_depth-=1;return result;}
fn resolveContractBody(self:Engine&,index:u32,contract:Contract)->blot_error::Error {for parameter in 0..contract.variables.len {let err=self.type_env.append(Engine_type_env{name:self.types.list(contract.parameter_names)[parameter],ty:self.types.list(contract.variables)[parameter]});if err!=blot_error::Error.none {return err;}}for name,ordinal in self.types.list(contract.row_parameter_names) {let err=self.row_env.append(Engine_row_env{name:name,row:self.types.list(contract.row_parameters)[ordinal]});if err!=blot_error::Error.none {return err;}}let body=self.tree.node(contract.declaration).b;let node=self.tree.node(body);var predicates=PredicateBuffer{};var roots=IdBuffer{};let result=resolveContractPredicates(self,index,contract,body,node,predicates,roots);blot_support_pooled_buffer::deinit(roots,equation_type_ids);blot_support_pooled_buffer::deinit(predicates,equation_values);return result;}
type PredicateBuffer=blot_support_pooled_buffer::Buffer<blot_check_types::Obligation>;
type IdBuffer=blot_support_pooled_buffer::Buffer<u32>;
fn resolveContractPredicates(self:Engine&,index:u32,contract:Contract,body:u32,node:blot_parse_ast::Node,predicates:PredicateBuffer&,roots:IdBuffer&)->blot_error::Error {for child in self.tree.list(blot_parse_ast::List{node.a,node.b}) {if self.tree.node(child).tag==blot_parse_ast::tag_constraint {let err=self.lowerPredicates(child,body,predicates);if err!=blot_error::Error.none {return err;}}}for member in contract.members.start..contract.members.start+contract.members.len {let err=self.resolveMember(member as u32);if err!=blot_error::Error.none {return err;}}for &predicate in predicates.items {let normalized,err=self.resolveNonzeroPredicateRoots(predicate,roots);if err!=blot_error::Error.none {return err;}predicate=normalized;}for root in self.types.list(contract.parameters) {let err=roots.append(root);if err!=blot_error::Error.none {return err;}}let product,err=self.types.product(roots.items);if err!=blot_error::Error.none {return err;}let rows,err=self.types.freeRowVariables(product);if err!=blot_error::Error.none {return err;}let start=self.contract_predicates.len as u32;for predicate in predicates.items {self.contract_predicates.append(predicate);}self.contracts[index].predicates=blot_check_types::List{start:start,len:predicates.items.len as u32};let span,err=self.types.saveList(rows);if err!=blot_error::Error.none {return err;}self.contracts[index].row_variables=span;self.contract_states.insert(index,Engine_contract_states_state.ready);return blot_error::Error.none;}
fn Engine::resolveNonzeroPredicateRoots(self:Engine&,before:blot_check_types::Obligation,roots:IdBuffer&)->blot_check_types::Obligation,blot_error::Error {var result=before;for ordinal in 0..4 {var root=before.ty;if ordinal==1 {root=before.other;}else if ordinal==2 {root=before.result;}else if ordinal==3 {root=before.signature;}if root==0 {continue;}let value,err=self.types.resolve(root,0);if err!=blot_error::Error.none {return result,err;}if ordinal==0 {result.ty=value;}else if ordinal==1 {result.other=value;}else if ordinal==2 {result.result=value;}else {result.signature=value;}let err=roots.append(value);if err!=blot_error::Error.none {return result,err;}}return result,blot_error::Error.none;}
fn blot_support_pooled_buffer::append(self:blot_check_check::IdBuffer&,value:u32)->blot_error::Error {return blot_support_pooled_buffer::push(self,value,blot_check_check::equation_type_ids);}
fn blot_support_pooled_buffer::append(self:blot_check_check::PredicateBuffer&,value:blot_check_types::Obligation)->blot_error::Error {return blot_support_pooled_buffer::push(self,value,blot_check_check::equation_values);}
fn Engine::associatedStep(self:Engine&,source:u32)->bool,blot_error::Error {if self.inference_transitions+self.types.projection_steps>=self.inference_limit {let err=self.diagnostic(Code.associated_limit,source);return false,err;}let err=self.types.chargeProjection();if err==blot_error::Error.type_limit {let issue=self.diagnostic(Code.associated_limit,source);return false,issue;}return err==blot_error::Error.none,err;}
fn Engine::memberIndex(self:const Engine&,contract:Contract,name:u32)->blot_support::Option<u32> {for index in contract.members.start..contract.members.start+contract.members.len {if self.contract_members[index].name==name {return blot_support::some(index as u32);}}return blot_support::none<u32>();}
fn Engine::resolveMember(self:Engine&,index:u32)->blot_error::Error {let member=self.contract_members[index];if member.contract.unit!=self.unit || member.kind==blot_reuse_principal_interface::ContractMemberKind.abstract_type {return blot_error::Error.none;}if self.member_states.contains(index) {return blot_error::Error.none;}self.member_states.insert(index,Engine_member_states_state.visiting);let ordinal .= self.catalogs.contract_identities.get(member.contract);let contract=self.contracts[ordinal];let source .= self.member_sources.get(index);let saved_types=self.type_env;let saved_rows=self.row_env;let saved_closed=self.closed_type_variables;let saved_implicit=self.implicit_row_parameters;let saved_defer=self.defer_associated;self.type_env=TypeEnvironment{};self.row_env=RowEnvironment{};self.closed_type_variables=true;self.implicit_row_parameters=false;self.defer_associated=true;let err=resolveMemberBody(self,index,member,contract,source);self.type_env.deinit();self.row_env.deinit();self.type_env=saved_types;self.row_env=saved_rows;self.closed_type_variables=saved_closed;self.implicit_row_parameters=saved_implicit;self.defer_associated=saved_defer;return err;}
fn resolveMemberBody(self:Engine&,index:u32,member:ContractMember,contract:Contract,source:u32)->blot_error::Error {for name,ordinal in self.types.list(contract.parameter_names) {let err=self.type_env.append(Engine_type_env{name:name,ty:self.types.list(contract.variables)[ordinal]});if err!=blot_error::Error.none {return err;}}for name,ordinal in self.types.list(contract.row_parameter_names) {let err=self.row_env.append(Engine_row_env{name:name,row:self.types.list(contract.row_parameters)[ordinal]});if err!=blot_error::Error.none {return err;}}let root,err=self.annotation(self.tree.node(source).b);if err!=blot_error::Error.none {return err;}if member.kind==blot_reuse_principal_interface::ContractMemberKind.defined_type {let err=self.unrestrictedAssociatedType(root,source);if err!=blot_error::Error.none {return err;}}self.contract_members[index].root=root;self.member_states.insert(index,Engine_member_states_state.ready);return blot_error::Error.none;}
fn Engine::projectionAnnotation(self:Engine&,symbol:u32,syntax:const u32[:],source:u32)->blot_support::Option<u32>,blot_error::Error {let name=self.pool.get(symbol);let separator=lastDot(name);if !separator.present {return blot_support::none<u32>(),blot_error::Error.none;}let path=name[..separator.value];let first_separator=firstDot(path);var first_text=path;if first_separator.present {first_text=path[..first_separator.value];}let first_name,known=self.pool.lookup(first_text);if !known {return blot_support::none<u32>(),blot_error::Error.none;}for entry in self.type_env.items {if entry.name==first_name {let err=self.diagnostic(Code.unsupported_type,source);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let root,err=self.types.fresh();return blot_support::some(root),err;}}var key=Qualified{namespace:0,member:first_name};if first_separator.present {let member,known=self.pool.lookup(path[first_separator.value+1..]);if !known {return blot_support::none<u32>(),blot_error::Error.none;}key=Qualified{namespace:first_name,member:member};}let index .= self.catalogs.contract_names.get(key);if !index {return blot_support::none<u32>(),blot_error::Error.none;}let contract=self.contracts[index];if contract.private {let span=self.tree.span(source);for declaration in self.tree.roots.items {let enclosing=self.tree.span(declaration);if span.start<enclosing.start || span.end>enclosing.end || self.tree.declaration_traits(declaration).private {continue;}var escape=true;if self.tree.node(declaration).tag==blot_parse_ast::tag_value_decl {let binding=self.tree.value_decl(declaration);let annotation=self.tree.span(binding.annotation);let where_span=self.tree.span(binding.where_node);escape=(binding.annotation!=0 && span.start>=annotation.start && span.end<=annotation.end) || (binding.where_node!=0 && span.start>=where_span.start && span.end<=where_span.end);}if escape {let err=self.diagnostic(Code.private_identity_escape,source);if err!=blot_error::Error.none {return bl