fn usageReadExpression(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let n=self.units[owner].node(id); let operand,e=expression(self,owner,n.a,frame); if e!=Error.none||!isValue(operand) { return operand,e; } let info=valueInfo(self,flowValue(operand)); if n.b==0 { if info.kind!=ValueKind.scalar { return Flow.value {0},failNode(self,owner,id,Code.type_mismatch); } let value,error=makeScalar(self,owner,id,Value {info.scalar,info.bits}); return Flow.value {value},error; } if (n.b==1&&info.kind!=ValueKind.array)||(n.b==2&&info.kind!=ValueKind.list)||n.b>2 { return Flow.value {0},failNode(self,owner,id,Code.type_mismatch); } let value,error=makeScalar(self,owner,id,Value {blot_backend_runtime_ir::SC_u32,info.len}); return Flow.value {value},error; }
