// Physical iteration requires the exact ordinary cursor producer protocol.
namespace blot_backend_collection_iteration;
import check.core;
import .unit_index;
import .collection_ops;
import support.option;
struct Candidate { iter: u32,next: u32,receiver: u32,incoming: u32,iteration: u32,rest: u32,pattern: u32,constructor: u32 }
struct StepSink { pattern: u32,constructor: u32 }
fn local(source: const blot_check_core::Module&,id: u32,binding: u32) -> bool { if id == 0 || source.node(id).tag != blot_check_core::Tag.reference { return false; } let reference = source.reference(id); return (reference.unit == 0 || reference.unit == source.unit) && reference.binding == binding; }
fn contains(values: const u32[:],value: u32) -> bool { for held in values { if held == value { return true; } } return false; }
fn candidate(source: const blot_check_core::Module&,uses: const blot_backend_unit_index::Uses&,id: u32) -> blot_support::Option<Candidate> {
    let loop_ = source.loopInfo(id); if loop_.kind != blot_check_core::LoopKind.forever { return blot_support::none<Candidate>(); } let children = source.children(loop_.body); if children.len < 3 { return blot_support::none<Candidate>(); } let step = source.node(children[0]); let pattern = source.node(children[1]); let update = source.node(children[2]);
    if step.tag != blot_check_core::Tag.bind || pattern.tag != blot_check_core::Tag.pattern_bind || update.tag != blot_check_core::Tag.bind || !local(source,pattern.b,step.a) { return blot_support::none<Candidate>(); } let next = source.node(step.b); if next.tag != blot_check_core::Tag.project { return blot_support::none<Candidate>(); }
    let matched = source.pattern(pattern.a); if matched.tag != blot_check_core::PatternTag.constructor || matched.b == 0 { return blot_support::none<Candidate>(); } if source.pattern(matched.b).tag != blot_check_core::PatternTag.product { return blot_support::none<Candidate>(); } let items = source.patternChildren(matched.b); if items.len != 2 || source.pattern(items[1]).tag != blot_check_core::PatternTag.bind { return blot_support::none<Candidate>(); } let rest = source.pattern(items[1]).a; if !local(source,update.b,rest) { return blot_support::none<Candidate>(); }
    let fallback = source.children(pattern.c); if fallback.len != 1 || source.node(fallback[0]).tag != blot_check_core::Tag.break_ || source.node(fallback[0]).a != id { return blot_support::none<Candidate>(); }
    for carry in source.loopCarries(id) {
        if carry.backedge != update.a || !local(source,next.a,carry.iteration) { continue; } let iter = source.binding(carry.incoming).initializer; if iter == 0 || source.node(iter).tag != blot_check_core::Tag.project { return blot_support::none<Candidate>(); } let named = [carry.outgoing,step.a,rest,carry.iteration,carry.backedge];
        for held,position in named { if contains(named[..position],held) { continue; } for index in uses.references.get(held) { let reference = source.reference(index); if reference.unit != 0 && reference.unit != source.unit { continue; } if reference.binding == carry.outgoing { return blot_support::none<Candidate>(); } if reference.binding == step.a && index != pattern.b { return blot_support::none<Candidate>(); } if reference.binding == rest && index != update.b { return blot_support::none<Candidate>(); } if reference.binding != carry.iteration && reference.binding != carry.backedge { continue; } if index == next.a { continue; }
            var broken = false; for exit in uses.values.get(index) { if source.node(exit.exit).a == id { broken = true; break; } } if !broken { return blot_support::none<Candidate>(); }
        } }
        return blot_support::some(Candidate { iter: iter,next: step.b,receiver: next.a,incoming: carry.incoming,iteration: carry.iteration,rest: rest,pattern: items[0],constructor: matched.a , ..});
    } return blot_support::none<Candidate>();
}
fn parameter(source: const blot_check_core::Module&,body: const blot_check_core::Body&,id: u32) -> bool { return local(source,id,source.bodyParameters(body)[0].binding); }
fn cursorCreation(source: const blot_check_core::Module&,target: u32) -> bool { let body .= source.body(target); if body == null || !body.is_function || body.parameters.len != 1 { return false; } let root = source.node(body.root); return root.tag == blot_check_core::Tag.array_op && source.arrayOperation(body.root) == blot_backend_collection_ops::Op.cursor && source.children(body.root).len == 1 && parameter(source,body,source.children(body.root)[0]); }
fn cursorNext(source: const blot_check_core::Module&,target: u32,consumer: const blot_check_core::Module&,constructor: u32) -> bool {
    let body .= source.body(target); if body == null || !body.is_function || body.parameters.len != 1 { return false; } let root = source.node(body.root); if root.tag != blot_check_core::Tag.if_value { return false; } let predicate = source.node(root.a);
    if predicate.tag != blot_check_core::Tag.array_op || source.arrayOperation(root.a) != blot_backend_collection_ops::Op.cursor_has || source.children(root.a).len != 1 || !parameter(source,body,source.children(root.a)[0]) { return false; }
    let some = source.node(root.b); let empty = source.node(root.c); if some.tag != blot_check_core::Tag.construct || empty.tag != blot_check_core::Tag.construct || empty.b != 0 || some.b == 0 { return false; } let actual = source.constructor(some.a); let wanted = consumer.constructor(constructor); let absent = source.constructor(empty.a);
    if absent.tag == actual.tag || source.nominal(absent.nominal).identity != source.nominal(actual.nominal).identity { return false; } if actual.tag != wanted.tag || source.nominal(actual.nominal).identity != consumer.nominal(wanted.nominal).identity { return false; } if source.node(some.b).tag != blot_check_core::Tag.product { return false; } let values = source.children(some.b); if values.len != 2 { return false; } let operations = [blot_backend_collection_ops::Op.cursor_value,blot_backend_collection_ops::Op.cursor_advance];
    for value,index in values { if source.node(value).tag != blot_check_core::Tag.array_op || source.arrayOperation(value) != operations[index] || source.children(value).len != 1 || !parameter(source,body,source.children(value)[0]) { return false; } } return true;
}
fn patternSink(source: const blot_check_core::Module&,id: u32) -> blot_support::Option<StepSink> { let node = source.node(id); let matched = source.pattern(node.a); if matched.tag != blot_check_core::PatternTag.constructor || matched.b == 0 || source.pattern(matched.b).tag != blot_check_core::PatternTag.product { return blot_support::none<StepSink>(); } let fields = source.patternChildren(matched.b); if fields.len != 2 { return blot_support::none<StepSink>(); } for field in fields { let tag = source.pattern(field).tag; if tag != blot_check_core::PatternTag.bind && tag != blot_check_core::PatternTag.wildcard { return blot_support::none<StepSink>(); } } return blot_support::some(StepSink { id,matched.a , ..}); }
fn stepSink(source: const blot_check_core::Module&,uses: const blot_backend_unit_index::Uses&,binding: u32) -> blot_support::Option<StepSink> {
    let node = source.node(binding); if node.tag == blot_check_core::Tag.pattern_bind { return patternSink(source,binding); } if node.tag != blot_check_core::Tag.bind || node.a == 0 { return blot_support::none<StepSink>(); } let parent = uses.parentOf(binding); if parent.count != 1 { return blot_support::none<StepSink>(); } let siblings = source.children(parent.node); if parent.position + 1 == siblings.len { return blot_support::none<StepSink>(); } let pattern_id = siblings[parent.position + 1]; let pattern = source.node(pattern_id); if pattern.tag != blot_check_core::Tag.pattern_bind || !local(source,pattern.b,node.a) { return blot_support::none<StepSink>(); }
    let sink = patternSink(source,pattern_id); if !sink.present { return sink; } for id in uses.references.get(node.a) { if local(source,id,node.a) && id != pattern.b { return blot_support::none<StepSink>(); } } if uses.flagsOf(node.a).captured { return blot_support::none<StepSink>(); } return sink;
}
