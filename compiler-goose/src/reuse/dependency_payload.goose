fn partitionInto(self_:Owner&,destination:Owner&,value:squid_check_core::EffectRows) {
 self_.detach(destination,value.rows);
 self_.detach(destination,value.labels);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_check_core::Types) {
 self_.detach(destination,value.nodes);
 self_.detach(destination,value.extra);
 partitionInto(self_,destination,value.effects);
 self_.detach(destination,value.operations);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_check_core::Module) {
 self_.detach(destination,value.field_names);
 self_.detach(destination,value.runtime_names);
 self_.detach(destination,value.source_names);
 self_.detach(destination,value.declaration_dependencies);
 self_.detach(destination,value.dependency_references);
 self_.detach(destination,value.dependency_members);
 self_.detach(destination,value.erased_declaration_references);
 self_.detach(destination,value.tag_calls);
 partitionInto(self_,destination,value.types);
 self_.detach(destination,value.nodes);
 self_.detach(destination,value.spans);
 self_.detach(destination,value.extra);
 self_.detach(destination,value.bindings);
 self_.detach(destination,value.bodies);
 self_.detach(destination,value.parameters);
 self_.detach(destination,value.references);
 self_.detach(destination,value.calls);
 self_.detach(destination,value.merges);
 self_.detach(destination,value.merge_ranges);
 self_.detach(destination,value.names);
 self_.detach(destination,value.obligations);
 self_.detach(destination,value.nominals);
 self_.detach(destination,value.operation_names);
 self_.detach(destination,value.constructors);
 self_.detach(destination,value.projections);
 self_.detach(destination,value.projection_variants);
 self_.detach(destination,value.patterns);
 self_.detach(destination,value.pattern_rows);
 self_.detach(destination,value.match_arms);
 self_.detach(destination,value.matches);
 self_.detach(destination,value.updates);
 self_.detach(destination,value.update_steps);
 self_.detach(destination,value.closures);
 self_.detach(destination,value.associated);
 self_.detach(destination,value.contracts);
 self_.detach(destination,value.contract_members);
 self_.detach(destination,value.implementations);
 self_.detach(destination,value.implementation_members);
 self_.detach(destination,value.member_templates);
 self_.detach(destination,value.primitives);
 self_.detach(destination,value.loops);
 self_.detach(destination,value.loop_carries);
 self_.detach(destination,value.operation_values);
 self_.detach(destination,value.handle_effects);
 self_.detach(destination,value.dispatch_signatures);
 self_.detach(destination,value.type_tags);
 self_.detach(destination,value.sparks);
 self_.detach(destination,value.kernels);
 self_.detach(destination,value.processes);
 self_.detach(destination,value.diagnostics);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_check_frozen_types::Graph) {
 self_.detach(destination,value.nodes);
 self_.detach(destination,value.extra);
 self_.detach(destination,value.rows);
 self_.detach(destination,value.labels);
 self_.detach(destination,value.operations);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_check_frozen_types::PatternGraph) {
 self_.detach(destination,value.nodes);
 self_.detach(destination,value.extra);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_reuse_principal_interface::Interface) {
 partitionInto(self_,destination,value.graph);
 partitionInto(self_,destination,value.patterns);
 self_.detach(destination,value.bindings);
 self_.detach(destination,value.obligations);
 self_.detach(destination,value.nominals);
 self_.detach(destination,value.constructors);
 self_.detach(destination,value.effect_families);
 self_.detach(destination,value.effect_templates);
 self_.detach(destination,value.associated);
 self_.detach(destination,value.contracts);
 self_.detach(destination,value.contract_predicates);
 self_.detach(destination,value.contract_members);
 self_.detach(destination,value.implementations);
 self_.detach(destination,value.implementation_predicates);
 self_.detach(destination,value.implementation_members);
 self_.detach(destination,value.member_templates);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_reuse_frozen_dependency::Identity) {
 self_.detach(destination,value.normalized_path);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_reuse_frozen_dependency::ImportResolution) {
 self_.detach(destination,value.path);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_reuse_frozen_dependency::Module) {
 partitionInto(self_,destination,value.identity);
 self_.detach(destination,value.imports);
 self_.detach(destination,value.source_imports);
 for item in value.source_imports {partitionInto(self_,destination,item);}
 partitionInto(self_,destination,value.core);
 partitionInto(self_,destination,value.interface);
 self_.detach(destination,value.exports);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_reuse_frozen_dependency::Symbol) {
 self_.detach(destination,value.text);
}
fn partitionInto(self_:Owner&,destination:Owner&,value:squid_reuse_frozen_dependency::FrozenDependency) {
 self_.detach(destination,value.symbols);
 for item in value.symbols {partitionInto(self_,destination,item);}
 self_.detach(destination,value.modules);
 for item in value.modules {partitionInto(self_,destination,item);}
}
