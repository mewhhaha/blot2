
type Tick is effect = Unit -> U32
entry const answer = func () => return do:
  let count = 40
  for request in @requests (@computation (func () => return Tick ())):
    case request of
      effect Tick () =>
        count := @u32.add self 1
        yield 2
      complete count =>
        count := @u32.add self 1
        break
  break count

entry const checked_answer = answer ()
