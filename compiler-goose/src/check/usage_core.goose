    let acquisition = self.module.types.node(acquired.a); let release = self.module.types.node(released.a); if acquisition.tag != TypeTag.function || acquisition.a != blot_check_types::unit || release.tag != TypeTag.function || release.b != blot_check_types::unit || (release.c != 0 && !blot_check_cleanup_contracts::hostNominal(self.module.types, self.module.nominals, self.module.typeOf(node.b))) || !same(self.module, release.a, acquisition.b) || !same(self.module, node.ty, acquisition.b) { return Error.invalid_artifact; }
