 data_word item=>{if !self_.localAddress(item.address,record.owner) {return false,blot_error::Error.none;}return self_.admitOperand(g,item.operand,record.owner,roots);},
 global item=>{return self_.knownGlobal(item.id,g.request_owner),blot_error::Error.none;},global_bits item=>{return self_.knownGlobal(item.id,g.request_owner),blot_error::Error.none;},
 data item=>{if item.bytes.len%4!=0 {return false,blot_error::Error.none;}if item.address!=0 {return self_.admitSerialized(g,item.address,item.bytes.len);}},
 operation_symbol item=>{return self_.importer.admitOperation(g,item.id);},demand item=>{if item.kind==blot_reuse_artifact_emitter::ResourceKind.operation {return self_.importer.admitOperation(g,item.id);}},
