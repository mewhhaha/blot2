 for index in 0..first.b {let field=module.types.recordField(first,index);var common=true;for constructor_index in constructors {let error=proof.step(0);if error!=Error.none {return error;}let payload=module.types.node(module.constructors[constructor_index].payload);var found=false;if payload.tag==Tag.record {for ordinal in 0..payload.b {let error=proof.step(0);if error!=Error.none {return error;}if module.types.recordField(payload,ordinal).name==field.name {found=true;}}}if !found {common=false;}}if !common {continue;}if count>=output.b {return Error.invalid_artifact;}let published=module.types.recordField(output,count);let described=blot_check_typed_staging::descriptorInfo(module.types,published.ty);if !described.present || published.name!=field.name {return Error.invalid_artifact;}
 for constructor_index in constructors {let error=proof.step(0);if error!=Error.none {return error;}let constructor=module.constructors[constructor_index];let variables,error=proof.constructorVariables(family_index,constructor);if error!=Error.none {return error;}var bindings:u32[32]=[0;32];let arrow=module.types.node(constructor.scheme.root);if arrow.tag!=Tag.function {return Error.invalid_artifact;}let error=proof.matchType(arrow.b,target,variables,bindings,0);if error!=Error.none {return error;}for binding in bindings[..variables.len] {if binding==0 {return Error.invalid_artifact;}}let payload=module.types.node(constructor.payload);for ordinal in 0..payload.b {let error=proof.step(0);if error!=Error.none {return error;}let actual=module.types.recordField(payload,ordinal);if actual.name==field.name {let error=proof.matchType(actual.ty,described.value,variables,bindings,0);if error!=Error.none {return error;}}}}
 count+=1;}return require(count==output.b);
