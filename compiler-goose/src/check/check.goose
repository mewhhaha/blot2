    if !self.source_validation && tree.diagnostics.len==0 && !has_issue {
        for id in tree.roots.items {if tree.node(id).tag==blot_parse_ast::tag_value_decl && self.resolved[id]!=0 {self.root_global=self.resolved[id];let err=self.inferGlobal(self.resolved[id]);if err!=blot_error::Error.none {return err;}}}
        for declaration in self.implementations {if declaration.identity.unit!=unit {continue;}for member in self.implementation_members[declaration.members.start..declaration.members.start+declaration.members.len] {if member.kind!=blot_reuse_principal_interface::ImplementationMemberKind.value {continue;}self.root_global=member.target.binding;let err=self.inferGlobal(member.target.binding);if err!=blot_error::Error.none {return err;}}}self.root_global=0;
        for id in tree.roots.items {if tree.node(id).tag!=blot_parse_ast::tag_value_decl || !tree.value_decl(id).exported || self.resolved[id]==0 {continue;}let principal=self.bindings[self.resolved[id]].scheme;for constraint in self.obligations[principal.obligations.start..principal.obligations.start+principal.obligations.len] {if constraint.kind!=blot_check_types::ObligationKind.resolver_dispatch {continue;}let resolved,err=self.types.resolve(constraint.ty,0);if err!=blot_error::Error.none {return err;}let owner=self.types.node(resolved);if owner.tag!=blot_check_types::Tag.resolver {continue;}let resolved,err=self.types.resolve(owner.a,0);if err!=blot_error::Error.none {return err;}let token=self.types.node(resolved);if token.tag!=blot_check_types::Tag.type_constructor {continue;}if !self.catalogs.associated_members.contains(AssociatedMember{Identity{token.a,token.b},constraint.name}) {let err=self.diagnostic(Code.missing_member,constraint.source);if err!=blot_error::Error.none {return err;}}}}
