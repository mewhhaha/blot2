import public_interface;
import public_frontend;

fn main() {
    let source = "pub let f: U32 -> U32 ! {} resources {depth: 128, frame: 4294967295} = fn x => return x";
    let candidate = public_frontend::parse(source);
    assert(candidate.status == 0);
    var built = public_interface::build(source, candidate, "package@1", "src/main.blot", "f");
    assert(built.status == 0);
    assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 0);
    assert(built.interface.visibility == 1 && built.interface.declared_depth == 128 &&
        built.interface.declared_frame == 4294967295 && built.interface.actual_depth == 1 && built.interface.actual_frame == 0);
    let edited = "// moved origin\npub let f: U32 -> U32 ! {} resources {depth: 128, frame: 4294967295} = fn x => return 7";
    let edited_candidate = public_frontend::parse(edited);
    assert(edited_candidate.status == 0);
    assert(public_interface::check(edited, edited_candidate, "package@1", "src/main.blot", "f", built.interface) == 0);
    let changed_contract = "pub let f: U32 -> U32 ! {} resources {depth: 127, frame: 4294967295} = fn x => return x";
    let changed_candidate = public_frontend::parse(changed_contract);
    assert(changed_candidate.status == 0);
    assert(public_interface::check(changed_contract, changed_candidate, "package@1", "src/main.blot", "f", built.interface) == 1);
    var mutable_package: u8[>..] = []; mutable_package.append("package@1");
    var owned = public_interface::build(source, candidate, mutable_package, "src/main.blot", "f");
    assert(owned.status == 0); mutable_package[0] = 'X';
    assert(owned.interface.package_identity[0] == 'p');
    let bsource = "pub let p: U32 -> Bool ! {} resources {depth: 3, frame: 64} = fn x => return x < 1";
    let bcandidate = public_frontend::parse(bsource);
    var boolean = public_interface::build(bsource, bcandidate, "package@1", "src/main.blot", "p");
    assert(boolean.status == 0 && boolean.interface.result_type == 2);
    assert(public_interface::check(bsource, bcandidate, "package@1", "src/main.blot", "p", boolean.interface) == 0);
    assert(public_interface::build(source, candidate, "package@1", "src/main.blot", "wrong").status == 1);
    assert(public_interface::check(source, candidate, "wrong-package", "src/main.blot", "f", built.interface) == 1);
    assert(public_interface::check(source, candidate, "package@1", "src/other.blot", "f", built.interface) == 1);
    assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "other", built.interface) == 1);
    assert(public_interface::build(source, candidate, "", "src/main.blot", "f").status == 1);
    assert(public_interface::build(source, candidate, "package", "../main.blot", "f").status == 1);
    assert(public_interface::build(source, candidate, "package", "./main.blot", "f").status == 1);
    assert(public_interface::build(source, candidate, "package", "/main.blot", "f").status == 1);
    assert(public_interface::build(source, candidate, "package", "src//main.blot", "f").status == 1);
    assert(public_interface::build(source, candidate, "package", "src\\main.blot", "f").status == 1);
    assert(public_interface::build(source, candidate, "package", "C:/main.blot", "f").status == 1);
    let invalid: u8[] = [255];
    assert(public_interface::build(source, candidate, invalid[..], "src/main.blot", "f").status == 1);
    assert(public_interface::build(source, candidate, "package", invalid[..], "f").status == 1);
    assert(public_interface::build(source, candidate, "package", "src/main.blot", invalid[..]).status == 1);

    built.interface.schema = 2; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.schema = 1;
    built.interface.edition[0] = 'X'; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.edition[0] = 'k';
    built.interface.semantic_policy[0] = 'X'; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.semantic_policy[0] = 'K';
    built.interface.parameter_type = 2; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.parameter_type = 1;
    built.interface.parameter_count = 0; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.parameter_count = 1;
    built.interface.lifetime = 2; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.lifetime = 1;
    built.interface.binder_count = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.binder_count = 0;
    built.interface.capture_count = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.capture_count = 0;
    built.interface.precondition_count = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.precondition_count = 0;
    built.interface.postcondition_count = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.postcondition_count = 0;
    built.interface.on_true_count = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.on_true_count = 0;
    built.interface.on_false_count = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.on_false_count = 0;
    built.interface.dictionary_count = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.dictionary_count = 0;
    built.interface.layout_premise_count = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.layout_premise_count = 0;
    built.interface.data_identity_count = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.data_identity_count = 0;
    built.interface.visibility = 0; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.visibility = 1;
    built.interface.declared_depth = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.declared_depth = 128;
    built.interface.declared_frame = 0; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.declared_frame = 4294967295;
    built.interface.actual_depth = 2; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.actual_depth = 1;
    built.interface.actual_frame = 4; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.actual_frame = 0;
    built.interface.effect_bits = 1; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.effect_bits = 0;
    built.interface.call_mode = 2; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.call_mode = 1;
    built.interface.result_type = 2; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.result_type = 1;
    built.interface.package_identity[0] = 'X'; assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 1); built.interface.package_identity[0] = 'p';
    assert(public_interface::check(source, candidate, "package@1", "src/main.blot", "f", built.interface) == 0);
    assert(public_interface::check("pub let g: U32 -> U32 ! {} resources {depth: 128, frame: 4294967295} = fn x => return x", candidate, "package@1", "src/main.blot", "f", built.interface) == 1);
    assert(public_interface::check("pub let f: U32 -> U32 ! {} resources {depth: 128, frame: 4294967295} = fn x => return y", candidate, "package@1", "src/main.blot", "f", built.interface) == 1);
    var bad_candidate = candidate; bad_candidate.core.left_end += 1;
    assert(public_interface::build(source, bad_candidate, "package@1", "src/main.blot", "f").status == 1);
    assert(public_interface::check(source, bad_candidate, "package@1", "src/main.blot", "f", built.interface) == 1);
    print("public scalar interface candidate: passed");
}
