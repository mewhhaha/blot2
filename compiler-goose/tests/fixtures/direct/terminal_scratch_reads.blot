type World = { rows: Array U32, a: Array U32, b: Array U32, c: Array U32, d: Array U32, e: Array U32, f: Array U32, g: Array U32 }
func make (): World => return { rows: #[0, 0, 0], a: #[1], b: #[2], c: #[3], d: #[4], e: #[5], f: #[6], g: #[7] }
func step (world: own World) -> (width: U32) -> (seed: U32): World => return do:
  let scratch = @array.generate width (func (i: U32) => return seed + i)
  world.rows := #[seed, scratch[0], scratch[width - 1]]
  return world
func reuse (world: own World) -> (width: U32) -> (seed: U32): World => return do:
  let scratch = @array.generate width (func (i: U32) => return seed + i)
  world.rows[0] := seed
  world.rows[1] := scratch[0]
  world.rows[2] := scratch[width - 1]
  return world
entry func fresh (width: U32): U32 => return do:
  let world = make ()
  for tick in 0 .. 150:
    world := step world width tick
  return world.rows[0] + world.rows[1] + world.rows[2] + world.g[0]
entry func in_place (width: U32): U32 => return do:
  let world = make ()
  for tick in 0 .. 150:
    world := reuse world width tick
  return world.rows[0] + world.rows[1] + world.rows[2] + world.g[0]
entry func nested (width: U32): U32 => return do:
  let world = make ()
  for outer in 0 .. 30:
    for inner in 0 .. 5:
      world := step world width (outer * 5 + inner)
      if inner % 2 == 0:
        continue
  return world.rows[0] + world.rows[1] + world.rows[2] + world.g[0]
entry func future_read (width: U32): U32 => return do:
  let scratch = @array.generate width (func (i: U32) => return 9 + i)
  let copied = #[scratch[0], scratch[width - 1]]
  return scratch[1] + copied[0] + copied[1]
entry func later_capture (width: U32): U32 => return do:
  let scratch = @array.generate width (func (i: U32) => return 9 + i)
  let copied = #[scratch[0], scratch[width - 1]]
  let read = func (i: U32) => return scratch[i]
  return read 1 + copied[0] + copied[1]
entry func mapper_publication (width: U32): U32 => return do:
  let destination: Array (Array U32) = #[]
  let scratch = @array.generate width (func (i: U32) => return i + 9)
  @storage.push destination #[42]
  let copied = #[scratch[0], scratch[width - 1]]
  return destination[0][0] + copied[0] + copied[1]
entry func mapper_trap (width: U32): Array U32 => return do:
  let scratch = @array.generate width (func (i: U32) => return 4 / (width - 1) + i)
  return #[scratch[0], scratch[width - 1]]
func filled_pair (width: U32) -> (seed: U32): Array U32 => return do:
  let scratch: Array U32 = @array.fill width seed
  return #[scratch[0], scratch[width - 1]]
entry func nested_fill (width: U32): U32 => return do:
  let sum = 0
  for tick in 0 .. 150:
    if tick % 2 == 0:
      continue
    let rows = filled_pair width tick
    sum := sum + rows[0] + rows[1]
  return sum
entry func alias_result (width: U32): U32 => return do:
  let world = make ()
  for tick in 0 .. 150:
    world := step world width tick
  world.rows[2] := world.rows[2] + 5
  world.a := world.rows.copy
  return world.rows[2] + world.a[2] + world.g[0]
