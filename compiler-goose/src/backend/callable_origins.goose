enum Environment {zero,local {value: u32},data_word {value: u32}}
struct Construction {target: u32,kind: blot_backend_runtime_ir::TableKind,layout: u32,bytes: u32,local: blot_support::Option<u32> = blot_support::none<u32>(),allocation: blot_support::Option<i64> = blot_support::none<i64>(),end: i64,environment: Environment}
fn construction(module: const Module&,origin: blot_backend_wasm::TableOrigin) -> blot_support::Option<Construction> {
