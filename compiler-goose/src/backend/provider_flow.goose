        if !stack.valid || controls.len != 0 || (body.result != blot_backend_runtime_ir::VT_none && stack.items.len != 0 && stack.items[stack.items.len - 1].hasFrame()) {return false;}
        if !changed {if !stack_heads || source_count == 0 {return true;}guards.ensure(blot_backend_wasm::instructions(module,body));if !guards.graph.valid || !scopeRetirements(guards.graph,blot_backend_wasm::instructions(module,body),source_ids,retirements) {return false;}for index in 0..uses.len {uses[index] = borrowerSources(next_sources,outer_sources,uses[index]);}return protectedBorrowers(guards.graph,guards.reachable,uses,retirements);}
