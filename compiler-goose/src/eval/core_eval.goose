}
fn principalConstraintInquiry(context: PrincipalConstraintInquiry&,store: const blot_check_types::Store&) -> Error { let result,error=unknownPrincipalConstraintInner(context.region,context.graph,store,context.constraint); context.result=result; return error; }
fn unknownPrincipalConstraint(self: ClosureRegion&,graph: const PrincipalGraph&,c: Constraint) -> bool,Error { var context=PrincipalConstraintInquiry {self,graph,c}; let error=withPrincipalGraph<PrincipalConstraintInquiry,principalConstraintInquiry>(graph,context); return context.result,error; }
struct PrincipalBodyInquiry { region: ClosureRegion&,graph: const PrincipalGraph&,result: bool=false }
fn principalBodyInquiry(context: PrincipalBodyInquiry&,store: const blot_check_types::Store&) -> Error { let self: ClosureRegion&=context.region; let graph: const PrincipalGraph&=context.graph; let root,error=blot_reuse_principal_type_graph::matchesOpen(store,graph.root,store,graph.root,self.session.options.max_type_depth,self.session.options.max_values); if error!=Error.none||!root { return error; } for requirement in graph.requirements { let valid,e=unknownPrincipalConstraintInner(self,graph,store,requirement); if e!=Error.none||!valid { return e; } } for alias in graph.aliases { if alias.instance==alias.principal { continue; } let valid,e=blot_reuse_principal_type_graph::matchesOpen(store,alias.principal,store,alias.instance,self.session.options.max_type_depth,self.session.options.max_values); if e!=Error.none||!valid { return e; } } for function in graph.functions { let valid,e=blot_reuse_principal_type_graph::matchesOpen(store,function,store,function,self.session.options.max_type_depth,self.session.options.max_values); if e!=Error.none||!valid { return e; } } context.result=true; return Error.none; }
fn unknownPrincipalBody(self: ClosureRegion&,graph: const PrincipalGraph&) -> bool,Error { var context=PrincipalBodyInquiry {self,graph}; let error=withPrincipalGraph<PrincipalBodyInquiry,principalBodyInquiry>(graph,context); return context.result,error; }
fn principalDependencies(self: ClosureRegion&,first: const PrincipalGraph&,transitive: bool) -> Error { if self.session.principal_reads==null&&self.session.receipt_tape==null&&!recordingConstant(self.session) { return Error.none; } var pending: (const PrincipalGraph&)[>..<]=[]; var seen: dictionary<PrincipalGraphKey,bool>; pending.push(first); var edges=0; while pending.len!=0 { let graph: const PrincipalGraph&=pending[pending.len-1]; pending.resize(pending.len-1); if seen.contains(graph.key) { continue; } if seen.count>=self.session.options.max_values { return Error.type_limit; } seen.insert(graph.key,true);
  if self.session.principal_reads { if graph.untracked_reads { self.session.principal_reads.invalidate(blot_reuse_principal_inputs::Reason.call_read); } if graph.foreign_sources&&!graph.foreign_types_only { self.session.principal_reads.source_complete=false; } for target in graph.dependencies { let error=self.session.principal_reads.source(target); if error!=Error.none { return error; } } }
