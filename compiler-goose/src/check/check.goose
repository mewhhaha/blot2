 blot_backend_simd_intrinsics::Shape.binary,blot_backend_simd_intrinsics::Shape.compare => {return arrow2(self,vector,vector,output);},
 blot_backend_simd_intrinsics::Shape.shift,blot_backend_simd_intrinsics::Shape.broadcast => {return arrow2(self,vector,blot_check_types::u32_type,vector);},
 blot_backend_simd_intrinsics::Shape.reduce => {return self.types.function(vector,blot_check_types::boolean);},
