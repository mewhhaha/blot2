// Numeric authority is recomputed from executable guards and exact values.
namespace blot_check_numeric_proof_core;
type ModuleRef = blot_check_frozen_core_validation::ModuleRef;
import .frozen_core_validation;
import support.error;
import support.option;
import support.structural;
import .core;
import .check;
import .types;
import .numeric_proof_terms;
import .numeric_proof_headers;
import .numeric_proof_contracts;
import backend.scalar_ops;
import backend.runtime_ir;
import backend.collection_ops;
import backend.opaque_storage;
type Error = blot_error::Error;
type Module = blot_check_core::Module;
type Tag = blot_check_core::Tag;
type TypeTag = blot_check_types::Tag;
type Op = blot_check_core::Op;
type Term = blot_check_numeric_proof_terms::Term;
type TermTag = blot_check_numeric_proof_terms::Tag;
type TermKind = blot_check_numeric_proof_terms::Kind;
type Proposition = blot_check_numeric_proof_terms::Proposition;
type Relation = blot_check_numeric_proof_terms::Relation;
type Header = blot_check_numeric_proof_headers::Owned;
type Options = blot_check_numeric_proof_terms::Limits;
struct Value { operand: u32 = 0, proof: blot_support::Option<Proposition> = blot_support::none<Proposition>(), condition: u32 = 0, exits: bool = false }
struct Entry { binding: u32, value: Value }
struct Return { target: u32, value: Value }
enum Fact { order { value: Proposition }, unequal { value: blot_check_numeric_proof_contracts::Unequal } }
struct Condition { op: Op = Op.none, negated: bool = false, left: u32 = 0, right: u32 = 0, positive: blot_support::Option<Fact> = blot_support::none<Fact>(), negative: blot_support::Option<Fact> = blot_support::none<Fact>() }
enum SummaryInputs { parameters { bindings: const blot_check_core::Parameter[:], values: const Value[:] }, captures { entries: const Entry[:] }, locals { entries: const Entry[:], parent: const SummaryInputs& } }
fn SummaryInputs::lookup(self: SummaryInputs, binding: u32) -> blot_support::Option<Value> {
    match self {
        SummaryInputs.parameters input => { for parameter, index in input.bindings { if parameter.binding == binding { return blot_support::some(input.values[index]); } } },
        SummaryInputs.captures input => { var index = input.entries.len; while index != 0 { index -= 1; if input.entries[index].binding == binding { return blot_support::some(input.entries[index].value); } } },
        SummaryInputs.locals input => { var index = input.entries.len; while index != 0 { index -= 1; if input.entries[index].binding == binding { return blot_support::some(input.entries[index].value); } } return input.parent.lookup(binding); },
    } return blot_support::none<Value>();
}
struct PlanCheck { seen: bool = false, admitted: bool = false }
struct PlanLease { live: bool = false, generation: u64 = 0 }
reusable[] var plan_checks: PlanCheck[>..];
var plan_leases: PlanLease[>..<];
struct Plan { checks: PlanCheck[:] = [], visits: i64 = 0, lease: i64 = -1, generation: u64 = 0 }
fn plan(module: const Module&) -> Plan { var index: i64 = 0; while index < plan_leases.len && plan_leases[index].live { index += 1; } if index == plan_leases.len { plan_leases.append(PlanLease {}); } plan_leases[index].generation += 1; plan_leases[index].live = true; let checks = plan_checks.alloc_slice(module.nodes.len); for &check in checks { check = PlanCheck {}; } return Plan { checks: checks, lease: index, generation: plan_leases[index].generation }; }
fn Plan::deinit(self: Plan&) { if self.lease >= 0 && self.lease < plan_leases.len && plan_leases[self.lease].live && plan_leases[self.lease].generation == self.generation { plan_checks.free_slice(self.checks); plan_leases[self.lease].live = false; } self.checks = []; self.lease = -1; }
fn Plan::admits(self: const Plan&, id: u32) -> bool { return id < self.checks.len && self.checks[id].seen && self.checks[id].admitted; }
fn Plan::record(self: Plan&, id: u32, admitted: bool) -> Error { if id >= self.checks.len { return Error.invalid_artifact; } let entry .= self.checks[id]; if !entry.seen { entry.seen = true; entry.admitted = true; } entry.admitted = entry.admitted && admitted; return Error.none; }
fn Plan::clear(self: Plan&) { for &entry in self.checks { entry = PlanCheck {}; } }
fn kind(tag: TypeTag) -> blot_support::Option<TermKind> { match tag { TypeTag.unsigned32 => { return blot_support::some(TermKind.unsigned32); }, TypeTag.array => { return blot_support::some(TermKind.array); }, TypeTag.list => { return blot_support::some(TermKind.list); }, _ => { return blot_support::none<TermKind>(); }, } }
fn opaqueReferenceConstructor(module: const Module&, catalog: u32) -> bool { if catalog >= module.constructors.len { return false; } let constructor = module.constructor(catalog); if constructor.nominal >= module.nominals.len { return false; } let nominal = module.nominal(constructor.nominal); let constructors = module.nominalConstructors(constructor.nominal); return nominal.is_opaque && !nominal.affine && !nominal.has_usage && nominal.storage.kind == blot_backend_opaque_storage::Kind.reference && constructors.len == 1 && constructors[0] == catalog; }
fn opaqueReferenceBinding(module: const Module&, id: u32) -> blot_support::Option<u32> { let pattern = module.pattern(id); if pattern.tag != blot_check_core::PatternTag.constructor || pattern.b == 0 || !opaqueReferenceConstructor(module, pattern.a) { return blot_support::none<u32>(); } let payload = module.pattern(pattern.b); if payload.tag == blot_check_core::PatternTag.bind && payload.a != 0 { return blot_support::some(payload.a); } return blot_support::none<u32>(); }
fn opaqueReferenceResult(module: const Module&, binding: u32, arguments: i64) -> bool { if binding == 0 || binding >= module.bindings.len { return false; } var ty = module.bindings[binding].ty; var wrappers: i64 = 0; while module.types.node(ty).tag == TypeTag.forall { if wrappers == 128 { return false; } wrappers += 1; ty = module.types.node(ty).a; } for ignored in 0..arguments { let node = module.types.node(ty); if node.tag != TypeTag.function { return false; } ty = node.b; } let result = module.types.node(ty); if result.tag != TypeTag.nominal { return false; } for nominal, index in module.nominals { if nominal.identity.unit == result.a && nominal.identity.decl == result.b { let constructors = module.nominalConstructors(index as u32); return constructors.len == 1 && opaqueReferenceConstructor(module, constructors[0]); } } return false; }
fn contract(module: const Module&, binding: u32) -> const Header? { for value in module.proof_contracts { if value.binding == binding { return value.header; } } return null; }
fn resolved(source: const blot_check_types::Store&, id: u32) -> u32 { return source.head(id, 0); }
fn resolved(source: const blot_check_core::Types&, id: u32) -> u32 { return id; }
fn signatureTypes(source, root: u32, header: Header) -> Error { var ty = root; var wrappers: i64 = 0; while source.node(resolved(source, ty)).tag == TypeTag.forall { if wrappers == 128 { return Error.invalid_artifact; } wrappers += 1; ty = source.node(resolved(source, ty)).a; } var value_slot: i64 = 0; var proof_slot: i64 = 0;
    for slot in 0..header.arity { let arrow = source.node(resolved(source, ty)); if arrow.tag != TypeTag.function { return Error.invalid_artifact; } let input = source.node(resolved(source, arrow.a)).tag; let expected = kind(input); if expected.present { if value_slot >= header.value_slots.len || value_slot >= header.values.len || header.value_slots[value_slot] != slot || header.values[value_slot] != expected.value { return Error.invalid_artifact; } value_slot += 1; } else if input == TypeTag.erased_proof { if proof_slot >= header.proof_slots.len || header.proof_slots[proof_slot] != slot { return Error.invalid_artifact; } proof_slot += 1; } ty = arrow.b; }
    if value_slot != header.value_slots.len || proof_slot != header.proof_slots.len || (source.node(resolved(source, ty)).tag == TypeTag.erased_proof) != header.result.present { return Error.invalid_artifact; } return Error.none;
}
fn dataTypes(source, nodes: const blot_check_types::Node[:]) -> Error { for node in nodes { match node.tag {
    TypeTag.array, TypeTag.list, TypeTag.cursor, TypeTag.resolver, TypeTag.provider => { if source.node(node.a).tag == TypeTag.erased_proof { return Error.invalid_artifact; } },
    TypeTag.state_provider => { for child in [node.a, node.b, node.c] { if source.node(child).tag == TypeTag.erased_proof { return Error.invalid_artifact; } } },
    TypeTag.product => { for child in source.list(blot_check_types::List { node.a, node.b }) { if source.node(child).tag == TypeTag.erased_proof { return Error.invalid_artifact; } } },
    TypeTag.record => { for field in 0..node.b { if source.node(source.recordField(node, field).ty).tag == TypeTag.erased_proof { return Error.invalid_artifact; } } },
    TypeTag.nominal, TypeTag.projection => { for child in source.nominalArguments(node) { if source.node(child).tag == TypeTag.erased_proof { return Error.invalid_artifact; } } }, _ => {},
    } } return Error.none;
}
struct Selected { node: u32, target: blot_check_core::BindingRef }
struct Loop { source: u32, previous: Loop?, breaks: bool = false }
struct Target { module: const Module&, binding: u32 }
struct Checker {
    selected: const Selected[:] = [], module: const Module&, units: const ModuleRef[:], values: blot_check_numeric_proof_terms::Store,
    environment: Entry[>..<]&, returns: Return[>..<]&, plan: Plan? = null, facts: Fact[>..<]&, conditions: Condition[>..<]&,
    degraded: bool = false, event: u32 = 0, loop: Loop? = null
}
fn Checker::owner(self: const Checker&, unit: u32) -> const Module?, Error { if unit == 0 || unit == self.module.unit { return self.module, Error.none; } for module_owner_ref in self.units { let module: const blot_check_core::Module& = module_owner_ref.value; if module.unit == unit { return module, Error.none; } } return null, Error.invalid_artifact; }
fn Checker::target(self: const Checker&, raw: blot_check_core::BindingRef) -> Target, Error { let initial, err = self.owner(raw.unit); if err != Error.none { return Target { self.module, 0 }, err; } var module: const Module& = initial; var binding = raw.binding; for ignored in 0..128 { if binding == 0 || binding >= module.bindings.len { return Target { self.module, 0 }, Error.invalid_artifact; } let value = module.bindings[binding]; if value.kind != blot_check_check::Kind.external { return Target { module, binding }, Error.none; } if value.target.unit != 0 && value.target.unit != module.unit { let next, err = self.owner(value.target.unit); if err != Error.none { return Target { self.module, 0 }, err; } module .= next; } binding = value.target.binding; } return Target { self.module, 0 }, Error.invalid_artifact; }
fn Checker::lookup(self: const Checker&, binding: u32) -> blot_support::Option<Value> { var index = self.environment.len; while index != 0 { index -= 1; let entry = self.environment[index]; if entry.binding == binding { return blot_support::some(entry.value); } } return blot_support::none<Value>(); }
fn Checker::bind(self: Checker&, binding: u32, value: Value) -> Error { let err = self.values.charge(1); if err != Error.none { return err; } if self.environment.len >= self.values.limits.terms { return Error.proof_analysis_limit; } self.environment.append(Entry { binding, value }); return Error.none; }
fn Checker::version(self: Checker&, ty: u32, binding: u32) -> Value, Error { let operand_kind = kind(self.module.types.node(ty).tag); if !operand_kind.present { return Value {}, Error.none; } var term = Term { tag: TermTag.version, kind: operand_kind.value, a: binding, b: 1 }; if binding == 0 { if self.event == 0xffffffff { return Value {}, Error.proof_analysis_limit; } self.event += 1; term.a = self.event; term.b = 2; } let operand, err = self.values.intern(term); return Value { operand: operand }, err; }
fn ordinary(value: Value) -> Error { if value.proof.present { return Error.invalid_artifact; } return Error.none; }
fn Checker::proof(self: Checker&, actual: blot_support::Option<Proposition>, expected: Proposition) -> Error { if !actual.present { return Error.invalid_artifact; } if actual.value == expected { return Error.none; } let entailed, err = blot_check_numeric_proof_contracts::entails(self.values, [actual.value], expected); if err != Error.none { return err; } if !entailed { return Error.invalid_artifact; } return Error.none; }
fn factEqual(left: Fact, right: Fact) -> bool { match left { Fact.order a => { match right { Fact.order b => { return a.value == b.value; }, _ => { return false; }, } }, Fact.unequal a => { match right { Fact.unequal b => { return a.value == b.value; }, _ => { return false; }, } }, } }
fn Checker::fact(self: Checker&, value: Fact) -> Error { if !self.plan || self.degraded { return Error.none; } for prior in self.facts { if factEqual(prior, value) { return Error.none; } } if self.facts.len >= 256 { return Error.none; } let err = self.values.charge(1); if err != Error.none { return err; } self.facts.append(value); return Error.none; }
fn Checker::query(self: Checker&, goal: Proposition) -> bool, Error { if !self.plan || self.degraded { return false, Error.none; } var ordered: Proposition[256]; var unequal: blot_check_numeric_proof_contracts::Unequal[256]; var order_count: i64 = 0; var unequal_count: i64 = 0; for item in self.facts { match item { Fact.order payload => { ordered[order_count] = payload.value; order_count += 1; }, Fact.unequal payload => { unequal[unequal_count] = payload.value; unequal_count += 1; }, } } let result, err = blot_check_numeric_proof_contracts::entailsWithUnequal(self.values, ordered[..order_count], unequal[..unequal_count], goal); if err == Error.out_of_memory { return false, err; } if err == Error.proof_analysis_limit { self.degraded = true; } if err != Error.none { return false, Error.none; } return result, Error.none; }
fn Checker::condition(self: Checker&, value: Condition) -> u32, Error { if !self.plan { return 0, Error.none; } let err = self.values.charge(1); if err != Error.none { return 0, err; } if self.conditions.len >= self.values.limits.terms { return 0, Error.proof_analysis_limit; } self.conditions.append(value); return self.conditions.len as u32, Error.none; }
fn Checker::length(self: Checker&, value: Value) -> u32, Error { if value.operand == 0 { return 0, Error.invalid_proof_operand; } return self.values.intern(Term { tag: TermTag.length, a: value.operand }); }
fn Checker::order(self: Checker&, relation: Relation, left: u32, right: u32) -> Error { return self.fact(Fact.order { Proposition { relation, left, right } }); }
fn Checker::preserveLength(self: Checker&, id: u32, input: Value) -> Value, Error { let result, err = self.version(self.module.typeOf(id), 0); if err != Error.none { return result, err; } if result.operand != 0 && input.operand != 0 { let left, err = self.length(result); if err != Error.none { return result, err; } let right, err = self.length(input); if err != Error.none { return result, err; } let err = self.order(Relation.eq, left, right); if err != Error.none { return result, err; } } return result, Error.none; }
fn Checker::arithmeticIdentity(self: Checker&, op: Op, left: u32, right: u32) -> u32, Error { if left == 0 || right == 0 { return 0, Error.none; } let lhs, err = self.values.view().get(left); if err != Error.none { return 0, err; } let rhs, err = self.values.view().get(right); if err != Error.none { return 0, err; } if lhs.kind != TermKind.unsigned32 || rhs.kind != TermKind.unsigned32 { return 0, Error.none; }
    match op {
        Op.add, Op.sub, Op.bit_or, Op.bit_xor => { if rhs.tag == TermTag.literal && rhs.a == 0 { return left, Error.none; } if op != Op.sub && lhs.tag == TermTag.literal && lhs.a == 0 { return right, Error.none; } if (op == Op.sub || op == Op.bit_xor) && left == right { return self.values.intern(Term { tag: TermTag.literal, a: 0 }); } if op == Op.bit_or && left == right { return left, Error.none; } },
        Op.mul, Op.div => { if rhs.tag == TermTag.literal && rhs.a == 1 { return left, Error.none; } if op == Op.mul && lhs.tag == TermTag.literal && lhs.a == 1 { return right, Error.none; } },
        Op.bit_and => { if rhs.tag == TermTag.literal && rhs.a == 0xffffffff { return left, Error.none; } if lhs.tag == TermTag.literal && lhs.a == 0xffffffff { return right, Error.none; } if left == right { return left, Error.none; } },
        Op.shift_left, Op.shift_right => { if rhs.tag == TermTag.literal && rhs.a & 31 == 0 { return left, Error.none; } }, _ => {},
    } return 0, Error.none;
}
fn Checker::arithmetic(self: Checker&, id: u32, op: Op, left: Value, right: Value) -> Value, Error {
    let lhs, err = self.values.view().get(left.operand); if err != Error.none { return Value {}, err; } let rhs, err = self.values.view().get(right.operand); if err != Error.none { return Value {}, err; }
    if lhs.tag == TermTag.literal && rhs.tag == TermTag.literal { let value, err = blot_backend_scalar_ops::evaluate(op, blot_backend_scalar_ops::Value { blot_backend_runtime_ir::SC_u32, lhs.a }, blot_backend_scalar_ops::Value { blot_backend_runtime_ir::SC_u32, rhs.a }); if err != Error.none { return self.version(self.module.typeOf(id), 0); } if value.scalar == blot_backend_runtime_ir::SC_u32 { let operand, err = self.values.intern(Term { tag: TermTag.literal, a: value.bits }); return Value { operand: operand }, err; } }
    let identity, err = self.arithmeticIdentity(op, left.operand, right.operand); if err != Error.none { return Value {}, err; } if identity != 0 { return Value { operand: identity }, Error.none; } let result, err = self.version(self.module.typeOf(id), 0); if err != Error.none || (op != Op.add && op != Op.sub) { return result, err; }
    let zero, err = self.values.intern(Term { tag: TermTag.literal, a: 0 }); if err != Error.none { return result, err; } var fits = Relation.add_fits; if op == Op.sub { fits = Relation.sub_fits; } let fits, err = self.query(Proposition { fits, left.operand, right.operand }); if err != Error.none || !fits { return result, err; }
    if op == Op.add { let err = self.order(Relation.le, left.operand, result.operand); if err != Error.none { return result, err; } let err = self.order(Relation.le, right.operand, result.operand); if err != Error.none { return result, err; } let positive, err = self.query(Proposition { Relation.lt, zero, right.operand }); if err != Error.none { return result, err; } if positive { let err = self.order(Relation.lt, left.operand, result.operand); if err != Error.none { return result, err; } } let positive, err = self.query(Proposition { Relation.lt, zero, left.operand }); if err != Error.none { return result, err; } if positive { let err = self.order(Relation.lt, right.operand, result.operand); if err != Error.none { return result, err; } } }
    else { let err = self.order(Relation.le, result.operand, left.operand); if err != Error.none { return result, err; } let positive, err = self.query(Proposition { Relation.lt, zero, right.operand }); if err != Error.none { return result, err; } if positive { let err = self.order(Relation.lt, result.operand, left.operand); if err != Error.none { return result, err; } } } return result, Error.none;
}
fn Checker::assume(self: Checker&, id: u32, positive: bool, depth: i64) -> Error {
    if id == 0 || !self.plan || self.degraded { return Error.none; } if depth >= 128 { return Error.proof_analysis_limit; } let err = self.values.charge(1); if err != Error.none { return err; } let value = self.conditions[id - 1]; if value.negated { return self.assume(value.left, !positive, depth + 1); }
    if value.op == Op.none { var selected = value.negative; if positive { selected = value.positive; } if selected.present { return self.fact(selected.value); } return Error.none; }
    if (value.op == Op.and_ && positive) || (value.op == Op.or_ && !positive) { let err = self.assume(value.left, positive, depth + 1); if err != Error.none { return err; } return self.assume(value.right, positive, depth + 1); }
    let start = self.facts.len; let err = self.assume(value.left, positive, depth + 1); if err != Error.none { return err; } var first: Fact[>..<]; first.append(self.facts[start..]); self.facts.resize(start);
    let err = self.assume(value.left, !positive, depth + 1); if err != Error.none { return err; } let err = self.assume(value.right, positive, depth + 1); if err != Error.none { return err; } var second: Fact[>..<]; second.append(self.facts[start..]); self.facts.resize(start);
    for item in first { for other in second { if factEqual(item, other) { let err = self.fact(item); if err != Error.none { return err; } break; } } } return Error.none;
}
fn join(left: Value, right: Value, proof_result: bool) -> Value, Error { if left.exits { return right, Error.none; } if right.exits { return left, Error.none; } if proof_result { if !left.proof.present || !right.proof.present || left.proof.value != right.proof.value { return Value {}, Error.invalid_artifact; } return left, Error.none; } let err = ordinary(left); if err != Error.none { return Value {}, err; } let err = ordinary(right); if err != Error.none { return Value {}, err; } if left == right { return left, Error.none; } if left.operand == right.operand { return Value { operand: left.operand }, Error.none; } return Value {}, Error.none; }
fn Checker::operands(self: Checker&, children: const u32[:], depth: i64) -> Error { for child in children { let value, err = self.walk(child, depth + 1); if err != Error.none { return err; } let err = ordinary(value); if err != Error.none { return err; } } return Error.none; }
fn Checker::comparison(self: Checker&, op: Op, left: u32, right: u32) -> u32, Error {
    if left == 0 || right == 0 { return 0, Error.none; } let a, err = self.values.view().get(left); if err != Error.none { return 0, err; } let b, err = self.values.view().get(right); if err != Error.none { return 0, err; } if a.kind != TermKind.unsigned32 || b.kind != TermKind.unsigned32 { return 0, Error.none; }
    let forward = Fact.order { Proposition { Relation.lt, left, right } }; let backward = Fact.order { Proposition { Relation.le, right, left } }; let equal = Fact.order { Proposition { Relation.eq, left, right } }; let unequal = Fact.unequal { blot_check_numeric_proof_contracts::Unequal { left, right } }; var result = Condition {};
    match op {
        Op.less => { result.positive = blot_support::some(forward); result.negative = blot_support::some(backward); },
        Op.less_equal => { result.positive = blot_support::some(Fact.order { Proposition { Relation.le, left, right } }); result.negative = blot_support::some(Fact.order { Proposition { Relation.lt, right, left } }); },
        Op.greater => { result.positive = blot_support::some(Fact.order { Proposition { Relation.lt, right, left } }); result.negative = blot_support::some(Fact.order { Proposition { Relation.le, left, right } }); },
        Op.greater_equal => { result.positive = blot_support::some(backward); result.negative = blot_support::some(forward); },
        Op.equal => { result.positive = blot_support::some(equal); result.negative = blot_support::some(unequal); },
        Op.not_equal => { result.positive = blot_support::some(unequal); result.negative = blot_support::some(equal); }, _ => { return 0, Error.none; },
    } return self.condition(result);
}
fn Checker::summaryOperand(self: Checker&, module: const Module&, inputs: SummaryInputs, id: u32, depth: i64) -> u32, Error {
    if id == 0 || depth >= 32 { return 0, Error.none; } let err = self.values.charge(1); if err != Error.none { return 0, err; } let node = module.node(id);
    if node.tag == Tag.reference { let reference = module.reference(id); if reference.unit != 0 && reference.unit != module.unit { return 0, Error.none; } let value = inputs.lookup(reference.binding); if value.present { return value.value.operand, Error.none; } }
    if node.tag == Tag.constant && module.types.node(node.ty).tag == TypeTag.unsigned32 { return self.values.intern(Term { tag: TermTag.literal, a: node.a }); }
    if node.tag == Tag.scalar && node.c == 0 && module.types.node(node.ty).tag == TypeTag.unsigned32 && node.b != 0 { if module.types.node(module.typeOf(node.a)).tag != TypeTag.unsigned32 || module.types.node(module.typeOf(node.b)).tag != TypeTag.unsigned32 { return 0, Error.none; } let left, err = self.summaryOperand(module, inputs, node.a, depth + 1); if err != Error.none { return 0, err; } let right, err = self.summaryOperand(module, inputs, node.b, depth + 1); if err != Error.none { return 0, err; } return self.arithmeticIdentity(node.op, left, right); }
    if node.tag == Tag.construct && node.b != 0 && opaqueReferenceConstructor(module, node.a) { return self.summaryOperand(module, inputs, node.b, depth + 1); }
    if node.tag == Tag.call { let value, err = self.summaryInvocation(module, inputs, id, depth); return value.operand, err; }
    if node.tag == Tag.block_ { let value, err = self.summaryBlock(module, inputs, id, [], depth); return value.operand, err; }
    if node.tag == Tag.suite && module.children(id).len == 1 { return self.summaryOperand(module, inputs, module.children(id)[0], depth + 1); }
    if node.tag == Tag.array_op && module.arrayOperation(id) == blot_backend_collection_ops::Op.length { let children = module.children(id); if children.len != 1 { return 0, Error.none; } let operand, err = self.summaryOperand(module, inputs, children[0], depth + 1); if err != Error.none || operand == 0 { return 0, err; } let term, err = self.values.view().get(operand); if err != Error.none { return 0, err; } if term.kind != TermKind.array && term.kind != TermKind.list { return 0, Error.none; } return self.values.intern(Term { tag: TermTag.length, a: operand }); } return 0, Error.none;
}
fn Checker::summaryCall(self: Checker&, target: blot_check_core::BindingRef, actual: const Value[:], depth: i64) -> Value, Error {
    if depth >= 32 { return Value {}, Error.none; } let selected, err = self.target(target); if err != Error.none { return Value {}, err; } let binding = selected.module.bindings[selected.binding]; if binding.body_id == 0 || binding.body_id >= selected.module.bodies.len { return Value {}, Error.none; } let body .= selected.module.bodies[binding.body_id]; let parameters = selected.module.bodyParameters(body); if body.binding != selected.binding || !body.is_function || parameters.len > actual.len { return Value {}, Error.none; }
    for parameter, index in parameters { let err = self.values.charge(index + 1); if err != Error.none { return Value {}, err; } if parameter.binding == 0 { return Value {}, Error.none; } for prior in parameters[..index] { if prior.binding == parameter.binding { return Value {}, Error.none; } } }
    return self.summaryApplied(selected.module, SummaryInputs.parameters { parameters, actual[..parameters.len] }, body.root, actual[parameters.len..], depth + 1);
