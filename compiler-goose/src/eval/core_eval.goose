struct PrincipalProvider { generator: blot_backend_core_backend::Generator& }
struct PrincipalGraphProvider { generator: blot_backend_core_backend::Generator& }
enum CodeProjection { inactive,physical { value: blot_eval_specialization::PhysicalProjection },owned { value: blot_eval_specialization::OwnedProjection },static_code { value: blot_backend_core_backend::StaticCodeProjection } }
fn projectionOption(projection: CodeProjection?) -> blot_support::Option<CodeProjection> { if projection { return blot_support::some<CodeProjection>(projection); } return blot_support::none<CodeProjection>(); }
fn projectionBorrow(projection: const blot_support::Option<CodeProjection>&) -> CodeProjection? { if !projection.present { return null; } return projection.value; }
fn mapping(projection: CodeProjection,solver: blot_check_types::Store&,variable: u32,root: u32) -> Error {
 match projection { inactive=>{ abort("inactive code projection"); },physical p=>{ var selected=p.value;return selected.mapping(solver,variable,root); },owned p=>{ var selected=p.value;return selected.mapping(solver,variable,root); },static_code p=>{ var selected=p.value;return selected.mapping(solver,variable,root); }, }
}
fn instance(projection: CodeProjection,unit: u32,variable: u32) -> blot_support::Option<blot_check_types::NominalIdentity> { match projection { inactive=>{ abort("inactive code projection"); },owned p=>{ return p.value.instance(unit,variable); },_=>{ return blot_support::none<blot_check_types::NominalIdentity>(); }, } }
struct PrincipalGraphKey { target: Target,source_interface: bool,deferred_member: bool,options: Options }
struct PrincipalTypeImport { source: u32,graph: u32 }
struct PrincipalRowImport { source: u32,graph: u32 }
enum PrincipalAction { constraint { value: u32 },alias { value: u32 },function { value: u32 },reference { value: u32 } }
struct PrincipalGraph {
 owner_id: u64=blot_native::fresh_owner_id(),key: PrincipalGraphKey,leases: i64=1,retention_eligible: bool=false,
 types: blot_check_types::StoreSnapshot,node_count: i64=0,base_edge_count: i64=0,owned_bytes: i64=0,pool_index: i64=-1,root: u32=0,imports: const PrincipalTypeImport[:]=default<const PrincipalTypeImport[:]>(),rows: const PrincipalRowImport[:]=default<const PrincipalRowImport[:]>(),requirements: const Constraint[:]=default<const Constraint[:]>(),constraints: const Constraint[:]=default<const Constraint[:]>(),aliases: const DataAlias[:]=default<const DataAlias[:]>(),functions: const u32[:]=default<const u32[:]>(),arguments: const u32[:]=default<const u32[:]>(),references: const Target[:]=default<const Target[:]>(),actions: const PrincipalAction[:]=default<const PrincipalAction[:]>(),source_complete: bool=false,dependencies: const BindingRef[:]=default<const BindingRef[:]>(),plain_reads: const blot_reuse_specialization_receipt::PlainFact[:]=default<const blot_reuse_specialization_receipt::PlainFact[:]>(),untracked_reads: bool=false,foreign_sources: bool=false,foreign_types_only: bool=false
}
fn nodeCount(self_: const PrincipalGraph&) -> i64 { return self_.node_count; }
fn edgeCount(self_: const PrincipalGraph&) -> i64 {
 var count=self_.base_edge_count+self_.actions.len+self_.imports.len+self_.rows.len+self_.arguments.len+self_.aliases.len*2+self_.functions.len+self_.references.len+self_.dependencies.len+self_.plain_reads.len;
 for c in self_.constraints { count+=5+c.diagnostic_name.len; } for c in self_.requirements { count+=5+c.diagnostic_name.len; } return count;
}
fn retain(self_: PrincipalGraph&) { assert(self_.leases!=0x7fffffffffffffff); self_.leases++; }
fn hash(key: FieldKey) -> u64 { return ::hash_combine(::hash_combine(::hash(key.family),::hash(key.tag)),::hash(key.name)); }
fn hash(key: Target) -> u64 { return ::hash_combine(::hash(key.unit),::hash(key.binding)); }
fn hash(key: CallProofKey) -> u64 { return ::hash_combine(hash(key.target),::hash(key.evidence)); }
struct SessionBindingOffsetsBuffer { storage: i64[:]=default<i64[:]>(),items: i64[:]=default<i64[:]>(),len: i64=0,failure: Error=blot_error::Error.none }
reusable[] var pool_SessionBindingOffsetsBuffer: i64[>..]=[];
fn ensure(self_: SessionBindingOffsetsBuffer&,minimum: i64) -> Error { if self_.failure!=blot_error::Error.none { return self_.failure; } let error=blot_support_pooled_buffer::ensure(self_,minimum,pool_SessionBindingOffsetsBuffer); if error!=blot_error::Error.none { self_.failure=error; } return error; }
fn push(self_: SessionBindingOffsetsBuffer&,value: i64) { if self_.failure!=blot_error::Error.none { return; } self_.failure=blot_support_pooled_buffer::push(self_,value,pool_SessionBindingOffsetsBuffer); self_.len=self_.items.len; }
fn append(self_: SessionBindingOffsetsBuffer&,values: const i64[:]) { if self_.failure!=blot_error::Error.none { return; } self_.failure=blot_support_pooled_buffer::append(self_,values,pool_SessionBindingOffsetsBuffer); self_.len=self_.items.len; }
fn resize(self_: SessionBindingOffsetsBuffer&,length: i64) { blot_support_pooled_buffer::resize(self_,length); self_.len=length; }
fn resize(self_: SessionBindingOffsetsBuffer&,length: i64,value: i64) { if length<=self_.len { resize(self_,length); return; } let error=ensure(self_,length); if error!=blot_error::Error.none { return; } for index in self_.len..length { self_.storage[index]=value; } self_.items=self_.storage[..length]; self_.len=length; }
fn clear(self_: SessionBindingOffsetsBuffer&) { blot_support_pooled_buffer::clear(self_); self_.len=0; self_.failure=blot_error::Error.none; }
fn deinit(self_: SessionBindingOffsetsBuffer&) { blot_support_pooled_buffer::deinit(self_,pool_SessionBindingOffsetsBuffer); self_.len=0; self_.failure=blot_error::Error.none; }
