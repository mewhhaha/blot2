        let outline_trace = blot_phase_profile::region("owned.outline",entry,0,0); let outlined,outline_error = outlining.finalize(); outline_trace.exit(); if outline_error != blot_error::Error.none { if outline_error == blot_error::Error.out_of_memory { return blot_backend_core_backend::emptyResult(workspace),outline_error; } return scopedFailure(workspace,entry,"Scoped helpers exceeded their checked machine-state or engine limits",work),blot_error::Error.none; }
