import tests.frontend_lifecycle_test;
fn test_frontend_graph_domains() {
    var source: u8[>..] = []; assert(read_file("examples/graph.blot", source)); frontend_planned(source, true, 0);
    var two: u8[>..] = []; two.append(source); two.append("\nlet bad: forall [r:Region] => (Graph[r,U32],Graph[r,U32]) -> U32 ! {read r} resources {depth:1,frame:4096} = fn (first,second) => return open first as [d1,n1,e1,m1] a in do:\n  break open second as [d2,n2,e2,m2] z in do:\n    if m1>0:\n      let endpoint = a.edges[0]\n      break z.nodes[endpoint.0]\n    break 0\n"); frontend_planned(two, false, FE_DOMAIN);
    let constructor = "type One[r:Region] = exists [d:Domain] => View[r,U32,1,d]\nlet make: forall [r:Region] => Dest[r,U32,1] -> One[r] ! {write r} resources {depth:1,frame:1024} = fn dst => return open array.in(dst,#[1]) as [d] values in do:\n  break pack [d] as One[r] values\n";
    var same_site: u8[>..] = []; same_site.append(constructor); same_site.append("let bad: forall [r:Region] => (Dest[r,U32,1],Dest[r,U32,1]) -> U32 ! {read r,write r} resources {depth:2,frame:4096} = fn (first,second) => do:\n  let p = make@[r](first)\n  let q = make@[r](second)\n  return open p as [d1] a in do:\n    break open q as [d2] z in do:\n      case index.try_make(a,0):\n        #None => break 0\n        #Some(endpoint) => break z[endpoint]\n"); frontend_planned(same_site, false, FE_DOMAIN);
    var iteration: u8[>..] = []; iteration.append(constructor); iteration.append("let bad: forall [r:Region] => (One[r],One[r]) -> U32 ! {read r} resources {depth:1,frame:4096} = fn (first,second) => return open first as [d1] a in do:\n  case index.try_make(a,0):\n    #None => break 0\n    #Some(endpoint) => do:\n      let total = for i in 0..2 carry (acc=0) do:\n        let value = open second as [d2] z in do:\n          break z[endpoint]\n        next (U32.wrapping_add(acc,value))\n      break total\n"); frontend_planned(iteration, false, FE_DOMAIN);
}
fn test_frontend_generic_layout_obligations() {
    var positive: u8[>..] = []; assert(read_file("examples/generic_result.blot", positive)); frontend_planned(positive, true, 0);
    var negative: u8[>..] = []; negative.append("type Wide = ("); for i in 64 { if i != 0 { negative.append(","); } negative.append("U32"); } negative.append(")\nlet choose: forall [T:Type] => T -> Result[T,Unit] ! {} resources {depth:1,frame:1024} = fn value => return #Ok(value)\nlet bad: Wide -> Result[Wide,Unit] ! {} resources {depth:2,frame:4096} = fn value => return choose@[Wide](value)\n");
    with_core() { b => var work = Work { .. }; var diagnostics: Diagnostic[>..] = []; let completed = frontend_complete(negative, "layout-negative", b, work, diagnostics); if !completed { print("layout completion ", diagnostics); } assert(completed); let ok = build_plans(b, "", diagnostics); if ok || diagnostics.len == 0 || validator::validator_diagnostic_name(diagnostics[0].code) != "k1_layout_limit" && diagnostics[0].code != 4012 { print("layout plan ", ok, " ", diagnostics); } assert(!ok); assert(diagnostics.len != 0); assert(diagnostics[0].code == 4012 || validator::validator_diagnostic_name(diagnostics[0].code) == "k1_layout_limit"); }
}
