 match producer.types.row(declared.c).tail {blot_check_effects::Tail.variable value=>{var ordinal:i64=-1;for variable,index in producer.types.list(body.scheme.row_variables) {if variable==value.value {ordinal=index;break;}}if ordinal>=0 {let principal .= instance;if !principal {return Error.invalid_artifact;}let witness=principal.scheme_row_witnesses[ordinal];if !witness.present {return Error.invalid_artifact;}for label,index in module.types.rowLabels(witness.value.row) {if witness.value.excluded.isSet(index) {continue;}let error=effects.consumeTarget(module.types.operations[label],used);if error!=Error.none {return error;}}}},_=>{},}
 if ambient.present {let row=ambient.value;let labels=module.types.effects.labels[row.labels.start..row.labels.start+row.labels.len];var allowed:bool[256]=[false;256];if labels.len>allowed.len {return Error.invalid_artifact;}for label,index in module.types.rowLabels(arrow.c) {if effects.seen[index] {continue;}for actual,ordinal in labels {if allowed[ordinal] {continue;}let same,error=effects.sameOperation(module.types.operations[label],module.types.operations[actual]);if error!=Error.none {return error;}if !same {continue;}allowed[ordinal]=true;effects.seen[index]=true;break;}}}for seen in effects.seen[..effects.target.labels.len] {if !seen {return Error.invalid_artifact;}}signature=arrow.b;formal=declared.b;
 }return Error.none;
}
fn quoteEffects(module:const Module&,quote:blot_check_core::Node,closed_rows:List,remaining:i64&)->Error {return quoteEffectsContext(module,[],quote,closed_rows,remaining);}
fn evaluateEffects(module:const Module&,units:const ModuleRef[:],node:blot_check_core::Node,closed_rows:List,remaining:i64&,workspace:Workspace?)->Error {var effects=Effects{workspace:workspace,m:module,units:units,target_module:module,target:blot_check_effects::Row{labels:List{..},tail:blot_check_effects::Tail.closed, ..},closed_rows:closed_rows,remaining:remaining, ..};return effects.visit(node.a,0);}
fn quoteEffectsContext(module:const Module&,units:const ModuleRef[:],quote:blot_check_core::Node,closed_rows:List,remaining:i64&)->Error {return quoteEffectsContextWorkspace(module,units,quote,closed_rows,remaining,null);}
fn quoteEffectsContextWorkspace(module:const Module&,units:const ModuleRef[:],quote:blot_check_core::Node,closed_rows:List,remaining:i64&,workspace:Workspace?)->Error {let shape=blot_check_typed_staging::codeInfo(module.types,quote.ty);if !shape.present {return Error.invalid_artifact;}if module.typeOf(quote.a)!=blot_check_types::never {let error=requireEqualRows(module,shape.value.result,module.typeOf(quote.a),closed_rows,remaining);if error!=Error.none {return error;}}let target=module.types.effects.node(shape.value.effects);if target.labels.len>256 || target.tail==blot_check_effects::Tail.parameter {return Error.invalid_artifact;}var effects=Effects{workspace:workspace,m:module,units:units,target_module:module,target:target,closed_rows:closed_rows,remaining:remaining, ..};let error=effects.visit(quote.a,0);if error!=Error.none {return error;}for seen in effects.seen[..target.labels.len] {if !seen {return Error.invalid_artifact;}}return Error.none;}
fn descriptorFields(module:const Module&,target:u32,output:blot_check_types::Node,remaining:i64&)->Error {
