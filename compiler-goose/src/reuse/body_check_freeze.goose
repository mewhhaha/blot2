fn capture(tree:const Tree&,pool:const Pool&,text:const u8[:],checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>)->Cache,Error {
 let value,error=initPooled();if error!=blot_error::Error.none {return Cache{..},error;}var result=value;let error=captureInto(tree,pool,text,checked,names,result);if error!=blot_error::Error.none {result.deinit();return Cache{..},error;}return result,blot_error::Error.none;
}
fn captureInto(tree:const Tree&,pool:const Pool&,text:const u8[:],checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>,cache:Cache&)->Error {return captureIntoResolved(tree,pool,text,checked,names,blot_support::none<AnnotationLookup>(),cache);}
fn captureIntoResolved(tree:const Tree&,pool:const Pool&,text:const u8[:],checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>,annotations:blot_support::Option<AnnotationLookup>,cache:Cache&)->Error {
 if checked.diagnostics.len!=0 || text.len==0 {return blot_error::Error.none;}{ let propagated_error = cache.compact(); if propagated_error != blot_error::Error.none { return propagated_error; } }var bodies=FreezeBodies{..};let error=captureCandidates(tree,pool,text,checked,names,annotations,cache,bodies);for &body in bodies.items {body.deinit();}bodies.deinit();return error;
}
fn captureCandidates(tree:const Tree&,pool:const Pool&,text:const u8[:],checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>,annotations:blot_support::Option<AnnotationLookup>,cache:Cache&,bodies:FreezeBodies&)->Error {
 for root in tree.roots.items {if tree.node(root).tag!=blot_parse_ast::tag_value_decl || cache.find(pool.get(tree.value_decl(root).name))!=null {continue;}let node_owner,present=blot_parse_ast::declaration_nodes(tree,root);if !present || node_owner.len<cache.minimum_nodes {continue;}let shape,error=syntax(tree,pool,root);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }if !shape.present {continue;}if shape.value.ids.len<cache.minimum_nodes {releaseSyntax(shape.value);continue;}
 let body,error=captureBody(tree,pool,text,checked,root,shape.value,names,annotations);releaseSyntax(shape.value);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }if body.present {let pushed=bodies.push(body.value);if pushed!=blot_error::Error.none {var failed=body.value;failed.deinit();return pushed;}}}
