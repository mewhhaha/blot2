fn collectPackagePack(self: ClosureRegion&,scope: u32,id: u32,work: CollectionWork&) -> Error { let module=self.session.units[self.scratch.sources[scope].owner]; let n=module.node(id); let imported,error=importType(self,scope,n.ty,0); if error!=Error.none { return error; } let package=self.solver.node(imported); if package.tag!=TypeTag.existential||package.c!=n.c { return Error.unresolved_type; } var witnesses: u32[>..<]=[]; for ty in module.types.list(blot_check_types::List {n.b,n.c}) { let actual,e=importType(self,scope,ty,0); if e!=Error.none { return e; } witnesses.push(actual); } let payload,e=self.solver.substitute(package.a,self.solver.list(blot_check_types::List {package.b,package.c}),witnesses); if e!=Error.none { return e; } let normalized=normalizePackPayload(self,scope,id,payload); if normalized!=Error.none { return normalized; } let instance,e2=importType(self,scope,module.typeOf(n.a),0); if e2!=Error.none { return e2; } let aliased=appendAlias(self,DataAlias {instance,payload}); if aliased!=Error.none { return aliased; } return work.append(n.a); }
