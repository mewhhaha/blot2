    for index in 0..words.len/2 {if words[index*2]>=owner.types.nodes.len || words[index*2+1]>=owner.types.nodes.len {return Error.invalid_artifact;}let scope=owner.types.node(words[index*2+1]);if scope.tag!=TypeTag.scoped || scope.b!=0 || scope.c>=owner.types.nodes.len {return Error.invalid_artifact;}let term=owner.types.node(scope.c);if term.tag!=TypeTag.instance_selection {return Error.invalid_artifact;}if term.a!=selection.a || term.b!=selection.b {continue;}let arrow=owner.types.node(words[index*2]);let called=owner.types.node(declaring);if arrow.tag!=TypeTag.function {return Error.invalid_artifact;}let a,ae=blot_check_rank_equal::equal(owner.types,arrow.a,called.a,true);let b,be=blot_check_rank_equal::equal(owner.types,arrow.b,called.b,true);if ae!=Error.none || be!=Error.none || !a || !b {continue;}let left,err=blot_check_generative_relocation::labels(owner.types,arrow.c);if err!=Error.none {return err;}let right,err=blot_check_generative_relocation::labels(owner.types,called.c);if err!=Error.none {return err;}if left!=right {continue;}
        var actual=call.signature;for argument in call.arguments[..call.len] {if actual>=self.module.types.nodes.len {return Error.invalid_artifact;}let parameter=self.module.types.node(actual);let equal,err=self.same(parameter.a,self.module.node(argument).ty);if err!=Error.none || parameter.tag!=TypeTag.function || !equal {return Error.invalid_artifact;}actual=parameter.b;}
        var map,err=blot_check_generative_relocation::init(owner,self.module,scheme,call.signature,self.module.node(id).ty,call.len,self.module.span(id).end+1);if err!=Error.none {return err;}return map.applications(id);
