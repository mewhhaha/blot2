    for merge in self_.module.branchMerges(id) { var then_value = self_.lookup(merge.then_binding); var else_value = self_.lookup(merge.else_binding); for entry in left_bindings.items { if entry.binding == merge.then_binding { then_value = blot_support::some(entry.value); } } for entry in right_bindings.items { if entry.binding == merge.else_binding { else_value = blot_support::some(entry.value); } } var a = Value {..}; var b = Value {..}; if then_value.present { a = then_value.value; } if else_value.present { b = else_value.value; }
