// Structural equality is opt-in for application data. This contract lives in
// an explicit module so unrelated projects keep the small bootstrap prelude.
type Eq a is contract = { const eq: a -> a -> Bool }
const eq: a -> a -> Bool where { Eq a } = func left -> right => return Eq.eq left right

impl Boolean : Eq Bool = {
  const eq = func left -> right => return Bool.eq left right,
}
impl Unsigned : Eq U32 = {
  const eq = func left -> right => return U32.eq left right,
}
impl Float : Eq F32 = {
  const eq = func left -> right => return F32.eq left right,
}

const equal_array: Array a -> Array a -> Bool where { Eq a } = func left -> right => return do:
  if left.length != right.length:
    break false
  let same = true
  for index in 0..left.length:
    if Bool.not (Eq.eq left[index] right[index]):
      same := false
  break same
impl Sequence a : Eq (Array a) where { Eq a } = {
  const eq = func left -> right => return equal_array left right,
}
