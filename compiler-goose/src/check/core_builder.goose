 // Execution looks up constructor signatures in the defining module. Local
 // payload IDs still describe field layout to ownership checking and lowering.
 for metadata in self_.source.checked.constructors {
  var scheme=blot_check_types::Scheme{};
  if !declared_signatures_only || metadata.identity.unit==self_.source.checked.unit {
   let projected,error=self_.projectConstructorScheme(metadata);
   if error!=blot_error::Error.none {return error;}
   scheme=projected;
  }
