// Push N records into pre-sized capacity (`Array.with_capacity`, matching Rust's
// `Vec::with_capacity` and C++'s `vector::reserve`) while keeping indices to
// every 64th one.
import * as rng from "./rng"

const BENCH_N: U32 = 1000000 // BENCH_N

type Item is data = $Item { key: U32, val: U32 }

io bench (): #[U32] =>
  let items: #[Item] = Array.with_capacity BENCH_N
  let marks: #[U32] = Array.with_capacity ((BENCH_N >> 6) + 1)
  let r: U64 = 12345u64
  for i in 0 .. BENCH_N:
    r := rng.xs_next self
    items := self.push ($Item { key: (r % 1000000u64).to_u32, val: i % 97 })
    if (i & 63) == 0:
      marks := self.push i

  let total: I64 = 0i64
  for i in 0 .. BENCH_N:
    total := self + items[i].key.to_i64

  let mt: I64 = 0i64
  for i in 0 .. marks.length:
    mt := self + items[marks[i]].val.to_i64

  let out: #[U32] = #[]
  out := rng.emit_u32 self items.length
  out := rng.emit_u32 self marks.length
  out := rng.emit_i64 self total
  out := rng.emit_i64 self mt
  return out
