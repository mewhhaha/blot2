fn simdLanes(self: Session&,owner: i64,id: u32,vector: ValueId) -> Value[4],Error { var lanes: Value[4]; if vector==0||valueInfo(self,vector).kind!=ValueKind.product||valueInfo(self,vector).len!=4 { return lanes,failNode(self,owner,id,Code.unsupported); } for child,index in valueChildren(self,vector)[..4] { let lane,error=requireScalar(self,owner,id,child); if error!=Error.none { return lanes,error; } lanes[index]=lane; } return lanes,Error.none; }
fn simdPair(self: Session&,owner: i64,id: u32,pair: ValueId) -> Value[4][2],Error { var lanes: Value[4][2]; if pair==0||valueInfo(self,pair).kind!=ValueKind.product||valueInfo(self,pair).len!=2 { return lanes,failNode(self,owner,id,Code.unsupported); } let children=valueChildren(self,pair); let first,e=simdLanes(self,owner,id,children[0]); if e!=Error.none { return lanes,e; } let second,e2=simdLanes(self,owner,id,children[1]); if e2!=Error.none { return lanes,e2; } lanes[0]=first; lanes[1]=second; return lanes,Error.none; }
fn simdValue(self: Session&,owner: i64,id: u32,op: blot_check_core::Op,left: ValueId,right: ValueId) -> ValueId,Error {
 let a,error=simdLanes(self,owner,id,left); if error!=Error.none { return 0,error; } var lanes: Value[4];
 if op==blot_check_core::Op.any_true||op==blot_check_core::Op.all_true { var count: u32=0; for lane in a { if lane.bits!=0 { count++; } } var truth=count==4; if op==blot_check_core::Op.any_true { truth=count!=0; } var bits: u32=0; if truth { bits=1; } return makeScalar(self,owner,id,Value {blot_backend_runtime_ir::SC_bool,bits}); }
 else if op==blot_check_core::Op.bit_not||op==blot_check_core::Op.bits||op==blot_check_core::Op.from_bits { for item,index in a { var scalar=blot_backend_runtime_ir::SC_u32; var bits=item.bits; if op==blot_check_core::Op.from_bits { scalar=blot_backend_runtime_ir::SC_f32; } if op==blot_check_core::Op.bit_not { bits=~bits; } lanes[index]=Value {scalar,bits}; } }
 else if op==blot_check_core::Op.shift_left||op==blot_check_core::Op.shift_right||op==blot_check_core::Op.shift_right_signed||op==blot_check_core::Op.broadcast { let count,e=requireScalar(self,owner,id,right); if e!=Error.none { return 0,e; } if count.scalar!=blot_backend_runtime_ir::SC_u32 { return 0,failNode(self,owner,id,Code.unsupported); } if op==blot_check_core::Op.broadcast&&count.bits>=blot_backend_simd_intrinsics::laneLimit(op) { return 0,failNode(self,owner,id,Code.simd_lane_literal); } for item,index in a { let shift=count.bits&31; var bits: u32=0; if op==blot_check_core::Op.shift_left { bits=item.bits<<shift; } else if op==blot_check_core::Op.shift_right { bits=item.bits>>shift; } else if op==blot_check_core::Op.shift_right_signed { bits=blot_native::i32_bits(blot_native::i32_from_bits(item.bits)>>shift); } else { bits=a[count.bits].bits; } lanes[index]=Value {item.scalar,bits}; } }
