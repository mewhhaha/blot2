 let inputs=blot_reuse_constant_receipt::Inputs {mappings,rows}; let recordable=blot_reuse_constant_receipt::recordable(module,body.root,body.scheme.root); var context=ConstantRun {self,resolved,body,frame,reference,inputs,recordable,blot_support::none<ValueId>(),blot_support::none<blot_reuse_constant_receipt::Record>()}; defer { if context.pending.present { context.pending.value.deinit(); } }
 if recordable { if self.constant_provider_enabled&&self.generator { let completed,error=self.generator.constantLookup(self,reference,inputs); if error!=Error.none { return 0,error; } if completed.present { context.outcome=blot_support::some(completed.value.value); mappings.resize(0); rows.resize(0); mappings.append(completed.value.outputs.types); rows.append(completed.value.outputs.rows); } } if self.constant_receipt_retry { return 0,Error.declined; } }
 if !context.outcome.present { let error=blot_reuse_constant_receipt::withRecorder(self,context,runConstantRecording); if error!=Error.none { return 0,error; } }
