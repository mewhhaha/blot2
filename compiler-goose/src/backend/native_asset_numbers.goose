fn hexadecimal(text: const u8[:]) -> f64,bool {
    var at: i64 = 0;var negative = false;if at < text.len && (text[at] == '-' || text[at] == '+') {negative = text[at] == '-';at++;}if at + 2 > text.len || text[at] != '0' || (text[at + 1] != 'x' && text[at + 1] != 'X') {return 0.0,false;}at += 2;var numerator = Big {..};var any = false;var nonzero = false;var point = false;var significant: i64 = 0;var kept: i64 = 0;var fraction: i64 = 0;var sticky = false;var integer: u64 = 0;var integer_overflow = false;
    while at < text.len {let byte = text[at];if byte == '.' && !point {point = true;at++;continue;}let value,valid = hexDigit(byte);if !valid {break;}any = true;if point {fraction++;}if value != 0 {nonzero = true;}if nonzero {significant++;if kept < 1152 {numerator.multiplyAdd(16,value);kept++;}else if value != 0 {sticky = true;}}if !integer_overflow {if integer > (18446744073709551615 - value) / 16 {integer_overflow = true;}else {integer = integer * 16 + value;}}at++;}
    if !any {return 0.0,false;}var exponent: i64 = 0;var exponent_negative = false;var has_exponent = false;if at < text.len && (text[at] == 'p' || text[at] == 'P') {has_exponent = true;at++;if at < text.len && (text[at] == '-' || text[at] == '+') {exponent_negative = text[at] == '-';at++;}let start = at;while at < text.len && digit(text[at]) {if exponent < 1000000000 {exponent = min(exponent * 10 + (text[at] - '0') as i64,1000000000);}at++;}if start == at {return 0.0,false;}}if at != text.len || (point && !has_exponent) {return 0.0,false;}if !has_exponent {if integer_overflow {return 0.0,false;}var result = integer as! f64;if negative {result = -result;}return result,true;}if exponent_negative {exponent = -exponent;}var sign: u64 = 0;if negative {sign = 9223372036854775808;}if !nonzero {return blot_native::f64_from_bits(sign),true;}let order = exponent - fraction * 4 + significant * 4;if order > 1200 {return blot_native::f64_from_bits(sign | 9218868437227405312),true;}if order < -1200 {return blot_native::f64_from_bits(sign),true;}let power = exponent - fraction * 4 + (significant - kept) * 4;var denominator = Big {..};denominator.multiplyAdd(1,1);if power >= 0 {numerator = numerator.shifted(power);}else {denominator = denominator.shifted(-power);}return ratio(numerator,denominator,negative,sticky),true;
