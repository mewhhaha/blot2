struct State { proofs: ProofsBuffer=ProofsBuffer {},arguments: ArgumentsBuffer=ArgumentsBuffer {},members: MembersBuffer=MembersBuffer {},edges: ArgumentsBuffer=ArgumentsBuffer {},active_arguments: ArgumentsBuffer=ArgumentsBuffer {},active: ActiveBuffer=ActiveBuffer {},active_projections: ActiveProjectionsBuffer=ActiveProjectionsBuffer {},provisional_equations: ProvisionalEquationsBuffer=ProvisionalEquationsBuffer {},provisional_mappings: ProvisionalMappingsBuffer=ProvisionalMappingsBuffer {},provisional_rows: ProvisionalRowsBuffer=ProvisionalRowsBuffer {},next: ArgumentsBuffer=ArgumentsBuffer {},active_facts: ActiveFactsBuffer=ActiveFactsBuffer {},buckets: BucketsMap=BucketsMap {},facts: FactsMap=FactsMap {},owner_id: u64=0,trace: blot_eval_implementation_trace::Record=blot_eval_implementation_trace::Record {..},failure: blot_support::Option<Code> =blot_support::none<Code>(),candidates: u64=0,prerequisite_edges: u64=0,hits: u64=0,max_depth: i64=0,generation: u64=0,live: bool=false }
reusable var states: State[>..]=[];
var inactive: State=State {};
var next_generation: u64=1;
struct Store { proofs: ProofsBuffer& =inactive.proofs,arguments: ArgumentsBuffer& =inactive.arguments,members: MembersBuffer& =inactive.members,edges: ArgumentsBuffer& =inactive.edges,active_arguments: ArgumentsBuffer& =inactive.active_arguments,active: ActiveBuffer& =inactive.active,active_projections: ActiveProjectionsBuffer& =inactive.active_projections,provisional_equations: ProvisionalEquationsBuffer& =inactive.provisional_equations,provisional_mappings: ProvisionalMappingsBuffer& =inactive.provisional_mappings,provisional_rows: ProvisionalRowsBuffer& =inactive.provisional_rows,next: ArgumentsBuffer& =inactive.next,active_facts: ActiveFactsBuffer& =inactive.active_facts,buckets: BucketsMap& =inactive.buckets,facts: FactsMap& =inactive.facts,owner_id: u64& =inactive.owner_id,trace: blot_eval_implementation_trace::Record& =inactive.trace,failure: blot_support::Option<Code>& =inactive.failure,candidates: u64& =inactive.candidates,prerequisite_edges: u64& =inactive.prerequisite_edges,hits: u64& =inactive.hits,max_depth: i64& =inactive.max_depth,lease: u32=0,generation: u64=0,handle_index: i64=-1 }
reusable var handles: Store[>..]=[];
fn initPooled() -> Store,Error { if next_generation==0xffffffffffffffff||states.len>=0xffffffff { return Store {},blot_error::Error.out_of_memory; } let generation=next_generation; next_generation++; let index=states.alloc_index(State {owner_id:blot_native::fresh_owner_id(),generation:generation,live:true}); let state: State& =states[index]; return Store {proofs:state.proofs,arguments:state.arguments,members:state.members,edges:state.edges,active_arguments:state.active_arguments,active:state.active,active_projections:state.active_projections,provisional_equations:state.provisional_equations,provisional_mappings:state.provisional_mappings,provisional_rows:state.provisional_rows,next:state.next,active_facts:state.active_facts,buckets:state.buckets,facts:state.facts,owner_id:state.owner_id,trace:state.trace,failure:state.failure,candidates:state.candidates,prerequisite_edges:state.prerequisite_edges,hits:state.hits,max_depth:state.max_depth,lease:(index+1) as u32,generation:generation},blot_error::Error.none; }
fn initPooledRef() -> Store?,Error { let initialized,error=initPooled(); if error!=blot_error::Error.none { return null,error; } let at=handles.alloc_index(initialized); handles[at].handle_index=at; return handles[at],blot_error::Error.none; }
fn withStore<C,F>(context:C&) -> Error { let initialized,error=initPooled(); if error!=blot_error::Error.none { return error; } var store=initialized; let result=F(context,store); store.deinit(); return result; }
fn valid(self_: Store) -> bool { return self_.lease!=0&&self_.lease-1<states.len&&states[self_.lease-1].live&&states[self_.lease-1].generation==self_.generation; }
struct Handle { owner_id:u64,lease:u32,generation:u64 }
fn valid(handle:Handle)->bool {return handle.lease!=0&&handle.lease-1<states.len&&handle.owner_id!=0&&states[handle.lease-1].live&&states[handle.lease-1].generation==handle.generation&&states[handle.lease-1].owner_id==handle.owner_id;}
fn acquireHandle(source:Store)->Handle {
 assert(valid(source)); let state:State& =states[source.lease-1];
