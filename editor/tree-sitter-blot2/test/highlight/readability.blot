import { Vec3 } from "std/vector.blot"
//              ^ keyword.control.import

const from = func value => return value
//    ^ function
entry const normalized = func value => return from value / 6555.0
//                                            ^ variable

const and = func left => return func ~(right: Bool) => return if left then @demand right else false
//                                   ^ operator
//                                    ^ punctuation.bracket
//                                                                     ^ keyword.control.conditional

const demand = func ~value => return @demand value
//    ^^^^^^ function
//                  ^ operator
//                   ^^^^^ variable.parameter
//                                   ^^^^^^^ function.builtin

const compatible = func ~value => return @force value
//                                       ^^^^^^ function.builtin

const same = func a => return func b => return if :a == :b then true else false
const project = .x
const choose = func value => return case value of
  #Some a | #Some a if a > 0 => a
  _ => 0
