let element: Unit -> U32 ! {} resources {depth:1,frame:0} = fn () => return 99
let exercise: Unit -> Result[Result[U32,AllocError],ReserveError] ! {reserve,release}
= fn () => return region@[Result[U32,AllocError]](4) as r (owner,free) in do:
  let (rest,answer): (Space[r],Result[U32,AllocError]) = do:
    case region.try_alloc@[U32](free,1):
      #Err((unused,error)) => break (unused,#Err(error))
      #Ok((unused,destination)) => do:
        let b0 = builder.begin_append(destination)
        let answer = do:
          case builder.try_append(b0,41):
            #Err((rest_builder,_)) => do:
              builder.discard(rest_builder)
              break 0
            #Ok(b1) => do:
              case builder.try_append(b1,element(())):
                #Err((rest_builder,unused_value)) => do:
                  builder.discard(rest_builder)
                  break unused_value
                #Ok(b2) => do:
                  builder.discard(b2)
                  break 0
        break (unused,#Ok(answer))
  space.end(rest)
  region.close(owner)
  break answer
pub let run: Unit -> U32 ! {reserve,release} resources {depth:4,frame:8192} = fn () => do:
  case exercise(()):
    #Err(_) => return 0
    #Ok(result) => do:
      case result:
        #Err(_) => return 0
        #Ok(answer) => return answer
