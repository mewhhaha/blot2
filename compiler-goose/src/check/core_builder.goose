fn Builder::allCatalogs(self:Builder&)->Error {for contract in self.source.checked.proof_contracts {self.tables.proof_contracts.push(blot_check_core::ProofContract{binding:contract.binding,header:contract.header, ..});}for metadata in self.source.checked.nominals {let constructors,error=self.save(self.source.checked.types.list(metadata.constructors));if error!=Error.none {return error;}let display,error=self.nominalDiagnosticNames(metadata);if error!=Error.none {return error;}let parameters,error=self.projectedTypeList(metadata.parameters);if error!=Error.none {return error;}let variables,error=self.projectedTypeList(metadata.variables);if error!=Error.none {return error;}self.tables.nominals.push(blot_check_core::Nominal{affine:metadata.affine,has_usage:metadata.has_usage,closed_storage:metadata.closed_storage,private:metadata.private,is_opaque:metadata.is_opaque,storage:metadata.storage,diagnostic_name:display.name,diagnostic_origin:display.origin,identity:metadata.identity,parameters:parameters,variables:variables,constructors:constructors, ..});}for metadata in self.source.checked.effect_templates {if metadata.identity.decl==0 || metadata.family==0 {continue;}let family=self.source.checked.effect_families[metadata.family];if family.name==0 || (!family.callable && metadata.name==0) {continue;}let origin,error=self.source.diagnostic_origins.name(metadata.identity.unit,self.source.checked.unit);if error==Error.out_of_memory {return error;}if error!=Error.none {continue;}var bytes=NameBuffer{..};let failure=operationDiagnosticName(self,metadata,family,origin,bytes);bytes.deinit(name_runs);if failure!=Error.none {return failure;}}
