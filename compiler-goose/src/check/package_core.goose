fn schemeFor(self:Walker&,value:blot_check_types::Scheme,body:u32)->Error {let error=self.step(0);if error!=Error.none {return error;}for variable in self.module.types.list(value.row_variables) {let error=self.step(0);if error!=Error.none {return error;}let owned,error=self.scopes.ownsRow(variable);if error!=Error.none {return error;}if !owned {return Error.invalid_artifact;}}var assumed=false;for owner in self.scopes.schemes[..self.scopes.scheme_count] {let error=self.step(0);if error!=Error.none {return error;}if owner==value {assumed=true;}}if body!=0 && self.module.binding(body).scheme!=value {return Error.invalid_artifact;}if assumed {let goals,error=self.scopes.schemeGoals(value);if error!=Error.none {return error;}let error=blot_check_scheme_predicates::scope(self.scopes,goals);if error!=Error.none {return error;}}else {let error=blot_check_dictionary_contracts::requirements(self.module,value.obligations,self.scopes,body);if error!=Error.none {return error;}}if value.variables.len!=0 {let owner=self.module.types.node(value.root);if owner.tag==blot_check_types::Tag.forall {if value.variables.len!=owner.c || self.module.types.list(value.variables)!=self.module.types.list(List{start:owner.b,len:owner.c, ..}) {return Error.invalid_artifact;}}else {for variable in self.module.types.list(value.variables) {let error=self.step(0);if error!=Error.none {return error;}let owned,error=self.scopes.ownsVariable(variable);if error!=Error.none {return error;}if self.module.types.node(variable).tag!=blot_check_types::Tag.variable || !owned {return Error.invalid_artifact;}}}}for row in self.module.types.list(value.closed_rows) {let owned,error=self.closedRowOwned(row);if error!=Error.none {return error;}if !owned {return Error.invalid_artifact;}}let binders=self.module.types.list(value.generative);if binders.len%2!=0 {return Error.invalid_artifact;}for index in 0..binders.len/2 {if self.module.types.node(binders[index*2]).tag!=blot_check_types::Tag.function || self.module.type