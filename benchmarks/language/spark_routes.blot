// Loaded in the Gdev project beside its existing path plan benchmark.
import * as fixture from "../../test_support/path_plans"
import * as ground from "ink/navigation/ground"
import * as math from "ink/math"

entry func serial_shared (seed: U32) => return fixture.direct_shared seed

type RouteWorld = { storage: ground.Storage, stored: ground.Stored }

func prepare_routes (seed: U32): RouteWorld =>
  let boxes: #[~ground.Box] = #[]
  let rounds: #[~ground.Round] = #[]
  let words: #[~U32] = #[]
  let shapes: #[~F32] = #[]
  let storage = $ground.Storage { boxes, rounds, words, shapes }
  let empty_boxes: #[ground.Box] = #[]
  let round_arr = #[ground.round_of 0.0 math.zero3 (1.0 + U32.to_f32 (seed % 4) * 0.2)]
  let stored = Maybe.unwrap_or ground.closed_stored (ground.make_into storage (&empty_boxes[0..0]) (&round_arr[0..round_arr.length]) 20.0)
  return { storage, stored }

func run_one_route (ctx: RouteWorld) -> (query: U32): #[F32] =>
  if query < 4:
    return fixture.packed_on (ground.read ctx.storage ctx.stored) query
  return #[]

// Variable-width prepared route kernel: each query yields [4 summary lanes, XYZ points...].
entry kernel routes: Kernel [U32, U32, #[F32]] = { prepare: prepare_routes, run: run_one_route }

effect StartRoute: Array U32 -> U32

func route_planner_init (seed: U32): U32 => return seed
func route_planner_step (st: own U32) -> (delta: U32): (U32, U32) =>
  let next = @u32.add st delta
  let world = prepare_routes next
  let best = 0
  for q in 0 .. 4:
    let plan = run_one_route world q
    if plan.length > 0 and plan[0] > 0.0:
      best := q
  return (next, best)

entry process route_planner: Process [U32, U32, U32] = { init: route_planner_init, step: route_planner_step }

func request_planner (): U32 ! { StartRoute } => return StartRoute #[11, 114, 111, 117, 116, 101, 95, 112, 108, 97, 110, 110, 101, 114]
entry func start_route (host: Array U32 -> U32 ! { Foreign }) => return do @effect.provider StartRoute host:
  use endpoint <- request_planner ()
  return endpoint
