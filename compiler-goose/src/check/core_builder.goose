recursive fn Builder::resolverStatements(self:Builder&,source:u32,statements:const u32[:],tail:u32,depth:i64)->u32,Error {if depth>=1024 {return 0,Error.core_limit;}if statements.len==0 {return tail,Error.none;}if self.source.checked.iterator_bodies.len!=0 && self.source.checked.iterator_bodies[statements[0]]!=0 {var expanded=WordBuffer{..};let error=expanded.appendSlice(self.source.tree.children(self.source.checked.iterator_bodies[statements[0]]));if error!=Error.none {expanded.deinit();return 0,error;}let error=expanded.appendSlice(statements[1..]);if error!=Error.none {expanded.deinit();return 0,error;}let value,error=self.resolverStatements(source,expanded.items,tail,depth+1);expanded.deinit();return value,error;}var ordinary:i64=0;while ordinary<statements.len {let child=statements[ordinary];let tag=self.source.tree.node(child).tag;var simple=true;match tag {blot_parse_ast::tag_return_stmt,blot_parse_ast::tag_break_stmt,blot_parse_ast::tag_continue_stmt,blot_parse_ast::tag_use_stmt,blot_parse_ast::tag_if_stmt,blot_parse_ast::tag_if_let_stmt,blot_parse_ast::tag_for_stmt,blot_parse_ast::tag_range_stmt,blot_parse_ast::tag_forever_stmt=>{simple=false;},blot_parse_ast::tag_let_stmt=>{simple=self.source.tree.binding(child).fallback==0;},_=>{},}if !simple {break;}ordinary+=1;}if ordinary!=0 {var prefix=WordBuffer{..};let value,error=resolverOrdinary(self,source,statements,ordinary,tail,depth,prefix);prefix.deinit();return value,error;}let statement_source=statements[0];let syntax=self.source.tree.node(statement_source);if syntax.tag==blot_parse_ast::tag_return_stmt {let index=self.source.checked.resolver_op_ids[statement_source];if index==0 {return 0,Error.core_limit;}let info=self.source.checked.resolver_ops[index-1];let candidate,error=self.expression(syntax.a,depth+1);if error!=Error.none {return 0,error;}if info.completion!=0 {return self.resolverComplete(info.completion,candidate);}let value,error=self.completedValue(statement_source,candidate,info.completed_type