import "./helpers.blot" as helpers

type Output[r: Region, T: Type] where [Plain(T)] =
  exists [m: Nat, d: Domain] => View[r,T,m,d]

pub let copy_identity:
  forall [r: Region, T: Type, n: Nat, c: Nat, d: Domain] where [Plain(T)] =>
  Fn[static, Many,
    {src: View[r,T,n,d], dst: Dest[r,T,c]},
    Result[Output[r,T],Unit]]
  ! {} resources {depth:2,frame:4096}
= fn {src: source, dst: output} => do:
  dest.discard(output)
  let value = helpers.identity@[View[r,T,n,d]](source)
  return #Ok(pack [n,d] as Output[r,T] value)
