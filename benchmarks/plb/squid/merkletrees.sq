// PLB merkletrees: per-node freelist allocation and direct recursive
// make_tree / cal_hash / check_tree / free_tree over a single 20B node pool.
import * as buf from "./buf"

const MIN_DEPTH: U32 = 4
const NONE: U32 = 0xFFFFFFFF

// flags: bit 0 = has_hash, bit 1 = has_value.
type MNode is data = $MNode { hash: U32, val: U32, l: U32, r: U32, flags: U32 }

func alloc_node (nodes: own #[MNode]) -> (freelist: own #[U32]) -> (flen: U32) -> (val: U32) -> (l: U32) -> (r: U32) -> (flags: U32): (U32, #[MNode], #[U32], U32) =>
  let nd = $MNode { hash: 0, val, l, r, flags }
  if flen > 0:
    let nflen = flen - 1
    let idx = freelist[nflen]
    nodes[idx] := nd
    return (idx, nodes, freelist, nflen)
  let idx = nodes.length
  nodes := self.push nd
  return (idx, nodes, freelist, flen)

func make_tree (depth: U32) -> (nodes: own #[MNode]) -> (freelist: own #[U32]) -> (flen: U32): (U32, #[MNode], #[U32], U32) =>
  if depth == 0:
    return alloc_node nodes freelist flen 1 NONE NONE 2
  let (l, n1, fl1, fn1) = make_tree (depth - 1) nodes freelist flen
  let (r, n2, fl2, fn2) = make_tree (depth - 1) n1 fl1 fn1
  return alloc_node n2 fl2 fn2 0 l r 0

func cal_hash (idx: U32) -> (nodes: own #[MNode]): #[MNode] =>
  let nd = nodes[idx]
  if (nd.flags & 1) != 0:
    return nodes
  if (nd.flags & 2) != 0:
    nodes[idx] := $MNode { hash: nd.val, val: nd.val, l: nd.l, r: nd.r, flags: nd.flags | 1 }
    return nodes
  if nd.l == NONE or nd.r == NONE:
    return nodes
  nodes := cal_hash nd.l self
  nodes := cal_hash nd.r self
  let h = nodes[nd.l].hash + nodes[nd.r].hash
  nodes[idx] := $MNode { hash: h, val: nd.val, l: nd.l, r: nd.r, flags: nd.flags | 1 }
  return nodes

func check_tree (idx: U32) -> (nodes: #[MNode]): Bool =>
  let nd = nodes[idx]
  if (nd.flags & 1) == 0:
    return false
  if (nd.flags & 2) != 0:
    return true
  if nd.l == NONE or nd.r == NONE:
    return false
  return check_tree nd.l nodes and check_tree nd.r nodes

func free_tree (idx: U32) -> (nodes: #[MNode]) -> (freelist: own #[U32]) -> (flen: U32): (#[U32], U32) =>
  let nd = nodes[idx]
  if nd.l != NONE:
    let (fl1, fn1) = free_tree nd.l nodes freelist flen
    freelist := fl1
    flen := fn1
  if nd.r != NONE:
    let (fl2, fn2) = free_tree nd.r nodes freelist flen
    freelist := fl2
    flen := fn2
  if flen < freelist.length:
    freelist[flen] := idx
  else:
    freelist := self.push idx
  return (freelist, flen + 1)

io bench (inp: #[U32]): #[U32] =>
  let n = inp[0]
  let max_depth = if n < MIN_DEPTH + 2 then MIN_DEPTH + 2 else n
  let init_cap = (1 << (max_depth + 2))
  let nodes: #[MNode] = Array.with_capacity init_cap
  let freelist: #[U32] = Array.with_capacity init_cap
  let flen: U32 = 0
  let (w, l, c) = buf.new_buf ()

  // Stretch tree
  let (sroot, n0, fl0, fn0) = make_tree (max_depth + 1) nodes freelist flen
  nodes := cal_hash sroot n0
  let sok = check_tree sroot nodes
  let shash = nodes[sroot].hash
  let (fl1, fn1) = free_tree sroot nodes fl0 fn0
  freelist := fl1
  flen := fn1

  let (w1, l1, c1) = buf.push_text w l c "stretch tree of depth "
  let (w2, l2, c2) = buf.push_u32 w1 l1 c1 (max_depth + 1)
  let (w3, l3, c3) = buf.push_text w2 l2 c2 "\t root hash: "
  let (w4, l4, c4) = buf.push_u32 w3 l3 c3 shash
  let (w5, l5, c5) = buf.push_text w4 l4 c4 (if sok then " check: true\n" else " check: false\n")
  w := w5
  l := l5
  c := c5

  // Long-lived tree
  let (lroot, n1, fl2, fn2) = make_tree max_depth nodes freelist flen
  nodes := n1
  freelist := fl2
  flen := fn2

  let d: U32 = MIN_DEPTH
  for ever:
    if d > max_depth:
      break
    let iters: U32 = 1 << (max_depth - d + MIN_DEPTH)
    let sum: U32 = 0
    for _ in 0 .. iters:
      let (t, na, fla, fna) = make_tree d nodes freelist flen
      nodes := cal_hash t na
      sum := self + nodes[t].hash
      let (flb, fnb) = free_tree t nodes fla fna
      freelist := flb
      flen := fnb
    let (wa, la, ca) = buf.push_u32 w l c iters
    let (wb, lb, cb) = buf.push_text wa la ca "\t trees of depth "
    let (wc, lc, cc) = buf.push_u32 wb lb cb d
    let (wd, ld, cd) = buf.push_text wc lc cc "\t root hash sum: "
    let (we, le, ce) = buf.push_u32 wd ld cd sum
    let (wf, lf, cf) = buf.push_b we le ce 10
    w := wf
    l := lf
    c := cf
    d := self + 2

  nodes := cal_hash lroot self
  let lok = check_tree lroot nodes
  let (wa, la, ca) = buf.push_text w l c "long lived tree of depth "
  let (wb, lb, cb) = buf.push_u32 wa la ca max_depth
  let (wc, lc, cc) = buf.push_text wb lb cb "\t root hash: "
  let (wd, ld, cd) = buf.push_u32 wc lc cc nodes[lroot].hash
  let (we, le, ce) = buf.push_text wd ld cd (if lok then " check: true\n" else " check: false\n")
  return buf.finish_buf we le ce
