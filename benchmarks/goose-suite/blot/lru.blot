// LRU cache: open-addressed hash map with backward-shift deletion + doubly-linked
// recency list in parallel U32 node arrays with an explicit freelist.
import * as rng from "./rng"

const BENCH_N: U32 = 8000000 // BENCH_N
const NONE: U32 = 0xFFFFFFFF

type Slot is data = $Slot { key: U32, node: U32 }

func next_pow2 (v: U32): U32 =>
  let p: U32 = 16
  for ever:
    if p >= v:
      break
    p := self << 1
  return p

func home (key: U32) -> (mask: U32): U32 =>
  return ((key * 0x9E3779B1) ^ (key >> 16)) & mask

func find_slot (slots: #[Slot]) -> (mask: U32) -> (key: U32): U32 =>
  let i = home key mask
  for ever:
    let $Slot { key: sk, node: sn } = slots[i]
    if sn == NONE or sk == key:
      break
    i := (self + 1) & mask
  return i

func map_remove (slots: own #[Slot]) -> (mask: U32) -> (at: U32): #[Slot] =>
  let i = at
  let j = i
  for ever:
    j := (self + 1) & mask
    let s = slots[j]
    if s.node == NONE:
      break
    let h = home s.key mask
    if (i < j and (h <= i or h > j)) or (i > j and h <= i and h > j):
      slots[i] := s
      i := j
  slots[i] := $Slot { key: 0, node: NONE }
  return slots

io bench (): #[U32] =>
  let cap = BENCH_N / 8
  let keys = cap * 2
  let nslots = next_pow2 (cap * 2)
  let mask = nslots - 1
  let slots = @array.fill nslots ($Slot { key: 0, node: NONE })

  // Sentinel head (0) and tail (1), parallel arrays (16 bytes/node total).
  let nkey = @array.fill (cap + 2) NONE
  let nval = @array.fill (cap + 2) 0
  let nprev = @array.fill (cap + 2) NONE
  let nnext = @array.fill (cap + 2) NONE
  let pool_used: U32 = 2
  nnext[0] := 1
  nprev[1] := 0

  let free_stack = @array.fill cap 0
  let free_len: U32 = 0

  let count: U32 = 0
  let hits: U32 = 0
  let misses: U32 = 0
  let removes: U32 = 0
  let r = rng.u64_from_u32 12345

  for _ in 0 .. BENCH_N:
    r := rng.xs_next self
    let a = rng.xs_mod r keys
    let key = rng.sq_div_u32 a keys
    let at = find_slot slots mask key
    let f = slots[at].node
    let $rng.U64 { lo: _, hi } = r
    if ((hi >> 8) & 15) == 0:
      if f != NONE:
        let p = nprev[f]
        let q = nnext[f]
        nnext[p] := q
        nprev[q] := p
        slots := map_remove self mask at
        free_stack[free_len] := f
        free_len := self + 1
        count := self - 1
        removes := self + 1
    else:
      if f != NONE:
        nval[f] := self + 1
        let p = nprev[f]
        let q = nnext[f]
        nnext[p] := q
        nprev[q] := p
        let fq = nnext[0]
        nprev[f] := 0
        nnext[f] := fq
        nprev[fq] := f
        nnext[0] := f
        hits := self + 1
      else:
        misses := self + 1
        let ins = at
        if count == cap:
          let lru = nprev[1]
          let lru_key = nkey[lru]
          let lp = nprev[lru]
          let lq = nnext[lru]
          nnext[lp] := lq
          nprev[lq] := lp
          let lat = find_slot slots mask lru_key
          slots := map_remove self mask lat
          free_stack[free_len] := lru
          free_len := self + 1
          count := self - 1
          ins := find_slot slots mask key
        let ni: U32 = 0
        if free_len > 0:
          free_len := self - 1
          ni := free_stack[free_len]
        else:
          ni := pool_used
          pool_used := self + 1
        nkey[ni] := key
        nval[ni] := key % 1000
        slots[ins] := $Slot { key, node: ni }
        let fq = nnext[0]
        nprev[ni] := 0
        nnext[ni] := fq
        nprev[fq] := ni
        nnext[0] := ni
        count := self + 1

  let walk = rng.u64_zero ()
  let vals = rng.u64_zero ()
  let cur = nnext[0]
  for ever:
    if cur == NONE or cur == 1:
      break
    walk := rng.u64_add_u32 (rng.u64_mul_31 self) nkey[cur]
    vals := rng.u64_add_u32 self nval[cur]
    cur := nnext[cur]

  let out: #[U32] = #[]
  out := rng.emit_u32 self hits
  out := rng.emit_u32 self misses
  out := rng.emit_u32 self removes
  out := rng.emit_u32 self count
  out := rng.emit_u64 self walk
  out := rng.emit_i64 self vals
  return out
