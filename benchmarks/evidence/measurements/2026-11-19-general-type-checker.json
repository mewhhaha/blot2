  "contractBenchGoose": [
    "import check.capability_contracts;",
    "import support.error;",
    "import support.native;",
    "type Term=blot_check_capability_contracts::Term;",
    "fn main() {",
    " var terms:Term[4096]=default<Term[4096]>();var args:u32[1]=[0];var fields:u32[2]=[20000,1];",
    " terms[1]=Term{blot_check_capability_contracts::Tag.parameter,0,..};",
    " for root in [2 as u32,31 as u32,32 as u32,256 as u32,4095 as u32] {",
    "  terms[root]=Term{blot_check_capability_contracts::Tag.record,0,2,..};",
    "  let recipe=blot_check_capability_contracts::Recipe{1,root,terms[..root+1],fields[..]};",
    "  let iterations=max(300,160000/((root as i64)+1));",
    "  let start=blot_native::thread_cpu_ns();",
    "  var store,error=blot_check_capability_contracts::init();assert(error==blot_error::Error.none);store.limits.visits=20000000;",
    "  for i in iterations {",
    "   let result,failure=store.instantiate(recipe,args[..]);assert(failure==blot_error::Error.none && result==1);",
    "  }",
    "  let elapsed=blot_native::thread_cpu_ns()-start;assert(store.visits==iterations*2);store.deinit();",
    "  print(root,\" \",iterations,\" \",elapsed);",
    " }",
    "}"
  ],
