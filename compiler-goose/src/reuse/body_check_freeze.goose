 let owner .= body.auxiliary;if owner {var mapper=AuxiliaryFreeze{catalog:catalog,source:source,work:work,roots:roots,rows:effect_rows,labels:labels,next_type:next_type,next_row:auxiliary_rows,next_label:auxiliary_labels,private:private,..};let mapped=owner.transform(mapper);private=mapper.private;next_type=mapper.next_type;auxiliary_rows=mapper.next_row;auxiliary_labels=mapper.next_label;if mapped!=blot_error::Error.none {mapper.dependencies.deinit();mapper.constructors.deinit();return mapped;}owner.dependencies=blot_reuse_body_auxiliary::copyOwned(mapper.dependencies.items);owner.constructors=blot_reuse_body_auxiliary::copyOwned(mapper.constructors.items);mapper.dependencies.deinit();mapper.constructors.deinit();blot_reuse_body_auxiliary::releaseOwned(owner.origins);owner.origins=default<u32[:]>();blot_reuse_body_auxiliary::releaseOwned(owner.binding_origins);owner.binding_origins=default<u32[:]>();}
 let reads,error=bodyReads(work.graph.value,body,work.fields.items,work.nominals.items);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }body.nominals=reads.nominals;body.type_work=reads.bytes;
 }
 let at=chunks.alloc_index(Chunk{graph:canonicalFrozenGraph(work.graph.owner,work.graph.value),graph_owner:blot_reuse_dependency_payload::Owner{lease:work.graph.owner.lease,generation:work.graph.owner.generation},nominals:copyOwned(work.nominals.items),field_names:copyOwned(work.fields.items),qualifications:copyOwned(work.qualifications.items),bodies:copyOwned(bodies),live:true, ..});let owner:Chunk& =chunks[at];owner.slot=(at+1) as u32;
 for &body in owner.bodies {owner.body_bytes+=body.bytes();owner.type_work+=body.type_work;body.owner .= owner;}
