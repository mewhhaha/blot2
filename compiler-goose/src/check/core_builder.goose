 let resolver_ops,error=owner.copy<blot_check_core::ResolverInfo>(self.resolver_ops[:]);if error!=Error.none {return default<Module>(),error;}result.resolver_ops=resolver_ops;
 let operation_values,error=owner.copy<blot_check_core::OperationValue>(self.operation_values[:]);if error!=Error.none {return default<Module>(),error;}result.operation_values=operation_values;
 let handle_effects,error=owner.copy<blot_check_core::HandleEffects>(self.handle_effects[:]);if error!=Error.none {return default<Module>(),error;}result.handle_effects=handle_effects;
 let dispatch_signatures,error=owner.copy<blot_check_types::Id>(self.dispatch_signatures[:]);if error!=Error.none {return default<Module>(),error;}result.dispatch_signatures=dispatch_signatures;
 let proof_contracts,error=owner.copy<blot_check_core::ProofContract>(self.proof_contracts[:]);if error!=Error.none {return default<Module>(),error;}result.proof_contracts=proof_contracts;

 result.types.effects.variable_count=effect_variable_count;
 for node in result.types.nodes {if node.tag==blot_check_types::Tag.forall || node.tag==blot_check_types::Tag.existential {result.has_rank_contracts=true;}if node.tag==blot_check_types::Tag.usage {result.has_usage_contracts=true;}if node.tag==blot_check_types::Tag.erased_proof {result.has_numeric_proofs=true;}}
 for nominal in result.nominals {if nominal.has_usage {result.has_usage_contracts=true;}}
 blot_check_quantifier_goals::sort(quantifier_goals);
 for &contract in result.proof_contracts {let value_slots,error=owner.copy<u32>(contract.header.value_slots);if error!=Error.none {return default<Module>(),error;}let proof_slots,error=owner.copy<u32>(contract.header.proof_slots);if error!=Error.none {return default<Module>(),error;}let values,error=owner.copy<blot_check_numeric_proof_terms::Kind>(contract.header.values);if error!=Error.none {return default<Module>(),error;}let operands,error=owner.copy<blot_check_numeric_proof_terms::Term>(contract.header.operands);if error!=Error.none {return default<Module>(),error;}let requirements,error=owner.copy<blot_check_numeric_proof_contracts::Requirement>(contract.header.requirements);if error!=Error.none {return default<Module>(),error;}contract.header.value_slots=value_slots;contract.header.proof_slots=proof_slots;contract.header.values=values;contract.header.operands=operands;contract.header.requirements=requirements;}
 for &use in result.dictionary_uses {if use.introduction==0 {continue;}let mapped=ast_map[use.introduction];assert(mapped!=0);use.introduction=mapped;if result.node(mapped).tag==blot_check_core::Tag.closure {use.introduction=result.closures[result.node(mapped).a].body;}}
 for &selection in result.dictionary_selections {match selection.proof {blot_check_core::DictionaryProof.selected payload=>{},blot_check_core::DictionaryProof.given payload=>{var given=payload.value;if given.introduction==0 {continue;}let mapped=ast_map[given.introduction];assert(mapped!=0);given.introduction=mapped;if result.node(mapped).tag==blot_check_core::Tag.closure {given.introduction=result.closures[result.node(mapped).a].body;}selection.proof=blot_check_core::DictionaryProof.given{value:given, ..};},}}
 return result,Error.none;
}
fn Builder::deinit(self:Builder&) {
 if self.scratch.type_map.len!=0 {word_runs.free_slice(self.scratch.type_map);self.scratch.type_map=[];}
 if self.scratch.variable_map.len!=0 {word_runs.free_slice(self.scratch.variable_map);self.scratch.variable_map=[];}
 if self.scratch.effect_row_map.len!=0 {word_runs.free_slice(self.scratch.effect_row_map);self.scratch.effect_row_map=[];}
 if self.scratch.effect_variable_map.len!=0 {word_runs.free_slice(self.scratch.effect_variable_map);self.scratch.effect_variable_map=[];}
 if self.scratch.effect_operation_map.len!=0 {word_runs.free_slice(self.scratch.effect_operation_map);self.scratch.effect_operation_map=[];}
 if self.scratch.ast_map.len!=0 {word_runs.free_slice(self.scratch.ast_map);self.scratch.ast_map=[];}
 if self.scratch.member_origin_heads.len!=0 {word_runs.free_slice(self.scratch.member_origin_heads);self.scratch.member_origin_heads=[];}
 if self.scratch.member_origin_next.len!=0 {word_runs.free_slice(self.scratch.member_origin_next);self.scratch.member_origin_next=[];}
 if self.scratch.signature_sources.len!=0 {word_runs.free_slice(self.scratch.signature_sources);self.scratch.signature_sources=[];}
 if self.scratch.merge_heads.len!=0 {word_runs.free_slice(self.scratch.merge_heads);self.scratch.merge_heads=[];}
 if self.scratch.merge_next.len!=0 {word_runs.free_slice(self.scratch.merge_next);self.scratch.merge_next=[];}
 if self.scratch.loop_exit_indices.len!=0 {word_runs.free_slice(self.scratch.loop_exit_indices);self.scratch.loop_exit_indices=[];}
 if self.scratch.statement_arms.len!=0 {word_runs.free_slice(self.scratch.statement_arms);self.scratch.statement_arms=[];}
 if self.scratch.definition_epochs.len!=0 {word_runs.free_slice(self.scratch.definition_epochs);self.scratch.definition_epochs=[];}
 if self.scratch.reference_epochs.len!=0 {word_runs.free_slice(self.scratch.reference_epochs);self.scratch.reference_epochs=[];}
}

