fn Walker::restoreStage(self: Walker&, environment: StageEnvironment) { self.len = environment.states.len; copy(self.states[..self.len], environment.states); self.region_count = environment.regions.len; for value, index in environment.regions { self.regions[index] = value; } for value, index in environment.bindings { self.region_bindings[index] = value; } self.ambient = environment.ambient; self.returns .= environment.returns; self.breaks .= environment.breaks; self.earlier .= environment.earlier; }
