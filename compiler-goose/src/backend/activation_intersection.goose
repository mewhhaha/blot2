fn semanticAt(self:Scan&,site:SemanticSite,context:u32,kind:Kind)->u32 {if self.failure!=Error.none {return 0;}if context>=self.semantic.invocations.len {self.decline();return 0;}let invocation=self.semantic.invocations[context];var target=invocation.caller;if invocation.callable!=0 {let actual=self.semantic.nodes[invocation.callable].target;if !actual.present {self.decline();return 0;}target=actual.value;}var root=target.node;if invocation.callable==0 {let unit .= self.unit(target.unit);if !unit {return 0;}let body .= unit.body(target.binding);if !body {self.decline();return 0;}root=body.root;}if site.unit!=target.unit || site.root!=root {self.decline();return 0;}if invocation.callable!=0 {self.sameMappings(site,invocation.callable);}else {self.emptyMappings(site);}if self.failure!=Error.none {return 0;}var result=blot_support::none<u32>();for node,id in self.semantic.nodes {if !self.step() {return 0;}if node.kind!=kind || node.context!=context || node.site.unit!=site.unit || node.site.binding!=target.binding || node.site.node!=site.node {continue;}if result.present {self.decline();return 0;}result=blot_support::some(id as u32);}if !result.present {self.decline();return 0;}return result.value;}
