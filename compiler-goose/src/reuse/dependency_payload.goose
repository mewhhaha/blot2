fn clone(value:const squid_check_core::Module&)->Owned<squid_check_core::Module>,Error {var owner,error=init();if error!=squid_error::Error.none {return default<Owned<squid_check_core::Module>>(),error;}let result,error=cloneValue(owner,value);if error!=squid_error::Error.none {owner.deinit();return default<Owned<squid_check_core::Module>>(),error;}return Owned<squid_check_core::Module>{result,owner,..},squid_error::Error.none;}
