// Structural equality is opt-in for application data. This trait lives in
// an explicit module so unrelated projects keep the small bootstrap prelude.
type Eq a is trait = { eq: a -> a -> Bool }
func eq (left: a) -> (right: a): Bool where { Eq a } => Eq.eq left right

const Bool.Eq: Eq Bool = {
  eq: func left -> right => Bool.eq left right,
}
const U32.Eq: Eq U32 = {
  eq: func left -> right => U32.eq left right,
}
const F32.Eq: Eq F32 = {
  eq: func left -> right => F32.eq left right,
}

func equal_array (left: #[a]) -> (right: #[a]): Bool where { Eq a } =>
  if left.length != right.length:
    return false
  let same = true
  for index in 0..left.length:
    if not (Eq.eq left[index] right[index]):
      same := false
  return same
const Array.Eq: Eq #[a] where { Eq a } = {
  eq: func left -> right => equal_array left right,
}

private func equal_maybe (left: Maybe a) -> (right: Maybe a): Bool where { Eq a } =>
  case left, right of
    $Nothing, $Nothing => true
    $Some a, $Some b => Eq.eq a b
    _, _ => false

const Maybe.Eq: Eq (Maybe a) where { Eq a } = { eq: equal_maybe }

private func equal_result (left: Result [a, e]) -> (right: Result [a, e]): Bool where { Eq a, Eq e } =>
  case left, right of
    $Ok a, $Ok b => Eq.eq a b
    $Err a, $Err b => Eq.eq a b
    _, _ => false

const Result.Eq: Eq (Result [a, e]) where { Eq a, Eq e } = { eq: equal_result }

func eq_struct (left: t) -> (right: t): Bool =>
  let same = true
  #for field in #fields t:
    if not (Eq.eq left.(field) right.(field)):
      same := false
  return same
