diff --git a/zig-native/tests/checker_normalization_execution.test.ts b/zig-native/tests/checker_normalization_execution.test.ts
new file mode 100644
--- /dev/null
+++ b/zig-native/tests/checker_normalization_execution.test.ts
@@ -0,0 +1,99 @@
+import { strict as assert } from "node:assert";
+import { createZigProjectCompiler } from "../../compiler/zig_project_client.ts";
+import { instantiateGuest } from "../../compiler/guest.ts";
+
+const source = `const pick = func (first: U32) -> (second: U32) => return second
+const named = func (values: {left: U32, right: U32}) => return @u32.add values.left values.right
+const encode = func (first: U32) -> (second: U32) => return @u32.add (@u32.mul first 10) second
+const many = func (a: U32) -> (b: U32) -> (c: U32) -> (d: U32) -> (e: U32) -> (f: U32) -> (g: U32) -> (h: U32) => return
+  @u32.add a (@u32.add b (@u32.add c (@u32.add d (@u32.add e (@u32.add f (@u32.add g h))))))
+entry const answer = func (input: U32): U32 => return named {right: many 1 2 3 4 5 6 7 8, left: pick 0 input}
+entry const sequence = func (callback: U32 -> U32 ! {Foreign}) => return encode (callback 1) (callback 2)
+entry const ordinary_stop = func (input: U32): U32 => return do:
+  if @u32.eq input 0:
+    return pick (@panic "earlier ordinary") 7
+  return input
+entry const intrinsic_stop = func (input: U32): U32 => return do:
+  if @u32.eq input 0:
+    return @u32.add (@panic "earlier intrinsic") 7
+  return input
+`;
+
+for (const codegenTier of ["development", "optimized"] as const) {
+  Deno.test(`checker normalization preserves currying, effects and retained errors (${codegenTier})`, async () => {
+    const directory = await Deno.makeTempDir({
+      prefix: "blot-check-normalize-",
+    });
+    const entry = `${directory}/main.blot`;
+    const compiler = await createZigProjectCompiler({
+      executable: Deno.args[0],
+      entry,
+      prelude: null,
+      codegenTier,
+      cacheDirectory: false,
+      startupTimeoutMs: 5000,
+    });
+    try {
+      let original: Uint8Array<ArrayBuffer> | undefined;
+      for (const extra of [0, 1, 0]) {
+        const current = source.replace(
+          "many 1 2 3 4 5 6 7 8",
+          `many 1 2 3 4 5 6 7 ${8 + extra}`,
+        );
+        const built = await compiler.build({
+          sources: { [entry]: current },
+          signal: AbortSignal.timeout(5000),
+        });
+        assert(built.success, JSON.stringify(built));
+        if (extra === 0) {
+          if (original) assert.deepEqual(built.bytes, original);
+          else original = built.bytes.slice();
+        }
+        for (const asynchronous of [false, true]) {
+          const guest = await instantiateGuest(built.bytes, { asynchronous });
+          try {
+            const seen: number[] = [];
+            const capability = {
+              parameter: "U32" as const,
+              result: "U32" as const,
+              call(value: number) {
+                seen.push(value);
+                return value + 2;
+              },
+            };
+            const callback = guest.capability(capability);
+            const invoke = async (
+              name: string,
+              value: Parameters<typeof guest.call>[1],
+            ) => {
+              if (asynchronous) return await guest.callAsync(name, value);
+              return guest.call(name, value);
+            };
+            for (const input of [1, 7, 41]) {
+              assert.equal(await invoke("answer", input), input + 36 + extra);
+              assert.equal(await invoke("ordinary_stop", input), input);
+              assert.equal(await invoke("intrinsic_stop", input), input);
+            }
+            assert.equal(await invoke("sequence", callback), 34);
+            assert.deepEqual(seen, [1, 2]);
+            await assert.rejects(() => invoke("ordinary_stop", 0));
+            await assert.rejects(() => invoke("intrinsic_stop", 0));
+          } finally {
+            guest.dispose();
+          }
+        }
+        const bad = current.replace("right: many", "wrong: many");
+        const rejected = await compiler.build({
+          sources: { [entry]: bad },
+          signal: AbortSignal.timeout(5000),
+        });
+        assert(!rejected.success);
+        assert.equal(rejected.diagnostics[0].code, "unknown_field");
+        assert.equal(rejected.diagnostics[0].start, bad.indexOf("wrong: many"));
+      }
+    } finally {
+      await compiler.dispose();
+      await Deno.remove(directory, { recursive: true });
+    }
+  });
+}
