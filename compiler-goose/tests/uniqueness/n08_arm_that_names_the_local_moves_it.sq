type World is data = $World { counts: Array U32, size: U32 }
const bump = func (world: own World) -> (n: U32) => return do:
  world.counts[0] := @u32.add world.counts[0] n
  break world
const step = func (world: own World) -> (kind: U32) => return do:
  world := case kind of
    0 => bump world 1
    1 => do:
      let next = bump world 2
      break bump next 3
    _ => world
  break world
const pick = func (world: own World) -> (kind: U32) => return case kind of
  0 => bump world 1
  _ => world
const either = func (world: own World) -> (flag: Bool) => return if flag then bump world 4 else world
const run = func (n: U32) => return do:
  let world = either (pick (step ($World { counts: #[0], size: 1 }) n) n) true
  world.counts[0] := @u32.add world.counts[0] 1
  break world.counts[0]
