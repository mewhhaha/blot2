// This file is executable: just compile examples/prelude.blot
// std/prelude.blot supplies Maybe, Result, combinators, and numeric operators.

fn increment value => value + 1
fn doubled value => value * 2

// A closure captures its immutable argument; functions are ordinary values.
const add_two = U32.add 2
const transform = compose doubled increment

export const const_answer = Maybe.unwrap_or 0 $ Maybe.map transform $ Some 20

export fn answer () => do:
  let candidate = Maybe.map add_two (Some 40)
  let Some(value) = candidate else:
    return 0
  return Result.unwrap_or 0 $ Result.map identity $ Ok value

// One generic function and one local lambda each work at distinct types.
export fn generic_identity () => do:
  let same = fn value => value
  let enabled = same (identity True)
  if enabled:
    return same (identity 42)
  return 0

// Backticks call source functions; application binds more tightly.
fn plus left => fn right => left + right
export fn named_operator () => 20 `plus` 22

export fn inspect (enabled: Bool) => do:
  let candidate = do:
    if enabled:
      return Some (Some 42)
    return Some Nothing
  return case candidate of
    Some (Some value) => value
    Some Nothing => 0
    Nothing => 0

export fn recover (enabled: Bool) => do:
  let candidate = do:
    if enabled:
      return Ok 42
    return Err False
  if let Ok(value) = candidate:
    return value
  return 0
