+const named = func (values: {left: U32, right: U32}) => return @u32.add values.left values.right
+const encode = func (first: U32) -> (second: U32) => return @u32.add (@u32.mul first 10) second
+const many = func (a: U32) -> (b: U32) -> (c: U32) -> (d: U32) -> (e: U32) -> (f: U32) -> (g: U32) -> (h: U32) => return
+  @u32.add a (@u32.add b (@u32.add c (@u32.add d (@u32.add e (@u32.add f (@u32.add g h))))))
+entry const answer = func (input: U32): U32 => return named {right: many 1 2 3 4 5 6 7 8, left: pick 0 input}
+entry const sequence = func (callback: U32 -> U32 ! {Foreign}) => return encode (callback 1) (callback 2)
+entry const ordinary_stop = func (input: U32): U32 => return do:
+  if @u32.eq input 0:
+    return pick (@panic "earlier ordinary") 7
+  return input
+entry const intrinsic_stop = func (input: U32): U32 => return do:
+  if @u32.eq input 0:
+    return @u32.add (@panic "earlier intrinsic") 7
+  return input
