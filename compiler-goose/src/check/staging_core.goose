fn effectVisitCallback(self:Effects&,callback:blot_check_core::ClosureInfo,arrow:blot_check_types::Node,depth:i64,inherit_handlers:bool)->Error {var nested=Effects{workspace:self.workspace,m:self.m,units:self.units,target_module:self.m,target:self.m.types.row(arrow.c),closed_rows:callback.closed_rows,remaining:self.remaining,checked_calls:self.checked_calls,variables:self.variables, ..};if inherit_handlers {nested.handlers .= self.handlers;}if nested.target.labels.len>nested.seen.len {return Error.invalid_artifact;}return nested.visit(callback.body,depth+1);}
