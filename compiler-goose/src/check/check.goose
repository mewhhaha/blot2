fn Engine::provisionalEquation(self:Engine&,contract:Identity,name:u32,arguments:const u32[:])->blot_support::Option<u32>,blot_error::Error {
    var ordinal=self.provisional_equations.len;while ordinal!=0 {ordinal-=1;let frame=self.provisional_equations[ordinal];let declaration=self.implementations[frame.declaration];if declaration.contract!=contract || frame.arguments.len!=arguments.len {continue;}var same=true;for before,index in self.types.list(frame.arguments) {let equal,err=self.types.equalSymbolic(before,arguments[index]);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if !equal {same=false;break;}}if !same {continue;}let member_index=self.implementationMemberIndex(declaration,name);if !member_index.present {return blot_support::none<u32>(),blot_error::Error.none;}let member=self.implementation_members[member_index.value];if member.kind!=blot_reuse_principal_interface::ImplementationMemberKind.type_ {return blot_support::none<u32>(),blot_error::Error.none;}let old,err=blot_eval_implementation_patterns::typeBinders(self.types,declaration);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let old_rows,err=blot_eval_implementation_patterns::rowBinders(self.types,declaration);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let root,err=self.types.substituteWithRows(member.root,old,frame.variables,old_rows,frame.rows);return blot_support::some(root),err;
    }return blot_support::none<u32>(),blot_error::Error.none;
}
fn Engine::implementationBodies(self:Engine&)->blot_error::Error {for declaration in self.implementations {if declaration.identity.unit!=self.unit {continue;}for member in declaration.members.start..declaration.members.start+declaration.members.len {let root,err=self.resolveImplementationMember(member as u32);if err!=blot_error::Error.none {return err;}}}return blot_error::Error.none;}
fn Engine::implementationMethodScope(self:Engine&,index:u32)->blot_error::Error {let declaration=self.implementations[index];let err=self.implementationScope(declaration);if err!=blot_error::Error.none {return err;}for member in self.implementation_members[declaration.members.start..declaration.members.start+declaration.members.len] {if member.kind==blot_reuse_principal_interface::ImplementationMemberKind.value {self.env.append(Entry{member.name,member.target.binding});}}return blot_error::Error.none;}
fn Engine::implementationArgumentPack(self:Engine&,span:blot_check_types::List)->u32,blot_error::Error {let roots=equation_type_ids.alloc_slice(span.len);for value,index in self.types.list(span) {roots[index]=value;}let result,err=self.types.product(roots);equation_type_ids.free_slice(roots);return result,err;}
fn Engine::beginImplementationQualification(self:Engine&,index:u32,scope:u32,value:u32)->blot_error::Error {let declaration=self.implementations[index];let start=self.declared_obligations.len as u32;for predicate in self.implementation_predicates[declaration.predicates.start..declaration.predicates.start+declaration.predicates.len] {self.declared_obligations.append(predicate);let err=self.appendPending(PendingObligation{owner:self.current,value:predicate,declared:true,suspended:true});if err!=blot_error::Error.none {return err;}}let pack,err=self.implementationArgumentPack(declaration.head);if err!=blot_error::Error.none {return err;}let proof=blot_check_types::Obligation{kind:blot_check_types::ObligationKind.contract,identity:declaration.contract,ty:pack,source:scope,explicit:true};self.declared_obligations.append(proof);let err=self.appendPending(PendingObligation{owner:self.current,value:proof,declared:true,suspended:true});if err!=blot_error::Error.none {return err;}self.qualifications.append(Qualification{scope:scope,owner:self.current,clauses:blot_check_types::List{start:start,len:self.declared_obligations.len as u32-start},value:value});return blot_error::Error.none;}
fn Engine::validateImplementationBinders(self:Engine&,index:u32,source:u32)->blot_error::Error {let declaration=self.implementations[index];for ordinal in 0..declaration.variables.len {let variable=self.types.list(declaration.variables)[ordinal];let resolved=self.types.head(variable,0);if self.types.node(resolved).tag!=blot_check_types::Tag.variable {let err=self.diagnostic(Code.type_mismatch,source);if err!=blot_error::Error.none {return err;}}for prior in 0..ordinal {if self.types.head(self.types.list(declaration.variables)[prior],0)==resolved {let err=self.diagnostic(Code.type_mismatch,source);if err!=blot_error::Error.none {return err;}}}}for row,ordinal in self.types.list(declaration.row_parameters) {let resolved_id,err=self.types.resolveEffects(row,0);if err!=blot_error::Error.none {return err;}let resolved=self.types.row(resolved_id);var variable=blot_support::none<u32>();match resolved.tail {blot_check_effects::Tail.variable payload=>{variable=blot_support::some(payload.value);},_=>{}}if resolved.labels.len!=0 || !variable.present {let err=self.diagnostic(Code.effect_mismatch,source);if err!=blot_error::Error.none {return err;}continue;}for prior in self.types.list(declaration.row_parameters)[..ordinal] {let previous_id,err=self.types.resolveEffects(prior,0);if err!=blot_error::Error.none {return err;}let previous=self.types.row(previous_id);match previous.tail {blot_check_effects::Tail.variable payload=>{if payload.value==variable.value {let err=self.diagnostic(Code.effect_mismatch,source);if err!=blot_error::Error.none {return err;}}},_=>{}}}}return blot_error::Error.none;}
fn Engine::contractArgumentsEqual(self:Engine&,given:blot_check_types::Obligation,contract:Identity,arguments:const u32[:],resolve:bool)->bool,blot_error::Error {if given.kind!=blot_check_types::ObligationKind.contract || given.identity!=contract {return false,blot_error::Error.none;}let node=self.types.node(self.types.head(given.ty,0));if node.tag!=blot_check_types::Tag.product || node.b!=arguments.len {return false,blot_error::Error.none;}let expected=equation_type_ids.alloc_slice(node.b);for item,index in self.types.list(blot_check_types::List{start:node.a,len:node.b}) {expected[index]=item;}let same,err=contractArgumentsEqualBody(self,expected,arguments,resolve);equation_type_ids.free_slice(expected);return same,err;}
fn contractArgumentsEqualBody(self:Engine&,expected:const u32[:],arguments:const u32[:],resolve:bool)->bool,blot_error::Error {var same=true;for left,index in expected {var before=left;var after=arguments[index];if resolve {let value,err=self.types.resolve(before,0);if err!=blot_error::Error.none {return false,err;}before=value;let value,err=self.types.resolve(after,0);if err!=blot_error::Error.none {return false,err;}after=value;}let equal,err=self.types.equalSymbolic(before,after);if err!=blot_error::Error.none {return false,err;}if !equal {same=false;}}return same,blot_error::Error.none;}
fn Engine::contractGiven(self:Engine&,contract:Identity,arguments:const u32[:])->bool,blot_error::Error {for given in self.annotation_givens {let err=self.inferenceTransition();if err!=blot_error::Error.none {return false,err;}let same,err=self.contractArgumentsEqual(given,contract,arguments,true);if err!=blot_error::Error.none || same {return same,err;}}for lexical in self.dictionary_givens {let same,err=self.contractArgumentsEqual(lexical.predicate,contract,arguments,true);if err!=blot_error::Error.none || same {return same,err;}}for boundary in self.qualifications {if boundary.owner!=self.current {continue;}for given in self.declared_obligations[boundary.clauses.start..boundary.clauses.start+boundary.clauses.len] {let same,err=self.contractArgumentsEqual(given,contract,arguments,false);if err!=blot_error::Error.none || same {return same,err;}}}if self.checking_implementation.present {let declaration=self.implementations[self.checking_implementation.value];if declaration.contract==contract && declaration.head.len==arguments.len {let same,err=contractArgumentsEqualBody(self,self.types.list(declaration.head),arguments,false);if err!=blot_error::Error.none || same {return same,err;}}for given in self.implementation_predicates[declaration.predicates.start..declaration.predicates.start+declaration.predicates.len] {let same,err=self.contractArgumentsEqual(given,contract,arguments,false);if err!=blot_error::Error.none || same {return same,err;}}}return false,blot_error::Error.none;}
fn Engine::privateImplementationAllowed(self:const Engine&,source:u32)->bool {let span=self.tree.span(source);for root in self.tree.roots.items {let enclosing=self.tree.span(root);if span.start<enclosing.start || span.end>enclosing.end {continue;}if self.tree.declaration_traits(root).private {return true;}if self.tree.node(root).tag==blot_parse_ast::tag_implementation_decl {let declaration=self.tree.implementation(root);for member in self.tree.list(declaration.members) {if self.tree.node(member).tag!=blot_parse_ast::tag_value_decl {continue;}if source==member && self.implementation_bindings.contains(self.current) {return true;}let body=self.tree.span(self.tree.value_decl(member).body);if span.start>=body.start && span.end<=body.end {return true;}}return false;}if self.tree.node(root).tag!=blot_parse_ast::tag_value_decl {return false;}let value=self.tree.value_decl(root);for header in [value.annotation,value.where_node] {if header==0 {continue;}let boundary=self.tree.span(header);if span.start>=boundary.start && span.end<=boundary.end {return false;}}return true;}return self.current!=0;}
fn Engine::selectedMember(self:const Engine&,proof:u32,name:u32)->blot_support::Option<ImplementationMember> {let declaration=self.selected_proofs[proof];for member in self.selected_members[declaration.members.start..declaration.members.start+declaration.members.len] {if member.name==name {return blot_support::some(member);}}return blot_support::none<ImplementationMember>();}
fn legacyError(err:blot_error::Error)->blot_error::Error {if err==blot_error::Error.out_of_memory {return err;}if err==blot_error::Error.evidence_limit {return blot_error::Error.type_limit;}return blot_error::Error.type_mismatch;}
fn Engine::proveImplementationPredicate(self:Engine&,predicate:blot_check_types::Obligation&,source:u32)->bool,blot_error::Error {self.proved_predicate_target=ExternalTarget{unit:0,binding:0};self.proved_predicate_prerequisites=blot_check_types::List{};let kind=predicate.kind;if kind==blot_check_types::ObligationKind.callee_use {return self.proveCalleePredicate(predicate,source);}if kind==blot_check_types::ObligationKind.dispatch || kind==blot_check_types::ObligationKind.receiver || kind==blot_check_types::ObligationKind.field || kind==blot_check_types::ObligationKind.writable_field || kind==blot_check_types::ObligationKind.result_dispatch || kind==blot_check_types::ObligationKind.resolver_dispatch {return self.proveLegacy(predicate,source);}if kind==blot_check_types::ObligationKind.effect_operation {return proveEffectOperation(self,predicate);}if kind!=blot_check_types::ObligationKind.type_eq {let open,err=self.requirementOpen(predicate);if err!=blot_error::Error.none || open {return false,err;}}let tag=self.types.node(self.types.head(predicate.ty,0)).tag;if kind==blot_check_types::ObligationKind.update && predicate.signature!=0 {let carrier=self.types.node(self.types.head(predicate.signature,0));if carrier.tag!=blot_check_types::Tag.function {return false,blot_error::Error.none;}let row_id,err=self.types.resolveEffects(carrier.c,0);if err!=blot_error::Error.none {return false,err;}let row=self.types.row(row_id);if row.labels.len==0 {match row.tail {blot_check_effects::Tail.variable payload=>{let value,err=self.types.functionWithEffects(blot_check_types::unit,blot_check_types::unit,0);if err!=blot_error::Error.none {return false,err;}predicate.signature=value;},_=>{}}}}match kind {blot_check_types::ObligationKind.arithmetic=>{return tag==blot_check_types::Tag.unsigned32 || tag==blot_check_types::Tag.floating32,blot_error::Error.none;},blot_check_types::ObligationKind.ordered=>{return tag==blot_check_types::Tag.unsigned32 || tag==blot_check_types::Tag.floating32,blot_error::Error.none;},blot_check_types::ObligationKind.equality=>{return tag==blot_check_types::Tag.unsigned32 || tag==blot_check_types::Tag.floating32 || tag==blot_check_types::Tag.boolean,blot_error::Error.none;},blot_check_types::ObligationKind.integer=>{return tag==blot_check_types::Tag.unsigned32,blot_error::Error.none;},blot_check_types::ObligationKind.type_rep=>{return true,blot_error::Error.none;},blot_check_types::ObligationKind.effect_rep=>{return true,blot_error::Error.none;},blot_check_types::ObligationKind.type_eq=>{let left,err=self.normalizeAssociated(predicate.ty,source,true);if err!=blot_error::Error.none {return false,err;}let right,err=self.normalizeAssociated(predicate.result,source,true);if err!=blot_error::Error.none {return false,err;}predicate.ty=left;predicate.result=right;return self.types.equalSymbolic(left,right);},_=>{}}
 let ambient=self.ambient;let solved,err=proveImplementationInvocation(self,predicate);self.ambient=ambient;return solved,err;}
fn proveEffectOperation(self:Engine&,predicate:blot_check_types::Obligation&)->bool,blot_error::Error {let arguments,err=self.types.resolve(predicate.other,0);if err!=blot_error::Error.none {return false,err;}let closed,err=self.types.equalClosed(arguments,arguments);if err!=blot_error::Error.none || !closed {return false,err;}let pack=self.types.node(arguments);if pack.tag!=blot_check_types::Tag.product {return false,blot_error::Error.none;}let actuals=equation_type_ids.alloc_slice(pack.b);for value,index in self.types.list(blot_check_types::List{pack.a,pack.b}) {actuals[index]=value;}let label,err=self.types.internOperation(predicate.identity,actuals);equation_type_ids.free_slice(actuals);if err!=blot_error::Error.none {return false,err;}let carrier_id,err=self.types.resolve(predicate.signature,0);if err!=blot_error::Error.none {return false,err;}let carrier=self.types.node(carrier_id);if carrier.tag!=blot_check_types::Tag.function {return false,blot_error::Error.none;}let row=self.types.row(carrier.c);for known in self.types.rowLabels(carrier.c) {if known==label {return true,blot_error::Error.none;}}var open=false;match row.tail {blot_check_effects::Tail.variable payload=>{open=true;},_=>{}}if !open {return false,blot_error::Error.none;}let labels=equation_type_ids.alloc_slice(row.labels.len+1);for value,index in self.types.rowLabels(carrier.c) {labels[index]=value;}labels[labels.len-1]=label;let established,err=self.types.effects.row(labels,blot_check_effects::Tail.closed);equation_type_ids.free_slice(labels);if err!=blot_error::Error.none {return false,blot_check_types::effectError(err);}let err=self.types.unifyEffects(carrier.c,established);if err!=blot_error::Error.none {return false,err;}let root,err=self.types.resolve(predicate.ty,0);if err!=blot_error::Error.none {return false,err;}predicate.ty=root;let signature,err=self.types.resolve(predicate.signature,0);if err!=blot_error::Error.none {return false,err;}predicate.signature=signature;return true,blot_error::Error.none;}
fn proveImplementationInvocation(self:Engine&,predicate:blot_check_types::Obligation&)->bool,blot_error::Error {if predicate.signature==0 {let row,err=self.types.freshEffects();if err!=blot_error::Error.none {return false,err;}self.ambient=row;}else {let carrier=self.types.node(self.types.head(predicate.signature,0));if carrier.tag!=blot_check_types::Tag.function {return false,blot_error::Error.none;}self.ambient=carrier.c;}let start=self.diagnostics.len;let index=self.pending.len;let err=self.appendPending(PendingObligation{owner:self.current,value:predicate});if err!=blot_error::Error.none {return false,err;}let attempted,err=self.attemptPending(index,self.pending[index]);if err!=blot_error::Error.none {return false,err;}let solved=self.pending[index].solved && self.diagnostics.len==start;self.pending[index].solved=true;if self.diagnostics.len!=start {deinitDiagnosticPayloads(self.diagnostics[start..]);self.diagnostics.resize(start);}return solved,blot_error::Error.none;}
fn Engine::proveCalleePredicate(self:Engine&,predicate:blot_check_types::Obligation&,source:u32)->bool,blot_error::Error {let binding=predicate.identity.decl;let prepared,err=self.prepareSelectedGlobal(binding);if err!=blot_error::Error.none || !prepared {return false,err;}let principal=self.bindings[binding].scheme;let summary=self.bindings[binding].summary;let root,err=self.types.resolve(predicate.ty,0);if err!=blot_error::Error.none {return false,err;}let pack=self.types.node(root);if pack.tag!=blot_check_types::Tag.product || pack.b!=summary.public_variables.len+summary.public_rows.len {return false,blot_error::Error.none;}if self.active_evidence.len>=256 || self.active_predicates.len>=256-self.active_evidence.len {let err=self.diagnostic(Code.associated_limit,source);return false,err;}for active in self.active_predicates {let allowed,err=self.associatedStep(source);if err!=blot_error::Error.none || !allowed {return false,err;}if active.binding==binding && active.value.kind==blot_check_types::ObligationKind.callee_use {let before,err=self.types.resolve(active.value.ty,0);if err!=blot_error::Error.none {return false,err;}let after,err=self.types.resolve(predicate.ty,0);if err!=blot_error::Error.none {return false,err;}let equal,err=self.types.equalSymbolic(before,after);if err!=blot_error::Error.none {return false,err;}if equal {let err=self.diagnostic(Code.recursive_evidence,source);return false,err;}}}self.active_predicates.append(Engine_active_predicates{binding:binding,value:predicate});let result,err=proveCalleeActive(self,predicate,source,binding,principal,summary,pack);self.active_predicates.resize(self.active_predicates.len-1);return result,err;}
