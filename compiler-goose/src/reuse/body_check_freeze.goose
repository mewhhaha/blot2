 { let propagated_error = require(selected.present); if propagated_error != blot_error::Error.none { return propagated_error; } }let origin=selected.value;var index:i64=-1;for prior,at in work.qualifications.items {if prior==origin {index=at;break;}}if index<0 {index=work.qualifications.items.len;let pushed=work.qualifications.push(origin);if pushed!=blot_error::Error.none {return pushed;}}goal.qualification_span=blot_support::some(blot_parse_ast::Span{(index+1) as u32,0, ..});goal.qualification_unit=0;
 }
 if goal.name!=0 {let name,error=ownFieldName(work.fields,catalog.pool.get(goal.name));{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }goal.name=1+name;}
 if goal.kind==blot_check_types::ObligationKind.contract {let slot,error=ownIdentityRead(catalog,source,work.nominals,goal.identity,true);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }goal.identity=Identity{slot+1,0, ..};}
 else if goal.kind==blot_check_types::ObligationKind.effect_operation {let slot,error=ownOperationRead(catalog,source,work.nominals,goal.identity);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }goal.identity=Identity{slot+1,0, ..};}
 }
 { let propagated_error = require(operations.len<=4096); if propagated_error != blot_error::Error.none { return propagated_error; } }for &operation,label in operations {if label<=blot_check_types::foreign_operation {continue;}let slot,error=ownOperationRead(catalog,source,work.nominals,operation.identity);{ let propagated_error = error; if propagated_error != blot_error::Error.none { return propagated_error; } }operation.identity=Identity{slot+1,0, ..};}
