fn Builder::projectOperation(self:Builder&,label:u32,depth:i64)->u32,Error {if depth>=1024 || label==0 || label>=self.scratch.effect_operation_map.len {return 0,Error.core_limit;}if self.scratch.effect_operation_map[label]!=0 {return self.scratch.effect_operation_map[label],Error.none;}let source=self.source.checked.types.operations.items[label];var values=WordBuffer{..};let result,error=projectOperationValues(self,label,source,depth,values);values.deinit();return result,error;}
fn projectOperationValues(self:Builder&,label:u32,source:blot_check_types::Operation,depth:i64,values:WordBuffer&)->u32,Error {for argument in self.source.checked.types.list(source.arguments) {let projected,error=self.projectType(argument,depth+1);if error!=Error.none {return 0,error;}let error=values.append(projected);if error!=Error.none {return 0,error;}}let arguments,error=self.saveTypes(values.items);if error!=Error.none {return 0,error;}if self.tables.effect_operations.len==0xffffffff {return 0,Error.core_limit;}let id=self.tables.effect_operations.len as u32;let instance,error=self.projectInstance(source.instance,depth+1);if error!=Error.none {return 0,error;}self.tables.effect_operations.push(blot_check_types::Operation{identity:source.identity,arguments:arguments,instance:instance, ..});self.scratch.effect_operation_map[label]=id;return id,Error.none;}
recursive fn Builder::projectRow(self:Builder&,source:u32,depth:i64)->u32,Error {if source==0 {return 0,Error.none;}if depth>=1024 || source>=self.scratch.effect_row_map.len {return 0,Error.core_limit;}if self.scratch.effect_row_map[source]!=0 {return self.scratch.effect_row_map[source]-1,Error.none;}let original=self.source.checked.types.effects.node(source);var labels=WordBuffer{..};let result,error=projectRowLabels(self,source,original,depth,labels);labels.deinit();return result,error;}
fn projectRowLabels(self:Builder&,source:u32,original:blot_check_effects::Row,depth:i64,labels:WordBuffer&)->u32,Error {for label in self.source.checked.types.effects.list(original.labels) {let projected,error=self.projectOperation(label,depth+1);if error!=Error.none {return 0,error;}let error=labels.append(projected);if error!=Error.none {return 0,error;}}var tail=blot_check_effects::Tail.closed;match original.tail {blot_check_effects::Tail.closed=>{},blot_check_effects::Tail.variable payload=>{let variable,error=self.projectRowVariable(payload.value);if error!=Error.none {return 0,error;}tail=blot_check_effects::Tail.variable{value:variable, ..};},blot_check_effects::Tail.parameter payload=>{tail=blot_check_effects::Tail.parameter{value:payload.value, ..};},blot_check_effects::Tail.formal payload=>{let formal,error=self.projectType(payload.value,depth+1);if error!=Error.none {return 0,error;}tail=blot_check_effects::Tail.formal{value:formal, ..};},}if labels.items.len==0 && tail==blot_check_effects::Tail.closed {self.scratch.effect_row_map[source]=1;return 0,Error.none;}if self.tables.effect_rows.len==0xffffffff || labels.items.len>0xffffffff-self.tables.effect_labels.len {return 0,Error.core_limit;}let start=self.tables.effect_labels.len as u32;self.tables.effect_labels.append(labels.items);let id=self.tables.effect_rows.len as u32;self.tables.effect_rows.push(blot_check_effects::Row{labels:blot_check_effects::List{start,labels.items.len as u32, ..},tail:tail, ..});self.scratch.effect_row_map[source]=id+1;return id,Error.none;}
fn Builder::saveTypes(self:Builder&,values:const u32[:])->blot_check_types::List,Error {if values.len>0xffffffff-self.tables.type_extra.len {return blot_check_types::List{..},Error.core_limit;}let start=self.tables.type_extra.len as u32;self.tables.type_extra.append(values);return blot_check_types::List{start,values.len as u32, ..},Error.none;}
fn Builder::projectScheme(self:Builder&,scheme:blot_check_types::Scheme,local:bool)->blot_check_types::Scheme,Error {let root,error=self.projectType(scheme.root,0);if error!=Error.none {return blot_check_types::Scheme{..},error;}var variables=WordBuffer{..};var rows=WordBuffer{..};let result,error=projectSchemeLists(self,scheme,local,root,variables,rows);variables.deinit();rows.deinit();return result,error;}
fn wordContains(words:const u32[:],value:u32)->bool {for word in words {if word==value {return true;}}return false;}
fn projectSchemeLists(self:Builder&,scheme:blot_check_types::Scheme,local:bool,root:u32,variables:WordBuffer&,rows:WordBuffer&)->blot_check_types::Scheme,Error {for id in self.source.checked.types.list(scheme.variables) {let projected,error=self.projectType(id,0);if error!=Error.none {return blot_check_types::Scheme{..},error;}let tag=self.tables.type_nodes[root].tag;if local && tag!=blot_check_types::Tag.forall && tag!=blot_check_types::Tag.existential {if self.tables.type_nodes[projected].tag!=blot_check_types::Tag.variable || wordContains(variables.items,projected) {continue;}}let error=variables.append(projected);if error!=Error.none {return blot_check_types::Scheme{..},error;}}var universal=root;var scopes:i64=0;while self.tables.type_nodes[universal].tag==blot_check_types::Tag.forall {if scopes==128 {return blot_check_types::Scheme{..},Error.core_limit;}scopes+=1;let quantifier=self.tables.type_nodes[universal];let error=variables.appendSlice(self.tables.type_extra[quantifier.b..quantifier.b+quantifier.c]);if error!=Error.none {return blot_check_types::Scheme{..},error;}universal=quantifier.a;}let span,error=self.saveTypes(variables.items);if error!=Error.none {return blot_check_types::Scheme{..},error;}for variable in self.source.checked.types.list(scheme.row_variables) {let projected,error=self.projectRowVariable(variable);if error!=Error.none {return blot_check_types::Scheme{..},error;}let error=rows.append(projected);if error!=Error.none {return blot_check_types::Scheme{..},error;}}let row_span,error=self.saveTypes(rows.items);if error!=Error.none {return blot_check_types::Scheme{..},error;}rows.clear();for variable in self.source.checked.types.list(scheme.closed_rows) {let projected,error=self.projectRowVariable(variable);if error!=Error.none {return blot_check_types::Scheme{..},error;}let error=rows.append(projected);if error!=Error.none {return blot_check_types::Scheme{..},error;}}let closed_span,error=self.saveTypes(rows.items);if error!=Error.none {return blot_check_types::Scheme{..},error;}let start=self.tables.obligations.len as u32;for value in self.source.checked.obligations[scheme.obligations.start..scheme.obligations.start+scheme.obligations.len] {let error=self.projectObligation(value);if error!=Error.none {return blot_check_types::Scheme{..},error;}}let generative,error=self.projectPublic(scheme.generative,false);if error!=Error.none {return blot_check_types::Scheme{..},error;}return blot_check_types::Scheme{root:root,variables:span,row_variables:row_span,closed_rows:closed_span,generative:generative,obligations:blot_check_types::List{start,(self.tables.obligations.len-start) as u32, ..}, ..},Error.none;}
fn Builder::projectObligation(self:Builder&,value:blot_check_types::Obligation)->Error {let ty,error=self.projectType(value.ty,0);if error!=Error.none {return error;}let result,error=self.projectType(value.result,0);if error!=Error.none {return error;}let other,error=self.projectType(value.other,0);if error!=Error.none {return error;}let signature,error=self.projectType(value.signature,0);if error!=Error.none {return error;}var diagnostic_name=blot_check_core::Name{..};if value.explicit && value.name!=0 {let name,error=self.saveName(self.source.names.get(value.name));if error!=Error.none {return error;}diagnostic_name=name;}self.tables.obligations.push(blot_check_core::Obligation{ty:ty,kind:value.kind,span:self.source.checked.diagnosticSpan(self.source.tree,value.source),name:value.name,result:result,other:other,signature:signature,operator:value.operator,identity:value.identity,explicit:value.explicit,qualification_span:value.qualification_span,qualification_unit:value.qualification_unit,diagnostic_name:diagnostic_name, ..});return Error.none;}
fn Builder::projectPublic(self:Builder&,public:blot_check_types::List,rows:bool)->blot_check_types::List,Error {var values=WordBuffer{..};let result,error=projectPublicValues(self,public,rows,values);values.deinit();return result,error;}
fn projectPublicValues(self:Builder&,public:blot_check_types::List,rows:bool,values:WordBuffer&)->blot_check_types::List,Error {for id in self.source.checked.types.list(public) {var projected:u32=0;if rows {let value,error=self.projectRowVariable(id);if error!=Error.none {return blot_check_types::List{..},error;}projected=value;}else {let value,error=self.projectType(id,0);if error!=Error.none {return blot_check_types::List{..},error;}projected=value;}let error=values.append(projected);if error!=Error.none {return blot_check_types::List{..},error;}}return self.saveTypes(values.items);}
fn Builder::reserve(self:Builder&,source:u32)->u32,Error {if self.tables.nodes.len==0xffffffff {return 0,Error.core_limit;}let id=self.tables.nodes.len as u32;self.tables.nodes.push(blot_check_core::Node{tag:blot_check_core::Tag.invalid, ..});self.tables.spans.push(self.source.checked.diagnosticSpan(self.source.tree,source));self.tables.merge_ranges.push(List{..});self.tables.dispatch_signatures.push(0);return id,Error.none;}
fn Builder::make(self:Builder&,source:u32,value:blot_check_core::Node)->u32,Error {let id,error=self.reserve(source);if error!=Error.none {return 0,error;}self.tables.nodes[id]=value;if value.tag==blot_check_core::Tag.call || value.tag==blot_check_core::Tag.reference {let span=self.source.tree.span(source);for use in self.source.checked.selected_uses {let origin=self.source.tree.span(use.source);if origin.start<span.start || origin.end>span.end {continue;}self.tables.selected_uses.push(blot_check_core::SelectedUse{node:id,proof:use.proof, ..});}}
 if value.tag==blot_check_core::Tag.project && self.tables.projections[value.b].diagnostic_point==0 {let field=self.tables.projections[value.b].field;var member_point:u32=0;var matches:i64=0;var next:u32=0;if source<self.scratch.member_origin_heads.len {next=self.scratch.member_origin_heads[source];}while next!=0 {let index=next-1;let origin=self.source.tree.operator_origins.items[index];next=self.scratch.member_origin_next[index];if origin.member!=field {continue;}matches+=1;member_point=origin.member_point;if matches==2 {break;}}if matches==1 {let ordinary=self.source.tree.span(source);let selected=self.source.checked.diagnosticSpan(self.source.tree,source);var point=member_point;if selected.start!=ordinary.start || selected.end!=ordinary.end {point=selected.start;}self.tables.projections[value.b].diagnostic_point=point;}}
 if value.tag==blot_check_core::Tag.bind && value.a!=0 && value.a<self.tables.bindings.len {self.tables.bindings[value.a].initializer=value.b;if self.tables.nodes[value.b].tag==blot_check_core::Tag.closure {let template .= self.tables.closures[self.tables.nodes[value.b].a];if template.qualifier==0 {template.qualifier=value.a;}}}if self.scratch.signature_sources.len!=0 && self.scratch.signature_sources[source]!=0 {let signature,error=self.projectType(self.scratch.signature_sources[source],0);if error!=Error.none {return 0,error;}let callable=self.tables.type_nodes[signature];if value.tag==blot_check_core::Tag.project && callable.tag==blot_check_types::Tag.function {let projected,error=self.addType(blot_check_types::Node{tag:blot_check_types::Tag.function,a:self.tables.nodes[value.a].ty,b:value.ty,c:callable.c, ..});if error!=Error.none {return 0,error;}self.tables.dispatch_signatures[id]=projected;}else {self.tables.dispatch_signatures[id]=signature;}}return id,Error.none;
}
fn Builder::save(self:Builder&,values:const u32[:])->List,Error {if values.len>0xffffffff-self.tables.extra.len {return List{..},Error.core_limit;}let start=self.tables.extra.len as u32;self.tables.extra.append(values);return List{start,values.len as u32, ..},Error.none;}
fn Builder::unwrap(self:const Builder&,original:u32)->u32 {var source=original;while self.source.tree.node(source).tag==blot_parse_ast::tag_group {source=self.source.tree.node(source).a;}return source;}
fn Builder::target(self:const Builder&,binding:u32)->blot_check_core::BindingRef {if binding>=self.source.checked.bindings.len {return blot_check_core::BindingRef{binding:binding, ..};}let value=self.source.checked.bindings[binding];if value.external.present {let external=value.external.value;return blot_check_core::BindingRef{unit:external.unit,binding:external.binding, ..};}return blot_check_core::BindingRef{binding:binding, ..};}
fn Builder::typeOf(self:Builder&,source:u32)->u32,Error {return self.projectType(self.source.checked.expr_types[source],0);}
fn Builder::referenceNode(self:Builder&,source:u32,binding:u32,ty:u32)->u32,Error {let index=self.tables.references.len as u32;self.tables.references.push(self.target(binding));return self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.reference,ty:ty,a:index, ..});}
fn Builder::saveFieldName(self:Builder&,symbol:u32)->Error {if symbol==0 || self.scratch.saved_fields.contains(symbol) {return Error.none;}self.scratch.saved_fields.insert(symbol,true);let spelling,error=self.saveName(self.source.names.get(symbol));if error!=Error.none {return error;}self.tables.field_names.push(blot_check_core::FieldName{symbol: symbol,spelling:spelling, ..});return Error.none;}
fn Builder::projectionIndex(self:Builder&,catalog:u32,source_type:u32,result_type:u32)->u32,Error {let metadata=self.source.checked.projection_catalog[catalog];let error=self.saveFieldName(metadata.field);if error!=Error.none {return 0,error;}let start=self.tables.projection_variants.len as u32;let words=self.source.checked.types.list(metadata.variants);var offset:i64=0;while offset<words.len {self.tables.projection_variants.push(blot_check_core::ProjectionVariant{tag:words[offset],field:words[offset+1], ..});offset+=2;}let index=self.tables.projections.len as u32;self.tables.projections.push(blot_check_core::Projection{nominal:metadata.nominal,field:metadata.field,source_type:source_type,result_type:result_type,variants:List{start,(words.len/2) as u32, ..}, ..});return index,Error.none;}
fn Builder::directProjection(self:Builder&,source_type:u32,result_type:u32,field:u32)->u32,Error {let start=self.tables.projection_variants.len as u32;self.tables.projection_variants.push(blot_check_core::ProjectionVariant{tag:0,field:field, ..});let index=self.tables.projections.len as u32;self.tables.projections.push(blot_check_core::Projection{nominal:Identity{0,0, ..},source_type:source_type,result_type:result_type,variants:List{start,1, ..}, ..});return index,Error.none;}
fn Builder::resolvedReference(self:Builder&,source:u32,ty:u32)->u32,Error {let binding=self.source.checked.resolved[source];if binding==0 {let error=self.diagnostic(blot_check_core::Code.unresolved_binding,source);return 0,error;}return self.projectedReference(source,binding,ty,source);}
fn Builder::projectedReference(self:Builder&,source:u32,binding:u32,ty:u32,path_source:u32)->u32,Error {var path:const u32[:]=[];if path_source<self.source.checked.access_paths.len {path=self.source.checked.types.list(self.source.checked.access_paths[path_source]);}if path.len==0 {return self.referenceNode(source,binding,ty);}let types=self.source.checked.types.list(self.source.checked.access_types[path_source]);if types.len!=path.len+1 {let error=self.diagnostic(blot_check_core::Code.unresolved_binding,source);return 0,error;}let first_type,error=self.projectType(types[0],0);if error!=Error.none {return 0,error;}let first,error=self.referenceNode(source,binding,first_type);if error!=Error.none {return 0,error;}var result=first;for catalog,index in path {let result_type,error=self.projectType(types[index+1],0);if error!=Error.none {return 0,error;}let projection,error=self.projectionIndex(catalog,self.tables.nodes[result].ty,result_type);if error!=Error.none {return 0,error;}let projected,error=self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.project,ty:result_type,a:result,b:projection, ..});if error!=Error.none {return 0,error;}result=projected;}return result,Error.none;}
fn Builder::productExpression(self:Builder&,source:u32,ty:u32,tag:blot_check_core::Tag,depth:i64)->u32,Error {var values=WordBuffer{..};let result,error=productExpressionValues(self,source,ty,tag,depth,values);values.deinit();return result,error;}
fn productExpressionValues(self:Builder&,source:u32,ty:u32,tag:blot_check_core::Tag,depth:i64,values:WordBuffer&)->u32,Error {for child in self.source.tree.children(source) {let value,error=self.expression(child,depth+1);if error!=Error.none {return 0,error;}let error=values.append(value);if error!=Error.none {return 0,error;}}let range,error=self.save(values.items);if error!=Error.none {return 0,error;}return self.make(source,blot_check_core::Node{tag:tag,ty:ty,a:range.start,b:range.len, ..});}
fn Builder::stringExpression(self:Builder&,source:u32,ty:u32)->u32,Error {let bytes=self.source.names.get(self.source.tree.node(source).a);var values=WordBuffer{..};let result,error=stringExpressionValues(self,source,ty,bytes,values);values.deinit();return result,error;}
fn stringExpressionValues(self:Builder&,source:u32,ty:u32,bytes:const u8[:],values:WordBuffer&)->u32,Error {var at:i64=0;while at<bytes.len {let width=blot_parse_lexer::utf8_width(bytes[at]);let point,error=blot_parse_lexer::decode_point(bytes[at..at+width]);if error!=Error.none {return 0,Error.core_limit;}at+=width;let value,error=self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.constant,ty:blot_check_types::u32_type,a:point, ..});if error!=Error.none {return 0,error;}let error=values.append(value);if error!=Error.none {return 0,error;}}let range,error=self.save(values.items);if error!=Error.none {return 0,error;}return self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.array,ty:ty,a:range.start,b:range.len, ..});}
fn Builder::recordExpression(self:Builder&,source:u32,ty:u32,depth:i64)->u32,Error {var catalog:u32=0;if source<self.source.checked.constructor_resolved.len {catalog=self.source.checked.constructor_resolved[source];}if catalog==0 && self.source.tree.node(source).a!=0 {let error=self.diagnostic(blot_check_core::Code.unresolved_binding,source);return 0,error;}let fields=self.source.tree.children(source);if catalog!=0 && fields.len==0 && self.source.checked.constructors[catalog].payload==0 {return self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.construct,ty:ty,a:catalog, ..});}if fields.len>0x3fffffffffffffff {return 0,Error.core_limit;}var values=WordBuffer{..};var destinations=WordBuffer{..};let types=word_runs.alloc_slice(fields.len*2);for &value in types {value=0;}let result,error=recordExpressionFields(self,source,ty,depth,catalog,fields,values,destinations,types);word_runs.free_slice(types);values.deinit();destinations.deinit();return result,error;}
fn recordExpressionFields(self:Builder&,source:u32,ty:u32,depth:i64,catalog:u32,fields:const u32[:],values:WordBuffer&,destinations:WordBuffer&,types:u32[:])->u32,Error {for field in fields {let syntax=self.source.tree.node(field);let destination=self.source.checked.projections[field];if destination>=fields.len {let error=self.diagnostic(blot_check_core::Code.unresolved_binding,field);return 0,error;}var value:u32=0;if syntax.b==0 {let field_type,error=self.typeOf(field);if error!=Error.none {return 0,error;}let reference,error=self.resolvedReference(field,field_type);if error!=Error.none {return 0,error;}value=reference;}else {let expression,error=self.expression(syntax.b,depth+1);if error!=Error.none {return 0,error;}value=expression;}let error=values.append(value);if error!=Error.none {return 0,error;}let error=destinations.append(destination);if error!=Error.none {return 0,error;}types[destination*2]=syntax.a;types[destination*2+1]=self.tables.nodes[value].ty;}let type_range,error=self.saveTypes(types);if error!=Error.none {return 0,error;}let payload_type,error=self.addType(blot_check_types::Node{tag:blot_check_types::Tag.record,a:type_range.start,b:fields.len as u32, ..});if error!=Error.none {return 0,error;}let value_range,error=self.save(values.items);if error!=Error.none {return 0,error;}var result_type=payload_type;if catalog==0 && self.tables.type_nodes[ty].tag==blot_check_types::Tag.usage {result_type=ty;let required=self.tables.type_nodes[self.tables.type_nodes[ty].a];if required.tag!=blot_check_types::Tag.record || required.b!=fields.len {return 0,Error.core_limit;}for field,ordinal in fields {let name=self.source.tree.node(field).a;var found=false;for index in 0..required.b {if self.tables.type_extra[required.a+index*2]==name {destinations.items[ordinal]=index as u32;found=true;break;}}if !found {return 0,Error.core_limit;}}}let destination_range,error=self.save(destinations.items);if error!=Error.none {return 0,error;}let payload,error=self.make(sou