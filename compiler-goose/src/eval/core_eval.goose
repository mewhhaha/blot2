var inactive_member_trace: blot_reuse_specialization_receipt::MemberTrace=blot_reuse_specialization_receipt::MemberTrace {..};
reusable var member_trace_slots: blot_reuse_specialization_receipt::MemberTrace[>..]=[];
fn memberTraceSlot(index: i64) -> blot_reuse_specialization_receipt::MemberTrace& { if index<0 { return inactive_member_trace; } return member_trace_slots[index]; }

fn sessionTables(session: const Session&) -> SessionTables { assert(session.session_owner_slot!=0); let at=session.session_owner_slot-1; assert(at<session_owners.len&&session_owners[at].live&&session_owners[at].generation==session.session_owner_generation); return session_owners[at].tables; }

fn canonicalSession(self_:Session&)->Session& {
 assert(self_.session_owner_slot!=0);let at=self_.session_owner_slot-1;
 assert(at<session_owners.len && session_owners[at].live && session_owners[at].generation==self_.session_owner_generation);
 let owner:SessionOwner& = session_owners[at];assert(owner.session<live_sessions.len);
 let registered:Session& = live_sessions[owner.session];let supplied:Session& = self_;
 assert(supplied .== registered);return registered;
}

fn canonicalReadSession(self_:const Session&)->const Session& {assert(self_.session_owner_slot!=0);let at=self_.session_owner_slot-1;assert(at<session_owners.len&&session_owners[at].live&&session_owners[at].generation==self_.session_owner_generation);let owner:const SessionOwner& =session_owners[at];assert(owner.session<live_sessions.len);let registered:const Session& =live_sessions[owner.session];let supplied:const Session& =self_;assert(supplied .==registered);return registered;}

fn ownedSessionTables(self_:const Session&)->SessionTables {
 assert(self_.session_owner_slot!=0);let at=self_.session_owner_slot-1;
 assert(at<session_owners.len&&session_owners[at].live&&session_owners[at].generation==self_.session_owner_generation);
 return session_owners[at].tables;
}

fn selectedTypeChildren<S>(source:const S&,node:blot_check_types::Node)->const u32[:] {if node.tag==blot_check_types::Tag.product {return source.list(blot_check_types::List{node.a,node.b});}return source.nominalArguments(node);}
fn selectedClosureRows<M>(module:const M&,id:u32,tag:blot_check_core::Tag)->const u32[:] {if tag==blot_check_core::Tag.closure {return module.types.list(module.closure(id).closed_rows);}return default<const u32[:]>();}
fn selectedClosureCaptures<M>(module:const M&,node:blot_check_core::Node)->const u32[:] {if node.tag==blot_check_core::Tag.closure {let span=module.closures[node.a].captures;return module.extra[span.start..span.start+span.len];}return default<const u32[:]>();}

fn canonicalSolvedEvidence(source:SolvedEvidence)->SolvedEvidence {
 return SolvedEvidence{solved_types.realloc_slice(source.types,source.types.len),solved_rows.realloc_slice(source.rows,source.rows.len),solved_selected.realloc_slice(source.selected,source.selected.len)};
}
fn canonicalPrincipalGraph(source:PrincipalGraph?)->PrincipalGraph? {
 if !source {return null;}let at=source.pool_index;assert(at>=0 && at<principal_graph_pool.len);
 let graph:PrincipalGraph& =principal_graph_pool[at];assert(graph .== source && graph.leases!=0);return graph;
}
fn canonicalRecords(self_:PrincipalAdapter,source:const PrincipalRecord[:])->PrincipalRecord[:] {return principal_query_records.realloc_slice(source,source.len);}
fn canonicalRecord(self_:PrincipalAdapter,source:PrincipalRecord)->PrincipalRecord {
 return PrincipalRecord{source.key,PrincipalDependencies{
  principal_dependency_sources.realloc_slice(source.dependencies.sources,source.dependencies.sources.len),
  principal_dependency_plain.realloc_slice(source.dependencies.plain,source.dependencies.plain.len),
  source.dependencies.has_writes},PrincipalGraphResult{canonicalPrincipalGraph(source.value.graph)}};
}

fn requireReference<T>(value:T?)->T& {assert(value);return value;}
