// Word frequency counting: generate skewed text into a pre-sized byte buffer
// via bulk extend_view, split into packed spans, and count in an open-addressed table.
import * as rng from "./rng"

const BENCH_N: U32 = 2000000 // BENCH_N

type Slot is data = $Slot { packed: U32, count: U32 }

func next_pow2 (v: U32): U32 =>
  let p: U32 = 16
  for ever:
    if p >= v:
      break
    p := self << 1
  return p

func hash_span (buf: #[U8]) -> (start: U32) -> (len: U32): U64 =>
  let h: U64 = rng.FNV_OFFSET
  for i in 0 .. len:
    h := rng.fnv_step self buf[start + i]
  return h

func eq_span (buf: #[U8]) -> (a: U32) -> (b: U32) -> (len: U32): Bool =>
  for i in 0 .. len:
    if buf[a + i] != buf[b + i]:
      return false
  return true

func build_text (vocab: U32): #[U8] =>
  let r: U64 = 12345u64
  let dict: #[U8] = Array.with_capacity (vocab * 9)
  let dict_spans = @array.fill vocab 0

  for i in 0 .. vocab:
    r := rng.xs_next self
    let n = 3 + (r % 12u64).to_u32
    let start = dict.length
    for _ in 0 .. n:
      r := rng.xs_next self
      dict := self.push (97 + (r % 26u64).to_u32).to_u8
    dict_spans[i] := (start << 4) | n

  let text: #[U8] = Array.with_capacity (BENCH_N * 10)
  let vocab_u64 = vocab.to_u64
  for _ in 0 .. BENCH_N:
    r := rng.xs_next self
    let a = (r % vocab_u64).to_u32
    let a64 = a.to_u64
    let k = ((a64 * a64) / vocab_u64).to_u32
    let sp = dict_spans[k]
    let ds = sp >> 4
    let dl = sp & 15
    text := Array.extend_view self dict[ds .. ds + dl]
    text := self.push ' '
  return text

io bench (): #[U32] =>
  let vocab = BENCH_N / 10 + 16
  let text = build_text vocab

  // Split text on spaces into packed (start << 4 | len) spans.
  let words: #[U32] = Array.with_capacity BENCH_N
  let wstart: U32 = 0
  for ti in 0 .. text.length:
    if text[ti] == ' ':
      if ti > wstart:
        words := self.push ((wstart << 4) | (ti - wstart))
      wstart := ti + 1
  if text.length > wstart:
    words := self.push ((wstart << 4) | (text.length - wstart))

  // Count in an open-addressed hash table referencing spans in text.
  let nslots = next_pow2 (vocab * 4)
  let mask = nslots - 1
  let slots = @array.fill nslots ($Slot { packed: 0, count: 0 })
  let distinct: U32 = 0

  for wi in 0 .. words.length:
    let wp = words[wi]
    let ws = wp >> 4
    let wl = wp & 15
    let idx = (hash_span text ws wl).to_u32 & mask
    for ever:
      let $Slot { packed: sp, count: sc } = slots[idx]
      if sc == 0:
        slots[idx] := $Slot { packed: wp, count: 1 }
        distinct := self + 1
        break
      let sl = sp & 15
      if sl == wl and eq_span text (sp >> 4) ws wl:
        slots[idx].count := sc + 1
        break
      idx := (self + 1) & mask

  let total: I64 = 0i64
  for si in 0 .. nslots:
    let $Slot { packed: sp, count: sc } = slots[si]
    if sc > 0:
      let ss = sp >> 4
      let sl = sp & 15
      let contrib = sc.to_i64 * (sl.to_i64 + text[ss].to_i64)
      total := self + contrib

  let out: #[U32] = #[]
  out := rng.emit_u32 self words.length
  out := rng.emit_u32 self distinct
  out := rng.emit_i64 self total
  return out
