fn admitEmission<G>(self:State&,g:G&,record:blot_reuse_artifact_emitter::Record,position:i64,last:u64,roots:const u32[:])->bool,Error {match record.event {
 EmitEvent.function item=>{let function=self.old.emission.functions[item.id];if function.role==FunctionRole.static_closure && !self.staticHelper(function,record.owner) {return false,Error.none;}},
 EmitEvent.callable_layout item=>{let owner=record.owner;if owner==0 || owner>self.old.metadata.jobs.len {return false,Error.none;}let job=self.old.metadata.jobs.items[owner-1];let declared=self.declaredCallableLayout(owner);if !job.function.present || job.function.value!=item.function || !declared.present || declared.value!=item.layout {return false,Error.none;}let ty,error=self.importer.importCallableLayout(g,item.layout,declared);if error!=Error.none || !ty.present {return false,error;}if g.representations.store.node(ty.value).tag!=blot_backend_layout::Tag.function {return false,Error.none;}},
 EmitEvent.semantic_site item=>{let site=item.value;if site.function>=self.old.emission.functions.len {return false,Error.none;}let function=self.old.emission.functions[site.function];if site.place>=function.instructions.len {return false,Error.none;}let instruction=self.old.emission.instructions[function.instructions.start+site.place];if site.kind==blot_backend_wasm::SemanticKind.diagnostic_memory {if blot_backend_runtime_ir::fixed(instruction.op).bytes==0 && instruction.op!=blot_backend_runtime_ir::OP_memory_copy && instruction.op!=blot_backend_runtime_ir::OP_memory_fill {return false,Error.none;}}else if instruction.op!=blot_backend_runtime_ir::OP_call && instruction.op!=blot_backend_runtime_ir::OP_call_indirect && instruction.op!=blot_backend_runtime_ir::OP_call_import {return false,Error.none;}if site.kind==blot_backend_wasm::SemanticKind.allocation {if !self.old.emission.arena.present || instruction.op!=blot_backend_runtime_ir::OP_call || !self.old.emission.arena.value.isAllocation(instruction.operand.value) {return false,Error.none;}}let imported,error=self.importer.importSemanticSite(g,site);if error!=Error.none || !imported.present {return false,error;}},
 EmitEvent.instruction item=>{return self.admitOperand(g,item.operand,record.owner,roots);},
 EmitEvent.instruction_run run=>{let instructions=self.old.emission.instructionRun(run.instructions);if !instructions.present || instructions.value.len==0 || run.function>=self.old.emission.functions.len {return false,Error.none;}if instructions.value.len as u64>0xffffffffffffffff-record.sequence {return false,Error.none;}let stop=record.sequence+instructions.value.len as u64;if stop-1>last {return false,Error.none;}if position+1<self.old.emission.records.len && self.old.emission.records.items[position+1].sequence<stop {return false,Error.none;}let next=self.metaAt(record.sequence);if next<self.old.metadata.events.len && self.old.metadata.events.items[next].sequence<stop {return false,Error.none;}for item in instructions.value {let accepted,error=self.admitOperand(g,item.operand,record.owner,roots);if error!=Error.none || !accepted {return false,error;}}},
