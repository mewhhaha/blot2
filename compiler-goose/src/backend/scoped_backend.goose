            at,link=>{ let scalar,scalar_error = scalar(self_,module,id,second); if scalar_error != blot_error::Error.none { return Value {..},scalar_error; } let index,index_error = elementIndex(self_,module,id,first,scalar); if index_error != blot_error::Error.none { return Value {..},index_error; } var out = blot_emitter::Emitter<blot_backend_wasm::Module> { code: self_.c , ..}; let address = out.temp(); out.value(first.token); out.value(first.epoch_low); out.value(first.epoch_high); out.value(first.word); out.value(index); out.call(self_.runtime.functions.address); out.set(address); if out.failure != blot_error::Error.none { return Value {..},out.failure; } var tag = ValueTag.ref; if op == blot_check_storage_ops::Op.link { tag = ValueTag.link; } return Value { tag: tag, word: first.word, root: first.root, other_roots: first.other_roots, token: first.token, epoch_low: first.epoch_low, epoch_high: first.epoch_high, index: index, depth: first.depth, .. },blot_error::Error.none; },
