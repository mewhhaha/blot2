type Read is effect = { get: Unit -> U32 }
const call = func callback => return do:
  let bound = func value => return callback value
  break bound 1
const provider = @effect.provider Read.get (func () => return 41)
entry const answer = func () => return do provider:
  let pure = call (func value => return @u32.add value 40)
  use effectful <- call (func value => return do:
    use seed <- Read.get ()
    break @u32.add seed value
  )
  break @u32.add pure effectful
entry const folded = answer ()
