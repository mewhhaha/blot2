fn withPrincipalGraph<C,F>(graph: const PrincipalGraph&,context: C&) -> Error { let cloned,error=blot_check_types::cloneSnapshot(graph.types); if error!=Error.none { return error; } var invocation=PrincipalGraphRead<C> {cloned,context}; let result=blot_check_types::withStore<PrincipalGraphRead<C>,readPrincipalGraph<C,F>>(invocation); blot_check_types::deinit(invocation.snapshot); return result; }
struct PrincipalGraphRead<C> { snapshot: blot_check_types::StoreSnapshot,context: C& }
fn readPrincipalGraph<C,F>(invocation: PrincipalGraphRead<C>&,store: blot_check_types::Store&) -> Error { let error=blot_check_types::restoreStore(invocation.snapshot,store); if error!=Error.none { return error; } let readonly: const blot_check_types::Store&=store; return F(invocation.context,readonly); }
fn finishSuspendedRegion(context: bool&,region: ClosureRegion&) -> Error { return Error.none; }
fn destroySuspendedRegion(session: Session&,snapshot: RegionSnapshot&) -> Error { var ignored=false; return withResumedRegion<bool,finishSuspendedRegion>(session,snapshot,ignored); }
import support.wyhash;
import support.host_layout;
import reuse.semantic_query_table;
enum PrincipalClaim { source_description,open_residual }
struct PrincipalAnswer { found: bool=false,graph: PrincipalGraph?=null }
struct PrincipalQueryKey { source: PrincipalGraphKey,claim_: PrincipalClaim,forced: bool=false }
fn deinit(self: PrincipalQueryKey&) {}
struct PrincipalDependencies { sources: BindingRef[:]=[],plain: blot_reuse_specialization_receipt::PlainFact[:]=[],has_writes: bool=false }
reusable[] var principal_dependency_sources: BindingRef[>..]=[];
reusable[] var principal_dependency_plain: blot_reuse_specialization_receipt::PlainFact[>..]=[];
fn deinit(self: PrincipalDependencies&) { principal_dependency_sources.free_slice(self.sources); principal_dependency_plain.free_slice(self.plain); self.sources=[]; self.plain=[]; }
struct PrincipalGraphResult { graph: PrincipalGraph?=null }
fn deinit(self: PrincipalGraphResult&) { if self.graph { deinit(self.graph); } self.graph .= null; }
struct PrincipalAdapter { claim: PrincipalClaim }
type PrincipalRecord=blot_reuse_semantic_query_table::OwnedRecord<PrincipalQueryKey,PrincipalDependencies,PrincipalGraphResult,PrincipalAdapter>;
type PrincipalTable=blot_reuse_semantic_query_table::Table<PrincipalQueryKey,PrincipalDependencies,PrincipalGraphResult,PrincipalAdapter>;
reusable[] var principal_query_records: PrincipalRecord[>..]=[];
fn fingerprint(self: PrincipalAdapter,key: PrincipalQueryKey) -> u64 { if key.forced { return 0; } var hash=blot_support_wyhash::init(0); hash.value(key.source); return hash.final(); }
fn complete(self: PrincipalAdapter,record: PrincipalRecord) -> bool { let graph: PrincipalGraph?=record.value.graph; if graph==null { return false; } if record.key.claim_!=self.claim||graph.root==0||record.key.source!=graph.key||record.dependencies.sources.len!=graph.dependencies.len||record.dependencies.plain.len!=graph.plain_reads.len { return false; } for left,index in record.dependencies.sources { if left!=graph.dependencies[index] { return false; } } for left,index in record.dependencies.plain { if left!=graph.plain_reads[index] { return false; } } var writes=false; for fact in record.dependencies.plain { writes=writes||!fact.read; } return writes==record.dependencies.has_writes; }
fn bytes(self: PrincipalAdapter,record: PrincipalRecord) -> i64 { if record.value.graph==null { return 0; } return satAdd(satAdd(principalGraphBytes(),record.value.graph.owned_bytes),record.dependencies.sources.len*8+record.dependencies.plain.len*11); }
fn allocateRecords(self: PrincipalAdapter,len: i64) -> PrincipalRecord[:],Error { return principal_query_records.alloc_slice(len),Error.none; }
fn releaseRecords(self: PrincipalAdapter,records: const PrincipalRecord[:]) { principal_query_records.free_slice(records); }
fn recordBytes(self: PrincipalAdapter) -> i64 { return 12+2+60+1+1+16+16+1+8; }
struct PrincipalQueries { table: PrincipalTable,claim: PrincipalClaim,declines: dictionary<PrincipalGraphKey,bool>&,owner: u64=0,units: u64=0,unit_count: i64=0,force_collision: bool=false,lookup_budget: i64=4096,inspected_positions: i64=0,inspected_dependencies: i64=0,lookup_declines: i64=0 }
fn hash(key: PrincipalGraphKey) -> u64 { var value=blot_support_wyhash::init(0); value.value(key); return value.final(); }
