import * as ecs from "engine/ecs"
import { resource, Event } from "engine/ecs"
import * as app from "./app"
import { PendingInput } from "./app"
import { Viewport } from "./platform"
import { Vec2 } from "./spatial"

type Button is data = Primary | Secondary | Other U32
type EventKind is data = KeyPressed U32 | KeyReleased U32 | FocusLost
  | PointerDown Button | PointerUp Button | PointerMoved | Scrolled F32 | Ignored

#[resource]
type Input is data = Input {
  event: EventKind, held: Array U32, pointer: Vec2, delta: Vec2,
  picked: Maybe ecs.EntityId, viewport: Viewport,
}

const button = fn code => case code of
  0 => Primary
  2 => Secondary
  _ => Other code

// Legacy host events carry character codes. Fold ASCII case before tracking
// holds so releasing Shift before a letter cannot leave that letter stuck.
const key = fn code => do:
  if code >= 97:
    if code <= 122:
      return code - 32
  return code

const held = fn keys => fn code => do:
  for pressed in keys:
    if pressed == code:
      return True
  return False

const without = fn keys => fn code => do:
  let remaining = []
  for pressed in keys:
    if pressed != code:
      remaining := [...self, pressed]
  return remaining

const receive = fn () => do:
  use pending <- ecs.get PendingInput
  let PendingInput (Some event) = pending else:
    return ()
  use previous <- ecs.get Input
  let next = previous
  next.event := Ignored
  next.delta := Vec2 { x: 0.0, y: 0.0 }
  next.viewport := event.viewport
  next.picked := case event.pick_valid of
    1 => Some event.picked
    _ => Nothing
  let code = key event.key
  let was_held = held previous.held code
  let (kind, keys) = case event.kind, was_held of
    1, False => (KeyPressed code, [...previous.held, code])
    2, _ => (KeyReleased code, without previous.held code)
    3, _ => (FocusLost, [])
    4, _ => (PointerDown (button event.button), previous.held)
    5, _ => (PointerUp (button event.button), previous.held)
    6, _ => (PointerMoved, previous.held)
    7, _ => (Scrolled event.wheel_delta, previous.held)
    _, _ => (Ignored, previous.held)
  next.event := kind
  next.held := keys
  if event.kind >= 4:
    if event.kind <= 7:
      next.pointer := Vec2 { x: event.pointer_x, y: event.pointer_y }
      next.delta := Vec2 {
        x: next.pointer.x - previous.pointer.x,
        y: next.pointer.y - previous.pointer.y,
      }
  use ecs.set next
  return ()

const plugin = fn builder => do:
  let next = app.insert_resource (Input {
    event: Ignored, held: [], picked: Nothing,
    pointer: Vec2 { x: 0.0, y: 0.0 }, delta: Vec2 { x: 0.0, y: 0.0 },
    viewport: Viewport { width: 1.0, height: 1.0 },
  }) builder
  next := app.add_system Event receive self
  return next
