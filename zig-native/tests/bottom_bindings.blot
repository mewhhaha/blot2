data Maybe a = #Some a | #None
entry const guard_bound = fn (flag:Bool) => do:
  let #Some value = if flag then #Some 42 else #None else:
    let stop = @panic "bound"
  break value
entry const guard_wild = fn (flag:Bool) => do:
  let #Some value = if flag then #Some 42 else #None else:
    let _ = @panic "wildcard"
  break value
entry const guard_tuple = fn (flag:Bool) => do:
  let #Some value = if flag then #Some 42 else #None else:
    let (left,right) = @panic "tuple"
  break value
entry const guard_float = fn (flag:Bool) => do:
  let #Some value = if flag then #Some 42.5 else #None else:
    let (left,right) = @panic "float tuple"
  break value
entry const tuple_panic: Unit -> U32 = fn () => do:
  let (left,right) = @panic "never destructure"
  break 42
entry const tuple_float: Unit -> F32 = fn () => do:
  let (left,right) = @panic "never destructure float"
  break 42.5
entry const partial_value = fn (flag:Bool) => do:
  let value = if flag then 42 else @panic "initializer"
  break value
entry const folded = guard_tuple (@u32.eq 1 1)
entry const observed = fn (host: Unit -> U32 ! {Foreign}) => do:
  use flag <- host ()
  let #Some value = if @u32.eq flag 0 then #None else #Some 42 else:
    host ()
    let (left,right) = @panic "after host"
  break value
