struct SummaryState {providers:Mode[:] = default<Mode[:]>(),functions:Summary[:] = default<Summary[:]>(),parameters:Parameter[:] = default<Parameter[:]>(),depth:u32=0,prepared:bool=false,role_conflicts:i64=0,generation:u64=0,live:bool=false}
var inactive_summaries:SummaryState=SummaryState{..};
reusable var summary_states:SummaryState[>..]=[];
reusable[] var summary_runs:Summary[>..]=[];
reusable[] var parameter_runs:Parameter[>..]=[];
reusable[] var provider_runs:Mode[>..]=[];
struct Summaries {module_ref:const Module?=null,slot:u32=0,generation:u64=0,functions:Summary[:]& =inactive_summaries.functions,parameters:Parameter[:]& =inactive_summaries.parameters,providers:Mode[:]& =inactive_summaries.providers,depth:u32& =inactive_summaries.depth,prepared:bool& =inactive_summaries.prepared,role_conflicts:i64& =inactive_summaries.role_conflicts}
fn valid(self_:const Summaries&)->bool {return self_.slot!=0 && self_.slot<=summary_states.len && summary_states[self_.slot-1].live && summary_states[self_.slot-1].generation==self_.generation;}
fn module(self_:const Summaries&)->const Module& {assert(self_.valid());let module .= self_.module_ref;assert(module);return module;}
fn initSummaries(module:const Module&)->Summaries,Error {var count:i64=0;for function in module.functions {if function.parameters.len>0x7fffffffffffffff-count {return Summaries{..},blot_error::Error.out_of_memory;}count+=function.parameters.len;}let functions=summary_runs.alloc_slice(module.functions.len);let parameters=parameter_runs.alloc_slice(count);for &parameter in parameters {parameter=Parameter{..};}var start:i64=0;for function,index in module.functions {functions[index]=Summary{parameters:parameters[start..start+function.parameters.len],..};start+=function.parameters.len;}let generation=blot_native::fresh_owner_id();let at=summary_states.alloc_index(SummaryState{functions:functions,parameters:parameters,generation:generation,live:true,..});let state .= summary_states[at];return Summaries{module_ref:module,slot:(at+1) as u32,generation:generation,functions:state.functions,parameters:state.parameters,providers:state.providers,depth:state.depth,prepared:state.prepared,role_conflicts:state.role_conflicts,..},blot_error::Error.none;}
fn init(module:const Module&)->Summaries,Error {return initSummaries(module);}
fn setProviders(self_:Summaries&,providers:const Mode[:])->Error {assert(self_.valid());let copy=provider_runs.alloc_slice(providers.len);for value,index in providers {copy[index]=value;}if self_.providers.len!=0 {let previous:Mode[:]=self_.providers;provider_runs.free_slice(previous);}self_.providers=copy;return blot_error::Error.none;}
fn deinit(self_:Summaries&) {if self_.slot==0 {return;}assert(self_.valid());let parameters:Parameter[:]=self_.parameters;let functions:Summary[:]=self_.functions;let providers:Mode[:]=self_.providers;if parameters.len!=0 {parameter_runs.free_slice(parameters);}if functions.len!=0 {summary_runs.free_slice(functions);}if providers.len!=0 {provider_runs.free_slice(providers);}let at=self_.slot-1;summary_states[at].live=false;summary_states.free(at);self_=Summaries{..};}
fn prepare(self_:const Summaries&)->Error {assert(self_.valid());if self_.prepared {return blot_error::Error.none;}if self_.module().arena.present {for id in 0..self_.functions.len {let summary,error=self_.get(id as u32);if error!=blot_error::Error.none {return error;}}}self_.prepared=true;return blot_error::Error.none;}
fn mayReference(function:const Function&,parameter:ValueType,index:i64)->bool {return parameter==blot_backend_runtime_ir::VT_i32 && function.parameterRole(index)!=blot_backend_runtime_ir::ROLE_scalar;}
struct Analysis {mode:AnalysisMode=AnalysisMode.temporaries,locals:Value[:] = default<Value[:]>(),writes:u32[:] = default<u32[:]>(),read_unset:bool[:] = default<bool[:]>(),allocations:Allocations=Allocations{..},uses:Uses=Uses{..},stack:Values=Values{..},controls:Controls=Controls{..},references:References=References{..},fields:FieldMap=FieldMap{..},accesses:Accesses=Accesses{..},region:u32=0,segment:u32=0,at:u32=0,valid:bool=true,invalidates:bool=false,rc_valid:bool=true,rc_writes:RcWrites=RcWrites{..},result_owner:u32=0}
reusable[] var local_runs:Value[>..]=[];
reusable[] var write_runs:u32[>..]=[];
reusable[] var unset_runs:bool[>..]=[];
fn initAnalysis(summaries:const Summaries&,function:const Function&,mode:AnalysisMode)->Analysis,Error {let module .= summaries.module();let local_count=module.locals(function).len;if local_count>0x7fffffffffffffff-function.parameters.len {return Analysis{..},blot_error::Error.out_of_memory;}let count=function.parameters.len+local_count;let locals=local_runs.alloc_slice(count);let writes=write_runs.alloc_slice(count);let unset=unset_runs.alloc_slice(count);for &value in locals {value=Value{..};}for &value,index in writes {value=0;if index<function.parameters.len {value=1;}}for &value in unset {value=false;}for inst in blot_backend_wasm::instructions(module,function) {if inst.op==blot_backend_runtime_ir::OP_local_set || inst.op==blot_backend_runtime_ir::OP_local_tee {if writes[inst.operand]!=0xffffffff {writes[inst.operand]+=1;}}}return Analysis{mode:mode,locals:locals,writes:writes,read_unset:unset,..},blot_error::Error.none;}
fn deinit(self_:Analysis&) {if self_.locals.len!=0 {local_runs.free_slice(self_.locals);}if self_.writes.len!=0 {write_runs.free_slice(self_.writes);}if self_.read_unset.len!=0 {unset_runs.free_slice(self_.read_unset);}self_.allocations.deinit();self_.uses.deinit();self_.stack.deinit();self_.controls.deinit();self_.references.deinit();self_.fields.deinit();self_.accesses.deinit();self_.rc_writes.deinit();self_=Analysis{..};}
fn dominates(self_:const Analysis&,scope:u32)->bool {if scope==0 {return true;}for control in self_.controls.items {if control.identity==scope {return true;}}return false;}
fn floor(self_:const Analysis&)->i64 {if self_.controls.len==0 {return 0;}return self_.controls.items[self_.controls.len-1].height;}
fn pop(self_:Analysis&)->Value {if self_.stack.len>self_.floor() {return self_.stack.pop();}return Value{..};}
fn push(self_:Analysis&,value:Value)->Error {return self_.stack.push(value);}
fn use(self_:Analysis&,value:Value)->Error {if value.owner==0 {return blot_error::Error.none;}let owner .= self_.allocations.items[value.owner-1];owner.last=self_.at;owner.last_region=self_.region;if self_.mode==AnalysisMode.temporaries && (owner.uses==absent || self_.uses.items[owner.uses].at!=self_.at) {let error=self_.uses.push(Use{at:self_.at,previous:owner.uses,..});if error!=blot_error::Error.none {return error;}owner.uses=(self_.uses.len-1) as u32;}return blot_error::Error.none;}
fn escape(self_:Analysis&,value:Value)->Error {let error=self_.use(value);if error!=blot_error::Error.none {return error;}if value.owner!=0 {self_.allocations.items[value.owner-1].escaped=true;}return blot_error::Error.none;}
fn recordResult(self_:Analysis&,value:Value)->Error {let error=self_.use(value);if error!=blot_error::Error.none {return error;}if value.owner!=0 {self_.allocations.items[value.owner-1].returned=true;}if value.owner==0 || value.offset!=0 || (self_.result_owner!=0 && self_.result_owner!=value.owner) {self_.result_owner=absent;}else {self_.result_owner=value.owner;}return blot_error::Error.none;}
fn allocation(self_:Analysis&,bytes:u32)->Error {let error=self_.allocations.push(Allocation{size:bytes,region:self_.region,last_region:self_.region,definition:self_.at,last:self_.at,segment:self_.segment,..});if error!=blot_error::Error.none {return error;}return self_.push(Value{owner:self_.allocations.len as u32,..});}
fn memory(self_:Analysis&,value:Value,offset:u32,bytes:blot_support::Option<u32>,kind:AccessKind,reference:u32)->Error {let error=self_.use(value);if error!=blot_error::Error.none {return error;}if value.owner==0 {return blot_error::Error.none;}if offset>0xffffffff-value.offset {return self_.escape(value);}let start=value.offset+offset;let owner .= self_.allocations.items[value.owner-1];if !bytes.present || start>owner.size || bytes.value>owner.size-start {return self_.escape(value);}owner.required=max(owner.required,start+bytes.value);if !owner.parameter && bytes.value!=0 {let error=self_.accesses.push(Access{offset:start,bytes:bytes.value,at:self_.at,previous:owner.accesses,kind:kind,reference:reference,..});if error!=blot_error::Error.none {return error;}owner.accesses=(self_.accesses.len-1) as u32;}return blot_error::Error.none;}
fn scalarSlot(self_:const Analysis&,address:Value,offset:u32,instructions:const Instruction[:])->bool {if address.owner==0 || offset>0xffffffff-address.offset {return false;}let start=address.offset+offset;if start%4!=0 {return false;}let owner=self_.allocations.items[address.owner-1];if start>owner.size || 4>owner.size-start {return false;}if owner.rc_mask.present {return !blot_runtime_runtime_layout::referenceWord(owner.rc_mask.value,start/4);}if owner.annotations==absent {return false;}return blot_backend_runtime_ir::wordRole(instructions[owner.annotations..owner.annotations+owner.annotation_count],start/4)==blot_backend_runtime_ir::ROLE_scalar;}
fn fieldKey(owner:u32,offset:u32)->u64 {return (owner as u64)<<32 | offset as u64;}
fn scalarRange(self_:const Analysis&,address:Value,offset:u32,bytes:u32,instructions:const Instruction[:])->bool {var word:u32=0;while word<bytes {if word>0xffffffff-offset || !self_.scalarSlot(address,offset+word,instructions) {return false;}if word>0xffffffff-4 {return false;}word+=4;}return true;}
fn scalarStoreAddress(self_:const Analysis&,address:Value,offset:u32,bytes:u32,instructions:const Instruction[:])->bool {if address.offset!=absent && address.offset%4!=0 {return false;}if address.owner==0 {return true;}if address.offset==absent {let mask=self_.allocations.items[address.owner-1].rc_mask;return mask.present && mask.value==0;}return self_.scalarRange(address,offset,bytes,instructions);}
fn field(self_:const Analysis&,address:Value,offset:u32)->blot_support::Option<u32> {if address.owner==0 || offset>0xffffffff-address.offset {return blot_support::none<u32>();}let start=address.offset+offset;let id .= self_.fields.get(fieldKey(address.owner,start));if !id {return blot_support::none<u32>();}let reference=self_.references.items[id];if reference.region!=self_.region || !self_.dominates(reference.scope) {return blot_support::none<u32>();}return blot_support::some<u32>(id);}
fn storeReference(self_:Analysis&,address:Value,offset:u32,value:Value,instructions:const Instruction[:],summaries:const Summaries&)->Error {let error=self_.use(value);if error!=blot_error::Error.none {return error;}if value.owner==0 {return blot_error::Error.none;}if address.owner==0 || self_.allocations.items[address.owner-1].parameter || self_.allocations.items[value.owner-1].parameter || offset>0xffffffff-address.offset {return self_.escape(value);}let start=address.offset+offset;let parent .= self_.allocations.items[address.owner-1];var scalar=false;if parent.rc_mask.present && !blot_runtime_runtime_layout::referenceWord(parent.rc_mask.value,start/4) {scalar=true;}if parent.annotations!=absent && (start%4!=0 || blot_backend_runtime_ir::wordRole(instructions[parent.annotations..parent.annotations+parent.annotation_count],start/4)==blot_backend_runtime_ir::ROLE_scalar) {scalar=true;}let identity=scalar && start%4==0 && address.owner==value.owner && value.offset==0 && blot_backend_runtime_ir::hasSelfIdentityStore(instructions,self_.at);if scalar && !identity {if self_.mode==AnalysisMode.parameters {summaries.role_conflicts+=1;}return self_.escape(value);}let id=self_.references.len as u32;var scope:u32=0;if self_.controls.len!=0 {scope=self_.controls.items[self_.controls.len-1].identity;}let error=self_.references.push(Reference{parent:address.owner,child:value,offset:start,at:self_.at,scope:scope,region:self_.region,previous:parent.references,..});if error!=blot_error::Error.none {return error;}parent.references=id;self_.fields.insert(fieldKey(address.owner,start),id);return blot_error::Error.none;}
fn validateReferences(self_:Analysis&)->Error {if self_.references.len==0 {return blot_error::Error.none;}var remaining:i64=reference_check_limit;for reference,id in self_.references.items {let parent .= self_.allocations.items[reference.parent-1];if parent.escaped {continue;}var next=parent.accesses;while next!=absent {if remaining==0 {parent.escaped=true;break;}remaining-=1;let access=self_.accesses.items[next];next=access.previous;if access.offset as u64>=reference.offset as u64+4 || reference.offset as u64>=access.offset as u64+access.bytes {continue;}if access.kind==AccessKind.write && access.at<=reference.at {continue;}if access.kind==AccessKind.read && access.reference==id && access.bytes==4 && access.offset==reference.offset {continue;}parent.escaped=true;break;}}var pending=Words{..};let error=propagateEscapes(self_,pending);pending.deinit();return error;}
fn propagateEscapes(self_:Analysis&,pending:Words&)->Error {for owner,index in self_.allocations.items {if owner.escaped {let error=pending.push(index as u32);if error!=blot_error::Error.none {return error;}}}var at:i64=0;while at<pending.len {var next=self_.allocations.items[pending.items[at]].references;at+=1;while next!=absent {let reference=self_.references.items[next];let child .= self_.allocations.items[reference.child.owner-1];if !child.escaped {child.escaped=true;let error=pending.push(reference.child.owner-1);if error!=blot_error::Error.none {return error;}}next=reference.previous;}}return blot_error::Error.none;}
fn closeArm(self_:Analysis&)->Error {let control=self_.controls.items[self_.controls.len-1];if control.result {let error=self_.escape(self_.pop());if error!=blot_error::Error.none {return error;}}for value in self_.stack.items[control.height..] {let error=self_.escape(value);if error!=blot_error::Error.none {return error;}}self_.stack.resize(control.height);return blot_error::Error.none;}
fn dead(self_:Analysis&)->Error {let floor=self_.floor();for value in self_.stack.items[floor..] {let error=self_.escape(value);if error!=blot_error::Error.none {return error;}}self_.stack.resize(floor);return blot_error::Error.none;}
fn opaqueCall(self_:Analysis&,parameters:i64,result:ValueType)->Error {for index in 0..parameters {let error=self_.escape(self_.pop());if error!=blot_error::Error.none {return error;}}if result!=blot_backend_runtime_ir::VT_none {let error=self_.push(Value{..});if error!=blot_error::Error.none {return error;}}self_.region+=1;self_.segment+=1;self_.invalidates=true;return blot_error::Error.none;}
recursive fn get(self_:const Summaries&,id:u32)->Summary,Error {assert(self_.valid());let summary .= self_.functions[id];if self_.prepared || summary.state!=SummaryPhase.unseen || self_.depth==summary_depth_limit {return summary,blot_error::Error.none;}let module .= self_.module();if module.fixtureHelper(id) {summary.state=SummaryPhase.done;return summary,blot_error::Error.none;}if module.arena.present {let arena=module.arena.value;if id==arena.recycle || id==arena.reset || id==arena.cycle_collect || id==arena.cycle_safe || arena.isAllocation(id) {summary.state=SummaryPhase.done;return summary,blot_error::Error.none;}}if module.cohorts.present && id==module.cohorts.value.begin {for &parameter in summary.parameters {parameter=Parameter{escapes:false,..};}summary.invalidates=false;summary.state=SummaryPhase.done;return summary,blot_error::Error.none;}summary.state=SummaryPhase.active;self_.depth+=1;let function .= module.functions[id];let catalog=blot_backend_provider_modes::Catalog{entries:blot_backend_provider_modes::Modes{items:self_.providers,len:self_.providers.len,..},..};if blot_backend_provider_modes::readOperation(module,catalog,function).present {for &parameter in summary.parameters {parameter=Parameter{escapes:false,..};}summary.parameters[function.provider_parameter].bytes=blot_runtime_runtime_layout::StateFrame_bytes;summary.invalidates=false;summary.state=SummaryPhase.done;self_.depth-=1;return summary,blot_error::Error.none;}let created,error=initAnalysis(self_,function,AnalysisMode.parameters);if error!=blot_error::Error.none {self_.depth-=1;return Summary{..},error;}var state=created;let error=summarize(self_,module,function,summary,state);state.deinit();self_.depth-=1;if error!=blot_error::Error.none {return Summary{..},error;}summary.state=SummaryPhase.done;return summary,blot_error::Error.none;}
fn summarize(self_:const Summaries&,module:const Module&,function:const Function&,summary:Summary&,state:Analysis&)->Error {for parameter,index in module.parameters(function) {if !mayReference(function,parameter,index) {continue;}let error=state.allocations.push(Allocation{size:0xffffffff,region:0,last_region:0,definition:0,last:0,parameter:true,..});if error!=blot_error::Error.none {return error;}state.locals[index]=Value{owner:state.allocations.len as u32,..};}let error=state.scan(module,function,self_);if error!=blot_error::Error.none {return error;}if !state.valid {return blot_error::Error.none;}var owner:i64=0;for parameter,index in module.parameters(function) {if !mayReference(function,parameter,index) {continue;}let value=state.allocations.items[owner];summary.parameters[index]=Parameter{escapes:value.escaped || value.returned,bytes:value.required,..};owner+=1;}summary.invalidates=state.invalidates;if state.result_owner==0 || state.result_owner==absent || state.invalidates {return blot_error::Error.none;}let result=state.allocations.items[state.result_owner-1];var embedded=false;for reference in state.references.items {if reference.child.owner==state.result_owner {embedded=true;break;}}var owns_fields=result.references!=absent;if result.rc_mask.present {owns_fields=owns_fields || result.rc_mask.value!=0;}if result.annotations!=absent {let roles=blot_backend_wasm::instructions(module,function)[result.annotations..result.annotations+result.annotation_count];let checked=min(result.size/4,(16*blot_backend_runtime_ir::words_per_chunk+1) as u32);for word in 0..checked {if blot_backend_runtime_ir::wordRole(roles,word)!=blot_backend_runtime_ir::ROLE_scalar {owns_fields=true;}}}if !result.parameter && !result.escaped && !embedded && !owns_fields {summary.owned_result_bytes=blot_support::some(result.size);}return blot_error::Error.none;}

