let capacity: u32 = 64;
let bytes: u32 = (capacity + 1) * 4;
struct Walk { storage: u32,top: u32,limit: u32,node: u32 }
fn initialize(module: blot_backend_wasm::Module&,function: u32,source: u32,walk: Walk) -> blot_error::Error { return initializeSized(module,function,source,walk,blot_support::none<u32>()); }
fn initializeSized(module: blot_backend_wasm::Module&,function: u32,source: u32,walk: Walk,size: blot_support::Option<u32>) -> blot_error::Error {
