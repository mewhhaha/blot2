{let s="pub let project: forall [r: Region, s: Region, n: Nat, c: Nat, d: Domain] => Fn[static, Many, (View[r,{x:F32,y:F32,vx:F32,vy:F32},n,d], F32, Builder[s,{x:F32,y:F32},0,c,Append]), exists [e: Domain] => View[s,{x:F32,y:F32},n,e]] ! {read r, write s} requires [Le(n,c)] resources {depth: 2, frame: 256} = fn (source,dt,initial) => do:\n  let built = for i in 0..n carry (b=initial)\n    invariant [Eq(Init(b),i)] do:\n      next (builder.append(b,{x: ((dt + (source[i].vy + source[i].vy)) * source[i].y),y: ((source[i].vx * dt * source[i].x + source[i].vy) * dt)}))\n  return builder.freeze(built)\n";var t,st=i08_header_parse::parse(s);assert(st==0);let p=i08_affine_build::build(t,s);assert(p.status==0 && i08_affine_verify::verify(t,s,p.plan));yes+=1;}
{let s="pub let project: forall [r: Region, s: Region, n: Nat, c: Nat, d: Domain] => Fn[static, Many, (View[r,{x:F32,y:F32,vx:F32,vy:F32},n,d], F32, Builder[s,{x:F32,y:F32},0,c,Append]), exists [e: Domain] => View[s,{x:F32,y:F32},n,e]] ! {read r, write s} requires [Le(n,c)] resources {depth: 2, frame: 256} = fn (source,dt,initial) => do:\n  let built = for i in 0..n carry (b=initial)\n    invariant [Eq(Init(b),i)] do:\n      next (builder.append(b,{x: ((source[i].y + source[i].vx + (dt * source[i].vy)) + dt * source[i].x * source[i].vx + source[i].vy),y: (source[i].vy * dt * (dt + 1.25))}))\n  return builder.freeze(built)\n";var t,st=i08_header_parse::parse(s);assert(st==0);let p=i08_affine_build::build(t,s);assert(p.status==0 && i08_affine_verify::verify(t,s,p.plan));yes+=1;}
