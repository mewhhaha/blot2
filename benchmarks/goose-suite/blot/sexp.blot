// Generate N s-expressions into a byte buffer, parse into a
// compact 8-byte/node AST arena with error checks, then walk 4 times.
import * as rng from "./rng"

const BENCH_N: U32 = 200000 // BENCH_N
const DEPTH: U32 = 4
const PASSES: U32 = 4
const NONE_IDX: U32 = 0x3FFFFFFF

const TAG_SYM: U32 = 0
const TAG_NUM: U32 = 1
const TAG_LIST: U32 = 2

// 8 bytes per node:
//   b = (next << 2) | tag
//   a = (start << 4) | len  for Sym; v for Num; first for List.
type Sexp is data = $Sexp { a: U32, b: U32 }

func push_byte (text: own #[U8]) -> (len: U32) -> (b: U8): (#[U8], U32) =>
  if len < text.length:
    text[len] := b
  else:
    text := self.push b
  return (text, len + 1)

func emit_sym (text: own #[U8]) -> (len: U32) -> (sym_seed: U64): (#[U8], U32) =>
  let r = sym_seed
  let n = 3 + (((r >> 32).to_u32 % 12) * 4 + (r.to_u32 % 12)) % 12
  for _ in 0 .. n:
    r := rng.xs_next self
    let ch = 97 + (((r >> 32).to_u32 % 26) * 22 + (r.to_u32 % 26)) % 26
    let (t1, l1) = push_byte text len ch.to_u8
    text := t1
    len := l1
  return (text, len)

func emit_uint (text: own #[U8]) -> (len: U32) -> (v: U32): (#[U8], U32) =>
  if v == 0:
    return push_byte text len 48
  // Max value is 99999 (5 digits) — format in scalar locals (zero allocation).
  let d0: U32 = 0
  let d1: U32 = 0
  let d2: U32 = 0
  let d3: U32 = 0
  let d4: U32 = 0
  let n: U32 = 0
  let x = v
  for ever:
    if x == 0:
      break
    let dig = 48 + (x % 10)
    if n == 0:
      d0 := dig
    else:
      if n == 1:
        d1 := dig
      else:
        if n == 2:
          d2 := dig
        else:
          if n == 3:
            d3 := dig
          else:
            d4 := dig
    n := self + 1
    x := self / 10
  for ever:
    if n == 0:
      break
    n := self - 1
    let ch = if n == 0 then d0 else if n == 1 then d1 else if n == 2 then d2 else if n == 3 then d3 else d4
    let (t1, l1) = push_byte text len ch.to_u8
    text := t1
    len := l1
  return (text, len)

func build_text (): (#[U8], U32) =>
  // Pre-size for depth-4 forms, with growth if the estimate is low.
  let text: #[U8] = @array.fill (BENCH_N * 496) (U32.to_u8 0)
  let len: U32 = 0
  let seed: U64 = 12345

  let st_depth = @array.fill 16 0
  let st_rem = @array.fill 16 0
  let st_active = @array.fill 16 0

  for _ in 0 .. BENCH_N:
    st_depth[0] := DEPTH
    st_rem[0] := 0
    st_active[0] := 0
    let sp: U32 = 1
    for ever:
      if sp == 0:
        break
      let top = sp - 1
      if st_active[top] == 0:
        seed := rng.xs_next self
        let d = st_depth[top]
        if d == 0 or (seed & 3) == 0:
          if ((seed >> 8) & 1) == 0:
            let (t1, l1) = emit_sym text len seed
            text := t1
            len := l1
          else:
            let (t1, l1) = emit_uint text len (rng.xs_mod (seed >> 16) 100000)
            text := t1
            len := l1
          let (t2, l2) = push_byte text len 32
          text := t2
          len := l2
          sp := self - 1
        else:
          let (t1, l1) = push_byte text len 40
          text := t1
          len := l1
          st_rem[top] := 2 + ((seed >> 24) & 3).to_u32
          st_active[top] := 1
      else:
        let rem = st_rem[top]
        if rem > 0:
          st_rem[top] := rem - 1
          st_depth[sp] := st_depth[top] - 1
          st_active[sp] := 0
          sp := self + 1
        else:
          let (t1, l1) = push_byte text len 41
          let (t2, l2) = push_byte t1 l1 32
          text := t2
          len := l2
          sp := self - 1

  return (text, len)

func push_node (pool: own #[Sexp]) -> (plen: U32) -> (nd: Sexp): (#[Sexp], U32) =>
  if plen < pool.length:
    pool[plen] := nd
    return (pool, plen + 1)
  pool := self.push nd
  return (pool, plen + 1)

func walk_root (pool: #[Sexp]) -> (buf: #[U8]) -> (root: U32) -> (p: U32) -> (stack: own #[U32]): (U32, #[U32]) =>
  stack[0] := root
  let sp: U32 = 1
  let acc: U32 = 0
  for ever:
    if sp == 0:
      break
    sp := self - 1
    let cur = stack[sp]
    for ever:
      if cur == NONE_IDX:
        break
      let $Sexp { a, b } = pool[cur]
      let tag = b & 3
      if tag == TAG_SYM:
        let start = a >> 4
        let slen = a & 15
        acc := self + slen + buf[start].to_u32 + p
      else:
        if tag == TAG_NUM:
          acc := self + (a ^ p)
        else:
          acc := self + 1
          if a != NONE_IDX:
            stack[sp] := a
            sp := self + 1
      cur := b >> 2
  return (acc, stack)

io bench (): #[U32] =>
  let (text, text_len) = build_text ()
  // ~76 nodes per depth-4 form; pre-size to avoid doubling spike.
  let pool = @array.fill (BENCH_N * 78) ($Sexp { a: 0, b: 0 })
  let plen: U32 = 0
  let roots = @array.fill BENCH_N 0
  let rlen: U32 = 0
  let st_chain = @array.fill 16 NONE_IDX
  let sp: U32 = 0
  let pos: U32 = 0
  let err_len: U32 = 0

  for ever:
    for ever:
      if pos >= text_len:
        break
      if text[pos] != 32:
        break
      pos := self + 1
    if pos >= text_len:
      if sp > 0:
        err_len := 8
      break
    let c = text[pos]
    if c == 41:
      if sp == 0:
        err_len := 8
        break
      pos := self + 1
      let first = st_chain[sp]
      sp := self - 1
      let prev = if sp == 0 then NONE_IDX else st_chain[sp]
      let idx = plen
      let (p1, pl1) = push_node pool plen ($Sexp { a: first, b: (prev << 2) | TAG_LIST })
      pool := p1
      plen := pl1
      if sp == 0:
        if rlen < roots.length:
          roots[rlen] := idx
        else:
          roots := self.push idx
        rlen := self + 1
      else:
        st_chain[sp] := idx
    else:
      if c == 40:
        pos := self + 1
        sp := self + 1
        st_chain[sp] := NONE_IDX
      else:
        let start = pos
        let prev = if sp == 0 then NONE_IDX else st_chain[sp]
        let idx = plen
        if c >= 48 and c <= 57:
          let v: U32 = 0
          for ever:
            if pos >= text_len:
              break
            let ch = text[pos]
            if ch >= 48 and ch <= 57:
              v := self * 10 + (ch - 48).to_u32
              pos := self + 1
            else:
              break
          let (p1, pl1) = push_node pool plen ($Sexp { a: v, b: (prev << 2) | TAG_NUM })
          pool := p1
          plen := pl1
        else:
          for ever:
            if pos >= text_len:
              break
            let ch = text[pos]
            if ch != 32 and ch != 40 and ch != 41:
              pos := self + 1
            else:
              break
          let slen = pos - start
          let (p1, pl1) = push_node pool plen ($Sexp { a: (start << 4) | slen, b: (prev << 2) | TAG_SYM })
          pool := p1
          plen := pl1
        if sp == 0:
          if rlen < roots.length:
            roots[rlen] := idx
          else:
            roots := self.push idx
          rlen := self + 1
        else:
          st_chain[sp] := idx

  let total: I64 = 0
  let walk_stack = @array.fill 16 0
  for p in 0 .. PASSES:
    for ri in 0 .. rlen:
      let (wsum, ws1) = walk_root pool text roots[ri] p walk_stack
      walk_stack := ws1
      total := self + wsum.to_i64

  let out: #[U32] = #[]
  out := rng.emit_u32 self text_len
  out := rng.emit_u32 self plen
  out := rng.emit_u32 self rlen
  out := rng.emit_u32 self err_len
  out := rng.emit_i64 self total
  return out
