type Reader=blot_eval_worker_packet::Reader;
struct Member { index: i64,key: Key }
struct Edge { from: u32,to: u32 }
struct Component { members: Member[:],edges: Edge[:],budget: i64=0 }
reusable[] var members: Member[>..]=[];
reusable[] var edges: Edge[>..]=[];
fn create(member_values: const Member[:],edge_values: const Edge[:]) -> Component { let a=members.alloc_slice(member_values.len); let b=edges.alloc_slice(edge_values.len); for value,index in member_values { a[index]=value; } for value,index in edge_values { b[index]=value; } return Component {a,b}; }
fn deinit(self: Component&) { members.free_slice(self.members); edges.free_slice(self.edges); self.members=[]; self.edges=[]; }
struct Result { snapshot: blot_support::Option<blot_evidence_packet::OwnedSnapshot>=blot_support::none<blot_evidence_packet::OwnedSnapshot>(),keys: Key[:]=[],roots: u32[:]=[],sources: blot_check_core::BindingRef[:]=[],recursive_members: i64=0,restarts: i64=0,transitions: i64=0,counters: blot_work_counters::Counters=blot_work_counters::Counters {},job_nanos: u64=0 }
reusable[] var result_keys: Key[>..]=[];
reusable[] var result_roots: u32[>..]=[];
reusable[] var result_sources: blot_check_core::BindingRef[>..]=[];
fn deinit(self: Result&) { if self.snapshot.present { self.snapshot.value.deinit(); } self.snapshot=blot_support::none<blot_evidence_packet::OwnedSnapshot>(); result_keys.free_slice(self.keys); result_roots.free_slice(self.roots); result_sources.free_slice(self.sources); self.keys=[]; self.roots=[]; self.sources=[]; }
struct Lexical { original: u32,input: blot_eval_lexical_capture_inputs::Inputs }
reusable[] var lexical_inputs: Lexical[>..]=[];
fn writeInput(writer: Writer&,input: blot_eval_lexical_capture_inputs::Inputs) { blot_eval_worker_packet::put(writer,input.unit); blot_eval_worker_packet::put(writer,input.identity); blot_eval_worker_packet::put(writer,input.anonymous); blot_eval_worker_packet::put(writer,input.applied); blot_eval_worker_packet::put(writer,input.source_type); blot_eval_worker_packet::put(writer,input.existing); blot_eval_worker_packet::put(writer,input.parameters); blot_eval_worker_packet::count(writer,input.mappings.len); for mapping in input.mappings { blot_eval_worker_packet::put(writer,mapping); } blot_eval_worker_packet::count(writer,input.rows.len); for row in input.rows { blot_eval_worker_packet::put(writer,row); } blot_eval_worker_packet::count(writer,input.slots.len); for slot in input.slots { blot_eval_worker_packet::put(writer,slot); } blot_eval_worker_packet::count(writer,input.words.len); for word in input.words { blot_eval_worker_packet::put(writer,word); } }
