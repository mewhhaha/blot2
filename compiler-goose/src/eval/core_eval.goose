fn allConstraintsSolved(self: const ClosureRegion&) -> bool { for c in self.scratch.constraints { if !c.solved { return false; } } return true; }
fn closeRetainedFunctionRows(self: ClosureRegion&,root: u32,parameters: i64) -> bool,Error { if parameters==0 { return false,Error.none; } if parameters>self.session.options.max_type_depth { return false,Error.type_limit; } let resolved,error=self.solver.resolve(root,0); if error!=Error.none { return false,error; } let arrow=self.solver.node(resolved); if arrow.tag!=TypeTag.function { return false,Error.none; } let changed,e=closeRetainedFunctionRows(self,arrow.b,parameters-1); if e!=Error.none { return false,e; } let input,e2=project(self,arrow.a); if e2!=Error.none { return false,e2; } if input==0 { return changed,Error.none; } let output,e3=project(self,arrow.b); if e3!=Error.none { return false,e3; } if output==0 { return changed,Error.none; } let row,e4=self.solver.resolveEffects(arrow.c,0); if e4!=Error.none { return false,e4; } if self.solver.row(row).tail!=blot_check_effects::Tail.variable { return changed,Error.none; } let closed,e5=self.solver.effects.row(self.solver.rowLabels(row),blot_check_effects::Tail.closed); if e5!=Error.none { return false,e5; } let joined=self.solver.unifyEffects(row,closed); return joined==Error.none,joined; }
fn closeRetainedRows(self: ClosureRegion&) -> Error { if !allConstraintsSolved(self) { return Error.none; } var changed=true; while changed { changed=false; for source in self.scratch.sources { if source.value==0||valueInfo(self.session,source.value).kind!=ValueKind.closure { continue; } let metadata=closureInfo(self.session,source.value); var parameters=1; if metadata.origin==blot_eval_eval_values::ClosureOrigin.named { let body=self.session.units[source.owner].body(metadata.identity); if !body||metadata.applied>body.parameters.len { return Error.unresolved_type; } parameters=body.parameters.len-metadata.applied; } else if metadata.origin==blot_eval_eval_values::ClosureOrigin.anonymous { let module=self.session.units[source.owner]; var body=module.closures[metadata.identity].body; while module.node(body).tag==CoreTag.closure&&parameters<self.session.options.max_type_depth { body=module.closure(body).body; parameters++; } } let closed,error=closeRetainedFunctionRows(self,source.root,parameters); if error!=Error.none { return error; } changed=closed||changed; } } return Error.none; }
fn headerVariablesOnly(self: ClosureRegion&,ty: u32,header: const u32[:]) -> bool,Error { if ty==0 { return true,Error.none; } let variables,error=self.solver.freeVariables(ty); if error!=Error.none { return false,error; } for variable in variables { var found=false; for candidate in header { if variable==candidate { found=true; break; } } if !found { return false,Error.none; } } return true,Error.none; }
fn genericEntryInterface(self: ClosureRegion&,scope: u32) -> bool,Error { let resolved,error=self.solver.resolve(self.scratch.sources[scope].root,0); if error!=Error.none { return false,error; } let arrow=self.solver.node(resolved); if arrow.tag!=TypeTag.function { return false,Error.none; } let input,e=project(self,arrow.a); if e!=Error.none { return false,e; } let output,e2=project(self,arrow.b); if e2!=Error.none { return false,e2; } if input!=0&&output!=0 { return false,Error.none; } for source,index in self.scratch.sources { if index==scope||source.value==0 { continue; } let actual,e3=project(self,source.root); if e3!=Error.none { return false,e3; } if actual==0 { return false,Error.none; } } let root,e3=self.solver.product([arrow.a,arrow.b]); if e3!=Error.none { return false,e3; } let header,e4=self.solver.freeVariables(root); if e4!=Error.none { return false,e4; } for c in self.scratch.constraints { if c.solved { continue; } if c.scope!=scope||c.explicit||c.deferred_member { return false,Error.none; } match c.kind { binary,field,result_dispatch,physical_field,receiver,update,type_compare,collection,record_merge=>{},_=>{ return false,Error.none; }, } for ty in [c.left,c.right,c.result,c.signature] { let valid,e5=headerVariablesOnly(self,ty,header); if e5!=Error.none||!valid { return false,e5; } } } return true,Error.none; }
fn inferEntry(self: ClosureRegion&,value: ValueId) -> blot_support::Option<ValueId>,Error { self.include_callables=true; let scope,error=addValue(self,value,0); if error!=Error.none { return blot_support::none<ValueId>(),error; } let partial=solveMode(self,true); if partial!=Error.none { return blot_support::none<ValueId>(),partial; } let closed=closeRetainedRows(self); if closed!=Error.none { return blot_support::none<ValueId>(),closed; } let generic,e=genericEntryInterface(self,scope); if e!=Error.none||generic { return blot_support::none<ValueId>(),e; } let solved=solve(self); if solved!=Error.none { return blot_support::none<ValueId>(),solved; } if !allConstraintsSolved(self) { return blot_support::none<ValueId>(),Error.unresolved_type; } let rows=closeRetainedRows(self); if rows!=Error.none { return blot_support::none<ValueId>(),rows; } let selected,e2=freeze(self,scope); if e2!=Error.none { return blot_support::none<ValueId>(),e2; } let published=publishValidatedCalls(self); return blot_support::some(selected),published; }
fn infer(self: ClosureRegion&,value: ValueId) -> ValueId,Error { self.include_callables=true; let scope,error=addValue(self,value,0); if error!=Error.none { return 0,error; } let solved=solve(self); if solved!=Error.none { return 0,solved; } if !allConstraintsSolved(self) { return 0,Error.unresolved_type; } let rows=closeRetainedRows(self); if rows!=Error.none { return 0,rows; } let selected,e=freeze(self,scope); if e!=Error.none { return 0,e; } let published=publishValidatedCalls(self); return selected,published; }
