// Pointer-linked binary tree in a flat U32-indexed node pool (12 bytes/node).
// Children are pushed before their parent (post-order), matching tree.goose.
import * as rng from "./rng"

const BENCH_N: U32 = 20 // BENCH_N
const PASSES: U32 = 8
const NONE: U32 = 0xFFFFFFFF

type TNode is data = $TNode { v: U32, l: U32, r: U32 }

func build_tree (max_depth: U32) -> (init_seed: U64): #[TNode] =>
  let pool: #[TNode] = #[]
  let cap: U32 = 32
  let st_depth = @array.fill cap 0
  let st_seed = @array.fill cap (U32.to_u64 0)
  let st_stage = @array.fill cap 0
  let st_left = @array.fill cap 0

  st_depth[0] := max_depth
  st_seed[0] := init_seed
  st_stage[0] := 0
  let sp: U32 = 1
  let last_idx: U32 = 0

  for ever:
    if sp == 0:
      break
    let top = sp - 1
    let d = st_depth[top]
    let seed = st_seed[top]
    let stage = st_stage[top]
    if d == 0:
      let v1000 = (((seed >> 32).to_u32 % 1000) * 296 + (seed.to_u32 % 1000)) % 1000
      pool := self.push ($TNode { v: v1000, l: NONE, r: NONE })
      last_idx := pool.length - 1
      sp := self - 1
    else:
      if stage == 0:
        st_stage[top] := 1
        let child_seed = rng.xs_next seed
        st_depth[sp] := d - 1
        st_seed[sp] := child_seed
        st_stage[sp] := 0
        sp := self + 1
      else:
        if stage == 1:
          st_left[top] := last_idx
          st_stage[top] := 2
          let child_seed = rng.xs_next (seed + 1)
          st_depth[sp] := d - 1
          st_seed[sp] := child_seed
          st_stage[sp] := 0
          sp := self + 1
        else:
          let l = st_left[top]
          let r = last_idx
          let v1000 = (((seed >> 32).to_u32 % 1000) * 296 + (seed.to_u32 % 1000)) % 1000
          pool := self.push ($TNode { v: v1000, l, r })
          last_idx := pool.length - 1
          sp := self - 1
  return pool

func sum_pass (pool: #[TNode]) -> (root: U32) -> (p: U32): I64 =>
  let stack = @array.fill 32 0
  stack[0] := root
  let sp: U32 = 1
  let total: I64 = 0
  for ever:
    if sp == 0:
      break
    sp := self - 1
    let nd = pool[stack[sp]]
    total := self + (nd.v ^ p).to_i64
    if nd.r != NONE:
      stack[sp] := nd.r
      sp := self + 1
    if nd.l != NONE:
      stack[sp] := nd.l
      sp := self + 1
  return total

io bench (): #[U32] =>
  let pool = build_tree BENCH_N 12345
  let root = pool.length - 1
  let total: I64 = 0
  for p in 0 .. PASSES:
    total := self + sum_pass pool root p

  let out: #[U32] = #[]
  out := rng.emit_u32 self pool.length
  out := rng.emit_i64 self total
  return out
