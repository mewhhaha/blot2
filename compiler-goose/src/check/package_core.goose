fn schemeFor(self_:Walker&,value:blot_check_types::Scheme,body:u32)->Error {let error=self_.step(0);if error!=blot_error::Error.none {return error;}for variable in self_.module.types.list(value.row_variables) {let error=self_.step(0);if error!=blot_error::Error.none {return error;}let owned,error=self_.scopes.ownsRow(variable);if error!=blot_error::Error.none {return error;}if !owned {return blot_error::Error.invalid_artifact;}}var assumed=false;for owner in self_.scopes.schemes[..self_.scopes.scheme_count] {let error=self_.step(0);if error!=blot_error::Error.none {return error;}if owner==value {assumed=true;}}if body!=0 && self_.module.binding(body).scheme!=value {return blot_error::Error.invalid_artifact;}if assumed {let goals,error=self_.scopes.schemeGoals(value);if error!=blot_error::Error.none {return error;}let error=blot_check_scheme_predicates::scope(self_.scopes,goals);if error!=blot_error::Error.none {return error;}}else {let error=blot_check_dictionary_contracts::requirements(self_.module,value.obligations,self_.scopes,body);if error!=blot_error::Error.none {return error;}}if value.variables.len!=0 {let owner=self_.module.types.node(value.root);if owner.tag==blot_check_types::Tag.forall {if value.variables.len!=owner.c || self_.module.types.list(value.variables)!=self_.module.types.list(List{start:owner.b,len:owner.c, ..}) {return blot_error::Error.invalid_artifact;}}else {for variable in self_.module.types.list(value.variables) {let error=self_.step(0);if error!=blot_error::Error.none {return error;}let owned,error=self_.scopes.ownsVariable(variable);if error!=blot_error::Error.none {return error;}if self_.module.types.node(variable).tag!=blot_check_types::Tag.variable || !owned {return blot_error::Error.invalid_artifact;}}}}for row in self_.module.types.list(value.closed_rows) {let owned,error=self_.closedRowOwned(row);if error!=blot_error::Error.none {return error;}if !owned {return blot_error::Error.invalid_artifact;}}let binders=self_.module.types.li