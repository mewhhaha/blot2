//! Multi-core `#kernel` handle metadata, wire helpers, and typed in-language
//! orchestration (`run`, `prepare`, `run_prepared`, `submit`, `poll`, `await_job`)
//! over [`Runtime`](`std/runtime/Runtime`).

import * as flat from "./flat"
import * as runtime from "./runtime"

type Hash64 is data = $Hash64 { lo: U32, hi: U32 }

const zero_hash = $Hash64 { lo: 0, hi: 0 }

func same_hash (a: Hash64) -> (b: Hash64) => a.lo == b.lo and a.hi == b.hi

func id k => return flat.kernel_id k

func binding_hash k =>
  let (lo, hi) = flat.kernel_binding_hash k
  return $Hash64 { lo, hi }

func ctx_hash k =>
  let (lo, hi) = flat.kernel_ctx_hash k
  return $Hash64 { lo, hi }

func io_hash k =>
  let (lo, hi) = flat.kernel_io_hash k
  return $Hash64 { lo, hi }

func encode value => return flat.encode value
func decode words => return flat.decode words
func schema_hash value => return flat.schema_hash value

// Opaque handle for a prepared kernel context uploaded to the host pool.
type Prepared [ctx, item, out] is opaque = {
  kernel_id: U32,
  slot: U32,
  hash_lo: U32,
  hash_hi: U32,
}

// Opaque handle for an in-flight non-blocking kernel batch job.
type KernelJob out is opaque = { job_id: U32 }

// Typed failure modes returned by host kernel execution.
type KernelErr is data =
  | $Oom
  | $Trap Text
  | $Timeout
  | $BudgetExceeded
  | $InvalidHandle
  | $DecodeError
  | $HostError Text

private func decode_kernel_err (code: U32) -> (msg: own Text): KernelErr =>
  if code == runtime.err_oom:
    return $Oom
  if code == runtime.err_trap:
    return $Trap msg
  if code == runtime.err_timeout:
    return $Timeout
  if code == runtime.err_budget:
    return $BudgetExceeded
  if code == runtime.err_invalid_handle:
    return $InvalidHandle
  return $HostError msg

// Run a stateless `#kernel` synchronously/suspending on the host `KernelPool`.
func run (k: Kernel [Unit, item, out]) -> (items: #[item]): Result [#[out], KernelErr] ! { runtime.Runtime } =>
  let kid = flat.kernel_id k
  let (hlo, hhi) = flat.kernel_binding_hash k
  let payload = flat.encode_batch items
  let req = runtime.pack_request runtime.op_kernel_run #[kid, hlo, hhi, items.length] payload
  use resp <- runtime.Runtime.call req
  if not (runtime.valid_response resp 2):
    return $Err $DecodeError
  let status = resp[1]
  if status != runtime.status_ok:
    return $Err (decode_kernel_err status (runtime.tail_words resp 2))
  let body = runtime.tail_words resp 2
  let $Some decoded = flat.decode_batch body else:
    return $Err $DecodeError
  return $Ok decoded

// Upload and prepare context for a prepared-context `#kernel`.
func prepare (k: Kernel [ctx, item, out]) -> (wire_ctx: ctx): Result [Prepared [ctx, item, out], KernelErr] ! { runtime.Runtime } =>
  let kid = flat.kernel_id k
  let (hlo, hhi) = flat.kernel_binding_hash k
  let payload = flat.encode_wire wire_ctx
  let req = runtime.pack_request runtime.op_kernel_prepare #[kid, hlo, hhi] payload
  use resp <- runtime.Runtime.call req
  if not (runtime.valid_response resp 2):
    return $Err $DecodeError
  let status = resp[1]
  if status != runtime.status_ok:
    return $Err (decode_kernel_err status (runtime.tail_words resp 2))
  if resp.length < 3:
    return $Err $DecodeError
  return $Ok ($Prepared { kernel_id: kid, slot: resp[2], hash_lo: hlo, hash_hi: hhi })

// Run a batch against a [`Prepared`] kernel context.
func run_prepared (p: Prepared [ctx, item, out]) -> (items: #[item]): Result [#[out], KernelErr] ! { runtime.Runtime } =>
  let $Prepared { kernel_id, slot, hash_lo, hash_hi } = p
  let payload = flat.encode_batch items
  let req = runtime.pack_request runtime.op_kernel_run_prepared #[kernel_id, slot, hash_lo, hash_hi, items.length] payload
  use resp <- runtime.Runtime.call req
  if not (runtime.valid_response resp 2):
    return $Err $DecodeError
  let status = resp[1]
  if status != runtime.status_ok:
    return $Err (decode_kernel_err status (runtime.tail_words resp 2))
  let body = runtime.tail_words resp 2
  let $Some decoded = flat.decode_batch body else:
    return $Err $DecodeError
  return $Ok decoded

// Release a [`Prepared`] kernel context on the host pool (consumes handle).
func clear (p: own Prepared [ctx, item, out]): Unit ! { runtime.Runtime } =>
  let $Prepared { kernel_id, slot, hash_lo: _, hash_hi: _ } = p
  let req = runtime.pack_request runtime.op_kernel_clear #[kernel_id, slot] #[]
  use _ <- runtime.Runtime.call req
  return ()

// Submit a stateless `#kernel` batch without blocking; collect with [`poll`] or [`await_job`].
func submit (k: Kernel [Unit, item, out]) -> (items: #[item]): Result [KernelJob out, KernelErr] ! { runtime.Runtime } =>
  let kid = flat.kernel_id k
  let (hlo, hhi) = flat.kernel_binding_hash k
  let payload = flat.encode_batch items
  let req = runtime.pack_request runtime.op_kernel_submit #[kid, hlo, hhi, items.length] payload
  use resp <- runtime.Runtime.call req
  if not (runtime.valid_response resp 2):
    return $Err $DecodeError
  let status = resp[1]
  if status != runtime.status_ok:
    return $Err (decode_kernel_err status (runtime.tail_words resp 2))
  if resp.length < 3:
    return $Err $DecodeError
  return $Ok ($KernelJob { job_id: resp[2] })

// Submit a prepared-context `#kernel` batch without blocking.
func submit_prepared (p: Prepared [ctx, item, out]) -> (items: #[item]): Result [KernelJob out, KernelErr] ! { runtime.Runtime } =>
  let $Prepared { kernel_id, slot, hash_lo, hash_hi } = p
  let payload = flat.encode_batch items
  let req = runtime.pack_request runtime.op_kernel_submit_prepared #[kernel_id, slot, hash_lo, hash_hi, items.length] payload
  use resp <- runtime.Runtime.call req
  if not (runtime.valid_response resp 2):
    return $Err $DecodeError
  let status = resp[1]
  if status != runtime.status_ok:
    return $Err (decode_kernel_err status (runtime.tail_words resp 2))
  if resp.length < 3:
    return $Err $DecodeError
  return $Ok ($KernelJob { job_id: resp[2] })

// Non-blocking poll for a submitted [`KernelJob`].
func poll (job: KernelJob out): Maybe (Result [#[out], KernelErr]) ! { runtime.Runtime } =>
  let $KernelJob { job_id } = job
  let req = runtime.pack_request runtime.op_kernel_poll #[job_id] #[]
  use resp <- runtime.Runtime.call req
  if not (runtime.valid_response resp 3):
    return $Some ($Err $DecodeError)
  if resp[1] != runtime.status_ok:
    return $Some ($Err (decode_kernel_err resp[1] (runtime.tail_words resp 2)))
  let state = resp[2]
  if state == 0:
    return $Nothing
  if state == 1:
    let body = runtime.tail_words resp 3
    let $Some decoded = flat.decode_batch body else:
      return $Some ($Err $DecodeError)
    return $Some ($Ok decoded)
  if resp.length < 4:
    return $Some ($Err $DecodeError)
  return $Some ($Err (decode_kernel_err resp[3] (runtime.tail_words resp 4)))

// Wait for a submitted [`KernelJob`] to finish (consumes the job handle).
func await_job (job: own KernelJob out): Result [#[out], KernelErr] ! { runtime.Runtime } =>
  let $KernelJob { job_id } = job
  let req = runtime.pack_request runtime.op_kernel_await #[job_id] #[]
  use resp <- runtime.Runtime.call req
  if not (runtime.valid_response resp 2):
    return $Err $DecodeError
  let status = resp[1]
  if status != runtime.status_ok:
    return $Err (decode_kernel_err status (runtime.tail_words resp 2))
  let body = runtime.tail_words resp 2
  let $Some decoded = flat.decode_batch body else:
    return $Err $DecodeError
  return $Ok decoded

// Lossless 32-bit <-> two 16-bit exact-integer F32 lanes (zero precision loss
// above 16,777,215).
func pack_u32 (value: U32) => (U32.to_f32 (value & 65535), U32.to_f32 (value >> 16))

func unpack_u16 (lane: F32): Maybe U32 =>
  if not (is_finite lane) or lane < 0.0 or lane > 65535.0:
    return $Nothing
  let v = F32.to_u32 lane
  if U32.to_f32 v != lane:
    return $Nothing
  return $Some v

func unpack_u32 (lo_lane: F32) -> (hi_lane: F32): Maybe U32 =>
  let $Some lo = unpack_u16 lo_lane else:
    return $Nothing
  let $Some hi = unpack_u16 hi_lane else:
    return $Nothing
  return $Some (lo | (hi << 16))

// Lossless 64-bit hash <-> four 16-bit exact-integer F32 lanes.
func pack_hash (h: Hash64) =>
  (U32.to_f32 (h.lo & 65535), U32.to_f32 (h.lo >> 16), U32.to_f32 (h.hi & 65535), U32.to_f32 (h.hi >> 16))

func unpack_hash (w0: F32) -> (w1: F32) -> (w2: F32) -> (w3: F32): Maybe Hash64 =>
  let $Some lo = unpack_u32 w0 w1 else:
    return $Nothing
  let $Some hi = unpack_u32 w2 w3 else:
    return $Nothing
  return $Some ($Hash64 { lo, hi })

// Single-byte step of standard 64-bit FNV-1a:
//   H = (H ^ byte) * 0x00000100_000001b3  (mod 2^64)
// Computed using 16-bit products so intermediate values stay < 2^25.
func fnv1a64_byte (lo: U32) -> (hi: U32) -> (byte: U32) =>
  let xlo = lo ^ (byte & 255)
  let p0 = (xlo & 65535) * 435
  let p1 = (xlo >> 16) * 435 + (p0 >> 16)
  let new_lo = (p0 & 65535) | ((p1 & 65535) << 16)
  let carry = p1 >> 16
  let new_hi = hi * 435 + carry + (xlo << 8)
  return (new_lo, new_hi)

func fnv1a64_word (lo: U32) -> (hi: U32) -> (word: U32) =>
  let (lo0, hi0) = fnv1a64_byte lo hi (word & 255)
  let (lo1, hi1) = fnv1a64_byte lo0 hi0 ((word >> 8) & 255)
  let (lo2, hi2) = fnv1a64_byte lo1 hi1 ((word >> 16) & 255)
  return fnv1a64_byte lo2 hi2 ((word >> 24) & 255)

func f32_bits (value: F32): U32 =>
  let encoded: #[U32] = flat.encode value
  return encoded[0]

// Standard 64-bit FNV-1a over little-endian bytes of a u32 word slice.
func fnv1a64_words (words: &[U32]): Hash64 =>
  let lo: U32 = 0x84222325
  let hi: U32 = 0xcbf29ce4
  for i in 0 .. words.length:
    let (nlo, nhi) = fnv1a64_word lo hi words[i]
    lo := nlo
    hi := nhi
  return $Hash64 { lo, hi }

// Standard 64-bit FNV-1a over little-endian IEEE-754 bytes of an F32 slice.
// Matches Rust `fnv1a64_words` over `f.to_bits()` bit-for-bit.
func fnv1a64_f32s (values: &[F32]): Hash64 =>
  let lo: U32 = 0x84222325
  let hi: U32 = 0xcbf29ce4
  for i in 0 .. values.length:
    let (nlo, nhi) = fnv1a64_word lo hi (f32_bits values[i])
    lo := nlo
    hi := nhi
  return $Hash64 { lo, hi }
