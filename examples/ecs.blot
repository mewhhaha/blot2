// Executable source ECS with typed component columns and scoped state effects.
// Entity IDs are column indices; Nothing means that component is absent.
// Worlds stay inside the guest. This example exports scalar queries.

import * as array from "std/array"

type Position is data = $Position { x: F32, y: F32 }
type Velocity is data = $Velocity { x: F32, y: F32 }
type Ghost is data = $Ghost { remaining: F32 }
type Time is data = $Time { seconds: F32 }
type Column component is data = $Column #[Maybe component]
type World is data = $World {
  time: Time,
  positions: Column Position,
  velocities: Column Velocity,
  ghosts: Column Ghost,
}
type State a is effect = {
  get: Unit -> a
  set: a -> Unit
}

func Column.copy (value: Column component): Column component =>
  let $Column items = value
  return $Column items.copy

func World.copy (world: World): World =>
  let $World { time, positions, velocities, ghosts } = world
  return $World {
    time,
    positions: positions.copy,
    velocities: velocities.copy,
    ghosts: ghosts.copy,
  }

func run_scoped (world: own World) -> action =>
  let $World { time, positions, velocities, ghosts } = world
  let t = time
  let pos = positions
  let vel = velocities
  let gh = ghosts
  let result = $Nothing
  with State Time = { get: func () => t, set: func v => t := v }:
    with State (Column Position) = { get: func () => pos.copy, set: func v => pos := v.copy }:
      with State (Column Velocity) = { get: func () => vel.copy, set: func v => vel := v.copy }:
        with State (Column Ghost) = { get: func () => gh.copy, set: func v => gh := v.copy }:
          use value <- action ()
          result := $Some value
  let $Some final_result = result else:
    @panic "ecs action did not complete"
  return ($World { time: t, positions: pos, velocities: vel, ghosts: gh }, final_result)

func get (witness: p -> a): a => State.get ()
func set value => State.set value
func get_column exemplar => get (func () => $Column #[$Some exemplar])

func create (): World => $World {
  time: $Time { seconds: 0.5 },
  positions: $Column #[
    $Some ($Position { x: 0.0, y: 0.0 }),
    $Some ($Position { x: 10.0, y: 20.0 }),
    $Nothing,
    $Some ($Position { x: 1.0, y: 2.0 }),
  ],
  velocities: $Column #[
    $Some ($Velocity { x: 2.0, y: 4.0 }),
    $Nothing,
    $Some ($Velocity { x: 1.0, y: 1.0 }),
    $Some ($Velocity { x: 4.0, y: 2.0 }),
  ],
  ghosts: $Column (array.generate 4 (func index: Maybe Ghost => $Nothing)),
}

func move_position position -> velocity -> seconds => case position, velocity of
  $Some ($Position { x, y }), $Some ($Velocity { x: vx, y: vy }) =>
    $Some ($Position { x: x + vx * seconds, y: y + vy * seconds })
  _, _ => position

func move () =>
  use stored_positions <- get_column ($Position { x: 0.0, y: 0.0 })
  use stored_velocities <- get_column ($Velocity { x: 0.0, y: 0.0 })
  use time <- get $Time
  let $Column positions = stored_positions
  let $Column velocities = stored_velocities
  let $Time { seconds } = time
  let next = positions.copy
  for index in 0..positions.length:
    next[index] := move_position positions[index] velocities[index] seconds
  return use set ($Column next)

func add_ghost () =>
  use stored <- get_column ($Ghost { remaining: 1.0 })
  let $Column ghosts = stored
  let next = ghosts.copy
  for index in 0..ghosts.length:
    next[index] := $Some ($Ghost { remaining: 1.0 })
  return use set ($Column next)

func update () =>
  use move ()
  use add_ghost ()
  return ()

func simulate (ticks: U32) -> (world: own World): World =>
  let next = world
  for tick in 0..ticks:
    let (updated, _) = run_scoped next update
    next := updated
  return next

func checksum_scoped () =>
  use stored <- get_column ($Position { x: 0.0, y: 0.0 })
  let $Column positions = stored
  let total = 0.0
  for position in positions:
    if let $Some ($Position { x, y }) = position:
      total := self + x + y
  return total

func checksum (world: World): F32 =>
  let (_, total) = run_scoped world.copy checksum_scoped
  return total

func count_ghosts (world: World): U32 =>
  let (_, count) = run_scoped world.copy (func () =>
    use stored <- get_column ($Ghost { remaining: 1.0 })
    let $Column ghosts = stored
    let count = 0
    for ghost in ghosts:
      if let $Some _ = ghost:
        count := self + 1
    return count)
  return count

io run (ticks: U32): F32 => checksum (simulate ticks (create ()))
io ghost_count (ticks: U32): U32 => count_ghosts (simulate ticks (create ()))
io snapshot (): F32 =>
  let original = create ()
  let next = simulate 1 original.copy
  return checksum next - checksum original
