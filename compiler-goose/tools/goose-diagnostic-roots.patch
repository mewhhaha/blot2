--- a/src/typecheck.h
+++ b/src/typecheck.h
@@ -3052,6 +3052,34 @@
             if (t->kind == TY_REF && t->ref->pool && !HasGenerics(t->ref->sub)) ValidatePool(t);
             if (IsIndexT(t)) ValidateIndexType(t);
         }
+        // Explicitly partial development diagnostics: only concrete probe roots.
+        // Globals and declaration validation above still run; no code is emitted.
+        if (auto selected = getenv("GOOSE_DIAGNOSTIC_ROOTS"); selected && *selected) {
+            if (!nomain) throw CompileError { "GOOSE_DIAGNOSTIC_ROOTS requires check mode" };
+            unordered_set<string> pending;
+            string names(selected);
+            for (size_t begin = 0; begin < names.size();) {
+                auto end = names.find(',', begin);
+                if (end == string::npos) end = names.size();
+                if (end == begin) throw CompileError { "empty diagnostic root" };
+                pending.insert(names.substr(begin, end - begin));
+                begin = end + 1;
+            }
+            vector<SFunction *> roots;
+            for (auto sf : ast.functions) {
+                if (!pending.erase(string(sf->qname))) continue;
+                if (!sf->params.empty() || !sf->generics.empty() || sf->isthread)
+                    throw CompileError { cat("diagnostic root needs a concrete no-argument wrapper: ", sf->qname) };
+                roots.push_back(sf);
+            }
+            if (!pending.empty()) throw CompileError { cat("unknown diagnostic root: ", *pending.begin()) };
+            for (auto sf : roots) CheckRoot([&] { CheckUnreached(sf); });
+            CheckRoot([&] { CheckGlobalShrinks(); });
+            CheckRoot([&] { SettleParamRootExactness(); });
+            CheckRoot([&] { ResolveGrowConflicts(); });
+            CheckRoot([&] { VerifyLiterals(); });
+            return;
+        }
         auto mainsf = ast.MainFunction();
         if (!mainsf && !library && !(nomain && !ast.DeclaresMain()))
             throw CompileError { "program needs exactly one global fn main()" };
