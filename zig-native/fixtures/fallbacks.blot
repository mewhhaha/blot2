data Maybe a = #Some a | #None
entry const matching = fn () => do:
  let #Some value = #Some 42 else:
    @panic "unreachable"
  return value
entry const choose = fn (flag: Bool) => do:
  let #Some value = if flag then #Some 42 else #None else:
    @panic "missing"
  return value
entry const floating = fn (flag: Bool) => do:
  let #Some value = if flag then #Some 42.5 else #None else:
    @panic "missing float"
  return value
entry const branches = fn (flag: Bool) => do:
  let #Some value = if flag then #Some 42 else #None else:
    if flag:
      @panic "first branch"
    else:
      @panic "second branch"
  return value
entry const nested = fn (flag: Bool) => do:
  let #Some value = if flag then #Some 42 else #None else:
    do:
      @panic "nested"
  return value
entry const merged = fn (flag: Bool) => do:
  let total = 40
  if flag:
    @panic "branch"
  else:
    total := @u32.add self 2
  return total
entry const folded = matching ()
entry const observed = fn (host: Unit -> U32 ! {Foreign}) => do:
  use flag <- host ()
  let #Some value = if @u32.eq flag 0 then #None else #Some 42 else:
    host ()
    @panic "after callback"
  return value
