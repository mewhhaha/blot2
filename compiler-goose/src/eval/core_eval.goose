}
fn literal(self: Session&,owner: i64,id: u32,frame: Frame&) -> ValueId,Error { let module=self.units[owner]; let node=module.node(id); if node.ty>=module.types.nodes.len { return 0,failNode(self,owner,id,Code.unsupported); } var shape=module.types.node(node.ty); let qualified=shape.tag==TypeTag.usage; if qualified { if shape.c!=0||(shape.b!=blot_check_types::usageKindCode(blot_check_types::UsageKind.unique)&&shape.b!=blot_check_types::usageKindCode(blot_check_types::UsageKind.shared)) { return 0,failNode(self,owner,id,Code.unsupported); } declineConstant(self); shape=module.types.node(shape.a); } var scalar=blot_backend_runtime_ir::SC_unit;
