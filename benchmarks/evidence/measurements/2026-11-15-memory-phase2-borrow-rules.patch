+    fn ownsIn(self: *Analyzer, ty: T.Id, variables: []const T.Id, arguments: []const bool, depth: usize) Error!bool {
+        switch (ty) {
+            T.unit, T.boolean, T.u32_type, T.f32_type, T.never => return false,
+            else => {},
+        }
+        if (depth > 64 or ty >= self.m.types.nodes.len) return true;
+        for (variables, arguments) |variable, argument| if (variable == ty) return argument;
+        if (variables.len == 0) if (self.owns_cache.get(ty)) |known| return known;
+        const n = self.m.types.node(ty);
+        switch (n.tag) {
+            .unit, .boolean, .u32, .f32, .never => return false,
+            .variable => return false,
+            .array, .list => return true,
+            .cursor, .function => return false,
+            .product => {
+                for (self.m.types.list(.{ .start = n.a, .len = n.b })) |item| if (try self.ownsIn(item, variables, arguments, depth + 1)) return true;
+                return false;
+            },
+            .record => {
+                for (0..n.b) |index| if (try self.ownsIn(self.m.types.recordField(n, index).ty, variables, arguments, depth + 1)) return true;
+                return false;
+            },
+            .nominal => {
+                if (storage_types.identity(n.a, n.b)) |kind| return kind == .grow or kind == .resize;
+                if (n.a == std.math.maxInt(u32)) return true;
+                const identity: T.NominalIdentity = .{ .unit = n.a, .decl = n.b };
