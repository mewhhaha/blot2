// Executable, source-defined ECS using immutable component columns.
// Entity IDs are column indices; Nothing means that component is absent.
// Worlds stay inside the guest. The current host ABI exchanges only scalars.

data Position = Position { x: F32, y: F32 }
data Velocity = Velocity { x: F32, y: F32 }
data Ghost = Ghost { remaining: F32 }
data Time = Time { seconds: F32 }
data World = World {
  positions: Array (Maybe Position),
  velocities: Array (Maybe Velocity),
  ghosts: Array (Maybe Ghost),
  time: Time,
}

fn create () => World {
  positions: [Some (Position { x: 0.0, y: 0.0 }), Some (Position { x: 10.0, y: 20.0 }), Nothing, Some (Position { x: 1.0, y: 2.0 })],
  velocities: [Some (Velocity { x: 2.0, y: 4.0 }), Nothing, Some (Velocity { x: 1.0, y: 1.0 }), Some (Velocity { x: 4.0, y: 2.0 })],
  ghosts: [Nothing, Nothing, Nothing, Nothing],
  time: Time { seconds: 0.5 },
}

fn move_position position => fn velocity => fn seconds =>
  case position, velocity of
    Some (Position { x, y }), Some (Velocity { x: vx, y: vy }) =>
      Some (Position {
        x: F32.add x (F32.mul vx seconds),
        y: F32.add y (F32.mul vy seconds),
      })
    _, _ => position

// This query requires Position and Velocity, but Time is a world resource.
fn move_columns positions => fn velocities => fn seconds => fn index => do:
  if index >= @array.length positions:
    return positions
  let next = move_position (@array.get positions index) (@array.get velocities index) seconds
  return move_columns (@array.set positions index next) velocities seconds (index + 1)

fn move world => do:
  let World { positions, velocities, ghosts, time } = world
  let Time { seconds } = time
  return World {
    positions: move_columns positions velocities seconds 0,
    velocities,
    ghosts,
    time,
  }

fn insert_ghosts ghosts => fn index => do:
  if index >= @array.length ghosts:
    return ghosts
  return insert_ghosts (@array.set ghosts index (Some (Ghost { remaining: 1.0 }))) (index + 1)

// Insertion does not require the component to have been present beforehand.
fn add_ghost world => do:
  let World { positions, velocities, ghosts, time } = world
  return World { positions, velocities, ghosts: insert_ghosts ghosts 0, time }

fn run_systems systems => fn world => fn index => do:
  if index >= @array.length systems:
    return world
  let next = (@array.get systems index) world
  return run_systems systems next (index + 1)

fn update world => run_systems [move, add_ghost] world 0

fn simulate ticks => fn world => do:
  if ticks == 0:
    return world
  return simulate (ticks - 1) (update world)

fn sum_positions positions => fn index => fn total => do:
  if index >= @array.length positions:
    return total
  let next = case @array.get positions index of
    Nothing => total
    Some (Position { x, y }) => F32.add total (F32.add x y)
  return sum_positions positions (index + 1) next

fn checksum world => do:
  let World { positions } = world
  return sum_positions positions 0 0.0

fn count_ghosts ghosts => fn index => fn count => do:
  if index >= @array.length ghosts:
    return count
  let next = case @array.get ghosts index of
    Nothing => count
    Some _ => count + 1
  return count_ghosts ghosts (index + 1) next

export fn run (ticks: U32) -> F32 => checksum (simulate ticks (create ()))

export fn ghost_count (ticks: U32) -> U32 => do:
  let World { ghosts } = simulate ticks (create ())
  return count_ghosts ghosts 0 0

export fn snapshot () -> F32 => do:
  let original = create ()
  let next = update original
  return F32.sub (checksum next) (checksum original)
