            load,write=>{ if first.tag != ValueTag.ref && first.tag != ValueTag.link { return Value {..},unsupported(self_,module,id); } if op == blot_check_storage_ops::Op.load { if first.root.present { return readElement(self_,module,id,first,first.index); } var value,error = constant(self_,0); if error != blot_error::Error.none { return Value {..},error; } let copied = self_.c.set(value.word,first.word); if copied != blot_error::Error.none { return Value {..},copied; } value.floating = first.floating; return value,blot_error::Error.none; } if !first.root.present { let word,error = scalar(self_,module,id,second); if error != blot_error::Error.none { return Value {..},error; } let assigned = self_.c.set(first.word,word); if assigned != blot_error::Error.none { return Value {..},assigned; } } else { let written = writeElement(self_,module,id,first,blot_support::some(first.index),second); if written != blot_error::Error.none { return Value {..},written; } } },
            length=>{ let word,error = length(self_,module,id,first); if error != blot_error::Error.none { return Value {..},error; } return Value { word: word , ..},blot_error::Error.none; },
