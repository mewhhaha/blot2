fn Engine::possibleOperationType(self:Engine&,original:u32,allow_unit:bool,depth:i64)->bool,blot_error::Error {if depth>=1024 {return false,blot_error::Error.type_limit;}let node=self.tree.node(original);if node.tag==blot_parse_ast::tag_group {return self.possibleOperationType(node.a,allow_unit,depth+1);}if node.tag==blot_parse_ast::tag_unit {return allow_unit,blot_error::Error.none;}if node.tag==blot_parse_ast::tag_name {if self.lookup(node.a).present {return false,blot_error::Error.none;}let global,err=self.globalBinding(node.a);if err!=blot_error::Error.none || global.present {return false,err;}let text=self.pool.get(node.a);if text=="Unit" || text=="Bool" || text=="U32" || text=="F32" || text=="Array" || text=="List" || text=="Cursor" {return true,blot_error::Error.none;}for entry in self.type_env.items {if entry.name==node.a {return true,blot_error::Error.none;}}return self.catalogs.nominal_names.contains(self.catalogKey(node.a)),blot_error::Error.none;}if node.tag==blot_parse_ast::tag_apply {let left,err=self.possibleOperationType(node.a,false,depth+1);if err!=blot_error::Error.none || !left {return false,err;}return self.possibleOperationType(node.b,true,depth+1);}if node.tag==blot_parse_ast::tag_product || node.tag==blot_parse_ast::tag_array {if node.tag==blot_parse_ast::tag_array && node.c==0 {return false,blot_error::Error.none;}for child in self.tree.children(original) {let possible,err=self.possibleOperationType(child,true,depth+1);if err!=blot_error::Error.none || !possible {return false,err;}}return true,blot_error::Error.none;}if node.tag==blot_parse_ast::tag_record {if node.a!=0 {return false,blot_error::Error.none;}for child in self.tree.children(original) {let field=self.tree.node(child);if field.b==0 {var known=false;for entry in self.type_env.items {known=known || entry.name==field.a;}if !known {return false,blot_error::Error.none;}}else {let possible,err=self.possibleOperationType(field.b,true,depth+1);if err!=blot_error::Error.none || !possible