fn valid(self_:const Owner&)->bool {return self_.lease!=0 && self_.lease-1<owners.len && owners[self_.lease-1].live && owners[self_.lease-1].generation==self_.generation;}
fn initOwner()->Owner,Error {if owners.len>=0xffffffff {return Owner{},blot_error::Error.out_of_memory;}let generation=blot_native::fresh_owner_id();let at=owners.alloc_index(Lease{generation:generation,live:true});return Owner{(at+1) as u32,generation},blot_error::Error.none;}
fn remember(self_:Owner&,run:Run)->Error {assert(self_.valid());if links.len>=0xffffffff {return blot_error::Error.out_of_memory;}let at=links.alloc_index(Link{run,owners[self_.lease-1].head});owners[self_.lease-1].head=(at+1) as u32;return blot_error::Error.none;}
fn mark(self_:const Owner&)->u32 {assert(self_.valid());return owners[self_.lease-1].head;}
