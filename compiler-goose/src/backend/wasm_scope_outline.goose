struct BankScratch {map:u32[:] = default<u32[:]>(),first:Reference[:] = default<Reference[:]>(),shared:bool[:] = default<bool[:]>(),writes:u32[:] = default<u32[:]>(),verified:u32[:] = default<u32[:]>(),retained:bool=false}
fn finalize(self_:Context&)->Stats,Error {let module .= self_.target();if self_.finalized || module.memory_model!=blot_backend_wasm::MemoryModel.data_stacks || module.artifacts {return Stats{..},blot_error::Error.invalid_outline;}if module.functions.len>1000000 || module.imports.len>1000000-module.functions.len {return Stats{..},blot_error::Error.outline_limit;}var banks=Banks{..};var prepared=PreparedBuffer{..};let first_global=module.globals.len;var counts=FinalCounts{next_global:first_global,..};let error=stageFinalization(self_,banks,prepared,counts);if error!=blot_error::Error.none {releaseFinalization(banks,prepared);return Stats{..},error;}let error=publishFinalization(self_,prepared,first_global,counts.next_global);releaseFinalization(banks,prepared);if error!=blot_error::Error.none {return Stats{..},error;}self_.stats=Stats{regions:self_.helpers.len as u64,globals:(counts.next_global-first_global) as u64,copies_removed:counts.copies_removed,reads_forwarded:counts.reads_forwarded,bank_operand_bytes_saved:counts.bank_operand_bytes_saved,..};self_.finalized=true;return self_.stats,blot_error::Error.none;}
