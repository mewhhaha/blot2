// A retained old snapshot forces copies of nominal wrappers, payload records
// and reference Arrays. Every reachable field is still immutable plain data.
type Body is data = #Body {position: (U32, U32), lanes: Array U32}
type World is data = #World {bodies: Array Body}
entry const update_snapshots = func (steps: U32) : U32 => return do:
  let world = #World {bodies: @array.generate 256 (func i => return #Body {position: (i, i + 1), lanes: #[i]})}
  let sum = 0
  for step in 0..steps:
    let previous = world
    let index = step % 256
    world.bodies[index].lanes := #[step]
    sum := self + previous.bodies[index].lanes[0] + world.bodies[index].lanes[0]
  break sum
entry const memory = func () : Array U32 => return #[]
