// Closed activation analysis: finite heap masks and path-owned immutable flow cells.
namespace blot_backend_activation_graph;
import support.error;
import support.option;
import support.pooled_buffer;
import .wasm;
import .runtime_ir;
import .provider_modes;
import .provider_origins;
import .callable_origins;
type Error=blot_error::Error;
type Module=blot_backend_wasm::Module;
type Function=blot_backend_runtime_ir::Function;
type Instruction=blot_backend_runtime_ir::Instruction;
type Op=blot_backend_runtime_ir::Op;
type Role=blot_backend_runtime_ir::Role;
type ValueType=blot_backend_runtime_ir::ValueType;
type ProviderFact=blot_backend_provider_origins::Fact;
type Catalog=blot_backend_provider_modes::Catalog;
type Mode=blot_backend_provider_modes::Mode;
let absent:u32=0xffffffff;
let max_sites:i64=64;
let max_words:i64=16;
struct TagTest {local:u32,version:u32,value:u32,equal:bool}
struct Value {owners:u64=0,codes:u64=0,constant:blot_support::Option<u32>=blot_support::Option<u32>{present:true,value:0},offset:u32=0,outside_head:bool=false,local:blot_support::Option<u32>=blot_support::Option<u32>{..},version:u32=0,tag_field:bool=false,tag_test:blot_support::Option<TagTest>=blot_support::Option<TagTest>{..}}
fn merge(self:Value&,other:Value)->bool {let previous=self;self.owners|=other.owners;self.codes|=other.codes;self.outside_head=self.outside_head || other.outside_head;if self.constant!=other.constant {self.constant=blot_support::none<u32>();}if self.offset!=other.offset {self.offset=absent;}self.local=blot_support::none<u32>();self.tag_field=false;self.tag_test=blot_support::none<TagTest>();return previous!=self;}
fn reference(self:Value)->bool {return self.owners!=0 || self.outside_head;}
enum Kind {ordinary,closure,frame,static_data}
struct Site {function:u32,at:u32,context:u32,bytes:u32,kind:Kind,provider:u64=0,children:u64=0,borrowed_head:bool=false}
struct Store {function:u32,at:u32,context:u32,owners:u64,values:u64,offset:u32,outside_value:bool}
struct Call {from:u32,at:u32,target:u32,indirect:bool}
enum Blocker {none,boundary,limit,instruction,receiver,escape,recursion,epoch,control,caller}
struct Context {parent:u32,at:u32,function:u32,provider:u64=0,outside_provider:bool=false}
struct Report {sites:Site[:]=[],calls:Call[:]=[],contexts:Context[:]=[],stores:Store[:]=[],complete:bool=false,blocker:Blocker=Blocker.none,function:u32=0,at:u32=0,work:i64=0}
reusable[] var site_runs:Site[>..]=[];
reusable[] var call_runs:Call[>..]=[];
reusable[] var context_runs:Context[>..]=[];
reusable[] var store_runs:Store[>..]=[];
reusable[] var word_runs:u32[>..]=[];
fn deinit(self:Report&) {if self.sites.len!=0 {site_runs.free_slice(self.sites);}if self.calls.len!=0 {call_runs.free_slice(self.calls);}if self.contexts.len!=0 {context_runs.free_slice(self.contexts);}if self.stores.len!=0 {store_runs.free_slice(self.stores);}self=Report{..};}
struct Object {site:Site=Site{function:0,at:0,context:0,bytes:0,kind:Kind.ordinary,..},words:Value[16]=[Value{..};16],roles:Role[16]=[blot_backend_runtime_ir::ROLE_unknown;16],written:u16=0,observed:u16=0,frame:blot_support::Option<ProviderFact>=blot_support::Option<ProviderFact>{..}}
// Written is the exact validity mask. Copying Flow copies every defined cell,
// so a later state write cannot modify any earlier branch or return snapshot.
struct Flow {cells:Value[64]=[Value{..};64],written:u64=0}
struct Frame {end:u32,alternate:u32,height:i64,result:bool}
struct State {pc:u32=0,locals:Value[128]=[Value{..};128],versions:u32[128]=[0;128],stack:Value[128]=[Value{..};128],stack_len:i64=0,frames:Frame[64]=[Frame{end:0,alternate:0,height:0,result:false};64],frame_len:i64=0,flow:Flow=Flow{..}}
struct Outcome {value:Value,flow:Flow}
struct Structure {ends:u32[:]=[],alternates:u32[:]=[]}
struct States {storage:State[:]=[],items:State[:]=[],len:i64=0}
reusable[] var pool_States:State[>..]=[];
fn push(self:States&,value:State)->Error {let error=blot_support_pooled_buffer::push(self,value,pool_States);self.len=self.items.len;return error;}
fn pop(self:States&)->State {assert(self.len>0);let value=self.items[self.len-1];blot_support_pooled_buffer::resize(self,self.len-1);self.len=self.items.len;return value;}
fn deinit(self:States&) {blot_support_pooled_buffer::deinit(self,pool_States);self.len=0;}
struct Outcomes {storage:Outcome[:]=[],items:Outcome[:]=[],len:i64=0}
reusable[] var pool_Outcomes:Outcome[>..]=[];
fn push(self:Outcomes&,value:Outcome)->Error {let error=blot_support_pooled_buffer::push(self,value,pool_Outcomes);self.len=self.items.len;return error;}
fn pop(self:Outcomes&)->Outcome {assert(self.len>0);let value=self.items[self.len-1];blot_support_pooled_buffer::resize(self,self.len-1);self.len=self.items.len;return value;}
fn deinit(self:Outcomes&) {blot_support_pooled_buffer::deinit(self,pool_Outcomes);self.len=0;}
reusable[] var structure_runs:blot_support::Option<Structure>[>..]=[];
struct Graph {module:const Module&,catalog:Catalog=Catalog{..},objects:Object[64]=[Object{..};64],object_count:i64=0,calls:Call[256]=[Call{from:0,at:0,target:0,indirect:false};256],call_count:i64=0,targets:u32[64]=[0;64],target_count:i64=0,contexts:Context[64]=[Context{parent:0,at:0,function:0,..};64],context_count:i64=0,stores:Store[256]=[Store{function:0,at:0,context:0,owners:0,values:0,offset:0,outside_value:false};256],store_count:i64=0,active:u32[16]=[0;16],active_count:i64=0,work:i64=0,changed:bool=false,structures:blot_support::Option<Structure>[:]=[],blocker:Blocker=Blocker.none,function:u32=0,at:u32=0,failure:Error=Error.none}
fn fail(self:Graph&,reason:Blocker)->Value {if self.blocker==Blocker.none {self.blocker=reason;}if self.failure==Error.none {self.failure=Error.unavailable;}return Value{..};}
fn recordError(self:Graph&,error:Error) {if self.failure==Error.none && error!=Error.none {self.failure=error;}}
fn spend(self:Graph&,count:i64)->bool {if self.failure!=Error.none {return false;}if count>262144-self.work {self.fail(Blocker.limit);return false;}self.work+=count;return true;}
fn push(self:Graph&,state:State&,value:Value) {if self.failure!=Error.none {return;}if state.stack_len>=128 {self.fail(Blocker.limit);return;}state.stack[state.stack_len]=value;state.stack_len+=1;}
fn pop(self:Graph&,state:State&)->Value {if self.failure!=Error.none {return Value{..};}if state.stack_len==0 {return self.fail(Blocker.control);}state.stack_len-=1;return state.stack[state.stack_len];}
fn context(self:Graph&,parent:u32,at:u32,function:u32)->u32 {for entry,index in self.contexts[..self.context_count] {if entry.parent==parent && entry.at==at && entry.function==function {return index as u32;}}if self.context_count==64 {self.fail(Blocker.limit);return 0;}let id=self.context_count;self.context_count+=1;self.contexts[id]=Context{parent:parent,at:at,function:function,..};return id as u32;}
fn target(self:Graph&,function:u32)->Value {if self.failure!=Error.none {return Value{..};}for entry,index in self.targets[..self.target_count] {if entry==function {return Value{codes:1 as u64<<index,constant:blot_support::none<u32>(),..};}}if self.target_count==64 {return self.fail(Blocker.limit);}let id=self.target_count;self.target_count+=1;self.targets[id]=function;return Value{codes:1 as u64<<id,constant:blot_support::none<u32>(),..};}
fn object(self:Graph&,context:u32,function:u32,at:u32,bytes:u32,kind:Kind)->u32 {for entry,index in self.objects[..self.object_count] {if entry.site.context==context && entry.site.function==function && entry.site.at==at {return index as u32;}}if self.object_count==64 || bytes==0 || bytes%4!=0 || bytes/4>16 {self.fail(Blocker.limit);return 0;}let id=self.object_count;self.object_count+=1;self.objects[id]=Object{site:Site{context:context,function:function,at:at,bytes:bytes,kind:kind,..},..};return id as u32;}
fn firstBit(bits:u64)->i64 {assert(bits!=0);var index:i64=0;var remaining=bits;while remaining&1==0 {remaining>>=1;index+=1;}return index;}
fn staticObject(self:Graph&,address:u32)->Value {if self.failure!=Error.none {return Value{..};}let id=self.object(absent,absent,address,8,Kind.static_data);if self.failure!=Error.none {return Value{..};}if address>self.module.data.len || 8>self.module.data.len-address {return self.fail(Blocker.receiver);}var code=blot_support::none<u32>();for origin in self.module.table_origins {if !origin.function.present && origin.place==address && blot_backend_callable_origins::construction(self.module,origin).present {code=blot_support::some(origin.target);break;}}for word in 0..2 {let at=address+word*4;let data=self.module.data;let value=data[at] as u32 | data[at+1] as u32<<8 | data[at+2] as u32<<16 | data[at+3] as u32<<24;var field=Value{constant:blot_support::some(value),..};if word==0 && code.present {field=self.target(code.value);}if word==1 && value!=0 {return self.fail(Blocker.receiver);}self.objects[id].words[word]=field;self.objects[id].roles[word]=blot_backend_runtime_ir::ROLE_scalar;self.objects[id].written|=1 as u16<<word;}return Value{owners:1 as u64<<id,constant:blot_support::none<u32>(),..};}
fn load(self:Graph&,flow:const Flow&,address:Value,offset:u32)->Value {if self.failure!=Error.none {return Value{..};}if address.outside_head || address.owners==0 || address.offset==absent || address.offset>absent-offset {return self.fail(Blocker.receiver);}let position=address.offset+offset;if position%4!=0 {return self.fail(Blocker.receiver);}var result=blot_support::none<Value>();var owners=address.owners;while owners!=0 {let id=firstBit(owners);owners&=owners-1;let object .= self.objects[id];if position>=object.site.bytes || object.written&(1 as u16<<(position/4))==0 {return self.fail(Blocker.receiver);}var field=object.words[position/4];let bit=1 as u64<<id;if object.frame.present && position==4 {if flow.written&bit==0 {return self.fail(Blocker.receiver);}field=flow.cells[id];}else {object.observed|=1 as u16<<(position/4);}if result.present {result.value.merge(field);}else {result=blot_support::some(field);}}if !result.present {return self.fail(Blocker.receiver);}var value=result.value;if position==0 && value.codes==0 && value.owners==0 && address.local.present {value.tag_field=true;value.local=address.local;value.version=address.version;}return value;}
fn recordStore(self:Graph&,context:u32,function:u32,at:u32,owners:u64,offset:u32,value:Value) {for &entry in self.stores[..self.store_count] {if entry.context==context && entry.function==function && entry.at==at && entry.offset==offset {entry.owners|=owners;entry.values|=value.owners;entry.outside_value=entry.outside_value || value.outside_head;return;}}if self.store_count==256 {self.fail(Blocker.limit);return;}self.stores[self.store_count]=Store{function:function,at:at,context:context,owners:owners,values:value.owners,offset:offset,outside_value:value.outside_head};self.store_count+=1;}
fn store(self:Graph&,flow:Flow&,context:u32,function:u32,at:u32,address:Value,offset:u32,value:Value) {if self.failure!=Error.none {return;}if address.outside_head || address.owners==0 || address.offset==absent {self.fail(Blocker.escape);return;}if address.offset>absent-offset {self.fail(Blocker.receiver);return;}let position=address.offset+offset;if position%4!=0 {self.fail(Blocker.receiver);return;}self.recordStore(context,function,at,address.owners,position,value);var owners=address.owners;while owners!=0 {let id=firstBit(owners);owners&=owners-1;let object .= self.objects[id];if position>=object.site.bytes || object.site.kind==Kind.static_data {self.fail(Blocker.escape);return;}if value.reference() && object.roles[position/4]!=blot_backend_runtime_ir::ROLE_reference {self.fail(Blocker.escape);return;}if object.roles[position/4]==blot_backend_runtime_ir::ROLE_reference && !value.reference() && (value.codes!=0 || !value.constant.present || value.constant.value!=0 || value.offset!=0) {self.fail(Blocker.receiver);return;}if value.outside_head && (!object.frame.present || position!=8) {self.fail(Blocker.escape);return;}let bit=1 as u16<<(position/4);if object.written&bit==0 {object.words[position/4]=value;object.words[position/4].local=blot_support::none<u32>();object.written|=bit;}else {let changed=object.words[position/4].merge(value);if changed && object.observed&bit!=0 {self.changed=true;}}if object.frame.present && position==4 {flow.cells[id]=value;flow.written|=1 as u64<<id;}object.site.children|=value.owners;object.site.borrowed_head=object.site.borrowed_head || value.outside_head;}}

fn structure(self:Graph&,function:u32)->Structure {if self.failure!=Error.none {return Structure{..};}if self.structures[function].present {return self.structures[function].value;}let code=self.module.instructions(self.module.functions[function]);let ends=word_runs.alloc_slice(code.len);let alternates=word_runs.alloc_slice(code.len);for &value in ends {value=absent;}for &value in alternates {value=absent;}var stack:u32[4096]=[0;4096];var length:i64=0;for inst,at in code {if inst.op==blot_backend_runtime_ir::OP_block || inst.op==blot_backend_runtime_ir::OP_if_ {stack[length]=at as u32;length+=1;}else if inst.op==blot_backend_runtime_ir::OP_loop {self.fail(Blocker.epoch);break;}else if inst.op==blot_backend_runtime_ir::OP_else_ {if length==0 {self.fail(Blocker.control);break;}let top=stack[length-1];if code[top].op!=blot_backend_runtime_ir::OP_if_ || alternates[top]!=absent {self.fail(Blocker.control);break;}alternates[top]=at as u32;}else if inst.op==blot_backend_runtime_ir::OP_end {if length==0 {self.fail(Blocker.control);break;}length-=1;ends[stack[length]]=at as u32;}}if length!=0 {self.fail(Blocker.control);}if self.failure!=Error.none {word_runs.free_slice(ends);word_runs.free_slice(alternates);return Structure{..};}let result=Structure{ends:ends,alternates:alternates};self.structures[function]=blot_support::some(result);return result;}
fn recordCall(self:Graph&,from:u32,at:u32,target:u32,indirect:bool) {let call=Call{from:from,at:at,target:target,indirect:indirect};for old in self.calls[..self.call_count] {if old==call {return;}}if self.call_count==256 {self.fail(Blocker.limit);return;}self.calls[self.call_count]=call;self.call_count+=1;}
fn incoming(self:Graph&,boundary:u32) {let affected_runs=word_runs.alloc_slice(self.module.functions.len);for &flag in affected_runs {flag=0;}incomingWithFlags(self,boundary,affected_runs);word_runs.free_slice(affected_runs);}
fn incomingWithFlags(self:Graph&,boundary:u32,affected:u32[:]) {affected[boundary]=1;for call in self.calls[..self.call_count] {affected[call.from]=1;affected[call.target]=1;}for entry in self.module.exports {if !entry.global && entry.index<affected.len && entry.index!=boundary && affected[entry.index]!=0 {self.fail(Blocker.caller);return;}}if self.module.start.present {let id=self.module.start.value;if id>=affected.len || (id!=boundary && affected[id]!=0) {self.fail(Blocker.caller);return;}}for body,function in self.module.functions {if self.module.runtimeHelper(function) {continue;}for inst,at in self.module.instructions(body) {if !self.spend(1) {return;}if inst.op==blot_backend_runtime_ir::OP_call && inst.operand<affected.len && affected[inst.operand]!=0 && inst.operand!=boundary && affected[function]==0 {self.function=function as u32;self.at=at as u32;self.fail(Blocker.caller);return;}if !inst.table_reference || inst.operand>=affected.len || affected[inst.operand]==0 {continue;}var constructed=false;for origin in self.module.table_origins {if !origin.function.present || origin.function.value!=function || origin.place!=at || origin.target!=inst.operand {continue;}if affected[function]==0 || !blot_backend_callable_origins::construction(self.module,origin).present {self.fail(Blocker.caller);return;}constructed=true;break;}if !constructed {self.fail(Blocker.caller);return;}}}for origin in self.module.table_origins {if origin.target>=affected.len || (origin.function.present && origin.function.value>=affected.len) {self.fail(Blocker.caller);return;}if affected[origin.target]==0 {continue;}if !origin.function.present || affected[origin.function.value]==0 || !blot_backend_callable_origins::construction(self.module,origin).present {self.fail(Blocker.caller);return;}}}
fn allocation(self:Graph&,flow:Flow&,context:u32,function:u32,at:u32,bytes:u32,head:Value)->Value {if self.failure!=Error.none {return Value{..};}let body=self.module.functions[function];let code=self.module.instructions(body);let annotations=blot_backend_runtime_ir::allocationAnnotations(code,at);if annotations.len==0 {return self.fail(Blocker.instruction);}let id=self.object(context,function,at,bytes,Kind.ordinary);if self.failure!=Error.none {return Value{..};}if head.offset!=0 {return self.fail(Blocker.receiver);}self.objects[id].site.provider|=head.owners;flow.written&=~(1 as u64<<id);for word in 0..bytes/4 {let role=blot_backend_runtime_ir::wordRole(annotations,word);if role!=blot_backend_runtime_ir::ROLE_scalar && role!=blot_backend_runtime_ir::ROLE_reference {return self.fail(Blocker.instruction);}if code[at].operand==self.module.arena.value.allocate_scalar && role!=blot_backend_runtime_ir::ROLE_scalar {return self.fail(Blocker.instruction);}self.objects[id].roles[word]=role;}for origin in self.module.table_origins {if !origin.function.present || origin.function.value!=function || origin.kind==blot_backend_runtime_ir::TABLE_unknown {continue;}let fact=blot_backend_callable_origins::construction(self.module,origin);if !fact.present {return self.fail(Blocker.instruction);}if !fact.value.allocation.present || fact.value.allocation.value!=at {continue;}self.objects[id].site.kind=Kind.closure;}for inst,point in code {if inst.op!=blot_backend_runtime_ir::OP_ownership {continue;}let marker=blot_backend_runtime_ir::ownership(inst.operand);if marker.kind!=blot_backend_runtime_ir::OWN_rest || marker.chunk!=blot_backend_provider_origins::begin_chunk {continue;}let fact=blot_backend_provider_origins::constructor(self.module,body,point);if !fact.present {return self.fail(Blocker.instruction);}if fact.value.allocation!=at {continue;}if fact.value.kind!=4 {return self.fail(Blocker.instruction);}self.objects[id].site.kind=Kind.frame;self.objects[id].frame=fact;}return Value{owners:1 as u64<<id,constant:blot_support::none<u32>(),..};}
fn stateAccess(self:Graph&,flow:Flow&,context:u32,function:u32,head:Value,mode:Mode,input:Value,seen:u64)->Value {if self.failure!=Error.none {return Value{..};}if head.outside_head || head.owners==0 || head.offset!=0 {return self.fail(Blocker.receiver);}var result=blot_support::none<Value>();var owners=head.owners;while owners!=0 {let id=firstBit(owners);let bit=1 as u64<<id;owners&=owners-1;if seen&bit!=0 {return self.fail(Blocker.receiver);}let object=self.objects[id];if !object.frame.present {return self.fail(Blocker.receiver);}let fact=object.frame.value;var value=Value{..};let is_write=fact.write.present && mode.operation==fact.write.value;if mode.operation==fact.read || is_write {if mode.access==blot_backend_provider_modes::Access.read {if mode.operation!=fact.read {return self.fail(Blocker.receiver);}value=self.load(flow,Value{owners:bit,constant:blot_support::none<u32>(),..},4);}else {if !is_write {return self.fail(Blocker.receiver);}var at:u32=48;if mode.machine==blot_backend_runtime_ir::VT_f32 {at+=1;}self.store(flow,context,function,at,Value{owners:bit,constant:blot_support::none<u32>(),..},4,input);}}else {let parent=self.load(flow,Value{owners:bit,constant:blot_support::none<u32>(),..},8);value=self.stateAccess(flow,context,function,parent,mode,input,seen|bit);}if self.failure!=Error.none {return Value{..};}if result.present {result.value.merge(value);}else {result=blot_support::some(value);}}if !result.present {return self.fail(Blocker.receiver);}return result.value;}
fn providerView(self:Graph&,source:Function)->blot_backend_provider_modes::FunctionView {return blot_backend_provider_modes::FunctionView{parameters:self.module.parameters(source),result:source.result,result_role:source.result_role,entry:source.entry,provider_parameter:source.provider_parameter,parameter_roles:source.parameter_roles,locals:self.module.locals(source),instructions:self.module.instructions(source)};}
fn invoke(self:Graph&,parent:u32,at:u32,function:u32,arguments:const Value[:],input_flow:Flow)->Outcomes {var outcomes=Outcomes{..};if !self.spend(1) {return outcomes;}if function>=self.module.functions.len || self.module.runtimeHelper(function) || self.active_count==16 {self.fail(Blocker.instruction);return outcomes;}for id in self.active[..self.active_count] {if id==function {self.fail(Blocker.recursion);return outcomes;}}let body=self.module.functions[function];if body.entry || arguments.len!=body.parameters.len || arguments.len>16 {self.fail(Blocker.boundary);return outcomes;}for value,index in arguments {let role=body.parameterRole(index);if role!=blot_backend_runtime_ir::ROLE_scalar && role!=blot_backend_runtime_ir::ROLE_reference {self.fail(Blocker.boundary);return outcomes;}if role==blot_backend_runtime_ir::ROLE_scalar && value.reference() {self.fail(Blocker.escape);return outcomes;}if value.outside_head && index!=body.provider_parameter {self.fail(Blocker.escape);return outcomes;}}let context=self.context(parent,at,function);if self.failure!=Error.none {return outcomes;}if body.provider_parameter<arguments.len {let supplied=arguments[body.provider_parameter];self.contexts[context].provider|=supplied.owners;self.contexts[context].outside_provider=self.contexts[context].outside_provider || supplied.outside_head;}self.active[self.active_count]=function;self.active_count+=1;var flow=input_flow;let view=self.providerView(body);let read=blot_backend_provider_modes::readOperation(self.catalog,view);let write=blot_backend_provider_modes::writeOperation(self.module,self.catalog,view);if read.present {let value=self.stateAccess(flow,context,function,arguments[2],read.value,Value{..},0);if self.failure==Error.none {self.recordError(outcomes.push(Outcome{value:value,flow:flow}));}}else if write.present {let value=self.stateAccess(flow,context,function,arguments[2],write.value,arguments[1],0);if self.failure==Error.none {self.recordError(outcomes.push(Outcome{value:value,flow:flow}));}}else {outcomes=self.scanBody(context,function,arguments,flow);}self.active_count-=1;return outcomes;}
fn finishFrame(self:Graph&,state:State&,frame:Frame) {var result=Value{..};if frame.result {result=self.pop(state);}if self.failure!=Error.none {return;}if state.stack_len<frame.height {self.fail(Blocker.control);return;}state.stack_len=frame.height;if frame.result {self.push(state,result);}}
fn branch(self:Graph&,state:State&,depth:u32,result:ValueType,outcomes:Outcomes&)->bool {if depth>state.frame_len {self.fail(Blocker.control);return false;}if depth==state.frame_len {var value=Value{..};if result!=blot_backend_runtime_ir::VT_none {value=self.pop(state);}self.recordError(outcomes.push(Outcome{value:value,flow:state.flow}));return false;}let index=state.frame_len-1-depth;let frame=state.frames[index];self.finishFrame(state,frame);state.frame_len=index;state.pc=frame.end+1;return true;}
fn constrain(self:Graph&,state:State&,value:Value,taken:bool)->bool {if value.constant.present {return (value.constant.value!=0)==taken;}if value.tag_test.present {let test=value.tag_test.value;if test.local>=128 || state.versions[test.local]!=test.version {return true;}var mask:u64=0;var owners=state.locals[test.local].owners;while owners!=0 {let id=firstBit(owners);owners&=owners-1;self.objects[id].observed|=1;let tag=self.objects[id].words[0].constant;if !tag.present || ((tag.value==test.value)==test.equal)==taken {mask|=1 as u64<<id;}}state.locals[test.local].owners&=mask;if state.locals[test.local].owners==0 {return false;}}return true;}

fn scanBody(self:Graph&,context:u32,function:u32,arguments:const Value[:],flow:Flow)->Outcomes {var outcomes=Outcomes{..};let source=self.module.functions[function];let code=self.module.instructions(source);let count=source.parameters.len+self.module.locals(source).len;if count>128 || code.len>4096 {self.fail(Blocker.limit);return outcomes;}let layout=self.structure(function);if self.failure!=Error.none {return outcomes;}var initial=State{flow:flow,..};for value,index in arguments {initial.locals[index]=value;}var pending=States{..};self.recordError(pending.push(initial));var paths:i64=0;while pending.len!=0 && self.failure==Error.none {paths+=1;if paths>256 {self.fail(Blocker.limit);break;}var state=pending.pop();var live=true;while state.pc<code.len && live && self.failure==Error.none {if !self.spend(1) {break;}self.function=function;self.at=state.pc;live=stepState(self,context,function,arguments,source,layout,count,state,pending,outcomes);}if live && self.failure==Error.none {if state.frame_len!=0 {self.fail(Blocker.control);break;}var value=Value{..};if source.result!=blot_backend_runtime_ir::VT_none {value=self.pop(state);}if self.failure==Error.none {self.recordError(outcomes.push(Outcome{value:value,flow:state.flow}));}}}pending.deinit();return outcomes;}
fn stepState(self:Graph&,context:u32,function:u32,arguments:const Value[:],source:Function,layout:Structure,count:i64,state:State&,pending:States&,outcomes:Outcomes&)->bool {let code=self.module.instructions(source);let inst=code[state.pc];var next=true;var live=true;match inst.op {
 blot_backend_runtime_ir::OP_ownership,blot_backend_runtime_ir::OP_nop => {},
 blot_backend_runtime_ir::OP_local_get => {if inst.operand>=count {self.fail(Blocker.instruction);return false;}var value=state.locals[inst.operand];value.local=blot_support::some(inst.operand);value.version=state.versions[inst.operand];self.push(state,value);},
 blot_backend_runtime_ir::OP_local_set,blot_backend_runtime_ir::OP_local_tee => {if inst.operand>=count {self.fail(Blocker.instruction);return false;}var value=self.pop(state);var machine=blot_backend_runtime_ir::VT_none;if inst.operand<source.parameters.len {machine=self.module.parameters(source)[inst.operand];}else {machine=self.module.locals(source)[inst.operand-source.parameters.len];}if value.reference() && machine!=blot_backend_runtime_ir::VT_i32 {self.fail(Blocker.instruction);return false;}value.local=blot_support::none<u32>();value.tag_field=false;state.locals[inst.operand]=value;state.versions[inst.operand]+=1;if inst.op==blot_backend_runtime_ir::OP_local_tee {self.push(state,value);}},
 blot_backend_runtime_ir::OP_i32_const => {var value=Value{constant:blot_support::some(inst.operand),..};let constructor,has_constructor=blot_backend_runtime_ir::staticConstructor(code,state.pc);if inst.table_reference {value=self.target(inst.operand);}else if blot_backend_runtime_ir::hasImmortalReference(code,state.pc) || has_constructor {value=self.staticObject(inst.operand);}self.push(state,value);},
 blot_backend_runtime_ir::OP_f32_const => {self.push(state,Value{constant:blot_support::some(inst.operand),..});},
 blot_backend_runtime_ir::OP_global_get => {if inst.operand>=self.module.globals.len || blot_backend_runtime_ir::role(self.module.globals[inst.operand].scalar)==blot_backend_runtime_ir::ROLE_reference {self.fail(Blocker.escape);return false;}self.push(state,Value{constant:blot_support::none<u32>(),..});},
 blot_backend_runtime_ir::OP_i32_load,blot_backend_runtime_ir::OP_f32_load => {let address=self.pop(state);let value=self.load(state.flow,address,inst.operand);if inst.op==blot_backend_runtime_ir::OP_f32_load && value.reference() {self.fail(Blocker.instruction);return false;}self.push(state,value);},
 blot_backend_runtime_ir::OP_i32_store,blot_backend_runtime_ir::OP_f32_store => {let value=self.pop(state);if inst.op==blot_backend_runtime_ir::OP_f32_store && value.reference() {self.fail(Blocker.instruction);return false;}let address=self.pop(state);self.store(state.flow,context,function,state.pc,address,inst.operand,value);},
 blot_backend_runtime_ir::OP_i32_add,blot_backend_runtime_ir::OP_i32_sub => {var right=self.pop(state);var left=self.pop(state);if right.reference() && inst.op==blot_backend_runtime_ir::OP_i32_add {let previous=left;left=right;right=previous;}if !left.reference() && right.reference() {self.fail(Blocker.escape);return false;}if left.reference() {if right.reference() || !right.constant.present || left.offset==absent {self.fail(Blocker.receiver);return false;}if inst.op==blot_backend_runtime_ir::OP_i32_add {if left.offset>absent-right.constant.value {self.fail(Blocker.receiver);return false;}left.offset+=right.constant.value;}else {if left.offset<right.constant.value {self.fail(Blocker.receiver);return false;}left.offset-=right.constant.value;}left.local=blot_support::none<u32>();self.push(state,left);}else {var value=Value{constant:blot_support::none<u32>(),..};if left.constant.present && right.constant.present {var bits:u32=0;if inst.op==blot_backend_runtime_ir::OP_i32_add {bits=(left.constant.value as u64+right.constant.value as u64) as! u32;}else {bits=(left.constant.value as u64+4294967296-right.constant.value as u64) as! u32;}value.constant=blot_support::some(bits);}self.push(state,value);}},
 blot_backend_runtime_ir::OP_i32_eq,blot_backend_runtime_ir::OP_i32_ne,blot_backend_runtime_ir::OP_i32_eqz => {var right=Value{..};if inst.op!=blot_backend_runtime_ir::OP_i32_eqz {right=self.pop(state);}let left=self.pop(state);var value=Value{constant:blot_support::none<u32>(),..};if left.constant.present && right.constant.present {var bit:u32=0;if (left.constant.value==right.constant.value)!=(inst.op==blot_backend_runtime_ir::OP_i32_ne) {bit=1;}value.constant=blot_support::some(bit);}if left.tag_field && left.local.present && right.constant.present && inst.op!=blot_backend_runtime_ir::OP_i32_eqz {value.tag_test=blot_support::some(TagTest{local:left.local.value,version:left.version,value:right.constant.value,equal:inst.op==blot_backend_runtime_ir::OP_i32_eq});}self.push(state,value);},
 blot_backend_runtime_ir::OP_block,blot_backend_runtime_ir::OP_if_ => {var condition=Value{constant:blot_support::some(1 as u32),..};if inst.op==blot_backend_runtime_ir::OP_if_ {condition=self.pop(state);}if state.frame_len>=64 {self.fail(Blocker.limit);return false;}let frame=Frame{end:layout.ends[state.pc],alternate:layout.alternates[state.pc],height:state.stack_len,result:inst.operand!=0 && inst.operand!=blot_backend_runtime_ir::VT_none};state.frames[state.frame_len]=frame;state.frame_len+=1;if inst.op==blot_backend_runtime_ir::OP_if_ {var other=state;if self.constrain(other,condition,false) {if frame.alternate!=absent {other.pc=frame.alternate+1;}else {if frame.result {self.fail(Blocker.control);return false;}other.frame_len-=1;other.pc=frame.end+1;}self.recordError(pending.push(other));}live=self.constrain(state,condition,true);}},
 blot_backend_runtime_ir::OP_else_,blot_backend_runtime_ir::OP_end => {if state.frame_len==0 {self.fail(Blocker.control);return false;}state.frame_len-=1;let frame=state.frames[state.frame_len];self.finishFrame(state,frame);if inst.op==blot_backend_runtime_ir::OP_else_ {state.pc=frame.end+1;next=false;}},
 blot_backend_runtime_ir::OP_br,blot_backend_runtime_ir::OP_br_if => {if inst.op==blot_backend_runtime_ir::OP_br_if {let condition=self.pop(state);var taken=state;if self.constrain(taken,condition,true) && self.branch(taken,inst.operand,source.result,outcomes) {self.recordError(pending.push(taken));}live=self.constrain(state,condition,false);}else {live=self.branch(state,inst.operand,source.result,outcomes);next=false;}},
 blot_backend_runtime_ir::OP_return_ => {var value=Value{..};if source.result!=blot_backend_runtime_ir::VT_none {value=self.pop(state);}self.recordError(outcomes.push(Outcome{value:value,flow:state.flow}));live=false;},
 blot_backend_runtime_ir::OP_unreachable_ => {live=false;},
 blot_backend_runtime_ir::OP_drop => {self.pop(state);},
 blot_backend_runtime_ir::OP_call,blot_backend_runtime_ir::OP_call_indirect => {return callState(self,context,function,arguments,source,state,pending,inst);},
 blot_backend_runtime_ir::OP_call_import => {self.fail(Blocker.instruction);return false;},
 _ => {let contract=blot_backend_runtime_ir::contract(self.module,source,inst);if contract.effect!=blot_backend_runtime_ir::EFFECT_pure || contract.may_trap {self.fail(Blocker.instruction);return false;}for index in 0..contract.arity {let value=self.pop(state);if value.reference() {self.fail(Blocker.escape);return false;}}if contract.result!=blot_backend_runtime_ir::VT_none {self.push(state,Value{constant:blot_support::none<u32>(),..});}},
 }if state.stack_len>128 || state.frame_len>64 {self.fail(Blocker.limit);return false;}if next {state.pc+=1;}return live;
}
fn appendContinuations(self:Graph&,state:const State&,pending:States&,results:const Outcomes&,result:ValueType) {if self.failure!=Error.none {return;}for outcome in results.items {var continuation=state;continuation.pc+=1;continuation.flow=outcome.flow;if result!=blot_backend_runtime_ir::VT_none {self.push(continuation,outcome.value);}if self.failure!=Error.none {return;}self.recordError(pending.push(continuation));}}
fn callState(self:Graph&,context:u32,function:u32,arguments:const Value[:],source:Function,state:State&,pending:States&,inst:Instruction)->bool {if (inst.op==blot_backend_runtime_ir::OP_call && inst.operand>=self.module.functions.len) || (inst.op==blot_backend_runtime_ir::OP_call_indirect && inst.operand>=self.module.signatures.len) {self.fail(Blocker.instruction);return false;}var selector=Value{..};if inst.op==blot_backend_runtime_ir::OP_call_indirect {selector=self.pop(state);}let signature=blot_backend_runtime_ir::call(self.module,inst);if signature.parameters.len>16 {self.fail(Blocker.limit);return false;}var args:Value[16]=[Value{..};16];var count=signature.parameters.len;while count!=0 {count-=1;args[count]=self.pop(state);}if self.failure!=Error.none {return false;}let arena=self.module.arena.value;if inst.op==blot_backend_runtime_ir::OP_call && arena.isAllocation(inst.operand) {if signature.parameters.len!=1 || !args[0].constant.present || args[0].reference() {self.fail(Blocker.instruction);return false;}var head=Value{..};if source.provider_parameter<arguments.len {head=arguments[source.provider_parameter];}let value=self.allocation(state.flow,context,function,state.pc,args[0].constant.value,head);self.push(state,value);state.pc+=1;return true;}if inst.op==blot_backend_runtime_ir::OP_call && inst.operand==arena.recycle {if signature.parameters.len!=1 || args[0].outside_head || args[0].owners==0 || args[0].offset!=0 {self.fail(Blocker.escape);return false;}var owners=args[0].owners;while owners!=0 {let id=firstBit(owners);owners&=owners-1;if self.objects[id].site.kind!=Kind.frame {self.fail(Blocker.escape);return false;}}state.pc+=1;return true;}
 if inst.op==blot_backend_runtime_ir::OP_call {self.recordCall(function,state.pc,inst.operand,false);var results=self.invoke(context,state.pc,inst.operand,args[..signature.parameters.len],state.flow);self.appendContinuations(state,pending,results,signature.result);results.deinit();}else {if selector.codes==0 || selector.reference() || selector.constant.present {self.fail(Blocker.receiver);return false;}var combined=Outcomes{..};var targets=selector.codes;while targets!=0 && self.failure==Error.none {let index=firstBit(targets);targets&=targets-1;let target=self.targets[index];if self.module.functions[target].signature!=inst.operand {continue;}self.recordCall(function,state.pc,target,true);var results=self.invoke(context,state.pc,target,args[..signature.parameters.len],state.flow);if self.failure==Error.none {for outcome in results.items {self.recordError(combined.push(outcome));}}results.deinit();}self.appendContinuations(state,pending,combined,signature.result);combined.deinit();}return false;
}
fn deinit(self:Graph&) {for entry in self.structures {if entry.present {word_runs.free_slice(entry.value.ends);word_runs.free_slice(entry.value.alternates);}}if self.structures.len!=0 {structure_runs.free_slice(self.structures);}self.catalog.deinit();}
fn analyze(module:const Module&,boundary:u32)->Report,Error {let catalog,error=blot_backend_provider_modes::initProtected(module);if error!=Error.none {return Report{..},error;}let structures=structure_runs.alloc_slice(module.functions.len);for &entry in structures {entry=blot_support::none<Structure>();}var graph=Graph{module:module,function:boundary,structures:structures,..};if catalog.present {graph.catalog=catalog.value;}let complete=analyzeInto(graph,boundary,catalog.present);if graph.failure!=Error.none && graph.failure!=Error.unavailable {let error=graph.failure;graph.deinit();return Report{..},error;}let sites=site_runs.alloc_slice(graph.object_count);for &site,index in sites {site=graph.objects[index].site;}let calls=call_runs.alloc_slice(graph.call_count);for &call,index in calls {call=graph.calls[index];}let contexts=context_runs.alloc_slice(graph.context_count);for &context,index in contexts {context=graph.contexts[index];}let stores=store_runs.alloc_slice(graph.store_count);for &store,index in stores {store=graph.stores[index];}let result=Report{sites:sites,calls:calls,contexts:contexts,stores:stores,complete:complete,blocker:graph.blocker,function:graph.function,at:graph.at,work:graph.work};graph.deinit();return result,Error.none;}
fn analyzeInto(graph:Graph&,boundary:u32,catalog:bool)->bool {let module .= graph.module;let drain,has_drain=module.resourceDrainImport();var complete=false;if module.arena.present && boundary<module.functions.len && !has_drain {let source=module.functions[boundary];if !source.entry && source.result==blot_backend_runtime_ir::VT_i32 && source.result_role==blot_backend_runtime_ir::ROLE_scalar && source.parameters.len<=16 && blot_backend_runtime_ir::validProviderParameter(module,source) && catalog {var args:Value[16]=[Value{..};16];var admitted=true;for parameter,index in module.parameters(source) {if index==source.provider_parameter {args[index]=Value{outside_head:true,constant:blot_support::none<u32>(),..};}else {if source.parameterRole(index)!=blot_backend_runtime_ir::ROLE_scalar {admitted=false;break;}args[index]=Value{constant:blot_support::none<u32>(),..};}}if admitted {for iteration in 0..32 {graph.changed=false;for &object in graph.objects[..graph.object_count] {object.observed=0;}var outcomes=graph.invoke(absent,absent,boundary,args[..source.parameters.len],Flow{..});if graph.failure!=Error.none {outcomes.deinit();break;}var escaped=false;for outcome in outcomes.items {if outcome.value.reference() {escaped=true;break;}}outcomes.deinit();if escaped {graph.blocker=Blocker.escape;break;}if !graph.changed {complete=true;break;}}}}}if !complete && graph.blocker==Blocker.none {graph.blocker=Blocker.boundary;}if complete {graph.incoming(boundary);if graph.failure!=Error.none {complete=false;}}return complete;}
struct Cohort {graph:Report,owner:u8,members:u64}
fn deinit(self:Cohort&) {self.graph.deinit();}
fn reachable(sites:const Site[:],initial:u64)->u64 {var seen=initial;for iteration in 0..64 {var pending=seen;var next=seen;while pending!=0 {let id=firstBit(pending);pending&=pending-1;next|=sites[id].children;}if next==seen {return seen;}seen=next;}return seen;}
fn countBits(bits:u64)->i64 {var count:i64=0;var pending=bits;while pending!=0 {pending&=pending-1;count+=1;}return count;}
fn cohort(module:const Module&,boundary:u32)->blot_support::Option<Cohort>,Error {var graph,error=analyze(module,boundary);if error!=Error.none {return blot_support::none<Cohort>(),error;}let candidate=cohortOwner(module,graph,boundary);if !candidate.present {graph.deinit();return blot_support::none<Cohort>(),Error.none;}return blot_support::some(Cohort{graph:graph,owner:candidate.value.owner,members:candidate.value.members}),Error.none;}
struct CohortBits {owner:u8,members:u64}
fn cohortOwner(module:const Module&,graph:const Report&,boundary:u32)->blot_support::Option<CohortBits> {if !graph.complete || graph.contexts.len==0 {return blot_support::none<CohortBits>();}var frame=blot_support::none<u8>();var statics:u64=0;for site,index in graph.sites {if site.kind==Kind.static_data {statics|=1 as u64<<index;}if site.kind!=Kind.frame {continue;}if frame.present || site.function!=boundary || site.context!=0 {return blot_support::none<CohortBits>();}frame=blot_support::some(index as u8);}if !frame.present {return blot_support::none<CohortBits>();}let owner=frame.value;let owner_bit=1 as u64<<owner;var members:u64=0;for site,index in graph.sites {if site.kind!=Kind.closure {continue;}let bit=1 as u64<<index;var pending=reachable(graph.sites,bit);while pending!=0 {let child=firstBit(pending);pending&=pending-1;if reachable(graph.sites,1 as u64<<child)&bit!=0 {members|=1 as u64<<child;}}}if countBits(members)<2 || members&(statics|owner_bit)!=0 {return blot_support::none<CohortBits>();}let internal=members|owner_bit|statics;var pending=members;while pending!=0 {let id=firstBit(pending);pending&=pending-1;let site=graph.sites[id];if site.context==0 || site.provider!=owner_bit || site.borrowed_head || site.children&~internal!=0 {return blot_support::none<CohortBits>();}if site.function>=module.functions.len || module.functions[site.function].provider_parameter>=module.functions[site.function].parameters.len {return blot_support::none<CohortBits>();}var context=site.context;var enclosed=false;for depth in 0..64 {if context>=graph.contexts.len {return blot_support::none<CohortBits>();}let entry=graph.contexts[context];if context==0 {enclosed=entry.parent==absent && entry.function==boundary;break;}context=entry.parent;}if !enclosed {return blot_support::none<CohortBits>();}}for store in graph.stores {let grouped=store.owners&members!=0 || (store.owners&owner_bit!=0 && store.offset==4);if grouped {if store.outside_value || store.values&~internal!=0 || store.owners&~(members|owner_bit)!=0 {return blot_support::none<CohortBits>();}}else if store.values&members!=0 {return blot_support::none<CohortBits>();}}return blot_support::some(CohortBits{owner:owner,members:members});}
