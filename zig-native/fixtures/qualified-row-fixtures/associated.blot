infixl 60 (+) = add
type Tick is effect = Unit -> Unit
const add = func left => return func right => return @type.call "add" left right
type Box is data = $Box U32
const Box.add = func left => return func right => return do:
  let $Box a=left
  let $Box b=right
  break $Box (@u32.add a b)
const twice: a -> a ! {Tick} where { associated "add" a a a ! {} } = func value => return do:
  use Tick ()
  break value + value
entry const answer = func () => return do (@effect.provider Tick (func () => return ())):
  use boxed <- twice ($Box 21)
  let $Box value=boxed
  break value
entry const folded=answer ()
