type Box is data = $Box (Array U32)
type World is data = $World { counts: Array U32, other: Array U32 }
const scaled = func (rows: Array U32) -> (k: U32) => return #[@u32.mul rows[0] k, @u32.mul rows[1] k]
const twice = func step -> (own state) => return do:
  state := step (own state) 1
  state := step own state 2
  break state
const bump = func (rows: own Array U32) -> (k: U32) => return do:
  rows[0] := @u32.add rows[0] k
  break rows
const run = func (n: U32) => return (twice bump #[n, 2])[0]
