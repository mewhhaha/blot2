fn admitJobRequest<G>(self_:State&,g:G&,id:u32)->bool,Error {self_.stats.request_checks+=1;if id==0 || id>self_.requests_admitted.len {return false,blot_error::Error.none;}if self_.requests_admitted[id-1] && g.owner_id!=0 && self_.importer.generator_owner==g.owner_id {self_.stats.request_hits+=1;return true,blot_error::Error.none;}let request=self_.old.metadata.jobs.items[id-1].request;let selected,error=self_.importer.importRequest(g,request);if error!=blot_error::Error.none || !selected.present {return false,error;}self_.requests_admitted[id-1]=false;match request {named=>{self_.requests_admitted[id-1]=true;},closure item=>{self_.requests_admitted[id-1]=item.key.static_values==0;},_=>{},}return true,blot_error::Error.none;}
