 GS_API GS_NORETURN void gs_panic(const char *msg) {
     fprintf(stderr, "goose runtime error: %s\n", msg);
     gs_end(1);
+}
+
+static gs_observer_event_fn gs_observer_event;
+static gs_observer_try_fn gs_observer_try;
+static gs_observer_oom_fn gs_observer_refusal;
+
+GS_API void gs_runtime_observer_install(gs_observer_event_fn event,
+    gs_observer_try_fn attempt, gs_observer_oom_fn oom) {
+    gs_observer_event = event;
+    gs_observer_try = attempt;
+    gs_observer_refusal = oom;
+}
+
+/* Only explicit allocator refusals or selected synthetic mutation failpoints
+   reach this path. Generic panic, invalid sizes and signals never do. */
+static GS_NORETURN void gs_observer_oom(int kind, uint64_t bytes) {
+    if (gs_observer_refusal) gs_observer_refusal(kind, bytes);
+    gs_panic("out of memory at observed allocation");
+}
+GS_API void gs_observer_attempt(int kind, uint64_t owner, uint64_t bytes) {
+    if (gs_observer_try && gs_observer_try(kind, owner, bytes))
+        gs_observer_oom(kind, bytes);
+}
+GS_API void gs_observer_pool_commit(int kind, uint64_t owner, uint64_t old_bytes,
+    uint64_t new_bytes, uint64_t before, uint64_t after) {
+    if (!gs_observer_event) return;
+    gs_observer_event(kind, owner, old_bytes, new_bytes, after);
+    if (after > before)
+        gs_observer_event(GS_OBS_POOL_CAPACITY_GROW, owner, before, after, 0);
+    else if (new_bytes > old_bytes)
+        gs_observer_event(GS_OBS_POOL_REUSE, owner, 0, new_bytes - old_bytes, 0);
 }
 
