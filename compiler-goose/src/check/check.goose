 }}
 if text=="@hole" {let scope,err=self.holeScope();if err!=blot_error::Error.none {return 0,err;}self.holes.append(Engine_holes{id,scope,self.current});return self.types.fresh();}if text=="@requests" || text=="@computation" {var code=Code.intrinsic_arity;if text=="@requests" {code=Code.requests_scope;}let err=self.diagnostic(code,id);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}if exactIntrinsicArity(text).present && self.permitted_intrinsic!=id {let err=self.diagnostic(Code.call_arity,id);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}
