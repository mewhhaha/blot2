fn Engine::retainsSelfMember(self:const Engine&,binding:u32,member:Associated)->bool {let declaration=self.bindings[binding].declaration;let state .= self.global_states.get(binding);if !state || state.state!=State.complete {return false;}for pending in self.pending {if pending.owner!=binding || pending.scope!=declaration || !pending.method_member || (!pending.suspended && !state.on_stack) || pending.solved || pending.covered || pending.declared {continue;}let requirement=pending.value;if requirement.explicit || requirement.kind!=blot_check_types::ObligationKind.receiver || requirement.name!=member.member || self.types.node(self.types.head(requirement.other,0)).tag!=blot_check_types::Tag.unit {continue;}let receiver=self.identityOf(requirement.ty);if receiver.present && receiver.value==member.identity {return true;}}return false;}
struct NameParts {text:const u8[:],position:i64=0,finished:bool=false}
fn NameParts::next(self:NameParts&)->blot_support::Option<const u8[:]> {if self.finished {return blot_support::none<const u8[:]>();}let start=self.position;while self.position<self.text.len {if self.text[self.position]=='.' as u8 {let end=self.position;self.position+=1;return blot_support::some(self.text[start..end]);}self.position+=1;}self.finished=true;return blot_support::some(self.text[start..]);}
