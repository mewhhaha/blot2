fn uleb(value:i64)->i64 {var remaining=value;var bytes:i64=1;while remaining>=128 {remaining>>=7;bytes+=1;}return bytes;}
fn sleb(value:u32)->i64 {var remaining=value as! i32;var bytes:i64=0;loop {let byte=(remaining as! u32)&127;remaining>>=7;bytes+=1;if (remaining==0 && byte&64==0) || (remaining== -1 && byte&64!=0) {return bytes;}}}
fn instructionBound(inst:Instruction)->blot_support::Option<i64> {if inst.table_reference {return blot_support::some(6 as i64);}let opcode,simd_=blot_backend_wasm_simd_ops::code(inst.op);if simd_ {var bytes:i64=1+uleb(opcode as i64);match inst.op {blot_backend_runtime_ir::OP_v128_load,blot_backend_runtime_ir::OP_v128_store=>{bytes+=1+uleb(inst.operand);},blot_backend_runtime_ir::OP_i32x4_replace_lane,blot_backend_runtime_ir::OP_i32x4_extract_lane,blot_backend_runtime_ir::OP_f32x4_extract_lane,blot_backend_runtime_ir::OP_f32x4_replace_lane=>{bytes+=1;},blot_backend_runtime_ir::OP_i8x16_shuffle=>{bytes+=16;},_=>{},}return blot_support::some(bytes);}match inst.op {blot_backend_runtime_ir::OP_ownership,blot_backend_runtime_ir::OP_wide_layouts,blot_backend_runtime_ir::OP_resource_retire,blot_backend_runtime_ir::OP_call_indirect=>{return blot_support::none<i64>();},blot_backend_runtime_ir::OP_block,blot_backend_runtime_ir::OP_loop,blot_backend_runtime_ir::OP_if_,blot_backend_runtime_ir::OP_memory_size,blot_backend_runtime_ir::OP_memory_grow,blot_backend_runtime_ir::OP_host_ref_get,blot_backend_runtime_ir::OP_host_ref_set,blot_backend_runtime_ir::OP_host_ref_null,blot_backend_runtime_ir::OP_i32_trunc_sat_f32_u=>{return blot_support::some(2 as i64);},blot_backend_runtime_ir::OP_local_get,blot_backend_runtime_ir::OP_local_set,blot_backend_runtime_ir::OP_local_tee,blot_backend_runtime_ir::OP_global_get,blot_backend_runtime_ir::OP_global_set,blot_backend_runtime_ir::OP_br,blot_backend_runtime_ir::OP_br_if=>{return blot_support::some(1+uleb(inst.operand));},blot_backend_runtime_ir::OP_call,blot_backend_runtime_ir::OP_call_import=>{return blot_support::some(6 as i64);},blot_backend_runtime_ir::OP_i32_const=>{return blot_support::some(1+sleb(inst.operand));},blot_backend_runtime_ir::OP_f32_const=>{return blot_support::some(5 as i64);},blot_backend_runtime_ir::OP_i32_load,blot_backend_runtime_ir::OP_f32_load,blot_backend_runtime_ir::OP_i32_store,blot_backend_runtime_ir::OP_f32_sto