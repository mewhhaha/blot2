             if (CanContain(pt, of))
                 for (auto &a : v->ref.alts)
-                    if (Depth(a.root) <= rd) out.Add({ a.root, a.exact, a.from });
+                    if (Depth(a.root) <= rd) add({ a.root, a.exact, a.from });
             beyond(v, pt, rd);
         } else {
-            if (Depth(v) <= rd && CanContain(v->type, of)) out.Add({ v, true });
+            if (Depth(v) <= rd && CanContain(v->type, of)) add({ v, true });
