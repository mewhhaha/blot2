fn captureFrozenBodies(tree:const Tree&,pool:const Pool&,checked:const blot_check_check::Checked&,names:blot_support::Option<ExternalNames>,bodies:FreezeBodies&,rows:Scratch_u32&,auxiliary_roots:AuxiliaryRoots&,cache:Cache&)->Error {
 for body in bodies.items {for fact in body.facts {{let pushed=auxiliary_roots.types.push(fact.ty);if pushed!=blot_error::Error.none {return pushed;}}}for binding in body.bindings {{let pushed=auxiliary_roots.types.push(binding.ty);if pushed!=blot_error::Error.none {return pushed;}}}for signature in body.signatures {{let pushed=auxiliary_roots.types.push(signature.ty);if pushed!=blot_error::Error.none {return pushed;}}}for access in body.accesses {{let pushed=auxiliary_roots.types.push(access.ty);if pushed!=blot_error::Error.none {return pushed;}}}for predicate in body.predicates {{let pushed=auxiliary_roots.types.append([predicate.value.ty,predicate.value.other,predicate.value.result,predicate.value.signature]);if pushed!=blot_error::Error.none {return pushed;}}}{let pushed=rows.append(body.closed_rows);if pushed!=blot_error::Error.none {return pushed;}}let owner .= body.auxiliary;if owner {{ let propagated_error = owner.transform(auxiliary_roots); if propagated_error != blot_error::Error.none { return propagated_error; } }}}
