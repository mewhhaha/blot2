fn constantRequirements(self: ClosureRegion&,root: Target) -> bool,Error { let cache=self.session.specializations.call_summaries.constant_requirements; if cache.contains(root) { return true,Error.none; } if cache.count>=self.session.options.max_values { return false,Error.none; } var pending: HeaderVisit[>..<]=[]; var visited: dictionary<Target,bool>; pending.push(HeaderVisit {root}); visited.insert(root,false); var edges=0; while pending.len!=0 { let last=pending.len-1; let frame=pending[last]; let module=self.session.units[frame.target.unit]; let scheme=module.binding(frame.target.binding).scheme; if frame.next==scheme.obligations.len { visited.insert(frame.target,true); pending.resize(last); continue; } pending[last].next++; edges++; if edges>self.session.options.max_children { return false,Error.none; } let requirement=module.obligations[scheme.obligations.start+frame.next]; if requirement.kind==blot_check_types::ObligationKind.callee_use { let child,error=schemeTarget(self,frame.target.unit,requirement.identity); if error!=Error.none { return false,error; } if !self.session.units[child.unit].binding(child.binding).has_explicit||cache.contains(child) { continue; } let done=visited.get(child); if done { if !done { return false,Error.none; } continue; } if visited.count>=self.session.options.max_values { return false,Error.none; } visited.insert(child,false); pending.push(HeaderVisit {child}); } else if requirement.explicit { for operand in [requirement.ty,requirement.other,requirement.result,requirement.signature] { if operand!=0&&operand==requirement.signature&&autonomousRowCarrier(self,frame.target,requirement) { continue; } if operand!=0 { let closed,error=self.session.specializations.closed_source_types.closed(self.session.units,frame.target.unit,operand,0); if error!=Error.none||!closed { return false,error; } } } } } var room=self.session.options.max_values-cache.count; if room<0 { room=0; } if visited.count>room { return false,Error.none; } for entry in vi