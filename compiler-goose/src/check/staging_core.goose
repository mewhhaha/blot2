struct CollectionProof {reader:Named&,closed:List}
fn same(self:CollectionProof,first:u32,second:u32)->Error {return requireEqual(self.reader.m,first,second,self.reader.remaining);}
fn callback(self:CollectionProof,row:u32)->Error {return require(self.reader.ownedTail(row,self.closed) && self.reader.m.types.rowLabels(row).len==0);}
fn collection(self:CollectionProof,sequence:u32,element:u32)->Error {return Error.invalid_artifact;}
