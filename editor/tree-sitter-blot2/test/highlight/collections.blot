const size = func values => return values.length
// <- keyword.storage.type
//    ^^^^ function
//           ^^^^ keyword.function
//                ^^^^^^ variable.parameter
//                                       ^^^^^^ variable.other.member

const update = func values => return do:
  values[0] := 6
//^^^^^^ variable
//      ^ punctuation.bracket
//       ^ constant.numeric.integer
//          ^^ operator
  values[0].position.x := self + 1
//          ^^^^^^^^ variable.other.member
//                   ^ variable.other.member
//                        ^^^^ variable.builtin
  break values.get(0)
//       ^^^^^^ variable
//              ^^^ function.method

const contains = func tail => return func witness => return tail.contains(witness)
//                                                              ^^^^^^^^ function.method
const bound = func tail => return tail.contains
//                                    ^^^^^^^^ variable.other.member
