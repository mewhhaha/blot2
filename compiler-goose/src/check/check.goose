fn Engine::capabilityHeader(self:const Engine&,binding:u32)->blot_support::Option<blot_check_capability_contracts::Recipe> {for entry in self.capability_roots {if entry.binding==binding {return blot_support::some(blot_check_capability_contracts::Recipe{arity:self.bindings[binding].capability_parameters.arity(),root:entry.root,nodes:self.capability_store.nodes.items,words:self.capability_store.words.items});}}return blot_support::none<blot_check_capability_contracts::Recipe>();}
fn Engine::refreshCapabilityRecipe(self:Engine&,binding:u32)->blot_error::Error {let definition=self.bindings[binding];if definition.kind!=Kind.global || !definition.capability_parameters.present() {return blot_error::Error.none;}for &entry in self.capability_roots {if entry.binding!=binding {continue;}let updated,err=blot_check_capability_contract_source::deriveChecked(self.capability_store,self.tree,self.pool,self.tree.value_decl(definition.declaration).body,definition.capability_parameters,self.operation_refs);if err!=blot_error::Error.none {return contractError(err);}if updated.present {entry.root=updated.value;}return blot_error::Error.none;}return blot_error::Error.none;}
