 var remaining:i64=1000000;for node,id in module.types.nodes {if node.tag!=Tag.nominal || !blot_check_typed_staging::isIdentity(node.a,node.b) {continue;}if node.b==blot_check_typed_staging::code_identity.decl {let shape=blot_check_typed_staging::codeInfo(module.types,id as u32);if !shape.present || shape.value.result==0 {return Error.invalid_artifact;}}else {let target=blot_check_typed_staging::descriptorInfo(module.types,id as u32);if !target.present || target.value==0 {return Error.invalid_artifact;}}}
 for node in module.nodes {if node.tag!=CoreTag.staging {continue;}let operation,error=blot_check_typed_staging::opFromCode(node.c);if error!=Error.none {return Error.invalid_artifact;}let input=module.typeOf(node.a);match operation {
 blot_check_typed_staging::Op.evaluate=>{let error=result(module,node.ty,input,remaining);if error!=Error.none {return error;}},blot_check_typed_staging::Op.quote=>{if !blot_check_typed_staging::codeInfo(module.types,node.ty).present {return Error.invalid_artifact;}},
 blot_check_typed_staging::Op.lift=>{let error=result(module,node.ty,input,remaining);if error!=Error.none {return error;}var ownership=blot_check_usage_check::Work{remaining:remaining, ..};let contains_usage,error=blot_check_usage_check::containsNominalWork(module.types,module.nominals,input,ownership);if error!=Error.none {return Error.invalid_artifact;}remaining=ownership.remaining;let liftable,error=blot_check_typed_staging::liftable(module.types,input);if contains_usage || error!=Error.none || !liftable {return Error.invalid_artifact;}},
 blot_check_typed_staging::Op.splice,blot_check_typed_staging::Op.emit,blot_check_typed_staging::Op.run=>{let shape=blot_check_typed_staging::codeInfo(module.types,input);if !shape.present {return Error.invalid_artifact;}let error=result(module,node.ty,shape.value.result,remaining);if error!=Error.none {return error;}if operation==blot_check_typed_staging::Op.run {let row=module.types.effects.node(shape.value.effects);if row.labels.len!=0 || row.tail!=blot_check_effects::Tail.closed {return Error.invalid_artifact;}}},
 blot_check_typed_staging::Op.same=>{if node.ty!=blot_check_types::boolean || !blot_check_typed_staging::descriptorInfo(module.types,input).present || !blot_check_typed_staging::descriptorInfo(module.types,module.typeOf(node.b)).present {return Error.invalid_artifact;}},
 blot_check_typed_staging::Op.fields=>{let target=blot_check_typed_staging::descriptorInfo(module.types,input);if !target.present {return Error.invalid_artifact;}let error=descriptorFields(module,target.value,module.types.node(node.ty),remaining);if error!=Error.none {return error;}},
 blot_check_typed_staging::Op.describe=>{let shape=blot_check_typed_staging::codeInfo(module.types,input);if !shape.present {return Error.invalid_artifact;}let output=module.types.node(node.ty);if output.tag!=Tag.record || output.b!=2 {return Error.invalid_artifact;}var found_result=false;var found_effects=false;for index in 0..2 {let field=module.types.recordField(output,index);let name=module.fieldSpelling(field.name);if !name.present {return Error.invalid_artifact;}if name.value=="result" {if found_result {return Error.invalid_artifact;}found_result=true;let target=blot_check_typed_staging::descriptorInfo(module.types,field.ty);if !target.present {return Error.invalid_artifact;}let error=requireEqual(module,shape.value.result,target.value,remaining);if error!=Error.none {return error;}}else {if name.value!="effects" || found_effects {return Error.invalid_artifact;}found_effects=true;let effect=module.types.node(field.ty);if effect.tag!=Tag.nominal || effect.a!=blot_check_types::effect_set_identity.unit || effect.b!=blot_check_types::effect_set_identity.decl || module.types.nominalArguments(effect).len!=0 {return Error.invalid_artifact;}}}if !found_result || !found_effects {return Error.invalid_artifact;}},
