// Pointer-linked binary tree in a flat U32-indexed node pool (12 bytes/node).
// Children are pushed before their parent (post-order), matching tree.goose.
import * as rng from "./rng"

const BENCH_N: U32 = 20 // BENCH_N
const PASSES: U32 = 8
const NONE: U32 = 0xFFFFFFFF

type TNode is data = $TNode { v: U32, l: U32, r: U32 }

func build_rec (pool: own #[TNode]) -> (d: U32) -> (seed: U64): (#[TNode], U32) =>
  let v1000 = (seed % 1000u64).to_u32
  if d == 0:
    let idx = pool.length
    pool := self.push ($TNode { v: v1000, l: NONE, r: NONE })
    return (pool, idx)
  let (p1, l) = build_rec pool (d - 1) (rng.xs_next seed)
  let (p2, r) = build_rec p1 (d - 1) (rng.xs_next (seed + 1u64))
  let idx = p2.length
  let p3 = p2.push ($TNode { v: v1000, l, r })
  return (p3, idx)

func sum_rec (pool: #[TNode]) -> (idx: U32) -> (p: U32): I64 =>
  let nd = pool[idx]
  let acc = (nd.v ^ p).to_i64
  if nd.l == NONE:
    return acc
  return acc + sum_rec pool nd.l p + sum_rec pool nd.r p

io bench (): #[U32] =>
  let cap: U32 = (1 << (BENCH_N + 1)) - 1
  let (pool, root) = build_rec (Array.with_capacity cap) BENCH_N 12345u64
  let total: I64 = 0i64
  for p in 0 .. PASSES:
    total := self + sum_rec pool root p

  let out: #[U32] = #[]
  out := rng.emit_u32 self pool.length
  out := rng.emit_i64 self total
  return out
