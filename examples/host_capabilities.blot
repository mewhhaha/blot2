// Executable scalar-callback port of the host-capability proposal.
// Capability records are guest values, not composite arguments in the host ABI.
// Title and frame numbers stand in for the proposed Text and RenderFrame ABI.

type WindowIo is data = $WindowIo { set_title: U32 -> U32 ! {Foreign} }
type RenderIo is data = $RenderIo { submit: U32 -> U32 ! {Foreign} }
type Io is data = $Io { window: WindowIo, render: RenderIo }

const title = func window => return do:
  let $WindowIo { set_title } = window
  use status <- set_title 7
  break status

// Only rendering authority reaches this function, not the whole Io bundle.
const render_frame = func render => return func frame => return do:
  let $RenderIo { submit } = render
  use status <- submit frame
  break status

const launch = func io => return do:
  let $Io { window, render } = io
  use status <- title window
  if status != 0:
    break status
  use rendered <- render_frame render 42
  break rendered

// The single host callback uses disjoint scalar command ranges. The wrappers
// grant only the specific operations needed by each guest capability record.
entry const main = func (dispatch: U32 -> U32 ! {Foreign}) => return do:
  let set_title = func title_id => return do:
    if title_id >= 1000:
      break 1
    use status <- dispatch (1000 + title_id)
    break status
  let submit = func frame => return do:
    if frame >= 1000:
      break 1
    use status <- dispatch (2000 + frame)
    break status
  use status <- launch ($Io {
    window: $WindowIo { set_title },
    render: $RenderIo { submit },
  })
  break status

entry const render_only = func (submit: U32 -> U32 ! {Foreign}) => return
  render_frame ($RenderIo { submit }) 42

entry const uses_host = @effect.has (@effect.of main) Foreign
