// Scalar cursors retain no AST or pooled-run slice across recursive lowering.
struct ResolverStatements {source:u32=0,start:i64=0,len:i64=0,pooled:bool=false}
fn resolverSourceStatements(self_:const Builder&,source:u32)->ResolverStatements {return ResolverStatements{source:source,len:self_.source.tree.children(source).len,..};}
