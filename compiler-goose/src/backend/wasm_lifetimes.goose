struct SharedScan {state:blot_support::Option<Analysis> =blot_support::none<Analysis>()}
fn deinit(self_:SharedScan&) {if self_.state.present {self_.state.value.deinit();}self_=SharedScan{..};}
fn invalidate(self_:SharedScan&) {self_.deinit();}
fn analysis(self_:SharedScan&,module:const Module&,function:const Function&,summaries:const Summaries&)->Analysis?,Error {if self_.state.present {return self_.state.value,blot_error::Error.none;}let created,error=initAnalysis(summaries,function,AnalysisMode.temporaries);if error!=blot_error::Error.none {return null,error;}self_.state=blot_support::some(created);let error=self_.state.value.scan(module,function,summaries);if error!=blot_error::Error.none {self_.deinit();return null,error;}return self_.state.value,blot_error::Error.none;}
