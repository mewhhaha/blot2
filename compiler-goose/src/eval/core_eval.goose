struct StartupDependencies { selected: BindingRef[:],complete: bool }
struct SolvedEvidence { types: Mapping[:]=default<Mapping[:]>(),rows: RowMapping[:]=default<RowMapping[:]>(),selected: BindingRef[:]=default<BindingRef[:]>() }
struct ReceiptJudgment { matched: bool=true,solved: SolvedEvidence }
reusable[] var solved_types: Mapping[>..]=[];
reusable[] var solved_rows: RowMapping[>..]=[];
reusable[] var solved_selected: BindingRef[>..]=[];
fn deinit(self_: SolvedEvidence&) { solved_types.free_slice(self_.types); solved_rows.free_slice(self_.rows); solved_selected.free_slice(self_.selected); self_.types=default<Mapping[:]>(); self_.rows=default<RowMapping[:]>(); self_.selected=default<BindingRef[:]>(); }
fn deinit(self_: StartupDependencies&) { solved_selected.free_slice(self_.selected); self_.selected=default<blot_eval_core_eval::BindingRef[:]>(); }
fn deinit(self_: ReceiptJudgment&) { deinit(self_.solved); }
fn clone(self_: SolvedEvidence) -> SolvedEvidence,Error { let types=solved_types.alloc_slice(self_.types.len); let rows=solved_rows.alloc_slice(self_.rows.len); let selected=solved_selected.alloc_slice(self_.selected.len); for x,i in self_.types { types[i]=x; } for x,i in self_.rows { rows[i]=x; } for x,i in self_.selected { selected[i]=x; } return SolvedEvidence {types,rows,selected},blot_error::Error.none; }
struct DispatchCandidate { side: blot_reuse_dispatch_explanation::Side,operand: u32,outcome: blot_reuse_dispatch_explanation::Outcome }
enum DispatchContextKind { left_operand,right_operand }
struct DispatchContext { kind: DispatchContextKind,unit: u32,span: Span }
struct DispatchRecord {
 op: blot_check_types::Operator=blot_check_types::Operator.none,member: u32=0,
 candidates: DispatchCandidate[3]=[DispatchCandidate {blot_reuse_dispatch_explanation::Side.left,0,blot_reuse_dispatch_explanation::Outcome.no_member};3],len: u8=0,
 contexts: DispatchContext[2]=[DispatchContext {DispatchContextKind.left_operand,0,Span {0,0}},DispatchContext {DispatchContextKind.right_operand,0,Span {0,0}}],context_len: u8=0
}
fn add(self_: DispatchRecord&,side: blot_reuse_dispatch_explanation::Side,operand: u32,outcome: blot_reuse_dispatch_explanation::Outcome) { if self_.len==3 { return; } self_.candidates[self_.len]=DispatchCandidate {side,operand,outcome}; self_.len++; }
fn items(self_: const DispatchRecord&) -> const DispatchCandidate[:] { return self_.candidates[..self_.len]; }
fn sourceInvocationOrigin(previous: blot_support::Option<SourceLocation>,entry: u32,caller: u32,span: Span,dependent: bool) -> blot_support::Option<SourceLocation> {
 if caller==entry { if previous.present { return previous; } return blot_support::some(SourceLocation {caller,span}); } if dependent { return previous; } return blot_support::some(SourceLocation {caller,span});
}
recursive fn callerDependent(source: const blot_check_core::Types&,ty: u32,depth: i64) -> bool {
 if ty==0||depth>=256 { return false; } let n=source.node(ty); let tag=n.tag;
 if tag==blot_check_types::Tag.function||tag==blot_check_types::Tag.provider { for label in source.rowLabels(n.c) { for argument in source.operationArguments(label) { if callerDependent(source,argument,depth+1) { return true; } } } }
 if tag==blot_check_types::Tag.variable||tag==blot_check_types::Tag.bound { return true; }
 if tag==blot_check_types::Tag.usage||tag==blot_check_types::Tag.forall { return callerDependent(source,n.a,depth+1); }
 if tag==blot_check_types::Tag.function||tag==blot_check_types::Tag.provider { return callerDependent(source,n.a,depth+1)||callerDependent(source,n.b,depth+1); }
 if tag==blot_check_types::Tag.array||tag==blot_check_types::Tag.list||tag==blot_check_types::Tag.cursor||tag==blot_check_types::Tag.resolver { return callerDependent(source,n.a,depth+1); }
 if tag==blot_check_types::Tag.state_provider { return callerDependent(source,n.a,depth+1)||callerDependent(source,n.b,depth+1)||callerDependent(source,n.c,depth+1); }
 if tag==blot_check_types::Tag.product { for child in source.list(blot_check_types::List {n.a,n.b}) { if callerDependent(source,child,depth+1) { return true; } } }
 else if tag==blot_check_types::Tag.record { for index in 0..n.b { if callerDependent(source,source.recordField(n,index).ty,depth+1) { return true; } } }
 else if tag==blot_check_types::Tag.nominal { for child in source.nominalArguments(n) { if callerDependent(source,child,depth+1) { return true; } } } return false;
}
fn callerDependentUse(module: const Module&,id: u32) -> bool {
 let n=module.node(id); if n.tag==blot_check_core::Tag.call { for arg in module.children(id) { if callerDependent(module.types,module.typeOf(arg),0) { return true; } } }
 else if n.tag==blot_check_core::Tag.apply { return callerDependent(module.types,module.typeOf(n.b),0); }
 else if n.tag==blot_check_core::Tag.associated||n.tag==blot_check_core::Tag.scalar { return callerDependent(module.types,module.typeOf(n.a),0)||callerDependent(module.types,module.typeOf(n.b),0); }
 else if n.tag==blot_check_core::Tag.project { return callerDependent(module.types,module.typeOf(n.a),0); } else if n.tag==blot_check_core::Tag.result_associated { return callerDependent(module.types,n.ty,0); } return false;
}
fn obligationDependent(source: const blot_check_core::Types&,obligation: blot_check_core::Obligation) -> bool {
 if obligation.kind==blot_check_types::ObligationKind.dispatch { return callerDependent(source,obligation.ty,0)||callerDependent(source,obligation.other,0); }
 if obligation.kind==blot_check_types::ObligationKind.result_dispatch { return callerDependent(source,obligation.result,0); }
 return callerDependent(source,obligation.ty,0)||callerDependent(source,obligation.other,0)||callerDependent(source,obligation.result,0);
}
struct Diagnostic { unit: u32,span: Span,code: Code,detail: const u8[:]="",tag_origin: bool=false,related: blot_support::Option<SourceLocation> =blot_support::none<SourceLocation>(),origins: blot_check_staging_origins::Trace=blot_check_staging_origins::Trace {},dispatch: blot_support::Option<DispatchRecord> =blot_support::none<DispatchRecord>(),implementation_trace: blot_support::Option<blot_eval_implementation_trace::Record> =blot_support::none<blot_eval_implementation_trace::Record>() }
fn message(self_: Diagnostic) -> const u8[:] { return blot_check_diagnostic_code::message(self_.code,self_.detail); }
