fn getInner(self: PrincipalQueries&,key: PrincipalGraphKey,session: const Session&) -> PrincipalAnswer {
 if self.owner!=session.owner_id||self.units!=unitsIdentity(session)||self.unit_count!=session.units.len { return PrincipalAnswer {}; } if self.claim==PrincipalClaim.source_description&&self.declines.contains(key) { return PrincipalAnswer {found:true}; }
 let adapter=PrincipalAdapter {self.claim}; var cursor=self.table.candidates(adapter.fingerprint(PrincipalQueryKey {key,self.claim,self.force_collision}),blot_reuse_semantic_query_table::Order.oldest_first); var remaining=self.lookup_budget;
 loop { let position=cursor.next(); if !position.present { break; } if !inspect(self,remaining,false) { return PrincipalAnswer {}; } let record=self.table.records[position.value]; if record.key.source!=key { continue; } var valid=true;
  for fact,index in record.dependencies.plain { if !inspect(self,remaining,true) { return PrincipalAnswer {}; } if !fact.read { continue; } var actual=blot_support::none<bool>(); let known=session.specializations.plain_nominals.get(fact.key); if known { actual=blot_support::some(known); } if record.dependencies.has_writes { var prior=index; while prior!=0 { prior--; if !inspect(self,remaining,true) { return PrincipalAnswer {}; } let write=record.dependencies.plain[prior]; if !write.read&&write.key==fact.key { actual=blot_support::some(write.plain); break; } } } if fact.present { valid=valid&&actual.present&&actual.value==fact.plain; } else { valid=valid&&!actual.present; } if !valid { break; } }
