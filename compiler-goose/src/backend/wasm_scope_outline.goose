fn tryExtract(self_:Context&,ticket:Ticket,after:Work)->blot_support::Option<Credit>,Error {let selected=self_.rootIndex(ticket.function);if !selected.present {return blot_support::none<Credit>(),blot_error::Error.none;}if self_.finalized {return blot_support::none<Credit>(),blot_error::Error.invalid_outline;}let module .= self_.target();let source=module.functions[ticket.function];let code=blot_backend_wasm::instructions(module,source);if ticket.start>code.len || after.expressions<ticket.work.expressions || after.layouts<ticket.work.layouts {return blot_support::none<Credit>(),blot_error::Error.invalid_outline;}for entry in self_.roots.items[selected.value].pending.table.slots {if entry.tag!=0 && entry.key>=ticket.start {return blot_support::none<Credit>(),blot_error::Error.none;}}let length=code.len-ticket.start;if length==0 || length<self_.options.minimum_instructions || length>self_.options.maximum_range_instructions || self_.helpers.len>=self_.options.maximum_helpers || hasCoordinates(module,ticket.function) {return blot_support::none<Credit>(),blot_error::Error.none;}var uses:dictionary<u32,Use> = dictionary<u32,Use> {};var inputs:dictionary<u32,bool> = dictionary<u32,bool> {};let accepted,error=analyzeProof(module,source,code[ticket.start..],self_.options.maximum_control_depth,uses,inputs);if error!=blot_error::Error.none || !accepted {return blot_support::none<Credit>(),error;}let error=self_.sync(selected.value);if error!=blot_error::Error.none {return blot_support::none<Credit>(),error;}var provisional:dictionary<u32,u32> = dictionary<u32,u32> {};for entry in uses.slots {if entry.tag==0 {continue;}let id=entry.key;let total=self_.roots.items[selected.value].totals.items[id];if id<source.parameters.len || total.references>entry.val.references || (::contains(inputs,id) && total.writes!=0) {::insert(provisional,id,(self_.options.maximum_globals-1) as u32);}}let created,error=prepareBody(module,source,code[ticket.start..],false,GlobalMap.sparse{map:provisional