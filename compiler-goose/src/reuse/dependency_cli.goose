struct Metrics {frontend_us:i64=0,freeze_us:i64=0,frontend_teardown_us:i64=0,encode_us:i64=0,decode_us:i64=0,validation_us:i64=0,source_us:i64=0,relink_us:i64=0,compile_us:i64=0,source_bytes:i64=0,artifact_bytes:i64=0,wasm_bytes:i64=0,modules:i64=0,cached_modules:i64=0,fresh_modules:i64=0,dictionary:i64=0,syntax_nodes:i64=0,body_elaborations:i64=0,body_lowerings:i64=0,interface_bytes:i64=0,core_bytes:i64=0,interface_bindings:i64=0,interface_global_bindings:i64=0}
fn jsonStringify(self_:Metrics,writer:blot_json::Writer&)->Error {return blot_json::jsonStringify(self_,writer);}
fn elapsed(start:u64)->i64 {let now=blot_native::clock_ns();if now<start {return 0;}return ((now-start)/1000) as i64;}
fn payloadMetrics(value:const Frozen&,metrics:Metrics&) {metrics.modules=value.modules.len;metrics.dictionary=value.symbols.len;for module in value.modules {metrics.interface_bytes+=blot_reuse_payload_bytes::bytes(module.interface);metrics.core_bytes+=blot_reuse_payload_bytes::bytes(module.core);metrics.interface_bindings+=module.interface.bindings.len;for binding in module.interface.bindings {if binding.kind==blot_reuse_principal_interface::Kind.global || binding.kind==blot_reuse_principal_interface::Kind.external {metrics.interface_global_bindings++;}}}}
fn word(hash:blot_support_blake3::State&,value:u64) {var bytes:u8[8]=[0;8];for index in 8 {bytes[index]=(value>>(index*8)) as! u8;}hash.update(bytes);}
fn text(hash:blot_support_blake3::State&,value:const u8[:]) {word(hash,value.len as u64);hash.update(value);}
fn settings(options:Options)->Digest {
    var hash=blot_support_blake3::init();text(hash,"blotc-dependencies-v4:selected-implementations:module-visibility:opaque-nominals:project:default-check-and-backend:generic-core:no-evaluated-values:ordered-dictionary");let prelude=selectedSetting(options.prelude_path);text(hash,prelude);let root=selectedSetting(options.std_root);text(hash,root);word(hash,options.aliases.len as u64);for alias in options.aliases {text(hash,alias.prefix);text(hash,alias.root);}word(hash,options.max_source_bytes as u64);word(hash,options.max_total_source_bytes as u64);word(hash,options.max_files as u64);return hash.final();
}
reusable[] var aliases:Alias[>..]=[];
struct CanonicalOptions {prelude_path:Text=blot_support::none<const u8[:]>(),std_root:Text=blot_support::none<const u8[:]>(),aliases:Alias[:]=default<Alias[:]>(),owner:blot_reuse_dependency_payload::Owner=blot_reuse_dependency_payload::Owner{..}}
fn initCanonical(options:Options)->CanonicalOptions,Error {var result=CanonicalOptions{..};let owner,error=blot_reuse_dependency_payload::init();if error!=blot_error::Error.none {return result,error;}result.owner=owner;let error=result.populate(options);if error!=blot_error::Error.none {result.deinit();return CanonicalOptions{..},error;}return result,blot_error::Error.none;}
fn canonicalOwned(self_:CanonicalOptions&,raw:const u8[:])->const u8[:],Error {var input=blot_reuse_project::FileInputs{..};var bytes:u8[>..<]=[];let error=input.canonical(raw,bytes);if error!=blot_error::Error.none {return default<const u8[:]>(),error;}return self_.owner.copy(bytes[..]);}
fn populate(self_:CanonicalOptions&,options:Options)->Error {if options.input_mode!=blot_reuse_project::InputMode.project {return blot_error::Error.input_mode_unsupported;}if options.prelude_path.present {let value,error=self_.canonicalOwned(options.prelude_path.value);if error!=blot_error::Error.none {return error;}self_.prelude_path=blot_support::some(value);}if options.std_root.present {let value,error=self_.canonicalOwned(options.std_root.value);if error!=blot_error::Error.none {return error;}self_.std_root=blot_support::some(value);}self_.aliases=aliases.alloc_slice(options.aliases.len);for &alias in self_.aliases {alias=Alias{prefix:default<const u8[:]>(),root:default<const u8[:]>()};}for alias,index in options.aliases {let root,error=self_.canonicalOwned(alias.root);if error!=blot_error::Error.none {return error;}self_.aliases[index]=Alias{alias.prefix,root};}return blot_error::Error.none;}
fn view(self_:const CanonicalOptions&,raw:Options)->Options {var result=raw;result.prelude_path=self_.prelude_path;result.std_root=self_.std_root;result.aliases=self_.aliases;return result;}
fn deinit(self_:CanonicalOptions&) {if self_.aliases.len!=0 {aliases.free_slice(self_.aliases);}self_.owner.deinit();self_=CanonicalOptions{..};}
// A failed write removes only its own exclusive temporary file. Replacement
// happens after the complete bytes and sync, preserving the old destination.
fn publish(output:const u8[:],bytes:const u8[:])->Error {
    for byte in output {if byte==0 {return blot_error::Error.invalid_path;}}var target:u8[>..]=[];target.append(output);target.push(0);var temporary:u8[>..<]=[];var fd:i32=-1;
    for attempt in 16 {temporary.clear();temporary.append(output);temporary.append(".tmp.");format(temporary,blot_native::process_id());temporary.push('.');format(temporary,blot_native::random_u64());temporary.push(0);fd=blot_native::open_write(temporary[0],true);if fd>=0 {break;}if fd != -17 {return blot_error::Error.io;}}
    if fd<0 {return blot_error::Error.io;}var error=blot_io::write_all(blot_io::Writer{fd},bytes);if error==blot_error::Error.none && blot_native::sync(fd)<0 {error=blot_error::Error.io;}let closed=blot_native::close(fd);if error==blot_error::Error.none && closed<0 {error=blot_error::Error.io;}if error==blot_error::Error.none && blot_native::rename_file(temporary[0],target[0])<0 {error=blot_error::Error.io;}if error!=blot_error::Error.none {blot_native::remove_file(temporary[0]);}return error;
}
fn existingOutput(output:const u8[:],owned:u8[>..<]&)->bool,Error {var input=blot_reuse_project::FileInputs{..};let error=input.canonical(output,owned);if error==blot_error::Error.file_not_found {return false,blot_error::Error.none;}if error!=blot_error::Error.none {return false,error;}return true,blot_error::Error.none;}
fn emit<T,S>(stream:S&,value:T)->Error {var bytes:u8[>..]=[];var writer=blot_json::Writer{out:bytes,options:blot_json::Options{..},..};writer.beginObject();const for <N,A> in fields<T> {writer.field(N,value.A);}writer.endObject();if writer.failure!=blot_error::Error.none {return writer.failure;}bytes.push('\n');return stream.writeAll(bytes[..]);}
struct DiagnosticWire {kind:const u8[:]="diagnostic",filename:const u8[:],stage:const u8[:],unit:u32,code:const u8[:],start:u32,end:u32,message:const u8[:]}
fn frontend<T,S>(writer:S&,filename:const u8[:],unit:u32,stage:const u8[:],source:const u8[:],publication:blot_parse_syntax_diagnostics::Publication,details:T)->Error {var issue,error=blot_reuse_dependency_consumer::publishedDiagnostic(unit,stage,source,publication,details);if error!=blot_error::Error.none {return error;}let result=issue.write(writer,filename);issue.deinit();return result;}
fn sourceDiagnostic<S>(writer:S&,source:Project&,entry:const u8[:])->Error {let issue=source.diagnostics.items[0];var filename=entry;if issue.unit!=0 {filename=source.filename(issue.unit);}if issue.publication.present {let unit .= source.unit(issue.unit);if issue.parse_code.present {return frontend(writer,filename,issue.unit,"parse-project",unit.source,issue.publication.value,unit.tree.diagnostics.items);}return frontend(writer,filename,issue.unit,"parse-project",unit.source,issue.publication.value,issue.lexical_details);}return emit(writer,DiagnosticWire{filename:filename,stage:"parse-project",unit:issue.unit,code:issue.codeName(),start:issue.span.start,end:issue.span.end,message:issue.message(),..});}
fn checkDiagnostic<S>(writer:S&,source:Project&,entry:const u8[:],issue:blot_reuse_project_check::Diagnostic)->Error {var preparation,error=blot_reuse_partial_dependency::rejectChecked(source,entry,issue);if error!=blot_error::Error.none {return error;}var failure=blot_error::Error.none;match preparation {rejected payload=>{assert(payload.value.result.diagnostic.present);var filename=entry;if payload.value.diagnostic_filename.present {filename=payload.value.diagnostic_filename.value;}failure=payload.value.result.diagnostic.value.write(writer,filename);},_=>{abort("checker diagnostic did not reject");}}preparation.deinit();return failure;}
enum Creation {inactive,rejected,ready{frozen:OwnedFrozen,key:blot_reuse_dependency_format::Key}}
fn createFrontend<E,S>(executor:E&,writer:S&,entry:const u8[:],output:const u8[:],options:Options,compiler:Digest,metrics:Metrics&)->Creation,Error {
    let at=blot_native::clock_ns();var source,error=blot_reuse_project::load(entry,options);if error!=blot_error::Error.none {return Creation.inactive,error;}if source.diagnostics.len!=0 {let error=sourceDiagnostic(writer,source,entry);source.deinit();return Creation.rejected,error;}
    var checked,error=blot_reuse_project_check::checkProject(executor,source);if error!=blot_error::Error.none {source.deinit();return Creation.inactive,error;}if checked.diagnostics.len!=0 {let error=checkDiagnostic(writer,source,entry,checked.diagnostics[0]);checked.deinit();source.deinit();return Creation.rejected,error;}
    metrics.frontend_us=elapsed(at);metrics.source_bytes=source.source_bytes;for unit in source.units.items {metrics.syntax_nodes+=unit.tree.nodes.len-1;}for module in checked.modules {assert(module.present);metrics.body_elaborations+=module.value.checked.body_elaborations;}
    let freeze_start=blot_native::clock_ns();var frozen,error=blot_reuse_dependency_closure::freeze(executor,source,checked);if error!=blot_error::Error.none {checked.deinit();source.deinit();return Creation.inactive,error;}metrics.freeze_us=elapsed(freeze_start);payloadMetrics(frozen.value,metrics);for module in frozen.value.modules {metrics.body_lowerings+=module.core.body_lowerings;}
    let key,error=blot_reuse_dependency_closure::sourceKey(compiler,settings(options),source);if error!=blot_error::Error.none {frozen.deinit();checked.deinit();source.deinit();return Creation.inactive,error;}var destination:u8[>..<]=[];let exists,error=existingOutput(output,destination);if error!=blot_error::Error.none {frozen.deinit();checked.deinit();source.deinit();return Creation.inactive,error;}if exists {for unit in source.units.items {if destination==source.symbols.get(unit.filename) {frozen.deinit();checked.deinit();source.deinit();return Creation.inactive,blot_error::Error.output_is_source;}}}
    let teardown=blot_native::clock_ns();checked.deinit();source.deinit();metrics.frontend_teardown_us=elapsed(teardown);return Creation.ready{frozen,key},blot_error::Error.none;
}
fn work<E,S>(executor:E&,workspace:Workspace&,writer:S&,create:bool,entry:const u8[:],output:const u8[:],artifact:Text,raw_options:Options,compiler:Digest,metrics:Metrics&,backend_options:CompileOptions=CompileOptions{..})->bool,Error {
    var canonical,error=initCanonical(raw_options);if error!=blot_error::Error.none {return false,error;}let result,failure=workCanonical(executor,workspace,writer,create,entry,output,artifact,canonical.view(raw_options),compiler,metrics,backend_options);canonical.deinit();return result,failure;
}
fn workCanonical<E,S>(executor:E&,workspace:Workspace&,writer:S&,create:bool,entry:const u8[:],output:const u8[:],artifact:Text,options:Options,compiler:Digest,metrics:Metrics&,backend_options:CompileOptions)->bool,Error {
