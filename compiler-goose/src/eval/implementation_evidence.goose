struct BucketsMap { count: i64=0,slots: dictionary_slot<u64,u32>[:]=[] }
reusable[] var pool_BucketsMap: dictionary_slot<u64,u32>[>..]=[];
fn get(self: const BucketsMap&,key: u64) -> u32? { let view=blot_support_pooled_map::Map<u64,u32> {count:self.count,slots:self.slots}; return blot_support_pooled_map::get(view,key); }
fn contains(self: const BucketsMap&,key: u64) -> bool { return self.get(key)!=null; }
fn insert(self: BucketsMap&,key: u64,value: u32) { var view=blot_support_pooled_map::Map<u64,u32> {count:self.count,slots:self.slots}; blot_support_pooled_map::insert(view,key,value,pool_BucketsMap); self.count=view.count; self.slots=view.slots; }
fn clear(self: BucketsMap&) { for &slot in self.slots { slot.tag=0; } self.count=0; }
fn release(self: BucketsMap&) { if self.slots.len!=0 { pool_BucketsMap.free_slice(self.slots); } self.slots=[]; self.count=0; }
fn restore(self: BucketsMap&,slots: const dictionary_slot<u64,u32>[:],count: i64) { release(self); self.count=count; if slots.len!=0 { self.slots=pool_BucketsMap.alloc_slice(slots.len); for slot,index in slots { self.slots[index]=slot; } } }
struct FactsMap { count: i64=0,slots: dictionary_slot<FactKey,u32>[:]=[] }
reusable[] var pool_FactsMap: dictionary_slot<FactKey,u32>[>..]=[];
