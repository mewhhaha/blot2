// Word frequency counting: generate skewed text into a byte buffer,
// split into packed (start, len) spans, and count in an open-addressed hash table.
import * as rng from "./rng"

const BENCH_N: U32 = 2000000 // BENCH_N

type Slot is data = $Slot { packed: U32, count: U32 }

func next_pow2 (v: U32): U32 =>
  let p: U32 = 16
  for ever:
    if p >= v:
      break
    p := self << 1
  return p

func hash_span (buf: #[U8]) -> (start: U32) -> (len: U32): U64 =>
  let h: U64 = rng.FNV_OFFSET
  for i in 0 .. len:
    h := rng.fnv_step self buf[start + i]
  return h

func eq_span (buf: #[U8]) -> (a: U32) -> (b: U32) -> (len: U32): Bool =>
  for i in 0 .. len:
    if buf[a + i] != buf[b + i]:
      return false
  return true

func build_text (vocab: U32): (#[U8], U32) =>
  let r: U64 = 12345
  let dict: #[U8] = #[]
  let dict_spans = @array.fill vocab 0

  for i in 0 .. vocab:
    r := rng.xs_next self
    let n = 3 + rng.xs_mod r 12
    let start = dict.length
    for _ in 0 .. n:
      r := rng.xs_next self
      dict := self.push (97 + rng.xs_mod r 26).to_u8
    dict_spans[i] := (start << 4) | n

  // Pre-size for the expected word lengths, with growth if the estimate is low.
  let text: #[U8] = @array.fill (BENCH_N * 12) (U32.to_u8 0)
  let len: U32 = 0
  for _ in 0 .. BENCH_N:
    r := rng.xs_next self
    let a = rng.xs_mod r vocab
    let k = rng.sq_div_u32 a vocab
    let sp = dict_spans[k]
    let ds = sp >> 4
    let dl = sp & 15
    for j in 0 .. dl:
      let ch = dict[ds + j]
      if len < text.length:
        text[len] := ch
      else:
        text := self.push ch
      len := self + 1
    if len < text.length:
      text[len] := 32
    else:
      text := self.push 32
    len := self + 1
  return (text, len)

io bench (): #[U32] =>
  let vocab = BENCH_N / 10 + 16
  let (text, text_len) = build_text vocab

  // Split text on spaces into packed (start << 4 | len) spans.
  let words = @array.fill BENCH_N 0
  let wcount: U32 = 0
  let wstart: U32 = 0
  for ti in 0 .. text_len:
    if text[ti] == 32:
      if ti > wstart:
        words[wcount] := (wstart << 4) | (ti - wstart)
        wcount := self + 1
      wstart := ti + 1
  if text_len > wstart:
    words[wcount] := (wstart << 4) | (text_len - wstart)
    wcount := self + 1

  // Count in an open-addressed hash table referencing spans in text.
  let nslots = next_pow2 (vocab * 4)
  let mask = nslots - 1
  let slots = @array.fill nslots ($Slot { packed: 0, count: 0 })
  let distinct: U32 = 0

  for wi in 0 .. wcount:
    let wp = words[wi]
    let ws = wp >> 4
    let wl = wp & 15
    let idx = (hash_span text ws wl).to_u32 & mask
    for ever:
      let $Slot { packed: sp, count: sc } = slots[idx]
      if sc == 0:
        slots[idx] := $Slot { packed: wp, count: 1 }
        distinct := self + 1
        break
      let sl = sp & 15
      if sl == wl and eq_span text (sp >> 4) ws wl:
        slots[idx] := $Slot { packed: sp, count: sc + 1 }
        break
      idx := (self + 1) & mask

  let total: I64 = 0
  for si in 0 .. nslots:
    let $Slot { packed: sp, count: sc } = slots[si]
    if sc > 0:
      let ss = sp >> 4
      let sl = sp & 15
      let contrib = sc.to_i64 * (sl.to_i64 + text[ss].to_i64)
      total := self + contrib

  let out: #[U32] = #[]
  out := rng.emit_u32 self wcount
  out := rng.emit_u32 self distinct
  out := rng.emit_i64 self total
  return out
