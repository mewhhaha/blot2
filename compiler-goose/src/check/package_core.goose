fn reachableHeader(self:Walker&,initial:const Module&,binding:u32,wanted:blot_check_core::Obligation,depth:i64)->bool,Error {let solver .= self.scopes.solver;if !solver {return true,Error.none;}let cache .= self.context.source_proofs;if cache && cache.owns(initial) {let result,error=cache.possibleHeader(initial,binding,wanted,depth,self.scopes.remaining);if error!=Error.none {return false,solver.readerError(error);}return result,Error.none;}let origin .= self.origin;let root .= self.module;if origin {root .= origin;}let result,error=reachableHeaderMetadata(catalog(self.context),root,initial,binding,wanted,depth,self.scopes.remaining);if error!=Error.none {return false,solver.readerError(error);}return result,Error.none;}
