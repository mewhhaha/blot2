// Import catalogs, aliases and source diagnostics preserve dependency order.
namespace blot_reuse_project_check;
import .project_check;
fn require(condition:bool)->Error {if !condition {return Error.invalid_artifact;}return Error.none;}
fn appendCatalog(self:Engine&,catalogs:blot_check_check::ImportedCatalog[>..<]&,source_catalogs:blot_check_check::SourceCatalog[>..<]&,producer:CatalogModule,name:u32,namespace_:u32,kind:blot_check_check::ImportedCatalog_kind,index:u32,origin:u32)->Error {
 match producer.owner {
 CatalogOwner.typed payload=>{catalogs.push(blot_check_check::ImportedCatalog{producer:payload.value,name:name,namespace:namespace_,kind:kind,index:index,origin:origin, ..});},
 CatalogOwner.source payload=>{source_catalogs.push(blot_check_check::SourceCatalog{producer:blot_check_check::declarationCatalog(payload.value),declarations:payload.value.declarations,name:name,namespace:namespace_,kind:kind,index:index,origin:origin, ..});},
 CatalogOwner.frozen payload=>{if self.source_validation {source_catalogs.push(blot_check_check::SourceCatalog{producer:producer.catalog(),declarations:self.compiled_catalogs[payload.value.unit-1].declarations,name:name,namespace:namespace_,kind:kind,index:index,origin:origin, ..});}else {catalogs.push(blot_check_check::ImportedCatalog{frozen:payload.value,name:name,namespace:namespace_,kind:kind,index:index,origin:origin, ..});}},
 CatalogOwner.inactive=>{return Error.invalid_artifact;},
 }return Error.none;
}
fn importExport(self:Engine&,imports:blot_check_check::ImportedBinding[>..<]&,headers:blot_check_check::SourceHeader[>..<]&,catalogs:blot_check_check::ImportedCatalog[>..<]&,source_catalogs:blot_check_check::SourceCatalog[>..<]&,producer:CatalogModule,exported:Export,name:u32,namespace_:u32,origin:u32)->Error {
 if exported.kind==ExportKind.value {var local_name=name;var member:u32=0;if namespace_!=0 {local_name=0;member=name;}if self.source_validation {var imported=self.headerImport(exported.target,origin);imported.name=local_name;imported.namespace=namespace_;imported.member=member;headers.push(imported);}else {var imported=self.valueImport(exported.target,origin);imported.name=local_name;imported.namespace=namespace_;imported.member=member;imports.push(imported);}return Error.none;}
 var kind=blot_check_check::ImportedCatalog_kind.nominal;match exported.kind {ExportKind.nominal=>{},ExportKind.constructor=>{kind=blot_check_check::ImportedCatalog_kind.constructor;},ExportKind.effect_family=>{kind=blot_check_check::ImportedCatalog_kind.effect_family;},ExportKind.contract=>{kind=blot_check_check::ImportedCatalog_kind.contract;},ExportKind.implementation=>{kind=blot_check_check::ImportedCatalog_kind.implementation;},ExportKind.value=>{abort("value import uses the binding path");}}
 return self.appendCatalog(catalogs,source_catalogs,producer,name,namespace_,kind,exported.catalog,origin);
}
fn appendDiagnostics(self:Engine&,unit:u32,diagnostics:const blot_check_check::Diagnostic[:])->Error {
 for source in diagnostics {var origin=unit;if source.origin_unit!=0 {origin=source.origin_unit;}var item=Diagnostic{unit:origin,span:source.span,code:Code.semantic,semantic:blot_support::some(source.code),type_application:source.type_application,symbol:source.symbol,implicit_type_witness:source.implicit_type_witness,source_terminator:source.source_terminator,numeric_literal:source.numeric_literal,contexts:source.contexts,context_len:source.context_len, ..};
 if source.purity.present {var witness=source.purity.value;if witness.operation_name.present {witness.operation_name=blot_support::some<const u8[:]>(copyOwned(witness.operation_name.value));}item.purity=blot_support::some(witness);}
 if source.detail.present {item.detail=blot_support::some<const u8[:]>(copyOwned(source.detail.value));}
 if source.hole.present {let hole,error=source.hole.value.clone();if error!=Error.none {item.deinit();return error;}item.hole=blot_support::some(hole);}
 if source.explanation.present {let explanation,error=source.explanation.value.clone();if error!=Error.none {item.deinit();return error;}item.explanation=blot_support::some(explanation);}
 let error=self.diagnostics.push(item);if error!=Error.none {item.deinit();return error;}
 }return Error.none;
}
fn moduleExports<D>(self:Engine&,unit:u32,catalog:blot_check_check::DeclarationCatalog,declarations:const D[:],diagnostics:const blot_check_check::Diagnostic[:],forwarded:const Export[:])->Export[:],Error {
 var exports:Export[>..<]=[];for binding,index in declarations {if binding.kind!=blot_check_check::Kind.global || binding.private {continue;}exports.push(Export{name:binding.name,target:ExternalTarget{unit,index as u32, ..}, ..});}
 for nominal,index in catalog.nominals {if index!=0 && nominal.identity.unit==unit && !nominal.private {exports.push(Export{nominal.name,ExternalTarget{unit,0, ..},ExportKind.nominal,index as u32, ..});}}
 for constructor,index in catalog.constructors {if index!=0 && constructor.identity.unit==unit && !constructor.private {exports.push(Export{constructor.name,ExternalTarget{unit,0, ..},ExportKind.constructor,index as u32, ..});}}
 for family,index in catalog.effect_families {if index!=0 && family.identity.unit==unit && !family.private {exports.push(Export{family.name,ExternalTarget{unit,0, ..},ExportKind.effect_family,index as u32, ..});}}
 for contract,index in catalog.contracts {if contract.identity.unit==unit && !contract.private {exports.push(Export{contract.name,ExternalTarget{unit,0, ..},ExportKind.contract,index as u32, ..});}}
 for implementation,index in catalog.implementations {if implementation.identity.unit==unit && !implementation.private {exports.push(Export{implementation.name,ExternalTarget{unit,0, ..},ExportKind.implementation,index as u32, ..});}}
 exports.append(forwarded);let error=self.appendDiagnostics(unit,diagnostics);if error!=Error.none {return [],error;}return copyOwned(exports[:]),Error.none;
}
fn checkModule(self:Engine&,unit:u32)->Error {let source=self.source.unit(unit);blot_phase_profile::traceModule(unit,self.source.symbols.get(source.filename),source.source.len);let region=blot_phase_profile::region("check.module",unit,0,source.source.len as u32);let error=checkModuleBody(self,unit);region.exit();return error;}
fn checkModuleBody(self:Engine&,unit:u32)->Error {
 let before=self.diagnostics.items.len;let source=self.source.unit(unit);let tree:const blot_parse_ast::Tree&=source.tree;
 var occupied=dictionary<u32,bool>{};var forwarded:Export[>..<]=[];var imports:blot_check_check::ImportedBinding[>..<]=[];var headers:blot_check_check::SourceHeader[>..<]=[];var catalogs:blot_check_check::ImportedCatalog[>..<]=[];var source_catalogs:blot_check_check::SourceCatalog[>..<]=[];var fixities:blot_check_check::ImportedFixity[>..<]=[];
 for root in tree.roots.items {let node=tree.node(root);if node.tag==blot_parse_ast::tag_value_decl || node.tag==blot_parse_ast::tag_data_decl || node.tag==blot_parse_ast::tag_type_alias_decl || node.tag==blot_parse_ast::tag_contract_decl || node.tag==blot_parse_ast::tag_implementation_decl || node.tag==blot_parse_ast::tag_effect_type_decl || node.tag==blot_parse_ast::tag_effect_decl {occupied.insert(node.a,true);}if node.tag==blot_parse_ast::tag_data_decl {for constructor in tree.children(node.b) {occupied.insert(tree.node(constructor).a,true);}}
 if node.tag==blot_parse_ast::tag_value_decl && tree.value_decl(root).exported && unit!=self.source.entry {{ let propagated_error = self.diagnostic(unit,tree.span(root),Code.entry_module); if propagated_error != Error.none { return propagated_error; } }}}
 for imported in self.source.unitImports(unit) {
 let info=tree.import_decl(imported.declaration.node);let forwarding=tree.node(imported.declaration.node).tag==blot_parse_ast::tag_export_decl;
 if info.namespace!=0 {let present=occupied.contains(info.namespace);if !present {occupied.insert(info.namespace,true);}if present {{ let propagated_error = self.diagnostic(unit,info.namespace_span,Code.duplicate_name); if propagated_error != Error.none { return propagated_error; } }continue;}}
 let found=self.catalogModule(imported.target);if !found.present || !found.value.valid {{ let propagated_error = self.diagnostic(unit,imported.span,Code.dependency_failed); if propagated_error != Error.none { return propagated_error; } }continue;}let producer=found.value;
 { let propagated_error = self.appendCatalog(catalogs,source_catalogs,producer,0,0,blot_check_check::ImportedCatalog_kind.catalog,0,imported.declaration.node); if propagated_error != Error.none { return propagated_error; } }
 if info.namespace!=0 {for exported in producer.exports {var original=producer;if exported.kind!=ExportKind.value && exported.target.unit!=0 && exported.target.unit!=imported.target {let current=self.catalogModule(exported.target.unit);assert(current.present);original=current.value;}{ let propagated_error = self.importExport(imports,headers,catalogs,source_catalogs,original,exported,exported.name,info.namespace,imported.declaration.node); if propagated_error != Error.none { return propagated_error; } }}}
 else {for binding in tree.list(info.bindings) {let alias=tree.import_binding(binding);let present=occupied.contains(alias.alias);if !present {occupied.insert(alias.alias,true);}if present {{ let propagated_error = self.diagnostic(unit,tree.span(binding),Code.duplicate_name); if propagated_error != Error.none { return propagated_error; } }continue;}var found=false;
 for exported in producer.exports {if forwarding {if self.resolution_remaining==0 {{ let propagated_error = self.diagnostic(unit,tree.span(binding),Code.resolution_budget); if propagated_error != Error.none { return propagated_error; } }break;}self.resolution_remaining-=1;}if exported.name!=alias.name {continue;}found=true;var original=producer;if exported.kind!=ExportKind.value && exported.target.unit!=0 && exported.target.unit!=imported.target {let current=self.catalogModule(exported.target.unit);assert(current.present);original=current.value;}
 { let propagated_error = self.importExport(imports,headers,catalogs,source_catalogs,original,exported,alias.alias,0,binding); if propagated_error != Error.none { return propagated_error; } }if forwarding {var public=exported;public.name=alias.alias;forwarded.push(public);}}
 if !found {{ let propagated_error = self.diagnostic(unit,tree.span(binding),Code.unknown_export); if propagated_error != Error.none { return propagated_error; } }continue;}
 }}
 }
 if source.implicit_prelude {
 let prelude=self.source.prelude_unit;let found=self.catalogModule(prelude);if !found.present || !found.value.valid {{ let propagated_error = self.diagnostic(unit,Span{0,0, ..},Code.dependency_failed); if propagated_error != Error.none { return propagated_error; } }}
 else {let producer=found.value;{ let propagated_error = self.appendCatalog(catalogs,source_catalogs,producer,0,0,blot_check_check::ImportedCatalog_kind.catalog,0,0); if propagated_error != Error.none { return propagated_error; } }for exported in producer.exports {if occupied.contains(exported.name) {continue;}{ let propagated_error = self.importExport(imports,headers,catalogs,source_catalogs,producer,exported,exported.name,0,0); if propagated_error != Error.none { return propagated_error; } }}
 if self.result.compiledModule(self.source,prelude)!=null {for fixity in self.source.compiled_modules[prelude-1].fixities {if !fixity.named {appendHiddenImport(self,fixity.producer,imports,headers);}var external=blot_support::none<ExternalTarget>();if !fixity.named {external=blot_support::some(fixity.producer);}fixities.push(blot_check_check::ImportedFixity{operator:fixity.operator,target:fixity.target,named:fixity.named,external:external, ..});}}
 else {let prelude_tree:const blot_parse_ast::Tree&=self.source.unit(prelude).tree;for root in prelude_tree.roots.items {if prelude_tree.node(root).tag!=blot_parse_ast::tag_fixity_decl {continue;}let fixity=prelude_tree.fixity(root);let binding=producer.resolved(root);let declaration=producer.declaration(binding);var target=ExternalTarget{prelude,binding, ..};if declaration.external.present {target=declaration.external.value;}if !fixity.named {appendHiddenImport(self,target,imports,headers);}var external=blot_support::none<ExternalTarget>();if !fixity.named {external=blot_support::some(target);}fixities.push(blot_check_check::ImportedFixity{operator:fixity.operator,target:fixity.target,named:fixity.named,external:external, ..});}}
 }}
 if self.prepare_names {return blot_check_check::prepareGeneratedNames(self.source.symbols,tree,catalogs[:]);}
 let context=BodyNameContext{self.slot,self.generation, ..};var options=blot_check_check::ModuleOptions{associated_remaining:self.associated_remaining,purity_origins:moduleOrigins(self.source),builtin_catalog:unit==self.source.prelude_unit,prelude_unit:self.source.prelude_unit,inherited_fixities:fixities[:],body_source:source.source,body_external_names:blot_support::some(blot_reuse_body_check_cache::ExternalNames{context:context,has_unit_origin:true,has_closed_rows:true,has_qualification:true,has_capabilities:true, ..}),producer_capabilities:blot_support::some(blot_check_check::ProducerCapabilities{context:context, ..}),producer_storage:blot_support::some(blot_check_check::ProducerStorage{context:context, ..}), ..};
 match self.editor {Editor.none=>{if self.retain_bodies {options.retained_bodies .= self.result.body_caches[unit-1];}},Editor.query payload=>{options.max_inference_transitions=blot_support::some(payload.value.budget.remaining);if payload.value.unit==unit {options.editor=blot_support::some(payload.value.marker);}}}
 let cached .= blot_support_pooled_map::get(self.previous_bodies,self.source.filename(unit));if cached {let offer=cached;options.previous_bodies .= offer;}
 if self.source_validation {
 let value,error=blot_check_check::validateModuleSource(tree,self.source.symbols,headers[:],source_catalogs[:],unit,options);{ let propagated_error = error; if propagated_error != Error.none { return propagated_error; } }var validation=value;
 if blot_check_check::hasNumericFailure(tree) && validation.diagnostics.len==0 {validation.deinit();return Error.numeric_validation_incomplete;}
 let exports,error=self.moduleExports(unit,blot_check_check::declarationCatalog(validation),validation.declarations,validation.diagnostics,forwarded[:]);if error!=Error.none {validation.deinit();return error;}self.source_modules[unit-1]=blot_support::some(SourceModule{validation,exports,self.diagnostics.items.len==before, ..});return Error.none;
 }
 let value,error=blot_check_check::checkModuleWithPrivateExecution(tree,self.source.symbols,imports[:],catalogs[:],unit,options,self.execution);{ let propagated_error = error; if propagated_error != Error.none { return propagated_error; } }var checked=value;
 match self.editor {Editor.query payload=>{let ignored=payload.value.budget.spend(checked.counters.inference_steps as i64);if checked.initializer_rejected {payload.value.budget.exhausted=true;}for issue in checked.diagnostics {if issue.code==blot_check_check::Code.inference_budget {payload.value.budget.remaining=0;payload.value.budget.exhausted=true;}}},_=>{}}
 if checked.initializer_rejected {let error=self.appendDiagnostics(unit,checked.diagnostics);checked.deinit();return error;}
 let exports,error=self.moduleExports(unit,blot_check_check::declarationCatalog(checked),checked.bindings,checked.diagnostics,forwarded[:]);if error!=Error.none {checked.deinit();return error;}
 self.result.modules[unit-1]=blot_support::some(Module{checked,exports,self.diagnostics.items.len==before, ..});self.result.body_elaborations+=checked.body_elaborations;self.result.imported_schemes+=checked.imported_schemes;self.result.normalization.merge(checked.types.normalization);return Error.none;
}
fn appendHiddenImport(self:Engine&,target:ExternalTarget,imports:blot_check_check::ImportedBinding[>..<]&,headers:blot_check_check::SourceHeader[>..<]&) {if self.source_validation {var imported=self.headerImport(target,0);imported.expose=false;headers.push(imported);}else {var imported=self.valueImport(target,0);imported.expose=false;imports.push(imported);}}
