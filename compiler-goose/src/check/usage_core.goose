// Executable references independently prove moves, captures and loan scopes.
namespace blot_check_usage_core;
import reuse.principal_interface;

import check.capability_contract_core;
import check.capability_contracts;
import check.check_packet_owner;
import check.cleanup_contracts;
import check.closed_nominal_storage;
import check.core;
import check.rank_equal;
import check.task_types;
import check.typed_staging;
import check.types;
import check.usage_check;
import eval.body_recipe;
import support.error;

import support.option;
import .check;
import .task_core;
type Error = blot_error::Error;
type Module = blot_check_core::Module;
type Tag = blot_check_core::Tag;
type TypeTag = blot_check_types::Tag;
type Usage = blot_check_types::UsageKind;
struct State { binding: u32, first: u32 = 0, loan: u32 = 0 }
enum Outcome { live, exit }
struct ExitFrame { target: u32, joined: State[:], seen: bool = false, parent: ExitFrame? = null }
struct StageEnvironment { states: State[:], regions: const u32[:], bindings: const u32[:], ambient: u32, returns: ExitFrame?, breaks: ExitFrame?, earlier: StageEnvironment? }
struct Walker {
    module: const Module&, states: State[4096], len: i64 = 0, snapshots: State[65536], snapshot_len: i64 = 0, remaining: i64 = 65536,
    regions: u32[128], region_bindings: u32[128], region_count: i64 = 0, ambient: u32 = 0,
    returns: ExitFrame? = null, breaks: ExitFrame? = null, earlier: StageEnvironment? = null
}
fn record(self_: Walker&, frame: ExitFrame&) { frame.seen = true; for &entry, index in frame.joined { if entry.first == 0 { entry.first = self_.states[index].first; } } }
fn charge(self_: Walker&, depth: i64) -> Error { if depth >= 128 || self_.remaining == 0 { return blot_error::Error.invalid_artifact; } self_.remaining -= 1; return blot_error::Error.none; }
fn snapshot(self_: Walker&) -> State[:], Error { if self_.len > self_.snapshots.len - self_.snapshot_len || self_.len > self_.remaining { return [], blot_error::Error.invalid_artifact; } self_.remaining -= self_.len; let values = self_.snapshots[self_.snapshot_len..self_.snapshot_len + self_.len]; self_.snapshot_len += self_.len; for value, index in self_.states[..self_.len] { values[index] = value; } return values, blot_error::Error.none; }
fn copy(destination: State[:], source: const State[:]) { for value, index in source { destination[index] = value; } }
fn block_(self_: Walker&, source: u32, depth: i64) -> Outcome, Error { let count = self_.len; let mark = self_.snapshot_len; let joined, err = self_.snapshot(); if err != blot_error::Error.none { return Outcome.live, err; } var frame = ExitFrame { target: source, joined: joined, parent: self_.returns , ..}; let outer .= self_.returns; self_.returns .= frame;
    let node = self_.module.nodes[source]; var flow = Outcome.live; var error = blot_error::Error.none; for child in self_.module.extra[node.a..node.a + node.b] { let result, err = self_.expression(child, depth + 1); if err != blot_error::Error.none { error = err; break; } if result == Outcome.exit { flow = Outcome.exit; break; } } self_.len = count; self_.returns .= outer; self_.snapshot_len = mark; if error != blot_error::Error.none { return flow, error; }
    if frame.seen { if flow == Outcome.exit { copy(self_.states[..count], frame.joined); } else { for &entry, index in self_.states[..count] { if entry.first == 0 { entry.first = frame.joined[index].first; } } } return Outcome.live, blot_error::Error.none; } return flow, blot_error::Error.none;
}
fn singleIteration(self_: Walker&, loop_: blot_check_core::LoopInfo) -> bool { if loop_.kind != blot_check_core::LoopKind.range { return false; } let first = self_.module.nodes[loop_.first]; let end = self_.module.nodes[loop_.end]; if first.tag != blot_check_core::Tag.constant || end.tag != blot_check_core::Tag.constant || first.ty != blot_check_types::u32_type || end.ty != blot_check_types::u32_type { return false; } return first.a < end.a && end.a - first.a == 1; }
fn affine(self_: Walker&, ty: u32) -> bool, Error { let value, err = blot_check_usage_check::affineNominal(self_.module.types, self_.module.nominals, ty); if err != blot_error::Error.none { return false, blot_error::Error.invalid_artifact; } return value, blot_error::Error.none; }
fn state(self_: Walker&, binding: u32) -> State? { for entry in self_.states[..self_.len] { if entry.binding == binding { return entry; } } return null; }
fn introduce(self_: Walker&, binding: u32) -> Error { if binding == 0 { return blot_error::Error.none; } if binding >= self_.module.bindings.len { return blot_error::Error.invalid_artifact; } if self_.state(binding) { return blot_error::Error.none; } let affine, err = self_.affine(self_.module.bindings[binding].ty); if err != blot_error::Error.none { return err; } if !affine { return blot_error::Error.none; } if self_.len == self_.states.len { return blot_error::Error.invalid_artifact; } self_.states[self_.len] = State { binding: binding , ..}; self_.len += 1; return blot_error::Error.none; }
fn use(self_: Walker&, binding: u32, source: u32) -> Error { if binding == 0 || binding >= self_.module.bindings.len { return blot_error::Error.invalid_artifact; } let affine, err = self_.affine(self_.module.bindings[binding].ty); if err != blot_error::Error.none { return err; } if !affine { return blot_error::Error.none; } let entry .= self_.state(binding); if !entry || entry.first != 0 || entry.loan != 0 { return blot_error::Error.invalid_artifact; } entry.first = source; return blot_error::Error.none; }
fn liveLoans(self_: Walker&, ty: u32, depth: i64) -> Error { let err = self_.charge(depth); if err != blot_error::Error.none { return err; } let node = self_.module.types.node(ty); match node.tag {
    usage => { if node.c != 0 { var live = false; for region in self_.regions[..self_.region_count] { if node.c == region { live = true; } } if !live { return blot_error::Error.invalid_artifact; } } return self_.liveLoans(node.a, depth + 1); },
    array, list, cursor => { return self_.liveLoans(node.a, depth + 1); },
    product => { for child in self_.module.types.list(blot_check_types::List { node.a, node.b , ..}) { let err = self_.liveLoans(child, depth + 1); if err != blot_error::Error.none { return err; } } },
    record => { for index in 0..node.b { let err = self_.liveLoans(self_.module.types.recordField(node, index).ty, depth + 1); if err != blot_error::Error.none { return err; } } },
    nominal => { for child in self_.module.types.nominalArguments(node) { let err = self_.liveLoans(child, depth + 1); if err != blot_error::Error.none { return err; } } }, _ => {},
    } return blot_error::Error.none;
}
fn activeType(self_: Walker&, ty: u32, depth: i64) -> bool, Error { let err = self_.charge(depth); if err != blot_error::Error.none { return false, err; } let node = self_.module.types.node(ty); match node.tag {
    usage => { for region in self_.regions[..self_.region_count] { if node.c == region { return true, blot_error::Error.none; } } return self_.activeType(node.a, depth + 1); },
    array, list, cursor => { return self_.activeType(node.a, depth + 1); },
    function => { let a, err = self_.activeType(node.a, depth + 1); if err != blot_error::Error.none || a { return a, err; } return self_.activeType(node.b, depth + 1); },
    product => { for child in self_.module.types.list(blot_check_types::List { node.a, node.b , ..}) { let found, err = self_.activeType(child, depth + 1); if err != blot_error::Error.none || found { return found, err; } } },
    record => { for index in 0..node.b { let found, err = self_.activeType(self_.module.types.recordField(node, index).ty, depth + 1); if err != blot_error::Error.none || found { return found, err; } } },
    nominal => { for child in self_.module.types.nominalArguments(node) { let found, err = self_.activeType(child, depth + 1); if err != blot_error::Error.none || found { return found, err; } } }, _ => {},
    } return false, blot_error::Error.none;
}
fn scalar(self_: Walker&, ty: u32) -> bool { let tag = self_.module.types.node(ty).tag; return tag == blot_check_types::Tag.unit || tag == blot_check_types::Tag.boolean || tag == blot_check_types::Tag.unsigned32 || tag == blot_check_types::Tag.floating32; }
fn capturedLoan(self_: Walker&, source: u32, excluded: u32, depth: i64) -> bool, Error { let err = self_.charge(depth); if err != blot_error::Error.none { return false, err; } if source == 0 { return false, blot_error::Error.none; } let node = self_.module.nodes[source]; match node.tag {
    reference => { return self_.carriesLoan(source, excluded, depth + 1); },
    constant, primitive_function, constructor_function, type_constructor, panic => { return false, blot_error::Error.none; },
    closure => { let value = self_.module.closures[node.a]; return self_.capturedLoan(value.body, value.parameter.binding, depth + 1); },
    apply, scalar, logical, record_merge, proof_guard, resource_acquire, usage_borrow => { let found, err = self_.capturedLoan(node.a, excluded, depth + 1); if err != blot_error::Error.none || found { return found, err; } return self_.capturedLoan(node.b, excluded, depth + 1); },
    resource_release, usage_share, usage_read, project, return_, package_pack => { return self_.capturedLoan(node.a, excluded, depth + 1); },
    effect_scope => { if node.a == 0 || node.a >= self_.module.nodes.len { return false, blot_error::Error.invalid_artifact; } return self_.capturedLoan(node.a, excluded, depth + 1); },
    bind, construct => { return self_.capturedLoan(node.b, excluded, depth + 1); },
    if_value, if_stmt => { for child in [node.a, node.b, node.c] { let found, err = self_.capturedLoan(child, excluded, depth + 1); if err != blot_error::Error.none || found { return found, err; } } },
    task, block_, suite, product, record, array, array_op, storage => { for child in self_.module.extra[node.a..node.a + node.b] { let found, err = self_.capturedLoan(child, excluded, depth + 1); if err != blot_error::Error.none || found { return found, err; } } },
    call => { let target = self_.module.calls[node.a].target; if target.unit == 0 || target.unit == self_.module.unit { for definition in self_.module.nodes { let err = self_.charge(depth); if err != blot_error::Error.none { return false, err; } if definition.tag == blot_check_core::Tag.bind && definition.a == target.binding { let found, err = self_.carriesLoan(definition.b, excluded, depth + 1); if err != blot_error::Error.none || found { return found, err; } } } } for child in self_.module.extra[node.b..node.b + node.c] { let found, err = self_.capturedLoan(child, excluded, depth + 1); if err != blot_error::Error.none || found { return found, err; } } }, _ => { return false, blot_error::Error.invalid_artifact; },
    } return false, blot_error::Error.none;
}
fn carriesLoan(self_: Walker&, source: u32, excluded: u32, depth: i64) -> bool, Error { let err = self_.charge(depth); if err != blot_error::Error.none { return false, err; } if source == 0 { return false, blot_error::Error.none; } let node = self_.module.nodes[source]; let active, err = self_.activeType(node.ty, depth + 1); if err != blot_error::Error.none || active { return active, err; }
    match node.tag {
        reference => { let ref = self_.module.references[node.a]; if (ref.unit != 0 && ref.unit != self_.module.unit) || ref.binding == excluded { return false, blot_error::Error.none; } for binding in self_.region_bindings[..self_.region_count] { if binding == ref.binding { return true, blot_error::Error.none; } } for definition in self_.module.nodes { let err = self_.charge(depth); if err != blot_error::Error.none { return false, err; } if definition.tag == blot_check_core::Tag.bind && definition.a == ref.binding { return self_.carriesLoan(definition.b, excluded, depth + 1); } } let active, err = self_.activeType(self_.module.bindings[ref.binding].ty, depth + 1); if err != blot_error::Error.none || active { return active, err; } let binding = self_.module.bindings[ref.binding]; if binding.kind == blot_reuse_principal_interface::Kind.parameter || binding.kind == blot_reuse_principal_interface::Kind.global || binding.kind == blot_reuse_principal_interface::Kind.external || self_.scalar(node.ty) { return false, blot_error::Error.none; } return false, blot_error::Error.invalid_artifact; },
        constant => { if !self_.scalar(node.ty) { return false, blot_error::Error.invalid_artifact; } },
        usage_share => { return self_.carriesLoan(node.a, excluded, depth + 1); },
        resource_release, primitive_function, constructor_function, type_constructor, usage_read => {},
        resource_acquire => { return false, blot_error::Error.none; },
        scalar, logical, call, apply => { if !self_.scalar(node.ty) { return false, blot_error::Error.invalid_artifact; } },
        closure => { let value = self_.module.closures[node.a]; return self_.capturedLoan(value.body, value.parameter.binding, depth + 1); },
        project, return_, package_pack => { return self_.carriesLoan(node.a, excluded, depth + 1); },
        bind, construct => { return self_.carriesLoan(node.b, excluded, depth + 1); },
        if_value, if_stmt => { let found, err = self_.carriesLoan(node.b, excluded, depth + 1); if err != blot_error::Error.none || found { return found, err; } return self_.carriesLoan(node.c, excluded, depth + 1); },
        task, block_, suite, product, record, array, array_op, storage => { for child in self_.module.extra[node.a..node.a + node.b] { let found, err = self_.carriesLoan(child, excluded, depth + 1); if err != blot_error::Error.none || found { return found, err; } } }, _ => { return false, blot_error::Error.invalid_artifact; },
    } return false, blot_error::Error.none;
}
fn argument(self_: Walker&, source: u32, parameter: u32, depth: i64) -> Error { if self_.region_count == 0 { return blot_error::Error.none; } let carries, err = self_.carriesLoan(source, 0, depth + 1); if err != blot_error::Error.none { return err; } if !carries { return blot_error::Error.none; } let actual = self_.module.types.node(self_.module.typeOf(source)); let required = self_.module.types.node(parameter); if actual.tag != blot_check_types::Tag.usage || required.tag != blot_check_types::Tag.usage || actual.b != required.b || (actual.b != blot_check_types::usageCode(Usage.borrow) && actual.b != blot_check_types::usageCode(Usage.borrow_mut)) { return blot_error::Error.invalid_artifact; } let equal, err = blot_check_rank_equal::equal(self_.module.types, actual.a, required.a, true); if err != blot_error::Error.none || !equal { return blot_error::Error.invalid_artifact; } if actual.c == required.c { return blot_error::Error.none; } let region = self_.module.types.node(required.c); if region.tag != blot_check_types::Tag.bound || region.b != 2 || region.c != 0 || !formalRegion(self_.module, required.c, self_.remaining) { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; }
fn argumentArrow(self_: Walker&, ty: u32) -> blot_check_types::Node, Error { var current = ty; while true { let err = self_.charge(0); if err != blot_error::Error.none { return default<blot_check_types::Node>(), err; } let node = self_.module.types.node(current); if node.tag != blot_check_types::Tag.usage && node.tag != blot_check_types::Tag.forall { return node, blot_error::Error.none; } current = node.a; } }
fn quantified(self_: Walker&, ty: u32) -> blot_check_types::Node, Error { var current = ty; while true { let err = self_.charge(0); if err != blot_error::Error.none { return default<blot_check_types::Node>(), err; } let node = self_.module.types.node(current); if node.tag == blot_check_types::Tag.usage { current = node.a; continue; } if node.tag != blot_check_types::Tag.forall { return node, blot_error::Error.none; } if node.c == 0 || node.c > 128 || node.b > self_.module.types.extra.len || node.c > self_.module.types.extra.len - node.b { return node, blot_error::Error.invalid_artifact; }
    for binder, ordinal in self_.module.types.list(blot_check_types::List { node.b, node.c , ..}) { if binder >= self_.module.types.nodes.len { return node, blot_error::Error.invalid_artifact; } let bound = self_.module.types.node(binder); if bound.tag != blot_check_types::Tag.bound || bound.c != 0 || bound.a != ordinal || (bound.b != 0 && bound.b != 2) { return node, blot_error::Error.invalid_artifact; } if bound.b != 2 { continue; } if self_.region_count == self_.regions.len { return node, blot_error::Error.invalid_artifact; } self_.regions[self_.region_count] = binder; self_.region_bindings[self_.region_count] = 0; self_.region_count += 1; } current = node.a;
    }
}
fn reference(self_: Walker&, catalog: u32, source: u32) -> Error { if catalog >= self_.module.references.len { return blot_error::Error.invalid_artifact; } let ref = self_.module.references[catalog]; let err = self_.liveLoans(self_.module.nodes[source].ty, 0); if err != blot_error::Error.none { return err; } if ref.unit != 0 && ref.unit != self_.module.unit { let affine, err = self_.affine(self_.module.nodes[source].ty); if err != blot_error::Error.none { return err; } if affine { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; } return self_.use(ref.binding, source); }
fn pattern(self_: Walker&, source: u32, depth: i64) -> Error { let err = self_.charge(depth); if err != blot_error::Error.none { return err; } if source == 0 || source >= self_.module.patterns.len { return blot_error::Error.invalid_artifact; } let node = self_.module.patterns[source]; match node.tag {
    bind => { return self_.introduce(node.a); }, constructor => { if node.b != 0 { return self_.pattern(node.b, depth + 1); } }, product => { for child in self_.module.extra[node.a..node.a + node.b] { let err = self_.pattern(child, depth + 1); if err != blot_error::Error.none { return err; } } }, _ => {},
    } return blot_error::Error.none;
}
fn branches(self_: Walker&, left: u32, right: u32, depth: i64) -> Outcome, Error { let mark = self_.snapshot_len; let result, err = branchesBody(self_, left, right, depth); self_.snapshot_len = mark; return result, err; }
fn branchesBody(self_: Walker&, left: u32, right: u32, depth: i64) -> Outcome, Error { let count = self_.len; let before, err = self_.snapshot(); if err != blot_error::Error.none { return Outcome.live, err; } let left_flow, err = self_.expression(left, depth + 1); if err != blot_error::Error.none { return Outcome.live, err; } self_.len = count; let after, err = self_.snapshot(); if err != blot_error::Error.none { return Outcome.live, err; } copy(self_.states[..count], before[..count]); var right_flow = Outcome.live; if right != 0 { let flow, err = self_.expression(right, depth + 1); if err != blot_error::Error.none { return Outcome.live, err; } right_flow = flow; } self_.len = count;
    for &entry, index in self_.states[..count] { let first = after[index]; if right_flow == Outcome.exit { entry = first; } else if left_flow != Outcome.exit && entry.first == 0 { entry.first = first.first; } } if left_flow == Outcome.exit && right_flow == Outcome.exit { return Outcome.exit, blot_error::Error.none; } return Outcome.live, blot_error::Error.none;
}
fn cases(self_: Walker&, index: u32, depth: i64) -> Outcome, Error { let mark = self_.snapshot_len; let result, err = casesBody(self_, index, depth); self_.snapshot_len = mark; return result, err; }
fn casesBody(self_: Walker&, index: u32, depth: i64) -> Outcome, Error { let info = self_.module.matches[index]; for input in self_.module.extra[info.inputs.start..info.inputs.start + info.inputs.len] { let flow, err = self_.expression(input, depth + 1); if err != blot_error::Error.none { return Outcome.live, err; } } let count = self_.len; let before, err = self_.snapshot(); if err != blot_error::Error.none { return Outcome.live, err; } let joined, err = self_.snapshot(); if err != blot_error::Error.none { return Outcome.live, err; } var live = false;
    for arm in self_.module.match_arms[info.arms.start..info.arms.start + info.arms.len] { copy(self_.states[..count], before[..count]); for row in self_.module.pattern_rows[arm.rows.start..arm.rows.start + arm.rows.len] { for pattern in self_.module.extra[row.patterns.start..row.patterns.start + row.patterns.len] { let err = self_.pattern(pattern, depth + 1); if err != blot_error::Error.none { return Outcome.live, err; } } }
        if arm.guard_ != 0 { let flow, err = self_.expression(arm.guard_, depth + 1); if err != blot_error::Error.none { return Outcome.live, err; } if flow == Outcome.exit { self_.len = count; continue; } for &entry, index in before[..count] { if entry.first == 0 { entry.first = self_.states[index].first; } } for entry in self_.states[count..self_.len] { if entry.first != 0 { return Outcome.live, blot_error::Error.invalid_artifact; } } }
        let flow, err = self_.expression(arm.body, depth + 1); if err != blot_error::Error.none { return Outcome.live, err; } self_.len = count; if flow == Outcome.live { live = true; for &entry, index in joined[..count] { if entry.first == 0 { entry.first = self_.states[index].first; } } }
    } copy(self_.states[..count], joined[..count]); if !live { return Outcome.exit, blot_error::Error.none; } return Outcome.live, blot_error::Error.none;
}
fn closure(self_: Walker&, index: u32, ty: u32, depth: i64) -> Error {
    if index >= self_.module.closures.len { return blot_error::Error.invalid_artifact; } let value = self_.module.closures[index]; let qualifier = self_.module.types.node(ty); if qualifier.tag == blot_check_types::Tag.usage && qualifier.b == blot_check_types::usageCode(Usage.concurrent) { return blot_error::Error.invalid_artifact; } let once = qualifier.tag == blot_check_types::Tag.usage && qualifier.b == blot_check_types::usageCode(Usage.once); let count = self_.len; var found: bool[4096] = [false;4096]; let err = self_.capture(value.body, found, depth + 1); if err != blot_error::Error.none { return err; }
    for captured, index in found[..count] { if captured { let entry .= self_.states[index]; if !once || entry.first != 0 { return blot_error::Error.invalid_artifact; } entry.first = value.body; } }
    let mark = self_.snapshot_len; let saved, err = self_.snapshot(); if err != blot_error::Error.none { return err; } let region_count = self_.region_count; let ambient = self_.ambient; let returns .= self_.returns; let breaks .= self_.breaks;
    let result = closureBody(self_, value, ty, found, count, depth); self_.len = count; copy(self_.states[..count], saved[..count]); self_.region_count = region_count; self_.ambient = ambient; self_.returns .= returns; self_.breaks .= breaks; self_.snapshot_len = mark; return result;
}
fn closureBody(self_: Walker&, value: blot_check_core::ClosureInfo, ty: u32, found: const bool[:], count: i64, depth: i64) -> Error { for captured, index in found[..count] { if captured { self_.states[index].first = 0; } } let arrow, err = self_.quantified(ty); if err != blot_error::Error.none { return err; } if arrow.tag != blot_check_types::Tag.function { return blot_error::Error.invalid_artifact; } self_.ambient = arrow.c; self_.returns .= null; self_.breaks .= null; let err = self_.introduce(value.parameter.binding); if err != blot_error::Error.none { return err; } let flow, err = self_.expression(value.body, depth + 1); return err; }
fn capturePattern(self_: Walker&, id: u32, found: bool[4096]&, depth: i64) -> Error { let err = self_.charge(depth); if err != blot_error::Error.none { return err; } let pattern = self_.module.pattern(id); match pattern.tag {
    value => { return self_.capture(pattern.a, found, depth + 1); },
    constructor, record_payload => { if pattern.b != 0 { return self_.capturePattern(pattern.b, found, depth + 1); } },
    product => { for child in self_.module.patternChildren(id) { let err = self_.capturePattern(child, found, depth + 1); if err != blot_error::Error.none { return err; } } },
    wildcard, bind, constant => {}, invalid => { return blot_error::Error.invalid_artifact; },
    } return blot_error::Error.none;
}
struct CaptureChildren { walker: Walker&, found: bool[4096]&, depth: i64 }
fn append(self_: CaptureChildren&, id: u32) -> Error { if id == 0 { return blot_error::Error.none; } let err = self_.walker.capture(id, self_.found, self_.depth + 1); if err != blot_error::Error.none { return blot_error::Error.plan_limit; } return blot_error::Error.none; }
fn appendSlice(self_: CaptureChildren&, ids: const u32[:]) -> Error { for id in ids { let err = self_.append(id); if err != blot_error::Error.none { return err; } } return blot_error::Error.none; }
fn capture(self_: Walker&, source: u32, found: bool[4096]&, depth: i64) -> Error {
    let err = self_.charge(depth); if err != blot_error::Error.none { return err; } if source == 0 || source >= self_.module.nodes.len { return blot_error::Error.invalid_artifact; } let node = self_.module.nodes[source]; match node.tag {
        reference => { let ref = self_.module.reference(source); if ref.unit != 0 && ref.unit != self_.module.unit { return blot_error::Error.none; } for state, index in self_.states[..self_.len] { if state.binding == ref.binding { found[index] = true; } } return blot_error::Error.none; },
