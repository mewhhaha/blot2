// Exact completed specialization packages. Source/proof admission precedes replay.
namespace blot_eval_completed_specialization_query;
import dictionary;
import .core_eval;
import .selected_query;
import .semantic_parallel;
import .eval_values;
import .type_evidence;
import check.core;
import backend.runtime_identity;
import reuse.artifact_capture;
import reuse.principal_reuse_gate;
import reuse.source_value_template;
import reuse.artifact_import;
import reuse.specialization_receipt;
import reuse.constant_receipt;
import reuse.independent_call_proof;
import reuse.independent_worker;
import support.error;
import support.option;
import support.native;
type Error=blot_error::Error;
type BindingRef=blot_check_core::BindingRef;
type Record=blot_reuse_independent_call_proof::Record;
enum Reason { mode,source,domain,expected,input,scalar,call,view,plain,resource,imported }
fn reasonCode(reason: Reason) -> u32 { match reason { mode=>0,source=>1,domain=>2,expected=>3,input=>4,scalar=>5,call=>6,view=>7,plain=>8,resource=>9,imported=>10, } }
struct Stats { independent_rechecked: i64=0,independent_rejections: i64[15]=[0;15],independent_regions: u64=0,independent_nodes: u64=0,independent_reused: i64=0,independent_declined: i64=0,parallel_batches: i64=0,parallel_jobs: i64=0,parallel_workers: i64=1,recorded: i64=0,member_recorded: i64=0,member_payload_bytes: i64=0,member_reused: i64=0,complete_records: i64=0,completed_closures: i64=0,lookups: i64=0,candidates: i64=0,reused: i64=0,reasons: i64[11]=[0;11],collected_visits_removed: i64=0,source_scopes_removed: i64=0,solver_nodes_removed: i64=0,values_imported: i64=0,plain_revalidated: i64=0,enumerated_records: i64=0,longest_bucket: i64=0,empty_buckets: i64=0,root_preflight_declined: i64=0,owner_importers: i64=0,prepared_importers: i64=0,fresh_importers: i64=0,shared_gates: i64=0,gate_fresh: i64=0,shared_gate_bytes: i64=0,plan_inspections: i64=0,plan_cache_hits: i64=0,source_validation_checks: i64=0,source_validation_hits: i64=0,graph_scratch: blot_reuse_source_value_template::ScratchStats=blot_reuse_source_value_template::ScratchStats {} }
struct CachedPlan { checked: bool=false,plan: blot_support::Option<blot_reuse_source_value_template::Plan>=blot_support::none<blot_reuse_source_value_template::Plan>(),source_admitted: blot_support::Option<bool>=blot_support::none<bool>() }
reusable[] var cached_plans: CachedPlan[>..]=[];
struct Tables { independent_calls: Record[>..<]&,completed_worker_proofs: Record[>..<]&,parallel_requests: blot_eval_semantic_parallel::Request[>..<]&,parallel_slots: blot_eval_semantic_parallel::Slot[>..<]&,parallel_outcomes: blot_eval_semantic_job_batch::Outcome<blot_eval_semantic_parallel::Result>[>..<]& }
struct State { owner_id: u64=blot_native::fresh_owner_id(),allocation_owner: u64=0,old: const blot_reuse_artifact_capture::Capture&,gate: blot_reuse_principal_reuse_gate::Gate,stats: Stats=Stats {},independent_calls: Record[>..<]&,completed_worker_proofs: Record[>..<]&,worker_proof_words: i64=0,recover_call_proofs: bool=true,parallel_enabled: bool=false,semantic_workers: u8=1,revalidate_plain_facts: bool=true,graph_scratch: blot_reuse_source_value_template::QueryScratch,plans: CachedPlan[:]=[],indexed: bool=false,semantic: blot_support::Option<blot_reuse_artifact_import::Importer>=blot_support::none<blot_reuse_artifact_import::Importer>(),state_owner: u64=0,generator_owner: u64=0,session_owner: u64=0,parallel_requests: blot_eval_semantic_parallel::Request[>..<]&,parallel_slots: blot_eval_semantic_parallel::Slot[>..<]&,parallel_outcomes: blot_eval_semantic_job_batch::Outcome<blot_eval_semantic_parallel::Result>[>..<]& }
fn init(allocation_owner: u64,old: const blot_reuse_artifact_capture::Capture&,units: const blot_check_core::Module[:],names: blot_support::Option<blot_backend_runtime_identity::View>,t: Tables) -> State,Error { assert(old.metadata.pools.present); let gate,error=blot_reuse_principal_reuse_gate::init(allocation_owner,old.metadata.pools.value,units,names); return State {allocation_owner:allocation_owner,old:old,gate:gate,independent_calls:t.independent_calls,completed_worker_proofs:t.completed_worker_proofs,graph_scratch:blot_reuse_source_value_template::QueryScratch {allocation_owner:allocation_owner},parallel_requests:t.parallel_requests,parallel_slots:t.parallel_slots,parallel_outcomes:t.parallel_outcomes},error; }
fn deinit(self: State&) { for &record in self.completed_worker_proofs { record.deinit(); } self.completed_worker_proofs.clear(); for &record in self.independent_calls { record.deinit(); } self.independent_calls.clear(); self.graph_scratch.deinit(); if self.semantic.present { self.semantic.value.deinit(); self.semantic=blot_support::none<blot_reuse_artifact_import::Importer>(); } for &cached in self.plans { if cached.plan.present { cached.plan.value.deinit(); } } cached_plans.free_slice(self.plans); self.plans=[]; self.gate.deinit(); self.parallel_requests.clear(); self.parallel_slots.clear(); self.parallel_outcomes.clear(); self.owner_id=0; }
fn index(self: State&) -> Error { if self.indexed { return Error.none; } self.plans=cached_plans.alloc_slice(self.old.metadata.specialization_queries.records.len); for &plan in self.plans { plan=CachedPlan {}; } self.indexed=true; return Error.none; }
fn pairedImporter(self: State&) -> blot_reuse_artifact_import::Importer&,Error { if !self.semantic.present { let pools: const blot_reuse_code_artifacts::Pools&=self.old.metadata.pools.value; let prepared,error=blot_reuse_artifact_import::initCheckedQuery(self.allocation_owner,pools,self.gate.units,self.gate); if error!=Error.none { return self.semantic.value,error; } if prepared.present { self.semantic=prepared; self.stats.prepared_importers++; } else { assert(pools.identity.present); let maps,e=blot_reuse_artifact_import::init(self.allocation_owner,pools,self.gate.units,blot_support::some(pools.identity.value.view()),self.gate.units.len); if e!=Error.none { return self.semantic.value,e; } self.semantic=blot_support::some(maps); self.stats.fresh_importers++; } for exact,position in self.gate.structural_units { self.semantic.value.stable[position]=exact; } self.stats.owner_importers++; } return self.semantic.value,Error.none; }
fn cachedPlan(self: State&,position: i64) -> blot_reuse_source_value_template::Plan?,Error { let cached: CachedPlan&=self.plans[position]; if cached.checked { self.stats.plan_cache_hits++; if cached.plan.present { return cached.plan.value,Error.none; } return null,Error.none; } let record=self.old.metadata.specialization_queries.records[position].dependencies; var roots: u32[>..<]=[]; roots.append([record.selected,record.input]); if record.member.present { let member=record.member.value; roots.push(member.function); for read in member.ready { roots.push(read.value); } } for view in record.views { roots.append([view.value,view.selected]); } for value in record.completed_closures { let snapshot=self.old.metadata.pools.value.evaluator; if value==0||value>=snapshot.values.len||snapshot.values[value].kind!=blot_eval_eval_values::ValueKind.closure||snapshot.value_evidence[value]==0 { cached.checked=true; return null,Error.none; } roots.push(value); } let inspection,error=blot_reuse_source_value_template::inspectRootsWithRows(self.old.metadata.pools.value,self.gate,roots,blot_reuse_source_value_template::RowPolicy.source_declared); if error!=Error.none { return null,error; } self.stats.plan_inspections++; cached.plan=inspection.plan; cached.checked=true; if cached.plan.present { return cached.plan.value,Error.none; } return null,Error.none; }
fn rootMatches<G>(self: const State&,g: G&,old_input: u32,input: u32) -> bool { let snapshot=self.old.metadata.pools.value.evaluator; let left=snapshot.values[old_input]; let right=g.evaluator.valueInfo(input); let before=snapshot.closures[left.bits]; let current=g.evaluator.closureInfo(input); if left.scalar!=right.scalar||left.nominal!=right.nominal||left.len!=right.len||before.ty!=current.ty||before.mappings.len!=current.mappings.len||before.row_mappings.len!=current.row_mappings.len||(snapshot.value_evidence[old_input]==0)!=(g.evaluator.valueEvidence(input)==0) { return false; } for prior,position in snapshot.type_mappings[before.mappings.start..before.mappings.start+before.mappings.len] { if prior.variable!=g.evaluator.storage.type_mappings[current.mappings.start+position].variable { return false; } } for prior,position in snapshot.row_mappings[before.row_mappings.start..before.row_mappings.start+before.row_mappings.len] { if prior.variable!=g.evaluator.storage.row_mappings[current.row_mappings.start+position].variable { return false; } } return true; }
fn reject(self: State&,reason: Reason) { self.stats.reasons[reasonCode(reason)]++; }
fn evidence<G>(g: G&,maps: blot_reuse_artifact_import::Importer&,old: u32) -> blot_support::Option<u32>,Error { if old==0 { return blot_support::some<u32>(0),Error.none; } return maps.importEvidence(g,old); }
fn memberReady<G>(g: G&,target: BindingRef) -> bool { if target.unit==0||target.unit>g.evaluator.units.len||target.binding>=g.evaluator.units[target.unit-1].bindings.len||g.evaluator.inquiry_regions!=0||g.evaluator.semantic_job_budget.present { return false; } let slot=g.evaluator.slots[g.evaluator.binding_offsets[target.unit-1]+target.binding]; return slot.state==blot_eval_core_eval::State.complete&&g.evaluator.memberReceiptEligible(target); }
fn lookup<G>(self: State&,g: G&,input: u32,expected: u32) -> blot_support::Option<u32>,Error { return lookupQuery(self,g,blot_support::none<BindingRef>(),input,expected,blot_support::none<u32>()); }
fn lookupMember<G>(self: State&,g: G&,target: BindingRef,input: u32,expected: u32) -> blot_support::Option<u32>,Error { if !memberReady(g,target) { return blot_support::none<u32>(),Error.none; } return lookupQuery(self,g,blot_support::some(target),input,expected,blot_support::none<u32>()); }
fn lookupMemberRecord<G>(self: State&,g: G&,target: BindingRef,input: u32,expected: u32,position: u32) -> blot_support::Option<u32>,Error { if !memberReady(g,target) { return blot_support::none<u32>(),Error.none; } return lookupQuery(self,g,blot_support::some(target),input,expected,blot_support::some(position)); }
import backend.backend_timing;
import reuse.semantic_query_table;
import .semantic_job_batch;
import .plain_catalog;
import reuse.code_artifacts;
fn lookupQuery<G>(self: State&,g: G&,member: blot_support::Option<BindingRef>,input: u32,expected: u32,exact: blot_support::Option<u32>) -> blot_support::Option<u32>,Error { if g.evaluator.timing { let scope=g.evaluator.timing.enter(blot_backend_backend_timing::Phase.query_prepare); let result,error=lookupQueryInner(self,g,member,input,expected,exact,scope); scope.deinit(); self.stats.graph_scratch=self.graph_scratch.stats; return result,error; } let result,error=lookupQueryInner(self,g,member,input,expected,exact,null); self.stats.graph_scratch=self.graph_scratch.stats; return result,error; }
fn phase(scope: blot_backend_backend_timing::Scope?,phase: blot_backend_backend_timing::Phase) { if scope { scope.change(phase); } }
fn lookupQueryInner<G>(self: State&,g: G&,member: blot_support::Option<BindingRef>,input: u32,expected: u32,exact: blot_support::Option<u32>,timing: blot_backend_backend_timing::Scope?) -> blot_support::Option<u32>,Error {
 self.stats.lookups++; if !self.gate.enabled||!(g.evaluator.units .== self.gate.units)||g.evaluator.units.len!=self.gate.units.len||self.allocation_owner==0||self.allocation_owner!=g.evaluator.allocation_owner { return blot_support::none<u32>(),Error.none; } if input>=g.evaluator.storage.values.len||expected>=g.evaluator.storage.evidence.nodes.len { return blot_support::none<u32>(),Error.none; } var current=blot_eval_selected_query::Source {0,0,blot_eval_eval_values::ClosureOrigin.named,0}; if member.present { if g.evaluator.valueInfo(input).kind!=blot_eval_eval_values::ValueKind.array||g.evaluator.valueEvidence(input)!=0 { return blot_support::none<u32>(),Error.none; } current=blot_eval_selected_query::memberSource(member.value); } else { if g.evaluator.valueInfo(input).kind!=blot_eval_eval_values::ValueKind.closure||expected==0||g.evaluator.storage.evidence.node(expected).tag!=blot_eval_type_evidence::Tag.function { return blot_support::none<u32>(),Error.none; } current=blot_eval_selected_query::source(g.evaluator.closureInfo(input)); }
 let ordinary=blot_eval_core_eval::Options {}; let options=g.evaluator.options; if options.max_values!=ordinary.max_values||options.max_children!=ordinary.max_children||options.max_depth!=ordinary.max_depth||options.max_type_depth!=ordinary.max_type_depth||options.max_steps!=ordinary.max_steps { reject(self,Reason.resource); return blot_support::none<u32>(),Error.none; } if (self.state_owner!=0&&self.state_owner!=self.owner_id)||(self.generator_owner!=0&&self.generator_owner!=g.owner_id)||(self.session_owner!=0&&self.session_owner!=g.evaluator.owner_id) { return blot_support::none<u32>(),Error.none; } if !member.present&&g.evaluator.storage.specialized_closures.contains(blot_eval_core_eval::ViewKey {value:input,evidence:expected}) { return blot_support::none<u32>(),Error.none; } self.state_owner=self.owner_id; self.generator_owner=g.owner_id; self.session_owner=g.evaluator.owner_id; let indexed=index(self); if indexed!=Error.none { return blot_support::none<u32>(),indexed; }
 var cursor=self.old.metadata.specialization_queries.candidates(blot_eval_selected_query::fingerprint(current,options,g.evaluator.depth),blot_reuse_semantic_query_table::Order.oldest_first); let result,error=lookupCandidates(self,g,member,input,expected,exact,timing,current,cursor); if self.stats.longest_bucket<cursor.inspected { self.stats.longest_bucket=cursor.inspected; } if cursor.inspected==0 { self.stats.empty_buckets++; } return result,error;
}
fn lookupCandidates<G>(self: State&,g: G&,member: blot_support::Option<BindingRef>,input: u32,expected: u32,exact: blot_support::Option<u32>,timing: blot_backend_backend_timing::Scope?,current: blot_eval_selected_query::Source,cursor: blot_reuse_semantic_query_table::Cursor&) -> blot_support::Option<u32>,Error {
 let pools: const blot_reuse_code_artifacts::Pools&=self.old.metadata.pools.value; loop { phase(timing,blot_backend_backend_timing::Phase.query_scan); let position=cursor.next(); if !position.present { break; } if exact.present&&position.value!=exact.value { continue; } let record: const blot_reuse_specialization_receipt::Record&=self.old.metadata.specialization_queries.records[position.value].dependencies; self.stats.enumerated_records++; if record.input>=pools.evaluator.values.len { continue; }
 if member.present { if !record.member.present { continue; } let old=record.member.value; if !g.evaluator.memberPrincipalsMatch(old)||old.exhausted||old.transitions>g.evaluator.options.max_summary_transitions||old.target!=member.value||!self.gate.admits(member.value)||pools.evaluator.values[record.input].kind!=blot_eval_eval_values::ValueKind.array { continue; } if old.query_budgets!=blot_reuse_constant_receipt::queryBudgets(g.evaluator)||old.summary_work!=g.evaluator.summary_graph_work||old.principal_nodes!=g.evaluator.principal_graph_nodes||old.principal_edges!=g.evaluator.principal_graph_edges { continue; } }
 else { if record.member.present||pools.evaluator.values[record.input].kind!=blot_eval_eval_values::ValueKind.closure { continue; } let source=blot_eval_selected_query::source(pools.evaluator.closures[pools.evaluator.values[record.input].bits]); if source!=current { continue; } }
 self.stats.candidates++; if !record.complete||record.steps!=0||record.depth!=g.evaluator.depth||record.options!=g.evaluator.options { reject(self,Reason.mode); continue; } if g.evaluator.storage.values.len>g.evaluator.options.max_values||record.values_added>g.evaluator.options.max_values-g.evaluator.storage.values.len||g.evaluator.storage.children.len>g.evaluator.options.max_children||record.children_added>g.evaluator.options.max_children-g.evaluator.storage.children.len { reject(self,Reason.resource); continue; }
 phase(timing,blot_backend_backend_timing::Phase.query_source); if !self.plans[position.value].source_admitted.present { self.stats.source_validation_checks++; self.plans[position.value].source_admitted=blot_support::some(self.gate.admitsReceipt(record)); } else { self.stats.source_validation_hits++; } if !self.plans[position.value].source_admitted.value { reject(self,Reason.source); continue; } if !member.present&&!rootMatches(self,g,record.input,input) { self.stats.root_preflight_declined++; reject(self,Reason.input); continue; }
 phase(timing,blot_backend_backend_timing::Phase.query_import); let maps,error=pairedImporter(self); if error!=Error.none { return blot_support::none<u32>(),error; } if !maps.enabled { reject(self,Reason.source); continue; } for exact,index in self.gate.structural_units { maps.stable[index]=exact; } let imported,e=evidence(g,maps,record.expected); if e!=Error.none { return blot_support::none<u32>(),e; } if !imported.present||imported.value!=expected { reject(self,Reason.expected); continue; } let plan,e2=cachedPlan(self,position.value); if e2!=Error.none { return blot_support::none<u32>(),e2; } if plan==null { reject(self,Reason.domain); continue; }
 phase(timing,blot_backend_backend_timing::Phase.query_match); let anchors,e3=self.graph_scratch.begin(plan,g); if e3!=Error.none { if e3==Error.out_of_memory { return blot_support::none<u32>(),e3; } reject(self,Reason.source); continue; } let matches,e4=matchInto(self,g,plan,maps,record.input,input,anchors); if e4!=Error.none { return blot_support::none<u32>(),e4; } if !matches { reject(self,Reason.input); continue; }
 if record.member.present { let old=record.member.value; var ready=true; for read in old.ready { if !self.gate.admits(read.target) { ready=false; break; } let slot=g.evaluator.slots[g.evaluator.binding_offsets[read.target.unit-1]+read.target.binding]; if slot.state!=blot_eval_core_eval::State.complete { ready=false; break; } let matched,e5=matchInto(self,g,plan,maps,read.value,slot.value,anchors); if e5!=Error.none { return blot_support::none<u32>(),e5; } if !matched { ready=false; break; } } if !ready { reject(self,Reason.input); continue; } let slot=g.evaluator.slots[g.evaluator.binding_offsets[old.target.unit-1]+old.target.binding]; let matched,e5=matchInto(self,g,plan,maps,old.function,slot.value,anchors); if e5!=Error.none { return blot_support::none<u32>(),e5; } if !matched { reject(self,Reason.input); continue; } }
 phase(timing,blot_backend_backend_timing::Phase.query_validate); let result,e5=validateCandidate(self,g,record,plan,maps,anchors,input,expected,timing); if e5!=Error.none||result.present { return result,e5; }
 } return blot_support::none<u32>(),Error.none;
}
fn matchInto<G>(self: State&,g: G&,plan: blot_reuse_source_value_template::Plan&,maps: blot_reuse_artifact_import::Importer&,before: u32,after: u32,anchors: u32[:]) -> bool,Error { let matched,error=plan.matchIntoWithScratch(g,maps,before,after,anchors,self.graph_scratch); if error==Error.declined { return false,Error.none; } return matched,error; }
struct Candidate<G> { state: State&,g: G&,record: const blot_reuse_specialization_receipt::Record&,plan: blot_reuse_source_value_template::Plan&,maps: blot_reuse_artifact_import::Importer&,anchors: u32[:],input: u32,expected: u32,timing: blot_backend_backend_timing::Scope?,proofs: Record[>..<]&,plain: dictionary<u64,bool>&,batch: blot_support::Option<blot_eval_semantic_parallel::Batch>=blot_support::none<blot_eval_semantic_parallel::Batch>(),next: blot_support::Option<blot_reuse_specialization_receipt::Record>=blot_support::none<blot_reuse_specialization_receipt::Record>() }
fn validateCandidate<G>(self: State&,g: G&,record: const blot_reuse_specialization_receipt::Record&,plan: blot_reuse_source_value_template::Plan&,maps: blot_reuse_artifact_import::Importer&,anchors: u32[:],input: u32,expected: u32,timing: blot_backend_backend_timing::Scope?) -> blot_support::Option<u32>,Error { var proofs: Record[>..<]=[]; var plain: dictionary<u64,bool>; let request_start=self.parallel_requests.len; let slot_start=self.parallel_slots.len; let outcome_start=self.parallel_outcomes.len; var context=Candidate<G> {self,g,record,plan,maps,anchors,input,expected,timing,proofs,plain}; let result,error=validateCandidateInner(context); for &proof in proofs { proof.deinit(); } proofs.clear(); if context.batch.present { context.batch.value.deinit(); } if context.next.present { context.next.value.deinit(); } self.parallel_requests.resize(request_start); self.parallel_slots.resize(slot_start); self.parallel_outcomes.resize(outcome_start); return result,error; }
fn candidateReject<G>(context: Candidate<G>&,reason: Reason) -> blot_support::Option<u32>,Error { reject(context.state,reason); return blot_support::none<u32>(),Error.none; }
fn validateCandidateInner<G>(context: Candidate<G>&) -> blot_support::Option<u32>,Error { let self: State&=context.state; let g: G&=context.g; let record: const blot_reuse_specialization_receipt::Record&=context.record; let maps: blot_reuse_artifact_import::Importer&=context.maps;
 for read in record.scalar_reads { let module=self.gate.units[read.target.unit-1]; let body=module.body(read.target.binding); assert(body!=null); let slot=g.evaluator.slots[g.evaluator.binding_offsets[read.target.unit-1]+read.target.binding]; var actual: u32=0; if !body.runtime&&slot.state==blot_eval_core_eval::State.complete&&g.evaluator.valueInfo(slot.value).kind==blot_eval_eval_values::ValueKind.scalar { actual=g.evaluator.valueEvidence(slot.value); } let imported,error=evidence(g,maps,read.evidence); if error!=Error.none { return blot_support::none<u32>(),error; } if !imported.present||imported.value!=actual { return candidateReject(context,Reason.scalar); } }
 if !record.member.present { let batch,error=prepareCallProofs(self,g,maps,record.call_reads); if error!=Error.none { return blot_support::none<u32>(),error; } context.batch=batch; }
 for read,index in record.call_reads { let actual,error=evidence(g,maps,read.evidence); if error!=Error.none { return blot_support::none<u32>(),error; } if !actual.present { return candidateReject(context,Reason.call); } let key=blot_eval_core_eval::CallProofKey {target:blot_eval_core_eval::Target {(read.unit-1) as i64,read.binding},evidence:actual.value}; var present=g.evaluator.specializations.validated_calls.contains(key); if !present { for proof in context.proofs { if proof.target==BindingRef {read.unit,read.binding}&&proof.evidence==actual.value { present=true; break; } } }
  if !present&&read.present&&self.recover_call_proofs&&!record.member.present { var recovered=blot_support::none<Record>(); if context.batch.present&&context.batch.value.attempted(index) { let proof,found,e=context.batch.value.take(index,self.stats); if e!=Error.none { return blot_support::none<u32>(),e; } if found { recovered=blot_support::some(proof); } } else { let proof,e=blot_reuse_independent_call_proof::acquire(self,g,read,actual.value); if e!=Error.none { return blot_support::none<u32>(),e; } recovered=proof; } if recovered.present { context.proofs.push(recovered.value); present=true; } }
  if present!=read.present { return candidateReject(context,Reason.call); }
 }
 for view in record.views { if view.value>=record.values_before { continue; } if view.value!=0&&context.anchors[view.value]==0 { return candidateReject(context,Reason.view); } let actual,error=evidence(g,maps,view.evidence); if error!=Error.none { return blot_support::none<u32>(),error; } if !actual.present { return candidateReject(context,Reason.view); } let existing=g.evaluator.storage.typed_views.get(blot_eval_core_eval::ViewKey {value:context.anchors[view.value],evidence:actual.value}); if view.existed { if existing==null { return candidateReject(context,Reason.view); } let matched,e=matchInto(self,g,context.plan,maps,view.selected,existing,context.anchors); if e!=Error.none { return blot_support::none<u32>(),e; } if !matched { return candidateReject(context,Reason.view); } } else if existing!=null { return candidateReject(context,Reason.view); } }
 for fact in record.plain_facts { let unit=(fact.key>>32) as u32; if unit==0||unit>self.gate.units.len||!self.gate.structural_units[unit-1] { return candidateReject(context,Reason.plain); } if fact.read { var present=blot_support::none<bool>(); let staged=context.plain.get(fact.key); if staged { present=blot_support::some<bool>(staged); } else { let current=g.evaluator.specializations.plain_nominals.get(fact.key); if current { present=blot_support::some<bool>(current); } } if self.revalidate_plain_facts&&!present.present&&fact.present&&fact.plain&&blot_eval_plain_catalog::prove(self.gate.units,unit,fact.key as! u32,g.evaluator.options.max_type_depth) { context.plain.insert(fact.key,true); present=blot_support::some(true); self.stats.plain_revalidated++; } if fact.present { if !present.present||present.value!=fact.plain { return candidateReject(context,Reason.plain); } } else if present.present { return candidateReject(context,Reason.plain); } } else { context.plain.insert(fact.key,fact.plain); } }
 return publishCandidate(context);
}
fn publishCandidate<G>(context: Candidate<G>&) -> blot_support::Option<u32>,Error { let self: State&=context.state; let g: G&=context.g; let record: const blot_reuse_specialization_receipt::Record&=context.record; let pools: const blot_reuse_code_artifacts::Pools&=self.old.metadata.pools.value; let maps: blot_reuse_artifact_import::Importer&=context.maps; phase(context.timing,blot_backend_backend_timing::Phase.query_publish); var completed: u32[>..<]=[]; var views: u32[>..<]=[]; var calls: u32[>..<]=[];
 for value in record.completed_closures { let actual,error=evidence(g,maps,pools.evaluator.value_evidence[value]); if error!=Error.none { return blot_support::none<u32>(),error; } if !actual.present { return candidateReject(context,Reason.domain); } completed.push(actual.value); } for view in record.views { let actual,error=evidence(g,maps,view.evidence); if error!=Error.none { return blot_support::none<u32>(),error; } if !actual.present { return candidateReject(context,Reason.domain); } views.push(actual.value); } for call in record.call_publications { let actual,error=evidence(g,maps,call.evidence); if error!=Error.none { return blot_support::none<u32>(),error; } if !actual.present { return candidateReject(context,Reason.domain); } calls.push(actual.value); }
 g.evaluator.storage.typed_views.reserve(g.evaluator.storage.typed_views.count+record.views.len); g.evaluator.specializations.validated_calls.reserve(g.evaluator.specializations.validated_calls.count+record.call_publications.len+context.proofs.len); let collect_proofs=self.semantic_workers>1; if collect_proofs { let length=self.independent_calls.len; self.independent_calls.resize(length+context.proofs.len,default<Record>()); self.independent_calls.resize(length); } g.evaluator.specializations.plain_nominals.reserve(g.evaluator.specializations.plain_nominals.count+context.plain.count); var additional=record.completed_closures.len; if !record.member.present { additional+=2; } g.evaluator.storage.specialized_closures.reserve(g.evaluator.storage.specialized_closures.count+additional);
 let cloned,error=record.clone(); if error!=Error.none { return blot_support::none<u32>(),error; } context.next=blot_support::some(cloned); for &read in context.next.value.scalar_reads { let actual,e=evidence(g,maps,read.evidence); if e!=Error.none { return blot_support::none<u32>(),e; } if !actual.present { return candidateReject(context,Reason.domain); } read.evidence=actual.value; } for &read in context.next.value.call_reads { let actual,e=evidence(g,maps,read.evidence); if e!=Error.none { return blot_support::none<u32>(),e; } if !actual.present { return candidateReject(context,Reason.domain); } read.evidence=actual.value; }
 if g.evaluator.retain_specialization_receipts { let length=g.evaluator.retained.specialization_receipts.len; g.evaluator.retained.specialization_receipts.resize(length+1,default<blot_reuse_specialization_receipt::Record>()); g.evaluator.retained.specialization_receipts.resize(length); } let before_children=g.evaluator.storage.children.len; let before=g.evaluator.storage.values.len; let storage=blot_reuse_source_value_template::QueryStorage {values_before:record.values_before,values_added:record.values_added,children_added:record.children_added}; let mapped,e=context.plan.materializeReceiptWithScratch(g,maps,context.anchors,storage,self.graph_scratch); if e!=Error.none { if e==Error.out_of_memory { return blot_support::none<u32>(),e; } return candidateReject(context,Reason.resource); }
 for view,index in record.views { if !view.existed { g.evaluator.storage.typed_views.insert(blot_eval_core_eval::ViewKey {value:mapped[view.value],evidence:views[index]},mapped[view.selected]); } } for &proof in context.proofs { let key=blot_eval_core_eval::CallProofKey {target:blot_eval_core_eval::Target {(proof.target.unit-1) as i64,proof.target.binding},evidence:proof.evidence}; if !g.evaluator.specializations.validated_calls.contains(key) { g.evaluator.proofs.proof_published++; } g.evaluator.specializations.validated_calls.insert(key,true); if collect_proofs { self.independent_calls.push(proof); } else { proof.deinit(); } } context.proofs.clear(); for call,index in record.call_publications { let key=blot_eval_core_eval::CallProofKey {target:blot_eval_core_eval::Target {(call.unit-1) as i64,call.binding},evidence:calls[index]}; if !g.evaluator.specializations.validated_calls.contains(key) { g.evaluator.proofs.proof_published++; } g.evaluator.specializations.validated_calls.insert(key,true); } for fact in context.plain.slots { if fact.tag!=0 { g.evaluator.specializations.plain_nominals.insert(fact.key,fact.val); } }
 if record.member.present { let member=record.member.value; g.evaluator.summary_transitions=member.transitions; g.evaluator.summary_exhausted=member.exhausted; if context.next.value.member.present { context.next.value.member.value.function=mapped[member.function]; for &read in context.next.value.member.value.ready { read.value=mapped[read.value]; } } }
 else { let selected=mapped[record.selected]; g.evaluator.storage.specialized_closures.insert(blot_eval_core_eval::ViewKey {value:context.input,evidence:context.expected},selected); g.evaluator.storage.specialized_closures.insert(blot_eval_core_eval::ViewKey {value:selected,evidence:context.expected},selected); self.stats.completed_closures++; } for value,index in record.completed_closures { g.evaluator.storage.specialized_closures.insert(blot_eval_core_eval::ViewKey {value:mapped[value],evidence:completed[index]},mapped[value]); self.stats.completed_closures++; }
 if g.evaluator.retain_specialization_receipts { let next: blot_reuse_specialization_receipt::Record&=context.next.value; next.input=context.input; next.expected=context.expected; next.selected=mapped[record.selected]; for &value in next.completed_closures { value=mapped[value]; } next.values_before=before; next.children_before=before_children; for &view,index in next.views { view.value=mapped[view.value]; view.selected=mapped[view.selected]; view.evidence=views[index]; } for &call,index in next.call_publications { call.evidence=calls[index]; } g.evaluator.retained.specialization_receipts.push(next); context.next=blot_support::none<blot_reuse_specialization_receipt::Record>(); } for read in record.call_reads { if read.present { g.evaluator.proofs.proof_reused++; } } self.stats.reused++; if record.member.present { self.stats.member_reused++; } self.stats.reasons[reasonCode(Reason.imported)]++; self.stats.collected_visits_removed+=record.collected; self.stats.source_scopes_removed+=record.source_scopes; self.stats.solver_nodes_removed+=record.solver_nodes; self.stats.values_imported+=g.evaluator.storage.values.len-before; return blot_support::some(mapped[record.selected]),Error.none;
}
fn prepareCallProofs<G>(self: State&,g: G&,maps: blot_reuse_artifact_import::Importer&,reads: const blot_reuse_specialization_receipt::CallRead[:]) -> blot_support::Option<blot_eval_semantic_parallel::Batch>,Error { if !self.recover_call_proofs||self.semantic_workers<=1||reads.len<4||!self.parallel_enabled { return blot_support::none<blot_eval_semantic_parallel::Batch>(),Error.none; } var requests: blot_eval_semantic_parallel::Request[>..<]=[]; var source_bytes=0; for read,index in reads { if !read.present { continue; } let actual,error=evidence(g,maps,read.evidence); if error!=Error.none { return blot_support::none<blot_eval_semantic_parallel::Batch>(),error; } if !actual.present { continue; } if g.evaluator.specializations.validated_calls.contains(blot_eval_core_eval::CallProofKey {target:blot_eval_core_eval::Target {(read.unit-1) as i64,read.binding},evidence:actual.value})||!self.gate.admits(BindingRef {read.unit,read.binding}) { continue; } let body=self.gate.units[read.unit-1].body(read.binding); assert(body!=null); var bytes=body.span.end as i64-body.span.start as i64; if bytes<0 { bytes=0; } source_bytes=blot_eval_core_eval::satAdd(source_bytes,bytes); requests.push(blot_eval_semantic_parallel::Request {index,read,actual.value}); } if requests.len<4||source_bytes<4096 { return blot_support::none<blot_eval_semantic_parallel::Batch>(),Error.none; } var room=g.evaluator.options.max_values-self.completed_worker_proofs.len; if room<0 { room=0; } if requests.len>room { return blot_support::none<blot_eval_semantic_parallel::Batch>(),Error.none; } let length=self.completed_worker_proofs.len; self.completed_worker_proofs.resize(length+requests.len,default<Record>()); self.completed_worker_proofs.resize(length);
 let batch,error=blot_reuse_independent_call_proof::runParallel<State,G>(self,g,requests,self.semantic_workers,self.parallel_requests,self.parallel_slots,self.parallel_outcomes); if error!=Error.none { batch.deinit(); return blot_support::none<blot_eval_semantic_parallel::Batch>(),error; } batch.retainSuccesses(self.completed_worker_proofs,self.worker_proof_words,g.evaluator.options.max_children); self.stats.parallel_batches++; self.stats.parallel_jobs+=requests.len; if self.stats.parallel_workers<batch.workers { self.stats.parallel_workers=batch.workers; } return blot_support::some(batch),Error.none;
}
