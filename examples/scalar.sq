// Executable scalar slice: native parsing, checking and Wasm emission.
io U32.increment value => @u32.add value 1

io const base: U32 = @u32.add 20 21
io const max_value: U32 = 0xFFFF_FFFF

io answer (): U32 =>
  let result: U32 = U32.increment base
  return result

// use also accepts pure computations; it does not introduce an effect itself.
io bound_answer (): U32 =>
  use result: U32 <- U32.increment base
  use ()
  return result

io capped (value: U32): U32 =>
  if @u32.lt value 42:
    return value
  return 42

io choose (condition: Bool): U32 =>
  if condition:
    return 20
  else:
    return 22
