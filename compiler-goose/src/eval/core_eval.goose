 else { if projection.nominal.decl!=0||variants.len!=1 { return default<Location>(),failNode(self,owner,source,Code.unsupported); } field=blot_support::some(variants[0].field); } if !field.present { return default<Location>(),failNode(self,owner,source,Code.unsupported); } let payload=valueInfo(self,container); if (payload.kind!=ValueKind.product&&payload.kind!=ValueKind.record)||field.value>=payload.len { return default<Location>(),failNode(self,owner,source,Code.unsupported); } return Location {container,field.value,wrapped},Error.none;
