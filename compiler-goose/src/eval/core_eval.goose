fn canonicalRegionCaller(value:blot_backend_backend_timing::RegionCaller)->blot_backend_backend_timing::RegionCaller {
 if value.function=="" {return blot_backend_backend_timing::RegionCaller{function:"",line:value.line};}
 if value.function=="solveEvidenceOwnedCodeInner" {return blot_backend_backend_timing::RegionCaller{function:"solveEvidenceOwnedCodeInner",line:value.line};}
 if value.function=="closureEvidenceQuery" {return blot_backend_backend_timing::RegionCaller{function:"closureEvidenceQuery",line:value.line};}
 if value.function=="sourceRegionInterface" {return blot_backend_backend_timing::RegionCaller{function:"sourceRegionInterface",line:value.line};}
 if value.function=="sourceInterfaceInner" {return blot_backend_backend_timing::RegionCaller{function:"sourceInterfaceInner",line:value.line};}
 if value.function=="matchCovariantTypeInner" {return blot_backend_backend_timing::RegionCaller{function:"matchCovariantTypeInner",line:value.line};}
 if value.function=="validateSchemeInner" {return blot_backend_backend_timing::RegionCaller{function:"validateSchemeInner",line:value.line};}
 if value.function=="describePrincipalTape" {return blot_backend_backend_timing::RegionCaller{function:"describePrincipalTape",line:value.line};}
 if value.function=="drainSummaries" {return blot_backend_backend_timing::RegionCaller{function:"drainSummaries",line:value.line};}
 if value.function=="retainedQueryTape" {return blot_backend_backend_timing::RegionCaller{function:"retainedQueryTape",line:value.line};}
 if value.function=="partialArrayMemberTape" {return blot_backend_backend_timing::RegionCaller{function:"partialArrayMemberTape",line:value.line};}
 if value.function=="startupDependencies" {return blot_backend_backend_timing::RegionCaller{function:"startupDependencies",line:value.line};}
 if value.function=="principalEvidenceRecorder" {return blot_backend_backend_timing::RegionCaller{function:"principalEvidenceRecorder",line:value.line};}
 if value.function=="principalEvidenceRegionInner" {return blot_backend_backend_timing::RegionCaller{function:"principalEvidenceRegionInner",line:value.line};}
 if value.function=="recheckCallProof" {return blot_backend_backend_timing::RegionCaller{function:"recheckCallProof",line:value.line};}
 assert(false);return blot_backend_backend_timing::RegionCaller{};
}
