 // Whether a reference to a pointee of this type, or a byte view, can point
 // into the array.
+// Optional private diagnostics only: no TypeStr/type queries or changed traversal.
+inline void TypeCheck::GlobalReach::Trace(string_view kind, VarDef *holder, VarDef *root,
+                                         bool exact, VarDef *src, TypeExpr *pointee,
+                                         bool byteview, Line at) {
+    if (!trace) return;
+    static size_t lines = 0;
+    if (lines >= 160) return;
+    lines++;
+    auto name = [&](VarDef *v) {
+        if (!v) return string("<none>");
+        auto result = cat(v->name, "@", tc.Where(v->line));
+        auto owner = v->ownerspec ? v->ownerspec : v->classfrom ? v->classfrom->ownerspec : nullptr;
+        if (owner && owner->sf) result += cat("[", owner->sf->qname, "]");
+        return result;
+    };
+    fprintf(stderr, "GOOSE_GLOBAL_REACH kind=%.*s holder=%s root=%s exact=%d src=%s pointee_kind=%d byteview=%d at=%s\n",
+            (int)kind.size(), kind.data(), name(holder).c_str(), name(root).c_str(), (int)exact,
+            name(src).c_str(), pointee ? (int)pointee->kind : -1, (int)byteview,
+            tc.Where(at).c_str());
+    if (lines == 160) fprintf(stderr, "GOOSE_GLOBAL_REACH limit=160\n");
+}
