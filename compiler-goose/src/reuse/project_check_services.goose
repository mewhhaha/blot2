// Producer services inspect the exact retained catalog selected by this check.
namespace blot_reuse_project_check;
import .project_check;
import backend.opaque_storage;
fn originalBindingName(self_:const Engine&,target:ExternalTarget)->blot_support::Option<const u8[:]> {let producer=self_.catalogModule(target.unit);if !producer.present {return blot_support::none<const u8[:]>();}return blot_support::some(self_.source.symbols.get(producer.value.declaration(target.binding).name));}
fn originalUnitOrigin(self_:const Engine&,unit:u32)->blot_support::Option<blot_reuse_body_check_cache::Digest> {if unit==0 || unit>self_.source.units.len {return blot_support::none<blot_reuse_body_check_cache::Digest>();}var hash=blot_support_blake3::init();hash.update("body original module");hash.update(self_.source.filename(unit));return blot_support::some(hash.final());}
fn originalBindingClosedRows(self_:const Engine&,target:ExternalTarget)->blot_support::Option<blot_reuse_body_check_cache::Digest> {
 let module=self_.catalogModule(target.unit);if !module.present {return blot_support::none<blot_reuse_body_check_cache::Digest>();}match module.value.owner {
 typed payload=>{let typed .= payload.value;if target.binding>=typed.bindings.len {return blot_support::none<blot_reuse_body_check_cache::Digest>();}let binding=typed.bindings[target.binding];return blot_reuse_body_check_cache::closedRowsDigest(blot_check_frozen_types::fromStore(typed.types),binding.ty,binding.scheme,self_.source.symbols);},
 frozen payload=>{let frozen .= payload.value;if target.binding>=frozen.bindings.len {return blot_support::none<blot_reuse_body_check_cache::Digest>();}let binding=frozen.bindings[target.binding];return blot_reuse_body_check_cache::closedRowsDigest(blot_check_frozen_types::Source.frozen{frozen.graph, ..},binding.ty,binding.scheme,self_.source.symbols);},_=>{return blot_support::none<blot_reuse_body_check_cache::Digest>();},
 }}
fn producerCapability(self_:const Engine&,target:ExternalTarget)->blot_support::Option<blot_check_check::ProducerCapability> {
 let module=self_.catalogModule(target.unit);if !module.present {return blot_support::none<blot_check_check::ProducerCapability>();}match module.value.owner {
 typed payload=>{let owner .= payload.value;if target.binding>=owner.bindings.len || owner.bindings[target.binding].external.present {return blot_support::none<blot_check_check::ProducerCapability>();}let binding=owner.bindings[target.binding];return blot_support::some(blot_check_check::ProducerCapability{flow:binding.capability_flow,parameters:binding.capability_parameters,recipe:blot_support::some(blot_check_check::CapabilitySource{blot_check_check::Callees.live{blot_check_check::liveCallees(owner)},target.binding, ..}), ..});},
 frozen payload=>{let owner .= payload.value;if target.binding>=owner.bindings.len || owner.bindings[target.binding].external.present {return blot_support::none<blot_check_check::ProducerCapability>();}let binding=owner.bindings[target.binding];return blot_support::some(blot_check_check::ProducerCapability{flow:binding.capability_flow,parameters:binding.capability_parameters,recipe:blot_support::some(blot_check_check::CapabilitySource{blot_check_check::Callees.frozen{blot_check_check::frozenCallees(owner)},target.binding, ..}), ..});},
 source payload=>{let owner .= payload.value;if target.binding>=owner.declarations.len || owner.declarations[target.binding].external.present {return blot_support::none<blot_check_check::ProducerCapability>();}let declaration=owner.declarations[target.binding];return blot_support::some(blot_check_check::ProducerCapability{flow:declaration.capability_flow,parameters:declaration.capability_parameters, ..});},inactive=>{return blot_support::none<blot_check_check::ProducerCapability>();},
 }}
fn producerStorage(self_:const Engine&,identity_:blot_check_types::NominalIdentity)->blot_support::Option<blot_backend_opaque_storage::Storage> {
 if identity_.unit==0 || identity_.unit>self_.source.units.len {return blot_support::none<blot_backend_opaque_storage::Storage>();}let module=self_.catalogModule(identity_.unit);if !module.present {return blot_support::none<blot_backend_opaque_storage::Storage>();}for nominal in module.value.catalog().nominals {if nominal.is_opaque && nominal.identity==identity_ {return blot_support::some(nominal.storage);}}return blot_support::none<blot_backend_opaque_storage::Storage>();
}
fn originalBindingCapabilities(self_:const Engine&,target:ExternalTarget)->blot_support::Option<blot_reuse_body_check_cache::Digest> {
 let module=self_.catalogModule(target.unit);if !module.present {return blot_support::none<blot_reuse_body_check_cache::Digest>();}match module.value.owner {
 typed payload=>{let owner .= payload.value;if target.binding>=owner.bindings.len {return blot_support::none<blot_reuse_body_check_cache::Digest>();}let binding=owner.bindings[target.binding];let recipe=owner.capability_contracts.header(target.binding,binding.capability_parameters.arity());return blot_reuse_body_check_cache::capabilityDigest(self_.source.symbols,binding,recipe);},
 frozen payload=>{let owner .= payload.value;if target.binding>=owner.bindings.len {return blot_support::none<blot_reuse_body_check_cache::Digest>();}let binding=owner.bindings[target.binding];let recipe=owner.capability_contracts.header(target.binding,binding.capability_parameters.arity());return blot_reuse_body_check_cache::capabilityDigest(self_.source.symbols,binding,recipe);},_=>{return blot_support::none<blot_reuse_body_check_cache::Digest>();},
 }}
fn originalQualification(self_:const Engine&,unit:u32,span:Span)->blot_support::Option<blot_reuse_body_check_cache::Digest> {
 let module=self_.catalogModule(unit);if !module.present {return blot_support::none<blot_reuse_body_check_cache::Digest>();}match module.value.owner {
 typed payload=>{let typed .= payload.value;if typed.bindings.len>4096 {return blot_support::none<blot_reuse_body_check_cache::Digest>();}var budget:i64=4096;for binding in typed.bindings {let digest=blot_reuse_body_check_cache::sourceQualificationDigest(self_.source.unit(unit).tree,self_.source.symbols,binding,span,budget);if digest.present {return digest;}}return blot_support::none<blot_reuse_body_check_cache::Digest>();},
 frozen payload=>{return frozenQualification(self_,unit,span,payload.value);},_=>{return blot_support::none<blot_reuse_body_check_cache::Digest>();},
 }}
fn declaredAt(predicate:blot_check_types::Obligation,unit:u32,span:Span,origin:Span)->bool {return predicate.explicit && predicate.qualification_unit==unit && predicate.qualification_span.present && predicate.qualification_span.value==span && origin.start>=span.start && origin.end<=span.end && origin.start<=origin.end;}
fn frozenQualification(self_:const Engine&,unit:u32,span:Span,frozen:const blot_reuse_principal_interface::Interface&)->blot_support::Option<blot_reuse_body_check_cache::Digest> {
 let compiled .= self_.result.compiledModule(self_.source,unit);if !compiled || frozen.bindings.len>4096 || frozen.obligations.len>4096 || frozen.obligation_spans.len!=frozen.obligations.len {return blot_support::none<blot_reuse_body_check_cache::Digest>();}
 var owner=blot_support::none<u32>();for binding,index in frozen.bindings {if binding.kind!=blot_reuse_principal_interface::Kind.global {continue;}let requirements=binding.scheme.obligations;for offset in requirements.len {let at=requirements.start+offset;if !declaredAt(frozen.obligations[at],unit,span,frozen.obligation_spans[at]) {continue;}if owner.present && owner.value!=index {return blot_support::none<blot_reuse_body_check_cache::Digest>();}owner=blot_support::some(index as u32);}}
 if !owner.present {
 let core:const blot_check_core::Module& =compiled.core;if core.bindings.len>4096 || core.obligations.len>4096 {return blot_support::none<blot_reuse_body_check_cache::Digest>();}var declaration=blot_support::none<u32>();var remaining:i64=4096;
 for local in core.bindings {if remaining==0 {return blot_support::none<blot_reuse_body_check_cache::Digest>();}remaining-=1;if local.kind!=blot_reuse_principal_interface::Kind.local {continue;}var declared=false;let requirements=local.scheme.obligations;for predicate in core.obligations[requirements.start..requirements.start+requirements.len] {if remaining==0 {return blot_support::none<blot_reuse_body_check_cache::Digest>();}remaining-=1;if !predicate.explicit || predicate.qualification_unit!=unit || !predicate.qualification_span.present || predicate.qualification_span.value!=span {continue;}if predicate.span.start<span.start || predicate.span.end>span.end || predicate.span.start>predicate.span.end {continue;}declared=true;}
 if !declared {continue;}for enclosing,index in core.bindings {if remaining==0 {return blot_support::none<blot_reuse_body_check_cache::Digest>();}remaining-=1;if enclosing.kind!=blot_reuse_principal_interface::Kind.global || enclosing.body_id==0 || enclosing.body_id>=core.bodies.len {continue;}if span.start<enclosing.span.start || span.end>enclosing.span.end || local.span.start<enclosing.span.start || local.span.end>enclosing.span.end {continue;}if declaration.present && declaration.value!=index {return blot_support::none<blot_reuse_body_check_cache::Digest>();}declaration=blot_support::some(index as u32);}}
 if !declaration.present || declaration.value>=frozen.bindings.len {return blot_support::none<blot_reuse_body_check_cache::Digest>();}let index=declaration.value;let enclosing=core.bindings[index];let body=core.bodies[enclosing.body_id];if body.binding!=index {return blot_support::none<blot_reuse_body_check_cache::Digest>();}let principal=frozen.bindings[index];return blot_reuse_body_check_cache::localQualificationDigest(self_.source.symbols.get(principal.name),principal.private,body.runtime,enclosing.span,span);
 }
 let index=owner.value;if index>=compiled.core.bindings.len {return blot_support::none<blot_reuse_body_check_cache::Digest>();}let binding=compiled.core.bindings[index];if binding.kind!=blot_reuse_principal_interface::Kind.global || binding.body_id==0 || binding.body_id>=compiled.core.bodies.len {return blot_support::none<blot_reuse_body_check_cache::Digest>();}let body=compiled.core.bodies[binding.body_id];if body.binding!=index {return blot_support::none<blot_reuse_body_check_cache::Digest>();}let principal=frozen.bindings[index];return blot_reuse_body_check_cache::qualificationDigest(self_.source.symbols.get(principal.name),principal.private,body.runtime,binding.span,span);
}
