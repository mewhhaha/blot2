        Tag.suite,Tag.product,Tag.record,Tag.array,Tag.array_op,Tag.storage => { let flow,err = self.operands(self.module.extra[node.a..node.a+node.b],depth); if err != Error.none || flow == Outcome.exit { return flow,err; } },
