reusable var ragged_regions: RaggedRegion[>..]=[];
recursive fn raggedBlock(self_: Session&,owner: i64,id: u32,frame: Frame) -> blot_support::Option<Flow>,Error { let module=self_.units[owner]; let body=module.children(id); if body.len<3||module.node(body[0]).tag!=blot_check_core::Tag.bind { return blot_support::none<Flow>(),blot_error::Error.none; } let initial=module.node(body[0]).b; if module.node(initial).tag!=blot_check_core::Tag.array||module.children(initial).len!=0 { return blot_support::none<Flow>(),blot_error::Error.none; } var facts=RaggedFacts {session:self_,owner:owner,frame:frame,module:module,operations:[default<RaggedOperation>();256],fields:[0;256], ..}; let diagnostic=self_.diagnostic; let prepared,error=prepare(facts,id); if error==blot_error::Error.declined { self_.diagnostic=diagnostic; return blot_support::none<Flow>(),blot_error::Error.none; } if error!=blot_error::Error.none||!prepared { return blot_support::none<Flow>(),error; } let plan=blot_backend_ragged_builder::analyze(module,id,facts); if !plan.present { return blot_support::none<Flow>(),blot_error::Error.none; } var available=self_.options.max_children-constantChildCount(self_); if available<0 { available=0; } if available>4194303 { available=4194303; } var probe=blot_eval_eval_ragged_count::Counter<RaggedFacts> {adapter:facts,plan:plan.value,remaining:self_.ragged_probe_limit,limit:available as u32}; let count,present=probe.run(); self_.counters.ragged_probe_visits+=probe.visits as u64; if !present { self_.counters.ragged_probe_declines++; return blot_support::none<Flow>(),blot_error::Error.none; } let children=ragged_children_pool.alloc_slice(count); let region_index=ragged_regions.alloc_index(RaggedRegion {owner:owner,frame:frame,plan:plan.value,children:children}); let region: RaggedRegion& =ragged_regions[region_index]; self_.ragged_reserved_children+=count; declineConstant(self_); self_.ragged_region .= region; let outcome,e=raggedBlockRun(self_,owner,id,frame,region,count); self_.ragged_region .= null; if region.reserved { self_.ragged_reserved_children-=count; } ragged_children_pool.free_slice(children); ragged_regions.free(region_index); return outcome,e; }
recursive fn raggedBlockRun(self_: Session&,owner: i64,id: u32,frame: Frame,region: RaggedRegion&,count: u32) -> blot_support::Option<Flow>,Error { let outcome,error=blockChildren(self_,owner,id,frame); if error!=blot_error::Error.none { return blot_support::none<Flow>(),error; } match outcome { value value=>{ assert(region.written==region.children.len); var result=value.value; if !region.published.present&&count!=0 { self_.ragged_reserved_children-=count; region.reserved=false; let published,e=makeAggregate(self_,owner,id,blot_eval_eval_values::ValueKind.list,0,0,region.children); if e!=blot_error::Error.none { return blot_support::none<Flow>(),e; } result=published; } self_.counters.ragged_staged_regions++; self_.counters.ragged_selected+=count; self_.counters.ragged_published_children+=count; return blot_support::some<Flow>(Flow.value{result}),blot_error::Error.none; },_=>{ return blot_support::some(outcome),blot_error::Error.none; }, } }

fn withSession<C,F>(units: const Module[:],allocation_owner: u64,context: C&) -> Error { let session,error=initOwnedSession(units,allocation_owner); if error!=blot_error::Error.none { return error; } assert(session); let result=F(context,session); deinitOwnedSession(session); return result; }

struct SessionOwner { session: u32,contexts: u32,tables: SessionTables,generation: u64,live: bool=true }
reusable var session_owners: SessionOwner[>..]=[];
var next_session_owner_generation: u64=1;
fn initOwnedSession(units: const Module[:],allocation_owner: u64) -> Session?,Error { assert(allocation_owner!=0); return initOwnedSessionFromParent(units,allocation_owner,null); }
fn deinitOwnedSession(session: Session&) { if session.session_owner_slot==0 { return; } let at=session.session_owner_slot-1; assert(at<session_owners.len&&session_owners[at].live&&session_owners[at].generation==session.session_owner_generation); let owner: SessionOwner& =session_owners[at]; let contexts: OwnedSessionContexts& =owned_session_contexts[owner.contexts]; let state_index=contexts.state; deinit(session); detachSession(session); session.session_owner_slot=0; session.session_owner_generation=0; live_sessions.free(owner.session); session_context_states[state_index].live=false; session_context_states.free(state_index); owned_session_contexts.free(owner.contexts); owner.tables.deinit(); owner.live=false; session_owners.free(at); }

fn createOwnedSession(parent: const Session?,units: const Module[:],tables: SessionTables,storage: blot_eval_eval_values::Store&,providers: blot_backend_provider_chain::Store&,proofs: blot_eval_implementation_evidence::Store&,regions: RegionStorage&,specializations: SpecializationCaches&,retained: RetainedRecords&) -> Session,Error { if parent { return initShared(canonicalReadSession(parent),tables,storage,providers,proofs,regions,specializations,retained); } return init(tables,units,storage,providers,proofs,regions,specializations,retained); }
fn initOwnedSessionFromParent(units: const Module[:],allocation_owner: u64,parent: const Session?) -> Session?,Error {
 let storage,storage_error=blot_eval_eval_values::initPooledRef(); if storage_error!=blot_error::Error.none { return null,storage_error; } assert(storage);
 let proofs,proofs_error=blot_eval_implementation_evidence::initPooledRef(); if proofs_error!=blot_error::Error.none { storage.deinit(); return null,proofs_error; } assert(proofs);
 let providers,providers_error=blot_backend_provider_chain::initPooledRef(); if providers_error!=blot_error::Error.none { proofs.deinit(); storage.deinit(); return null,providers_error; } assert(providers);
 let source_owners,source_error=blot_eval_source_owners::initPooled(); if source_error!=blot_error::Error.none { providers.deinit(); proofs.deinit(); storage.deinit(); return null,source_error; }
 let summaries,summary_error=initCallSummaries(); if summary_error!=blot_error::Error.none { source_owners.deinit(); providers.deinit(); proofs.deinit(); storage.deinit(); return null,summary_error; }
 let lexical,lexical_error=blot_eval_lexical_capture_inputs::initPooled(); if lexical_error!=blot_error::Error.none { releaseUninitializedSummaries(summaries); source_owners.deinit(); providers.deinit(); proofs.deinit(); storage.deinit(); return null,lexical_error; }
 let recipes,recipe_error=blot_eval_body_recipe::initPooled(); if recipe_error!=blot_error::Error.none { lexical.deinit(); releaseUninitializedSummaries(summaries); source_owners.deinit(); providers.deinit(); proofs.deinit(); storage.deinit(); return null,recipe_error; }
 let closed,closed_error=blot_eval_closed_source_types::initFactsPooled(); if closed_error!=blot_error::Error.none { recipes.deinit(); lexical.deinit(); releaseUninitializedSummaries(summaries); source_owners.deinit(); providers.deinit(); proofs.deinit(); storage.deinit(); return null,closed_error; }
 let tables,tables_error=initSessionTables(); if tables_error!=blot_error::Error.none { closed.deinit(); recipes.deinit(); lexical.deinit(); releaseUninitializedSummaries(summaries); source_owners.deinit(); providers.deinit(); proofs.deinit(); storage.deinit(); return null,tables_error; }
 let state_index=session_context_states.alloc_index(SessionContextState {live:true}); let state: SessionContextState& =session_context_states[state_index];
 let context_index=owned_session_contexts.alloc_index(OwnedSessionContexts {state:state_index as u32,regions:RegionStorage {blot_eval_region_arena::init(allocation_owner),source_owners,state.definitions,state.definition_units},specializations:SpecializationCaches {summaries,lexical,blot_eval_canonical_specialization::init(),recipes,closed,state.validated_calls,state.plain_nominals},retained:RetainedRecords {state.constant_records,state.specialization_receipts}});
 let owners: OwnedSessionContexts& =owned_session_contexts[context_index]; let value,error=createOwnedSession(parent,units,tables,storage,providers,proofs,owners.regions,owners.specializations,owners.retained);
 let session_index=live_sessions.alloc_index(value); let session: Session& =live_sessions[session_index]; if error!=blot_error::Error.none { deinit(session); detachSession(session); live_sessions.free(session_index); state.live=false; session_context_states.free(state_index); owned_session_contexts.free(context_index); tables.deinit(); return null,error; }
 if next_session_owner_generation==0xffffffffffffffff||session_owners.len>=0xffffffff { deinit(session); detachSession(session); live_sessions.free(session_index); state.live=false; session_context_states.free(state_index); owned_session_contexts.free(context_index); tables.deinit(); return null,blot_error::Error.out_of_memory; }
 let generation=next_session_owner_generation; next_session_owner_generation++; let at=session_owners.alloc_index(SessionOwner {session:session_index as u32,contexts:context_index as u32,tables:tables,generation:generation,live:true}); session.session_owner_slot=(at+1) as u32; session.session_owner_generation=generation; return session,blot_error::Error.none;
}

fn releaseUninitializedSummaries(self_: CallSummaries&) { assert(self_.jobs.len==0); self_.principals.deinit(); self_.normalized_principals.deinit(); self_.components.deinit(); let at=self_.lease-1; let state: SummaryOwnerState& =summary_owners[at]; release(state.keys); state.jobs.deinit(); state.stack.deinit(); release(state.active); release(state.active_lexical); release(state.eligibility); release(state.checked_requirements); release(state.completed_interfaces); release(state.public_requirements); release(state.constant_requirements); release(state.source_declines); release(state.normalized_declines); release(state.open_principals); release(state.result_principals); state.live=false; summary_owners.free(at); self_.lease=0; }
fn detachSession(self_: Session&) { self_.units=default<const blot_eval_core_eval::Module[:]>(); self_.binding_offsets=default<const i64[:]>(); self_.node_offsets=default<const i64[:]>(); self_.slots=default<blot_eval_core_eval::Slot[:]>(); self_.generator .= null; self_.timing .= null; self_.constant_recorder .= null; self_.receipt_tape .= null; self_.member_trace .= null; self_.refinement_observation .= null; self_.principal_reads .= null; self_.principal_plain_reads .= null; self_.indexed_region .= null; self_.ragged_region .= null; self_.diagnostic=blot_support::none<Diagnostic>(); self_.diagnostic_context=DiagnosticContext {}; self_.specialization_origin=blot_support::none<SourceLocation>(); self_.generator_origin=blot_support::none<blot_check_staging_origins::Source>(); }

fn seedScalarInputs(self_: Session&,current: const Session&) -> Error { if !(blot_support::same_slice_identity(self_.units,current.units))||self_.units.len!=current.units.len { return blot_error::Error.declined; } for module,owner in self_.units { let start=self_.binding_offsets[owner]; for old,index in current.slots[start..start+module.bindings.len] { if old.state!=State.complete||module.bindings[index].kind!=blot_reuse_principal_interface::Kind.global { continue; } let body=module.body(index as u32); if body==null||body.runtime { continue; } let input=valueScalar(current,old.value); if !input.present { continue; } var expected: u32=0; if input.value.scalar==blot_backend_runtime_ir::SC_unit { expected=blot_check_types::unit; } else if input.value.scalar==blot_backend_runtime_ir::SC_bool { expected=blot_check_types::boolean; } else if input.value.scalar==blot_backend_runtime_ir::SC_u32 { expected=blot_check_types::u32_type; } else if input.value.scalar==blot_backend_runtime_ir::SC_f32 { expected=blot_check_types::f32_type; } else { continue; } if valueEvidence(current,old.value)!=expected { continue; } let copied,error=makeScalar(self_,owner,body.root,input.value); if error!=blot_error::Error.none { return error; } self_.slots[start+index]=Slot {state:State.complete,value:copied}; } } return blot_error::Error.none; }
struct RecheckProof { session: Session&,target: Target,expected: u32,result: bool=false }
fn recheckCallProof(self_: Session&,reference: BindingRef,expected: u32) -> bool,Error { let first,error=target(self_,blot_support::none<i64>(),reference); if error!=blot_error::Error.none { return false,error; } let selected,e=external(self_,first); if e!=blot_error::Error.none { return false,e; } let module=self_.units[selected.unit]; let body=module.body(selected.binding); if body==null||module.binding(selected.binding).kind!=blot_reuse_principal_interface::Kind.global||(body.runtime&&!body.is_function) { return false,blot_error::Error.none; } var context=RecheckProof {self_,selected,expected}; let result=withRegion<RecheckProof>(self_,context,blot_backend_backend_timing::RegionCaller {function:"recheckCallProof",line:2948},recheckProofRegion); return context.result,result; }
fn recheckProofRegion(context: RecheckProof&,region: ClosureRegion&) -> Error { let module=context.session.units[context.target.unit]; let body=module.body(context.target.binding); assert(body!=null); let arrow,error=firstOrderArrow(region,context.expected); if error!=blot_error::Error.none { return evidenceFailure(context.session,context.target.unit,module.span(body.root),error); } if !arrow { return blot_error::Error.none; } let solved,e=bodyEvidenceFull(region,context.target.unit,body.root,module.binding(context.target.binding).ty,body.closed_rows,body.scheme,Expected.semantic {value:context.expected},[],[]); if e!=blot_error::Error.none { return evidenceFailure(context.session,context.target.unit,module.span(body.root),e); } let complete=allConstraintsSolved(region)&&solved.selected.len==0&&region.scratch.sources.len!=0; solved.deinit(); if !complete { return blot_error::Error.none; } let projected,e2=project(region,region.scratch.sources.items[0].root); if e2!=blot_error::Error.none { return evidenceFailure(context.session,context.target.unit,module.span(body.root),e2); } context.result=projected==context.expected; return blot_error::Error.none; }
