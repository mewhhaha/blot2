fn projectionAnnotationArguments(self:Engine&,contract:Contract,member:u32,syntax:const u32[:],source:u32,old:const u32[:],fresh:u32[:],old_rows:const u32[:],fresh_rows:u32[:],shapes:const u32[:],arguments:u32[:])->blot_support::Option<u32>,blot_error::Error {for &variable in fresh {let root,err=self.types.fresh();if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}variable=root;}for &row in fresh_rows {let value,err=self.types.freshEffects();if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}row=value;}for shape,index in shapes {let actual,err=self.parameterArgument(self.parameter_patterns.list(contract.patterns)[index],syntax[index],true,0);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let expected,err=self.types.substituteWithRows(shape,old,fresh,old_rows,fresh_rows);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let err=self.constrain(expected,actual,syntax[index]);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}arguments[index]=actual;}let projection,err=self.types.projection(contract.identity,member,arguments);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if self.defer_associated {return blot_support::some(projection),blot_error::Error.none;}let root,err=self.normalizeAssociated(projection,source,true);return blot_support::some(root),err;}
struct PackEquations {source:u32,quantifier:u32,selections:blot_check_types::List,binders:const u32[:],witnesses:const u32[:]}
struct ProjectionMemo {member:u32,arguments:blot_check_types::List,result:u32}
struct AssociatedMemo {package_probe:bool=false,usage:blot_support::Option<blot_check_usage_check::PooledMemo> = blot_support::none<blot_check_usage_check::PooledMemo>(),package:blot_support::Option<PackEquations> = blot_support::none<PackEquations>(),rows:blot_support_pooled_map::Map<u32,u32> = blot_support_pooled_map::Map<u32,u32>{},types:blot_support_pooled_map::Map<u32,u32> = blot_support_pooled_map::Map<u32,u32>{},projections:blot_support_pooled_buffer::Buffer<ProjectionMemo> = blot_support_pooled_buffer::Buffer<ProjectionMemo>{}}
reusable[] var associated_map_slots:dictionary_slot<u32,u32>[>..];
reusable[] var projection_memo_values:ProjectionMemo[>..];
reusable[] var equation_fields:blot_check_types::Field[>..];
fn AssociatedMemo::deinit(self:AssociatedMemo&) {self.types.deinit(associated_map_slots);self.rows.deinit(associated_map_slots);self.projections.deinit(projection_memo_values);if self.usage.present {self.usage.value.deinit();}}
fn Engine::normalizeAssociated(self:Engine&,root:u32,source:u32,requirements:bool)->u32,blot_error::Error {var memo=AssociatedMemo{};var active=IdBuffer{};let result,err=self.normalizeAssociatedNode(root,source,requirements,memo,active,0);active.deinit(equation_type_ids);memo.deinit();return result,err;}
fn Engine::normalizeAssociatedNode(self:Engine&,root:u32,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64)->u32,blot_error::Error {let id=self.types.head(root,0);let node=self.types.node(id);if id<=blot_check_types::never || node.tag==blot_check_types::Tag.variable || node.tag==blot_check_types::Tag.type_constructor {return id,blot_error::Error.none;}let known .= memo.types.get(id);if known {return known,blot_error::Error.none;}if depth>=256 {let err=self.diagnostic(Code.associated_limit,source);return id,err;}let allowed,err=self.associatedStep(source);if err!=blot_error::Error.none || !allowed {return id,err;}if node.tag==blot_check_types::Tag.projection && memo.package_probe {let result,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}memo.types.insert(id,result,associated_map_slots);return result,blot_error::Error.none;}let result,err=normalizeAssociatedShape(self,id,node,source,requirements,memo,active,depth);if err!=blot_error::Error.none {return 0,err;}memo.types.insert(id,result,associated_map_slots);return result,blot_error::Error.none;}
fn normalizeAssociatedShape(self:Engine&,id:u32,node:blot_check_types::Node,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64)->u32,blot_error::Error {let tag=node.tag;if tag==blot_check_types::Tag.projection || tag==blot_check_types::Tag.nominal || tag==blot_check_types::Tag.product {var span=blot_check_types::List{node.a,node.b};if tag!=blot_check_types::Tag.product {span=blot_check_types::List{start:node.c,len:self.types.nominalArguments(node).len as u32};}let prior=equation_type_ids.alloc_slice(span.len);var children:const u32[:]=[];if tag==blot_check_types::Tag.product {children=self.types.list(span);}else {children=self.types.nominalArguments(node);}for value,index in children {prior[index]=value;}let values=equation_type_ids.alloc_slice(prior.len);let result,err=normalizeAssociatedChildren(self,id,node,source,requirements,memo,active,depth,prior,values);equation_type_ids.free_slice(values);equation_type_ids.free_slice(prior);return result,err;}if tag==blot_check_types::Tag.function {let a,err=self.normalizeAssociatedNode(node.a,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}let b,err=self.normalizeAssociatedNode(node.b,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}let row,err=self.normalizeAssociatedRow(node.c,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}if a==node.a && b==node.b && row==node.c {return id,blot_error::Error.none;}return self.types.functionWithEffects(a,b,row);}if tag==blot_check_types::Tag.record {let fields=equation_fields.alloc_slice(node.b);let result,err=normalizeAssociatedRecord(self,id,node,source,requirements,memo,active,depth,fields);equation_fields.free_slice(fields);return result,err;}if tag==blot_check_types::Tag.array || tag==blot_check_types::Tag.list || tag==blot_check_types::Tag.cursor || tag==blot_check_types::Tag.resolver || tag==blot_check_types::Tag.provider {let child,err=self.normalizeAssociatedNode(node.a,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}var row=node.c;if tag==blot_check_types::Tag.provider {let value,err=self.normalizeAssociatedRow(node.c,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}row=value;}if child==node.a && row==node.c {return id,blot_error::Error.none;}if tag==blot_check_types::Tag.resolver {return self.types.resolver(child);}if tag==blot_check_types::Tag.provider {return self.types.provider(child,row);}return self.types.sequence(tag,child);}if tag==blot_check_types::Tag.usage {let child,err=self.normalizeAssociatedNode(node.a,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}if child==node.a {return id,blot_error::Error.none;}let kind,valid=blot_check_types::usageKindFromCode(node.b);assert(valid);return self.types.usage(child,kind,node.c);}if tag==blot_check_types::Tag.state_provider {let a,err=self.normalizeAssociatedNode(node.a,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}let b,err=self.normalizeAssociatedNode(node.b,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}let c,err=self.normalizeAssociatedNode(node.c,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}if a==node.a && b==node.b && c==node.c {return id,blot_error::Error.none;}return self.types.stateProvider(a,b,c);}return id,blot_error::Error.none;}
fn normalizeAssociatedChildren(self:Engine&,id:u32,node:blot_check_types::Node,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64,prior:const u32[:],values:u32[:])->u32,blot_error::Error {var changed=false;for child,index in prior {let next,err=self.normalizeAssociatedNode(child,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}changed=changed || next!=child;values[index]=next;}if node.tag==blot_check_types::Tag.product {if !changed {return id,blot_error::Error.none;}return self.types.product(values);}if node.tag==blot_check_types::Tag.nominal {if !changed {return id,blot_error::Error.none;}return self.types.nominal(Identity{node.a,node.b},values);}if memo.package.present {return self.packageProjection(id,values,memo.package.value,source);}return normalizeAssociatedProjection(self,id,node,source,requirements,memo,active,depth,values,changed);}
fn normalizeAssociatedRecord(self:Engine&,id:u32,node:blot_check_types::Node,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64,fields:blot_check_types::Field[:])->u32,blot_error::Error {var changed=false;for index in 0..node.b {let field=self.types.recordField(node,index);let next,err=self.normalizeAssociatedNode(field.ty,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}changed=changed || next!=field.ty;fields[index]=blot_check_types::Field{name:field.name,ty:next};}if !changed {return id,blot_error::Error.none;}return self.types.record(fields);}
fn normalizeAssociatedProjection(self:Engine&,id:u32,node:blot_check_types::Node,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64,arguments:const u32[:],changed:bool)->u32,blot_error::Error {let identity=Identity{node.a,node.b};let selected .= self.catalogs.contract_identities.get(identity);if !selected {let err=self.diagnostic(Code.missing_type_member,source);return id,err;}let index=selected;let contract=self.contracts[index];let name=self.types.projectionMember(node);let selected_member=self.memberIndex(contract,name);if !selected_member.present {let err=self.diagnostic(Code.missing_type_member,source);return id,err;}let member=selected_member.value;if inList(active.items,member) {let err=self.diagnostic(Code.recursive_associated_type,source);return id,err;}for cached in memo.projections.items {let allowed,err=self.associatedStep(source);if err!=blot_error::Error.none || !allowed {return id,err;}if cached.member!=member || cached.arguments.len!=arguments.len {continue;}var same=true;for before,ordinal in self.types.list(cached.arguments) {let equal,err=self.types.equalSymbolic(before,arguments[ordinal]);if err!=blot_error::Error.none {return 0,err;}if !equal {same=false;break;}}if same {self.counters.projection_memo_hits+=1;return cached.result,blot_error::Error.none;}}let err=self.resolveMember(member);if err!=blot_error::Error.none {return 0,err;}let old=equation_type_ids.alloc_slice(contract.variables.len);for value,ordinal in self.types.list(contract.variables) {old[ordinal]=value;}let fresh=equation_type_ids.alloc_slice(old.len);let old_rows=equation_type_ids.alloc_slice(contract.row_variables.len);for value,ordinal in self.types.list(contract.row_variables) {old_rows[ordinal]=value;}let fresh_rows=equation_type_ids.alloc_slice(old_rows.len);let shapes=equation_type_ids.alloc_slice(contract.parameters.len);for value,ordinal in self.types.list(contract.parameters) {shapes[ordinal]=value;}let result,err=normalizeAssociatedProjectionBound(self,id,identity,name,index,contract,member,source,requirements,memo,active,depth,arguments,changed,old,fresh,old_rows,fresh_rows,shapes);equation_type_ids.free_slice(shapes);equation_type_ids.free_slice(fresh_rows);equation_type_ids.free_slice(old_rows);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old);return result,err;}
fn normalizeAssociatedProjectionBound(self:Engine&,id:u32,identity:Identity,name:u32,index:u32,contract:Contract,member_index:u32,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64,arguments:const u32[:],changed:bool,old:const u32[:],fresh:u32[:],old_rows:const u32[:],fresh_rows:u32[:],shapes:const u32[:])->u32,blot_error::Error {let member=self.contract_members[member_index];for &variable in fresh {let root,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}variable=root;}for &row in fresh_rows {let root,err=self.types.freshEffects();if err!=blot_error::Error.none {return 0,err;}row=root;}for shape,ordinal in shapes {let expected,err=self.types.substituteWithRows(shape,old,fresh,old_rows,fresh_rows);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(expected,arguments[ordinal],source);if err!=blot_error::Error.none {return 0,err;}}let equation,err=self.implementationEquation(identity,name,arguments);if err!=blot_error::Error.none {return 0,err;}if equation.present {return equation.value,blot_error::Error.none;}let provisional,err=self.provisionalEquation(identity,name,arguments);if err!=blot_error::Error.none {return 0,err;}if provisional.present {let err=active.append(member_index);if err!=blot_error::Error.none {return 0,err;}let result,error=self.normalizeAssociatedNode(provisional.value,source,requirements,memo,active,depth+1);active.resize(active.items.len-1);return result,error;}let lexical,err=self.contractGiven(identity,arguments);if err!=blot_error::Error.none {return 0,err;}var selected=blot_support::none<u32>();if contract.requires_implementation && !lexical {let proof,err=self.selectImplementation(identity,arguments,source);if err!=blot_error::Error.none {return 0,err;}selected=proof;}if selected.present && member.kind!=blot_reuse_principal_interface::ContractMemberKind.defined_type {let result=self.selectedMember(selected.value,name);if result.present {return result.value.root,blot_error::Error.none;}}if requirements {let err=normalizeAssociatedRequirements(self,index,identity,source,arguments,old,fresh,old_rows,fresh_rows,selected,lexical);if err!=blot_error::Error.none {return 0,err;}}if member.kind!=blot_reuse_principal_interface::ContractMemberKind.defined_type {if !changed {return id,blot_error::Error.none;}return self.types.projection(identity,name,arguments);}let err=active.append(member_index);if err!=blot_error::Error.none {return 0,err;}let result,error=normalizeAssociatedExpansion(self,member,source,requirements,memo,active,depth,arguments,old,fresh,old_rows,fresh_rows,member_index);active.resize(active.items.len-1);return result,error;}
fn normalizeAssociatedRequirements(self:Engine&,index:u32,identity:Identity,source:u32,arguments:const u32[:],old:const u32[:],fresh:const u32[:],old_rows:const u32[:],fresh_rows:const u32[:],selected:blot_support::Option<u32>,lexical:bool)->blot_error::Error {let err=self.resolveContract(index);if err!=blot_error::Error.none {return err;}let contract=self.contracts[index];for predicate in self.contract_predicates[contract.predicates.start..contract.predicates.start+contract.predicates.len] {let instantiated,err=self.substitutePredicate(predicate,old,fresh,old_rows,fresh_rows);if err!=blot_error::Error.none {return err;}instantiated.source=source;instantiated.explicit=true;instantiated.qualification_unit=self.unit;instantiated.qualification_span=self.tree.span(source);if instantiated.kind==blot_check_types::ObligationKind.type_eq {let same,err=self.types.equalSymbolic(instantiated.ty,instantiated.result);if err!=blot_error::Error.none {return err;}if same {continue;}}if self.closed_type_variables && !self.implicit_row_parameters && self.current==0 {let open,err=self.requirementOpen(instantiated);if err!=blot_error::Error.none {return err;}if open {let err=self.diagnostic(Code.missing_predicate,source);if err!=blot_error::Error.none {return err;}}}let err=self.appendPending(PendingObligation{owner:self.current,value:instantiated,suspended:true});if err!=blot_error::Error.none {return err;}}if contract.requires_implementation && !selected.present && !lexical {let pack,err=self.types.product(arguments);if err!=blot_error::Error.none {return err;}let requirement=blot_check_types::Obligation{kind:blot_check_types::ObligationKind.contract,identity:identity,ty:pack,source:source,explicit:true};if self.closed_type_variables && !self.implicit_row_parameters && self.current==0 && !self.checking_implementation.present {var code=Code.missing_implementation;let open,err=self.requirementOpen(requirement);if err!=blot_error::Error.none {return err;}if open {code=Code.missing_predicate;}let err=self.diagnostic(code,source);if err!=blot_error::Error.none {return err;}}let err=self.appendPending(PendingObligation{owner:self.current,value:requirement,suspended:true});if err!=blot_error::Error.none {return err;}}return blot_error::Error.none;}
fn normalizeAssociatedExpansion(self:Engine&,member:ContractMember,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64,arguments:const u32[:],old:const u32[:],fresh:const u32[:],old_rows:const u32[:],fresh_rows:const u32[:],member_index:u32)->u32,blot_error::Error {let expanded,err=self.types.substituteWithRows(member.root,old,fresh,old_rows,fresh_rows);if err!=blot_error::Error.none {return 0,err;}let normalized,err=self.normalizeAssociatedNode(expanded,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}if !memo.usage.present {memo.usage=blot_support::some(blot_check_usage_check::PooledMemo{});}let contains,err=blot_check_usage_check::containsNominalMemoWork(self.types,self.nominals,normalized,self.associated_usage_work,memo.usage.value);if err!=blot_error::Error.none {return 0,err;}if contains {let err=self.diagnostic(Code.usage_evidence_mismatch,source);if err!=blot_error::Error.none {return 0,err;}}let span,err=self.types.saveList(arguments);if err!=blot_error::Error.none {return 0,err;}let err=blot_support_pooled_buffer::push(memo.projections,ProjectionMemo{member:member_index,arguments:span,result:normalized},projection_memo_values);return normalized,err;}
fn Engine::normalizeAssociatedRow(self:Engine&,root:u32,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64)->u32,blot_error::Error {let known .= memo.rows.get(root);if known {return known,blot_error::Error.none;}if depth>=256 {return 0,blot_error::Error.type_limit;}let id,err=self.types.resolveEffects(root,0);if err!=blot_error::Error.none {return 0,err;}let row=self.types.row(id);let labels=equation_type_ids.alloc_slice(row.labels.len);for value,index in self.types.rowLabels(id) {labels[index]=value;}let result,error=normalizeAssociatedLabels(self,id,row,source,requirements,memo,active,depth,labels);equation_type_ids.free_slice(labels);if error!=blot_error::Error.none {return 0,error;}memo.rows.insert(root,result,associated_map_slots);return result,blot_error::Error.none;}
fn normalizeAssociatedLabels(self:Engine&,id:u32,row:blot_check_effects::Row,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64,labels:u32[:])->u32,blot_error::Error {var changed=false;for &label in labels {let err=self.types.chargeProjection();if err!=blot_error::Error.none {return 0,err;}let operation=self.types.operation(label);let arguments=equation_type_ids.alloc_slice(self.types.operationArguments(label).len);for value,index in self.types.operationArguments(label) {arguments[index]=value;}let next,error=normalizeAssociatedOperation(self,operation,source,requirements,memo,active,depth,arguments);equation_type_ids.free_slice(arguments);if error!=blot_error::Error.none {return 0,error;}changed=changed || next!=label;label=next;}if !changed {return id,blot_error::Error.none;}let result,err=self.types.effects.rowAt(labels,row.tail,row.cursor);return result,blot_check_types::effectError(err);}
fn normalizeAssociatedOperation(self:Engine&,operation:blot_check_types::Operation,source:u32,requirements:bool,memo:AssociatedMemo&,active:IdBuffer&,depth:i64,arguments:u32[:])->u32,blot_error::Error {for &argument in arguments {let root,err=self.normalizeAssociatedNode(argument,source,requirements,memo,active,depth+1);if err!=blot_error::Error.none {return 0,err;}argument=root;}return self.types.internScopedOperation(operation.identity,operation.instance,arguments);}
fn Engine::validateMemberRequirements(self:Engine&,index:u32)->blot_error::Error {let member=self.contract_members[index];if member.root==0 || member.contract.unit!=self.unit {return blot_error::Error.none;}let contract_index .= self.catalogs.contract_identities.get(member.contract);let contract=self.contracts[contract_index];let source .= self.member_sources.get(index);let start=self.pending.len;let err=validateMemberRequirementsBody(self,member,contract,source,start);self.pending.resize(start);return err;}
fn validateMemberRequirementsBody(self:Engine&,member:ContractMember,contract:Contract,source:u32,start:i64)->blot_error::Error {let normalized,err=self.normalizeAssociated(member.root,source,true);if err!=blot_error::Error.none {return err;}var cursor=start;while cursor<self.pending.len {let pending=self.pending[cursor];let wanted=pending.value;if wanted.kind==blot_check_types::ObligationKind.contract && wanted.identity==contract.identity {cursor+=1;continue;}var supplied=false;for given in self.contract_predicates[contract.predicates.start..contract.predicates.start+contract.predicates.len] {let same,err=self.unifyRequirement(wanted,given);if err!=blot_error::Error.none {return err;}if same {supplied=true;break;}}if supplied {cursor+=1;continue;}let open,err=self.requirementOpen(wanted);if err!=blot_error::Error.none {return err;}if open || wanted.kind==blot_check_types::ObligationKind.contract {let err=self.diagnostic(Code.missing_predicate,source);if err!=blot_error::Error.none {return err;}cursor+=1;continue;}self.pending[cursor].suspended=false;let attempted,err=self.attemptPending(cursor,self.pending[cursor]);if err!=blot_error::Error.none {return err;}if !self.pending[cursor].solved {let err=self.diagnostic(Code.missing_predicate,source);if err!=blot_error::Error.none {return err;}}cursor+=1;}return blot_error::Error.none;}
fn Engine::constructorStorageType(self:Engine&,index:u32)->u32,blot_error::Error {return self.constructorUse(index,true);}
fn Engine::canonicalRecordType(self:Engine&,record:blot_check_types::Node)->u32,blot_error::Error {if record.b==1 {return self.types.recordField(record,0).ty,blot_error::Error.none;}let fields=equation_type_ids.alloc_slice(record.b);for index in 0..record.b {fields[index]=self.types.recordField(record,index).ty;}let root,err=self.types.product(fields);equation_type_ids.free_slice(fields);return root,err;}
fn Engine::constructorUse(self:Engine&,index:u32,storage:bool)->u32,blot_error::Error {let metadata=self.constructors[index];let principal=metadata.scheme;var root=principal.root;if storage && metadata.payload!=0 && self.types.node(metadata.payload).tag==blot_check_types::Tag.record {let value,err=self.types.function(metadata.payload,self.types.node(principal.root).b);if err!=blot_error::Error.none {return 0,err;}root=value;}let old=equation_type_ids.alloc_slice(principal.variables.len);for value,index in self.types.list(principal.variables) {old[index]=value;}let fresh=equation_type_ids.alloc_slice(old.len);let result,err=constructorUseVariables(self,root,old,fresh);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old);return result,err;}
fn constructorUseVariables(self:Engine&,root:u32,old:const u32[:],fresh:u32[:])->u32,blot_error::Error {for &id in fresh {let value,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}id=value;}return self.types.substitute(root,old,fresh);}
fn Engine::dataHeaders(self:Engine&)->blot_error::Error {for id in self.tree.roots.items {let node=self.tree.node(id);if node.tag!=blot_parse_ast::tag_data_decl && node.tag!=blot_parse_ast::tag_type_alias_decl {continue;}let key=Qualified{namespace:0,member:node.a};if self.catalogs.nominal_names.contains(key) {let err=self.diagnostic(Code.duplicate_name,id);if err!=blot_error::Error.none {return err;}continue;}let index=self.nominals.len as u32;let traits=self.tree.declaration_traits(id);var identity=Identity{unit:self.unit,decl:id};if traits.is_opaque {identity.decl=node.a|blot_check_types::opaque_name_bit;}self.nominals.append(Nominal{private:traits.private,is_opaque:traits.is_opaque,declaration:id,identity:identity,name:node.a,parameters:blot_check_types::List{},variables:blot_check_types::List{}});self.catalogs.nominal_identities.insert(identity,index);self.catalogs.nominal_names.insert(key,index);}for ordinal in 1..self.nominals.len {let nominal=self.nominals[ordinal];if nominal.identity.unit!=self.unit {continue;}let node=self.tree.node(nominal.declaration);let meta=self.tree.extra.items[node.c..node.c+4];if meta[3]!=0 {let err=self.diagnostic(Code.unsupported_attribute,nominal.declaration);if err!=blot_error::Error.none {return err;}}self.type_env.clear();self.row_env.clear();let parameters=equation_type_ids.alloc_slice(meta[1]);let patterns=equation_type_ids.alloc_slice(meta[1]);let err=dataHeaderParameters(self,ordinal as u32,meta,parameters,patterns);equation_type_ids.free_slice(patterns);equation_type_ids.free_slice(parameters);if err!=blot_error::Error.none {return err;}}self.type_env.clear();self.row_env.clear();return blot_error::Error.none;}
fn dataHeaderParameters(self:Engine&,index:u32,meta:const u32[:],parameters:u32[:],patterns:u32[:])->blot_error::Error {for parameter,ordinal in self.tree.list(blot_parse_ast::List{meta[0],meta[1]}) {let parsed,err=self.parameterAnnotation(parameter,0);if err!=blot_error::Error.none {return err;}parameters[ordinal]=parsed.ty;patterns[ordinal]=parsed.pattern;}let names=equation_type_ids.alloc_slice(self.type_env.items.len);let variables=equation_type_ids.alloc_slice(names.len);for entry,ordinal in self.type_env.items {names[ordinal]=entry.name;variables[ordinal]=entry.ty;}let err=dataHeaderLists(self,index,parameters,patterns,names,variables);equation_type_ids.free_slice(variables);equation_type_ids.free_slice(names);return err;}
fn dataHeaderLists(self:Engine&,index:u32,parameters:const u32[:],patterns:const u32[:],names:const u32[:],variables:const u32[:])->blot_error::Error {let list,err=self.types.saveList(parameters);if err!=blot_error::Error.none {return err;}self.nominals[index].parameters=list;let list,err=self.parameter_patterns.saveList(patterns);if err!=blot_error::Error.none {return err;}self.nominals[index].patterns=list;let list,err=self.types.saveList(variables);if err!=blot_error::Error.none {return err;}self.nominals[index].variables=list;let list,err=self.types.saveList(names);if err!=blot_error::Error.none {return err;}self.nominals[index].parameter_names=list;return blot_error::Error.none;}
fn Engine::resolveAlias(self:Engine&,index:u32)->u32,blot_error::Error {let nominal=self.nominals[index];if nominal.alias!=0 {return nominal.alias,blot_error::Error.none;}if nominal.identity.unit!=self.unit || self.tree.node(nominal.declaration).tag!=blot_parse_ast::tag_type_alias_decl {return 0,blot_error::Error.none;}if self.active_aliases.contains(index) {let err=self.diagnostic(Code.recursive_type_alias,nominal.declaration);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}if self.active_aliases.count>=256 {return 0,blot_error::Error.type_limit;}self.active_aliases.insert(index,true);let saved_defer=self.defer_associated;let saved_types=self.type_env;let saved_rows=self.row_env;let saved_closed=self.closed_type_variables;let saved_alias=self.implicit_row_parameters;self.defer_associated=true;self.type_env=TypeEnvironment{};self.row_env=RowEnvironment{};self.closed_type_variables=true;self.implicit_row_parameters=true;let target,err=resolveAliasBody(self,index,nominal);self.type_env.deinit();self.row_env.deinit();self.type_env=saved_types;self.row_env=saved_rows;self.closed_type_variables=saved_closed;self.implicit_row_parameters=saved_alias;self.defer_associated=saved_defer;self.active_aliases.remove(index);return target,err;}
fn resolveAliasBody(self:Engine&,index:u32,nominal:Nominal)->u32,blot_error::Error {for parameter in 0..nominal.variables.len {let err=self.type_env.append(Engine_type_env{name:self.types.list(nominal.parameter_names)[parameter],ty:self.types.list(nominal.variables)[parameter]});if err!=blot_error::Error.none {return 0,err;}}let target,err=self.annotation(self.tree.node(nominal.declaration).b);if err!=blot_error::Error.none {return 0,err;}let rows,err=self.types.freeRowVariables(target);if err!=blot_error::Error.none {return 0,err;}let span,err=self.types.saveList(rows);if err!=blot_error::Error.none {return 0,err;}self.nominals[index].alias_rows=span;self.nominals[index].alias=target;return target,blot_error::Error.none;}
fn Engine::aliasInstance(self:Engine&,index:u32,old:const u32[:],fresh:const u32[:],source:u32)->blot_support::Option<u32>,blot_error::Error {let alias,err=self.resolveAlias(index);if err!=blot_error::Error.none || alias==0 {return blot_support::none<u32>(),err;}if self.closed_type_variables && !self.implicit_row_parameters && self.nominals[index].alias_rows.len!=0 {let err=self.diagnostic(Code.unbound_alias_row,source);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}let root,err=self.types.fresh();return blot_support::some(root),err;}let rows=equation_type_ids.alloc_slice(self.nominals[index].alias_rows.len);for value,ordinal in self.types.list(self.nominals[index].alias_rows) {rows[ordinal]=value;}let fresh_rows=equation_type_ids.alloc_slice(rows.len);let result,error=aliasInstanceRows(self,alias,old,fresh,source,rows,fresh_rows);equation_type_ids.free_slice(fresh_rows);equation_type_ids.free_slice(rows);return result,error;}
fn aliasInstanceRows(self:Engine&,alias:u32,old:const u32[:],fresh:const u32[:],source:u32,rows:const u32[:],fresh_rows:u32[:])->blot_support::Option<u32>,blot_error::Error {for &row in fresh_rows {let id,err=self.types.freshEffects();if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}row=id;}let expanded,err=self.types.substituteWithRows(alias,old,fresh,rows,fresh_rows);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}if self.defer_associated || !self.has_associated_types {return blot_support::some(expanded),blot_error::Error.none;}let root,err=self.normalizeAssociated(expanded,source,true);return blot_support::some(root),err;}
fn Engine::dataBodies(self:Engine&)->blot_error::Error {self.closed_type_variables=true;let err=dataBodiesClosed(self);self.closed_type_variables=false;return err;}
fn dataBodiesClosed(self:Engine&)->blot_error::Error {var index:i64=1;while index<self.nominals.len {let nominal=self.nominals[index];if nominal.identity.unit!=self.unit {index+=1;continue;}if self.tree.node(nominal.declaration).tag==blot_parse_ast::tag_type_alias_decl {let root,err=self.resolveAlias(index as u32);if err!=blot_error::Error.none {return err;}index+=1;continue;}self.type_env.clear();self.row_env.clear();for ordinal in 0..nominal.variables.len {let err=self.type_env.append(Engine_type_env{name:self.types.list(nominal.parameter_names)[ordinal],ty:self.types.list(nominal.variables)[ordinal]});if err!=blot_error::Error.none {return err;}}let args=equation_type_ids.alloc_slice(nominal.parameters.len);for value,ordinal in self.types.list(nominal.parameters) {args[ordinal]=value;}let result,err=self.types.nominal(nominal.identity,args);equation_type_ids.free_slice(args);if err!=blot_error::Error.none {return err;}var constructors=IdBuffer{};let error=dataConstructors(self,index as u32,nominal,result,constructors);constructors.deinit(equation_type_ids);if error!=blot_error::Error.none {return error;}index+=1;}var imported=false;for nominal in self.nominals {if nominal.identity.unit!=self.unit && nominal.has_usage {imported=true;break;}}if self.types.has_usage_types || imported {var work=blot_check_usage_check::Work{};for ordinal in 0..self.nominals.len {let err=work.charge(1);if err!=blot_error::Error.none {return err;}var changed=false;for constructor in self.constructors {let err=work.charge(1);if err!=blot_error::Error.none {return err;}if constructor.payload==0 {continue;}if !self.nominals[constructor.nominal].affine {let affine,err=blot_check_usage_check::affineNominalWork(self.types,self.nominals,constructor.payload,work);if err!=blot_error::Error.none {return err;}if affine {self.nominals[constructor.nominal].affine=true;changed=true;}}if !self.nominals[constructor.nominal].has_usage {let usage,err=blot_check_usage_check::containsNominalWork(self.types,self.nominals,constructor.payload,work);if err!=blot_error::Error.none {return err;}if usage {self.nominals[constructor.nominal].has_usage=true;changed=true;}}}if !changed {break;}}}var storage_work=blot_check_usage_check::Work{};let err=blot_check_closed_nominal_storage::facts(self.types,self.nominals,self.constructors,self.unit,storage_work);if err!=blot_error::Error.none {if err!=blot_error::Error.type_limit {return err;}for &nominal in self.nominals {if nominal.identity.unit==self.unit {nominal.closed_storage=false;}}}self.type_env.clear();self.row_env.clear();return blot_error::Error.none;}
fn dataConstructors(self:Engine&,index:u32,nominal:Nominal,result:u32,constructors:IdBuffer&)->blot_error::Error {let declaration=self.tree.node(nominal.declaration);for id,tag in self.tree.children(declaration.b) {let node=self.tree.node(id);let key=self.catalogKey(node.a);if self.catalogs.constructor_names.contains(key) {let err=self.diagnostic(Code.duplicate_name,id);if err!=blot_error::Error.none {return err;}continue;}var payload:u32=0;if node.b!=0 {let root,err=self.constructorPayloadAnnotation(node.b);if err!=blot_error::Error.none {return err;}payload=root;}if payload!=0 {let shape=self.types.node(payload);if !nominal.is_opaque && shape.tag==blot_check_types::Tag.record && shape.b==0 {payload=0;}}let storage=self.types.node(payload);var parameter=payload;if !nominal.is_opaque && payload!=0 && storage.tag==blot_check_types::Tag.record {let root,err=self.canonicalRecordType(storage);if err!=blot_error::Error.none {return err;}parameter=root;}var ty=result;if payload!=0 {let root,err=self.types.function(parameter,result);if err!=blot_error::Error.none {return err;}ty=root;}let constructor=self.constructors.len as u32;let declared_record=!nominal.is_opaque && node.b!=0 && self.tree.node(node.b).tag==blot_parse_ast::tag_type_record && self.tree.type_conversion_origin(node.b)==self.tree.span(node.b).start;self.constructors.append(Constructor{private:nominal.private || nominal.is_opaque,identity:Identity{self.unit,id},nominal:index,tag:tag as u32,name:node.a,payload:payload,declared_record:declared_record,scheme:blot_check_types::Scheme{root:ty,variables:nominal.variables}});self.catalogs.constructor_identities.insert(Identity{self.unit,id},constructor);self.catalogs.constructor_names.insert(key,constructor);let err=constructors.append(constructor);if err!=blot_error::Error.none {return err;}self.constructor_resolved[id]=constructor;}let span,err=self.types.saveList(constructors.items);if err!=blot_error::Error.none {return err;}self.nominals[index].constructors=span;return blot_error::Error.none;}
fn Engine::effectHeaders(self:Engine&)->blot_error::Error {for id in self.tree.roots.items {let node=self.tree.node(id);if node.tag!=blot_parse_ast::tag_effect_decl && node.tag!=blot_parse_ast::tag_effect_type_decl {continue;}let attributes=self.tree.extra.items[node.c..];var attribute_index:i64=3;if node.tag==blot_parse_ast::tag_effect_decl {attribute_index=1;}if attributes[attribute_index]!=0 {let err=self.diagnostic(Code.unsupported_attribute,id);if err!=blot_error::Error.none {return err;}}if self.pool.get(node.a)=="Foreign" {let err=self.diagnostic(Code.sealed_effect,id);if err!=blot_error::Error.none {return err;}continue;}let key=self.catalogKey(node.a);if self.catalogs.effect_family_names.contains(key) || self.catalogs.nominal_names.contains(key) || self.hasGlobal(node.a) {let err=self.diagnostic(Code.duplicate_name,id);if err!=blot_error::Error.none {return err;}continue;}self.type_env.clear();self.row_env.clear();var parameters=IdBuffer{};var patterns=IdBuffer{};let err=effectHeaderParameters(self,id,node,key,parameters,patterns);patterns.deinit(equation_type_ids);parameters.deinit(equation_type_ids);if err!=blot_error::Error.none {return err;}}self.type_env.clear();self.row_env.clear();return blot_error::Error.none;}
fn effectHeaderParameters(self:Engine&,id:u32,node:blot_parse_ast::Node,key:Qualified,parameters:IdBuffer&,patterns:IdBuffer&)->blot_error::Error {if node.tag==blot_parse_ast::tag_effect_type_decl {let meta=self.tree.extra.items[node.c..node.c+4];for parameter in self.tree.list(blot_parse_ast::List{meta[0],meta[1]}) {let parsed,err=self.parameterAnnotation(parameter,0);if err!=blot_error::Error.none {return err;}let err=parameters.append(parsed.ty);if err!=blot_error::Error.none {return err;}let err=patterns.append(parsed.pattern);if err!=blot_error::Error.none {return err;}}}let names=equation_type_ids.alloc_slice(self.type_env.items.len);let variables=equation_type_ids.alloc_slice(names.len);for entry,ordinal in self.type_env.items {names[ordinal]=entry.name;variables[ordinal]=entry.ty;}let err=effectHeaderFamily(self,id,node,key,parameters.items,patterns.items,names,variables);equation_type_ids.free_slice(variables);equation_type_ids.free_slice(names);return err;}
fn effectHeaderFamily(self:Engine&,id:u32,node:blot_parse_ast::Node,key:Qualified,parameters:const u32[:],patterns:const u32[:],names:const u32[:],variables:const u32[:])->blot_error::Error {if self.effect_families.len==0xffffffff {return blot_error::Error.type_limit;}let family=self.effect_families.len as u32;let pattern_list,err=self.parameter_patterns.saveList(patterns);if err!=blot_error::Error.none {return err;}let parameter_list,err=self.types.saveList(parameters);if err!=blot_error::Error.none {return err;}let variable_list,err=self.types.saveList(variables);if err!=blot_error::Error.none {return err;}let name_list,err=self.types.saveList(names);if err!=blot_error::Error.none {return err;}self.effect_families.append(EffectFamily{private:self.tree.declaration_traits(id).private,identity:Identity{self.unit,id},name:node.a,callable:self.tree.node(node.b).tag!=blot_parse_ast::tag_effect_operations,patterns:pattern_list,parameters:parameter_list,variables:variable_list,parameter_names:name_list});self.catalogs.effect_family_names.insert(key,family);self.catalogs.effect_family_identities.insert(Identity{self.unit,id},family);var operations=IdBuffer{};let error=effectHeaderOperations(self,id,node,key,family,operations);operations.deinit(equation_type_ids);return error;}
fn effectHeaderOperations(self:Engine&,id:u32,node:blot_parse_ast::Node,key:Qualified,family:u32,operations:IdBuffer&)->blot_error::Error {if self.tree.node(node.b).tag==blot_parse_ast::tag_effect_operations {for member in self.tree.children(node.b) {let operation=self.tree.node(member);let key=EffectMember{family:family,member:operation.a};if self.catalogs.effect_members.contains(key) {let err=self.diagnostic(Code.duplicate_name,member);if err!=blot_error::Error.none {return err;}continue;}let template,err=self.effectSignature(family,member,operation.a,operation.b);if err!=blot_error::Error.none {return err;}self.catalogs.effect_members.insert(key,template);let err=operations.append(template);if err!=blot_error::Error.none {return err;}}}else {let template,err=self.effectSignature(family,id,node.a,node.b);if err!=blot_error::Error.none {return err;}self.catalogs.effect_operation_names.insert(key,template);let err=operations.append(template);if err!=blot_error::Error.none {return err;}}let list,err=self.types.saveList(operations.items);if err!=blot_error::Error.none {return err;}self.effect_families[family].operations=list;return blot_error::Error.none;}
fn Engine::effectSignature(self:Engine&,family:u32,identity:u32,name:u32,annotation:u32)->u32,blot_error::Error {let old=self.closed_type_variables;self.closed_type_variables=true;let result,err=effectSignatureClosed(self,family,identity,name,annotation);self.closed_type_variables=old;return result,err;}
