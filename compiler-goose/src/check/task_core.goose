        record => { for index in 0..node.b { let err = enclosing(module, module.types.recordField(node, index).ty, destination, remaining, depth + 1); if err != blot_error::Error.none { return err; } } },
        nominal => { for child in module.types.nominalArguments(node) { let err = enclosing(module, child, destination, remaining, depth + 1); if err != blot_error::Error.none { return err; } } },
