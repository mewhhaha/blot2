+    /// Conservative complete read set, also the borrowed lifetime inputs.
+    read_descriptors: []const u32,
+    body_visits: u32,
+    /// This family has no writes, fresh owners, transferred borrows or callee
+    /// scratch. Aggregate result storage belongs to the caller.
+    pub fn summary(self: ReadonlyCall) Summary {
+        return .{ .borrowed_parameters = self.read_descriptors, .destination_count = @intFromBool(self.result == .caller_destination) };
+    }
+    pub fn deinit(self: *ReadonlyCall, allocator: std.mem.Allocator) void {
+        allocator.free(self.selected);
+        allocator.free(self.uses);
+        allocator.free(self.read_descriptors);
+        self.* = undefined;
+    }
