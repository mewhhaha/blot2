    if node.tag==Tag.reference {let ref=self.module.reference(id);if ref.unit!=0 && ref.unit!=self.module.unit {return false,Error.none;}if ref.binding>=self.module.bindings.len {return false,Error.invalid_artifact;}let binding=self.module.bindings[ref.binding];if binding.initializer==0 {return false,Error.none;}if binding.initializer>=self.module.nodes.len {return false,Error.invalid_artifact;}let raw=self.module.node(binding.initializer).ty;let err=blot_check_generative_relocation::generalized(self.module,binding.scheme,raw);if err!=Error.none {return false,err;}let map,err=blot_check_generative_relocation::init(self.module,self.module,binding.scheme,node.ty,node.ty,0,0);if err!=Error.none {return false,err;}return self.valueOrigins(binding.initializer,raw,values,depth+1);}
    if node.tag==Tag.if_value {let left,err=self.valueOrigins(node.b,expected,values,depth+1);if err!=Error.none {return false,err;}let right,err=self.valueOrigins(node.c,expected,values,depth+1);return left && right,err;}
    if node.tag==Tag.project {if node.b>=self.module.projections.len {return false,Error.invalid_artifact;}let recipe=self.module.projections[node.b];if recipe.source_type>=self.module.types.nodes.len || recipe.result_type>=self.module.types.nodes.len {return false,Error.invalid_artifact;}if recipe.nominal.unit!=0 || recipe.nominal.decl!=0 {return false,Error.none;}let equal,err=self.same(recipe.result_type,expected);if err!=Error.none || !equal {return false,Error.invalid_artifact;}if recipe.variants.len!=1 || recipe.variants.start>=self.module.projection_variants.len {return false,Error.invalid_artifact;}let variant=self.module.projection_variants[recipe.variants.start];if variant.tag!=0 {return false,Error.invalid_artifact;}let container=self.module.types.node(recipe.source_type);if container.tag!=TypeTag.record && container.tag!=TypeTag.product {return false,Error.none;}if variant.field>=container.b {return false,Error.invalid_artifact;}var field_type:u32=0;
