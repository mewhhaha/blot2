}
fn Walker::requestLoop(self: Walker&, source: u32, node: blot_check_core::Node, depth: i64) -> Outcome,Error { if node.a >= self.module.request_loops.len || node.b != 0 || node.c != 0 || node.op != blot_check_core::Op.none { return Outcome.live,Error.invalid_artifact; } let loop=self.module.requestLoopInfo(source); if loop.computation == 0 || loop.completion_body == 0 || loop.arms.start > self.module.request_arms.len || loop.arms.len > self.module.request_arms.len-loop.arms.start { return Outcome.live,Error.invalid_artifact; } let flow,err=self.expression(loop.computation,depth+1); if err != Error.none { return Outcome.live,err; } let mark=self.snapshot_len; let result,err=requestLoopBody(self,source,loop,depth); self.snapshot_len=mark; return result,err; }
fn requestLoopBody(self: Walker&, source: u32, loop: blot_check_core::RequestLoopInfo, depth: i64) -> Outcome,Error { let count=self.len; let before,err=self.snapshot(); if err != Error.none { return Outcome.live,err; } for arm in self.module.requestArms(source) { let flow,err=self.expression(arm.callback,depth+1); if err != Error.none { return Outcome.live,err; } for after,index in self.states[..count] { let prior=before[index]; if after.first != prior.first || after.loan != prior.loan { return Outcome.live,Error.invalid_artifact; } } self.len=count; } if loop.carries.len != 0 { return Outcome.live,Error.invalid_artifact; } if loop.completion_pattern != 0 { let err=self.pattern(loop.completion_pattern,depth+1); if err != Error.none { return Outcome.live,err; } } let flow,err=self.expression(loop.completion_body,depth+1); self.len=count; return Outcome.live,err; }
fn Walker::loopValue(self: Walker&, source: u32, node: blot_check_core::Node, depth: i64) -> Outcome,Error { let loop=self.module.loops[node.a]; let flow,err=self.expression(loop.first,depth+1); if err != Error.none || flow == Outcome.exit { return flow,err; } let flow,err=self.expression(loop.end,depth+1); if err != Error.none || flow == Outcome.exit { return flow,err; } let mark=self.snapshot_len; let outer .= self.breaks; let result,err=loopBody(self,source,loop,depth); self.breaks .= outer; self.snapshot_len=mark; return result,err; }
fn loopBody(self: Walker&, source: u32, loop: blot_check_core::LoopInfo, depth: i64) -> Outcome,Error { let count=self.len; let before,err=self.snapshot(); if err != Error.none { return Outcome.live,err; } let joined,err=self.snapshot(); if err != Error.none { return Outcome.live,err; } var frame=ExitFrame {target:source,joined:joined}; self.breaks .= frame; if loop.pattern != 0 { let err=self.pattern(loop.pattern,depth+1); if err != Error.none { return Outcome.live,err; } } let flow,err=self.expression(loop.body,depth+1); if err != Error.none { return Outcome.live,err; } self.len=count; let single=self.singleIteration(loop); if flow == Outcome.live && !single { for after,index in self.states[..count] { if after.first != before[index].first { return Outcome.live,Error.invalid_artifact; } } } if flow == Outcome.live && single { self.record(frame); } copy(self.states[..count],frame.joined); if (loop.kind == blot_check_core::LoopKind.forever || single) && !frame.seen { return Outcome.exit,Error.none; } return Outcome.live,Error.none; }
fn relevant(module: const Module&, body: blot_check_core::Body) -> bool,Error { let contains,err=blot_check_usage_check::containsNominal(module.types,module.nominals,module.bindings[body.binding].ty); if err != Error.none { return false,Error.invalid_artifact; } if contains { return true,Error.none; } var pending:u32[>..<]; var seen:dictionary<u32,bool>; var walk=blot_eval_body_recipe::Walk {work:pending,seen:seen}; let err=walk.append(body.root); if err != Error.none { return false,Error.invalid_artifact; }
    while true { let id,present,err=walk.next(); if err != Error.none { return false,Error.invalid_artifact; } if !present { break; } if walk.count > 65536 { return false,Error.invalid_artifact; } let node=module.nodes[id]; if node.ty >= module.types.nodes.len { return false,Error.invalid_artifact; } let contains,err=blot_check_usage_check::containsNominal(module.types,module.nominals,node.ty); if err != Error.none { return false,Error.invalid_artifact; } if contains { return true,Error.none; } if node.tag == Tag.closure { if node.a >= module.closures.len { return false,Error.invalid_artifact; } let err=walk.append(module.closures[node.a].body); if err != Error.none { return false,Error.invalid_artifact; } } if node.tag == Tag.computation && (node.a == 0 || node.a >= module.nodes.len) { return false,Error.invalid_artifact; } if node.tag == Tag.request_loop { if node.a >= module.request_loops.len { return false,Error.invalid_artifact; } let loop=module.requestLoopInfo(id); if loop.computation == 0 || loop.completion_body == 0 || loop.arms.start > module.request_arms.len || loop.arms.len > module.request_arms.len-loop.arms.start { return false,Error.invalid_artifact; } } let err=blot_eval_body_recipe::appendChildren(walk,module,id,true); if err != Error.none { return false,Error.invalid_artifact; }
    } return false,Error.none;
}
fn nominalFacts(module: const Module&) -> Error { if module.nominals.len > 4096 { return Error.invalid_artifact; } var storage:blot_check_core::Nominal[4096]; let facts=storage[..module.nominals.len]; for value,index in module.nominals { facts[index]=value; } for &nominal in facts { if nominal.identity.unit == module.unit { nominal.affine=false; nominal.has_usage=false; } } var work=blot_check_usage_check::Work {}; for node in module.types.nodes { let err=blot_check_usage_check::nominalShape(module.types,facts,node,work); if err != Error.none { return Error.invalid_artifact; } }
    for ignored in 0..facts.len { let err=work.charge(1); if err != Error.none { return Error.invalid_artifact; } var changed=false; for constructor in module.constructors { let err=work.charge(1); if err != Error.none { return Error.invalid_artifact; } if constructor.nominal >= facts.len || constructor.payload >= module.types.nodes.len { return Error.invalid_artifact; } if constructor.payload == 0 || facts[constructor.nominal].identity.unit != module.unit { continue; } let nominal .= facts[constructor.nominal]; if !nominal.affine { let affine,err=blot_check_usage_check::affineNominalWork(module.types,facts,constructor.payload,work); if err != Error.none { return Error.invalid_artifact; } if affine { nominal.affine=true; changed=true; } } if !nominal.has_usage { let contains,err=blot_check_usage_check::containsNominalWork(module.types,facts,constructor.payload,work); if err != Error.none { return Error.invalid_artifact; } if contains { nominal.has_usage=true; changed=true; } } } if !changed { break; } }
    for proved,index in facts { let declared=module.nominals[index]; if proved.affine != declared.affine || proved.has_usage != declared.has_usage { return Error.invalid_artifact; } } return Error.none;
}
fn formalRegion(module: const Module&, id: u32, remaining: i64&) -> bool { for node in module.types.nodes { if remaining == 0 { return false; } remaining-=1; if node.tag != TypeTag.forall || node.c > 128 || node.b > module.types.extra.len || node.c > module.types.extra.len-node.b { continue; } for binder,ordinal in module.types.list(blot_check_types::List {node.b,node.c}) { if remaining == 0 { return false; } remaining-=1; if binder != id { continue; } if binder >= module.types.nodes.len { return false; } let bound=module.types.node(binder); if bound.tag == TypeTag.bound && bound.b == 2 && bound.c == 0 && bound.a == ordinal { return true; } } } return false; }
fn validateRegions(module: const Module&) -> Error { var bindings:u32[4096]; var count:i64=0; var remaining:i64=65536; for node in module.nodes { if remaining == 0 { return Error.invalid_artifact; } remaining-=1; if node.tag != Tag.usage_borrow && node.tag != Tag.resource_scope { continue; } var callable=node.b; if node.tag == Tag.resource_scope { callable=node.c; } if count == bindings.len || callable >= module.nodes.len || module.node(callable).tag != Tag.closure { return Error.invalid_artifact; } let callback=module.closure(callable); for binding in bindings[..count] { if binding == callback.parameter.binding { return Error.invalid_artifact; } } bindings[count]=callback.parameter.binding; count+=1; }
    for node,type_index in module.types.nodes { if remaining == 0 { return Error.invalid_artifact; } remaining-=1; if node.tag == TypeTag.bound && node.b == 2 { var owned=false; for binding in bindings[..count] { if binding == node.c { owned=true; break; } } if node.c == 0 { if !formalRegion(module,type_index as u32,remaining) { return Error.invalid_artifact; } } else if !owned || node.a != 0 { return Error.invalid_artifact; } }
        if node.tag == TypeTag.usage { if node.b == blot_check_types::usageCode(Usage.concurrent) && !blot_check_task_types::concurrentHost(module.types,node.a) { return Error.invalid_artifact; } let loan=node.b == blot_check_types::usageCode(Usage.borrow) || node.b == blot_check_types::usageCode(Usage.borrow_mut); if loan != (node.c != 0) { return Error.invalid_artifact; } if loan { if node.c >= module.types.nodes.len { return Error.invalid_artifact; } let region=module.types.node(node.c); if region.tag != TypeTag.bound || region.b != 2 { return Error.invalid_artifact; } } if node.b == blot_check_types::usageCode(Usage.shared) { let affine,err=blot_check_usage_check::affineNominal(module.types,module.nominals,node.a); if err != Error.none || affine { return Error.invalid_artifact; } } }
        let edges:u32[2]=[node.a,node.b]; var values:const u32[:]=[]; match node.tag {
            TypeTag.function => { values=edges; }, TypeTag.usage,TypeTag.array,TypeTag.list,TypeTag.cursor,TypeTag.resolver,TypeTag.provider,TypeTag.scoped => { values=edges[..1]; }, TypeTag.product => { values=module.types.list(blot_check_types::List {node.a,node.b}); }, TypeTag.nominal => { values=module.types.nominalArguments(node); },
            TypeTag.record => { for index in 0..node.b { let field=module.types.node(module.types.recordField(node,index).ty); if field.tag == TypeTag.bound && field.b == 2 { return Error.invalid_artifact; } } }, _ => {},
        } for edge in values { let child=module.types.node(edge); if child.tag == TypeTag.bound && child.b == 2 { return Error.invalid_artifact; } }
    } return Error.none;
}
fn packageWitnesses(module: const Module&) -> Error { var work=blot_check_usage_check::Work {}; for node in module.nodes { let err=work.charge(1); if err != Error.none { return Error.invalid_artifact; } if node.tag != Tag.package_pack { continue; } if node.b > module.types.extra.len || node.c > module.types.extra.len-node.b { return Error.invalid_artifact; } for witness in module.types.list(blot_check_types::List {node.b,node.c}) { let contains,err=blot_check_usage_check::containsNominalWork(module.types,module.nominals,witness,work); if err != Error.none || contains { return Error.invalid_artifact; } } } return Error.none; }
fn physicallyCaptures(module: const Module&, root: u32, binding: u32, remaining: i64&) -> bool,Error { var walker=Walker {module:module,len:1,remaining:min(remaining,65536)}; let budget=walker.remaining; walker.states[0]=State {binding:binding}; var found:bool[4096]=[false;4096]; let err=walker.capture(root,found,0); remaining-=budget-walker.remaining; return found[0],err; }
fn validate(module: const Module&) -> Error { let err=blot_check_closed_nominal_storage::validate(module); if err != Error.none { return err; } for nominal in module.nominals { if (nominal.affine && !nominal.has_usage) || (nominal.has_usage && !module.has_usage_contracts) { return Error.invalid_artifact; } } if !module.has_usage_contracts { return Error.none; } for node in module.nodes { if node.ty >= module.types.nodes.len { return Error.invalid_artifact; } }
    let err=nominalFacts(module); if err != Error.none { return err; } let err=packageWitnesses(module); if err != Error.none { return err; } let err=validateRegions(module); if err != Error.none { return err; } let err=blot_check_cleanup_contracts::validate(module); if err != Error.none { return err; } var walker=Walker {module:module};
    for body in module.bodies { if body.root == 0 { continue; } walker.len=0; walker.snapshot_len=0; walker.remaining=65536; walker.ambient=0; walker.region_count=0; var header,err=walker.quantified(module.bindings[body.binding].ty); if err != Error.none { return err; } for ignored in module.parameters[body.parameters.start..body.parameters.start+body.parameters.len] { if header.tag != TypeTag.function { return Error.invalid_artifact; } walker.ambient=header.c; header=module.types.node(header.b); } var required,err=relevant(module,body); if err != Error.none { return err; } for parameter in module.parameters[body.parameters.start..body.parameters.start+body.parameters.len] { let err=walker.introduce(parameter.binding); if err != Error.none { return err; } required=required || walker.len != 0; } if required { let flow,err=walker.expression(body.root,0); if err != Error.none { return err; } }
    } return Error.none;
}
