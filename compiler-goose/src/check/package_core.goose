}
fn Walker::knownInstance(self:Walker&,instance:blot_check_types::NominalIdentity)->bool,Error {return self.knownInstanceDepth(instance,0);}
recursive fn Walker::knownInstanceDepth(self:Walker&,instance:blot_check_types::NominalIdentity,depth:i64)->bool,Error {let error=self.step(depth);if error!=Error.none {return false,error;}if instance.decl==0 {return instance.unit==0,Error.none;}let owner .= self.scope_owner;while owner {let error=self.step(0);if error!=Error.none {return false,error;}if owner.identity==instance {return true,Error.none;}owner .= owner.parent;}if instance.unit==0 && instance.decl<self.module.types.nodes.len {let selected=self.module.types.node(instance.decl);if selected.tag!=blot_check_types::Tag.instance_selection {return false,Error.none;}let choices=self.module.types.nominalArguments(selected);if choices.len!=2 && choices.len!=3 {return false,Error.invalid_artifact;}for choice in choices[..2] {let capability=self.module.types.node(choice);if capability.tag!=blot_check_types::Tag.scoped {return false,Error.invalid_artifact;}let known,error=self.knownInstanceDepth(blot_check_types::NominalIdentity{unit:capability.b,decl:capability.c},depth+1);if error!=Error.none || !known {return false,error;}}return true,Error.none;}return false,Error.none;}
fn Walker::operationAuthority(self:Walker&,operation:blot_check_core::OperationValue)->Error {let known,error=self.knownInstance(operation.instance);if error!=Error.none {return error;}if operation.witness!=0 || operation.witness_result!=0 || !known {return Error.invalid_artifact;}if operation.instance.decl==0 {return require(operation.capability==0);}if operation.capability==0 {return Error.invalid_artifact;}let capability=self.module.types.node(self.module.typeOf(operation.capability));return require(capability.tag==blot_check_types::Tag.scoped && capability.b==operation.instance.unit && capability.c==operation.instance.decl);}
fn Walker::step(self:Walker&,depth:i64)->Error {if depth>=128 || self.scopes.remaining==0 {return Error.invalid_artifact;}self.scopes.remaining-=1;return Error.none;}
fn Walker::units(self:Walker&)->const ModuleRef[:] {return self.context.units;}
fn Walker::same(self:Walker&,first:u32,second:u32)->Error {var proof=Principal{left:self.module.types,right:self.module.types,remaining:self.scopes.remaining,views:self.scopes,foreign_views:true};return proof.validate(first,second);}
fn Walker::strictSame(self:Walker&,first:u32,second:u32)->Error {var proof=Principal{left:self.module.types,right:self.module.types,remaining:self.scopes.remaining,views:self.scopes};return proof.validate(first,second);}
fn Walker::scheme(self:Walker&,value:blot_check_types::Scheme)->Error {return self.schemeFor(value,0);}

var inactive_types=blot_check_core::Types{nodes:[],extra:[]};var inactive_budget:i64=0;
fn invalidPrincipal()->Principal {return Principal{left:inactive_types,right:inactive_types,remaining:inactive_budget};}
fn wordContains(values:const u32[:],wanted:u32)->bool {for value in values {if value==wanted {return true;}}return false;}
fn Walker::proveBody(self:Walker&,body:blot_check_core::Body)->Error {if body.root==0 {return Error.none;}self.return_owner .= null;self.loop_owner .= null;self.decision_owner .= null;let root=self.module.node(body.root);if root.tag==blot_check_core::Tag.contract_method {if root.a>=self.module.member_templates.len {return Error.invalid_artifact;}let template=self.module.member_templates[root.a];return require(template.binding==body.binding && body.is_function && root.c==body.parameters.len && body.scheme==self.module.binding(body.binding).scheme);}self.scopes.pure_rows=blot_check_package_row_facts::Facts{};self.scopes.closed_rows=blot_check_package_row_facts::Facts{};self.closed_rows=body.closed_rows;let error=self.closeRows(body.closed_rows);if error!=Error.none {return error;}let error=self.providerRows(body.root,0);if error!=Error.none {return error;}let signature=self.module.binding(body.binding).ty;let row,error=self.effectSignature(signature,body.parameters.len);if error!=Error.none {return error;}self.body_row=row;self.foreign_allowed=self.rowHasForeign(row);let error=self.scopes.generic(body.scheme);if error!=Error.none {return error;}let error=self.scopes.visit(signature);if error!=Error.none {return error;}let error=self.same(signature,body.scheme.root);if error!=Error.none {return error;}let error=self.schemeFor(body.scheme,body.binding);if error!=Error.none {return error;}let parent .= self.scope_owner;var owners:ScopeOwner[128]=[ScopeOwner{};128];var count:i64=0;for parameter in self.module.parameters[body.parameters.start..body.parameters.start+body.parameters.len] {let ty=self.module.types.node(parameter.ty);if ty.tag!=blot_check_types::Tag.scoped {continue;}if count>=owners.len {self.scope_owner .= parent;return Error.invalid_artifact;}owners[count]=ScopeOwner{identity:blot_check_types::NominalIdentity{unit:ty.b,decl:ty.c},parent:self.scope_owner};self.scope_owner .= owners[count];count+=1;}let quantified=self.module.types.node(signature).tag==blot_c