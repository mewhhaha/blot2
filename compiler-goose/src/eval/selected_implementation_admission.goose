// Supplied edges and targets gain authority only through complete reconstruction.
namespace blot_eval_selected_implementation_admission;
import check.check_packet_owner;
import check.core;
import check.types;
import eval.implementation_evidence;
import eval.implementation_predicates;
import eval.semantic_evidence_import;
import eval.type_evidence;
import support.error;
import backend.runtime_identity;

import dictionary;
import check.check;
import reuse.principal_interface;
import support.option;
type Error=blot_error::Error;
type C=blot_check_core::Module;
type T=blot_check_types::Id;
type E=blot_eval_type_evidence::Id;
type K=blot_check_types::ObligationKind;
fn require(value: bool) -> Error { if !value { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; }
fn convert(error: Error) -> Error { if error==blot_error::Error.none||error==blot_error::Error.out_of_memory { return error; } return blot_error::Error.invalid_artifact; }
struct Host { units: const C[:],evidence: blot_eval_type_evidence::Store&,associated_remaining: i64 }
fn evidenceStore(self_: Host&) -> blot_eval_type_evidence::Store& { return self_.evidence; }
fn diagnosticIdentity(self_: Host&) -> blot_support::Option<blot_backend_runtime_identity::View> { return blot_support::none<blot_backend_runtime_identity::View>(); }
fn implementationRead(self_: Host&,context: u32,identity: blot_check_types::NominalIdentity) -> Error { return blot_error::Error.none; }
fn implementationLegacyPredicate<R>(self_: Host&,context: u32,value: blot_check_core::Obligation,operands: E[4],resolver: blot_eval_type_evidence::ProjectionResolver<R>&) -> blot_eval_implementation_evidence::LegacyChoice,bool,Error {
 var owner: i64=-1; for module,index in self_.units { if module.unit==context { owner=index; break; } } if owner<0 { return default<blot_eval_implementation_evidence::LegacyChoice>(),false,blot_error::Error.none; } let module=self_.units[owner];
 if value.kind==blot_check_types::ObligationKind.field||value.kind==blot_check_types::ObligationKind.writable_field { if self_.evidence.node(operands[0]).tag==blot_eval_type_evidence::Tag.record { let fields=self_.evidence.children(operands[0]); var at=0; while at<fields.len { if fields[at]==value.name { if operands[2]==0||operands[2]==fields[at+1] { return blot_eval_implementation_evidence::LegacyChoice {target:blot_check_core::BindingRef {0,0},carrier:operands[3]},true,blot_error::Error.none; } return default<blot_eval_implementation_evidence::LegacyChoice>(),false,blot_error::Error.none; } at+=2; } } }
 if value.kind!=blot_check_types::ObligationKind.field&&value.kind!=blot_check_types::ObligationKind.dispatch&&value.kind!=blot_check_types::ObligationKind.receiver&&value.kind!=blot_check_types::ObligationKind.result_dispatch&&value.kind!=blot_check_types::ObligationKind.resolver_dispatch { return default<blot_eval_implementation_evidence::LegacyChoice>(),false,blot_error::Error.none; } var selection: E[2]=[operands[0],operands[1]]; if value.kind==blot_check_types::ObligationKind.result_dispatch { selection[0]=operands[2]; } if value.kind==blot_check_types::ObligationKind.resolver_dispatch { let resolver_type=self_.evidence.node(operands[0]); if resolver_type.tag!=blot_eval_type_evidence::Tag.resolver { return default<blot_eval_implementation_evidence::LegacyChoice>(),false,blot_error::Error.none; } selection[0]=resolver_type.a; }
 for operand,side in selection { if side==1&&value.kind!=blot_check_types::ObligationKind.dispatch { break; } if side==1&&value.name==0 { let result,result_present=blot_eval_implementation_predicates::primitiveResult(self_.evidence,value.operator,operands[0],operands[1]); if result_present { if result!=operands[2] { return default<blot_eval_implementation_evidence::LegacyChoice>(),false,blot_error::Error.none; } var carrier=operands[3]; if carrier==0 { let function,error=self_.evidence.intern(blot_eval_type_evidence::Tag.function,blot_check_types::unit,blot_check_types::unit,[]); if error!=blot_error::Error.none { return default<blot_eval_implementation_evidence::LegacyChoice>(),false,error; } carrier=function; } return blot_eval_implementation_evidence::LegacyChoice {target:blot_check_core::BindingRef {0,0},carrier:carrier},true,blot_error::Error.none; } }
  let node=self_.evidence.node(operand); var identity=blot_check_types::NominalIdentity {node.a,node.b}; match node.tag { nominal,type_constructor=>{},unsigned32=>{ identity=blot_check_types::NominalIdentity {0,blot_check_types::u32_type}; },floating32=>{ identity=blot_check_types::NominalIdentity {0,blot_check_types::f32_type}; },boolean=>{ identity=blot_check_types::NominalIdentity {0,blot_check_types::boolean}; },array=>{ identity=blot_check_types::NominalIdentity {0,0xffffffff}; },list=>{ identity=blot_check_types::NominalIdentity {0,0xfffffffe}; },cursor=>{ identity=blot_check_types::NominalIdentity {0,0xfffffffd}; },_=>{ continue; }, }
  for method in module.associated { if identity!=method.identity { continue; } if value.name!=0 { if method.member!=value.name { continue; } } else if method.operator!=value.operator { continue; } var binding_id: i64=-1; for candidate,ordinal in module.bindings { if (method.target.unit==context||method.target.unit==0)&&method.target.binding==ordinal { binding_id=ordinal; break; } if candidate.kind==blot_reuse_principal_interface::Kind.external&&candidate.target==method.target { binding_id=ordinal; break; } } if binding_id<0 { continue; } let binding=module.bindings[binding_id]; var mappings: blot_eval_type_evidence::Mapping[>..<]=[]; var rows: blot_eval_type_evidence::RowMapping[>..<]=[]; var arity=2; if value.kind==blot_check_types::ObligationKind.field||value.kind==blot_check_types::ObligationKind.result_dispatch { arity=1; } var carrier: E=0; if value.kind==blot_check_types::ObligationKind.resolver_dispatch { let matched,error=self_.evidence.matchLegacySignature(module.types,binding.scheme.root,operands[1],mappings,rows,resolver); if error!=blot_error::Error.none { return default<blot_eval_implementation_evidence::LegacyChoice>(),false,error; } if !matched { continue; } } else { let actual,matched,error=self_.evidence.matchPrerequisite(module.types,binding.scheme.root,operands,arity,mappings,rows,resolver); if error!=blot_error::Error.none { return default<blot_eval_implementation_evidence::LegacyChoice>(),false,error; } if !matched { continue; } carrier=actual; }
   for mapping in mappings { var found=false; for variable in module.types.list(binding.scheme.variables) { if variable==mapping.variable { found=true; break; } } if !found { return default<blot_eval_implementation_evidence::LegacyChoice>(),false,blot_error::Error.none; } } for mapping in rows { var found=false; for variable in module.types.list(binding.scheme.row_variables) { if variable==mapping.variable { found=true; break; } } if !found { return default<blot_eval_implementation_evidence::LegacyChoice>(),false,blot_error::Error.none; } } var original=method.target; if original.unit==0 { original.unit=context; } return blot_eval_implementation_evidence::LegacyChoice {original,carrier},true,blot_error::Error.none;
  }
 } return default<blot_eval_implementation_evidence::LegacyChoice>(),false,blot_error::Error.none;
}
struct Validator { module: const C&,host: Host&,derived: blot_eval_implementation_evidence::Store&,matched: dictionary<u32,u32>& }
fn root(self_: Validator&,value: T) -> E,Error { if value==0 { return 0,blot_error::Error.none; } let result,error=self_.host.evidence.projectWithBudget(self_.module.types,value,[],[],self_.host.associated_remaining); return result,convert(error); }
recursive fn compare(self_: Validator&,supplied: u32,inferred: u32,depth: i64) -> Error {
 if depth>=256||self_.host.associated_remaining==0 { return blot_error::Error.invalid_artifact; } self_.host.associated_remaining--; let known=self_.matched.get(supplied); if known { return require(known==inferred); } self_.matched.insert(supplied,inferred); let before=self_.module.selected_proofs[supplied]; let after=self_.derived.proofs.items[inferred]; var context=before.context; if context==0 { context=self_.module.unit; } if context!=after.context||before.implementation!=after.implementation||before.contract!=after.contract||(before.kind==blot_reuse_principal_interface::SelectedProofKind.predicate)!=(after.kind==blot_eval_implementation_evidence::ProofKind.predicate)||before.arguments.len!=after.arguments.len||before.members.len!=after.members.len||before.prerequisites.len!=after.prerequisites.len { return blot_error::Error.invalid_artifact; }
 for argument,index in self_.module.types.list(before.arguments) { let actual,error=root(self_,argument); if error!=blot_error::Error.none { return error; } if actual!=self_.derived.arguments.items[after.arguments.start+index] { return blot_error::Error.invalid_artifact; } }
 if before.kind==blot_reuse_principal_interface::SelectedProofKind.predicate { let fact=before.predicate; if before.predicate_target.unit!=after.predicate.target.unit||before.predicate_target.binding!=after.predicate.target.binding||fact.kind!=after.predicate.kind||fact.operator!=after.predicate.operator||fact.name!=after.predicate.name||fact.identity!=after.predicate.identity { return blot_error::Error.invalid_artifact; } for operand,index in [fact.ty,fact.other,fact.result,fact.signature] { let actual,error=root(self_,operand); if error!=blot_error::Error.none { return error; } if actual!=after.predicate.operands[index] { return blot_error::Error.invalid_artifact; } } }
 for member,index in self_.module.selected_members[before.members.start..before.members.start+before.members.len] { let expected=self_.derived.members.items[after.members.start+index]; if member.name!=expected.name||member.kind!=expected.kind||member.target.unit!=expected.target.unit||member.target.binding!=expected.target.binding { return blot_error::Error.invalid_artifact; } let actual,error=root(self_,member.root); if error!=blot_error::Error.none { return error; } if actual!=expected.root { return blot_error::Error.invalid_artifact; } } for child,index in self_.module.selected_edges[before.prerequisites.start..before.prerequisites.start+before.prerequisites.len] { let error=compare(self_,child,self_.derived.edges.items[after.prerequisites.start+index],depth+1); if error!=blot_error::Error.none { return error; } } return blot_error::Error.none;
}
struct CoreAdmission { module: const C&,remaining: i64&,host: Host?=null }
fn core(module: const C&,remaining: i64&) -> Error { if module.selected_proofs.len==0 { return require(module.selected_members.len==0&&module.selected_edges.len==0&&module.selected_uses.len==0); } var context=CoreAdmission {module,remaining}; return blot_eval_type_evidence::withStore<CoreAdmission>(context,coreEvidence); }
fn coreEvidence(context: CoreAdmission&,evidence: blot_eval_type_evidence::Store&) -> Error { let units: C[1]=[context.module]; var host=admissionHost(units,evidence,context.remaining); var scoped=coreWithHost(context,host); let error=blot_eval_implementation_evidence::withStore<CoreAdmission>(scoped,coreDerived); context.remaining=host.associated_remaining; context.host .= null; return error; }
fn coreDerived(context: CoreAdmission&,derived: blot_eval_implementation_evidence::Store&) -> Error { let host .= context.host; assert(host!=null); var matched: dictionary<u32,u32> = dictionary<u32,u32>{}; var validator=Validator {context.module,host,derived,matched}; var members_count=0; var edges_count=0; for proof,ordinal in context.module.selected_proofs { if proof.context!=0&&proof.context!=context.module.unit { return blot_error::Error.invalid_artifact; } if (proof.members.len!=0&&proof.members.start!=members_count)||(proof.prerequisites.len!=0&&proof.prerequisites.start!=edges_count) { return blot_error::Error.invalid_artifact; } members_count+=proof.members.len; edges_count+=proof.prerequisites.len; if proof.kind==blot_reuse_principal_interface::SelectedProofKind.predicate { continue; } var arguments: E[>..<]=[]; for argument in context.module.types.list(proof.arguments) { let actual,error=root(validator,argument); if error!=blot_error::Error.none { return error; } arguments.push(actual); } let selected,error=derived.resolve(host,context.module.unit,proof.contract,arguments); if error!=blot_error::Error.none { return convert(error); } let compared=compare(validator,ordinal as u32,selected,0); if compared!=blot_error::Error.none { return compared; } } return require(matched.count==context.module.selected_proofs.len&&members_count==context.module.selected_members.len&&edges_count==context.module.selected_edges.len); }
struct SnapshotValidator { source: blot_eval_implementation_evidence::View,host: Host&,derived: blot_eval_implementation_evidence::Store&,imports: blot_eval_semantic_evidence_import::Importer&,matched: dictionary<u32,u32>& }
fn root(self_: SnapshotValidator&,value: E) -> E,Error { let actual,error=self_.imports.ty(value,0); return actual,convert(error); }
recursive fn compare(self_: SnapshotValidator&,supplied: u32,inferred: u32,depth: i64) -> Error { if depth>=256||self_.host.associated_remaining==0 { return blot_error::Error.invalid_artifact; } self_.host.associated_remaining--; let known=self_.matched.get(supplied); if known { return require(known==inferred); } self_.matched.insert(supplied,inferred); let before=self_.source.proofs[supplied]; let after=self_.derived.proofs.items[inferred]; if before.context!=after.context||before.kind!=after.kind||before.implementation!=after.implementation||before.contract!=after.contract||before.arguments.len!=after.arguments.len||before.members.len!=after.members.len||before.prerequisites.len!=after.prerequisites.len { return blot_error::Error.invalid_artifact; }
 for argument,index in self_.source.arguments[before.arguments.start..before.arguments.start+before.arguments.len] { let actual,error=root(self_,argument); if error!=blot_error::Error.none { return error; } if actual!=self_.derived.arguments.items[after.arguments.start+index] { return blot_error::Error.invalid_artifact; } } if before.kind==blot_eval_implementation_evidence::ProofKind.predicate { let fact=before.predicate; if fact.kind!=after.predicate.kind||fact.operator!=after.predicate.operator||fact.name!=after.predicate.name||fact.identity!=after.predicate.identity||fact.target!=after.predicate.target { return blot_error::Error.invalid_artifact; } for operand,index in fact.operands { let actual,error=root(self_,operand); if error!=blot_error::Error.none { return error; } if actual!=after.predicate.operands[index] { return blot_error::Error.invalid_artifact; } } }
 for member,index in self_.source.members[before.members.start..before.members.start+before.members.len] { let expected=self_.derived.members.items[after.members.start+index]; if member.name!=expected.name||member.kind!=expected.kind||member.target!=expected.target { return blot_error::Error.invalid_artifact; } let actual,error=root(self_,member.root); if error!=blot_error::Error.none { return error; } if actual!=expected.root { return blot_error::Error.invalid_artifact; } } for child,index in self_.source.edges[before.prerequisites.start..before.prerequisites.start+before.prerequisites.len] { let error=compare(self_,child,self_.derived.edges.items[after.prerequisites.start+index],depth+1); if error!=blot_error::Error.none { return error; } } return blot_error::Error.none;
}
struct SnapshotAdmission { units: const C[:],evidence: blot_eval_type_evidence::View,supplied: blot_eval_implementation_evidence::View,remaining: i64&,host: Host?=null }
fn snapshot(units: const C[:],evidence: blot_eval_type_evidence::View,supplied: blot_eval_implementation_evidence::View,remaining: i64&) -> Error { if supplied.proofs.len==0 { return require(supplied.members.len==0&&supplied.arguments.len==0&&supplied.edges.len==0); } var context=SnapshotAdmission {units,evidence,supplied,remaining}; return blot_eval_type_evidence::withStore<SnapshotAdmission>(context,snapshotEvidence); }
fn snapshotEvidence(context: SnapshotAdmission&,evidence: blot_eval_type_evidence::Store&) -> Error { var host=admissionHost(context.units,evidence,context.remaining); var scoped=snapshotWithHost(context,host); let error=blot_eval_implementation_evidence::withStore<SnapshotAdmission>(scoped,snapshotDerived); context.remaining=host.associated_remaining; context.host .= null; return error; }
fn snapshotDerived(context: SnapshotAdmission&,derived: blot_eval_implementation_evidence::Store&) -> Error { let host .= context.host; assert(host!=null); var nodes: dictionary<u32,u32> = dictionary<u32,u32>{}; var rows: dictionary<u32,u32> = dictionary<u32,u32>{}; var labels: dictionary<u32,u32> = dictionary<u32,u32>{}; var imports=blot_eval_semantic_evidence_import::Importer {source:context.evidence,destination:host.evidence,max_depth:256,remaining:host.associated_remaining,nodes:nodes,rows:rows,labels:labels}; var matched: dictionary<u32,u32> = dictionary<u32,u32>{}; var validator=SnapshotValidator {context.supplied,host,derived,imports,matched}; var arguments_count=0; var members_count=0; var edges_count=0; for proof,ordinal in context.supplied.proofs { if (proof.arguments.len!=0&&proof.arguments.start!=arguments_count)||(proof.members.len!=0&&proof.members.start!=members_count)||(proof.prerequisites.len!=0&&proof.prerequisites.start!=edges_count) { return blot_error::Error.invalid_artifact; } arguments_count+=proof.arguments.len; members_count+=proof.members.len; edges_count+=proof.prerequisites.len; if proof.kind==blot_eval_implementation_evidence::ProofKind.predicate { if proof.arguments.len!=0||proof.members.len!=0 { return blot_error::Error.invalid_artifact; } continue; } var arguments: E[>..<]=[]; for argument in context.supplied.arguments[proof.arguments.start..proof.arguments.start+proof.arguments.len] { let actual,error=root(validator,argument); if error!=blot_error::Error.none { return error; } arguments.push(actual); } let selected,error=derived.resolve(host,proof.context,proof.contract,arguments); if error!=blot_error::Error.none { return convert(error); } let compared=compare(validator,ordinal as u32,selected,0); if compared!=blot_error::Error.none { return compared; } } return require(arguments_count==context.supplied.arguments.len&&members_count==context.supplied.members.len&&edges_count==context.supplied.edges.len&&matched.count==context.supplied.proofs.len); }

fn admissionHost(units:const C[:],evidence:blot_eval_type_evidence::Store&,remaining:i64)->Host {return Host{units:units,evidence:evidence,associated_remaining:remaining};}
fn coreWithHost(parent:const CoreAdmission&,host:Host&)->CoreAdmission {return CoreAdmission{module:parent.module,remaining:parent.remaining,host:host};}
fn snapshotWithHost(parent:const SnapshotAdmission&,host:Host&)->SnapshotAdmission {return SnapshotAdmission{units:parent.units,evidence:parent.evidence,supplied:parent.supplied,remaining:parent.remaining,host:host};}
