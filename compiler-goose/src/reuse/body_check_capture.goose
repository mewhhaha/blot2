self_.old_bindings.deinit();
self_.closed_rows.deinit();
self_.type_reads.deinit();
self_.predicates.deinit();
self_.members.deinit();
self_.projections.deinit();
self_.signatures.deinit();
self_.merges.deinit();
self_.loop_carries.deinit();
self_.loop_exits.deinit();
self_.exit_bindings.deinit();
self_.rebindings.deinit();
self_.constructors.deinit();
self_.accesses.deinit();
self_.fields.deinit();
self_.field_tags.deinit();
