    let end, end_error = module.addLocal(arena.allocate, blot_backend_runtime_ir::VT_i32); if end_error != Error.none { return end_error; }
    let pages, pages_error = module.addLocal(arena.allocate, blot_backend_runtime_ir::VT_i32); if pages_error != Error.none { return pages_error; }
