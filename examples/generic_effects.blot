// Operations and their providers are source-defined; no ECS or platform builtins.
type Reader a is effect = { ask: Unit -> a }
type Other a is effect = { ask: Unit -> a }

const read = func () => return Reader.ask U32 ()
const invoke = func work => return work ()
const reader = func value => return @effect.provider (Reader.ask U32) (func () => return value)

const forty = reader 40
const increment_reader = func () => return do:
  use outer <- Reader.ask U32 ()
  break @u32.add outer 1
const increment = @effect.provider (Reader.ask U32) increment_reader

entry const answer = func () => return do forty:
  break do increment:
    use value <- invoke read
    break @u32.add value 1

entry const const_answer = answer ()

// These opaque descriptors are compile-time values, not runtime handles.
const reads = @effect.of read
entry const effect_count = @effect.count reads
entry const reads_reader = @effect.has reads (Reader.ask U32)
entry const reads_other = @effect.has reads (Other.ask U32)

// Creating a closure is pure. Its call is handled where it is invoked.
const delayed = do forty:
  break func () => return Reader.ask U32 ()

entry const deferred = func () => return do (reader 7):
  break delayed ()
