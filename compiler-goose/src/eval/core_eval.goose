fn scalar(self_: RaggedFacts,value: ValueId) -> blot_support::Option<Value> { return valueScalar(self_.session,value); }
fn lookup(self_: RaggedFacts,reference: BindingRef) -> blot_support::Option<blot_eval_eval_ragged_count::Value> { if reference.unit==0||reference.unit==self_.module.unit { let value=self_.frame.values.get(reference.binding); if value { return blot_support::some(blot_eval_eval_ragged_count::Value {is_borrowed:true,borrowed:value}); } } let value=existing(self_,reference); if !value.present { return blot_support::none<blot_eval_eval_ragged_count::Value>(); } return blot_support::some(blot_eval_eval_ragged_count::Value {is_borrowed:true,borrowed:value.value}); }
