fn projectValue(self: Session&,owner: i64,source: u32,projection_index: u32,value: ValueId) -> ValueId,Error { let location,error=projectionLocation(self,owner,source,projection_index,value); if error!=Error.none { return 0,error; } return valueChildren(self,location.container)[location.field],Error.none; }
fn replaceProjection(self: Session&,owner: i64,source: u32,projection: u32,value: ValueId,replacement: ValueId) -> ValueId,Error { let location,error=projectionLocation(self,owner,source,projection,value); if error!=Error.none { return 0,error; } let changed,e=copyAggregate(self,owner,source,location.container,location.field,replacement); if e!=Error.none||!location.wrapped { return changed,e; } let wrapper=valueInfo(self,value); return makeAggregate(self,owner,source,ValueKind.nominal,wrapper.nominal,wrapper.bits,[changed]); }
fn update(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error { let module=self.units[owner]; let metadata=module.updateInfo(id); let original,error=expression(self,owner,metadata.root,frame); if error!=Error.none||!isValue(original) { return original,error; } let path=module.updatePath(id); let selectors=module.updateSelectors(id); var count=path.len; if selectors.len!=0 { count=selectors.len; } var chain: ValueId[>..<]=[]; chain.resize(count+1); var indices: u32[>..<]=[]; indices.resize(selectors.len); chain[0]=flowValue(original);
 if selectors.len!=0 { for selector,index in selectors { if selector.kind==blot_check_core::UpdateKind.field { let value,e=projectValue(self,owner,id,selector.projection,chain[index]); if e!=Error.none { return Flow.value {0},e; } chain[index+1]=value; } else { let position,e=expression(self,owner,selector.index,frame); if e!=Error.none||!isValue(position) { return position,e; } let scalar,e2=requireScalar(self,owner,selector.index,flowValue(position)); if e2!=Error.none { return Flow.value {0},e2; } let array=valueInfo(self,chain[index]); if scalar.scalar!=blot_backend_runtime_ir::SC_u32||(array.kind!=ValueKind.array&&array.kind!=ValueKind.list) { return Flow.value {0},failNode(self,owner,id,Code.unsupported); } if scalar.bits>=array.len { return Flow.value {0},failNode(self,owner,id,Code.array_bounds); } indices[index]=scalar.bits; chain[index+1]=valueChildren(self,chain[index])[scalar.bits]; } } } else { for projection,index in path { let value,e=projectValue(self,owner,id,projection,chain[index]); if e!=Error.none { return Flow.value {0},e; } chain[index+1]=value; } }
