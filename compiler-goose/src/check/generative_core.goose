fn callbackValue(self:const Scan&,id:u32,expected:u32,depth:i64)->bool,Error {var creators=Creators{..};return self.callbackCreators(id,expected,creators,depth);}
fn creatorVersions(self:const Scan&,creator:u32,arrow:u32,versions:u32[16]&)->i64,Error {var count:i64=0;for fact in self.facts[..self.len] {if fact.value!=creator {continue;}let same_arrow,err=self.arrow(arrow,fact.arrow);if err!=Error.none {return 0,err;}if !same_arrow {continue;}let selected=self.selected(fact.selected);if !selected.present {return 0,Error.invalid_artifact;}let version=self.module.types.nominalArguments(selected.value)[2];var known=false;for prior in versions[..count] {let same,err=self.same(prior,version);if err!=Error.none {return 0,err;}if same {known=true;break;}}if known {continue;}if count==versions.len {return 0,Error.invalid_artifact;}versions[count]=version;count+=1;}return count,Error.none;}
