fn recordFieldRecipe(self_: Generator&,query: const blot_check_core::Module&,name: u32,owner: const blot_check_core::Module&,ty: u32) -> blot_support::Option<blot_backend_storage_field_plan::Recipe>,Error { let hits = self_.field_recipes.hits; let probes = self_.field_recipes.probes; let recipe,error = self_.field_recipes.get(query,name,owner,ty); saturate(self_.emission_work.scoped_field_recipe_hits,self_.field_recipes.hits - hits); saturate(self_.emission_work.scoped_field_name_probes,self_.field_recipes.probes - probes); return recipe,error; }
