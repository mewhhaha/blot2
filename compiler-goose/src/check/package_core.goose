fn sharedRowPrefix(self:Walker&,solver:blot_check_scheme_equations::Solver&,row:u32,work:i64&)->bool,Error {if work==0 || row>=solver.prefix_rows {return false,Error.none;}work-=1;let error=solver.step();if error!=Error.none {return false,error;}if solver.store.row(row).tail!=blot_check_effects::Tail.closed {return false,Error.none;}for label in solver.store.rowLabels(row) {if label>=solver.prefix_operations {return false,Error.none;}let operation=solver.store.operations.items[label];if operation.instance.unit!=0 || operation.instance.decl!=0 || label!=blot_check_types::foreign_operation {return false,Error.none;}for argument in solver.store.list(operation.arguments) {let valid,error=self.sharedDataPrefix(solver,argument,work);if error!=Error.none || !valid {return false,error;}}}return true,Error.none;}
