 blot_parse_ast::tag_use_stmt,blot_parse_ast::tag_iterator_bind=>{let value,error=self.expression(syntax.b,depth+1);if error!=Error.none {return 0,error;}if syntax.a==0 || self.source.names.get(syntax.a)=="_" {return value,Error.none;}let binding=self.source.checked.resolved[source];if binding==0 {let error=self.diagnostic(blot_check_core::Code.unresolved_binding,source);return 0,error;}return self.make(source,blot_check_core::Node{tag:blot_check_core::Tag.bind,ty:blot_check_types::unit,a:binding,b:value, ..});},
