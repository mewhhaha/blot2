struct LegacyPrerequisites {engine:Engine&,state:LegacyProof&,predicate:blot_check_types::Obligation&,source:u32,binding:u32,carrier:u32,mappings:const blot_eval_type_evidence::Mapping[:],rows:const blot_eval_type_evidence::RowMapping[:],clauses:const blot_check_types::Obligation[:]}
fn legacyPrerequisites(context:LegacyPrerequisites&,copy:blot_eval_closed_evidence_import::PooledImporter&)->bool,blot_error::Error {let self .= context.engine;let predicate .= context.predicate;if predicate.kind!=blot_check_types::ObligationKind.resolver_dispatch {let signature,err=copy.ty(context.carrier,0);if err!=blot_error::Error.none {return false,err;}predicate.signature=signature;}if self.active_evidence.len>=256 || self.active_predicates.len>=256-self.active_evidence.len {let err=self.diagnostic(Code.associated_limit,context.source);return false,err;}for active in self.active_predicates {let allowed,err=self.associatedStep(context.source);if err!=blot_error::Error.none || !allowed {return false,err;}if active.binding!=context.binding || active.value.kind!=predicate.kind {continue;}let same,err=self.predicateEqualSymbolic(active.value,predicate);if err!=blot_error::Error.none {return false,err;}if same {let err=self.diagnostic(Code.recursive_evidence,context.source);return false,err;}}self.active_predicates.append(Engine_active_predicates{binding:context.binding,value:predicate});let old=equation_type_ids.alloc_slice(context.mappings.len);let fresh=equation_type_ids.alloc_slice(old.len);let old_rows=equation_type_ids.alloc_slice(context.rows.len);let new_rows=equation_type_ids.alloc_slice(old_rows.len);let edges=equation_type_ids.alloc_slice(context.clauses.len);let clauses=equation_values.alloc_slice(context.clauses.len);for clause,index in context.clauses {clauses[index]=clause;}let result,err=legacyPrerequisiteImports(context,copy,old,fresh,old_rows,new_rows,clauses,edges);equation_values.free_slice(clauses);equation_type_ids.free_slice(edges);equation_type_ids.free_slice(new_rows);equation_type_ids.free_slice(old_rows);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old);self.active_predicates.resize(self.active_predicates.len-1);return result,err;}
fn Engine::predicateEqualSymbolic(self:Engine&,left:blot_check_types::Obligation,right:blot_check_types::Obligation)->bool,blot_error::Error {let before:u32[4]=[left.ty,left.other,left.result,left.signature];let after:u32[4]=[right.ty,right.other,right.result,right.signature];var same=true;for value,index in before {let equal,err=self.types.equalSymbolic(value,after[index]);if err!=blot_error::Error.none {return false,err;}if !equal {same=false;}}return same,blot_error::Error.none;}
fn legacyPrerequisiteImports(context:LegacyPrerequisites&,copy:blot_eval_closed_evidence_import::PooledImporter&,old:u32[:],fresh:u32[:],old_rows:u32[:],new_rows:u32[:],clauses:const blot_check_types::Obligation[:],edges:u32[:])->bool,blot_error::Error {for mapping,index in context.mappings {old[index]=mapping.variable;let root,err=copy.ty(mapping.evidence,0);if err!=blot_error::Error.none {return false,err;}fresh[index]=root;}for mapping,index in context.rows {old_rows[index]=mapping.variable;let root,err=copy.row(mapping.evidence,0);if err!=blot_error::Error.none {return false,err;}new_rows[index]=root;}let self .= context.engine;for before,index in clauses {let allowed,err=self.associatedStep(context.source);if err!=blot_error::Error.none || !allowed {return false,err;}let clause,err=self.substitutePredicate(before,old,fresh,old_rows,new_rows);if err!=blot_error::Error.none {return false,err;}clause.source=context.source;let child,err=self.proveAndSavePredicate(clause,context.source);if err!=blot_error::Error.none || !child.present {return false,err;}edges[index]=child.value;}let start=self.selected_edges.len as u32;for edge in edges {self.selected_edges.append(edge);}self.proved_predicate_prerequisites=blot_check_types::List{start:start,len:edges.len as u32};self.proved_predicate_target=ExternalTarget{unit:self.unit,binding:context.binding};if self.bindings[context.binding].external.present {self.proved_predicate_target=self.bindings[context.binding].external.value;}return true,blot_error::Error.none;}
fn Engine::reflectionApplication(self:Engine&,id:u32)->blot_support::Option<u32>,blot_error::Error {var head=id;while self.tree.node(head).tag==blot_parse_ast::tag_apply {head=self.tree.node(head).a;}let syntax=self.tree.node(head);if syntax.tag!=blot_parse_ast::tag_intrinsic {return blot_support::none<u32>(),blot_error::Error.none;}let name=self.pool.get(syntax.a);var kind=ReflectionKind.of;if name=="@effect.of" {kind=ReflectionKind.of;}else if name=="@effect.descriptor" {kind=ReflectionKind.descriptor;}else if name=="@effect.count" {kind=ReflectionKind.count;}else if name=="@effect.has" {kind=ReflectionKind.has;}else if name=="@effect.same" {kind=ReflectionKind.same;}else {return blot_support::none<u32>(),blot_error::Error.none;}var arity:i64=1;if kind==ReflectionKind.has || kind==ReflectionKind.same {arity=2;}var arguments=IdBuffer{};var probe=id;var failure=blot_error::Error.none;while self.tree.node(probe).tag==blot_parse_ast::tag_apply {failure=arguments.append(self.tree.node(probe).b);if failure!=blot_error::Error.none {break;}probe=self.tree.node(probe).a;}var result:u32=0;if failure==blot_error::Error.none {if arguments.items.len!=arity {failure=self.diagnostic(Code.call_arity,id);if failure==blot_error::Error.none {let root,err=self.types.fresh();result=root;failure=err;}}else {reverseIds(arguments.items);let root,err=reflectionArguments(self,id,kind,arguments.items);result=root;failure=err;}}arguments.deinit(equation_type_ids);return blot_support::some(result),failure;}
fn reverseIds(values:u32[:]) {var at:i64=0;while at<values.len/2 {let opposite=values.len-1-at;let value=values[at];values[at]=values[opposite];values[opposite]=value;at+=1;}}
fn reflectionArguments(self:Engine&,id:u32,kind:ReflectionKind,arguments:const u32[:])->u32,blot_error::Error {let left=arguments[0];if kind==ReflectionKind.descriptor {let label,err=self.reflectionOperation(left,true);if err!=blot_error::Error.none {return 0,err;}if !label.present {return self.types.fresh();}return self.reflectDescriptor(id,label.value);}if kind==ReflectionKind.of {let argument=self.tree.node(left);var binding=blot_support::none<u32>();if argument.tag==blot_parse_ast::tag_name && !self.lookup(argument.a).present {let selected,err=self.globalBinding(argument.a);if err!=blot_error::Error.none {return 0,err;}binding=selected;}if argument.tag==blot_parse_ast::tag_field_access && self.tree.node(argument.a).tag==blot_parse_ast::tag_name && !self.lookup(self.tree.node(argument.a).a).present {let selected,err=self.qualifiedImportBinding(Qualified{namespace:self.tree.node(argument.a).a,member:argument.b});if err!=blot_error::Error.none {return 0,err;}binding=selected;}if !binding.present || !self.bindings[binding.value].named_function {let err=self.diagnostic(Code.function_target,left);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}let err=self.prepareGlobal(binding.value);if err!=blot_error::Error.none {return 0,err;}self.reflections.append(Reflection{node:id,kind:ReflectionKind.of,binding:binding.value});return self.reflectionType(false);}let value,err=self.expression(left);if err!=blot_error::Error.none {return 0,err;}let required,err=self.reflectionType(kind==ReflectionKind.same);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(value,required,left);if err!=blot_error::Error.none {return 0,err;}var right:u32=0;if arguments.len==2 {right=arguments[1];}if right!=0 {var ty:u32=0;if kind==ReflectionKind.has {let label,err=self.reflectionOperation(right,false);if err!=blot_error::Error.none {return 0,err;}if label.present {let value,err=self.reflectDescriptor(right,label.value);if err!=blot_error::Error.none {return 0,err;}ty=value;}else {ty=self.expr_types[right];}}else {let value,err=self.expression(right);if err!=blot_error::Error.none {return 0,err;}ty=value;}let required,err=self.reflectionType(true);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(ty,required,right);if err!=blot_error::Error.none {return 0,err;}}self.reflections.append(Reflection{node:id,kind:kind,left:left,right:right});if kind==ReflectionKind.count {return blot_check_types::u32_type,blot_error::Error.none;}return blot_check_types::boolean,blot_error::Error.none;}
struct ReflectionOrder {items:Reflection[:]}
fn ReflectionOrder::lessThan(self:ReflectionOrder&,left:i64,right:i64)->bool {return self.items[left].node<self.items[right].node;}
fn ReflectionOrder::swap(self:ReflectionOrder&,left:i64,right:i64) {let item=self.items[left];self.items[left]=self.items[right];self.items[right]=item;}
fn Engine::finishReflection(self:Engine&)->blot_error::Error {for &reflection in self.reflections {if reflection.kind!=ReflectionKind.of {continue;}let binding=self.bindings[reflection.binding];let root,err=self.types.resolve(binding.scheme.root,0);if err!=blot_error::Error.none {return err;}let signature=self.types.node(root);if signature.tag!=blot_check_types::Tag.function {let err=self.diagnostic(Code.function_target,reflection.node);if err!=blot_error::Error.none {return err;}continue;}let row,err=self.types.resolveEffects(signature.c,0);if err!=blot_error::Error.none {return err;}var closed=false;match self.types.row(row).tail {blot_check_effects::Tail.closed=>{closed=true;},_=>{}}for label in self.types.rowLabels(row) {for argument in self.types.operationArguments(label) {if closed {let same,err=self.types.equalClosed(argument,argument);if err!=blot_error::Error.none {return err;}closed=same;}}}if !closed {let err=self.diagnostic(Code.open_effect_descriptor,reflection.node);if err!=blot_error::Error.none {return err;}continue;}reflection.row=row;}var context=ReflectionOrder{self.reflections};blot_check_source_sort::pdqContext(0,self.reflections.len,context);return blot_error::Error.none;}
reusable[] var parameter_fields:blot_check_parameter_patterns::Field[>..];
fn Engine::copyParameterPatterns(self:Engine&,source:blot_check_frozen_types::Patterns,span:blot_check_parameter_patterns::List,copier:blot_check_check_scheme_import::Copier&)->blot_check_parameter_patterns::List,blot_error::Error {let result=equation_type_ids.alloc_slice(span.len);let output,err=copyParameterPatternsBody(self,source,span,copier,result);equation_type_ids.free_slice(result);return output,err;}
fn copyParameterPatternsBody(self:Engine&,source:blot_check_frozen_types::Patterns,span:blot_check_parameter_patterns::List,copier:blot_check_check_scheme_import::Copier&,result:u32[:])->blot_check_parameter_patterns::List,blot_error::Error {for pattern,index in source.list(span) {let value,err=self.copyParameterPattern(source,pattern,copier,0);if err!=blot_error::Error.none {return blot_check_parameter_patterns::List{},err;}result[index]=value;}return self.parameter_patterns.saveList(result);}
fn Engine::copyParameterPattern(self:Engine&,source:blot_check_frozen_types::Patterns,id:u32,copier:blot_check_check_scheme_import::Copier&,depth:i64)->u32,blot_error::Error {if depth>=1024 {return 0,blot_error::Error.type_limit;}let node=source.node(id);if node.kind==blot_check_parameter_patterns::Kind.binding {let ty,err=copier.copy(node.a,depth+1);if err!=blot_error::Error.none {return 0,err;}return self.parameter_patterns.add(blot_check_parameter_patterns::Node{kind:blot_check_parameter_patterns::Kind.binding,a:ty});}if node.kind==blot_check_parameter_patterns::Kind.record {let fields=parameter_fields.alloc_slice(node.b);let result,err=copyParameterRecord(self,source,node,copier,depth,fields);parameter_fields.free_slice(fields);return result,err;}let children=equation_type_ids.alloc_slice(node.b);let result,err=copyParameterSequence(self,source,node,copier,depth,children);equation_type_ids.free_slice(children);return result,err;}
fn copyParameterRecord(self:Engine&,source:blot_check_frozen_types::Patterns,node:blot_check_parameter_patterns::Node,copier:blot_check_check_scheme_import::Copier&,depth:i64,fields:blot_check_parameter_patterns::Field[:])->u32,blot_error::Error {for index in 0..node.b {let field=source.field(node,index);let pattern,err=self.copyParameterPattern(source,field.pattern,copier,depth+1);if err!=blot_error::Error.none {return 0,err;}fields[index]=blot_check_parameter_patterns::Field{name:field.name,pattern:pattern};}return self.parameter_patterns.record(fields);}
fn copyParameterSequence(self:Engine&,source:blot_check_frozen_types::Patterns,node:blot_check_parameter_patterns::Node,copier:blot_check_check_scheme_import::Copier&,depth:i64,children:u32[:])->u32,blot_error::Error {for child,index in source.list(blot_check_types::List{node.a,node.b}) {let pattern,err=self.copyParameterPattern(source,child,copier,depth+1);if err!=blot_error::Error.none {return 0,err;}children[index]=pattern;}return self.parameter_patterns.sequence(node.kind,children);}
struct ParameterAnnotation {ty:u32,pattern:u32}
fn Engine::parameterAnnotation(self:Engine&,id:u32,depth:i64)->ParameterAnnotation,blot_error::Error {if depth>=1024 {return ParameterAnnotation{},blot_error::Error.type_limit;}let node=self.tree.node(id);if node.tag==blot_parse_ast::tag_group {return self.parameterAnnotation(node.a,depth+1);}if node.tag==blot_parse_ast::tag_type_product || node.tag==blot_parse_ast::tag_type_array {let children=self.tree.children(id);if node.tag==blot_parse_ast::tag_type_product && children.len==1 {return self.parameterAnnotation(children[0],depth+1);}let types=equation_type_ids.alloc_slice(children.len);let patterns=equation_type_ids.alloc_slice(children.len);let result,err=parameterAnnotationSequence(self,node,children,depth,types,patterns);equation_type_ids.free_slice(patterns);equation_type_ids.free_slice(types);return result,err;}if node.tag==blot_parse_ast::tag_type_record {let children=self.tree.children(id);let types=equation_fields.alloc_slice(children.len);let fields=parameter_fields.alloc_slice(children.len);let result,err=parameterAnnotationRecord(self,id,children,depth,types,fields);parameter_fields.free_slice(fields);equation_fields.free_slice(types);return result,err;}var text:const u8[:]="";if node.tag==blot_parse_ast::tag_type_name {text=self.pool.get(node.a);}if text.len==0 || !((text[0]>='a' as u8 && text[0]<='z' as u8) || text[0]=='_' as u8) || firstDot(text).present {let err=self.diagnostic(Code.type_parameter,id);if err!=blot_error::Error.none {return ParameterAnnotation{},err;}let ty,err=self.types.fresh();if err!=blot_error::Error.none {return ParameterAnnotation{},err;}let pattern,err=self.parameter_patterns.add(blot_check_parameter_patterns::Node{kind:blot_check_parameter_patterns::Kind.binding,a:ty});return ParameterAnnotation{ty,pattern},err;}return self.parameterBinding(node.a,id);}
fn parameterAnnotationSequence(self:Engine&,node:blot_parse_ast::Node,children:const u32[:],depth:i64,types:u32[:],patterns:u32[:])->ParameterAnnotation,blot_error::Error {for child,index in children {let parsed,err=self.parameterAnnotation(child,depth+1);if err!=blot_error::Error.none {return ParameterAnnotation{},err;}types[index]=parsed.ty;patterns[index]=parsed.pattern;}var ty=blot_check_types::unit;if types.len!=0 {let root,err=self.types.product(types);if err!=blot_error::Error.none {return ParameterAnnotation{},err;}ty=root;}var kind=blot_check_parameter_patterns::Kind.tuple;if node.tag==blot_parse_ast::tag_type_array {kind=blot_check_parameter_patterns::Kind.array;}let pattern,err=self.parameter_patterns.sequence(kind,patterns);return ParameterAnnotation{ty,pattern},err;}
