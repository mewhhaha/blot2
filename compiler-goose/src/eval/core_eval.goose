fn lexicalScope(self: ClosureRegion&,lexical: u32) -> u32,Error { self.lexical_summary_job=lexical; let input=self.session.specializations.lexical_inputs.inputs[lexical-1]; let found=findUnit(self.session,input.unit,blot_support::none<i64>()); if !found.present { return 0,Error.unresolved_type; } let owner=found.value; let module=self.session.units[owner]; let scope,error=typeScope(self,owner); if error!=Error.none { return 0,error; } var qualifier: u32=0;
