fn put(receiver:Writer&,value:squid_check_types::Store) {let snapshot,error=squid_check_type_store_snapshot::viewPacketStore(value);if error!=squid_error::Error.none {receiver.failure=error;return;}put(receiver,snapshot);}
fn get(receiver:Reader&,value:squid_check_types::Store&) {var snapshot=default<squid_check_type_store_snapshot::Snapshot>();get(receiver,snapshot);if receiver.failure!=squid_error::Error.none {return;}let store,error=squid_check_types::initPooled();if error!=squid_error::Error.none {receiver.failure=error;return;}value=store;let restored=squid_check_type_store_snapshot::restorePacketStore(snapshot,value);if restored!=squid_error::Error.none {value.deinit();receiver.failure=restored;}}
fn put(receiver:Writer&,value:squid_check_parameter_patterns::Store) {if value.lease==0 {assert(value.generation==0);put(receiver,default<const squid_check_parameter_patterns::Node[:]>());put(receiver,default<const u32[:]>());return;}put(receiver,value.nodes().items);put(receiver,value.extra().items);}
fn get(receiver:Reader&,value:squid_check_parameter_patterns::Store&) {var nodes:squid_check_parameter_patterns::Node[:]=default<squid_check_parameter_patterns::Node[:]>();var words:u32[:]=default<u32[:]>();get(receiver,nodes);get(receiver,words);if receiver.failure!=squid_error::Error.none {return;}let store,error=squid_check_parameter_patterns::initPooled();if error!=squid_error::Error.none {receiver.failure=error;return;}var restored=store;restored.nodes().append(nodes);restored.extra().append(words);receiver.failure=restored.nodes().failure;if receiver.failure==squid_error::Error.none {receiver.failure=restored.extra().failure;}if receiver.failure!=squid_error::Error.none {restored.deinit();return;}value=squid_check_parameter_patterns::checkedView(restored);}
fn put(receiver:Writer&,value:squid_parse_symbols::Pool) {put(receiver,value.read_only);put(receiver,value.missing_name);put(receiver,value.bytes.items);put(receiver,value.entries.items);put(receiver,value.buckets.items);}
fn get(receiver:Reader&,value:squid_parse_symbols::Pool&) {var read_only=false;var missing=false;var bytes:u8[:]=default<u8[:]>();var entries:squid_parse_symbols::Entry[:]=default<squid_parse_symbols::Entry[:]>();var buckets:u32[:]=default<u32[:]>();get(receiver,read_only);get(receiver,missing);get(receiver,bytes);get(receiver,entries);get(receiver,buckets);if receiver.failure!=squid_error::Error.none {return;}for entry in entries {if entry.offset>bytes.len||entry.len>bytes.len-entry.offset {receiver.failure=squid_error::Error.invalid_artifact;return;}}for symbol in buckets {if symbol>entries.len {receiver.failure=squid_error::Error.invalid_artifact;return;}}let pool,error=squid_parse_symbols::initPooled();if error!=squid_error::Error.none {receiver.failure=error;return;}value=pool;value.bytes.append(bytes);value.entries.append(entries);value.buckets.append(buckets);receiver.failure=value.bytes.failure;if receiver.failure==squid_error::Error.none {receiver.failure=value.entries.failure;}if receiver.failure==squid_error::Error.none {receiver.failure=value.buckets.failure;}if receiver.failure!=squid_error::Error.none {value.deinit();return;}value.read_only=read_only;value.missing_name=missing;}

fn put(receiver:Writer&,value:squid_parse_ast::Tree) {put(receiver,value.lease!=0);if value.lease==0 {return;}put(receiver,value.has_typed_staging);put(receiver,value.nodes.items);put(receiver,value.spans.items);put(receiver,value.extra.items);put(receiver,value.roots.items);put(receiver,value.runtime_names.items);put(receiver,value.constant_names.items);put(receiver,value.test_meta.items);put(receiver,value.declaration_traits.items);put(receiver,value.declaration_nodes.items);put(receiver,value.diagnostics.items);put(receiver,value.operator_origins.items);put(receiver,value.type_conversion_origins.items);}
fn get(receiver:Reader&,value:squid_parse_ast::Tree&) {var present=false;get(receiver,present);if receiver.failure!=squid_error::Error.none||!present {value=squid_parse_ast::Tree{..};return;}var staging=false;get(receiver,staging);var nodes:squid_parse_ast::Node[:]=default<squid_parse_ast::Node[:]>();get(receiver,nodes);var spans:squid_parse_ast::Span[:]=default<squid_parse_ast::Span[:]>();get(receiver,spans);var extra:u32[:]=default<u32[:]>();get(receiver,extra);var roots:u32[:]=default<u32[:]>();get(receiver,roots);var runtime_names:squid_parse_ast::RuntimeName[:]=default<squid_parse_ast::RuntimeName[:]>();get(receiver,runtime_names);var constant_names:squid_parse_ast::RuntimeName[:]=default<squid_parse_ast::RuntimeName[:]>();get(receiver,constant_names);var test_meta:squid_parse_ast::TestMeta[:]=default<squid_parse_ast::TestMeta[:]>();get(receiver,test_meta);var declaration_traits:squid_parse_ast::DeclarationTraits[:]=default<squid_parse_ast::DeclarationTraits[:]>();get(receiver,declaration_traits);var declaration_nodes:squid_parse_ast::DeclarationNodes[:]=default<squid_parse_ast::DeclarationNodes[:]>();get(receiver,declaration_nodes);var diagnostics:squid_parse_ast::Diagnostic[:]=default<squid_parse_ast::Diagnostic[:]>();get(receiver,diagnostics);var operator_origins:squid_parse_ast::OperatorOrigin[:]=default<squid_parse_ast::OperatorOrigin[:]>();get(receiver,operator_origins);var type_conversion_origins:squid_parse_ast::TypeConversionOrigin[:]=default<squid_parse_ast::TypeConversionOrigin[:]>();get(receiver,type_conversion_origins);if receiver.failure!=squid_error::Error.none {return;}if nodes.len!=spans.len {receiver.failure=squid_error::Error.invalid_artifact;return;}for root in roots {if root>=nodes.len {receiver.failure=squid_error::Error.invalid_artifact;return;}}let tree,error=squid_parse_ast::initPooled();if error!=squid_error::Error.none {receiver.failure=error;return;}value=tree;value.nodes.clear();value.spans.clear();value.has_typed_staging=staging;value.nodes.append(nodes);value.spans.append(spans);value.extra.append(extra);value.roots.append(roots);value.runtime_names.append(runtime_names);value.constant_names.append(constant_names);value.test_meta.append(test_meta);value.declaration_traits.append(declaration_traits);value.declaration_nodes.append(declaration_nodes);value.diagnostics.append(diagnostics);value.operator_origins.append(operator_origins);value.type_conversion_origins.append(type_conversion_origins);receiver.failure=value.failure();if receiver.failure!=squid_error::Error.none {value.deinit();}}
