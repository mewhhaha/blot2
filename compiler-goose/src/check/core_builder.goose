if error!=blot_error::Error.none {return default<Module>(),error;
}let dependency_references,error=blot_reuse_dependency_payload::copy<blot_check_core::BindingRef>(owner,references[..]);
if error!=blot_error::Error.none {return default<Module>(),error;
}let dependency_members,error=blot_reuse_dependency_payload::copy<blot_check_core::DependencyMember>(owner,members[..]);
if error!=blot_error::Error.none {return default<Module>(),error;
}result.declaration_dependencies=declaration_dependencies;
result.dependency_references=dependency_references;
result.dependency_members=dependency_members;
return result,blot_error::Error.none;
}

fn selectedAccessPath(self_:const Builder&,source:u32)->const u32[:] {if source<self_.source.checked.access_paths.len {return self_.source.checked.types.list(self_.source.checked.access_paths[source]);}return default<const u32[:]>();}
