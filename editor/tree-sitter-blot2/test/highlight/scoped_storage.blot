const read = func (value: &U32) => return @storage.load value
//                        ^ operator
const follow = func (value: ^U32) => return @storage.load value
//                          ^ operator
const values: GrowArray U32 = #[42]
//            ^ type
const first = &values[0]
//            ^ operator
const link = ^values[0]
//           ^ operator

func step (own state: State) -> delta => return next (own state) delta
//         ^^^ keyword.storage.modifier
//             ^^^^^ variable.parameter
//                    ^^^^^ type
//                                                        ^^^^^ !variable.parameter

const closure = func (own value) => return value
//                        ^^^^^ variable.parameter
//                                         ^^^^^ !variable.parameter

entry kernel func scale (own x: U32): U32 => return x
//                           ^ variable.parameter
