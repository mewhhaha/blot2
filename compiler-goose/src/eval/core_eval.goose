fn withPrincipalGraph<C,F>(graph: const PrincipalGraph&,context: C&) -> Error { var snapshot,error=blot_check_types::cloneSnapshot(graph.types); if error!=blot_error::Error.none { return error; } var store,store_error=blot_check_types::initPooled(); if store_error!=blot_error::Error.none { blot_check_types::deinit(snapshot); return store_error; } let restored=blot_check_types::restoreStore(snapshot,store); if restored!=blot_error::Error.none { blot_check_types::deinit(store); blot_check_types::deinit(snapshot); return restored; } let readonly: const blot_check_types::Store& =store; let result=F(context,readonly); blot_check_types::deinit(store);blot_check_types::deinit(snapshot);return result; }
fn finishSuspendedRegion(context: bool&,region: ClosureRegion&) -> Error { return blot_error::Error.none; }
fn destroySuspendedRegion(session: Session&,snapshot: RegionSnapshot&) -> Error { var ignored=false; return withResumedRegion<bool>(session,snapshot,ignored,finishSuspendedRegion); }
import support.host_layout;
enum PrincipalClaim { source_description,open_residual }
struct PrincipalAnswer { found: bool=false,graph: PrincipalGraph?=null }
struct PrincipalQueryKey { source: PrincipalGraphKey,claim_: PrincipalClaim,forced: bool=false }
fn deinit(self_: PrincipalQueryKey&) {}
struct PrincipalDependencies { sources: BindingRef[:]=default<BindingRef[:]>(),plain: blot_reuse_specialization_receipt::PlainFact[:]=default<blot_reuse_specialization_receipt::PlainFact[:]>(),has_writes: bool=false }
