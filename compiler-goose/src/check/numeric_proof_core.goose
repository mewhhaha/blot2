fn Checker::summaryValue(self: Checker&, module: const Module&, inputs: SummaryInputs, id: u32, depth: i64) -> Value, Error { if id == 0 || depth >= 32 { return Value {}, Error.none; } let node = module.node(id); if node.tag == Tag.call { return self.summaryInvocation(module, inputs, id, depth); } if node.tag == Tag.block_ { return self.summaryBlock(module, inputs, id, [], depth); } if node.tag == Tag.if_value && module.types.node(node.ty).tag != TypeTag.boolean { let err = self.values.charge(1); if err != Error.none { return Value {}, err; } let left, err = self.summaryValue(module, inputs, node.b, depth + 1); if err != Error.none { return Value {}, err; } let right, err = self.summaryValue(module, inputs, node.c, depth + 1); if err != Error.none { return Value {}, err; } return join(left, right, false); } let operand, err = self.summaryOperand(module, inputs, id, depth); if err != Error.none { return Value {}, err; } let condition, err = self.summaryCondition(module, inputs, id, depth); return Value { operand: operand, condition: condition }, err; }
