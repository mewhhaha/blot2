fn Engine::callbackFunction(self:const Engine&,source:u32)->blot_support::Option<blot_check_capability_contracts::Recipe> {if source==0 || source>=self.resolved.len {return blot_support::none<blot_check_capability_contracts::Recipe>();}let id=self.resolved[source];if id==0 || id>=self.bindings.len {return blot_support::none<blot_check_capability_contracts::Recipe>();}let binding=self.bindings[id];if (binding.kind!=Kind.global && binding.kind!=Kind.external) || binding.scheme.generative.len!=0 {return blot_support::none<blot_check_capability_contracts::Recipe>();}if binding.capability_flow==CapabilityFlow.identity {return blot_support::some(blot_check_capability_contracts::Recipe{arity:1,root:1,nodes:identity_callback_nodes,words:[]});}if binding.capability_flow!=CapabilityFlow.input_shape || binding.capability_parameters.kind!=blot_check_capability_flow::ParameterResult.product || !binding.capability_parameters.valid() || !binding.capability_parameters.present() {return blot_support::none<blot_check_capability_contracts::Recipe>();}return self.capabilityHeader(id);}
