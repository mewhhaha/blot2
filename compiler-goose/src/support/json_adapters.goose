fn blot_check_effects::blotJsonWrite<JsonWriter>(value:blot_check_effects::Tail,writer:JsonWriter&)->blot_error::Error {match value {
variable payload=>{let opened=blot_json::beginObject(writer);if opened!=blot_error::Error.none {return opened;}let named=blot_json::key(writer,blot_json::sourceName("variable"));if named!=blot_error::Error.none {return named;}let written=blot_json::write(writer,payload.value);if written!=blot_error::Error.none {return written;}return blot_json::endObject(writer);},
parameter payload=>{let opened=blot_json::beginObject(writer);if opened!=blot_error::Error.none {return opened;}let named=blot_json::key(writer,blot_json::sourceName("parameter"));if named!=blot_error::Error.none {return named;}let written=blot_json::write(writer,payload.value);if written!=blot_error::Error.none {return written;}return blot_json::endObject(writer);},
formal payload=>{let opened=blot_json::beginObject(writer);if opened!=blot_error::Error.none {return opened;}let named=blot_json::key(writer,blot_json::sourceName("formal"));if named!=blot_error::Error.none {return named;}let written=blot_json::write(writer,payload.value);if written!=blot_error::Error.none {return written;}return blot_json::endObject(writer);},
