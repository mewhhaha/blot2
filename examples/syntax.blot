// Executable syntax showcase for Blot vNext.
// See docs/language/spec.md for the vNext specification.

type Vec2 is data = $Vec2 { x: F32, y: F32 }
type Mode is data = $Running | $Paused
type Event is data = $Tick U32 | $SetMode Mode | $Reset

func add left -> right => U32.add left right
func dot left -> right =>
  let $Vec2 { x: lx, y: ly } = left
  let $Vec2 { x: rx, y: ry } = right
  return lx * rx + ly * ry

func Vec2.scaled value -> factor =>
  let $Vec2 { x, y } = value
  return $Vec2 { x: x * factor, y: y * factor }

// Deferred work is an ordinary Unit callback. Booleans short-circuit directly.
func unwrap_or_else candidate -> fallback => case candidate of
  $Some value => value
  $Nothing => fallback ()

entry func short_circuit () =>
  let empty: #[U32] = #[]
  return false and (empty[0] > 0)

entry func lazy_fallback () =>
  let empty: #[U32] = #[]
  return unwrap_or_else ($Some 42) (func () => empty[0])

entry func factorial (value: U32): U32 =>
  if value <= 1:
    return 1
  return value * factorial (value - 1)

func choose first -> enabled -> fallback => case first, enabled, fallback of
  $Some value, true, _ => value
  _, _, $Some value => value
  _, _, _ => 0

func double_or_zero candidate =>
  let $Some value = candidate else:
    return 0
  return value * 2

func react event -> ticks => case event of
  $Tick count => ticks + count
  $SetMode $Running => ticks
  $SetMode $Paused => ticks
  $Reset => 0

entry const operator_example = 1 + 2 * 3
entry func recursive_example (value: U32) => factorial value
entry func matching_example () => choose $Nothing false ($Some (double_or_zero ($Some 21)))
entry func event_example () => react ($Tick 2) 40

entry func vector_example () =>
  let position = $Vec2 { x: 3.0, y: 4.0 }
  let scaled = Vec2.scaled position 2.0
  return dot position scaled

entry func array_snapshot () =>
  let original = #[1, 2, 3]
  let next = original.copy
  next[1] := 20
  return original[1] + next[1]

func set_second (items: own #[U32]) -> (value: U32): #[U32] =>
  items[1] := value
  return items

entry func array_update () =>
  let original = #[1, 2, 3]
  let updated = set_second original 20
  return updated[0] + updated[1] + updated[2]

type Counter a is effect = { advance: a -> a }
const local_counter = @effect.provider (Counter.advance U32) (func value => value + 1)

entry func provider_example () => do local_counter:
  use next <- Counter.advance U32 41
  break next
