type ModuleRef = blot_check_frozen_core_validation::ModuleRef;
import .check;
import .frozen_core_validation;
type Error = blot_error::Error;
type Module = blot_check_core::Module;
type Tag = blot_check_core::Tag;
type TypeTag = blot_check_types::Tag;
type Op = blot_check_task_types::Op;
type Flow = blot_check_capability_flow::Contract;
type BindingKind = blot_check_check::Kind;
fn same(module: const Module&, left: u32, right: u32, remaining: i64&) -> Error { let value, err = blot_check_rank_equal::equalWithBudget(module.types, left, right, true, remaining); if err != blot_error::Error.none || !value { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; }
fn step(remaining: i64&, depth: i64) -> Error { if remaining == 0 || depth >= 128 { return blot_error::Error.invalid_artifact; } remaining -= 1; return blot_error::Error.none; }
fn contains(values: const u32[:], id: u32) -> bool { for value in values { if value == id { return true; } } return false; }
fn once(module: const Module&, id: u32) -> blot_check_types::Node, Error {
    let callback = blot_check_task_types::scopeCallback(module.types, module.typeOf(id)); if callback.present { return callback.value, blot_error::Error.none; }
    let wrapper = module.types.node(module.typeOf(id)); if wrapper.tag != blot_check_types::Tag.usage || wrapper.b != blot_check_types::usageCode(blot_parse_ast::usagekind_once) || wrapper.c != 0 { return default<blot_check_types::Node>(), blot_error::Error.invalid_artifact; } let arrow = module.types.node(wrapper.a); if arrow.tag != blot_check_types::Tag.function { return arrow, blot_error::Error.invalid_artifact; } return arrow, blot_error::Error.none;
}
fn handle(module: const Module&, id: u32) -> const u32[:], Error { if !blot_check_task_types::isHandle(module.types, id) { return default<const u32[:]>(), blot_error::Error.invalid_artifact; } let nominal = module.types.node(module.types.node(id).a); let args = module.types.nominalArguments(nominal); if args.len != 2 || !blot_check_task_types::isGroup(module.types, args[0]) { return default<const u32[:]>(), blot_error::Error.invalid_artifact; } let arrow = module.types.node(args[1]); if arrow.tag != blot_check_types::Tag.function || arrow.a != blot_check_types::unit { return default<const u32[:]>(), blot_error::Error.invalid_artifact; } return args, blot_error::Error.none; }
fn callable(module: const Module&, source: u32) -> u32, Error { var current = source; for ignored in 0..128 { let node = module.node(current); if node.tag == blot_check_core::Tag.closure { return current, blot_error::Error.none; } if node.tag != blot_check_core::Tag.reference { return 0, blot_error::Error.invalid_artifact; } let reference = module.reference(current); if reference.unit != 0 && reference.unit != module.unit { return 0, blot_error::Error.invalid_artifact; } let binding = module.binding(reference.binding); if binding.kind != blot_reuse_principal_interface::Kind.local || binding.initializer == 0 { return 0, blot_error::Error.invalid_artifact; } current = binding.initializer; } return 0, blot_error::Error.invalid_artifact; }
fn receiveRequirement(module: const Module&, id: u32, remaining: i64&) -> blot_check_core::Obligation, Error {
    let input = module.typeOf(module.children(id)[0]);
    for binding in module.bindings { let err = step(remaining, 0); if err != blot_error::Error.none { return default<blot_check_core::Obligation>(), err; } if binding.capability_flow != blot_check_capability_flow::Contract.consume_task || binding.body_id == 0 { continue; } if binding.body_id >= module.bodies.len { return default<blot_check_core::Obligation>(), blot_error::Error.invalid_artifact; } let body = module.bodies[binding.body_id]; if body.root != id || body.parameters.len != 1 { continue; }
        if body.parameters.start >= module.parameters.len { return default<blot_check_core::Obligation>(), blot_error::Error.invalid_artifact; } let parameter = module.parameters[body.parameters.start]; let operand = module.children(id)[0]; if module.node(operand).tag != blot_check_core::Tag.reference || module.reference(operand).binding != parameter.binding || body.scheme.obligations.start > module.obligations.len || body.scheme.obligations.len > module.obligations.len - body.scheme.obligations.start { return default<blot_check_core::Obligation>(), blot_error::Error.invalid_artifact; }
        for goal in module.obligations[body.scheme.obligations.start..body.scheme.obligations.start + body.scheme.obligations.len] { let err = step(remaining, 0); if err != blot_error::Error.none { return default<blot_check_core::Obligation>(), err; } if goal.kind != blot_check_types::ObligationKind.task_receive { continue; } let err = same(module, input, goal.ty, remaining); if err != blot_error::Error.none { return goal, err; } let err = same(module, module.typeOf(id), goal.result, remaining); if err != blot_error::Error.none { return goal, err; } let signature = module.types.node(goal.signature); if signature.tag != blot_check_types::Tag.function { return goal, blot_error::Error.invalid_artifact; } let err = same(module, input, signature.a, remaining); if err != blot_error::Error.none { return goal, err; } let err = same(module, goal.result, signature.b, remaining); return goal, err; }
    } return default<blot_check_core::Obligation>(), blot_error::Error.invalid_artifact;
}
fn ownerUnit(initial: const Module&, unit: u32, units: const ModuleRef[:]) -> const Module?, Error { if unit == 0 || unit == initial.unit { return initial, blot_error::Error.none; } var found: const Module? = null; for candidate_owner_ref in units { let candidate: const blot_check_core::Module&  = candidate_owner_ref.value; if candidate.unit == unit { if found { return null, blot_error::Error.invalid_artifact; } found .= candidate; } } if !found { return null, blot_error::Error.invalid_artifact; } return found, blot_error::Error.none; }
fn receiveWrapper(initial: const Module&, initial_binding: u32, units: const ModuleRef[:]) -> Error {
    var module: const Module&  = initial; var binding_id = initial_binding;
    for ignored in 0..128 { if binding_id == 0 || binding_id >= module.bindings.len { return blot_error::Error.invalid_artifact; } let binding = module.bindings[binding_id]; if binding.capability_flow != blot_check_capability_flow::Contract.consume_task || binding.body_id == 0 || binding.body_id >= module.bodies.len { return blot_error::Error.invalid_artifact; } let body = module.bodies[binding.body_id]; if body.root == 0 || body.root >= module.nodes.len { return blot_error::Error.invalid_artifact; } let root = module.node(body.root);
        if body.is_function { if body.parameters.len != 1 || body.parameters.start >= module.parameters.len || root.tag != blot_check_core::Tag.task || (root.c != blot_check_task_types::opCode(blot_check_task_types::Op.join) && root.c != blot_check_task_types::opCode(blot_check_task_types::Op.receive)) || root.b != 1 { return blot_error::Error.invalid_artifact; } let formal = module.parameters[body.parameters.start]; let operand = module.children(body.root)[0]; if module.node(operand).tag != blot_check_core::Tag.reference { return blot_error::Error.invalid_artifact; } let reference = module.reference(operand); if (reference.unit != 0 && reference.unit != module.unit) || reference.binding != formal.binding || (root.c == blot_check_task_types::opCode(blot_check_task_types::Op.join) && !blot_check_task_types::isHandle(module.types, formal.ty)) { return blot_error::Error.invalid_artifact; } return blot_error::Error.none; }
        if body.parameters.len != 0 || root.tag != blot_check_core::Tag.reference { return blot_error::Error.invalid_artifact; } let reference = module.reference(body.root); binding_id = reference.binding; if reference.unit != 0 && reference.unit != module.unit { var found = false; for candidate_owner_ref in units { let candidate: const blot_check_core::Module&  = candidate_owner_ref.value; if candidate.unit == reference.unit { module .= candidate; found = true; break; } } if !found { return blot_error::Error.invalid_artifact; } }
    } return blot_error::Error.invalid_artifact;
