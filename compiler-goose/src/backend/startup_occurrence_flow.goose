enum Kind {scalar,product,record,nominal,array,closure}
struct Value {kind:Kind=Kind.scalar,scalar:ScalarValue=ScalarValue{..},known:bool=true,children:List=List{..},fields:List=List{..},nominal:blot_check_types::NominalIdentity=blot_check_types::NominalIdentity{..},tag:u32=0,closure:ClosureValue=ClosureValue{unit:0,identity:0,origin:blot_eval_eval_values::ClosureOrigin.anonymous,..},actual:blot_support::Option<u32> =blot_support::Option<u32>{..},provenance:Provenance=Provenance.inherit}
