fn Engine::operationTypeArgument(self:Engine&,id:u32,depth:i64)->u32,blot_error::Error {if depth>=1024 {return 0,blot_error::Error.type_limit;}let node=self.tree.node(id);if node.tag==blot_parse_ast::tag_unit {return blot_check_types::unit,blot_error::Error.none;}if node.tag==blot_parse_ast::tag_group {return self.operationTypeArgument(node.a,depth+1);}if node.tag==blot_parse_ast::tag_name {let text=self.pool.get(node.a);if text=="Unit" {return blot_check_types::unit,blot_error::Error.none;}if text=="Bool" {return blot_check_types::boolean,blot_error::Error.none;}if text=="U32" {return blot_check_types::u32_type,blot_error::Error.none;}if text=="F32" {return blot_check_types::f32_type,blot_error::Error.none;}for entry in self.type_env.items {if entry.name==node.a {return entry.ty,blot_error::Error.none;}}let selected .= self.catalogs.nominal_names.get(self.catalogKey(node.a));if selected {let index=selected;if self.nominals[index].parameters.len!=0 {let err=self.diagnostic(Code.type_arity,id);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}let alias,err=self.aliasInstance(index,[],[],id);if err!=blot_error::Error.none {return 0,err;}if alias.present {return alias.value,blot_error::Error.none;}return self.types.nominal(self.nominals[index].identity,[]);}}
