    if context.forbidden_owner.present { { let propagated_error = require(module.unit != context.forbidden_owner.value); if propagated_error != blot_error::Error.none { return propagated_error; } } }
    let header=blot_check_core::stampView(module); const for <N,A> in fields<blot_check_core::StampView> { { let propagated_error = require(boundedSlice(header.A)); if propagated_error != blot_error::Error.none { return propagated_error; } } }
    { let propagated_error = require(module.unit != 0xffffffff); if propagated_error != blot_error::Error.none { return propagated_error; } } { let propagated_error = require(module.nodes.len != 0 && module.bindings.len != 0 && module.bodies.len != 0); if propagated_error != blot_error::Error.none { return propagated_error; } }
    { let propagated_error = require(module.spans.len == module.nodes.len && module.merge_ranges.len == module.nodes.len); if propagated_error != blot_error::Error.none { return propagated_error; } } { let propagated_error = require(module.dispatch_signatures.len == 0 || module.dispatch_signatures.len == module.nodes.len); if propagated_error != blot_error::Error.none { return propagated_error; } }
    { let propagated_error = require(module.diagnostics.len == 0 && module.body_lowerings == module.bodies.len-1); if propagated_error != blot_error::Error.none { return propagated_error; } }
    { let propagated_error = require(module.types.nodes.len <= 0xffffffff && module.types.extra.len <= 0xffffffff && module.types.effects.rows.len <= 0xffffffff && module.types.effects.labels.len <= 0xffffffff && module.types.operations.len <= 0xffffffff); if propagated_error != blot_error::Error.none { return propagated_error; } }
    for ref,i in context.units { { let propagated_error = require(ref.value.unit != 0 && ref.value.unit != 0xffffffff); if propagated_error != blot_error::Error.none { return propagated_error; } } for prior in context.units[..i] { { let propagated_error = require(prior.value.unit != ref.value.unit); if propagated_error != blot_error::Error.none { return propagated_error; } } } }
    var scoped_work: i64=65536; let b=Bounds{module,context,scoped_work, ..};
    for field,ordinal in module.field_names { { let propagated_error = b.symbol(field.symbol,false); if propagated_error != blot_error::Error.none { return propagated_error; } } if ordinal != 0 { { let propagated_error = require(module.field_names[ordinal-1].symbol < field.symbol); if propagated_error != blot_error::Error.none { return propagated_error; } } } { let propagated_error = range(module.names.len,field.spelling.start,field.spelling.len); if propagated_error != blot_error::Error.none { return propagated_error; } } { let propagated_error = require(field.spelling.len != 0); if propagated_error != blot_error::Error.none { return propagated_error; } } }
    { let propagated_error = b.types(); if propagated_error != blot_error::Error.none { return propagated_error; } }
    for n in module.nodes { if n.tag == blot_check_core::Tag.loop_ { { let propagated_error = index(module.loops.len,n.a); if propagated_error != blot_error::Error.none { return propagated_error; } } } }
    { let propagated_error = b.catalogs(); if propagated_error != blot_error::Error.none { return propagated_error; } } { let propagated_error = b.nodes(); if propagated_error != blot_error::Error.none { return propagated_error; } }
    for nominal in module.nominals {
        if nominal.identity.unit == module.unit || nominal.identity.unit == 0 { continue; } var producer=false;
        for ref in context.units { let owner .= ref.value; if owner.unit != nominal.identity.unit { continue; } producer=true; var found=false;
            for definition in owner.nominals { if definition.identity == nominal.identity { { let propagated_error = require(definition.affine == nominal.affine && definition.has_usage == nominal.has_usage && definition.closed_storage == nominal.closed_storage); if propagated_error != blot_error::Error.none { return propagated_error; } } found=true; } } { let propagated_error = require(found); if propagated_error != blot_error::Error.none { return propagated_error; } }
        }
        if nominal.closed_storage { { let propagated_error = require(producer); if propagated_error != blot_error::Error.none { return propagated_error; } } }
    }
    return blot_error::Error.none;
}

fn hasFieldSpelling(module:const Module&,name:u32)->Error { let text=module.fieldSpelling(name); return require(text.present); }
