fn startsBytes(text:const u8[:],prefix:const u8[:])->bool {return text.len>=prefix.len && text[..prefix.len]==prefix;}
fn exactIntrinsicArity(name:const u8[:])->blot_support::Option<i64> {if startsBytes(name,"@u32.") || startsBytes(name,"@f32.") {return blot_support::none<i64>();}return intrinsicArity(name);}
fn intrinsicArity(name:const u8[:])->blot_support::Option<i64> {
 let storage=blot_check_storage_ops::lookup(name);if storage.present {return blot_support::some(blot_check_storage_ops::arity(storage.value));}let task=blot_check_task_types::lookup(name);if task.present {return blot_support::some(blot_check_task_types::arity(task.value));}let staging,present=blot_check_typed_staging::lookup(name);if present {return blot_support::some(blot_check_typed_staging::arity(staging));}let relation,present=blot_check_numeric_proof_terms::constructor(name);if present {return blot_support::some(2 as i64);}let simd=blot_backend_simd_intrinsics::lookup(name);if simd.present {return blot_support::some(simd.value.arity as i64);}let collection=blot_backend_collection_ops::lookup(name);if collection.present {return blot_support::some(collection.value.arity as i64);}
 if name=="@hole" {return blot_support::some(0 as i64);}
 for candidate in ["@resource.release","@usage.share","@usage.read","@usage.length","@state.get","@state.set","@effect.of","@effect.descriptor","@effect.count","@effect.scope","@u32.to_f32","@f32.to_u32","@f32.neg","@f32.abs","@f32.sqrt","@f32.floor","@f32.ceil","@f32.trunc","@array.length","@panic","@do.monad"] {if name==candidate {return blot_support::some(1 as i64);}}
