// Copied worker evidence images. Decoded runs carry no parent addresses or IDs.
namespace blot_evidence_packet;
import eval.type_evidence;
import check.effect_evidence;
import check.types;
import support.blake3;
import support.bytes;
import support.error;
import support.native;
type Error=blot_error::Error;
type Snapshot=blot_eval_type_evidence::Snapshot;
type View=blot_eval_type_evidence::View;
let magic: const u8[:]="BLOTEVID";
let version: u32=1;
let header: i64=84;
let byte_limit: i64=67108864;
let element_limit: i64=4194304;
fn digest(bytes: const u8[:]) -> u8[32] { return blot_support_blake3::hash(bytes); }
fn schema() -> u8[32] { return digest("BLOT evidence worker v1: nodes[tag8,a32,b32,c32];extra32;operations[identity32x2,arguments32x2,instance32x2];arguments32;rows[start32,len32,formal32];labels32;quantifiers[owner32,start32,len32];goals[ty32,kind32,name32,result32,other32,signature32,operator32,identity32x2,explicit8]"); }
fn emptySnapshot() -> Snapshot { return Snapshot {owner_id:0,nodes:default<blot_eval_type_evidence::Node[:]>(),extra:default<u32[:]>(),effects:blot_check_effect_evidence::Snapshot {operations:default<blot_check_effect_evidence::Operation[:]>(),arguments:default<u32[:]>(),rows:default<blot_check_effect_evidence::Row[:]>(),labels:default<u32[:]>(),owner_id:0, ..},quantifier_goals:default<blot_eval_type_evidence::QuantifierGoals[:]>(),quantifier_obligations:default<blot_eval_type_evidence::Goal[:]>(), ..}; }
struct OwnedSnapshot { snapshot: Snapshot,lease: u32=0,generation: u64=0 }
struct Lease { generation: u64,snapshot: Snapshot }
reusable var leases: Lease[>..]=[];
reusable[] var node_pool: blot_eval_type_evidence::Node[>..]=[];
reusable[] var word_pool: u32[>..]=[];
reusable[] var operation_pool: blot_check_effect_evidence::Operation[>..]=[];
reusable[] var row_pool: blot_check_effect_evidence::Row[>..]=[];
reusable[] var quantifier_pool: blot_eval_type_evidence::QuantifierGoals[>..]=[];
reusable[] var goal_pool: blot_eval_type_evidence::Goal[>..]=[];
var next_generation: u64=1;
fn valid(receiver: const OwnedSnapshot&) -> bool { return receiver.lease!=0&&receiver.lease<=leases.len&&leases[receiver.lease-1].generation==receiver.generation&&receiver.generation!=0; }
fn release(snapshot: Snapshot) { node_pool.free_slice(snapshot.nodes); word_pool.free_slice(snapshot.extra); operation_pool.free_slice(snapshot.effects.operations); word_pool.free_slice(snapshot.effects.arguments); row_pool.free_slice(snapshot.effects.rows); word_pool.free_slice(snapshot.effects.labels); quantifier_pool.free_slice(snapshot.quantifier_goals); goal_pool.free_slice(snapshot.quantifier_obligations); }
fn deinit(receiver: OwnedSnapshot&) { if receiver.lease==0 { return; } assert(valid(receiver)); let index=receiver.lease-1; release(leases[index].snapshot); leases[index].generation=0; leases.free(index); receiver.snapshot=emptySnapshot(); receiver.lease=0; receiver.generation=0; }
struct Writer { output: u8[>..<]&,start: i64,failure: Error=blot_error::Error.none,total: i64=0 }
fn room(receiver: Writer&,count: i64) -> bool { if receiver.failure!=blot_error::Error.none { return false; } let used=receiver.output.len-receiver.start; if count<0||used>byte_limit||count>byte_limit-used { receiver.failure=blot_error::Error.artifact_limit; return false; } return true; }
fn u8value(receiver: Writer&,value: u8) { if room(receiver,1) { receiver.output.push(value); } }
fn u32value(receiver: Writer&,value: u32) { if room(receiver,4) { for shift in 0..4 { receiver.output.push((value>>((shift*8) as u32)) as! u8); } } }
fn count(receiver: Writer&,length: i64) -> bool { if receiver.failure!=blot_error::Error.none { return false; } if length<0||length>element_limit||receiver.total>element_limit-length { receiver.failure=blot_error::Error.artifact_limit; return false; } receiver.total+=length; u32value(receiver,length as u32); return receiver.failure==blot_error::Error.none; }
fn words(receiver: Writer&,values: const u32[:]) { if !count(receiver,values.len) { return; } for value in values { u32value(receiver,value); } }
fn encode(view: View,output: u8[>..<]&) -> Error { let begin=output.len; output.append(magic); for index in 0..header-magic.len { output.push(0); } var writer=Writer {output,output.len, ..};
 if count(writer,view.nodes.len) { for node in view.nodes { u8value(writer,blot_eval_type_evidence::tagCode(node.tag)); u32value(writer,node.a); u32value(writer,node.b); u32value(writer,node.c); } } words(writer,view.extra);
 if count(writer,view.effects.operations.len) { for operation in view.effects.operations { u32value(writer,operation.identity.unit); u32value(writer,operation.identity.decl); u32value(writer,operation.arguments.start); u32value(writer,operation.arguments.len); u32value(writer,operation.instance.unit); u32value(writer,operation.instance.decl); } } words(writer,view.effects.arguments);
 if count(writer,view.effects.rows.len) { for row in view.effects.rows { u32value(writer,row.start); u32value(writer,row.len); u32value(writer,row.formal); } } words(writer,view.effects.labels);
 if count(writer,view.quantifier_goals.len) { for goals in view.quantifier_goals { u32value(writer,goals.owner); u32value(writer,goals.goals.start); u32value(writer,goals.goals.len); } }
 if count(writer,view.quantifier_obligations.len) { for goal in view.quantifier_obligations { u32value(writer,goal.ty); u32value(writer,blot_check_types::obligationKindCode(goal.kind)); u32value(writer,goal.name); u32value(writer,goal.result); u32value(writer,goal.other); u32value(writer,goal.signature); u32value(writer,blot_check_types::operatorCode(goal.operator)); u32value(writer,goal.identity.unit); u32value(writer,goal.identity.decl); var flag: u8=0; if goal.explicit { flag=1; } u8value(writer,flag); } }
 if writer.failure!=blot_error::Error.none { output.resize(begin); return writer.failure; } let payload=output[begin+header..]; let fingerprint=digest(payload); let schema_hash=schema(); blot_bytes::put_u32(output,begin+8,version); for byte,index in schema_hash { output[begin+12+index]=byte; } blot_bytes::put_u64(output,begin+44,payload.len as u64); for byte,index in fingerprint { output[begin+52+index]=byte; } return blot_error::Error.none;
}
struct Reader { bytes: const u8[:],at: i64=0,failure: Error=blot_error::Error.none,total: i64=0,snapshot: Snapshot }
fn available(receiver: Reader&,count: i64) -> bool { if receiver.failure!=blot_error::Error.none { return false; } if count<0||receiver.at<0||receiver.at>receiver.bytes.len||count>receiver.bytes.len-receiver.at { receiver.failure=blot_error::Error.invalid_artifact; return false; } return true; }
fn byte(receiver: Reader&) -> u8 { if !available(receiver,1) { return 0; } let value=receiver.bytes[receiver.at]; receiver.at++; return value; }
fn word(receiver: Reader&) -> u32 { if !available(receiver,4) { return 0; } let value=blot_bytes::get_u32(receiver.bytes,receiver.at); receiver.at+=4; return value; }
fn length(receiver: Reader&,width: i64) -> i64 { let count=word(receiver) as i64; if receiver.failure!=blot_error::Error.none { return 0; } if count>element_limit||receiver.total>element_limit-count||width<=0||count>(receiver.bytes.len-receiver.at)/width { receiver.failure=blot_error::Error.artifact_limit; return 0; } receiver.total+=count; return count; }
fn readWords(receiver: Reader&) -> u32[:] { let count=length(receiver,4); if receiver.failure!=blot_error::Error.none { return default<u32[:]>(); } let values=word_pool.alloc_slice(count); for &value in values { value=word(receiver); } return values; }
fn read(receiver: Reader&) -> Error {
 let node_count=length(receiver,13); if receiver.failure!=blot_error::Error.none { return receiver.failure; } let nodes=node_pool.alloc_slice(node_count); receiver.snapshot.nodes=nodes; for &node in nodes { let code=byte(receiver); let tag,known=blot_eval_type_evidence::tagFromCode(code); if !known { receiver.failure=blot_error::Error.invalid_artifact; return receiver.failure; } let a=word(receiver); let b=word(receiver); let c=word(receiver); node=blot_eval_type_evidence::Node {tag,a,b,c, ..}; }
 receiver.snapshot.extra=readWords(receiver); if receiver.failure!=blot_error::Error.none { return receiver.failure; }
 let operation_count=length(receiver,24); if receiver.failure!=blot_error::Error.none { return receiver.failure; } let operations=operation_pool.alloc_slice(operation_count); receiver.snapshot.effects.operations=operations; for &operation in operations { let unit=word(receiver); let declaration=word(receiver); let start=word(receiver); let count=word(receiver); let owner=word(receiver); let instance=word(receiver); operation=blot_check_effect_evidence::Operation {blot_check_types::NominalIdentity {unit,declaration},blot_check_effect_evidence::List {start,count, ..},blot_check_types::NominalIdentity {owner,instance, ..}, ..}; }
 receiver.snapshot.effects.arguments=readWords(receiver); if receiver.failure!=blot_error::Error.none { return receiver.failure; }
 let row_count=length(receiver,12); if receiver.failure!=blot_error::Error.none { return receiver.failure; } let rows=row_pool.alloc_slice(row_count); receiver.snapshot.effects.rows=rows; for &row in rows { let start=word(receiver); let count=word(receiver); let formal=word(receiver); row=blot_check_effect_evidence::Row {start,count,formal, ..}; }
 receiver.snapshot.effects.labels=readWords(receiver); if receiver.failure!=blot_error::Error.none { return receiver.failure; }
 let quantifier_count=length(receiver,12); if receiver.failure!=blot_error::Error.none { return receiver.failure; } let quantifiers=quantifier_pool.alloc_slice(quantifier_count); receiver.snapshot.quantifier_goals=quantifiers; for &quantifier in quantifiers { let owner=word(receiver); let start=word(receiver); let count=word(receiver); quantifier=blot_eval_type_evidence::QuantifierGoals {owner,blot_check_types::List {start,count, ..}, ..}; }
 let goal_count=length(receiver,37); if receiver.failure!=blot_error::Error.none { return receiver.failure; } let goals=goal_pool.alloc_slice(goal_count); receiver.snapshot.quantifier_obligations=goals; for &goal in goals { let ty=word(receiver); let kind_code=word(receiver); let kind,error=blot_check_types::obligationKindFromCode(kind_code); if error!=blot_error::Error.none { return blot_error::Error.invalid_artifact; } let name=word(receiver); let result=word(receiver); let other=word(receiver); let signature=word(receiver); let operator_code=word(receiver); let operator,e=blot_check_types::operatorFromCode(operator_code); if e!=blot_error::Error.none { return blot_error::Error.invalid_artifact; } let unit=word(receiver); let declaration=word(receiver); let explicit=byte(receiver); if explicit>1 { return blot_error::Error.invalid_artifact; } goal=blot_eval_type_evidence::Goal {ty:ty,kind:kind,name:name,result:result,other:other,signature:signature,operator:operator,identity:blot_check_types::NominalIdentity {unit,declaration, ..},explicit:explicit==1, ..}; } return receiver.failure;
}
fn shape(snapshot: const Snapshot&) -> bool { let nodes=snapshot.nodes; if nodes.len<6||snapshot.effects.rows.len==0||snapshot.effects.operations.len==0 { return false; } let expected: blot_eval_type_evidence::Tag[6]=[blot_eval_type_evidence::Tag.absent,blot_eval_type_evidence::Tag.unit,blot_eval_type_evidence::Tag.boolean,blot_eval_type_evidence::Tag.unsigned32,blot_eval_type_evidence::Tag.floating32,blot_eval_type_evidence::Tag.never]; for tag,index in expected { if nodes[index].tag!=tag||nodes[index].a!=0||nodes[index].b!=0||nodes[index].c!=0 { return false; } } for operation in snapshot.effects.operations { if operation.arguments.start>snapshot.effects.arguments.len||operation.arguments.len>snapshot.effects.arguments.len-operation.arguments.start { return false; } } for row in snapshot.effects.rows { if row.start>snapshot.effects.labels.len||row.len>snapshot.effects.labels.len-row.start||row.formal>=nodes.len { return false; } } for label in snapshot.effects.labels { if label==0||label>=snapshot.effects.operations.len { return false; } } for argument in snapshot.effects.arguments { if argument>=nodes.len { return false; } } let zero=snapshot.effects.rows[0]; return zero.start==0&&zero.len==0&&zero.formal==0; }
fn decode(bytes: const u8[:]) -> OwnedSnapshot,Error { let empty=OwnedSnapshot {snapshot:emptySnapshot(), ..}; if bytes.len<header||bytes[..8]!=magic { return empty,blot_error::Error.invalid_artifact; } if blot_bytes::get_u32(bytes,8)!=version { return empty,blot_error::Error.unsupported_version; } let schema_hash=schema(); if bytes[12..44]!=schema_hash { return empty,blot_error::Error.schema_mismatch; } let count=blot_bytes::get_u64(bytes,44); if count>byte_limit as u64 { return empty,blot_error::Error.artifact_limit; } if count!=(bytes.len-header) as u64 { return empty,blot_error::Error.invalid_artifact; } let checksum=digest(bytes[header..]); if bytes[52..84]!=checksum { return empty,blot_error::Error.invalid_artifact; } var reader=Reader {bytes:bytes[header..],snapshot:emptySnapshot(), ..}; let error=read(reader); if error!=blot_error::Error.none||reader.at!=reader.bytes.len||!shape(reader.snapshot) { release(reader.snapshot); if error!=blot_error::Error.none { return empty,error; } return empty,blot_error::Error.invalid_artifact; } if next_generation==0xffffffffffffffff||leases.len>=0xffffffff { release(reader.snapshot); return empty,blot_error::Error.out_of_memory; } reader.snapshot.owner_id=blot_native::fresh_owner_id(); reader.snapshot.effects.owner_id=blot_native::fresh_owner_id(); let generation=next_generation; next_generation++; let slot=leases.alloc_index(Lease {generation,reader.snapshot, ..}); return OwnedSnapshot {reader.snapshot,(slot+1) as u32,generation, ..},blot_error::Error.none; }
