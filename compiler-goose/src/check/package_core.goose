struct Context {units:const ModuleRef[:]=default<const ModuleRef[:]>(),source_proofs:SourceProofCache?=null,module_units:const Module[:]=default<const Module[:]>()}
fn contextView(context:Context)->Context {return context;}
fn contextView(context)->Context {return Context{units:context.units, ..};}
