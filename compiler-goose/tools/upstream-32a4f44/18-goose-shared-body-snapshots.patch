--- a/src/ast.h	2026-11-11 14:42:46.454021008 +0100
+++ b/src/ast.h	2026-11-11 18:11:19.568408588 +0100
@@ -2326,8 +2326,26 @@
     struct BodyEvent {
         VarDef *container, *root, *src;
         bool exact, classread, argcopy;
+        bool operator==(const BodyEvent &) const = default;
     };
-    vector<BodyEvent> bodyevents;
+    // The body's events as its check left them, read through immutable
+    // fixed-size chunks of the program-wide log. A chunk no event changed in
+    // since another record copied it is shared, not copied again: nested
+    // first checks would otherwise copy every callee's events once per
+    // enclosing body.
+    static constexpr size_t BodyChunkEvents = 64;
+    struct BodyChunk { BodyEvent events[BodyChunkEvents]; };
+    struct BodySnapshot {
+        size_t start = 0, count = 0;
+        vector<shared_ptr<const BodyChunk>> chunks;
+        size_t size() const { return count; }
+        const BodyEvent &operator[](size_t k) const {
+            auto i = start + k;
+            return chunks[i / BodyChunkEvents - start / BodyChunkEvents]->events[i % BodyChunkEvents];
+        }
+        void clear() { start = count = 0; chunks.clear(); }
+    };
+    BodySnapshot bodyevents;
 };
 
