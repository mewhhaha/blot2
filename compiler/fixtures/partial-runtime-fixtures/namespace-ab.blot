import * as alpha from "./a"
import * as beta from "./b"
effect Local: Unit -> F32
const reader = @effect.provider Local (func () => return 0.75)
type Cell is data = $Cell U32
const evaluate = func () => return do:
  let first = do alpha.reader:
    break alpha.Lib ()
  let second = do beta.reader:
    break beta.Lib ()
  let third = do reader:
    break Local ()
  let (_, $Cell count) = @state.run ($Cell 1) (func () => return @state.get $Cell)
  break @f32.add (@f32.add (@f32.add first second) third) (@u32.to_f32 count)
entry const answer = func () => return evaluate ()
entry const folded = evaluate ()
