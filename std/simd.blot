// Explicit four-lane operations. These aliases are ordinary product types, so
// lanes can be constructed, destructured and passed through normal functions.
// Every operation with a scalar counterpart gives bit-identical lanes.
type U32x4 = (U32, U32, U32, U32)
type F32x4 = (F32, F32, F32, F32)
func u32_splat (value: U32) : U32x4 => return (value, value, value, value)
func f32_splat (value: F32) : F32x4 => return (value, value, value, value)
func u32_add left -> right => return @simd.u32x4.add left right
func u32_sub left -> right => return @simd.u32x4.sub left right
func u32_mul left -> right => return @simd.u32x4.mul left right
func u32_and left -> right => return @simd.u32x4.bit_and left right
func u32_or left -> right => return @simd.u32x4.bit_or left right
func u32_xor left -> right => return @simd.u32x4.bit_xor left right
func f32_add left -> right => return @simd.f32x4.add left right
func f32_sub left -> right => return @simd.f32x4.sub left right
func f32_mul left -> right => return @simd.f32x4.mul left right
func f32_div left -> right => return @simd.f32x4.div left right
func f32_abs value => return @simd.f32x4.abs value
func f32_neg value => return @simd.f32x4.neg value
func f32_sqrt value => return @simd.f32x4.sqrt value
func f32_ceil value => return @simd.f32x4.ceil value
func f32_floor value => return @simd.f32x4.floor value
func f32_trunc value => return @simd.f32x4.trunc value
func to_f32 value => return @simd.u32x4.to_f32 value
func to_u32 value => return @simd.f32x4.to_u32 value
// Signed conversions use two's-complement U32 lane bits. Float-to-signed
// truncates toward zero and saturates, including zero for NaN.
func to_f32_signed value => return @simd.u32x4.to_f32_signed value
func to_u32_signed value => return @simd.f32x4.to_u32_signed value

// Shifts take a scalar count, which wraps modulo 32 like the U32 `<<`/`>>`.
// `u32_sar` shifts in copies of each lane's top bit.
func u32_shl (count: U32) -> lanes => return @simd.u32x4.shl lanes count
func u32_shr (count: U32) -> lanes => return @simd.u32x4.shr lanes count
func u32_sar (count: U32) -> lanes => return @simd.u32x4.sar lanes count

// `f32_min a b` is the prelude's `min a b`, `if a < b then a else b`, in each
// lane, including its NaN and signed-zero choices; `f32_max` likewise.
func f32_min left -> right => return @simd.f32x4.min left right
func f32_max left -> right => return @simd.f32x4.max left right
func u32_min left -> right => return @simd.u32x4.min left right
func u32_max left -> right => return @simd.u32x4.max left right

// Comparisons give a U32x4 mask: all ones where the scalar comparison holds,
// zero elsewhere. Unsigned comparisons follow U32 ordering.
func f32_eq left -> right => return @simd.f32x4.eq left right
func f32_ne left -> right => return @simd.f32x4.ne left right
func f32_lt left -> right => return @simd.f32x4.lt left right
func f32_le left -> right => return @simd.f32x4.le left right
func f32_gt left -> right => return @simd.f32x4.gt left right
func f32_ge left -> right => return @simd.f32x4.ge left right
func u32_eq left -> right => return @simd.u32x4.eq left right
func u32_ne left -> right => return @simd.u32x4.ne left right
func u32_lt left -> right => return @simd.u32x4.lt left right
func u32_le left -> right => return @simd.u32x4.le left right
func u32_gt left -> right => return @simd.u32x4.gt left right
func u32_ge left -> right => return @simd.u32x4.ge left right

// Selection is bitwise: a mask bit of one takes `yes`, zero takes `no`.
func f32_select (mask: U32x4) -> yes -> no => return @simd.f32x4.select mask (yes, no)
func u32_select (mask: U32x4) -> yes -> no => return @simd.u32x4.select mask (yes, no)
// There is no I32 surface type. Flip the sign bit to compare U32 lanes as
// two's-complement signed words, then use the same masks and selection.
const u32_sign_mask = (0x80000000, 0x80000000, 0x80000000, 0x80000000)
func u32_lt_signed left -> right => return u32_lt (u32_xor left u32_sign_mask) (u32_xor right u32_sign_mask)
func u32_le_signed left -> right => return u32_le (u32_xor left u32_sign_mask) (u32_xor right u32_sign_mask)
func u32_gt_signed left -> right => return u32_gt (u32_xor left u32_sign_mask) (u32_xor right u32_sign_mask)
func u32_ge_signed left -> right => return u32_ge (u32_xor left u32_sign_mask) (u32_xor right u32_sign_mask)
func u32_min_signed left -> right => return u32_select (u32_lt_signed left right) left right
func u32_max_signed left -> right => return u32_select (u32_gt_signed left right) left right
// Wasm SIMD has no integer divide. Keep U32's quotient and divide-by-zero
// behavior with four scalar lanes until a vector reciprocal is appropriate.
func u32_div (left: U32x4) -> (right: U32x4) => return do:
  let (a, b, c, d) = left
  let (e, f, g, h) = right
  break (@u32.div a e, @u32.div b f, @u32.div c g, @u32.div d h)
func u32_not lanes => return @simd.u32x4.not lanes
func u32_andnot left -> right => return @simd.u32x4.andnot left right
func any_true mask => return @simd.u32x4.any_true mask
func all_true mask => return @simd.u32x4.all_true mask

// Lane selectors must be literal U32 values at a direct, fully applied call.
// Shuffle indices 0-3 take lanes from `left`, 4-7 from `right`.
func f32_shuffle lanes -> left -> right => return @simd.f32x4.shuffle lanes (left, right)
func f32_swizzle lanes -> value => return @simd.f32x4.swizzle lanes value
func f32_broadcast (lane: U32) -> value => return @simd.f32x4.broadcast value lane
func u32_shuffle lanes -> left -> right => return @simd.u32x4.shuffle lanes (left, right)
func u32_swizzle lanes -> value => return @simd.u32x4.swizzle lanes value
func u32_broadcast (lane: U32) -> value => return @simd.u32x4.broadcast value lane

// Bit reinterpretation keeps every bit, including NaN payloads.
func f32_bits lanes => return @simd.f32x4.bits lanes
func f32_from_bits lanes => return @simd.u32x4.from_bits lanes

// Opt-in fused or unfused `a * b + c` and `-(a * b) + c`. Their rounding
// depends on the host; nothing else selects them implicitly.
func f32_relaxed_madd a -> b -> c => return @simd.f32x4.relaxed_madd a (b, c)
func f32_relaxed_nmadd a -> b -> c => return @simd.f32x4.relaxed_nmadd a (b, c)

// One range check precedes the index arithmetic, so a wrapping index cannot
// select unrelated lanes. Loads copy four elements; stores keep the ordinary
// Array snapshot contract and replace in place when the Array is exclusive.
// U32, F32 and Bool elements are supported.
func load index -> values => return @simd.load values index
func store index -> lanes -> values => return @simd.store values index lanes

// Reductions never reassociate implicitly. The pairwise variant is an explicit
// choice of grouping and can round differently from the left-to-right version.
func f32_sum (values: F32x4) => return do:
  let (a, b, c, d) = values
  break ((a + b) + c) + d
func f32_sum_pairwise (values: F32x4) => return do:
  let (a, b, c, d) = values
  break (a + b) + (c + d)
func u32_sum (values: U32x4) => return do:
  let (a, b, c, d) = values
  break ((a + b) + c) + d
// Dot products group exactly like std/vector's `Vec3.dot`, left to right:
// `((a.x * b.x + a.y * b.y) + a.z * b.z) + a.w * b.w`; `f32_dot3` ignores lane 3.
func f32_dot (left: F32x4) -> (right: F32x4) => return do:
  let (x, y, z, w) = f32_mul left right
  break ((x + y) + z) + w
func f32_dot3 (left: F32x4) -> (right: F32x4) => return do:
  let (x, y, z, _) = f32_mul left right
  break (x + y) + z
