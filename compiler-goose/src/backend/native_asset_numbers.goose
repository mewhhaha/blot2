fn compare(left: const Big&,right: const Big&) -> i64 {if left.len < right.len {return -1;}if left.len > right.len {return 1;}var index = left.len;while index != 0 {index--;if left.words[index] < right.words[index] {return -1;}if left.words[index] > right.words[index] {return 1;}}return 0;}
fn bitLength(self: const Big&) -> i64 {if self.len == 0 {return 0;}var value = self.words[self.len - 1];var bits: i64 = 0;while value != 0 {value >>= 1;bits++;}return (self.len - 1) * 32 + bits;}
fn shifted(self: const Big&,amount: i64) -> Big {assert(amount >= 0);if self.len == 0 {return Big {..};}let whole = amount / 32;let part = amount % 32;assert(self.len + whole + 1 <= 256);var result = Big {..};var carry: u64 = 0;for index in 0..self.len {let word = (self.words[index] as u64 << part) | carry;result.words[index + whole] = word as! u32;carry = word >> 32;}result.len = self.len + whole;if carry != 0 {result.words[result.len] = carry as u32;result.len++;}return result;}
fn subtract(self: Big&,other: const Big&) {assert(compare(self,other) >= 0);var borrow: u64 = 0;for index in 0..self.len {var right: u64 = borrow;if index < other.len {right += other.words[index];}let left = self.words[index] as u64;self.words[index] = (left + 4294967296 - right) as! u32;borrow = 0;if left < right {borrow = 1;}}assert(borrow == 0);self.trim();}
fn ratio(numerator: Big,denominator: Big,negative: bool,sticky: bool) -> f64 {
    var sign: u64 = 0;if negative {sign = 9223372036854775808;}if numerator.len == 0 {return blot_native::f64_from_bits(sign);}var exponent = numerator.bitLength() - denominator.bitLength();if exponent >= 0 {let scale = denominator.shifted(exponent);if compare(numerator,scale) < 0 {exponent--;}}else {let scale = numerator.shifted(-exponent);if compare(scale,denominator) < 0 {exponent--;}}
    if exponent > 1023 {return blot_native::f64_from_bits(sign | 9218868437227405312);}if exponent < -1075 {return blot_native::f64_from_bits(sign);}var shift: i64 = 1074;if exponent >= -1022 {shift = 52 - exponent;}var dividend = numerator;var divisor = denominator;if shift >= 0 {dividend = numerator.shifted(shift);}else {divisor = denominator.shifted(-shift);}var quotient: u64 = 0;var bit: i64 = 64;
    while bit != 0 {bit--;if divisor.bitLength() + bit > dividend.bitLength() {continue;}let candidate = divisor.shifted(bit);if compare(dividend,candidate) >= 0 {dividend.subtract(candidate);quotient |= 1 as u64 << bit;}}
