 var inputs: u32[>..<]=[]; inputs.append(self.session.storage.evidence.children(key.inputs)); for input in inputs { let resolved,error=self.solver.resolve(cursor,0); if error!=Error.none { return 0,error; } let arrow=self.solver.node(resolved); if arrow.tag!=TypeTag.function { return 0,Error.unresolved_type; } let actual,e=importEvidence(self,input,0); if e!=Error.none { return 0,e; } let joined=unify(self,arrow.a,actual); if joined!=Error.none { return 0,joined; } cursor=arrow.b; } if key.lexical==0 { self.scratch.unresolved_calls.insert(key.target,scope); } let collected=collect(self,scope,self.scratch.sources[scope].body); return scope,collected;
