// Exact constructor facts grant no authority without complete frame-flow proof.
namespace blot_backend_provider_origins;
import .runtime_ir;
import .wasm;
import runtime.runtime_layout;
import support.option;
let begin_chunk: u8 = 8;
let end_chunk: u8 = 9;
struct Fact { local: u32,kind: u32,value_role: blot_backend_runtime_ir::Role,value_machine: blot_backend_runtime_ir::ValueType,read: u32,write: blot_support::Option<u32>,allocation: i64,end: i64 }
fn marker(instruction: blot_backend_runtime_ir::Instruction,chunk: u8) -> blot_support::Option<u32> { if instruction.op != blot_backend_runtime_ir::OP_ownership { return blot_support::none<u32>(); } let fact = blot_backend_runtime_ir::ownership(instruction.operand); if fact.kind != blot_backend_runtime_ir::OWN_rest || fact.chunk != chunk { return blot_support::none<u32>(); } return blot_support::some(fact.roles); }
fn operation(instructions: const blot_backend_runtime_ir::Instruction[:],at: i64) -> blot_support::Option<u32> { if at + 1 >= instructions.len || instructions[at].op != blot_backend_runtime_ir::OP_i32_const || instructions[at].table_reference || instructions[at].operand == 0 || instructions[at + 1].op != blot_backend_runtime_ir::OP_drop { return blot_support::none<u32>(); } return blot_support::some(instructions[at].operand); }
fn frameBytes(kind: u32) -> blot_support::Option<u32> {
    match kind { 0=>{ return blot_support::some(blot_runtime_runtime_layout::ProviderFrame_bytes); },3=>{ return blot_support::some(blot_runtime_runtime_layout::RequestFrame_bytes); },4=>{ return blot_support::some(blot_runtime_runtime_layout::StateFrame_bytes); },5=>{ return blot_support::some(blot_runtime_runtime_layout::ScopedStateFrame_bytes); },6=>{ return blot_support::some(blot_runtime_runtime_layout::ScopedFrame_bytes); },7=>{ return blot_support::some(blot_runtime_runtime_layout::ScopedRequestFrame_bytes); },_=>{ return blot_support::none<u32>(); }, }
}
fn wordRole(kind: u32,value: blot_backend_runtime_ir::Role,word: i64) -> blot_backend_runtime_ir::Role { if word == 0 || word == 3 { return blot_backend_runtime_ir::ROLE_scalar; } if word == 1 { return value; } if (kind == 4 || kind == 5) && word == 4 { return blot_backend_runtime_ir::ROLE_scalar; } return blot_backend_runtime_ir::ROLE_reference; }
struct Value { frame: bool = false,constant: blot_support::Option<u32>,machine: blot_backend_runtime_ir::ValueType = blot_backend_runtime_ir::VT_i32 }
fn constructor(module: const blot_backend_wasm::Module&,body: const blot_backend_runtime_ir::Function&,at: i64) -> blot_support::Option<Fact> {
    let instructions = blot_backend_wasm::instructions(module,body); if at >= instructions.len { return blot_support::none<Fact>(); } let local = marker(instructions[at],begin_chunk); if !local.present || local.value < body.parameters.len || local.value >= body.parameters.len + body.locals.len { return blot_support::none<Fact>(); } let read = operation(instructions,at + 1); if !read.present { return blot_support::none<Fact>(); } var finish = at + 3; var write = blot_support::none<u32>();
    if finish < instructions.len && !marker(instructions[finish],end_chunk).present { write = operation(instructions,finish); if !write.present { return blot_support::none<Fact>(); } finish += 2; } if finish >= instructions.len { return blot_support::none<Fact>(); } let encoded = marker(instructions[finish],end_chunk); if !encoded.present || encoded.value >> 5 != 0 { return blot_support::none<Fact>(); }
    let kind = encoded.value & 7; let role = ((encoded.value >> 3) & 3) as blot_backend_runtime_ir::Role; if role != blot_backend_runtime_ir::ROLE_scalar && role != blot_backend_runtime_ir::ROLE_reference { return blot_support::none<Fact>(); } if (kind == 4 || kind == 5) != write.present || (kind != 4 && kind != 5 && role != blot_backend_runtime_ir::ROLE_reference) { return blot_support::none<Fact>(); } let bytes = frameBytes(kind); if !bytes.present || !module.arena.present { return blot_support::none<Fact>(); } let arena = module.arena.value; var allocation = blot_support::none<i64>();
    for instruction,index in instructions[..at] {
        if (instruction.op != blot_backend_runtime_ir::OP_local_set && instruction.op != blot_backend_runtime_ir::OP_local_tee) || instruction.operand != local.value { continue; }
        if allocation.present || instruction.op != blot_backend_runtime_ir::OP_local_set || index < 2 || instructions[index - 1].op != blot_backend_runtime_ir::OP_call { return blot_support::none<Fact>(); } var allocator = instructions[index - 1].operand == arena.allocate;
        if !allocator && module.regions.present { allocator = instructions[index - 1].operand == module.regions.value.runtime.frame_allocate && bytes.value == module.regions.value.plan.frame_bytes; } if !allocator || instructions[index - 2].op != blot_backend_runtime_ir::OP_i32_const || instructions[index - 2].operand != bytes.value { return blot_support::none<Fact>(); }
        let roles = blot_backend_runtime_ir::allocationAnnotations(instructions,index - 1); if roles.len == 0 { return blot_support::none<Fact>(); } for word in 0..bytes.value / 4 { if blot_backend_runtime_ir::wordRole(roles,word) != wordRole(kind,role,word) { return blot_support::none<Fact>(); } } allocation = blot_support::some(index - 1);
    }
    if !allocation.present { return blot_support::none<Fact>(); } let allocated = allocation.value; if at - allocated > 96 { return blot_support::none<Fact>(); } var stack: Value[16] = [Value {..};16]; var height: i64 = 0; var fields: u32 = 0; var value_machine = blot_backend_runtime_ir::VT_i32;
    for instruction in instructions[allocated + 2..at] {
        let op = instruction.op;
        if op == blot_backend_runtime_ir::OP_local_get {
            if height == 16 || instruction.operand >= body.parameters.len + body.locals.len { return blot_support::none<Fact>(); } var machine = blot_backend_runtime_ir::VT_i32; if instruction.operand < body.parameters.len { machine = module.parameters(body)[instruction.operand]; } else { machine = module.locals(body)[instruction.operand - body.parameters.len]; } stack[height] = Value { frame: instruction.operand == local.value,machine: machine , ..}; height++;
        } else if op == blot_backend_runtime_ir::OP_i32_const || op == blot_backend_runtime_ir::OP_f32_const {
            if height == 16 || instruction.table_reference { return blot_support::none<Fact>(); } var machine = blot_backend_runtime_ir::VT_i32; if op == blot_backend_runtime_ir::OP_f32_const { machine = blot_backend_runtime_ir::VT_f32; } stack[height] = Value { constant: blot_support::some(instruction.operand),machine: machine , ..}; height++;
        } else if op == blot_backend_runtime_ir::OP_i32_load || op == blot_backend_runtime_ir::OP_f32_load {
            if height == 0 || stack[height - 1].frame || stack[height - 1].machine != blot_backend_runtime_ir::VT_i32 { return blot_support::none<Fact>(); } var machine = blot_backend_runtime_ir::VT_i32; if op == blot_backend_runtime_ir::OP_f32_load { machine = blot_backend_runtime_ir::VT_f32; } stack[height - 1] = Value { machine: machine , ..};
        } else if op == blot_backend_runtime_ir::OP_i32_store || op == blot_backend_runtime_ir::OP_f32_store {
            if height < 2 || !stack[height - 2].frame || instruction.operand % 4 != 0 || instruction.operand >= bytes.value { return blot_support::none<Fact>(); } let bit = 1 as u32 << (instruction.operand / 4); if (fields & bit) != 0 { return blot_support::none<Fact>(); } let stored = stack[height - 1]; if stored.frame { return blot_support::none<Fact>(); } var machine = blot_backend_runtime_ir::VT_i32; if op == blot_backend_runtime_ir::OP_f32_store { machine = blot_backend_runtime_ir::VT_f32; } if stack[height - 2].machine != blot_backend_runtime_ir::VT_i32 || stored.machine != machine { return blot_support::none<Fact>(); }
            if machine == blot_backend_runtime_ir::VT_f32 && (instruction.operand != 4 || role != blot_backend_runtime_ir::ROLE_scalar || (kind != 4 && kind != 5)) { return blot_support::none<Fact>(); } if instruction.operand == 4 { value_machine = machine; } if instruction.operand == 0 && (!stored.constant.present || stored.constant.value != read.value) { return blot_support::none<Fact>(); }
            if (kind == 4 || kind == 5) && instruction.operand == blot_runtime_runtime_layout::StateFrame_write && (!stored.constant.present || stored.constant.value != write.value) { return blot_support::none<Fact>(); } if instruction.operand == blot_runtime_runtime_layout::ProviderFrame_kind && (op != blot_backend_runtime_ir::OP_i32_store || !stored.constant.present || stored.constant.value != kind) { return blot_support::none<Fact>(); } fields |= bit; height -= 2;
        } else if op == blot_backend_runtime_ir::OP_ownership { let fact = blot_backend_runtime_ir::ownership(instruction.operand); if fact.kind == blot_backend_runtime_ir::OWN_scope || fact.kind == blot_backend_runtime_ir::OWN_call_result { return blot_support::none<Fact>(); } }
        else { return blot_support::none<Fact>(); }
    }
    if height != 0 || fields != ((1 as u32 << (bytes.value / 4)) - 1) { return blot_support::none<Fact>(); } return blot_support::some(Fact { local: local.value,kind: kind,value_role: role,value_machine: value_machine,read: read.value,write: write,allocation: allocated,end: finish , ..});
}
