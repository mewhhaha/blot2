 if valueInfo(self,result).kind!=ValueKind.closure&&hasExplicitScheme(self,resolved.unit,body.scheme) { let actual_value=valueEvidence(self,result); if actual_value!=0 { let matched,error=matchType(self,resolved.unit,body.root,resolved.unit,body.scheme.root,actual_value,mappings,rows); if error!=Error.none { return 0,error; } if !matched { return 0,failNode(self,resolved.unit,body.root,Code.type_mismatch); } } let error=validateScheme(self,resolved.unit,body.root,body.scheme,frame,false); if error!=Error.none { return 0,error; } }
 let actual,e=projectType(self,resolved.unit,body.root,body.scheme.root,mappings,rows); if e!=Error.none { return 0,e; } let published,error=typedView(self,resolved.unit,body.root,result,actual); if error!=Error.none { return 0,error; }
