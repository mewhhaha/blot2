struct RowOrder {types:const blot_check_core::Types&,remaining:i64&,rows:u32[:]}
fn lessThan(self:RowOrder,left:i64,right:i64)->bool {self.remaining=max(0,self.remaining-1);return rowVariable(self.types,self.rows[left])<rowVariable(self.types,self.rows[right]);}
fn swap(self:RowOrder,left:i64,right:i64) {let value=self.rows[left];self.rows[left]=self.rows[right];self.rows[right]=value;}
fn sortRows(self:Walker&,rows:u32[:])->Error {blot_check_source_sort::pdqContext(0,rows.len,RowOrder{types:self.module.types,remaining:self.scopes.remaining,rows:rows, ..});return require(self.scopes.remaining!=0);}
fn sourceRows(self:Walker&)->const u32[:],Error {if self.has_source_row_index {return self.source_row_index,Error.none;}for index in self.admission.source_rows.items {if sameModule(index.module,self.module) {self.source_row_index=index.rows;self.has_source_row_index=true;return index.rows,Error.none;}}let workspace .= self.admission.workspace;if !workspace {return [],Error.invalid_artifact;}var pending=WordBuffer{..};let error=sourceRowsValue(self,pending);pending.deinit(word_runs);if error!=Error.none {if error==Error.out_of_memory {workspace.oom=true;}return [],Error.invalid_artifact;}return self.source_row_index,Error.none;}
