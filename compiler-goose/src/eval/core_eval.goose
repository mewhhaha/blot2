fn deinit(self: PrincipalGraph&) { assert(self.leases!=0); self.leases--; if self.leases!=0 { return; } let index=self.pool_index; assert(index>=0); for constraint in self.constraints { principal_names_pool.free_slice(constraint.diagnostic_name); } for constraint in self.requirements { principal_names_pool.free_slice(constraint.diagnostic_name); } principal_constraint_pool.free_slice(self.constraints); principal_constraint_pool.free_slice(self.requirements); principal_import_pool.free_slice(self.imports); principal_row_import_pool.free_slice(self.rows); principal_alias_pool.free_slice(self.aliases); principal_words_pool.free_slice(self.functions); principal_words_pool.free_slice(self.arguments); principal_targets_pool.free_slice(self.references); principal_actions_pool.free_slice(self.actions); principal_sources_pool.free_slice(self.dependencies); principal_plain_pool.free_slice(self.plain_reads); let error=blot_check_types::deinit(self.types); assert(error==Error.none); principal_graph_pool.free(index); }
