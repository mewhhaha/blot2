// Public constructors publish only complete ownership; failed resume empties it.
namespace blot_reuse_project_check;
import .project_check;
fn checkProject<E>(executor:E&,source:Project&)->CheckedProject,Error {return checkProjectWithPrivateExecution(executor,source,blot_check_check::PrivateExecution{..});}
fn checkProjectWithPrivateExecution<E>(executor:E&,source:Project&,execution:blot_check_check::PrivateExecution)->CheckedProject,Error {return checkProjectMode(executor,source,execution,blot_support::none<blot_reuse_entry_frontend_cutoff::Previous>(),Editor.none,false);}
fn checkProjectForEditor<E>(executor:E&,source:Project&,query:EditorQuery)->CheckedProject,Error {return checkProjectMode(executor,source,blot_check_check::PrivateExecution{..},blot_support::none<blot_reuse_entry_frontend_cutoff::Previous>(),Editor.query{query, ..},false);}
fn checkProjectWithEntryCutoff<E>(executor:E&,source:Project&,previous:blot_reuse_entry_frontend_cutoff::Previous)->CheckedProject,Error {return checkProjectMode(executor,source,blot_check_check::PrivateExecution{..},blot_support::some(previous),Editor.none,true);}
fn checkProjectRetainingBodies<E>(executor:E&,source:Project&,previous:blot_support::Option<blot_reuse_entry_frontend_cutoff::Previous>)->CheckedProject,Error {return checkProjectMode(executor,source,blot_check_check::PrivateExecution{..},previous,Editor.none,true);}
fn checkProjectToFirstDiagnostic<E>(executor:E&,source:Project&,previous:blot_support::Option<blot_reuse_entry_frontend_cutoff::Previous>,retain_bodies:bool)->CheckedProject,Error {return checkProjectModeDeferring(executor,source,blot_check_check::PrivateExecution{..},previous,Editor.none,retain_bodies,false,true);}
fn checkProjectDeferringEntry<E>(executor:E&,source:Project&,previous:blot_support::Option<blot_reuse_entry_frontend_cutoff::Previous>)->CheckedProject,Error {return checkProjectModeDeferring(executor,source,blot_check_check::PrivateExecution{..},previous,Editor.none,true,true,false);}
fn checkProjectDeferringEntryToFirstDiagnostic<E>(executor:E&,source:Project&,previous:blot_support::Option<blot_reuse_entry_frontend_cutoff::Previous>)->CheckedProject,Error {return checkProjectModeDeferring(executor,source,blot_check_check::PrivateExecution{..},previous,Editor.none,true,true,true);}
fn checkProjectMode<E>(executor:E&,source:Project&,execution:blot_check_check::PrivateExecution,previous:blot_support::Option<blot_reuse_entry_frontend_cutoff::Previous>,editor:Editor,retain_bodies:bool)->CheckedProject,Error {return checkProjectModeDeferring(executor,source,execution,previous,editor,retain_bodies,false,false);}
fn finishProject(engine:Engine&)->CheckedProject {engine.result.diagnostics=copyOwned(engine.diagnostics.items);engine.diagnostics.items=engine.diagnostics.storage[..0];let result=engine.result;engine.result=CheckedProject{..};return result;}
fn checkProjectModeDeferring<E>(executor:E&,source:Project&,execution:blot_check_check::PrivateExecution,previous:blot_support::Option<blot_reuse_entry_frontend_cutoff::Previous>,editor:Editor,retain_bodies:bool,defer_entry:bool,first_diagnostic:bool)->CheckedProject,Error {
 let timing=blot_phase_profile::enter(blot_phase_profile::Phase.check);let engine,error=initEngine(source,execution,editor,retain_bodies);if error!=Error.none {timing.exit();return CheckedProject{..},error;}assert(engine);
 let error=checkProjectInto(engine,executor,previous,defer_entry,first_diagnostic);if error!=Error.none {engine.deinit();timing.exit();return CheckedProject{..},error;}let result=finishProject(engine);engine.deinit();timing.exit();return result,Error.none;
}
fn checkProjectInto<E>(self:Engine&,executor:E&,previous:blot_support::Option<blot_reuse_entry_frontend_cutoff::Previous>,defer_entry:bool,first_diagnostic:bool)->Error {
 { let propagated_error = self.offerBodies(previous); if propagated_error != Error.none { return propagated_error; } }let source=self.source;if source.diagnostics.len!=0 {for diagnostic in source.diagnostics.items {{ let propagated_error = self.diagnostics.push(Diagnostic{unit:diagnostic.unit,span:diagnostic.span,code:Code.source_validation,source:blot_support::some(diagnostic), ..}); if propagated_error != Error.none { return propagated_error; } }}return Error.none;}
 { let propagated_error = self.result.allocateModules(source.units.len,self.retain_bodies); if propagated_error != Error.none { return propagated_error; } }self.source_validation=source.input_mode==blot_reuse_project::InputMode.source && blot_check_check::sourceImportDiagnostic(source.unit(source.entry).tree).present;
 for unit in source.units.items {if blot_check_check::hasNumericFailure(unit.tree) {self.source_validation=true;break;}}
 if self.source_validation {self.source_modules=source_module_runs.alloc_slice(source.units.len);for &value in self.source_modules {value=blot_support::none<SourceModule>();}}
 if previous.present && previous.value.reuse_modules && !self.source_validation {{ let propagated_error = self.result.allocateReuse(source.compiled_modules.len); if propagated_error != Error.none { return propagated_error; } }}
 { let propagated_error = self.initCompiledCatalogs(); if propagated_error != Error.none { return propagated_error; } }let deferrable=defer_entry && source.input_mode==blot_reuse_project::InputMode.project && !self.source_validation && source.order.len!=0 && source.order.items[source.order.len-1]==source.entry;
 var parallel=false;if !previous.present {let checked,error=self.checkParallel(executor,deferrable);{ let propagated_error = error; if propagated_error != Error.none { return propagated_error; } }parallel=checked;}
 if !parallel {for unit in source.order.items {if deferrable && unit==source.entry {self.result.deferred_entry=blot_support::some(Deferred{self.resolution_remaining,self.associated_remaining, ..});break;}let continued,error=self.checkOrdered(unit,previous);{ let propagated_error = error; if propagated_error != Error.none { return propagated_error; } }if !continued {break;}if first_diagnostic && !self.source_validation && self.diagnostics.items.len!=0 {break;}}}
 return Error.none;
}
fn checkDeferredEntry<E>(executor:E&,source:Project&,checked:CheckedProject&,previous:blot_support::Option<blot_reuse_entry_frontend_cutoff::Previous>)->Error {
 if !checked.deferred_entry.present {return Error.none;}let deferred=checked.deferred_entry.value;let timing=blot_phase_profile::enter(blot_phase_profile::Phase.check);
 let engine,error=initEngine(source,blot_check_check::PrivateExecution{..},Editor.none,checked.body_caches.len!=0);if error!=Error.none {checked.deinit();timing.exit();return error;}assert(engine);engine.result.deinit();engine.result=copy(checked);checked=CheckedProject{..};engine.resolution_remaining=deferred.resolution_remaining;engine.associated_remaining=deferred.associated_remaining;engine.result.deferred_entry=blot_support::none<Deferred>();
 engine.diagnostics=DiagnosticBuffer{engine.result.diagnostics,engine.result.diagnostics, ..};engine.result.diagnostics=[];
 let error=resumeEntry(engine,previous);if error!=Error.none {engine.deinit();timing.exit();return error;}checked=finishProject(engine);engine.deinit();timing.exit();return Error.none;
}
fn resumeEntry(self:Engine&,previous:blot_support::Option<blot_reuse_entry_frontend_cutoff::Previous>)->Error {{ let propagated_error = self.offerBodies(previous); if propagated_error != Error.none { return propagated_error; } }{ let propagated_error = self.initCompiledCatalogs(); if propagated_error != Error.none { return propagated_error; } }let ignored,error=self.checkOrdered(self.source.entry,previous);return error;}
