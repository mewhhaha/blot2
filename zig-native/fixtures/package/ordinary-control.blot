type Item = exists [a] => a
const item: Item = pack [U32] 2 as Item
effect Read: U32 -> U32
const request = func (host: U32 -> U32 ! {Foreign}) => return do:
  let count = 0
  for request in @requests (@computation (func () => return Read 2)):
    case request of
      effect Read value =>
        count := @u32.add count 1
        yield host value
      complete value =>
        break @u32.add count value
const update = func (value: U32) => return do:
  let record = {value, other: 40}
  record.value := @u32.add self 1
  let changed = @record.merge record {other: 2}
  break @u32.add changed.value changed.other
const loop = func (first: U32) => return do:
  let result = first
  for index in 0..4:
    if @u32.eq index 2:
      break
    result := @u32.add self index
  break result
const choose = func (value: U32) => return case value of
  0 => 7
  other => @u32.add other 1
const demand = func ~(value: U32) => return @u32.add (@force value) (@force value)
