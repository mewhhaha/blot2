fn put(receiver:Writer&,value:squid_check_check::Checked) {if !receiver.enter() {return;}put(receiver,value.function_exit_lambdas);put(receiver,value.editor);put(receiver,value.iterator_bodies);put(receiver,value.initializer_rejected);put(receiver,value.computations);put(receiver,value.reflections);put(receiver,value.tag_origins);put(receiver,value.effect_runners);put(receiver,value.effect_runner_ids);put(receiver,value.provider_blocks);put(receiver,value.provider_block_ids);put(receiver,value.body_closed_rows);put(receiver,value.lambda_closed_rows);put(receiver,value.dispatch_signatures);put(receiver,value.covered_requirements);put(receiver,value.effect_families);put(receiver,value.effect_templates);put(receiver,value.operation_uses);put(receiver,value.operation_refs);put(receiver,value.types);put(receiver,value.parameter_patterns);put(receiver,value.expr_types);put(receiver,value.resolved);put(receiver,value.bindings);put(receiver,value.merges);put(receiver,value.obligations);put(receiver,value.diagnostics);put(receiver,value.body_elaborations);put(receiver,value.imported_schemes);put(receiver,value.counters);put(receiver,value.unit);put(receiver,value.associated);put(receiver,value.nominals);put(receiver,value.contracts);put(receiver,value.contract_predicates);put(receiver,value.contract_members);put(receiver,value.implementations);put(receiver,value.implementation_predicates);put(receiver,value.implementation_members);put(receiver,value.member_templates);put(receiver,value.constructors);put(receiver,value.constructor_resolved);put(receiver,value.projections);put(receiver,value.access_paths);put(receiver,value.access_nodes);put(receiver,value.access_types);put(receiver,value.projection_resolved);put(receiver,value.projection_catalog);put(receiver,value.rebindings);put(receiver,value.loop_carries);put(receiver,value.loop_ranges);put(receiver,value.loop_exits);put(receiver,value.statement_arms);receiver.depth--;}
fn get(receiver:Reader&,value:squid_check_check::Checked&) {
 if !receiver.enter() {return;}value=default<squid_check_check::Checked>();let owner,error=squid_check_check::newCheckedOwner();if error!=squid_error::Error.none {receiver.failure=error;receiver.depth--;return;}value.owner=owner;
get(receiver,value.function_exit_lambdas);get(receiver,value.editor);get(receiver,value.iterator_bodies);get(receiver,value.initializer_rejected);get(receiver,value.computations);get(receiver,value.reflections);get(receiver,value.tag_origins);get(receiver,value.effect_runners);get(receiver,value.effect_runner_ids);get(receiver,value.provider_blocks);get(receiver,value.provider_block_ids);get(receiver,value.body_closed_rows);get(receiver,value.lambda_closed_rows);get(receiver,value.dispatch_signatures);get(receiver,value.covered_requirements);get(receiver,value.effect_families);get(receiver,value.effect_templates);get(receiver,value.operation_uses);get(receiver,value.operation_refs);get(receiver,value.types);get(receiver,value.parameter_patterns);get(receiver,value.expr_types);get(receiver,value.resolved);get(receiver,value.bindings);get(receiver,value.merges);get(receiver,value.obligations);get(receiver,value.diagnostics);get(receiver,value.body_elaborations);get(receiver,value.imported_schemes);get(receiver,value.counters);get(receiver,value.unit);get(receiver,value.associated);get(receiver,value.nominals);get(receiver,value.contracts);get(receiver,value.contract_predicates);get(receiver,value.contract_members);get(receiver,value.implementations);get(receiver,value.implementation_predicates);get(receiver,value.implementation_members);get(receiver,value.member_templates);get(receiver,value.constructors);get(receiver,value.constructor_resolved);get(receiver,value.projections);get(receiver,value.access_paths);get(receiver,value.access_nodes);get(receiver,value.access_types);get(receiver,value.projection_resolved);get(receiver,value.projection_catalog);get(receiver,value.rebindings);get(receiver,value.loop_carries);get(receiver,value.loop_ranges);get(receiver,value.loop_exits);get(receiver,value.statement_arms);
 if receiver.failure!=squid_error::Error.none {value.types.deinit();value.parameter_patterns.deinit();value.owner.deinit();value=default<squid_check_check::Checked>();receiver.depth--;return;}
 let diagnostics=value.diagnostics;value.diagnostics=default<squid_check_check::Diagnostic[:]>();let cloned,error=squid_check_check::cloneDiagnostics(value.owner,diagnostics);if error!=squid_error::Error.none {value.types.deinit();value.parameter_patterns.deinit();value.owner.deinit();value=default<squid_check_check::Checked>();receiver.failure=error;receiver.depth--;return;}value.diagnostics=cloned;
 if value.editor.present&&value.editor.value.context.present {let source=value.editor.value.context.value;value.editor.value.context=squid_support::none<squid_reuse_hole_diagnostics::Snapshot>();let context,error=source.clone();if error!=squid_error::Error.none {value.deinit();receiver.failure=error;receiver.depth--;return;}value.editor.value.context=squid_support::Option<squid_reuse_hole_diagnostics::Snapshot>{true,context};}
