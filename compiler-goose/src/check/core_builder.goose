fn Builder::projectQuantifierGoals(self:Builder&,source:u32,id:u32,depth:i64)->Error {let goals=self.source.checked.types.quantifierGoals(source);if goals.len==0 {return Error.none;}if self.tables.quantifier_obligations.len>0xffffffff || goals.len>0xffffffff-self.tables.quantifier_obligations.len {return Error.core_limit;}let start=self.tables.quantifier_obligations.len as u32;for goal in goals {self.tables.quantifier_obligations.push(blot_check_types::Obligation{ty:0,kind:blot_check_types::ObligationKind.type_rep,source:0, ..});}self.tables.quantifier_goals.push(blot_check_types::QuantifierGoals{owner:id,goals:blot_check_types::List{start,goals.len as u32, ..}, ..});for old,ordinal in goals {var goal=old;let ty,error=self.projectType(old.ty,depth+1);if error!=Error.none {return error;}goal.ty=ty;let other,error=self.projectType(old.other,depth+1);if error!=Error.none {return error;}goal.other=other;let result,error=self.projectType(old.result,depth+1);if error!=Error.none {return error;}goal.result=result;let signature,error=self.projectType(old.signature,depth+1);if error!=Error.none {return error;}goal.signature=signature;goal.source=0;self.tables.quantifier_obligations[start+ordinal]=goal;}return Error.none;}
fn Builder::projectRowVariable(self:Builder&,variable:u32)->u32,Error {if variable>=self.scratch.effect_variable_map.len {return 0,Error.core_limit;}if self.scratch.effect_variable_map[variable]!=0 {return self.scratch.effect_variable_map[variable]-1,Error.none;}if self.scratch.effect_variable_count==0xffffffff {return 0,Error.core_limit;}let id=self.scratch.effect_variable_count;self.scratch.effect_variable_count+=1;self.scratch.effect_variable_map[variable]=id+1;return id,Error.none;}
