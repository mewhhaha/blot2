type Brick is data = $Brick { from: U32, to: U32 }
type Access = { bricks: Array Brick, count: Array U32 }
func shift (access: own Access) -> (by: U32): Access => return do:
  for index in 0 .. access.bricks.length:
    let brick = access.bricks[index]
    brick.from := self + by
    access.bricks[index] := brick
  access.count[0] := 7
  return access
io run (n: U32): U32 => return do:
  let bricks: Array Brick = #[$Brick { from: 1, to: 2 }]
  let access = { bricks, count: #[0] }
  access := shift access n
  let $Brick { from, to } = access.bricks[0]
  break from * 100 + to + access.count[0]
