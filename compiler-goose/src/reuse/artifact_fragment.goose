fn declaredCallableLayout(self:const State&,id:u32)->blot_support::Option<u32> {if id==0 || id>self.old.metadata.jobs.len {return blot_support::none<u32>();}var applied:u32=0;var ty:u32=0;match self.old.metadata.jobs.items[id-1].request {Request.closure item=>{ty=item.key.ty;},Request.constructor item=>{ty=item.key.ty;},Request.operation item=>{ty=item.key.ty;},Request.callable item=>{ty=item.key.ty;applied=item.key.applied;},Request.primitive item=>{ty=item.key.ty;applied=item.key.applied;},Request.host item=>{ty=item.key.ty;},_=>{return blot_support::none<u32>();},}if applied>blot_reuse_code_artifacts::max_parameters {return blot_support::none<u32>();}let nodes=self.pools().layouts.nodes;while applied!=0 {applied-=1;if ty==0 || ty>=nodes.len || nodes[ty].tag!=blot_backend_layout::Tag.function {return blot_support::none<u32>();}ty=nodes[ty].b;}if ty==0 || ty>=nodes.len || nodes[ty].tag!=blot_backend_layout::Tag.function {return blot_support::none<u32>();}return blot_support::some(ty);}
fn admit<G>(self:State&,g:G&,id:u32)->bool,Error {self.serialized_addresses.clear();let first=self.starts[id-1];let last=self.ends[id-1];if first==0xffffffffffffffff || last<=first {return false,Error.none;}var roots=blot_reuse_source_value_template::WordBuffer{..};var skipped=blot_reuse_source_value_template::WordBuffer{..};let admitted,error=admitRecords(self,g,id,first,last,roots,skipped);skipped.deinit();roots.deinit();return admitted,error;}
fn admitRecords<G>(self:State&,g:G&,id:u32,first:u64,last:u64,roots:blot_reuse_source_value_template::WordBuffer&,skipped:blot_reuse_source_value_template::WordBuffer&)->bool,Error {var cursor=self.metaAt(first);while cursor<self.old.metadata.events.len {let event=self.old.metadata.events.items[cursor];cursor+=1;if event.sequence>last {break;}match event.event {MetaEvent.enter item=>{let child=item.job;let job=self.old.metadata.jobs.items[child-1];for read in self.old.metadata.static_reads.items[job.static_reads.start..job.static_reads.start+job.static_reads.len] {let matched,error=self.matchStatic(g,read);if error!=Error.none || !matched {return false,error;}}var constant=false;match job.request {Request.constant=>{constant=true;},_=>{},}if constant && !scalarConstant(self.old,job) {let selected,error=self.aggregateConstantRequest(g,child);if error!=Error.none || !selected.present {return false,error;}let error=roots.push(selected.value.root);if error!=Error.none {return false,error;}let error=skipped.push(child);if error!=Error.none {return false,error;}cursor=self.metaAt(self.ends[child-1]+1);continue;}if constant {let selected,error=self.scalarConstantRequest(g,job);if error!=Error.none || !selected.present {return false,error;}}else {let accepted,error=self.admitJobRequest(g,child);if error!=Error.none || !accepted {return false,error;}}},_=>{},}}var skip:i64=0;cursor=self.emissionAt(first);while cursor<self.old.emission.records.len {let record=self.old.emission.records.items[cursor];if record.sequence>last {break;}while skip<skipped.items.len && self.ends[skipped.items[skip]-1]<record.sequence {skip+=1;}if skip<skipped.items.len && record.sequence>=self.starts[skipped.items[skip]-1] {cursor=self.emissionAt(self.ends[skipped.items[skip]-1]+1);continue;}let accepted,error=admitEmission(self,g,record,cursor,last,roots.items);if error!=Error.none || !accepted {return false,error;}cursor+=1;}if skipped.items.len!=0 && self.serialized_addresses.table.count!=0 {retur