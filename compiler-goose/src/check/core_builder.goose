fn Builder::addPatternRow(self:Builder&,patterns:const u32[:])->u32,Error {let range,error=self.save(patterns);if error!=Error.none {return 0,error;}let index=self.tables.pattern_rows.len as u32;self.tables.pattern_rows.push(blot_check_core::PatternRow{patterns:range, ..});return index,Error.none;}
