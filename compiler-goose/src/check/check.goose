fn Engine::qualifiedValue(self:Engine&,id:u32,name:u32)->blot_support::Option<u32>,blot_error::Error {var parts=NameParts{self.pool.get(name)};let first=parts.next();assert(first.present);if !parts.peek().present {return blot_support::none<u32>(),blot_error::Error.none;}let root,known=self.pool.lookup(first.value);if !known {return blot_support::none<u32>(),blot_error::Error.none;}var binding=self.lookup(root);if !binding.present {let global,err=self.globalBinding(root);if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}binding=global;}if !binding.present {let member=parts.next();assert(member.present);if self.editorAt(id) && !parts.peek().present && self.isNamespace(root) {let capture,err=self.captureEditor(id,0,root);return blot_support::some(capture),err;}let symbol,known=self.pool.lookup(member.value);if known {let imported,err=self.qualifiedImportBinding(Qualified{namespace:root,member:symbol});if err!=blot_error::Error.none {return blot_support::none<u32>(),err;}binding=imported;}}if !binding.present {return blot_support::none<u32>(),blot_error::Error.none;}var path=IdBuffer{};var types=IdBuffer{};let result,err=qualifiedValueParts(self,id,binding.value,parts,path,types);types.deinit(equation_type_ids);path.deinit(equation_type_ids);return result,err;}
