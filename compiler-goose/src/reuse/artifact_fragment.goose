fn localAddress(self_:const State&,address:u32,owner:u32)->bool {if address<blot_runtime_arena_runtime::metadata_bytes {return self_.arena.present;}var cursor=self_.emissionAt(self_.starts[owner-1]);while cursor<self_.old.emission.records.len {let record=self_.old.emission.records.items[cursor];cursor+=1;if record.sequence>=self_.ends[owner-1] {break;}if record.owner!=owner {continue;}match record.event {data item=>{if address>=item.address && address<item.address+item.bytes.len {return true;}},_=>{},}}return address==0;}
