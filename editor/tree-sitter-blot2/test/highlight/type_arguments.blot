//                               ^ type.parameter

type State a is effect = { get: Unit -> a, set: a -> Unit }
//         ^ type.parameter
//                         ^ variable.other.member
//                                         ^ variable.other.member

type Empty () is data = $Empty
//         ^ punctuation.bracket
//          ^ punctuation.bracket
//            ^ keyword.storage.type

type Ping [] is effect = $Unit -> U32
