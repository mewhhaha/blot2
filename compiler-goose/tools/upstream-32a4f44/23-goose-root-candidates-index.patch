     TraceEngine(CheckerEngine::Candidates, of);
     Roots out;
+    // out.Add, finding an alternative by its root through an index once
+    // there are many: every variable in scope and every global is asked.
+    unordered_map<VarDef *, size_t> byroot;
+    auto add = [&](const RootAlt &a) {
+        if (byroot.empty()) {
+            if (out.alts.size() < 16) {
+                out.Add(a);
+                return;
+            }
+            for (size_t i = 0; i < out.alts.size(); i++) byroot.emplace(out.alts[i].root, i);
+        }
+        auto [at, fresh] = byroot.try_emplace(a.root, out.alts.size());
+        if (fresh) out.alts.push_back(a);
+        else Roots::Join(out.alts[at->second], a);
+    };
