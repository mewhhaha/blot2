fn hash(value: Import) -> u64 { return ::hash_combine(::hash(value.scope),::hash(value.ty)); }
fn hash(value: RowImport) -> u64 { return ::hash_combine(::hash(value.scope),::hash(value.row)); }
fn hash(value: LabelImport) -> u64 { return ::hash_combine(::hash(value.scope),::hash(value.label)); }
fn hash(value: RowVariable) -> u64 { return ::hash_combine(::hash(value.scope),::hash(value.variable)); }
fn hash(value: RowParameter) -> u64 { return ::hash_combine(::hash(value.owner),::hash(value.parameter)); }
fn hash(value: CallKey) -> u64 { return ::hash_combine(::hash_combine(::hash_combine(::hash(value.owner),::hash(value.binding)),::hash(value.evidence)),::hash(value.caller)); }
fn hash(value: SchemeInstance) -> u64 { return ::hash_combine(::hash_combine(hash(value.target),::hash(value.public)),::hash_combine(::hash_combine(::hash(value.open),::hash(value.physical)),::hash_combine(::hash(value.generation),::hash_combine(::hash(value.deferred_member),::hash(value.constant))))); }
fn hash(value: DefinitionKey) -> u64 { return ::hash_combine(::hash(value.owner),::hash(value.node)); }
fn hash(value: CandidateKey) -> u64 { return ::hash_combine(::hash_combine(::hash(value.caller),::hash(value.node)),hash(value.target)); }
fn hash(value: NormalizationKey) -> u64 { return ::hash_combine(::hash_combine(::hash(value.root),::hash(value.types)),::hash(value.rows)); }
fn hash(value: FirstOrderKey) -> u64 { return ::hash_combine(::hash(value.root),::hash(value.depth)); }

struct RegionInvocation<C> { session: Session&,context: C&,resume: RegionSnapshot?=null,caller: blot_backend_backend_timing::RegionCaller=blot_backend_backend_timing::RegionCaller {},timing_active: bool=false,timing_started: u64=0,timing_previous: blot_backend_backend_timing::Phase=blot_backend_backend_timing::Phase.other,registered: bool=false }
fn withRegion<C,F>(session: Session&,context: C&,caller: blot_backend_backend_timing::RegionCaller=blot_backend_backend_timing::RegionCaller {}) -> Error { var invocation=RegionInvocation<C> {session:session,context:context,caller:caller}; if session.timing { let scope=session.timing.enter(blot_backend_backend_timing::Phase.inference); invocation.timing_active=true; invocation.timing_started=scope.started; invocation.timing_previous=scope.previous; } let error=blot_check_types::withStore<RegionInvocation<C>,regionOwner<C,F>>(invocation); if !invocation.registered { closeRegionTiming(session,invocation.timing_active,invocation.timing_previous); } return error; }

