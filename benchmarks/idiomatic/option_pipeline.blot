const transform = func value => return if value % 5 == 0 then $Nothing else $Some (value * 3 + 1)
entry const run = func (seed: U32) : U32 => return do:
  let total = 0
  for index in 0..16384:
    let value = transform (seed + index)
    if let $Some number = value:
      total := self + number
  break total
