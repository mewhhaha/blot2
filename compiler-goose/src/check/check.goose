 blot_check_storage_ops::Op.at,blot_check_storage_ops::Op.link,blot_check_storage_ops::Op.view=>{valid=element.present && (op!=blot_check_storage_ops::Op.link || !kind.present || kind.value.kind==blot_check_storage_types::grow);let target,err=self.knownOrFresh(element);if err!=blot_error::Error.none {return 0,err;}var target_kind=blot_check_storage_types::view;if op==blot_check_storage_ops::Op.at {target_kind=blot_check_storage_types::ref;}else if op==blot_check_storage_ops::Op.link {target_kind=blot_check_storage_types::link;}let root,err=blot_check_storage_types::make(self.types,target_kind,target);if err!=blot_error::Error.none {return 0,err;}result=root;for argument in backwards[..backwards.len-1] {let value,err=self.expression(argument);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(value,blot_check_types::u32_type,argument);if err!=blot_error::Error.none {return 0,err;}}},
 blot_check_storage_ops::Op.load,blot_check_storage_ops::Op.write=>{valid=kind.present && (kind.value.kind==blot_check_storage_types::ref || kind.value.kind==blot_check_storage_types::link);var target:u32=0;if valid {target=kind.value.element;}else {let value,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}target=value;}if op==blot_check_storage_ops::Op.load {result=target;}else {let value,err=self.expression(backwards[0]);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(value,target,backwards[0]);if err!=blot_error::Error.none {return 0,err;}}},
 blot_check_storage_ops::Op.length=>{valid=element.present;result=blot_check_types::u32_type;},
