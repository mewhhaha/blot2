fn sameUnit(self:const State&,old:u32,current:u32)->bool {return old!=0 && old<=self.importer.unit_map.len && current!=0 && self.importer.unit_map[old-1]==current;}
fn priorUnit(self:const State&,current:u32)->blot_support::Option<u32> {if current==0 {return blot_support::none<u32>();}if current<=self.importer.unit_map.len && self.importer.unit_map[current-1]==current {return blot_support::some(current);}for mapped,index in self.importer.unit_map {if mapped==current {return blot_support::some((index+1) as u32);}}return blot_support::none<u32>();}
