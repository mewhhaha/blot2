const complete = func complete => return complete
//    ^ function
//                    ^ variable.parameter
//                                       ^ variable

const checked = func computation => return do:
  for request in @requests computation:
//               ^ function.builtin
    case request of
      effect Validate.check value =>
//    ^ keyword.storage.type
        if value == 0:
          break 0
        yield value
//      ^ keyword.control.return
      complete value =>
//    ^ keyword.control
//             ^ variable.parameter
        break value

const cancelled = func computation => return do:
  for request in @requests computation:
    case request of
      effect (Reader.ask U32) () =>
        break
//      ^ keyword.control.return
      complete _ =>
        break
  break 0

complete $Some value =>
// <- keyword.control
//       ^^^^ constructor
//            ^^^^^ variable.parameter
  break value

complete $Ok ($Done value) =>
// <- keyword.control
//       ^^ constructor
//            ^^^^ constructor
  break value
