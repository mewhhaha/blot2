import std;import os;import owned_chain;import owned_wasm_compile;import owned_wasm_check;
fn module(flag:u8[:],work:u32,value:u32,consumer:u8[:],abort:bool)->u8[] {let ending=if abort {str("abort(free,#Cancelled)")} else {str("seal(free,",value,")")};return str("type Scalar[r: Region] = U32\nlet consume: (Owned[Scalar[_]], Bool) -> U32 ! {release} = fn (h, flag) => do:\n",consumer,"type ScalarPayload[r: Region] = U32\nlet main: Unit -> Result[U32,#Reserve(ReserveError) | #Body(#Cancelled)] ! {reserve,release} = fn () => do:\n  let built = owned@[ScalarPayload[_],#Cancelled](",work,") as r free in do:\n    ",ending,"\n  case built:\n    #Err(e) => return #Err(e)\n    #Ok(h) => return #Ok(consume(h,#",flag,"))\n");}
fn main(){let plain="  let value = owned.open(h) as r data in do:\n    break data\n  owned.close(h)\n  return value\n";let moved="  let m = h\n  let value = owned.open(m) as r data in do:\n    let inner = owned.open(m) as q another in do:\n      break another\n    break data\n  owned.close(m)\n  return value\n";let branch="  if flag:\n    let value = owned.open(h) as r data in do:\n      break data\n    owned.close(h)\n    return value\n  else:\n    let m = h\n    let value = owned.open(m) as q data in do:\n      break data\n    owned.close(m)\n    return value\n";
 let branch_open="  let value = owned.open(h) as r data in do:\n    if flag:\n      break data\n    else:\n      break data\n  owned.close(h)\n  return value\n";
 var count:i64=0;for consumer in [plain,moved,branch,branch_open] {for flag in ["True","False"] {for n in [0 as u32,1,3840,3841,4294962944,4294962945,4294967295] {for value in [0 as u32,1,4294967295] {for abort in [false,true] {
 let s=module(flag,n,value,consumer,abort);let r=owned_chain::run(s);let bytes=owned_wasm_compile::compile(s);assert(bytes.len>0 && owned_wasm_check::verify(s,bytes) && write_file(str("owned-matrix-",count,".wasm"),bytes));if count==0 || count==125 || count==251 {for j in bytes.len {var corrupt=copy(bytes);corrupt[j]^=1;assert(!owned_wasm_check::verify(s,corrupt));assert(!owned_wasm_check::verify(s,bytes[..j]));}}count+=1;if n<=3840 {if abort {assert(r.status==2 && r.value==0 && r.reserve_error==0);}else {assert(r.status==0 && r.value==value && r.reserve_error==0);}}else {assert(r.status==3 && r.value==0 && r.reserve_error==(if n>4294962944 {1} else {3}));}
 }}}}}
 let stale="  let m = h\n  let value = owned.open(h) as r data in do:\n    break data\n  owned.close(m)\n  return value\n";let live="  let value = owned.open(h) as r data in do:\n    owned.close(h)\n    break data\n  return value\n";for body in [stale,live] {let bad=module("True",0,7,body,false);let r=owned_chain::run(bad);assert(r.status==1 && r.value==0 && r.reserve_error==0 && owned_wasm_compile::compile(bad).len==0);}
 print("private owned wasm matrix emitted ",count);}
