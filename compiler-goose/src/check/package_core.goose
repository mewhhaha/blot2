struct CacheState {live:bool=false,generation:u64=0,completed:Completed=Completed{..},targets:Targets=Targets{..},indexed_catalogs:Catalogs=Catalogs{..},usage_facts:UsageFacts=UsageFacts{..},absent_headers:AbsentHeaders=AbsentHeaders{..},module_work:i64[:]=default<i64[:]>(),exhausted_unit:blot_support::Option<u32> =blot_support::none<u32>()}
reusable var cache_states:CacheState[>..];
reusable[] var cache_work:i64[>..];
reusable[] var cache_bindings:u32[>..];
var inactive_completed=Completed{..};var inactive_targets=Targets{..};var inactive_catalogs=Catalogs{..};var inactive_usage=UsageFacts{..};var inactive_headers=AbsentHeaders{..};var inactive_work:i64[:]=default<i64[:]>();var inactive_exhausted=blot_support::none<u32>();
struct SourceProofCache {lease:u32=0,generation:u64=0,units:ModuleCatalog=ModuleCatalog{..},work:blot_work_counters::Counters?=null,completed:Completed& =inactive_completed,targets:Targets& =inactive_targets,indexed_catalogs:Catalogs& =inactive_catalogs,usage_facts:UsageFacts& =inactive_usage,absent_headers:AbsentHeaders& =inactive_headers,module_work:i64[:]& =inactive_work,exhausted_unit:blot_support::Option<u32>& =inactive_exhausted}
fn init(units:const ModuleRef[:])->SourceProofCache,Error {return initCatalog(ModuleCatalog{references:units, ..});}
fn initModules(units:const Module[:])->SourceProofCache,Error {return initCatalog(ModuleCatalog{modules:units, ..});}
fn initCatalog(units:ModuleCatalog)->SourceProofCache,Error {if units.len()==0 {return SourceProofCache{..},blot_error::Error.invalid_artifact;}for index in 0..units.len() {let unit .= units.at(index);if unit.unit==0 {return SourceProofCache{..},blot_error::Error.invalid_artifact;}for previous in 0..index {let prior .= units.at(previous);if sameModule(prior,unit) || prior.unit==unit.unit {return SourceProofCache{..},blot_error::Error.invalid_artifact;}}}if cache_states.len>=0xffffffff {return SourceProofCache{..},blot_error::Error.out_of_memory;}let generation=blot_native::fresh_owner_id();let index=cache_states.alloc_index(CacheState{live:true,generation:generation, ..});let state .= cache_states[index];return SourceProofCache{lease:(index+1) as u32,generation:generation,units:units,completed:state.completed,targets:state.targets,indexed_catalogs:state.indexed_catalogs,usage_facts:state.usage_facts,absent_headers:state.absent_headers,module_work:state.module_work,exhausted_unit:state.exhausted_unit, ..},blot_error::Error.none;}
fn valid(self_:const SourceProofCache&)->bool {return self_.lease!=0 && self_.lease<=cache_states.len && cache_states[self_.lease-1].live && cache_states[self_.lease-1].generation==self_.generation;}
fn initWithModuleBudget(units:const ModuleRef[:],work_per_module:i64)->SourceProofCache,Error {return initCatalogBudget(ModuleCatalog{references:units, ..},work_per_module);}
fn initCatalogBudget(units:ModuleCatalog,work_per_module:i64)->SourceProofCache,Error {if work_per_module<=0 || units.len()>0x7fffffffffffffff/work_per_module {return SourceProofCache{..},blot_error::Error.invalid_artifact;}let initialized,error=initCatalog(units);if error!=blot_error::Error.none {return SourceProofCache{..},error;}var cache=initialized;cache.module_work=cache_work.alloc_slice(units.len());for &remaining in cache.module_work {remaining=work_per_module;}return cache,blot_error::Error.none;}
fn initWithInventoryBudget(units:const ModuleRef[:])->SourceProofCache,Error {return initCatalogInventory(ModuleCatalog{references:units, ..});}
fn initModulesWithInventoryBudget(units:const Module[:])->SourceProofCache,Error {return initCatalogInventory(ModuleCatalog{modules:units, ..});}
fn initCatalogInventory(units:ModuleCatalog)->SourceProofCache,Error {if units.len()>0x7fffffffffffffff/32000000 {return SourceProofCache{..},blot_error::Error.invalid_artifact;}let initialized,error=initCatalogBudget(units,1000000);if error!=blot_error::Error.none {return SourceProofCache{..},error;}var cache=initialized;for index in 0..units.len() {let unit .= units.at(index);var inventory:i64=0;for count in [unit.nodes.len,unit.extra.len,unit.types.nodes.len,unit.types.extra.len,unit.obligations.len] {if count>0x7fffffffffffffff-inventory {cache.deinit();return SourceProofCache{..},blot_error::Error.invalid_artifact;}inventory+=count;}if inventory>0x7fffffffffffffff/256 {cache.deinit();return SourceProofCache{..},blot_error::Error.invalid_artifact;}cache.module_work[index]=min(32000000,max(1000000,inventory*256));}return cache,blot_error::Error.none;}
fn moduleRemaining(self_:const SourceProofCache&,unit:u32)->blot_support::Option<i64> {if self_.module_work.len==0 {return blot_support::none<i64>();}for index in 0..self_.units.len() {if self_.units.at(index).unit==unit {return blot_support::some(self_.module_work[index]);}}return blot_support::none<i64>();}
fn exhaustedUnit(self_:const SourceProofCache&)->blot_support::Option<u32> {return self_.exhausted_unit;}
fn remainingTotal(self_:const SourceProofCache&)->blot_support::Option<i64> {if self_.module_work.len==0 {return blot_support::none<i64>();}var total:i64=0;for remaining in self_.module_work {total+=remaining;}return blot_support::some(total);}
fn moduleWork(self_:SourceProofCache&,module:const Module&)->i64? {
 if self_.module_work.len==0 {return null;}
 assert(valid(self_));
 for index in 0..self_.units.len() {
  if sameModule(self_.units.at(index),module) {
   let storage=cache_states[self_.lease-1].module_work;
   let owned=cache_work.realloc_slice(storage,storage.len);
   return owned[index];
  }
 }
 return null;
}
fn deinit(self_:SourceProofCache&) {if self_.lease==0 {return;}assert(valid(self_));for slot in self_.targets.slots {if slot.tag!=0 && slot.val.len!=0 {let first:const u32& =slot.val[0];let at=cache_bindings.index_of(first);assert(at>=0);cache_bindings.free_slice(cache_bindings[at..at+slot.val.len]);}}self_.targets.deinit();self_.indexed_catalogs.deinit();self_.usage_facts.deinit();self_.absent_headers.deinit();self_.completed.deinit();if self_.module_work.len!=0 {cache_work.free_slice(self_.module_work);}cache_states[self_.lease-1].live=false;cache_states.free(self_.lease-1);self_=SourceProofCache{..};}
fn environment(self_:const SourceProofCache&,units:ModuleCatalog)->bool {if self_.units.len()!=units.len() {return false;}for index in 0..units.len() {if !sameHeader(self_.units.at(index),units.at(index)) {return false;}}return true;}
fn owns(self_:const SourceProofCache&,module:const Module&)->bool {for index in 0..self_.units.len() {if sameHeader(self_.units.at(index),module) {return true;}}return false;}
fn contains(self_:const SourceProofCache&,module:const Module&,binding:u32)->bool {return self_.owns(module) && self_.completed.contains(blot_check_core::BindingRef{unit:module.unit,binding:binding, ..});}
fn reserve(self_:SourceProofCache&,count:i64)->Error {if count>0xffffffff {return blot_error::Error.invalid_artifact;}return self_.completed.reserve(count);}
fn publish(self_:SourceProofCache&,module:const Module&,binding:u32) {assert(self_.owns(module));self_.completed.insert(blot_check_core::BindingRef{unit:module.unit,binding:binding, ..},true);}
fn admitCompletedSource(self_:SourceProofCache&,receipt:blot_reuse_source_completion::Borrow,units:const Module[:],entry:u32,names:blot_backend_runtime_identity::View)->Error {if !self_.environment(ModuleCatalog{modules:units, ..}) {return blot_error::Error.invalid_artifact;}let count=receipt.covered(units,entry,names);var bodies:i64=0;for &unit in units[..count] {for binding,id in unit.bindings {if id!=0 && binding.kind==blot_reuse_principal_interface::Kind.global && unit.body(id as u32)!=null {bodies+=1;}}}let error=self_.reserve(bodies);if error!=blot_error::Error.none {return error;}for &unit in units[..count] {for binding,id in unit.bindings {if id!=0 && binding.kind==blot_reuse_principal_interface::Kind.global && unit.body(id as u32)!=null {self_.publish(unit,id as u32);}}}let work .= self_.work;if work {work.scoped_source_completed_bodies=min(0xffffffffffffffff-work.scoped_source_completed_bodies,bodies as u64)+work.scoped_source_completed_bodies;}return blot_error::Error.none;}
fn possibleHeader(self_:SourceProofCache&,initial:const Module&,binding:u32,wanted:blot_check_core::Obligation,depth:i64,remaining:i64&)->bool,Error {if !self_.owns(initial) {return false,blot_error::Error.invalid_artifact;}let error=headerStep(depth,remaining);if error!=blot_error::Error.none {return false,error;}let key=HeaderKey{producer:blot_check_core::BindingRef{unit:initial.unit,binding:binding, ..},kind:wanted.kind,name:wanted.name,operator:wanted.operator,identity:wanted.identity, ..};if self_.absent_headers.contains(key) {return false,blot_error::Error.none;}let possible,error=reachableHeaderMetadata(self_.units,initial,initial,binding,wanted,depth,remaining);if error!=blot_error::Error.none {return false,error;}if !possible {let error=self_.absent_headers.reserve(1);if error!=blot_error::Error.none {return false,error;}self_.absent_headers.insert(key,true);}return possible,blot_error::Error.none;}
fn containsUsage(self_:SourceProofCache&,module:const Module&,root:u32,remaining:i64&)->bool,Error {var immutable=false;for index in 0..self_.units.len() {let owner .= self_.units.at(index);if owner.unit==module.unit && blot_support::same_slice_identity(owner.types.nodes,module.types.nodes) && blot_support::same_slice_identity(owner.types.extra,module.types.extra) && blot_support::same_slice_identity(owner.nominals,module.nominals) {immutable=true;break;}}let key=FactKey{unit:module.unit,root:root, ..};if remaining==0 {return false,blot_error::Error.invalid_artifact;}remaining-=1;if immutable {let fact .= self_.usage_facts.get(key);if fact {return fact,blot_error::Error.none;}}var work=blot_check_usage_check::Work{remaining:remaining, ..};let fact,error=blot_check_usage_check::containsNominalWork(module.types,module.nominals,root,work);remaining=work.remaining;if error!=blot_error::Error.none {return false,blot_error::Error.invalid_artifact;}if immutable {let error=self_.usage_facts.reserve(1);if error!=blot_error::Error.none {return false,error;}self_.usage_facts.insert(key,fact);}return fact,blot_error::Error.none;}
fn targetBindings(self_:SourceProofCache&,module:const Module&,target:blot_check_core::BindingRef,remaining:i64&)->const u32[:],Error {var catalog:const Module?=null;for index in 0..self_.units.len() {let owner .= self_.units.at(index);if owner.unit==module.unit && blot_support::same_slice_identity(owner.bindings,module.bindings) {catalog .= owner;break;}}if !catalog {return default<const u32[:]>(),blot_error::Error.invalid_artifact;}if !self_.indexed_catalogs.contains(catalog.unit) {let error=self_.indexCatalog(catalog,remaining);if error!=blot_error::Error.none {return default<const u32[:]>(),error;}}let found .= self_.targets.get(TargetKey{unit:module.unit,target_unit:target.unit,target_binding:target.binding, ..});if found {return found,blot_error::Error.none;}return default<const u32[:]>(),blot_error::Error.none;}
type WordBuffer=blot_support_pooled_buffer::Buffer<u32>;
reusable[] var word_runs:u32[>..];
fn indexCatalog(self_:SourceProofCache&,module:const Module&,remaining:i64&)->Error {var pending:dictionary<TargetKey,WordBuffer> =dictionary<TargetKey,WordBuffer>{};var staged=Targets{..};let error=indexCatalogValues(self_,module,remaining,pending,staged);if error!=blot_error::Error.none {for slot in staged.slots {if slot.tag!=0 && slot.val.len!=0 {let first:const u32& =slot.val[0];let at=cache_bindings.index_of(first);cache_bindings.free_slice(cache_bindings[at..at+slot.val.len]);}}}for &slot in pending.slots {if slot.tag!=0 {slot.val.deinit(word_runs);}}staged.deinit();return error;}
fn indexCatalogValues(self_:SourceProofCache&,module:const Module&,remaining:i64&,pending:dictionary<TargetKey,WordBuffer>&,staged:Targets&)->Error {for binding,ordinal in module.bindings {if remaining==0 {return blot_error::Error.invalid_artifact;}remaining-=1;let id=ordinal as u32;let targets=[blot_check_core::BindingRef{binding:id, ..},blot_check_core::BindingRef{unit:module.unit,binding:id, ..},binding.target];var length:i64=2;if binding.kind==blot_reuse_principal_interface::Kind.external {length=3;}for target in targets[..length] {let key=TargetKey{unit:module.unit,target_unit:target.unit,target_binding:target.binding, ..};if !pending.contains(key) {pending.insert(key,WordBuffer{..});}let found .= pending.get(key);assert(found);let error=found.push(id,word_runs);if error!=blot_error::Error.none {return error;}}}let error=staged.reserve(pending.count);if error!=blot_error::Error.none {return error;}for slot in pending.slots {if slot.tag==0 {continue;}let values=cache_bindings.alloc_slice(slot.val.items.len);for value,index in slot.val.items {values[index]=value;}staged.insert(slot.key,values);}let error=self_.targets.reserve(staged.count);if error!=blot_error::Error.none {return error;}let error=self_.indexed_catalogs.reserve(1);if error!=blot_error::Error.none {return error;}for slot in staged.slots {if slot.tag!=0 {self_.targets.insert(slot.key,slot.val);}}self_.indexed_catalogs.insert(module.unit,true);return blot_error::Error.none;}
fn headerStep(depth:i64,remaining:i64&)->Error {if depth>=128 || remaining==0 {return blot_error::Error.invalid_artifact;}remaining-=1;return blot_error::Error.none;}
fn headerModule(units:ModuleCatalog,origin:const Module&,unit:u32)->const Module?,Error {if unit==origin.unit {return origin,blot_error::Error.none;}for index in 0..units.len() {let owner .= units.at(index);if owner.unit==unit {return owner,blot_error::Error.none;}}return null,blot_error::Error.invalid_artifact;}
type ReferenceBuffer=blot_support_pooled_buffer::Buffer<blot_check_core::BindingRef>;
reusable[] var reference_runs:blot_check_core::BindingRef[>..];
fn reachableHeaderMetadata(units:ModuleCatalog,origin:const Module&,initial:const Module&,binding:u32,wanted:blot_check_core::Obligation,depth:i64,remaining:i64&)->bool,Error {var pending=ReferenceBuffer{..};var visited=Completed{..};let result,error=reachableHeaderValues(units,origin,initial,binding,wanted,depth,remaining,pending,visited);visited.deinit();pending.deinit(reference_runs);return result,error;}
fn reachableHeaderValues(units:ModuleCatalog,origin:const Module&,initial:const Module&,binding:u32,wanted:blot_check_core::Obligation,depth:i64,remaining:i64&,pending:ReferenceBuffer&,visited:Completed&)->bool,Error {let error=pending.push(blot_check_core::BindingRef{unit:initial.unit,binding:binding, ..},reference_runs);if error!=blot_error::Error.none {return false,error;}while pending.items.len!=0 {var reference=pending.items[pending.items.len-1];pending.items=pending.items[..pending.items.len-1];let selected,error=headerModule(units,origin,reference.unit);if error!=blot_error::Error.none {return false,error;}if !selected {return false,blot_error::Error.invalid_artifact;}var owner .= selected;var forwards:i64=0;loop {let error=headerStep(depth+forwards,remaining);if error!=blot_error::Error.none {return false,error;}if reference.binding==0 || reference.binding>=owner.bindings.len {return false,blot_error::Error.invalid_artifact;}let declaration=owner.binding(reference.binding);if declaration.kind!=blot_reuse_principal_interface::Kind.external {break;}var target=declaration.target;if target.unit==0 {target.unit=owner.unit;}let selected,error=headerModule(units,origin,target.unit);if error!=blot_error::Error.none {return false,error;}if !selected {return false,blot_error::Error.invalid_artifact;}let next .= selected;if target.binding==0 || target.binding>=next.bindings.len {return false,blot_error::Error.invalid_artifact;}let imported=next.binding(target.binding);if declaration.public_variables.len!=imported.public_variables.len || declaration.public_rows.len!=imported.public_rows.len {return false,blot_error::Error.invalid_artifact;}reference=target;owner .= next;forwards+=1;}reference.unit=owner.unit;if visited.contains(reference) {continue;}let error=visited.reserve(1);if error!=blot_error::Error.none {return false,error;}visited.insert(reference,true);let declaration=owner.binding(reference.binding);if declaration.kind!=blot_reuse_principal_interface::Kind.glo