+    try std.testing.expectError(error.Limit, key(&exhausted_store, &unrelated, &.{0}, options));
+}
+
+test "selected structural distinct nodes preserve the old source-work boundary" {
+    var store = K.Store.init(a, .{});
+    defer store.deinit();
+    var work: usize = 4096;
+    var builder = K.Builder.init(&store, &work, .{});
+    defer builder.deinit();
+    var output: std.ArrayList(u32) = .empty;
+    defer output.deinit(a);
+    // The old collision-free policy charges enter and finish once per source
+    // reference: 2,800 units. A separate per-global-node debit would use 4,200.
+    for (0..1400) |index| {
+        const reference: K.Reference = .{ .unit = 1, .ty = @intCast(index + 1) };
+        try std.testing.expect((try builder.enter(reference, 0)) == null);
+        var descriptor: K.Descriptor = .empty;
+        defer descriptor.deinit(a);
+        try builder.addWords(&descriptor, &.{ 3, @intCast(index) });
+        try builder.root(&output, try builder.complete(reference, &descriptor, 0));
+    }
+    try builder.finish(&output);
+    try std.testing.expectEqual(@as(usize, 4096 - 2800), work);
+    try std.testing.expectEqual(@as(usize, 1402), output.items.len);
+}
+
+test "selected structural cold and warm queries share the same word-work boundary" {
+    const tiny = [_]Term{.{ .reference = .{ .unit = 1, .ty = 1 }, .head = &.{3} }};
+    for ([_]usize{ 6, 7 }) |allowance| {
+        // Fresh stores in each iteration keep the rejecting cold query from
+        // warming the next boundary case through its completed descriptor.
+        var cold_store = K.Store.init(a, .{});
+        defer cold_store.deinit();
+        var warm_store = K.Store.init(a, .{});
+        defer warm_store.deinit();
+        const seed = try key(&warm_store, &tiny, &.{0}, .{});
+        defer a.free(seed);
+        const options: K.Options = .{ .word_work = allowance };
+        if (allowance == 6) {
+            try std.testing.expectError(error.Limit, key(&cold_store, &tiny, &.{0}, options));
+            try std.testing.expectError(error.Limit, key(&warm_store, &tiny, &.{0}, options));
+        } else {
+            const cold = try key(&cold_store, &tiny, &.{0}, options);
+            defer a.free(cold);
+            const warm = try key(&warm_store, &tiny, &.{0}, options);
+            defer a.free(warm);
+            try std.testing.expectEqual(@as(usize, 3), cold.len);
+            try std.testing.expectEqual(@as(usize, 3), warm.len);
+        }
+    }
+}
