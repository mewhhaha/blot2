func no_action (access: own Array U32): Array U32 => return access
func stages reset -> start -> settle => return {reset, start, settle}
func start (stages: {reset: own Array U32 -> Array U32, start: own Array U32 -> Array U32, settle: own Array U32 -> Array U32}) -> (access: own Array U32): U32 => return do:
  let updated = stages.start access
  return updated[0]
func bump (access: own Array U32): Array U32 => return do:
  access[0] := self + 1
  return access
const application = stages no_action bump no_action
func with_columns (body: own Array U32 -> U32) => return body #[5, 6]
entry func top (n: U32): U32 => return start application #[n]
entry func nested (n: U32): U32 => return with_columns (func (access: own Array U32) => return start application access) + n
