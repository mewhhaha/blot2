import * as text from "std/text"
entry const run = func (seed: U32) : U32 => return do:
  let output = text.builder ()
  for index in 0..512:
    output := text.append_u32 ((seed + index * 7919) % 65536) self
    output := text.push 44 self
  let input = text.finish output
  let value = 0
  let total = 0
  for scalar in input:
    if scalar == 44:
      total := self + value
      value := 0
    else:
      value := self * 10 + scalar - 48
  break total
