fn resourceClosures(self:Engine&,parts:const u32[:],host_index:i64)->bool,blot_error::Error {for part,index in parts {if index==host_index {var candidate=part;while self.tree.node(candidate).tag==blot_parse_ast::tag_group {candidate=self.tree.node(candidate).a;}if self.tree.node(candidate).tag==blot_parse_ast::tag_name {let value,err=self.expression(part);if err!=blot_error::Error.none {return false,err;}if blot_check_cleanup_contracts::sourceHost(self,part) {continue;}}}var direct=part;while self.tree.node(direct).tag==blot_parse_ast::tag_group {direct=self.tree.node(direct).a;}if self.tree.node(direct).tag!=blot_parse_ast::tag_lambda {let err=self.diagnostic(Code.cleanup_not_safe,part);return false,err;}}return true,blot_error::Error.none;}
struct ResourceTypes {payload:u32,owner:u32,acquire:u32,release:u32}
fn resourceTypes(self:Engine&,acquire_source:u32,release_source:u32,scoped:bool)->ResourceTypes,blot_error::Error {let payload,err=self.types.fresh();if err!=blot_error::Error.none {return ResourceTypes{},err;}let owner,err=self.types.usage(payload,blot_check_types::UsageKind.unique,0);if err!=blot_error::Error.none {return ResourceTypes{},err;}let arrow,err=self.types.functionWithEffects(blot_check_types::unit,owner,self.ambient);if err!=blot_error::Error.none {return ResourceTypes{},err;}let acquire,err=self.types.usage(arrow,blot_check_types::UsageKind.once,0);if err!=blot_error::Error.none {return ResourceTypes{},err;}let value,err=self.contextualLambda(acquire_source,acquire);if err!=blot_error::Error.none {return ResourceTypes{},err;}if !blot_check_cleanup_contracts::payloadNominal(self.types,self.nominals,payload) {let err=self.diagnostic(Code.cleanup_not_safe,acquire_source);if err!=blot_error::Error.none {return ResourceTypes{},err;}}let row,err=self.types.freshEffects();if err!=blot_error::Error.none {return ResourceTypes{},err;}let arrow,err=self.types.functionWithEffects(owner,blot_check_types::unit,row);if err!=blot_error::Error.none {return ResourceTypes{},err;}let initial,err=self.types.usage(arrow,blot_check_types::UsageKind.cleanup,0);if err!=blot_error::Error.none {return ResourceTypes{},err;}var release=initial;if blot_check_cleanup_contracts::sourceHost(self,release_source) {if scoped {release=self.expr_types[release_source];}let actual=self.types.node(self.types.head(self.expr_types[release_source],0));let err=self.types.unify(self.types.node(actual.a).a,owner);if err!=blot_error::Error.none {return ResourceTypes{},err;}}else {let value,err=self.contextualLambda(release_source,release);if err!=blot_error::Error.none {return ResourceTypes{},err;}var cleanup_row:u32=0;if blot_check_cleanup_contracts::sourceForeign(self,release_source) {let row,err=self.types.effects.row([blot_check_types::foreign_operation],blot_check_effects::Tail.closed);if err!=blot_error::Error.none {return ResourceTypes{},blot_check_types::effectError(err);}cleanup_row=row;}let actual=self.types.node(self.types.node(self.types.head(self.expr_types[release_source],0)).a);let err=self.constrainEffects(actual.c,cleanup_row,release_source);if err!=blot_error::Error.none {return ResourceTypes{},err;}let arrow,err=self.types.functionWithEffects(owner,blot_check_types::unit,cleanup_row);if err!=blot_error::Error.none {return ResourceTypes{},err;}let normalized,err=self.types.usage(arrow,blot_check_types::UsageKind.cleanup,0);if err!=blot_error::Error.none {return ResourceTypes{},err;}release=normalized;self.expr_types[release_source]=release;}var safe=false;if scoped {safe=blot_check_cleanup_contracts::source(self,release_source);}else {safe=blot_check_cleanup_contracts::sourceTransferred(self,release_source);}if !safe {let err=self.diagnostic(Code.cleanup_not_safe,release_source);if err!=blot_error::Error.none {return ResourceTypes{},err;}}return ResourceTypes{payload,owner,acquire,release},blot_error::Error.none;}
fn resourceLoan(self:Engine&,source:u32,parts:const u32[:],resource:ResourceTypes)->u32,blot_error::Error {let old=self.rankBoundary();let scope,err=self.types.rigidScope();if err!=blot_error::Error.none {return 0,err;}let region,err=self.types.rigid(scope,0,2);if err!=blot_error::Error.none {return 0,err;}let loan,err=self.types.usage(resource.payload,blot_check_types::UsageKind.borrow_mut,region);if err!=blot_error::Error.none {return 0,err;}let result,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}let arrow,err=self.types.functionWithEffects(loan,result,self.ambient);if err!=blot_error::Error.none {return 0,err;}let callback,err=self.types.usage(arrow,blot_check_types::UsageKind.once,0);if err!=blot_error::Error.none {return 0,err;}var callback_source=parts[0];while self.tree.node(callback_source).tag==blot_parse_ast::tag_group {callback_source=self.tree.node(callback_source).a;}if self.tree.node(callback_source).tag!=blot_parse_ast::tag_lambda {let err=self.diagnostic(Code.multiplicity_unknown,parts[0]);return result,err;}let value,err=self.contextualLambda(parts[0],callback);if err!=blot_error::Error.none {return 0,err;}let issues=self.diagnostics.len;let err=self.validateRankScope(scope,old.variables,old.versions,old.rows,old.row_versions,source);if err!=blot_error::Error.none {return 0,err;}for &issue in self.diagnostics[issues..] {if issue.code==Code.skolem_escape {issue.code=Code.borrow_escape;}}let inherited,err=freeVariableRun(self.types,resource.payload);if err!=blot_error::Error.none {return 0,err;}let footprint,error=loanFootprint(self,self.tree.node(callback_source).b,result,region,inherited);equation_type_ids.free_slice(inherited);if error!=blot_error::Error.none {return 0,error;}if footprint {let err=self.diagnostic(Code.borrow_escape,parts[0]);if err!=blot_error::Error.none {return 0,err;}}self.usage_loans.append(UsageLoan{source:source,callback:parts[0],parameter:self.tree.node(callback_source).a,region:region,mutable:true,acquire:parts[2],release:parts[1]});self.expr_types[parts[2]]=resource.acquire;self.expr_types[parts[1]]=resource.release;self.expr_types[parts[0]]=callback;return result,blot_error::Error.none;}
