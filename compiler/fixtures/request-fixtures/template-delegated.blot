type Tick is effect = { read: Unit -> U32 }
const build = func action => return do:
  let wrapped = func () => return action ()
  let value = @computation wrapped
  break value
const make = func action => return build action
const handled = func computation => return do:
  for request in @requests computation:
    case request of
      effect Tick.read () =>
        break 42.5
      complete value =>
        break value
entry const answer = func () => return do:
  let computation = make (func () => return do:
    use Tick.read ()
    break @panic "cancelled generic computation continued"
  )
  break handled computation
entry const folded = answer ()
