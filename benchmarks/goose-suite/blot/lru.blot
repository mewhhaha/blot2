// LRU cache: open-addressed hash map with backward-shift deletion + doubly-linked
// recency list in a single 16-byte/node arena with an explicit freelist.
import * as rng from "./rng"

const BENCH_N: U32 = 8000000 // BENCH_N
const NONE: U32 = 0xFFFFFFFF

type Slot is data = $Slot { key: U32, node: U32 }
type Node is data = $Node { key: U32, val: U32, prev: U32, next: U32 }

func next_pow2 (v: U32): U32 =>
  let p: U32 = 16
  for ever:
    if p >= v:
      break
    p := self << 1
  return p

func home (key: U32) -> (mask: U32): U32 =>
  return ((key * 0x9E3779B1) ^ (key >> 16)) & mask

func find_slot (slots: #[Slot]) -> (mask: U32) -> (key: U32): U32 =>
  let i = home key mask
  for ever:
    let $Slot { key: sk, node: sn } = slots[i]
    if sn == NONE or sk == key:
      break
    i := (self + 1) & mask
  return i

func map_remove (slots: own #[Slot]) -> (mask: U32) -> (at: U32): #[Slot] =>
  let i = at
  let j = i
  for ever:
    j := (self + 1) & mask
    let s = slots[j]
    if s.node == NONE:
      break
    let h = home s.key mask
    if (i < j and (h <= i or h > j)) or (i > j and h <= i and h > j):
      slots[i] := s
      i := j
  slots[i] := $Slot { key: 0, node: NONE }
  return slots

io bench (): #[U32] =>
  let cap = BENCH_N / 8
  let keys = cap * 2
  let nslots = next_pow2 (cap * 2)
  let mask = nslots - 1
  let slots = @array.fill nslots ($Slot { key: 0, node: NONE })

  // Sentinel head (0) and tail (1) in a single 16-byte/node arena.
  let nodes = @array.fill (cap + 2) ($Node { key: NONE, val: 0, prev: NONE, next: NONE })
  let pool_used: U32 = 2
  nodes[0].next := 1
  nodes[1].prev := 0

  let free_stack = @array.fill cap 0
  let free_len: U32 = 0

  let count: U32 = 0
  let hits: U32 = 0
  let misses: U32 = 0
  let removes: U32 = 0
  let r: U64 = 12345u64
  let keys64 = keys.to_u64

  for _ in 0 .. BENCH_N:
    r := rng.xs_next self
    let a = (r % keys64).to_u32
    let wide = a.to_u64
    let key = ((wide * wide) / keys64).to_u32
    let at = find_slot slots mask key
    let f = slots[at].node
    let hi = (r >> 32).to_u32
    if ((hi >> 8) & 15) == 0:
      if f != NONE:
        let p = nodes[f].prev
        let q = nodes[f].next
        nodes[p].next := q
        nodes[q].prev := p
        slots := map_remove self mask at
        free_stack[free_len] := f
        free_len := self + 1
        count := self - 1
        removes := self + 1
    else:
      if f != NONE:
        let nd = nodes[f]
        let p = nd.prev
        let q = nd.next
        nodes[p].next := q
        nodes[q].prev := p
        let fq = nodes[0].next
        nodes[f] := $Node { key: nd.key, val: nd.val + 1, prev: 0, next: fq }
        nodes[fq].prev := f
        nodes[0].next := f
        hits := self + 1
      else:
        misses := self + 1
        let ins = at
        if count == cap:
          let lru = nodes[1].prev
          let lnd = nodes[lru]
          nodes[lnd.prev].next := lnd.next
          nodes[lnd.next].prev := lnd.prev
          let lat = find_slot slots mask lnd.key
          slots := map_remove self mask lat
          free_stack[free_len] := lru
          free_len := self + 1
          count := self - 1
          ins := find_slot slots mask key
        let ni: U32 = 0
        if free_len > 0:
          free_len := self - 1
          ni := free_stack[free_len]
        else:
          ni := pool_used
          pool_used := self + 1
        let fq = nodes[0].next
        nodes[ni] := $Node { key, val: key % 1000, prev: 0, next: fq }
        slots[ins] := $Slot { key, node: ni }
        nodes[fq].prev := ni
        nodes[0].next := ni
        count := self + 1

  let walk: U64 = 0
  let vals: I64 = 0
  let cur = nodes[0].next
  for ever:
    if cur == NONE or cur == 1:
      break
    let nd = nodes[cur]
    walk := self * 31 + nd.key.to_u64
    vals := self + nd.val.to_i64
    cur := nd.next

  let out: #[U32] = #[]
  out := rng.emit_u32 self hits
  out := rng.emit_u32 self misses
  out := rng.emit_u32 self removes
  out := rng.emit_u32 self count
  out := rng.emit_u64 self walk
  out := rng.emit_i64 self vals
  return out
