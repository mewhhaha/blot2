struct InstanceDecision { statement: u32,count: i64 = 0,layouts: u32[4],facts: FactRange[4] = [FactRange {..};4],rows: FactRange[4] = [FactRange {..};4],reads: InstanceReads }
struct InstanceDecisions { decisions: DecisionBuffer,facts: MappingBuffer,rows: RowBuffer }
fn deinit(decisions: InstanceDecisions&) { decisions.facts.deinit(); decisions.rows.deinit(); decisions.decisions.deinit(); }
fn find(decisions: const InstanceDecisions&,statement: u32) -> const InstanceDecision&? { for &decision in decisions.decisions.items { if decision.statement == statement { return decision; } } return null; }
fn factsAt(decisions: const InstanceDecisions&,decision: const InstanceDecision&,index: i64) -> const Mapping[:] { let range = decision.facts[index]; return decisions.facts.items[range.start..range.start + range.len]; }
fn rowsAt(decisions: const InstanceDecisions&,decision: const InstanceDecision&,index: i64) -> const RowMapping[:] { let range = decision.rows[index]; return decisions.rows.items[range.start..range.start + range.len]; }
fn reader(decisions: const InstanceDecisions&,node: u32) -> const InstanceDecision&? { for &decision in decisions.decisions.items { for read in decision.reads.nodes[..decision.reads.len] { if read == node { return decision; } } } return null; }
struct InstanceRead {offset:i64=0,len:i64=0,facts:blot_backend_substitution_buffers::MappingsRead=blot_backend_substitution_buffers::MappingsRead{},rows:blot_backend_substitution_buffers::RowsRead=blot_backend_substitution_buffers::RowsRead{}}
fn valid(key:InstanceRead)->bool {if key.len==0 {return key.offset==0 && key.facts.lease==0 && key.rows.lease==0;}return key.facts.lease!=0 && blot_backend_substitution_buffers::valid(key.facts) && blot_backend_substitution_buffers::valid(key.rows) && key.offset>=0 && key.len>0 && key.offset<=buffer_DecisionBuffer.len && key.len<=buffer_DecisionBuffer.len-key.offset;}
fn snapshotInstances(decisions:InstanceDecisions&)->InstanceRead,Error {if decisions.decisions.items.len==0 {return InstanceRead{},blot_error::Error.none;}let error=blot_backend_substitution_buffers::prepare(decisions.facts);if error!=blot_error::Error.none {return InstanceRead{},error;}let owned=buffer_DecisionBuffer.realloc_slice(decisions.decisions.storage,decisions.decisions.storage.len);assert(blot_support::same_slice_identity(owned,decisions.decisions.storage) && blot_support::same_slice_identity(decisions.decisions.items,owned[..decisions.decisions.items.len]));let start=buffer_DecisionBuffer.index_of(owned[0]);assert(start>=0 && decisions.decisions.storage.len<=buffer_DecisionBuffer.len-start);return InstanceRead{offset:start,len:decisions.decisions.items.len,facts:blot_backend_substitution_buffers::readKey(decisions.facts),rows:blot_backend_substitution_buffers::readKey(decisions.rows)},blot_error::Error.none;}
fn find(decisions:const InstanceRead&,statement:u32)->const InstanceDecision&? {assert(valid(decisions));for &decision in buffer_DecisionBuffer[decisions.offset..decisions.offset+decisions.len] {if decision.statement==statement {return decision;}}return null;}
fn factsAt(decisions:const InstanceRead&,decision:const InstanceDecision&,index:i64)->const Mapping[:] {assert(valid(decisions));let range=decision.facts[index];assert(range.start>=0 && range.len>=0 && range.start<=decisions.facts.len && range.len<=decisions.facts.len-range.start);var key=decisions.facts;key.offset+=range.start;key.len=range.len;return blot_backend_substitution_buffers::read(key);}
fn rowsAt(decisions:const InstanceRead&,decision:const InstanceDecision&,index:i64)->const RowMapping[:] {assert(valid(decisions));let range=decision.rows[index];assert(range.start>=0 && range.len>=0 && range.start<=decisions.rows.len && range.len<=decisions.rows.len-range.start);var key=decisions.rows;key.offset+=range.start;key.len=range.len;return blot_backend_substitution_buffers::read(key);}
