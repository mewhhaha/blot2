        var alternative_budget: i64 = 65536;for index in 0..states.len {let state: State& = states[index];if state.consumers == 2 && state.last_read < min(state.first_consume,state.consume) && exclusiveConsumers(module,state.first_consume,state.consume,alternative_budget) {state.consumers = 1;}state.owned = (state.origin || state.transfer) && !state.escaped && state.consumers == 1 && state.last_read < state.consume;state.anchored = state.origin;}
