            if value.tag==Tag.record {if value.c>self.module.extra.len || value.b>self.module.extra.len-value.c {return false,Error.invalid_artifact;}for destination,index in self.module.extra[value.c..value.c+value.b] {if destination>=container.b {return false,Error.invalid_artifact;}if destination!=variant.field {continue;}if argument!=0 {return false,Error.invalid_artifact;}argument=self.module.extra[value.a+index];}}else {argument=self.module.extra[value.a+variant.field];}
            if argument==0 || value.ty>=self.module.types.nodes.len {return false,Error.invalid_artifact;}let raw_container=self.module.types.node(value.ty);if raw_container.tag!=container.tag || raw_container.b!=container.b {return false,Error.invalid_artifact;}var raw_field:u32=0;if raw_container.tag==TypeTag.record {let field=self.module.types.recordField(raw_container,variant.field);if field.name!=self.module.types.recordField(container,variant.field).name {return false,Error.invalid_artifact;}raw_field=field.ty;}else {raw_field=self.module.types.list(blot_check_types::List{raw_container.a,raw_container.b, ..})[variant.field];}let valid,err=self.valueOrigins(argument,raw_field,values,depth+1);if err!=Error.none || !valid {return valid,err;}
        }return true,Error.none;
    }
    if node.tag!=Tag.record && node.tag!=Tag.product && node.tag!=Tag.closure && node.tag!=Tag.call && node.tag!=Tag.apply {return false,Error.none;}let err=values.add(id);return true,err;
}
fn callbackCreators(self:const Scan&,id:u32,expected:u32,creators:Creators&,depth:i64)->bool,Error {
