grammar Squid

// Precedence and name resolution belong to the semantic checker, not the parser.
token IDENT = /[a-z_][a-z0-9_]*/ ;
token TYPE_IDENT = /[A-Z][A-Za-z0-9_]*/ ;
token INTEGER = /(0[xX][0-9A-Fa-f](_?[0-9A-Fa-f])*|[0-9](_?[0-9])*)(_?(u8|u32|i32|u64|i64))?/ ;
token FLOAT = /[0-9](_?[0-9])*((\.[0-9](_?[0-9])*([eE][+-]?[0-9](_?[0-9])*)?|[eE][+-]?[0-9](_?[0-9])*)(_?(f32|f64))?|_?(f32|f64))/ ;
token CHAR = /'([^'\\\r\n]|\\(['"\\nrt0]|x[0-9A-Fa-f]{2}))'/ ;
token BYTE_STRING = /b"([^"\\\r\n]|\\(["\\nrt0]|x[0-9A-Fa-f]{2}))*"/ ;
token STRING = /"([^"\\\r\n]|\\["\\nrt])*"/ ;
token INTRINSIC priority 3 = /@[a-z_][a-z0-9_]*(\.([a-z_][a-z0-9_]*|[A-Z][A-Za-z0-9_]*))*/ ;
token PROOF_TYPE priority 4 = /@proof\.(U32Eq|U32Lt|U32Le|U32AddFits|U32SubFits|Index)/ ;
token PROOF_LENGTH priority 4 = /@(array|list)\.length/ ;
token SYMBOL = /([+*$%=!<>^&|?~-]+(\/[+*$%=!<>^&|?~-]*)?|\/[+*$%=!<>^&|?~-]*)/ ;
token LAYOUT_NEWLINE = // ;
token LAYOUT_INDENT = // ;
token LAYOUT_DEDENT = // ;
skip WHITESPACE = /[ \t\r\n]+/ ;
skip COMMENT priority 3 = /\/\/[^\r\n]*/ ;

program = (imports:(import_declaration | export_declaration)* (declarations:declaration declarations:(declaration | export_declaration)*)?) ;
import_declaration = ("import" binding:(namespace_import | named_import) "froM" path:STRING LAYOUT_NEWLINE) ;
export_declaration = ("exporT" binding:named_import "froM" path:STRING LAYOUT_NEWLINE) ;
namespace_import = ("*" "as" name:source_identifier) ;
named_import = ("{" (bindings:import_binding ("," bindings:import_binding)* ","?)? "}") ;
import_binding = (name:(source_identifier | TYPE_IDENT | operator_name) alias:("as" (source_identifier | TYPE_IDENT | operator_name))?) ;
declaration = (visibility:"privatE" attributes:declaration_attribute* value:private_declaration_value LAYOUT_NEWLINE | attributes:declaration_attribute* value:public_declaration_value LAYOUT_NEWLINE) ;
private_declaration_value = (value_declaration | named_function_declaration | implementation_declaration | data_type | opaque_type | type_alias | contract_type | effect_declaration | effect_type) ;
public_declaration_value = (value_declaration | named_function_declaration | test_declaration | entry_concurrency_declaration | implementation_declaration | data_type | opaque_type | type_alias | contract_type | effect_declaration | effect_type) ;
test_declaration = ("tesT" trap:"expect_trap"? name:STRING (":" body:suite | "=>" ("return" body:expression | body:suite | body:expression))) ;
entry_concurrency_declaration = (entry_kernel_declaration | entry_process_declaration) ;
entry_kernel_declaration = ("#" "kernel" (value:named_function | "const" name:source_identifier ":" annotation:type_expression "=" body:kernel_body)) ;
kernel_body = ("{" LAYOUT_NEWLINE? ("prepare" ":" prepare:callable_path "," LAYOUT_NEWLINE? "run" ":" run:callable_path | "run" ":" run:callable_path "," LAYOUT_NEWLINE? "prepare" ":" prepare:callable_path) ","? LAYOUT_NEWLINE? "}") ;
entry_process_declaration = ("#" "process" "const" name:source_identifier ":" annotation:type_expression "=" body:process_body) ;
process_body = ("{" LAYOUT_NEWLINE? ("init" ":" init:callable_path "," LAYOUT_NEWLINE? "step" ":" step:callable_path | "step" ":" step:callable_path "," LAYOUT_NEWLINE? "init" ":" init:callable_path) ","? LAYOUT_NEWLINE? "}") ;
callable_path = (root:source_identifier ("." (TYPE_IDENT ".")* name:source_identifier)? | types:(TYPE_IDENT ".")+ name:source_identifier) ;
// The source adapter marks `opaque` only directly after `is`.
opaque_type = ("type" name:TYPE_IDENT parameters:type_atom* ("=>" "type" parameters:type_atom)* "is" "opaquE" "=" value:type_expression) ;
type_alias = ("type" name:TYPE_IDENT parameters:type_atom* ("=>" "type" parameters:type_atom)* "=" value:type_expression) ;
contract_type = ("type" name:TYPE_IDENT parameters:type_atom* ("=>" "type" parameters:type_atom)* "is" kind:source_identifier "=" body:contract_body) ;
implementation_declaration = (marker:"impL" name:TYPE_IDENT parameters:type_atom* ("=>" "type" parameters:type_atom)* ":" head:constraint_predicate where:where_clause? "=" body:implementation_body) ;
implementation_body = ("{" LAYOUT_NEWLINE? (members:implementation_member ("," LAYOUT_NEWLINE? members:implementation_member)* ","?)? LAYOUT_NEWLINE? "}") ;
implementation_member = (implementation_type_member | implementation_value_member) ;
implementation_type_member = ("type" name:TYPE_IDENT "=" value:type_expression) ;
implementation_value_member = ("const" name:(source_identifier | TYPE_IDENT) annotation:(":" type_expression)? "=" value:lambda) ;
declaration_attribute = ("@" body:attribute_name LAYOUT_NEWLINE?) ;
attribute_name = ("[" value:expression "]") ;
io_modifier = ("iO") ;
value_declaration = (modifier:io_modifier? kind:("const" | "let") name:(operator_name | qualified_name) annotation:(":" type_expression)? where:where_clause? "=" value:expression) ;
named_function_declaration = (value:named_function | value:io_function) ;
named_function = ("func" name:function_name parameter:parameter ("->" parameter:parameter)* result:(":" type_expression)? where:where_clause? "=>" ("return" body:expression | body:suite | body:rebinding | body:effect_step | body:expression)) ;
io_function = (modifier:io_modifier name:function_name parameter:parameter ("->" parameter:parameter)* result:(":" type_expression)? where:where_clause? "=>" ("return" body:expression | body:suite | body:rebinding | body:effect_step | body:expression)) ;
function_name = (operator_name | root:source_identifier rest:("." (source_identifier | TYPE_IDENT))* | root:TYPE_IDENT rest:("." (source_identifier | TYPE_IDENT))+) ;
effect_declaration = ("effect" name:qualified_name ":" signature:type_expression) ;
effect_type = ("type" name:TYPE_IDENT parameters:type_atom* ("=>" "type" parameters:type_atom)* "is" "effect" "=" (operations:effect_operations | signature:effect_signature)) ;
// A bare record declares operations; signatures start with a type name or group.
effect_signature = (head:effect_signature_application results:("->" type_application)* effects:effect_row?) ;
effect_signature_application = (head:effect_signature_atom arguments:type_atom*) ;
effect_signature_atom = (qualified_name | type_group) ;
effect_operations = ("{" LAYOUT_NEWLINE? (fields:effect_operation (("," LAYOUT_NEWLINE? | LAYOUT_NEWLINE) fields:effect_operation)* ("," LAYOUT_NEWLINE? | LAYOUT_NEWLINE)?)? "}") ;
effect_operation = (name:source_identifier ":" signature:type_expression) ;
data_type = (("data" name:TYPE_IDENT parameters:type_atom* ("=>" "type" parameters:type_atom)* "=" | "type" name:TYPE_IDENT parameters:type_atom* ("=>" "type" parameters:type_atom)* "is" "data" "=") LAYOUT_NEWLINE? "|"? constructors:constructor ("|" LAYOUT_NEWLINE? constructors:constructor)*) ;
constructor = (attributes:declaration_attribute* "#" name:TYPE_IDENT payload:type_expression?) ;
operator_symbol = (SYMBOL | "+" | "~" | "&" | "*" | "^" | "|") ;
operator_name = ("(" symbol:operator_symbol ")") ;
qualified_name = (root:(source_identifier | TYPE_IDENT) rest:("." (source_identifier | TYPE_IDENT))*) ;
parameter = (name:source_identifier | "(" (typed:typed_parameter | pattern:pattern)? ")") ;
typed_parameter = (name:source_identifier ":" annotation:type_expression where:where_clause?) ;
type_array = ("[" (elements:type_expression ("," elements:type_expression)* ","?)? "]") ;
type_symbol_array = ("#" "[" modifier:("+" | "~")? first:(INTEGER | type_expression) (";" second:type_expression)? "]") ;
type_record = ("{" LAYOUT_NEWLINE? (fields:type_field (("," LAYOUT_NEWLINE? | LAYOUT_NEWLINE) fields:type_field)* ("," LAYOUT_NEWLINE? | LAYOUT_NEWLINE)?)? "}") ;
type_field = (attributes:declaration_attribute* name:source_identifier (":" value:type_expression ("=" default:expression)?)?) ;
type_expression = (head:type_application results:("->" type_application)* effects:effect_row?) ;
effect_row = ("!" "{" (labels:type_application ("," labels:type_application)*)? ("|" tail:source_identifier)? "}") ;
// The frontend promotes `where` to this same-width private marker only after
// an annotation or function header. Other uses remain ordinary source_identifier.
where_clause = (marker:"wherE" body:constraint_body) ;
contract_body = ("{" LAYOUT_NEWLINE? (members:contract_member (("," LAYOUT_NEWLINE? | LAYOUT_NEWLINE) members:contract_member)* ("," LAYOUT_NEWLINE? | LAYOUT_NEWLINE)?)? "}") ;
contract_member = (contract_type_member | contract_value_member | contract_trait_or_predicate) ;
contract_type_member = ("type" name:TYPE_IDENT value:("=" type_expression)?) ;
contract_value_member = ("const" name:(source_identifier | TYPE_IDENT) ":" signature:type_expression) ;
contract_trait_or_predicate = (kind:qualified_name (":" signature:type_expression | member:STRING? arguments:type_atom* effects:effect_row?)) ;
constraint_body = ("{" LAYOUT_NEWLINE? (predicates:constraint_predicate ("," LAYOUT_NEWLINE? predicates:constraint_predicate)* ","?)? LAYOUT_NEWLINE? "}") ;
// Predicate names are contextual. `result "member" Input Output ! {row}` uses
// this common form; checking validates its two arguments and optional row.
constraint_predicate = (kind:qualified_name member:STRING? arguments:type_atom* effects:effect_row?) ;
type_application = (head:type_atom arguments:type_atom*) ;
type_atom = (storage_type | type_symbol_array | code_type | descriptor_type | quantified_type | usage_type | qualified_name | type_binder | type_group | type_array | type_record | proof_type) ;
storage_type = (operator:("&" | "^" | "*") value:type_atom) ;
code_type = ("code" "[" result:type_expression "," "row" effects:code_row "]") ;
code_row = ("{" (labels:type_application ("," labels:type_application)*)? ("|" tail:source_identifier)? "}" | tail:source_identifier) ;
descriptor_type = ("descriptor" value:type_atom) ;
proof_type = (name:PROOF_TYPE left:proof_operand right:proof_operand) ;
proof_operand = (source_identifier | INTEGER | proof_length | proof_group) ;
proof_length = (name:PROOF_LENGTH value:proof_operand) ;
proof_group = ("(" value:proof_operand ")") ;
usage_type = (kind:("own" | "unique" | "shared" | "once" | "many" | "cleanup" | "concurrent") value:type_atom | kind:("borrow" | "borrow_mut") region:source_identifier value:type_atom) ;
type_binder = ("(" name:source_identifier ":" annotation:type_expression ")") ;
type_group = ("(" (value:type_expression ("," value:type_expression)* ","?)? ")") ;

expression = (value:(package_pack | package_unpack | lambda | do_block | case_expression | if_expression | fork_statement | comptime_for | comptime_if | receive | infix_expression)) ;
lambda = ("func" parameter:parameter ("->" parameter:parameter)* result:(":" type_expression)? "=>" ("return" body:expression | body:suite | body:rebinding | body:effect_step | body:expression)) ;
infix_expression = (head:prefix_expression tails:infix_tail*) ;
// Standalone $, *, and ^ are also reserved by forwarding, imports, and patterns.
infix_tail = (operator:(SYMBOL | "+" | "~" | "&" | "$" | "*" | "^" | "|" | "and" | "or") argument:(lambda | do_block | case_expression | if_expression | prefix_expression)) ;
prefix_expression = (operator:(SYMBOL | "+" | "~" | "&" | "*" | "^")? value:application) ;
application = (head:atom arguments:(atom | comptime_access | member_access | slice_access)*) ;
comptime_access = ("·" "(" (name:source_identifier | operator:operator_symbol) ")") ;
member_access = ("." name:(source_identifier | TYPE_IDENT)) ;
atom = (boolean | FLOAT | INTEGER | CHAR | BYTE_STRING | STRING | INTRINSIC | PROOF_LENGTH | static_run | static_do | spark_expression | selector | type_witness | constructor_reference | qualified_name | operator_name | group | comprehension | collection_spread | collection_cons | list | array | record_values) ;
spark_expression = ("spark" "#" "[" body:collection_expression "|" pattern:pattern "<-" source:expression (".." end:expression)? "]") ;
static_run = ("#" "run" value:expression) ;
static_do = ("#" value:do_block) ;
receive = ("|" value:(qualified_name | group) "|") ;
boolean = ("true" | "false") ;
constructor_reference = ("#" value:(record | qualified_name)) ;
selector = ("·" name:(source_identifier | TYPE_IDENT) ("." name:(source_identifier | TYPE_IDENT))*) ;
type_witness = (":" value:atom) ;
if_expression = ("if" condition:infix_expression "then" consequence:expression "else" alternative:expression) ;
record = (name:qualified_name fields:record_values) ;
record_values = ("{" LAYOUT_NEWLINE? (fields:record_value ("," LAYOUT_NEWLINE? fields:record_value)* ","?)? LAYOUT_NEWLINE? "}") ;
record_value = (name:source_identifier (":" value:expression)?) ;
group = ("(" (value:expression ("," value:expression)* ","?)? ")") ;
list = ("[" (elements:collection_expression ("," elements:collection_expression)* ","?)? "]") ;
array = ("#" "[" (elements:collection_expression ("," elements:collection_expression)* ","?)? "]") ;
collection_open = ("#"? "[") ;
collection_spread = (opening:collection_open (prefix:collection_expression ",")* "..." tail:collection_expression ("," suffix:collection_expression)* ","? "]") ;
collection_cons = (opening:collection_open elements:collection_expression ("," elements:collection_expression)* "|" tail:expression "]") ;
comprehension = (opening:collection_open body:collection_expression "|" first:generator ("," rest:comprehension_qualifier)* "]") ;
comprehension_qualifier = (generator | comprehension_binding | comprehension_guard) ;
generator = (name:source_identifier "<-" value:expression) ;
comprehension_binding = ("let" name:source_identifier "=" value:expression) ;
comprehension_guard = (value:expression) ;
do_block = ("do" resolver:application? ":" body:suite) ;
case_expression = ("case" values:expression ("," values:expression)* "of" body:case_suite) ;
case_suite = (LAYOUT_NEWLINE LAYOUT_INDENT arms:case_arm* LAYOUT_DEDENT) ;
case_arm = (alternatives:pattern_row ("|" alternatives:pattern_row)* ("if" guard:expression)? "=>" (body:suite | body:expression) LAYOUT_NEWLINE) ;
pattern_row = (patterns:pattern ("," patterns:pattern)*) ;
pattern = (source_identifier | operator_name | INTEGER | CHAR | constructor_pattern | pattern_group | record_pattern | value_pattern | boolean_pattern) ;
boolean_pattern = (value:("true" | "false")) ;
value_pattern = ("^" name:qualified_name) ;
constructor_pattern = ("#" name:(TYPE_IDENT | qualified_constructor) (fields:record_pattern | payload:constructor_payload)?) ;
// Braces after a constructor always name its fields, never a record payload.
constructor_payload = (source_identifier | INTEGER | CHAR | constructor_pattern | pattern_group | value_pattern | boolean_pattern) ;
qualified_constructor = (((source_identifier | TYPE_IDENT) ".")+ TYPE_IDENT) ;
pattern_group = ("(" (value:pattern ("," value:pattern)* ","?)? ")") ;
record_pattern = ("{" (fields:record_pattern_field ("," fields:record_pattern_field)* ","?)? "}") ;
record_pattern_field = (name:source_identifier (":" value:pattern)?) ;
suite = (LAYOUT_NEWLINE LAYOUT_INDENT statements:statement* LAYOUT_DEDENT) ;
statement = (value:(named_function | binding | rebinding | effect_binding | effect_step | function_exit | result | reply | loop_exit | loop_continue | handler_statement | request_case | pattern_conditional | conditional | ever_statement | range_statement | for_statement | expression) LAYOUT_NEWLINE) ;
fork_statement = ("fork" targets:source_identifier ("," targets:source_identifier)* ":" body:suite) ;
handler_statement = ("handleR" name:source_identifier ":" effect:type_application "=>" body:(handler_suite | handler_inline_body)) ;
handler_suite = (LAYOUT_NEWLINE LAYOUT_INDENT (arms:handler_named_arm_line+ | arm:handler_callable_arm LAYOUT_NEWLINE | lambda:lambda LAYOUT_NEWLINE) LAYOUT_DEDENT) ;
handler_inline_body = (record_values | lambda | handler_callable_arm | handler_named_arm) ;
handler_named_arm_line = (arm:handler_named_arm ","? LAYOUT_NEWLINE) ;
handler_named_arm = (name:source_identifier parameter:parameter ("->" parameter:parameter)* result:(":" type_expression)? "=>" ("return" body:expression | body:suite | body:rebinding | body:effect_step | body:expression)) ;
handler_callable_arm = (parameter:parameter ("->" parameter:parameter)* result:(":" type_expression)? "=>" ("return" body:expression | body:suite | body:rebinding | body:effect_step | body:expression)) ;
comptime_for = ("#" "for" name:source_identifier "in" "#" kind:("fields" | "variants") target:type_atom ":" body:suite) ;
comptime_if = ("#" "if" condition:expression ":" consequence:suite fallback:comptime_else?) ;
comptime_else = (LAYOUT_NEWLINE? "#" "else" ":" alternative:suite) ;
binding = ("let" pattern:pattern annotation:(":" type_expression)? where:where_clause? "=" value:expression fallback:binding_else?) ;
rebinding = (name:source_identifier path:(member_access | comptime_access | index_access)* ":=" value:expression) ;
index_access = ("[" index:expression "]") ;
slice_access = ("[" start:expression ".." end:expression "]") ;
for_statement = ("for" "let"? pattern:pattern "in" start:expression (".." end:expression)? ":" body:suite) ;
range_statement = ("for" start:expression ".." end:expression ":" body:suite) ;
ever_statement = ("for" "ever" ":" body:suite) ;
binding_else = ("else" ":" alternative:suite) ;
// Separate islands avoid Baba's equal-length source_identifier/expression transition tie.
effect_binding = ("use" name:source_identifier annotation:(":" type_expression)? "<-" value:expression) ;
effect_step = ("use" value:expression) ;
function_exit = ("return" ("use" effect:expression | value:expression)) ;
result = ("break" forwarding:"$"? value:expression) ;
reply = ("yield" value:expression) ;
loop_exit = ("break") ;
loop_continue = ("continue") ;
request_case = ("case" request:source_identifier "of" body:request_case_suite) ;
request_case_suite = (LAYOUT_NEWLINE LAYOUT_INDENT arms:request_arm* LAYOUT_DEDENT) ;
request_arm = (kind:"effect" operation:(qualified_name | group) pattern:pattern "=>" body:suite LAYOUT_NEWLINE | kind:"complete" pattern:pattern "=>" body:suite LAYOUT_NEWLINE) ;
pattern_conditional = ("if" "let" pattern:pattern "=" value:expression ":" consequence:suite fallback:else_clause?) ;
conditional = ("if" condition:expression ":" consequence:suite fallback:else_clause?) ;
else_clause = (LAYOUT_NEWLINE? "else" ":" alternative:suite) ;

// At this nesting level a pipe begins comprehension qualifiers or a cons tail.
// Parenthesized and nested expressions retain the ordinary operator grammar.
collection_expression = (value:(collection_lambda | do_block | case_expression | collection_if | collection_infix)) ;
collection_lambda = ("func" parameter:parameter ("->" parameter:parameter)* result:(":" type_expression)? "=>" ("return" body:collection_expression | body:suite | body:collection_expression)) ;
collection_if = ("if" condition:collection_infix "then" consequence:collection_expression "else" alternative:collection_expression) ;
collection_infix = (head:prefix_expression tails:collection_infix_tail*) ;
collection_infix_tail = (operator:(SYMBOL | "+" | "~" | "&" | "$" | "*" | "^" | "and" | "or") argument:(collection_lambda | do_block | case_expression | collection_if | prefix_expression)) ;

source_identifier = (IDENT | "expect_trap" | "own" | "run" | "kernel" | "process" | "prepare" | "init" | "step" | "fields" | "variants" | "code" | "descriptor" | "forall" | "exists" | "row" | "region" | "pack" | "unpack" | "where" | "unique" | "shared" | "borrow" | "borrow_mut" | "once" | "many" | "cleanup" | "concurrent") ;

quantified_type = (kind:("forall" | "exists") "[" binders:quantified_binder ("," binders:quantified_binder)* "]" where:quantified_where? "=>" body:type_expression) ;
quantified_binder = (sort:("row" | "region")? name:(IDENT | "expect_trap" | "kernel" | "process" | "prepare" | "init" | "step" | "forall" | "exists" | "pack" | "unpack" | "where" | "unique" | "shared" | "borrow" | "borrow_mut" | "once" | "many" | "cleanup" | "concurrent")) ;
quantified_where = (("where" | "wherE") body:constraint_body) ;
package_pack = ("pack" "[" witnesses:type_expression ("," witnesses:type_expression)* "]" value:expression "as" annotation:type_expression) ;
package_unpack = ("unpack" package:expression "as" "[" binders:quantified_binder ("," binders:quantified_binder)* "]" name:source_identifier "in" body:expression) ;
