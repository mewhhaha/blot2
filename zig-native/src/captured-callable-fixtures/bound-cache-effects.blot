type Read is effect = { get: Unit -> U32 }
const call = fn callback => do:
  let bound = fn value => callback value
  return bound 1
const provider = @effect.provider Read.get (fn () => 41)
entry const answer = fn () => do provider:
  let pure = call (fn value => @u32.add value 40)
  use effectful <- call (fn value => do:
    use seed <- Read.get ()
    return @u32.add seed value
  )
  return @u32.add pure effectful
entry const folded = answer ()
