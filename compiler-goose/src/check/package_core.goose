struct CollectionProof {walker:Walker&}
fn same(self:CollectionProof,first:u32,second:u32)->Error {return self.walker.strictSame(first,second);}
fn callback(self:CollectionProof,row:u32)->Error {return require(self.walker.scopes.isPure(row) || (self.walker.foreign_allowed && self.walker.scopes.isForeign(row)));}
fn collection(self:CollectionProof,sequence:u32,element:u32)->Error {return self.walker.collectionSequence(sequence,element);}
