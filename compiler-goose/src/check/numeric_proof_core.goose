fn contains(values: const u32[:], target: u32) -> bool { for value in values { if value == target { return true; } } return false; }
recursive fn branches(self_: Checker&, id: u32, condition: u32, left_id: u32, right_id: u32, depth: i64)->Value, Error {var left_facts:Facts=Facts{..};var left_bindings:Entries=Entries{..};var right_facts:Facts=Facts{..};var right_bindings:Entries=Entries{..};let result,error=branchesValue(self_,id,condition,left_id,right_id,depth,left_facts,left_bindings,right_facts,right_bindings);blot_support_pooled_buffer::deinit(right_bindings,entry_scratch);blot_support_pooled_buffer::deinit(right_facts,fact_scratch);blot_support_pooled_buffer::deinit(left_bindings,entry_scratch);blot_support_pooled_buffer::deinit(left_facts,fact_scratch);return result,error;}
recursive fn branchesValue(self_: Checker&, id: u32, condition: u32, left_id: u32, right_id: u32, depth: i64,left_facts:Facts&,left_bindings:Entries&,right_facts:Facts&,right_bindings:Entries&)->Value, Error {
    let start = self_.environment.items.len; let facts = self_.facts.items.len; let err = self_.assume(condition, true, 0); if err != blot_error::Error.none { return Value {..}, err; } let left, err = self_.walk(left_id, depth + 1); if err != blot_error::Error.none { return Value {..}, err; }
    let stored=blot_support_pooled_buffer::append(left_facts,self_.facts.items[facts..],fact_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} self_.facts.resize(facts); let stored=blot_support_pooled_buffer::append(left_bindings,self_.environment.items[start..],entry_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} self_.environment.resize(start);
    let err = self_.assume(condition, false, 0); if err != blot_error::Error.none { return Value {..}, err; } let right, err = self_.walk(right_id, depth + 1); if err != blot_error::Error.none { return Value {..}, err; } let stored=blot_support_pooled_buffer::append(right_facts,self_.facts.items[facts..],fact_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} self_.facts.resize(facts); let stored=blot_support_pooled_buffer::append(right_bindings,self_.environment.items[start..],entry_scratch); if stored!=blot_error::Error.none {return Value{..},stored;} self_.environment.resize(start);
