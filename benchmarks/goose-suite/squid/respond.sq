// Streaming JSON response serializer with FNV-1a 64-bit checksum per response.
// Uses static const byte strings (b"...") with bulk Array.extend, pre-sized
// Array.with_capacity, and a stack-inlined 10-byte digit buffer.
import * as rng from "./rng"

const BENCH_N: U32 = 400000 // BENCH_N

const K_ID: #[U8] = b"{\"id\":"
const K_USER: #[U8] = b",\"user\":"
const K_ITEMS: #[U8] = b",\"items\":["
const K_SKU: #[U8] = b"{\"sku\":"
const K_QTY: #[U8] = b",\"qty\":"
const K_PRICE: #[U8] = b",\"price\":"
const K_TOTAL: #[U8] = b"],\"total\":"

type HandleRes is data = $HandleRes { hash: U64, len: U32 }

func emit_uint (buf: own #[U8]) -> (v: U32): #[U8] =>
  if v == 0:
    buf := self.push '0'
    return buf
  let digits = @array.fill 10 0u8
  let n: U32 = 0
  let x = v
  for ever:
    if x == 0:
      break
    digits[n] := (48 + (x % 10)).to_u8
    n := self + 1
    x := self / 10
  for ever:
    if n == 0:
      break
    n := self - 1
    buf := self.push digits[n]
  return buf

func emit_name (buf: own #[U8]) -> (seed: U64): #[U8] =>
  let r = rng.xs_next seed
  let n = 3 + (r & 7u64).to_u32
  let odd = ((r >> 8u64) & 7u64) == 0u64
  buf := self.push '\"'
  for i in 0 .. n:
    r := rng.xs_next self
    if odd and i == 1:
      buf := self.push '\\'
      let q: U8 = if (r & 1u64) == 0u64 then '\"' else '\\'
      buf := self.push q
    else:
      buf := self.push (97 + (r % 26u64).to_u32).to_u8
  buf := self.push '\"'
  return buf

func emit_sku (buf: own #[U8]) -> (seed: U64): #[U8] =>
  let r = rng.xs_next seed
  buf := self.push '\"'
  buf := self.push (65 + (r % 26u64).to_u32).to_u8
  buf := self.push (65 + ((r >> 8u64) % 26u64).to_u32).to_u8
  for _ in 0 .. 4:
    r := rng.xs_next self
    buf := self.push (48 + (r % 10u64).to_u32).to_u8
  buf := self.push '\"'
  return buf

func fnv_buf (buf: #[U8]): U64 =>
  let h: U64 = rng.FNV_OFFSET
  for i in 0 .. buf.length:
    h := rng.fnv_step self buf[i]
  return h

func handle (seed: U64): HandleRes =>
  let r0 = rng.xs_next seed
  let n = 1 + (r0 & 7u64).to_u32
  let buf: #[U8] = Array.with_capacity 512
  buf := Array.extend self K_ID
  buf := emit_uint self (((r0 >> 4u64) % 1000000u64).to_u32)
  buf := Array.extend self K_USER
  buf := emit_name self (r0 >> 8u64)
  buf := Array.extend self K_ITEMS

  let total: U32 = 0
  let r = r0 >> 16u64
  for i in 0 .. n:
    r := rng.xs_next self
    if i > 0:
      buf := self.push ','
    let qty = 1 + ((r >> 8u64) % 5u64).to_u32
    let price = 100 + ((r >> 16u64) % 99900u64).to_u32
    buf := Array.extend self K_SKU
    buf := emit_sku self r
    buf := Array.extend self K_QTY
    buf := emit_uint self qty
    buf := Array.extend self K_PRICE
    buf := emit_uint self price
    buf := self.push '}'
    total := self + qty * price

  buf := Array.extend self K_TOTAL
  buf := emit_uint self total
  buf := self.push '}'

  return $HandleRes { hash: fnv_buf buf, len: buf.length }

io bench (): #[U32] =>
  let seed: U64 = 12345u64
  let h: U64 = 0u64
  let bytes: I64 = 0i64
  for i in 0 .. BENCH_N:
    seed := rng.xs_next self
    let $HandleRes { hash: hh, len: l } = handle seed
    let term = hh * 31u64 + i.to_u64
    h := self ^ term
    bytes := self + l.to_i64

  let out: #[U32] = #[]
  out := rng.emit_u32 self BENCH_N
  out := rng.emit_i64 self bytes
  out := rng.emit_u64 self h
  return out
