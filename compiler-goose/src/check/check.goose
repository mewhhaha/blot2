fn Engine::operationValue(self:Engine&,source:u32,index:u32,syntax:blot_support::Option<const u32[:]>)->u32,blot_error::Error {let template=self.effect_templates[index];let family=self.effect_families[template.family];let old=equation_type_ids.alloc_slice(family.variables.len);for value,ordinal in self.types.list(family.variables) {old[ordinal]=value;}let fresh=equation_type_ids.alloc_slice(old.len);let shapes=equation_type_ids.alloc_slice(family.parameters.len);for value,ordinal in self.types.list(family.parameters) {shapes[ordinal]=value;}let arguments=equation_type_ids.alloc_slice(shapes.len);let result,err=operationValueArguments(self,source,index,template,family,syntax,old,fresh,shapes,arguments);equation_type_ids.free_slice(arguments);equation_type_ids.free_slice(shapes);equation_type_ids.free_slice(fresh);equation_type_ids.free_slice(old);return result,err;}
fn operationValueArguments(self:Engine&,source:u32,index:u32,template:EffectTemplate,family:EffectFamily,syntax:blot_support::Option<const u32[:]>,old:const u32[:],fresh:u32[:],shapes:const u32[:],arguments:u32[:])->u32,blot_error::Error {for &variable in fresh {let root,err=self.types.fresh();if err!=blot_error::Error.none {return 0,err;}variable=root;}if syntax.present {if syntax.value.len!=shapes.len {let err=self.diagnostic(Code.effect_arity,source);if err!=blot_error::Error.none {return 0,err;}return self.types.fresh();}for argument,ordinal in syntax.value {let actual,err=self.parameterArgument(self.parameter_patterns.list(family.patterns)[ordinal],argument,false,0);if err!=blot_error::Error.none {return 0,err;}let selected,err=self.types.substitute(shapes[ordinal],old,fresh);if err!=blot_error::Error.none {return 0,err;}let err=self.constrain(selected,actual,argument);if err!=blot_error::Error.none {return 0,err;}let resolved,err=self.types.resolve(selected,0);if err!=blot_error::Error.none {return 0,err;}arguments[ordinal]=resolved;}}else {for shape,ordinal in shapes {let root,err=self.types.substitute(shape,old,fresh);if err!=blot_error::Error.none {return 0,err;}arguments[ordinal]=root;}}let parameter,err=self.types.substitute(template.parameter,old,fresh);if err!=blot_error::Error.none {return 0,err;}let result,err=self.types.substitute(template.result,old,fresh);if err!=blot_error::Error.none {return 0,err;}let latent,err=self.types.freshEffects();if err!=blot_error::Error.none {return 0,err;}var row=latent;var concrete=shapes.len==0 || syntax.present;for &argument in arguments {let root,err=self.types.resolve(argument,0);if err!=blot_error::Error.none {return 0,err;}argument=root;if concrete {let closed,err=self.types.equalClosed(root,root);if err!=blot_error::Error.none {return 0,err;}concrete=closed;}}if concrete {let label,err=self.types.internOperation(template.identity,arguments);if err!=blot_error::Error.none {return 0,err;}let selected,err=self.ty