fn isValue(flow: Flow) -> bool { match flow { value=>true,_=>false, } }
fn flowValue(flow: Flow) -> ValueId { match flow { value v=>v.value,_=>{ assert(false); return 0; }, } }
fn reflectionExpression(self: Session&,owner: i64,id: u32,frame: Frame&) -> Flow,Error {
