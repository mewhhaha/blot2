}
struct Creators {values:u32[16],len:i64=0,remaining:i64=4096}
fn visit(self:Creators&)->Error {if self.remaining==0 {return Error.invalid_artifact;}self.remaining-=1;return Error.none;}
fn add(self:Creators&,value:u32)->Error {for prior in self.values[..self.len] {if prior==value {return Error.none;}}if self.len==self.values.len {return Error.invalid_artifact;}self.values[self.len]=value;self.len+=1;return Error.none;}
fn valueOrigins(self:const Scan&,id:u32,expected:u32,values:Creators&,depth:i64)->bool,Error {
