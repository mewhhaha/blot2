fn Engine::conditional(self:Engine&,id:u32)->Flow,blot_error::Error {let node=self.tree.node(id);let patterned=node.tag==blot_parse_ast::tag_if_let_stmt;var source=node.a;if patterned {source=node.b;}let subject,err=self.expression(source);if err!=blot_error::Error.none {return Flow{},err;}if !patterned {let err=self.constrain(subject,blot_check_types::boolean,node.a);if err!=blot_error::Error.none {return Flow{},err;}}var bodies:u32[2]=[node.b,node.c];if patterned {bodies=[self.tree.extra.items[node.c],self.tree.extra.items[node.c+1]];}let base=global_entry_runs.alloc_slice(self.env.len);for entry,index in self.env {base[index]=entry;}let left=equation_type_ids.alloc_slice(base.len);let right=equation_type_ids.alloc_slice(base.len);var joins=IdBuffer{};let result,error=conditionalBody(self,id,node,patterned,subject,bodies,base,left,right,joins);joins.deinit(equation_type_ids);if right.len!=0 {equation_type_ids.free_slice(right);}if left.len!=0 {equation_type_ids.free_slice(left);}if base.len!=0 {global_entry_runs.free_slice(base);}return result,error;}
